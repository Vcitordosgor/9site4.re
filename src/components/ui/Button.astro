---
/**
 * Button — variants primary / secondary / tertiary, tailles sm / md / lg.
 * Rend un <a> si `href` est fourni, sinon un <button>.
 * Conforme skill §2 : touch target ≥44px, cursor-pointer, focus visible.
 */
interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group relative inline-flex items-center justify-center gap-2 font-inter font-semibold whitespace-nowrap select-none transition-all duration-200 ease-out cursor-pointer disabled:cursor-not-allowed disabled:opacity-50';

const sizes = {
  sm: 'h-11 px-5 text-sm rounded-full',
  md: 'h-12 px-6 text-base rounded-full',
  lg: 'h-14 px-8 text-lg rounded-full',
};

const tertiarySizes = {
  sm: 'h-11 px-2 text-sm',
  md: 'h-12 px-2 text-base',
  lg: 'h-14 px-2 text-lg',
};

const variants = {
  primary:
    'bg-bleu text-bleu-nuit shadow-[0_8px_24px_rgba(145,166,255,0.45)] hover:bg-bleu-fonce hover:-translate-y-0.5 hover:shadow-card-hover active:translate-y-0',
  // Outline / ghost — distinct du primary.
  secondary:
    'bg-transparent ring-1 ring-bleu text-bleu hover:bg-bleu/10 hover:-translate-y-0.5 active:translate-y-0',
  tertiary:
    'bg-transparent text-blanc-casse hover:text-bleu',
  // Fond clair sur section sombre.
  inverse:
    'bg-blanc-casse text-bleu-nuit hover:bg-white hover:-translate-y-0.5 active:translate-y-0',
};

const classes = [
  base,
  variant === 'tertiary' ? tertiarySizes[size] : sizes[size],
  variants[variant],
  fullWidth ? 'w-full' : '',
  className,
].join(' ');

const Tag = href ? 'a' : 'button';
---

<Tag
  class={classes}
  {...(href ? { href } : { type, disabled })}
  {...rest}
>
  {variant === 'tertiary' ? (
    <span class="relative">
      <slot />
      <span
        class="absolute left-0 -bottom-0.5 h-px w-full origin-left scale-x-0 bg-current transition-transform duration-300 ease-out group-hover:scale-x-100"
        aria-hidden="true"
      ></span>
    </span>
  ) : (
    <slot />
  )}
</Tag>
