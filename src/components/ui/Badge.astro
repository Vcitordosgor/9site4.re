---
/**
 * Badge — petit label discret pour catégorie, statut, formulaire métier.
 * rounded-full, fond teinté, texte semibold.
 */
interface Props {
  variant?: 'primary' | 'outline';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'primary',
  size = 'sm',
  class: className = '',
} = Astro.props;

const sizes = {
  sm: 'h-6 px-2.5 text-xs',
  md: 'h-7 px-3 text-sm',
};

const variants = {
  primary: 'bg-bleu text-bleu-nuit',
  outline: 'bg-transparent text-blanc-casse ring-1 ring-blanc-casse/30',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 font-inter font-medium rounded-full whitespace-nowrap',
    sizes[size],
    variants[variant],
    className,
  ]}
>
  <slot />
</span>
