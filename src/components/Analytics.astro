---
/**
 * Analytics — GA4 + Meta Pixel, chargés UNIQUEMENT après consentement.
 *
 * Gated à la compilation par PUBLIC_ENABLE_ANALYTICS === 'true' + présence d'un ID.
 * Au runtime : les scripts tiers ne sont PAS chargés au load. Ils le sont via
 * window.__loadTrackers(), appelée par CookieConsent.astro une fois l'accord donné
 * (conformité CNIL : aucun traceur avant consentement).
 * Si rien n'est configuré : 0 script, 0 event, 0 erreur, pas de bandeau.
 */
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID as string | undefined;
const PIXEL_ID = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;
const ENABLED = import.meta.env.PUBLIC_ENABLE_ANALYTICS === 'true';

const HAS_GA = ENABLED && !!GA_ID;
const HAS_PIXEL = ENABLED && !!PIXEL_ID;
const HAS_ANY = HAS_GA || HAS_PIXEL;
---

{HAS_ANY && (
  <script is:inline define:vars={{ GA_ID: HAS_GA ? GA_ID : null, PIXEL_ID: HAS_PIXEL ? PIXEL_ID : null }}>
    // Défini mais NON exécuté au load : appelé par CookieConsent après consentement.
    window.__loadTrackers = function () {
      if (window.__trackersLoaded) return;
      window.__trackersLoaded = true;

      if (GA_ID) {
        var gs = document.createElement('script');
        gs.async = true;
        gs.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(gs);
        window.dataLayer = window.dataLayer || [];
        function gtag(){ window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', GA_ID, { anonymize_ip: true, send_page_view: true });
      }

      if (PIXEL_ID) {
        !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
        n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
        window.fbq('init', PIXEL_ID);
        window.fbq('track', 'PageView');
      }

      // Auto-binding des events data-track-* (sans PII).
      import('../lib/tracking').catch(function () {});
    };
  </script>
)}
