---
import Icon from '../ui/Icon.astro';

/**
 * Méthode 9site4 — section 4 home : 3 blocs numérotés.
 */
const etapes = [
  {
    num: '01',
    icon: 'file-text',
    titre: 'Cadrer votre activité',
    texte: "Nous identifions vos prestations, vos informations clés, vos objectifs et la manière dont vos clients doivent vous contacter.",
  },
  {
    num: '02',
    icon: 'wand',
    titre: 'Structurer votre site',
    texte: "Nous organisons vos pages, vos textes, vos visuels, vos appels à l'action et votre module métier pour créer un site clair et professionnel.",
  },
  {
    num: '03',
    icon: 'shield-check',
    titre: 'Gérer votre présence web',
    texte: "Hébergement, sécurité, maintenance, modifications simples et accompagnement local sont intégrés dans la durée.",
  },
];
---

<section class="relative px-6 py-16 md:py-24" aria-labelledby="methode-titre">
  <div class="mx-auto max-w-content">
    <div class="max-w-3xl mx-auto text-center">
      <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
        <span class="w-2 h-2 rounded-full bg-bleu"></span> Méthode 9site4
      </p>
      <h2 id="methode-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
        Une méthode pensée pour les entreprises locales.
      </h2>
    </div>

    <ol class="scroll-reveal mt-14 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
      {etapes.map((e) => (
        <li class="relative h-full flex flex-col rounded-3xl bg-blanc-casse p-7 md:p-8 transition-all duration-300 ease-out-soft hover:-translate-y-1 hover:shadow-card-hover">
          <div class="flex items-center justify-between">
            <span class="flex w-12 h-12 rounded-2xl bg-bleu/20 text-bleu-nuit items-center justify-center">
              <Icon name={e.icon} size={22} strokeWidth={1.75} />
            </span>
            <span class="font-sora font-bold text-bleu-nuit/25 text-3xl leading-none tabular-nums">{e.num}</span>
          </div>
          <h3 class="mt-6 font-sora font-semibold text-xl text-bleu-nuit leading-snug">{e.titre}</h3>
          <p class="mt-3 text-base text-bleu-nuit/70 leading-relaxed">{e.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
