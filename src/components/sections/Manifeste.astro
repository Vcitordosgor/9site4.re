---
import Icon from '../ui/Icon.astro';

/**
 * Manifeste — affirmation éditoriale centrée + 3 piliers (sans photo).
 * Une idée forte, soutenue par 3 preuves de méthode. 100% charte.
 */

const piliers = [
  { icon: 'monitor', titre: 'On crée', texte: 'Un site clair, adapté à votre métier.' },
  { icon: 'shield-check', titre: 'On gère', texte: 'Hébergement, sécurité, maintenance, modifications.' },
  { icon: 'mail', titre: 'On vous amène des demandes', texte: 'Un formulaire qui transforme vos visiteurs en clients.' },
];
---

<section class="relative px-6 py-16 md:py-24" aria-labelledby="manifeste-titre">
  <div class="mx-auto max-w-4xl text-center">
    <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
      <span class="w-2 h-2 rounded-full bg-bleu"></span> Pourquoi 9site4
    </p>
    <h2
      id="manifeste-titre"
      class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]"
    >
      Votre métier, c'est de servir vos clients.
      <span class="block mt-1 text-bleu">Le nôtre, c'est de vous en amener.</span>
    </h2>
    <p class="scroll-reveal mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/65 leading-relaxed">
      Un site clair, local et géré de A à Z, qui transforme les visiteurs en
      demandes concrètes — pendant que vous, vous gérez votre activité.
    </p>
  </div>

  <!-- 3 piliers -->
  <div class="mx-auto max-w-5xl mt-14 md:mt-16 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
    {piliers.map((p, i) => (
      <div class="scroll-reveal pillier group relative rounded-3xl bg-blanc-casse p-7 md:p-8 transition-all duration-300 ease-out-soft hover:-translate-y-1 hover:bg-bleu hover:shadow-[0_10px_30px_-10px_rgba(145,166,255,0.55)]">
        <div class="flex items-center justify-between">
          <span class="flex w-12 h-12 rounded-2xl bg-bleu/20 group-hover:bg-bleu-nuit/15 text-bleu-nuit items-center justify-center transition-colors duration-300">
            <Icon name={p.icon} size={22} strokeWidth={1.75} />
          </span>
          <span class="font-sora font-bold text-bleu-nuit/10 group-hover:text-bleu-nuit/25 text-3xl leading-none tabular-nums transition-colors duration-300">0{i + 1}</span>
        </div>
        <h3 class="mt-6 font-sora font-semibold text-lg text-bleu-nuit leading-snug">{p.titre}</h3>
        <p class="mt-2 text-sm text-bleu-nuit/65 group-hover:text-bleu-nuit/80 leading-relaxed transition-colors duration-300">{p.texte}</p>
      </div>
    ))}
  </div>
</section>
