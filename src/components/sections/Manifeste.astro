---
import Icon from '../ui/Icon.astro';
import { inclusions } from '../../lib/inclusions';

/**
 * Manifeste — section "Pourquoi 9site4" : 3 piliers + récap inclusions
 * (fusion de Promesse + Offre).
 */

const piliers = [
  { icon: 'monitor', titre: 'On crée', texte: 'Un site clair, mobile, adapté à votre métier.' },
  { icon: 'shield-check', titre: 'On gère', texte: 'Hébergement, sécurité, maintenance et modifications simples.' },
  { icon: 'mail', titre: 'On qualifie vos demandes', texte: 'Un formulaire métier pour recevoir des demandes complètes, pas des messages flous.' },
];

// Récap court des inclusions (issu de Offre fusionné)
const inclus = inclusions.map((i) => i.titre);
---

<section class="relative px-6 py-16 md:py-24" aria-labelledby="manifeste-titre">
  <div class="mx-auto max-w-4xl text-center">
    <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
      <span class="w-2 h-2 rounded-full bg-bleu"></span> Pourquoi 9site4
    </p>
    <h2
      id="manifeste-titre"
      class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]"
    >
      Votre métier, c'est de servir vos clients.
      <span class="block mt-1 text-bleu">Le nôtre, c'est de vous en amener.</span>
    </h2>
    <p class="scroll-reveal mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/65 leading-relaxed">
      Un site clair, local et géré de A à Z, qui transforme les visiteurs en
      demandes concrètes — pendant que vous, vous gérez votre activité.
    </p>
  </div>

  <!-- 3 piliers -->
  <div class="mx-auto max-w-5xl mt-14 md:mt-16 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
    {piliers.map((p, i) => (
      <div class="scroll-reveal pillier group relative rounded-3xl bg-blanc-casse p-7 md:p-8 transition-all duration-300 ease-out-soft hover:-translate-y-1 hover:bg-bleu hover:shadow-[0_10px_30px_-10px_rgba(145,166,255,0.55)]">
        <div class="flex items-center justify-between">
          <span class="flex w-12 h-12 rounded-2xl bg-bleu/20 group-hover:bg-white/20 text-bleu-nuit group-hover:text-white items-center justify-center transition-colors duration-300">
            <Icon name={p.icon} size={22} strokeWidth={1.75} />
          </span>
          <span class="font-sora font-bold text-bleu-nuit/20 group-hover:text-white/40 text-3xl leading-none tabular-nums transition-colors duration-300">0{i + 1}</span>
        </div>
        <h3 class="mt-6 font-sora font-semibold text-lg text-bleu-nuit group-hover:text-white leading-snug transition-colors duration-300">{p.titre}</h3>
        <p class="mt-2 text-sm text-bleu-nuit/65 group-hover:text-white/90 leading-relaxed transition-colors duration-300">{p.texte}</p>
      </div>
    ))}
  </div>

  <!-- Récap inclusions (fusion ancienne section Offre) -->
  <div class="scroll-reveal mx-auto max-w-5xl mt-10 md:mt-12 px-4">
    <p class="text-center font-roboto-mono text-[10px] uppercase tracking-[0.28em] text-blanc-casse/55 font-semibold mb-5">
      Tout est inclus dans l'abonnement
    </p>
    <ul class="flex flex-wrap justify-center gap-2">
      {inclus.map((label) => (
        <li class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full bg-blanc-casse/[0.08] ring-1 ring-blanc-casse/15 text-xs font-medium text-blanc-casse/85">
          <Icon name="check" size={12} strokeWidth={2.5} class="text-bleu" />
          {label}
        </li>
      ))}
    </ul>
  </div>
</section>
