---
import Icon from '../ui/Icon.astro';
import { fieldDisplay, type FieldOption, type Metier } from '../../lib/formDemo';

/**
 * Panneau de démo d'un métier (formulaire interactif + mockup WhatsApp).
 * Rendu inline sur la home pour le 1er onglet, et via les fragments
 * /fragments/form-panel/[id] pour les 5 autres (chargés au clic).
 */
interface Props {
  metier: Metier;
  active?: boolean;
}

const { metier: m, active = false } = Astro.props;
---

          <div
            role="tabpanel"
            id={`panel-${m.id}`}
            aria-labelledby={`tab-${m.id}`}
            data-panel={m.id}
            data-active={active ? 'true' : 'false'}
            hidden={!active}
          >
            <!-- Header full-width : kicker + titre + intro orientée bénéfice pro -->
            <header class="mb-5 lg:mb-7 max-w-3xl mx-auto text-center">
              <p class="font-roboto-mono text-[10px] uppercase tracking-[0.28em] text-bleu">
                {m.formKicker}
              </p>
              <h3 class="mt-3 font-sora font-bold text-xl md:text-2xl text-blanc-casse">
                {m.formTitle}
              </h3>
              <p class="mt-3 text-sm text-blanc-casse/70 leading-relaxed">
                {m.example}
              </p>
            </header>

            <!-- Grid : formulaire à gauche (3/5) + carte 'Message reçu' à droite (2/5) -->
            <div class="relative grid lg:grid-cols-5 gap-6 lg:gap-8 items-start">

            <!-- Connecteur formulaire → téléphone (desktop) -->
            <div class="hidden lg:flex absolute left-[58%] top-1/2 -translate-y-1/2 z-10 items-center gap-1.5" aria-hidden="true">
              <span class="block w-16 h-[2px] bg-bleu"></span>
              <span class="flex items-center justify-center w-10 h-10 rounded-full bg-bleu text-bleu-nuit shadow-[0_0_24px_rgba(145,166,255,0.6)]">
                <Icon name="arrow-right" size={18} strokeWidth={2.5} />
              </span>
            </div>

            <!-- Colonne mini-formulaire -->
            <div class="lg:col-span-3">
              <div class="relative rounded-3xl bg-white text-bleu-nuit p-5 md:p-6 ring-1 ring-bleu/30"
                style="box-shadow: 0 22px 50px -20px rgba(0,0,0,0.85), 0 0 0 1.5px #91a6ff, 0 0 36px -10px rgba(145,166,255,0.55);">
                <!-- Petit liseret bleu mauve en haut, écho à la card prix -->
                <span class="absolute top-0 inset-x-10 h-px bg-gradient-to-r from-transparent via-bleu/60 to-transparent" aria-hidden="true"></span>
                <!-- Mini-badge 'Aperçu live' avec point pulsant -->
                <div class="flex items-center justify-between gap-3 pb-3 border-b border-bleu-nuit/10">
                  <span class="inline-flex items-center gap-2 font-roboto-mono text-[10px] uppercase tracking-[0.22em] text-bleu-nuit/60 font-semibold">
                    <span class="relative flex h-2 w-2" aria-hidden="true">
                      <span class="absolute inline-flex h-full w-full rounded-full bg-bleu opacity-60 animate-ping"></span>
                      <span class="relative inline-flex h-2 w-2 rounded-full bg-bleu"></span>
                    </span>
                    Aperçu live
                  </span>
                  <span class="inline-flex items-center gap-1.5 px-2.5 h-6 rounded-full bg-bleu-nuit/[0.05] font-roboto-mono text-[9px] uppercase tracking-[0.2em] text-bleu-nuit/45">
                    {m.formKicker.replace('Formulaire · ', '')}
                  </span>
                </div>

                <p class="mt-4 font-sora font-bold text-xl leading-tight">{m.formTitle}</p>

                <p class="mt-1 text-xs text-bleu-nuit/55">
                  Aperçu interactif — cliquez dans les champs.
                </p>

                <form
                  id={`demo-form-${m.id}`}
                  class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-2.5"
                  data-demo-form
                  data-metier={m.id}
                  onsubmit="event.preventDefault();"
                  novalidate
                >
                  {m.fields.map((f) => {
                    const fieldId = `${m.id}-${f.name}`;
                    const wrapClass = f.span === 2 ? 'sm:col-span-2' : '';
                    const inputBase = 'w-full h-11 px-3.5 rounded-lg ring-1 ring-bleu-nuit/12 bg-white text-sm font-medium text-bleu-nuit placeholder:text-bleu-nuit/35 hover:ring-bleu-nuit/25 focus:ring-2 focus:ring-bleu outline-none shadow-sm transition-all duration-200';
                    return (
                      <div class={wrapClass}>
                        {f.type !== 'checkbox' && (
                          <label for={fieldId} class="block text-[11px] font-medium text-bleu-nuit/55 uppercase tracking-wide mb-1.5">
                            {f.label}
                          </label>
                        )}

                        {f.type === 'input-text' && (
                          <input id={fieldId} type="text" name={f.name}
                            placeholder={f.placeholder} value={f.defaultValue ?? ''}
                            class={inputBase} />
                        )}

                        {f.type === 'input-tel' && (
                          <input id={fieldId} type="tel" name={f.name} inputmode="tel"
                            autocomplete="tel" placeholder={f.placeholder}
                            value={f.defaultValue ?? ''}
                            class={`${inputBase} tabular-nums`} />
                        )}

                        {f.type === 'input-email' && (
                          <input id={fieldId} type="email" name={f.name}
                            autocomplete="email" placeholder={f.placeholder}
                            value={f.defaultValue ?? ''}
                            class={inputBase} />
                        )}

                        {f.type === 'input-file' && (
                          <label for={fieldId} class="flex flex-col items-center justify-center gap-1 h-[62px] px-3 rounded-lg ring-1 ring-dashed ring-bleu-nuit/25 bg-blanc-casse cursor-pointer hover:ring-bleu-nuit/45 hover:bg-bleu-nuit/[0.02] transition-all text-center">
                            <input id={fieldId} type="file" name={f.name}
                              accept="image/*"
                              class="sr-only" />
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="text-bleu-nuit/45" aria-hidden="true">
                              <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                              <circle cx="12" cy="13" r="3"/>
                            </svg>
                            <span class="text-[11px] font-medium text-bleu-nuit/70 leading-tight">Cliquez pour joindre une photo</span>
                            {f.hint && (
                              <span class="text-[10px] text-bleu-nuit/45 leading-tight">{f.hint}</span>
                            )}
                          </label>
                        )}

                        {f.type === 'input-date' && (
                          <input id={fieldId} type="date" name={f.name}
                            value={f.defaultValue ?? ''}
                            class={`${inputBase} tabular-nums cursor-pointer`} />
                        )}

                        {f.type === 'input-time' && (
                          <input id={fieldId} type="time" name={f.name}
                            value={f.defaultValue ?? ''}
                            class={`${inputBase} tabular-nums cursor-pointer`} />
                        )}

                        {f.type === 'input-number' && (
                          <input id={fieldId} type="number" name={f.name}
                            min={f.min} max={f.max} value={f.defaultValue ?? ''}
                            class={`${inputBase} tabular-nums`} />
                        )}

                        {f.type === 'select-real' && (
                          <select id={fieldId} name={f.name}
                            class={`${inputBase} cursor-pointer appearance-none bg-no-repeat bg-[right_0.875rem_center] pr-9`}
                            style="background-image: url('data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2212%22 height=%2212%22 viewBox=%220 0 24 24%22 fill=%22none%22 stroke=%22%23000000%22 stroke-width=%222%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22><path d=%22m6 9 6 6 6-6%22/></svg>'); background-size: 12px;">
                            {(f.options as FieldOption[]).map((o) => (
                              <option value={o.value} selected={o.value === f.defaultValue}>
                                {o.label}
                              </option>
                            ))}
                          </select>
                        )}

                        {f.type === 'textarea' && (
                          <textarea id={fieldId} name={f.name}
                            rows={f.rows ?? 2} placeholder={f.placeholder}
                            class="w-full px-3.5 py-2.5 rounded-xl ring-1 ring-bleu-nuit/15 bg-blanc-casse text-sm font-medium text-bleu-nuit placeholder:text-bleu-nuit/30 focus:ring-2 focus:ring-bleu-nuit/40 outline-none resize-none transition-shadow"
                          >{f.defaultValue ?? ''}</textarea>
                        )}

                        {f.type === 'radios-cards' && (
                          <div class="grid grid-cols-2 sm:grid-cols-4 gap-1.5">
                            {(f.options as FieldOption[]).map((o) => (
                              <label class="cursor-pointer">
                                <input type="radio" name={fieldId} value={o.value}
                                  data-field-name={f.name} data-label={o.label}
                                  checked={o.value === f.defaultValue ? true : undefined}
                                  class="peer sr-only" />
                                <span class="block text-center px-2 py-3 rounded-xl text-xs font-medium leading-tight transition-all bg-bleu-nuit/[0.04] text-bleu-nuit/70 ring-1 ring-bleu-nuit/10 peer-checked:bg-bleu-nuit peer-checked:text-blanc-casse peer-checked:ring-bleu-nuit hover:bg-bleu-nuit/[0.08] peer-focus-visible:ring-2 peer-focus-visible:ring-bleu-nuit/40">
                                  {o.label}
                                </span>
                              </label>
                            ))}
                          </div>
                        )}

                        {f.type === 'radios-chips' && (
                          <div class="flex flex-wrap gap-1.5">
                            {(f.options as FieldOption[]).map((o) => (
                              <label class="cursor-pointer">
                                <input type="radio" name={fieldId} value={o.value}
                                  data-field-name={f.name} data-label={o.label}
                                  checked={o.value === f.defaultValue ? true : undefined}
                                  class="peer sr-only" />
                                <span class="inline-flex items-center h-10 px-3 rounded-full text-xs font-medium transition-all bg-bleu-nuit/[0.06] text-bleu-nuit/70 ring-1 ring-bleu-nuit/10 peer-checked:bg-bleu-nuit peer-checked:text-blanc-casse peer-checked:ring-bleu-nuit hover:bg-bleu-nuit/[0.10] peer-focus-visible:ring-2 peer-focus-visible:ring-bleu-nuit/40">
                                  {o.label}
                                </span>
                              </label>
                            ))}
                          </div>
                        )}

                        {f.type === 'checkbox' && (
                          <label for={fieldId} class="flex items-center gap-2.5 h-10 px-3 rounded-lg ring-1 ring-bleu-nuit/15 bg-blanc-casse cursor-pointer hover:ring-bleu-nuit/30 transition-all">
                            <input id={fieldId} type="checkbox" name={f.name}
                              checked={f.defaultChecked ? true : undefined}
                              class="peer sr-only" />
                            <span class="flex items-center justify-center w-5 h-5 rounded-md ring-1 ring-bleu-nuit/25 peer-checked:bg-bleu-nuit peer-checked:ring-bleu-nuit transition-all shrink-0">
                              <svg class="w-3 h-3 text-blanc-casse opacity-0 peer-checked:opacity-100 transition-opacity" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M16.7 5.3a1 1 0 0 1 0 1.4l-7 7a1 1 0 0 1-1.4 0l-3-3a1 1 0 0 1 1.4-1.4l2.3 2.3 6.3-6.3a1 1 0 0 1 1.4 0z"/>
                              </svg>
                            </span>
                            <span class="text-sm font-medium text-bleu-nuit">{f.label}</span>
                          </label>
                        )}
                      </div>
                    );
                  })}
                </form>

                <button
                  type="submit"
                  form={`demo-form-${m.id}`}
                  class="mt-5 w-full h-11 rounded-full font-inter font-semibold text-base inline-flex items-center justify-center gap-2 cursor-pointer transition-all duration-200 ease-out hover:-translate-y-0.5 active:translate-y-0 bg-bleu text-bleu-nuit hover:bg-bleu-fonce shadow-[0_8px_24px_rgba(145,166,255,0.45)]"
                >
                  {m.cta}
                  <Icon name="arrow-right" size={18} strokeWidth={2} />
                </button>
                <p class="mt-2.5 text-[11px] text-bleu-nuit/55 text-center leading-relaxed">
                  Cliquez pour simuler l'envoi — sur votre site, les demandes arrivent par e-mail ou WhatsApp.
                </p>
              </div>
            </div>

            <!-- Colonne conversation WhatsApp Business : 3 bulles (client, formulaire 9site4, pro) -->
            <aside class="lg:col-span-2 lg:sticky lg:top-24" aria-label={`Aperçu conversation pour ${m.label}`}>
              <!-- Mockup téléphone (légèrement incliné sur desktop, ombre + halo mauve) -->
              <div class="relative mx-auto w-[280px] sm:w-[300px] lg:w-[340px] max-w-full lg:rotate-[-3deg]">
                <div class="relative rounded-[2.6rem] bg-black p-2.5 ring-1 ring-blanc-casse/10 shadow-[0_30px_60px_-15px_rgba(0,0,0,0.6),0_0_80px_-20px_rgba(145,166,255,0.45)]">
                  <!-- Notch -->
                  <div class="pointer-events-none absolute top-2.5 left-1/2 -translate-x-1/2 z-20 h-6 w-28 rounded-b-2xl bg-black" aria-hidden="true"></div>
                  <!-- Bouton volume gauche -->
                  <div class="pointer-events-none absolute -left-[3px] top-24 w-[3px] h-10 rounded-l-sm bg-black" aria-hidden="true"></div>
                  <div class="pointer-events-none absolute -left-[3px] top-40 w-[3px] h-16 rounded-l-sm bg-black" aria-hidden="true"></div>
                  <!-- Bouton power droit -->
                  <div class="pointer-events-none absolute -right-[3px] top-32 w-[3px] h-14 rounded-r-sm bg-black" aria-hidden="true"></div>
                  <div
                    class="relative rounded-[2.1rem] overflow-hidden bg-[#ECE5DD]"
                    data-message-card
                  >
                    <!-- Barre d'état (le notch repose dessus) -->
                    <div class="h-7 bg-[#075E54]" aria-hidden="true"></div>
                    <!-- Header WhatsApp Business -->
                <header class="flex items-center gap-3 px-4 py-3 bg-[#075E54] text-blanc-casse">
                  <span class="flex w-9 h-9 rounded-full bg-blanc-casse/20 items-center justify-center font-sora font-bold text-sm shrink-0" aria-hidden="true">
                    {m.label.charAt(0)}
                  </span>
                  <div class="flex-1 min-w-0">
                    <p class="font-sora font-semibold text-sm leading-tight truncate">Vous · WhatsApp Business</p>
                    <p class="text-[11px] text-blanc-casse/75 leading-tight flex items-center gap-1.5 mt-0.5">
                      <span class="block w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
                      en ligne
                    </p>
                  </div>
                  <span class="flex items-center gap-3 text-blanc-casse/70" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="6" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="12" cy="18" r="1.5"/></svg>
                  </span>
                </header>

                <!-- Convo body (fond bleu nuit léger pour évoquer WA) -->
                <div class="px-3 py-4 space-y-2.5">

                  <!-- Bulle 1 : message client (gauche) -->
                  <div class="flex justify-start">
                    <div class="max-w-[85%] rounded-2xl rounded-bl-sm bg-blanc-casse text-bleu-nuit px-3 py-2 shadow-sm">
                      <p class="text-[13px] leading-snug">{m.clientIntro}</p>
                      <p class="text-[10px] text-bleu-nuit/40 mt-1 text-right tabular-nums">10:24</p>
                    </div>
                  </div>

                  <!-- Bulle 2 : notification 9site4 (centre, ring orange,
                       coin tr-sm comme une notif descendant en push) -->
                  <div class="flex justify-center">
                    <div
                      class="w-full rounded-2xl rounded-tr-sm bg-blanc-casse ring-1 ring-bleu/40 px-3.5 py-3 shadow-sm"
                      data-notif-bubble
                    >
                      <p class="font-roboto-mono text-[9px] uppercase tracking-[0.22em] font-semibold text-bleu flex items-center gap-1.5 mb-2">
                        <Icon name="mail" size={11} strokeWidth={2.5} class="shrink-0" />
                        9site4 · Nouveau formulaire
                      </p>
                      <p class="font-sora font-semibold text-bleu-nuit text-sm leading-snug">
                        Nouvelle demande — {m.label}
                      </p>
                      <dl class="mt-2.5 space-y-1.5">
                        {m.fields.map((f) => (
                          <div class="grid grid-cols-[6rem_1fr] gap-2 items-baseline">
                            <dt class="text-[9.5px] uppercase tracking-wide text-bleu-nuit/55 font-medium leading-tight">
                              {f.label}
                            </dt>
                            <dd
                              class="text-[12px] text-bleu-nuit leading-snug break-words"
                              data-message-key={f.name}
                            >
                              {fieldDisplay(f)}
                            </dd>
                          </div>
                        ))}
                      </dl>
                      <div class="mt-2.5 flex items-center justify-between gap-2">
                        <span class="inline-flex items-center gap-1.5 h-6 px-2.5 rounded-full bg-[#25D366]/15 text-[#0E5B2F] text-[9.5px] font-semibold uppercase tracking-wide">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span>
                          Demande prête à traiter
                        </span>
                        <span class="text-[10px] text-bleu-nuit/40 tabular-nums">10:24 ✓✓</span>
                      </div>
                    </div>
                  </div>

                  <!-- Bulle 3 : réponse pro (droite, vert WhatsApp) -->
                  <div class="flex justify-end">
                    <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-[#DCF8C6] text-bleu-nuit px-3 py-2 shadow-sm">
                      <p class="text-[13px] leading-snug">{m.proReply}</p>
                      <p class="text-[10px] text-bleu-nuit/40 mt-1 text-right tabular-nums">
                        10:25 <span class="text-[#34B7F1]">✓✓</span>
                      </p>
                    </div>
                  </div>
                </div>
                </div>
                </div>
              </div>
            </aside>

            </div>
          </div>
