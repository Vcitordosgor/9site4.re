---
import Icon from '../ui/Icon.astro';
import siteConfig from '../../data/siteConfig.json';

/**
 * Hero — version "bold & impactant".
 * Fond sombre plein contraste, titre XXL, accent orange, 2 CTA francs,
 * bandeau de réassurance. Aucun mockup/illustration. Le H1 reste le LCP.
 */

const trust = [
  'Sans frais de création',
  'Hébergement inclus',
  'Maintenance incluse',
  'Fait à La Réunion',
];
---

<section
  class="relative overflow-hidden bg-bleu-nuit text-blanc-casse"
  aria-label="Présentation de 9site4"
>
  <!-- Fond : halos discrets + 974 en filigrane -->
  <div class="pointer-events-none absolute inset-0 -z-0" aria-hidden="true">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[55rem] h-[55rem] rounded-full bg-bleu/10 blur-3xl halo-pulse"></div>
    <div class="absolute -bottom-32 -right-24 w-[40rem] h-[40rem] rounded-full bg-orange/10 blur-3xl halo-pulse-slow"></div>
    <span class="absolute inset-x-0 bottom-0 flex justify-center select-none font-sora font-bold text-[34vw] md:text-[24vw] leading-[0.8] tracking-tighter text-blanc-casse/[0.03] translate-y-[18%]">
      974
    </span>
  </div>

  <div class="relative z-10 mx-auto max-w-content px-6 pt-28 pb-24 md:pt-36 md:pb-32 text-center">
    <!-- Eyebrow -->
    <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-4 h-9 rounded-full ring-1 ring-blanc-casse/15 bg-blanc-casse/[0.04] text-sm font-medium text-blanc-casse/80">
      <span class="inline-block w-2 h-2 rounded-full bg-orange"></span>
      Agence web à La Réunion · {siteConfig.location.areaCode}
    </p>

    <!-- H1 XXL -->
    <h1 class="hero-rise hero-rise-2 mx-auto mt-7 max-w-4xl text-hero font-sora font-bold text-balance">
      Votre site pro, en ligne en
      <span class="relative inline-block text-orange">
        7 jours.
      </span>
      <br class="hidden sm:block" />
      Géré pour vous.
    </h1>

    <!-- Sous-titre -->
    <p class="hero-rise hero-rise-3 mx-auto mt-6 max-w-2xl text-lg md:text-xl text-blanc-casse/75 leading-relaxed">
      9site4 crée votre site vitrine, l'héberge, le maintient et y intègre un
      formulaire adapté à votre métier pour recevoir des demandes plus claires.
      À partir de {siteConfig.pricing.monthly}/mois, sans frais de création.
    </p>

    <!-- CTAs -->
    <div class="hero-rise hero-rise-4 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/contact"
        class="group inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full bg-orange text-bleu-nuit shadow-card hover:shadow-card-hover hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out"
      >
        Demander mon site
        <Icon name="arrow-right" size={20} strokeWidth={2.25} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
      <a
        href="/realisations"
        class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full ring-1 ring-blanc-casse/25 text-blanc-casse hover:bg-blanc-casse hover:text-bleu-nuit transition-all duration-200 ease-out"
      >
        Voir un exemple pour mon métier
      </a>
    </div>

    <!-- Réassurance -->
    <ul class="hero-rise hero-rise-5 mt-10 flex flex-wrap items-center justify-center gap-x-5 gap-y-2.5">
      {trust.map((t) => (
        <li class="inline-flex items-center gap-2 text-sm text-blanc-casse/70">
          <Icon name="check" size={15} strokeWidth={2.5} class="text-orange" />
          {t}
        </li>
      ))}
    </ul>

    <!-- Prix signature inline -->
    <p class="hero-rise hero-rise-5 mt-8 inline-flex items-baseline gap-2 text-blanc-casse/55 text-sm">
      <span class="font-sora font-bold text-2xl text-blanc-casse">{siteConfig.pricing.monthly}</span>
      <span>/mois — soit environ {siteConfig.pricing.daily}/jour · sans engagement</span>
    </p>
  </div>
</section>
