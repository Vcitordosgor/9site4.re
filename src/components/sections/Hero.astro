---
import Icon from '../ui/Icon.astro';
import siteConfig from '../../data/siteConfig.json';

/**
 * Hero — bold, aligné à gauche, charte 9site4 (orange + bleu mauve).
 * Le métier défile dans le H1 (effet "Squarespace" léger, 100% CSS/JS,
 * aucune vidéo/image lourde). Respecte prefers-reduced-motion.
 * Le H1 reste l'élément prioritaire (LCP) — texte réel pour le SEO via aria-label.
 */

const metiers = [
  'restaurant',
  'salon de coiffure',
  'garage',
  'institut',
  'gîte',
  'artisan',
  'cabinet',
];

const trust = [
  'Sans frais de création',
  'Hébergement inclus',
  'Maintenance incluse',
  'Fait à La Réunion',
];
---

<section
  class="relative overflow-hidden px-6 pt-24 pb-20 md:pt-32 md:pb-28"
  aria-label="Présentation de 9site4"
>
  <!-- Halos charte (bleu mauve + orange), discrets -->
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute -top-40 -left-32 w-[42rem] h-[42rem] rounded-full bg-bleu/25 blur-3xl halo-pulse"></div>
    <div class="absolute top-10 -right-40 w-[40rem] h-[40rem] rounded-full bg-orange/15 blur-3xl halo-pulse-slow"></div>
    <span class="absolute right-0 bottom-0 select-none font-sora font-bold text-[30vw] md:text-[18vw] leading-[0.8] tracking-tighter text-bleu-nuit/[0.035] translate-x-[8%] translate-y-[20%]">974</span>
  </div>

  <div class="relative z-10 mx-auto max-w-content text-left">
    <!-- Eyebrow -->
    <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-4 h-9 rounded-full ring-1 ring-bleu-nuit/10 bg-blanc-casse/70 text-sm font-medium text-bleu-nuit/75">
      <span class="inline-block w-2 h-2 rounded-full bg-orange"></span>
      Agence web à La Réunion · {siteConfig.location.areaCode}
    </p>

    <!-- H1 XXL avec métier qui défile -->
    <h1
      class="hero-rise hero-rise-2 mt-7 max-w-4xl text-hero font-sora font-bold text-bleu-nuit text-balance"
      aria-label="Le site pro de votre commerce, en ligne en 7 jours."
    >
      <span aria-hidden="true">Le site pro de votre</span>
      <br />
      <span
        id="hero-metier"
        class="relative inline-block align-baseline"
        aria-hidden="true"
        data-metiers={JSON.stringify(metiers)}
      >
        <span class="relative z-10 hero-metier-word">{metiers[0]}</span>
        <span class="absolute inset-x-0 bottom-1 md:bottom-2 h-3 md:h-4 bg-bleu -z-0"></span>
      </span>
      <span aria-hidden="true">,</span>
      <br class="hidden sm:block" />
      <span aria-hidden="true" class="relative inline-block">
        <span class="relative z-10">en ligne en 7 jours.</span>
        <span class="absolute inset-x-0 bottom-1 md:bottom-2 h-3 md:h-4 bg-orange/70 -z-0"></span>
      </span>
    </h1>

    <!-- Sous-titre -->
    <p class="hero-rise hero-rise-3 mt-6 max-w-2xl text-lg md:text-xl text-bleu-nuit/70 leading-relaxed">
      9site4 crée votre site vitrine, l'héberge, le maintient et y intègre un
      formulaire adapté à votre métier pour recevoir des demandes plus claires.
      À partir de {siteConfig.pricing.monthly}/mois, sans frais de création.
    </p>

    <!-- CTAs -->
    <div class="hero-rise hero-rise-4 mt-10 flex flex-col sm:flex-row gap-4 justify-start">
      <a
        href="/contact"
        class="group inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full bg-orange text-bleu-nuit shadow-card hover:shadow-card-hover hover:-translate-y-0.5 active:translate-y-0 transition-all duration-200 ease-out"
      >
        Demander mon site
        <Icon name="arrow-right" size={20} strokeWidth={2.25} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
      <a
        href="/realisations"
        class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full ring-1 ring-bleu-nuit/20 text-bleu-nuit hover:bg-bleu hover:ring-bleu transition-all duration-200 ease-out"
      >
        Voir un exemple pour mon métier
      </a>
    </div>

    <!-- Réassurance -->
    <ul class="hero-rise hero-rise-5 mt-10 flex flex-wrap items-center gap-x-5 gap-y-2.5">
      {trust.map((t) => (
        <li class="inline-flex items-center gap-2 text-sm text-bleu-nuit/70">
          <Icon name="check" size={15} strokeWidth={2.5} class="text-orange" />
          {t}
        </li>
      ))}
    </ul>

    <!-- Prix signature inline -->
    <p class="hero-rise hero-rise-5 mt-7 inline-flex items-baseline gap-2 text-bleu-nuit/55 text-sm">
      <span class="font-sora font-bold text-2xl text-bleu-nuit">{siteConfig.pricing.monthly}</span>
      <span>/mois — soit environ {siteConfig.pricing.daily}/jour · sans engagement</span>
    </p>
  </div>
</section>

<style>
  .hero-metier-word {
    display: inline-block;
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .hero-metier-word.is-out {
    opacity: 0;
    transform: translateY(-0.35em);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-metier-word {
      transition: none;
    }
  }
</style>

<script>
  function initHeroMetier() {
    const host = document.getElementById('hero-metier');
    if (!host) return;
    const word = host.querySelector<HTMLElement>('.hero-metier-word');
    if (!word) return;

    let metiers: string[] = [];
    try {
      metiers = JSON.parse(host.dataset.metiers || '[]');
    } catch {
      return;
    }
    if (metiers.length < 2) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduced) return; // on garde le premier métier figé

    let i = 0;
    const tick = () => {
      i = (i + 1) % metiers.length;
      word.classList.add('is-out');
      window.setTimeout(() => {
        word.textContent = metiers[i];
        word.classList.remove('is-out');
      }, 400);
    };

    // Évite les timers multiples après navigations View Transitions
    const w = window as unknown as { __heroMetierTimer?: number };
    if (w.__heroMetierTimer) window.clearInterval(w.__heroMetierTimer);
    w.__heroMetierTimer = window.setInterval(tick, 2200);
  }

  initHeroMetier();
  document.addEventListener('astro:page-load', initHeroMetier);
</script>
