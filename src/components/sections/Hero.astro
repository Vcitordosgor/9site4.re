---
/**
 * Hero — style Squarespace : vidéo plein cadre, contenu centré, titre blanc
 * épuré, un seul bouton blanc plein, une ligne de réassurance. Minimaliste.
 * Vidéo optionnelle : dégradé de marque en fallback. Coupée sous reduced-motion.
 */
---

<section
  class="relative isolate overflow-hidden min-h-[92vh] flex items-center justify-center"
  aria-label="Présentation de 9site4"
>
  <!-- Fallback dégradé de marque -->
  <div class="absolute inset-0 -z-20 bg-black" aria-hidden="true"></div>

  <!-- Vidéo de fond -->
  <video
    class="hero-video absolute inset-0 -z-10 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster="/images/hero-poster.jpg"
    aria-hidden="true"
  >
    <source src="/videos/hero.webm" type="video/webm" />
    <source src="/videos/hero.mp4" type="video/mp4" />
  </video>

  <!-- Overlay léger pour lisibilité (l'image/vidéo reste visible) -->
  <div class="absolute inset-0 -z-10 bg-bleu-nuit/45" aria-hidden="true"></div>

  <!-- Contenu centré -->
  <div class="relative z-10 mx-auto max-w-4xl px-6 py-28 text-center text-blanc-casse">
    <h1 class="hero-rise hero-rise-2 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight">
      Le partenaire web des pros
      <span class="block italic font-medium text-bleu">qui font vivre La Réunion.</span>
    </h1>

    <p class="hero-rise hero-rise-3 mt-7 mx-auto max-w-2xl text-lg md:text-xl text-blanc-casse/85 leading-relaxed">
      9site4 crée, structure et gère des sites professionnels pour les TPE/PME réunionnaises : clairs, fiables, adaptés à chaque métier et prêts en 7 jours.
    </p>

    <div class="hero-rise hero-rise-4 mt-9 flex flex-wrap justify-center gap-2.5">
      {['Création incluse', 'Gestion continue', 'Sans frais de création', 'Accompagnement local'].map((b) => (
        <span class="inline-flex items-center gap-2 h-9 px-4 rounded-full bg-white/[0.08] ring-1 ring-white/15 text-xs font-medium text-blanc-casse">
          <span class="block w-1.5 h-1.5 rounded-full bg-bleu" aria-hidden="true"></span>
          {b}
        </span>
      ))}
    </div>

    <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="/contact"
        class="inline-flex items-center justify-center h-14 px-9 text-base font-semibold rounded-full bg-blanc-casse text-bleu-nuit hover:bg-white hover:-translate-y-0.5 shadow-card hover:shadow-card-hover transition-all duration-200 ease-out"
      >
        Créer mon site avec 9site4
      </a>
      <a
        href="/realisations"
        class="inline-flex items-center justify-center h-14 px-7 text-base font-semibold rounded-full ring-1 ring-blanc-casse/40 text-blanc-casse hover:bg-white/10 hover:-translate-y-0.5 transition-all duration-200 ease-out"
      >
        Voir nos réalisations
      </a>
    </div>
  </div>

  <!-- Indicateur de scroll discret -->
  <div class="hero-rise hero-rise-5 absolute bottom-6 left-1/2 -translate-x-1/2 z-10 text-blanc-casse/60" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce">
      <path d="M12 5v14M5 12l7 7 7-7" />
    </svg>
  </div>
</section>

<style>
  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
    .animate-bounce { animation: none; }
  }
</style>

<script>
  function initHeroVideo() {
    const v = document.querySelector<HTMLVideoElement>('.hero-video');
    if (!v) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      v.removeAttribute('autoplay');
      v.pause();
      return;
    }
    v.play().catch(() => {});
  }
  initHeroVideo();
  document.addEventListener('astro:page-load', initHeroVideo);
</script>
