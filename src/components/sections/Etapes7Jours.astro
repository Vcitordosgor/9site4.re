---
import Icon from '../ui/Icon.astro';

/**
 * Étapes — "Votre site en ligne en 7 jours". Timeline éditoriale Squarespace.
 */

const etapes = [
  {
    jour: 'Jour 1',
    icon: 'mail',
    titre: 'Vous envoyez vos infos',
    texte: 'Horaires, prestations, photos, zone d\'intervention, contact. Quelques éléments suffisent.',
  },
  {
    jour: 'Jours 2 à 5',
    icon: 'wand',
    titre: 'On construit votre site',
    texte: 'Design, structure, formulaire métier, responsive et mise en forme — adaptés à votre activité.',
  },
  {
    jour: 'Jours 6 à 7',
    icon: 'rocket',
    titre: 'On ajuste et on met en ligne',
    texte: 'Dernières modifications, vérification, nom de domaine, mise en ligne. Votre site est prêt.',
  },
];
---

<section class="relative px-6 py-[3rem] md:py-[4.5rem] bg-black text-blanc-casse" aria-labelledby="etapes-titre">
  <div class="mx-auto max-w-content">
    <div class="max-w-3xl">
      <p class="scroll-reveal inline-flex items-center px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide">
        Simple et rapide
      </p>
      <h2 id="etapes-titre" class="scroll-reveal mt-4 font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-tight">
        Votre site en ligne en 7 jours.
      </h2>
      <p class="scroll-reveal mt-5 text-lg text-blanc-casse/70 leading-relaxed">
        Pas de cahier des charges interminable, pas de mois d'attente. Un parcours
        clair, un seul interlocuteur.
      </p>
    </div>

    <ol class="scroll-reveal mt-12 grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 relative">
      {etapes.map((e, i) => (
        <li class="relative">
          <article class="h-full flex flex-col rounded-3xl bg-blanc-casse p-7 md:p-8 transition-all duration-300 ease-out-soft hover:-translate-y-0.5 hover:shadow-card-hover">
            <div class="flex items-center justify-between gap-4">
              <span class="flex w-12 h-12 rounded-2xl bg-bleu/25 text-bleu-nuit items-center justify-center">
                <Icon name={e.icon} size={22} strokeWidth={1.75} />
              </span>
              <span class="font-roboto-mono text-xs uppercase tracking-[0.18em] text-bleu-nuit/55 font-semibold">
                {e.jour}
              </span>
            </div>
            <h3 class="mt-6 font-sora font-semibold text-xl text-bleu-nuit leading-snug">
              {e.titre}
            </h3>
            <p class="mt-2.5 text-base text-bleu-nuit/65 leading-relaxed">
              {e.texte}
            </p>
          </article>
          {i < etapes.length - 1 && (
            <span class="hidden md:flex absolute top-12 -right-3.5 w-7 h-7 rounded-full bg-bleu text-bleu-nuit ring-4 ring-black items-center justify-center z-10 shadow-[0_0_12px_rgba(145,166,255,0.5)]" aria-hidden="true">
              <Icon name="arrow-right" size={14} strokeWidth={2.5} />
            </span>
          )}
        </li>
      ))}
    </ol>

    <div class="scroll-reveal mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-4">
      <a
        href="/contact"
        class="group inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full bg-bleu text-bleu-nuit hover:bg-bleu-fonce hover:-translate-y-0.5 shadow-[0_8px_24px_rgba(145,166,255,0.45)] transition-all duration-200 ease-out"
      >
        Demander mon site
        <Icon name="arrow-right" size={20} strokeWidth={2.25} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
      <p class="text-sm text-blanc-casse/55 max-w-md leading-relaxed">
        Délai indicatif pour un site vitrine standard, après réception des éléments nécessaires.
      </p>
    </div>
  </div>
</section>
