---
import realisations from '../../data/exemples.json';

// PERF : seuls les 12 previews effectivement affichés dans le marquee home
// sont importés ici. Les 28 autres ne sont chargés que sur /exemples.
import PreviewResto from '../exemples/previews/PreviewResto.astro';
import PreviewPizzeria from '../exemples/previews/PreviewPizzeria.astro';
import PreviewSalon from '../exemples/previews/PreviewSalon.astro';
import PreviewSpa from '../exemples/previews/PreviewSpa.astro';
import PreviewPaysagiste from '../exemples/previews/PreviewPaysagiste.astro';
import PreviewYoga from '../exemples/previews/PreviewYoga.astro';
import PreviewGite from '../exemples/previews/PreviewGite.astro';
import PreviewPlongee from '../exemples/previews/PreviewPlongee.astro';
import PreviewWedding from '../exemples/previews/PreviewWedding.astro';
import PreviewPhotographe from '../exemples/previews/PreviewPhotographe.astro';
import PreviewBoulangerie from '../exemples/previews/PreviewBoulangerie.astro';
import PreviewStudioAudio from '../exemples/previews/PreviewStudioAudio.astro';

const previewMap: Record<string, any> = {
  'restaurant-gastronomique': PreviewResto,
  'snack-pizzeria':           PreviewPizzeria,
  'salon-de-coiffure':        PreviewSalon,
  'spa-massage':              PreviewSpa,
  'paysagiste':               PreviewPaysagiste,
  'studio-yoga':              PreviewYoga,
  'gite-de-montagne':         PreviewGite,
  'plongee':                  PreviewPlongee,
  'wedding-planner':          PreviewWedding,
  'photographe-auteur':       PreviewPhotographe,
  'boulangerie-artisanale':   PreviewBoulangerie,
  'studio-audio':             PreviewStudioAudio,
};

// PERF : on n'affiche dans le marquee home qu'une sélection de 12 vignettes
// (au lieu des 40, dupliquées 2 fois → 160). Les 40 restent visibles sur /exemples.
// Gain : ~250 KB sur le HTML de la home. Le loop CSS infini est conservé en
// dupliquant UNE seule fois ces 12 vignettes (24 nœuds au total, vs 160 avant).
const showcaseSlugs = [
  'restaurant-gastronomique',
  'salon-de-coiffure',
  'paysagiste',
  'studio-yoga',
  'gite-de-montagne',
  'photographe-auteur',
  'snack-pizzeria',
  'spa-massage',
  'wedding-planner',
  'plongee',
  'boulangerie-artisanale',
  'studio-audio',
];
const showcase = showcaseSlugs
  .map((slug) => realisations.find((r) => r.slug === slug))
  .filter(Boolean) as typeof realisations;
const half = Math.ceil(showcase.length / 2);
const row1Items = showcase.slice(0, half);
const row2Items = showcase.slice(half);
const row1 = [...row1Items, ...row1Items];
const row2 = [...row2Items, ...row2Items];

const stats = [
  { value: '0 €', label: 'd’engagement, libre à tout moment' },
  { value: '7 jours', label: 'pour mettre votre site en ligne' },
  { value: '97,4€', label: 'par mois, tout compris' },
];
---

<section class="relative overflow-hidden bg-bleu-nuit text-blanc-casse py-14 md:py-20" aria-labelledby="vitrine-titre">
  <div class="mx-auto max-w-content px-6 text-center">
    <h2 id="vitrine-titre" class="font-sora font-bold text-2xl md:text-4xl text-balance leading-tight">
      Nos réalisations
    </h2>
    <p class="mt-5 mx-auto max-w-2xl text-lg text-blanc-casse/80 leading-relaxed">
      Découvrez une sélection de sites conçus par 9site4 pour les professionnels réunionnais.
    </p>
    <p class="mt-4 mx-auto max-w-3xl text-base text-blanc-casse/65 leading-relaxed">
      Chaque réalisation illustre notre manière de structurer une activité en ligne : une présentation claire, une identité adaptée au métier, des informations essentielles bien organisées et un parcours de contact simple.
    </p>
  </div>

  <!-- Double marquee — vignettes des réalisations -->
  <div class="vitrine-marquee relative mt-10 md:mt-14 space-y-5" aria-label="Nos réalisations qui défilent">
    <!-- Rangée 1 (sens normal) -->
    <div class="vitrine-track-1 flex gap-5 w-max px-3">
      {row1.map((r, i) => {
        const Preview = previewMap[r.slug] ?? null;
        return (
          <a
            href={r.previewUrl}
            target="_blank"
            rel="noopener"
            class="group relative shrink-0 w-80 md:w-96 rounded-2xl overflow-hidden ring-1 ring-blanc-casse/15 bg-bleu-nuit transition-all duration-300 hover:-translate-y-1 hover:ring-bleu/60"
            aria-hidden={i >= row1Items.length ? 'true' : undefined}
            tabindex={i >= row1Items.length ? -1 : undefined}
          >
            <!-- Browser chrome minimaliste -->
            <div class="flex items-center gap-1.5 px-3 py-2 bg-bleu-nuit/95" aria-hidden="true">
              <span class="block w-2 h-2 rounded-full bg-[#FF5F57]"></span>
              <span class="block w-2 h-2 rounded-full bg-[#FEBC2E]"></span>
              <span class="block w-2 h-2 rounded-full bg-[#28C840]"></span>
            </div>
            <div class="relative aspect-[4/3] overflow-hidden bg-blanc-casse">
              {Preview ? <Preview /> : <div class="absolute inset-0 flex items-center justify-center text-bleu-nuit/30 text-xs">{r.nom}</div>}
              <!-- Hover overlay -->
              <div class="absolute inset-0 flex items-end justify-between gap-2 p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-gradient-to-t from-bleu-nuit/90 via-bleu-nuit/40 to-transparent">
                <span class="font-sora font-semibold text-sm text-blanc-casse">{r.nom}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-bleu text-white text-[10px] font-bold uppercase tracking-wide">
                  {r.moduleInclus}
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>

    <!-- Rangée 2 (sens inverse) -->
    <div class="vitrine-track-2 flex gap-5 w-max px-3">
      {row2.map((r, i) => {
        const Preview = previewMap[r.slug] ?? null;
        return (
          <a
            href={r.previewUrl}
            target="_blank"
            rel="noopener"
            class="group relative shrink-0 w-80 md:w-96 rounded-2xl overflow-hidden ring-1 ring-blanc-casse/15 bg-bleu-nuit transition-all duration-300 hover:-translate-y-1 hover:ring-bleu/60"
            aria-hidden={i >= row2Items.length ? 'true' : undefined}
            tabindex={i >= row2Items.length ? -1 : undefined}
          >
            <div class="flex items-center gap-1.5 px-3 py-2 bg-bleu-nuit/95" aria-hidden="true">
              <span class="block w-2 h-2 rounded-full bg-[#FF5F57]"></span>
              <span class="block w-2 h-2 rounded-full bg-[#FEBC2E]"></span>
              <span class="block w-2 h-2 rounded-full bg-[#28C840]"></span>
            </div>
            <div class="relative aspect-[4/3] overflow-hidden bg-blanc-casse">
              {Preview ? <Preview /> : <div class="absolute inset-0 flex items-center justify-center text-bleu-nuit/30 text-xs">{r.nom}</div>}
              <div class="absolute inset-0 flex items-end justify-between gap-2 p-4 opacity-0 group-hover:opacity-100 transition-opacity duration-300 bg-gradient-to-t from-bleu-nuit/90 via-bleu-nuit/40 to-transparent">
                <span class="font-sora font-semibold text-sm text-blanc-casse">{r.nom}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-bleu text-white text-[10px] font-bold uppercase tracking-wide">
                  {r.moduleInclus}
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>

  <!-- Chiffres honnêtes -->
  <div class="mx-auto max-w-content px-6 mt-16 md:mt-24">
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-10 text-center">
      {stats.map((s) => (
        <div>
          <dt class="sr-only">{s.label}</dt>
          <dd>
            <span class="block font-sora font-bold text-5xl md:text-7xl text-blanc-casse leading-none tracking-tight">{s.value}</span>
            <span class="block mx-auto mt-4 h-[2px] w-10 bg-bleu" aria-hidden="true"></span>
            <span class="mt-4 block text-sm md:text-base text-blanc-casse/70">{s.label}</span>
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex justify-center">
      <a
        href="/exemples"
        class="group inline-flex items-center justify-center gap-2 h-13 px-8 py-3.5 text-base font-semibold rounded-full bg-bleu text-white hover:bg-[#7e95ff] hover:-translate-y-0.5 shadow-[0_8px_30px_rgba(145,166,255,0.45)] transition-all duration-200 ease-out"
      >
        Voir toutes nos réalisations
        <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>

<style>
  .vitrine-track-1 {
    animation: vitrine-scroll 55s linear infinite;
    will-change: transform;
  }
  .vitrine-track-2 {
    animation: vitrine-scroll 70s linear infinite reverse;
    will-change: transform;
  }
  .vitrine-marquee:hover .vitrine-track-1,
  .vitrine-marquee:hover .vitrine-track-2 {
    animation-play-state: paused;
  }
  @keyframes vitrine-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .vitrine-marquee { overflow-x: auto; }
    .vitrine-track-1,
    .vitrine-track-2 { animation: none; }
  }
</style>
