---
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

/**
 * CTABand — bande finale fond bleu-nuit, contraste fort.
 *
 * Props optionnelles `trackingSource` / `trackingSector` / `trackingPageType`
 * pour contextualiser les events de conversion selon la page hôte
 * (homepage_cta_band, seo_sector_page_restaurant, etc.).
 */
interface Props {
  trackingSource?: string;
  trackingSector?: string;
  trackingPageType?: string;
}
const {
  trackingSource = 'cta_band',
  trackingSector,
  trackingPageType,
} = Astro.props;
---

<section class="relative overflow-hidden px-6 py-[3rem] md:py-[4.5rem] bg-bleu-nuit text-blanc-casse">
  <!-- Accents graphiques discrets (mauve, sans flou) -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
  </div>

  <div class="relative mx-auto max-w-3xl text-center">
    <span class="scroll-reveal block mx-auto h-[3px] w-16 bg-bleu mb-6" aria-hidden="true"></span>
    <h2 class="scroll-reveal font-sora font-bold text-3xl md:text-5xl text-balance leading-tight">
      Votre entreprise mérite un site à la hauteur.
    </h2>
    <p class="scroll-reveal mt-6 text-lg md:text-xl text-blanc-casse/85 leading-relaxed">
      Présentez votre activité à 9site4. Nous vous proposons une structure adaptée à votre métier, à vos clients et à vos objectifs.
    </p>
    <div class="scroll-reveal mt-10 flex flex-col sm:flex-row gap-4 justify-center">
      <Button
        variant="primary"
        size="lg"
        href="/contact"
        data-track-event="cta_create_site_click"
        data-track-category="conversion"
        data-track-source={trackingSource}
        data-track-target="/contact"
        data-track-sector={trackingSector}
        data-track-page-type={trackingPageType}
      >
        Créer mon site
        <Icon name="arrow-right" size={20} strokeWidth={2.25} />
      </Button>
      <a
        href="/realisations"
        class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors"
        data-track-event="cta_view_realisations_click"
        data-track-category="navigation"
        data-track-source={trackingSource}
        data-track-target="/realisations"
        data-track-sector={trackingSector}
        data-track-page-type={trackingPageType}
      >
        Voir les exemples
      </a>
    </div>
  </div>
</section>
