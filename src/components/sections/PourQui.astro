---
import Icon from '../ui/Icon.astro';

/**
 * Pour qui / Pas pour qui — section de qualification honnête.
 * Aide le visiteur à s'auto-sélectionner, ton clair et non agressif.
 */

const pour = [
  'Vous êtes une entreprise locale à La Réunion',
  'Vous voulez un site clair sans gérer la technique',
  'Vous voulez recevoir des demandes plus propres',
  'Vous voulez un prix simple et prévisible',
  'Vous n\'avez pas envie de passer trois mois sur votre site',
];

const pasPour = [
  'Vous cherchez seulement le prix le plus bas',
  'Vous voulez une plateforme complexe sur mesure',
  'Vous voulez tout gérer vous-même',
  'Vous voulez modifier entièrement votre site toutes les semaines',
  'Vous voulez un très gros catalogue en ligne complexe',
];
---

<section class="relative px-6 py-14 md:py-20" aria-labelledby="pour-qui-titre">
  <div class="mx-auto max-w-content">
    <div class="max-w-3xl">
      <h2
        id="pour-qui-titre"
        class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-bleu-nuit text-balance leading-tight"
      >
        9site4 est-il fait pour vous ?
      </h2>
      <p class="scroll-reveal mt-6 text-lg text-bleu-nuit/70 leading-relaxed">
        On préfère être clairs dès le départ. Voici à qui s'adresse 9site4 — et à
        qui il ne s'adresse pas.
      </p>
    </div>

    <div class="scroll-reveal mt-12 grid grid-cols-1 lg:grid-cols-2 gap-5 md:gap-6">
      <!-- Pour vous -->
      <div class="rounded-2xl bg-blanc-casse ring-1 ring-bleu/40 p-6 md:p-8">
        <h3 class="font-sora font-semibold text-xl text-bleu-nuit">
          9site4 est fait pour vous si…
        </h3>
        <ul class="mt-5 space-y-3">
          {pour.map((item) => (
            <li class="flex items-start gap-3">
              <span class="flex w-6 h-6 rounded-full bg-bleu/25 text-bleu-nuit items-center justify-center shrink-0 mt-0.5">
                <Icon name="check" size={14} strokeWidth={2.5} />
              </span>
              <span class="text-base text-bleu-nuit/80 leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Pas pour vous -->
      <div class="rounded-2xl bg-blanc-casse ring-1 ring-bleu-nuit/10 p-6 md:p-8">
        <h3 class="font-sora font-semibold text-xl text-bleu-nuit">
          9site4 n'est pas fait pour vous si…
        </h3>
        <ul class="mt-5 space-y-3">
          {pasPour.map((item) => (
            <li class="flex items-start gap-3">
              <span class="flex w-6 h-6 rounded-full bg-bleu-nuit/[0.07] text-bleu-nuit/55 items-center justify-center shrink-0 mt-0.5">
                <Icon name="x" size={14} strokeWidth={2.5} />
              </span>
              <span class="text-base text-bleu-nuit/65 leading-snug">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
