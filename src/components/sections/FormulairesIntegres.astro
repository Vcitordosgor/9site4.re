---
import Icon from '../ui/Icon.astro';

/**
 * Formulaires intégrés — section conversion (brief §13).
 * Tabs "Je suis…" + démo de formulaire adapté au métier.
 */

import FormPanelDemo from './FormPanelDemo.astro';
import { metiers } from '../../lib/formDemo';
---

<section
  id="formulaires-integres"
  class="relative overflow-hidden px-6 py-[3.75rem] md:py-[5.25rem]"
  aria-labelledby="formulaires-titre"
>  <div class="relative mx-auto max-w-content">
    <!-- Header centré : eyebrow + titre stratégique + double paragraphe -->
    <div class="max-w-3xl mx-auto text-center">
      <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
        <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier intégré
      </p>
      <h2 id="formulaires-titre" class="scroll-reveal mt-6 font-sora font-bold text-3xl md:text-5xl text-blanc-casse text-balance leading-[1.1]">
        Un module métier intégré{' '}
        <span class="block italic font-medium text-bleu">à votre site.</span>
      </h2>
      <p class="scroll-reveal mt-6 text-lg text-blanc-casse/70 leading-relaxed">
        Réservation, demande de devis, rendez-vous, inscription, demande de séjour ou premier échange : chaque site 9site4 intègre un parcours adapté à votre activité.
      </p>
      <p class="scroll-reveal mt-3 text-base text-blanc-casse/55 leading-relaxed">
        Sélectionnez une activité ci-dessous : le parcours s'adapte automatiquement et structure chaque demande pour qu'elle arrive prête à traiter, par e-mail ou WhatsApp.
      </p>
    </div>

    <!-- Démo interactive (sans conteneur cream — les éléments flottent sur le noir) -->
    <div
      class="scroll-reveal mt-8 md:mt-12"
      data-form-demo
    >
      <!-- Header démo (zone 'barre de contrôle' légèrement teintée pour
           hiérarchie visuelle vs le panel ci-dessous) -->
      <div class="pb-6">
        <!-- Tabs métiers — barre centrée (style Squarespace) -->
        <div role="tablist" aria-label="Choisir un métier" class="flex flex-wrap justify-center gap-1.5">
          {metiers.map((m, i) => (
            <button
              type="button"
              role="tab"
              data-tab={m.id}
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-controls={`panel-${m.id}`}
              id={`tab-${m.id}`}
              tabindex={i === 0 ? 0 : -1}
              class="group inline-flex items-center gap-2 h-11 px-4 rounded-full text-sm font-medium text-blanc-casse/65 transition-all duration-200 ease-out hover:bg-blanc-casse/[0.08] hover:text-blanc-casse aria-selected:bg-bleu aria-selected:text-bleu-nuit aria-selected:font-semibold cursor-pointer"
            >
              <Icon name={m.icon} size={16} strokeWidth={2} />
              <span class="md:hidden">{m.shortLabel ?? m.label}</span>
              <span class="hidden md:inline">{m.label}</span>
            </button>
          ))}
        </div>
      </div>

      <!-- Panels : seul le 1er est rendu inline (SEO + first paint identiques).
           Les 5 autres sont des fragments statiques /fragments/form-panel/[id]
           insérés ici au 1er clic (ou pré-chargés au survol) sur leur onglet
           — voir mountPanel() dans le <script>. -->
      <div class="relative" data-panels>
        <FormPanelDemo metier={metiers[0]} active />
      </div>
    </div>

    <!-- CTA bas de section -->
    <div class="scroll-reveal mt-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <p class="text-sm text-blanc-casse/70 max-w-md">
        Votre activité n'est pas dans la liste ? Le module métier est adapté à chaque entreprise — c'est inclus dans la formule.
      </p>
      <a
        href="/contact"
        class="group inline-flex shrink-0 items-center justify-center gap-2 h-12 px-6 text-base font-semibold rounded-full bg-bleu text-bleu-nuit hover:bg-bleu-fonce hover:-translate-y-0.5 shadow-[0_8px_24px_rgba(145,166,255,0.45)] transition-all duration-200 ease-out"
      >
        Décrire mon besoin
        <Icon name="arrow-right" size={18} strokeWidth={2} class="transition-transform duration-300 group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-form-demo]').forEach((demo) => {
    const tabs = Array.from(demo.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    const panelsContainer = demo.querySelector<HTMLElement>('[data-panels]');
    // Les panneaux sont montés paresseusement : seul le 1er est dans le DOM
    // au load ; les autres sont des fragments HTML statiques insérés au 1er
    // clic (ou pré-chargés au survol) sur leur onglet.
    const getPanels = () =>
      Array.from(demo.querySelectorAll<HTMLElement>('[data-panel]'));

    // Monte le panneau `id` s'il n'est pas encore dans le DOM : fetch du
    // fragment statique /fragments/form-panel/[id], insertion dans le
    // conteneur, puis init du JS du panneau (sync live + simulation d'envoi).
    // La promesse est mémoïsée pour dédupliquer hover + clics rapides.
    const mounting = new Map<string, Promise<HTMLElement | null>>();
    const mountPanel = (id: string): Promise<HTMLElement | null> => {
      const existing = demo.querySelector<HTMLElement>(`[data-panel="${id}"]`);
      if (existing) return Promise.resolve(existing);
      let pending = mounting.get(id);
      if (pending) return pending;
      pending = (async () => {
        try {
          const res = await fetch(`/fragments/form-panel/${id}`);
          if (!res.ok || !panelsContainer) return null;
          panelsContainer.insertAdjacentHTML('beforeend', await res.text());
          const panel = demo.querySelector<HTMLElement>(`[data-panel="${id}"]`);
          if (panel) initPanel(panel);
          return panel;
        } catch {
          // Échec réseau : on retire la promesse mémoïsée pour permettre
          // un nouvel essai au prochain clic, et on garde le panneau actuel.
          mounting.delete(id);
          return null;
        }
      })();
      mounting.set(id, pending);
      return pending;
    };

    let wantedId = '';
    const select = async (id: string, focusTab = false) => {
      wantedId = id;
      const panel = await mountPanel(id);
      // Fragment indisponible, ou un autre onglet a été demandé entre-temps :
      // on ne touche pas à l'état courant.
      if (!panel || wantedId !== id) return;
      tabs.forEach((tab) => {
        const active = tab.dataset.tab === id;
        tab.setAttribute('aria-selected', String(active));
        tab.setAttribute('tabindex', active ? '0' : '-1');
        if (active && focusTab) tab.focus();
      });
      getPanels().forEach((p) => {
        const active = p.dataset.panel === id;
        p.dataset.active = String(active);
        if (active) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    };

    tabs.forEach((tab, i) => {
      // Pré-chargement du fragment au survol/focus pour masquer la latence
      // du fetch au clic (le panneau est inséré caché, select() l'affichera).
      const prefetch = () => {
        const id = tab.dataset.tab;
        if (id) void mountPanel(id);
      };
      tab.addEventListener('pointerenter', prefetch);
      tab.addEventListener('focus', prefetch);

      tab.addEventListener('click', () => {
        const id = tab.dataset.tab;
        if (id) select(id);
      });

      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const dir = e.key === 'ArrowRight' ? 1 : -1;
        const next = tabs[(i + dir + tabs.length) % tabs.length];
        const id = next.dataset.tab;
        if (id) select(id, true);
      });
    });

    // Sync live : quand un input du form change, mettre à jour la carte 'Message reçu'
    const placeholder = '—';
    const formatDate = (iso: string): string => {
      if (!iso) return placeholder;
      const d = new Date(iso);
      if (isNaN(d.getTime())) return iso;
      return d.toLocaleDateString('fr-FR', {
        weekday: 'long', day: 'numeric', month: 'long',
      });
    };
    const formatTime = (v: string): string =>
      v ? v.replace(':', 'h') : placeholder;

    const displayValue = (panel: HTMLElement, fieldName: string): string => {
      const form = panel.querySelector<HTMLFormElement>('[data-demo-form]');
      if (!form) return placeholder;

      // 1. Radio group : retrouvé via data-field-name
      const radioChecked = form.querySelector<HTMLInputElement>(
        `input[type="radio"][data-field-name="${fieldName}"]:checked`
      );
      if (radioChecked) {
        return radioChecked.dataset.label || radioChecked.value || placeholder;
      }
      // Si pas de radio coché mais un radio existe avec ce data-field-name → '—'
      const anyRadio = form.querySelector(`input[type="radio"][data-field-name="${fieldName}"]`);
      if (anyRadio) return placeholder;

      // 2. Autres inputs : par name
      const el = form.querySelector<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>(
        `[name="${fieldName}"]`
      );
      if (!el) return placeholder;

      if (el.tagName === 'SELECT') {
        const sel = el as HTMLSelectElement;
        return sel.options[sel.selectedIndex]?.textContent?.trim() || placeholder;
      }
      if (el instanceof HTMLInputElement) {
        if (el.type === 'checkbox') return el.checked ? 'Oui' : 'Non';
        if (el.type === 'date') return formatDate(el.value);
        if (el.type === 'time') return formatTime(el.value);
        if (el.type === 'file') {
          const f = el.files?.[0];
          return f ? f.name : 'Aucune photo jointe';
        }
        return el.value || el.placeholder || placeholder;
      }
      if (el instanceof HTMLTextAreaElement) {
        return el.value || el.placeholder || placeholder;
      }
      return placeholder;
    };

    const syncMessageCard = (panel: HTMLElement) => {
      const card = panel.querySelector<HTMLElement>('[data-message-card]');
      if (!card) return;
      const dds = card.querySelectorAll<HTMLElement>('[data-message-key]');
      dds.forEach((dd) => {
        const name = dd.dataset.messageKey;
        if (!name) return;
        const newValue = displayValue(panel, name);
        if (dd.textContent === newValue) return; // pas de changement → pas de flash
        dd.textContent = newValue;
        // Flash orange bref pour signaler que la valeur a changé en live
        if (typeof dd.animate === 'function') {
          dd.animate(
            [{ color: '#91A6FF' }, { color: '#FEFEFA' }],
            { duration: 700, easing: 'ease-out' }
          );
        }
      });
    };

    // 'Simuler l'envoi' : au submit du form, on déclenche une animation sur la
    // carte conversation (pulse + flash de la bulle 9site4). Pas d'envoi réel.
    const simulateSend = (panel: HTMLElement) => {
      const card = panel.querySelector<HTMLElement>('[data-message-card]');
      if (!card) return;

      // Pulse + glow orange de toute la carte
      if (typeof card.animate === 'function') {
        card.animate(
          [
            { transform: 'scale(1)',     boxShadow: '0 0 0 0 rgba(145, 166, 255, 0)' },
            { transform: 'scale(1.015)', boxShadow: '0 0 0 8px rgba(145, 166, 255, 0.35)' },
            { transform: 'scale(1)',     boxShadow: '0 0 0 0 rgba(145, 166, 255, 0)' },
          ],
          { duration: 800, easing: 'ease-out' }
        );
      }

      // Flash subtil du fond de la bulle 9site4 (notification reçue)
      const notif = card.querySelector<HTMLElement>('[data-notif-bubble]');
      if (notif && typeof notif.animate === 'function') {
        notif.animate(
          [
            { backgroundColor: 'rgba(145, 166, 255, 0.22)' },
            { backgroundColor: 'rgba(254, 254, 250, 1)' },
          ],
          { duration: 700, easing: 'ease-out' }
        );
      }

      // Sur mobile, scroller doucement vers la conversation pour voir l'effet
      if (window.matchMedia('(max-width: 1023px)').matches) {
        card.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    };

    // Init par panneau : appelé au load pour le panneau inline, et au 1er
    // montage (insertion du fragment) pour les autres.
    function initPanel(panel: HTMLElement) {
      const form = panel.querySelector<HTMLFormElement>('[data-demo-form]');
      if (!form) return;
      form.addEventListener('input', () => syncMessageCard(panel));
      form.addEventListener('change', () => syncMessageCard(panel));
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        simulateSend(panel);
      });
    }

    getPanels().forEach(initPanel);
  });
</script>
