<section
  id="formulaires-integres"
  class="relative overflow-hidden px-6 py-12 md:py-16"
  aria-labelledby="formulaires-titre"
>

  <div class="relative mx-auto max-w-content">
    <!-- Header centré : eyebrow + titre stratégique + double paragraphe -->
