---
import Icon from '../ui/Icon.astro';

/**
 * Douleur — scène problème / solution en split-screen (sans photo).
 * Gauche : infos dispersées (chaos contrôlé, désaturé). Droite : 9site4 ordonné.
 */

const chaos = [
  { label: 'Vous êtes ouverts ?', pos: 'left-3 top-2', rot: '-rotate-3' },
  { label: 'C\'est combien ?', pos: 'right-4 top-5', rot: 'rotate-2' },
  { label: 'Vous faites quoi exactement ?', pos: 'left-6 top-20', rot: 'rotate-1' },
  { label: 'Je peux réserver ?', pos: 'right-3 top-24', rot: '-rotate-2' },
  { label: 'C\'est où ?', pos: 'left-2 top-40', rot: 'rotate-3' },
  { label: 'Dispo ce week-end ?', pos: 'right-6 top-44', rot: '-rotate-1' },
  { label: 'Vous livrez ?', pos: 'left-1/3 top-32', rot: 'rotate-2' },
];

const sources = [
  { icon: 'instagram', label: 'Instagram' },
  { icon: 'globe', label: 'Google' },
  { icon: 'message-circle', label: 'WhatsApp' },
  { icon: 'image', label: 'Story' },
];

const ordered = [
  { icon: 'clock', label: 'Horaires clairs, toujours à jour' },
  { icon: 'list', label: 'Prestations et tarifs présentés' },
  { icon: 'map-pin', label: 'Adresse et zone d\'intervention' },
];
---

<section class="relative px-6 py-14 md:py-20 overflow-hidden" aria-labelledby="douleur-titre">
  <div class="mx-auto max-w-content">
    <div class="max-w-3xl mx-auto text-center">
      <h2
        id="douleur-titre"
        class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-tight"
      >
        Vos clients ne devraient pas chercher vos infos partout.
      </h2>
      <p class="scroll-reveal mt-5 text-lg text-blanc-casse/65 leading-relaxed">
        Instagram ou Facebook ne suffisent pas. Quand vos informations sont
        dispersées, vos clients hésitent, repoussent ou passent à quelqu'un
        d'autre.
      </p>
    </div>

    <div class="scroll-reveal relative mt-14 grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-10 items-stretch">
      <!-- Séparateur central "vs" (desktop) -->
      <div class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full bg-bleu text-white items-center justify-center font-sora font-bold text-sm shadow-card-hover ring-4 ring-black" aria-hidden="true">
        vs
      </div>

      <!-- AVANT : chaos sur fond bleu mauve -->
      <div class="relative rounded-[1.75rem] bg-bleu p-7 md:p-8 overflow-hidden">
        <div class="flex items-center gap-2.5">
          <span class="flex w-9 h-9 rounded-full bg-white/20 text-white items-center justify-center">
            <Icon name="alert-triangle" size={17} strokeWidth={2} />
          </span>
          <p class="font-sora font-semibold text-lg text-white">Sans 9site4</p>
        </div>

        <div class="mt-5 flex flex-wrap gap-2">
          {sources.map((s) => (
            <span class="inline-flex items-center gap-1.5 h-8 px-3 rounded-full bg-blanc-casse ring-1 ring-bleu-nuit/10 text-xs font-medium text-bleu-nuit/70">
              <Icon name={s.icon} size={13} strokeWidth={2} />
              {s.label}
            </span>
          ))}
        </div>

        <!-- Nuage de questions (chaos lisible) -->
        <div class="relative mt-6 h-64" aria-hidden="true">
          {chaos.map((c) => (
            <span class={`absolute ${c.pos} ${c.rot} inline-flex items-center max-w-[62%] rounded-2xl rounded-bl-sm bg-blanc-casse ring-1 ring-bleu-nuit/10 px-3 py-1.5 text-[12.5px] text-bleu-nuit/75 shadow-sm`}>
              {c.label}
            </span>
          ))}
        </div>

        <p class="mt-2 text-sm text-white/85 leading-relaxed">
          Des questions répétées, des demandes éparses, des prospects qui hésitent.
        </p>
      </div>

      <!-- AVEC : 9site4 ordonné -->
      <div class="relative rounded-[1.75rem] bg-white ring-2 ring-bleu/50 shadow-[0_10px_40px_-12px_rgba(145,166,255,0.5)] p-7 md:p-8">
        <div class="flex items-center gap-2.5">
          <span class="flex w-9 h-9 rounded-full bg-bleu/25 text-bleu-nuit items-center justify-center">
            <Icon name="check" size={17} strokeWidth={2.5} />
          </span>
          <p class="font-sora font-semibold text-lg text-bleu-nuit">Avec 9site4</p>
        </div>

        <div class="relative mt-6 space-y-2.5">
          {ordered.map((o) => (
            <div class="flex items-center gap-3 rounded-xl bg-bleu-nuit/[0.03] px-4 py-3">
              <span class="flex w-8 h-8 rounded-lg bg-white ring-1 ring-bleu-nuit/10 text-bleu-nuit/70 items-center justify-center shrink-0">
                <Icon name={o.icon} size={16} strokeWidth={2} />
              </span>
              <span class="text-sm font-medium text-bleu-nuit">{o.label}</span>
            </div>
          ))}
          <div class="flex items-center justify-between gap-3 rounded-xl bg-bleu/15 ring-1 ring-bleu/40 px-4 py-3">
            <span class="flex items-center gap-3">
              <span class="flex w-8 h-8 rounded-lg bg-bleu text-white items-center justify-center shrink-0">
                <Icon name="file-text" size={16} strokeWidth={2} />
              </span>
              <span class="text-sm font-semibold text-bleu-nuit">Formulaire métier intégré</span>
            </span>
            <span class="inline-flex items-center gap-1.5 h-6 px-2.5 rounded-full bg-bleu-nuit text-white text-[10px] font-semibold shrink-0">
              <span class="w-1.5 h-1.5 rounded-full bg-[#25D366]"></span> Demande reçue
            </span>
          </div>
        </div>

        <p class="relative mt-5 text-sm text-bleu-nuit/60 leading-relaxed">
          9site4 rassemble tout dans un site clair, local et prêt à transformer
          vos visiteurs en clients.
        </p>
      </div>
    </div>
  </div>
</section>
