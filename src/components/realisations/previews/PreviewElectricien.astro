---
import data from '../../../data/templates/volta.json';
/**
 * Mini-preview Volta — photo plein cadre tableau électrique.
 */
---

<div class="absolute inset-0 bg-volta-noir text-volta-fumee overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(8 12 18 / 0.45) 0%, rgb(8 12 18 / 0.10) 30%, rgb(8 12 18 / 0.15) 50%, rgb(8 12 18 / 0.95) 100%),
         linear-gradient(90deg, rgb(8 12 18 / 0.60) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-center gap-1">
      <svg width="9" height="9" viewBox="0 0 24 24" fill="currentColor" class="text-volta-cyan"><path d="M13 2L4.5 13.5H11L10 22L20.5 10H14L13 2Z"/></svg>
      <span class="font-syne font-bold text-volta-blanc text-[11px]">Volta</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-volta-fumee/85 font-medium">
      <span>Services</span>
      <span>Urgence</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <div class="flex items-center gap-1 mb-1">
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full rounded-full bg-volta-cyan opacity-75 animate-ping"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-volta-cyan"></span>
      </span>
      <span class="font-space-grotesk text-[5.5px] uppercase tracking-[0.22em] text-volta-cyan font-semibold">
        URGENCE 24h/24
      </span>
    </div>
    <p class="font-syne font-extrabold text-volta-blanc leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      L'électricité,<br/>
      <span class="text-volta-cyan">c'est sérieux.</span>
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-volta-cyan text-volta-noir font-space-grotesk font-bold text-[6.5px] uppercase tracking-wider">
        Devis gratuit
      </span>
      <span class="font-space-grotesk text-volta-fumee text-[7px] tabular-nums">0692 12 34 56</span>
    </div>
  </div>
</div>
