---
/**
 * Mini-preview Volta — tableau électrique digital.
 */
---

<div class="absolute inset-0 bg-volta-noir text-volta-fumee overflow-hidden">
  <svg class="absolute inset-0 w-full h-full opacity-20" aria-hidden="true">
    <defs>
      <pattern id="grid-volta" width="14" height="14" patternUnits="userSpaceOnUse">
        <path d="M14 0H0V14" fill="none" stroke="#06D4F5" stroke-width="0.3"/>
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid-volta)"/>
  </svg>

  <svg class="absolute top-0 right-0 h-full" width="120" viewBox="0 0 120 200" aria-hidden="true">
    <g stroke="#06D4F5" stroke-width="1.2" fill="none" opacity="0.6">
      <path d="M120 30H80V70H40"/>
      <path d="M120 90H100V140H60"/>
      <circle cx="80" cy="30" r="2" fill="#06D4F5"/>
      <circle cx="40" cy="70" r="2" fill="#06D4F5"/>
      <circle cx="60" cy="140" r="2" fill="#06D4F5"/>
    </g>
  </svg>

  <svg class="absolute right-4 top-1/2 -translate-y-1/2" width="70" height="100" viewBox="0 0 40 60" aria-hidden="true">
    <path d="M22 0L4 32h12L12 60l24-36H22z" fill="#06D4F5"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-space-grotesk font-bold text-volta-cyan text-[10px] tracking-wide">VOLTA<span class="text-volta-cuivre">.</span></span>
    <span class="font-jetbrains text-[6px] text-volta-fumee/60 uppercase tracking-wider">// 220V</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[70%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-volta-cyan mb-1">Électricité générale</p>
    <p class="font-space-grotesk font-bold text-volta-blanc leading-[0.9]" style="font-size: clamp(18px, 3.8vw, 30px);">Sous tension,</p>
    <p class="font-space-grotesk font-bold text-volta-cyan leading-[0.9]" style="font-size: clamp(18px, 3.8vw, 30px);">sans souci.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-volta-cyan text-volta-noir font-space-grotesk font-bold text-[6.5px] uppercase tracking-wider">Devis gratuit</span>
  </div>
</div>
