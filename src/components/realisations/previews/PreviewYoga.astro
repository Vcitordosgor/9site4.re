---
/**
 * Mini-preview Souffle Studio — slow & contemplatif.
 */
---

<div class="absolute inset-0 bg-yoga-creme text-yoga-encre overflow-hidden">
  <div class="absolute -top-8 left-1/2 -translate-x-1/2 w-32 h-32 rounded-full bg-yoga-ocre/35" aria-hidden="true"></div>

  <svg class="absolute right-4 bottom-6" width="80" height="80" viewBox="0 0 80 80" aria-hidden="true">
    <g fill="#3F4A3A">
      <circle cx="40" cy="22" r="8"/>
      <path d="M40 32 Q28 38 22 56 Q20 66 28 68 L52 68 Q60 66 58 56 Q52 38 40 32"/>
      <ellipse cx="20" cy="62" rx="14" ry="5"/>
      <ellipse cx="60" cy="62" rx="14" ry="5"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-yoga-encre text-[10px]">Souffle Studio</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-yoga-ocre font-semibold">Yoga</span>
  </div>

  <div class="absolute left-3 right-3 bottom-3 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-yoga-mousse mb-1">Studio · Saint-Leu</p>
    <p class="font-fraunces leading-[0.95] font-medium" style="font-size: clamp(16px, 3.4vw, 26px);">Inspirer,</p>
    <p class="font-fraunces italic text-yoga-ocre leading-[0.95]" style="font-size: clamp(16px, 3.4vw, 26px);">expirer.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-yoga-mousse text-yoga-creme font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Cours d'essai</span>
  </div>
</div>
