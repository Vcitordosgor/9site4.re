---
import data from '../../../data/templates/souffle.json';
/**
 * Mini-preview Souffle Studio — photo plein cadre yoga contemplatif.
 */
---

<div class="absolute inset-0 bg-yoga-creme text-yoga-encre font-spectral overflow-hidden">

  <img
    src={data.info.photoLieu}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(30 25 22 / 0.30) 0%, rgb(30 25 22 / 0) 32%, rgb(30 25 22 / 0) 48%, rgb(30 25 22 / 0.92) 100%),
         linear-gradient(90deg, rgb(30 25 22 / 0.45) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-dm-serif text-yoga-creme text-[11px]">Souffle</span>
      <span class="font-spectral italic text-yoga-ocre text-[9px]">Studio</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-yoga-creme/85 font-light">
      <span>Planning</span>
      <span>Pratiques</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-lexend text-[5.5px] uppercase tracking-[0.32em] text-yoga-ocre mb-1">
      Studio · La Réunion
    </p>
    <p class="font-dm-serif text-yoga-creme leading-[1.0]" style="font-size: clamp(14px, 3vw, 24px);">
      Le yoga,
    </p>
    <p class="font-spectral italic font-light text-yoga-ocre leading-[1.0]" style="font-size: clamp(14px, 3vw, 24px);">
      comme on respire.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-yoga-ocre text-yoga-creme font-lexend font-semibold text-[6px] uppercase tracking-wider rounded-full">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-yoga-creme/45 text-yoga-creme font-lexend font-semibold text-[6px] uppercase tracking-wider rounded-full">
        Planning
      </span>
    </div>
  </div>
</div>
