---
/**
 * Mini-preview Encre Volcan — studio tatouage.
 */
---

<div class="absolute inset-0 bg-tatoo-noir text-tatoo-creme overflow-hidden">
  <span class="absolute top-2 left-2 right-2 bottom-2 border border-tatoo-creme/30" aria-hidden="true"></span>
  <span class="absolute top-2.5 left-2.5 right-2.5 bottom-2.5 border border-tatoo-rouge/40" aria-hidden="true"></span>

  <svg class="absolute right-4 top-1/2 -translate-y-1/2" width="80" height="120" viewBox="0 0 60 100" aria-hidden="true">
    <rect x="14" y="34" width="32" height="3" fill="#EEE6D8"/>
    <rect x="26" y="20" width="8" height="14" fill="#A11920"/>
    <circle cx="30" cy="18" r="3.5" fill="#EEE6D8"/>
    <polygon points="22,38 38,38 30,90" fill="#EEE6D8" stroke="#A11920" stroke-width="0.8"/>
    <line x1="30" y1="38" x2="30" y2="84" stroke="#A11920" stroke-width="0.6"/>
    <g fill="#A11920">
      <path d="M10 60 Q14 50 12 40 Q18 50 16 60Z"/>
      <path d="M50 60 Q46 50 48 40 Q42 50 44 60Z"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-3">
    <span class="font-bodoni italic font-bold text-tatoo-creme text-[11px]">Encre <span class="text-tatoo-rouge">Volcan</span></span>
    <span class="font-jetbrains text-[6px] uppercase tracking-[0.2em] text-tatoo-creme/60">EST. 2012</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[55%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-tatoo-rouge mb-1">Studio · Saint-Denis</p>
    <p class="font-bodoni leading-[0.92] font-medium text-tatoo-creme" style="font-size: clamp(15px, 3.2vw, 26px);">L'encre,</p>
    <p class="font-bodoni italic text-tatoo-rouge leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">à vie.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-tatoo-rouge text-tatoo-creme font-jetbrains font-semibold text-[6px] uppercase tracking-wider">Voir le book</span>
  </div>
</div>
