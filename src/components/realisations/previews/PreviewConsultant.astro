---
/**
 * Mini-preview Lucas Ferrier — portfolio Notion/terminal.
 */
---

<div class="absolute inset-0 bg-lucas-noir text-lucas-perle overflow-hidden font-jetbrains">
  <div class="relative flex items-center justify-between px-3 pt-2 border-b border-lucas-anthracite pb-1.5">
    <span class="text-lucas-vert text-[8px]">~/lucas-ferrier</span>
    <span class="text-lucas-encre text-[7px]">consultant.md</span>
  </div>

  <div class="absolute left-3 right-3 top-8 text-[7px] leading-snug">
    <p class="text-lucas-encre">// strategy advisor</p>
    <p class="text-lucas-perle">const <span class="text-lucas-vert">help</span> = (you) =&gt;</p>
    <p class="pl-2 text-lucas-perle">you.<span class="text-lucas-vert">grow</span>();</p>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="text-lucas-vert text-[5.5px] uppercase tracking-[0.25em] mb-1">$ whoami</p>
    <p class="font-instrument italic text-lucas-blanc leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 24px);">Lucas Ferrier.</p>
    <p class="font-instrument text-lucas-perle leading-[0.95]" style="font-size: clamp(13px, 2.6vw, 18px);">Consultant indépendant.</p>
    <p class="mt-1.5 inline-flex items-center gap-1 text-lucas-vert text-[6.5px]">
      <span class="inline-block w-1.5 h-1.5 bg-lucas-vert animate-pulse"></span>
      <span>disponible · book a call →</span>
    </p>
  </div>
</div>
