---
/**
 * Mini-preview Lucas Ferrier — photo plein cadre workspace consultant.
 */
---

<div class="absolute inset-0 bg-lucas-noir text-lucas-blanc font-hanken overflow-hidden">


  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(8 10 14 / 0.45) 0%, rgb(8 10 14 / 0.05) 30%, rgb(8 10 14 / 0.10) 50%, rgb(8 10 14 / 0.95) 100%),
         linear-gradient(90deg, rgb(8 10 14 / 0.6) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="text-lucas-vert text-[8px]">▶</span>
      <span class="font-hanken font-medium text-lucas-blanc text-[9px]">Lucas Ferrier</span>
      <span class="font-space-mono text-lucas-vert text-[5.5px]">/ consultant</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-lucas-blanc/85 font-medium">
      <span>Missions</span>
      <span>Tarifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-space-mono text-[5.5px] text-lucas-vert mb-1">
      ▶ $ whoami → Disponible début 2026
    </p>
    <p class="font-instrument italic text-lucas-blanc leading-[1.0]" style="font-size: clamp(13px, 2.7vw, 22px);">
      J'aide les entreprises à <span class="text-lucas-vert">vraiment</span> utiliser le digital.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-lucas-vert text-lucas-noir font-hanken font-semibold text-[6.5px]">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-lucas-blanc/45 text-lucas-blanc font-hanken font-semibold text-[6.5px]">
        Missions
      </span>
    </div>
  </div>
</div>
