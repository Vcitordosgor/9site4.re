---
/**
 * Mini-preview Maison Marléne — boutique-hôtel raffiné.
 */
---

<div class="absolute inset-0 bg-marlene-nacre text-marlene-noir overflow-hidden">
  <div class="absolute -top-6 left-1/2 -translate-x-1/2 w-[80%] aspect-square rounded-t-full bg-marlene-sable" aria-hidden="true"></div>
  <div class="absolute top-3 left-1/2 -translate-x-1/2 w-[60%] aspect-square rounded-t-full bg-marlene-rose/70" aria-hidden="true"></div>
  <span class="absolute top-1/2 left-3 right-3 h-px bg-marlene-champagne/60" aria-hidden="true"></span>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-marlene-noir text-[10px]">Maison Marléne</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-marlene-champagne font-semibold">Institut</span>
  </div>

  <div class="absolute inset-x-0 bottom-3 px-3 text-center">
    <p class="font-cormorant italic leading-[0.95] text-marlene-bordeaux" style="font-size: clamp(20px, 4.2vw, 36px);">soin · charnel</p>
    <p class="mt-1 font-outfit text-[6.5px] uppercase tracking-[0.32em] text-marlene-moka">Beauté · Saint-Gilles</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-marlene-bordeaux text-marlene-nacre font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Prendre rendez-vous</span>
  </div>
</div>
