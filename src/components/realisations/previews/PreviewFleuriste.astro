---
import data from '../../../data/templates/frangipane.json';
/**
 * Mini-preview Frangipane — photo bouquet pastel + wordmark Cormorant italique éditorial.
 */
---

<div class="absolute inset-0 overflow-hidden" style="background-color: #F4E6E0; color: #2A2520;">

  <!-- Photo plein cadre -->
  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.04]"
    loading="lazy"
    decoding="async"
  />

  <!-- Overlay : poudre rose chaude + assombrissement bas -->
  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(244 230 224 / 0.2) 0%, rgb(42 37 32 / 0) 30%, rgb(42 37 32 / 0) 45%, rgb(42 37 32 / 0.92) 100%),
         linear-gradient(90deg, rgb(42 37 32 / 0.35) 0%, transparent 55%);">
  </div>

  <!-- Mini top-bar -->
  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic font-medium text-[11px]" style="color: #F4E6E0;">
      Frangipane
    </span>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider font-semibold" style="color: rgba(244, 230, 224, 0.85);">
      <span>Mariage</span>
      <span>Bouquet</span>
    </div>
  </div>

  <!-- Petite annotation -->
  <p class="absolute top-7 right-3 font-cormorant italic text-[8px]" style="color: #C49B62;">
    atelier floral ∼
  </p>

  <!-- Contenu : bas-gauche style éditorial -->
  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-jakarta font-semibold text-[5.5px] uppercase tracking-[0.25em] mb-1" style="color: #C49B62;">
      <span class="inline-block w-3 h-px" style="background-color: #C49B62;" aria-hidden="true"></span>
      <span>Depuis 2019 · La Réunion</span>
    </p>
    <p class="font-cormorant italic leading-[0.92] tracking-tight" style="color: #F4E6E0; font-size: clamp(15px, 3.2vw, 26px); font-weight: 500;">
      Frangipane.
    </p>
    <p class="mt-0.5 font-cormorant italic leading-tight" style="color: #C49B62; font-size: clamp(8px, 1.6vw, 12px);">
      Composer comme on écrit.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 font-jakarta font-semibold text-[6px] uppercase tracking-wider rounded-full" style="background-color: #5C7448; color: #F4E6E0;">
        Compositions
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 font-jakarta font-semibold text-[6px] uppercase tracking-wider rounded-full" style="color: #F4E6E0; --tw-ring-color: rgba(244, 230, 224, 0.5);">
        Mariage
      </span>
    </div>
  </div>
</div>
