---
/**
 * Mini-preview Sève & Sel — wedding cérémonie plage.
 */
---

<div class="absolute inset-0 bg-seve-ivoire text-seve-marine overflow-hidden">
  <div class="absolute inset-x-0 bottom-0 h-1/2" style="background: linear-gradient(180deg, transparent 0%, #EDD6C9 100%);" aria-hidden="true"></div>

  <svg class="absolute left-1/2 top-[44%] -translate-x-1/2 -translate-y-1/2" width="160" height="120" viewBox="0 0 160 120" aria-hidden="true">
    <ellipse cx="80" cy="60" rx="64" ry="44" fill="none" stroke="#B47358" stroke-width="0.4" opacity="0.6"/>
    <g fill="#7B9B7E" opacity="0.85">
      <ellipse cx="20" cy="60" rx="6" ry="2.5" transform="rotate(-60 20 60)"/>
      <ellipse cx="26" cy="42" rx="6" ry="2.5" transform="rotate(-40 26 42)"/>
      <ellipse cx="44" cy="26" rx="6" ry="2.5" transform="rotate(-20 44 26)"/>
      <ellipse cx="116" cy="26" rx="6" ry="2.5" transform="rotate(20 116 26)"/>
      <ellipse cx="134" cy="42" rx="6" ry="2.5" transform="rotate(40 134 42)"/>
      <ellipse cx="140" cy="60" rx="6" ry="2.5" transform="rotate(60 140 60)"/>
      <ellipse cx="134" cy="78" rx="6" ry="2.5" transform="rotate(120 134 78)"/>
      <ellipse cx="116" cy="94" rx="6" ry="2.5" transform="rotate(160 116 94)"/>
      <ellipse cx="44" cy="94" rx="6" ry="2.5" transform="rotate(-160 44 94)"/>
      <ellipse cx="26" cy="78" rx="6" ry="2.5" transform="rotate(-120 26 78)"/>
    </g>
    <g fill="#9C4A3E">
      <circle cx="80" cy="18" r="3"/>
      <circle cx="72" cy="20" r="2.2"/>
      <circle cx="88" cy="20" r="2.2"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-italianno text-seve-or text-[16px] leading-none">Sève &amp; Sel</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-seve-corail font-semibold">Wedding planner</span>
  </div>

  <div class="absolute inset-x-0 bottom-3 px-3 text-center">
    <p class="font-italianno text-seve-marine leading-[0.85]" style="font-size: clamp(28px, 5.8vw, 48px);">
      M<span class="text-seve-or align-middle" style="font-size:0.6em">&amp;</span>J
    </p>
    <p class="mt-1 font-cormorant italic text-seve-marine/85 text-[8px]">L'océan vous marie · Saint-Gilles</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-seve-corail text-seve-ivoire font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Nous rencontrer</span>
  </div>
</div>
