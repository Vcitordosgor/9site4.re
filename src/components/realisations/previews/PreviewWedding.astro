---
import data from '../../../data/templates/seve.json';
/**
 * Mini-preview Sève & Sel — photo plein cadre wedding éditorial.
 */
---

<div class="absolute inset-0 bg-seve-ivoire text-seve-marine font-outfit overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(30 38 50 / 0.32) 0%, rgb(30 38 50 / 0) 32%, rgb(30 38 50 / 0) 50%, rgb(30 38 50 / 0.92) 100%),
         linear-gradient(90deg, rgb(30 38 50 / 0.45) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-italianno text-seve-ivoire text-[14px] leading-none">Sève</span>
      <span class="font-italianno text-seve-or text-[14px] leading-none">&amp; Sel</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.2em] text-seve-ivoire/85 font-medium">
      <span>Cérémonies</span>
      <span>Lieux</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1 font-outfit text-[5px] uppercase tracking-[0.32em] text-seve-or mb-1">
      <span class="block w-3 h-px bg-seve-or" aria-hidden="true"></span>
      <span>Wedding planner · depuis 2017</span>
    </p>
    <p class="font-italianno text-seve-ivoire leading-[0.85]" style="font-size: clamp(28px, 5.5vw, 46px);">
      S<span class="text-seve-or align-middle" style="font-size:0.7em">&amp;</span>S
    </p>
    <p class="mt-0.5 font-cormorant italic text-seve-ivoire/90 leading-tight" style="font-size: clamp(9px, 1.8vw, 13px);">
      L'océan vous marie.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-seve-or text-seve-marine font-outfit font-semibold text-[6px] uppercase tracking-[0.18em]">
        Nous rencontrer
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-seve-ivoire/45 text-seve-ivoire font-outfit font-semibold text-[6px] uppercase tracking-[0.18em]">
        Cérémonies
      </span>
    </div>
  </div>
</div>
