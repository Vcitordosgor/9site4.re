---
import data from '../../../data/templates/latitude.json';
/**
 * Mini-preview Studio Latitude — photo plein cadre auteur.
 */
---

<div class="absolute inset-0 bg-latitude-noir text-latitude-blanc font-hanken overflow-hidden">

  <img
    src="/images/photographe/extra-1.webp"
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(10 10 12 / 0.40) 0%, rgb(10 10 12 / 0.05) 30%, rgb(10 10 12 / 0.10) 50%, rgb(10 10 12 / 0.95) 100%),
         linear-gradient(90deg, rgb(10 10 12 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-dm-serif text-latitude-blanc text-[10px]">Studio</span>
      <span class="font-dm-serif italic text-latitude-or text-[10px]">Latitude.</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-latitude-blanc/85 font-medium">
      <span>Portfolio</span>
      <span>Tarifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-hanken uppercase text-latitude-or mb-1" style="font-size:5.5px;letter-spacing:0.32em;">
      ✦ Photo d'auteur · 2016
    </p>
    <p class="font-dm-serif text-latitude-blanc leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Studio
    </p>
    <p class="font-dm-serif italic text-latitude-or leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Latitude.
    </p>
    <p class="mt-0.5 font-instrument italic text-latitude-blanc/90 leading-tight" style="font-size: clamp(8px, 1.6vw, 12px);">
      L'image juste, jamais l'image facile.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-latitude-or text-latitude-noir font-hanken font-semibold text-[6.5px] uppercase tracking-wider">
        Portfolio
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-latitude-blanc/45 text-latitude-blanc font-hanken font-semibold text-[6.5px] uppercase tracking-wider">
        Contact
      </span>
    </div>
  </div>
</div>
