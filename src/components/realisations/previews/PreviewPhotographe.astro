---
/**
 * Mini-preview Studio Latitude — planche-contact chambre noire.
 */
---

<div class="absolute inset-0 bg-latitude-noir text-latitude-blanc overflow-hidden">
  <div class="absolute inset-x-3 top-8 bottom-12 grid grid-cols-3 grid-rows-2 gap-1" aria-hidden="true">
    <div class="bg-latitude-charbon border border-latitude-cendre/40 flex items-center justify-center text-[6px] font-jetbrains text-latitude-or">01</div>
    <div class="bg-latitude-cendre/40 border border-latitude-cendre/40"></div>
    <div class="bg-latitude-charbon border border-latitude-cendre/40 flex items-center justify-center text-[6px] font-jetbrains text-latitude-or">03</div>
    <div class="bg-latitude-charbon border border-latitude-cendre/40 flex items-center justify-center text-[6px] font-jetbrains text-latitude-or">04</div>
    <div class="bg-latitude-charbon border-2 border-latitude-labo flex items-center justify-center text-[6px] font-jetbrains text-latitude-labo">★ 05</div>
    <div class="bg-latitude-cendre/40 border border-latitude-cendre/40"></div>
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-latitude-papier text-[10px]">Studio Latitude</span>
    <span class="font-jetbrains text-[6px] uppercase tracking-[0.25em] text-latitude-or">— argentique</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-latitude-labo mb-1">— planche-contact #023</p>
    <p class="font-cormorant italic text-latitude-papier leading-[0.95]" style="font-size: clamp(14px, 3vw, 22px);">La lumière, le grain.</p>
    <span class="mt-1 inline-flex items-center h-3 px-2 bg-latitude-labo text-latitude-papier font-jetbrains font-semibold text-[6px] uppercase tracking-wider">Voir la série</span>
  </div>
</div>
