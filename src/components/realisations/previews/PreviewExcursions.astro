---
/**
 * Mini-preview Sentiers Croisés — aventure rando.
 */
---

<div class="absolute inset-0 bg-sentiers-foret text-sentiers-brume overflow-hidden">
  <svg class="absolute inset-0 w-full h-full" viewBox="0 0 200 150" preserveAspectRatio="none" aria-hidden="true">
    <path d="M10 130 Q40 110 50 90 Q60 70 90 75 Q120 80 130 50 Q140 25 180 30" stroke="#F5E6B5" stroke-width="1.5" stroke-dasharray="3 2" fill="none"/>
    <circle cx="10" cy="130" r="3" fill="#5C8A4A"/>
    <circle cx="90" cy="75" r="2.5" fill="#5C8A4A"/>
    <polygon points="180,24 184,32 176,32" fill="#B85A3D"/>
  </svg>

  <div class="absolute top-2 right-3 w-10 h-10 rounded-full bg-sentiers-soleil opacity-80" aria-hidden="true"></div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-sentiers-brume text-[10px]">Sentiers Croisés</span>
    <span class="font-jetbrains text-[6px] uppercase tracking-[0.2em] text-sentiers-lichen font-semibold">Rando</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[68%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-sentiers-soleil mb-1">— Mafate · Salazie · Cilaos</p>
    <p class="font-fraunces leading-[0.92] font-medium text-sentiers-brume" style="font-size: clamp(16px, 3.4vw, 26px);">Marcher</p>
    <p class="font-fraunces italic text-sentiers-terre leading-[0.92]" style="font-size: clamp(16px, 3.4vw, 26px);">l'invisible.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-sentiers-terre text-sentiers-brume font-jetbrains font-semibold text-[6px] uppercase tracking-wider">Choisir un sentier</span>
  </div>
</div>
