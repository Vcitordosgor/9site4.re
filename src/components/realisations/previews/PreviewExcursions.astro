---
/**
 * Mini-preview Sentiers Croisés — photo plein cadre cinématique rando.
 */
---

<div class="absolute inset-0 bg-sentiers-foret text-sentiers-brume font-familjen overflow-hidden">

  <img
    src="/images/sentiers/cilaos.webp"
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(14 40 32 / 0.40) 0%, rgb(14 40 32 / 0.05) 32%, rgb(14 40 32 / 0.10) 50%, rgb(14 40 32 / 0.92) 100%),
         linear-gradient(90deg, rgb(14 40 32 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-0.5">
      <span class="font-familjen font-medium text-sentiers-brume text-[10px]">Sentiers Croisés</span>
      <span class="text-sentiers-soleil text-[6px] ml-0.5">▲</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-sentiers-brume/85 font-medium">
      <span>Sorties</span>
      <span>Galerie</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-roboto-mono text-[5.5px] uppercase tracking-[0.32em] text-sentiers-soleil mb-1 font-medium">
      ▲ Guide rando · depuis 2013
    </p>
    <p class="font-tinos italic text-sentiers-brume leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Le Maïdo<br/>
      <span class="text-sentiers-soleil">n'attend que vous.</span>
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-sentiers-soleil text-sentiers-foret font-familjen font-semibold text-[6.5px]">
        Voir les sorties
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-sentiers-brume/45 text-sentiers-brume font-familjen font-semibold text-[6.5px]">
        Réserver
      </span>
    </div>
  </div>
</div>
