---
/**
 * Mini-preview Boost Conduite — signalétique routière.
 */
---

<div class="absolute inset-0 bg-boost-route text-boost-noir overflow-hidden">
  <div class="absolute bottom-0 inset-x-0 h-10 bg-boost-asphalte" aria-hidden="true"></div>
  <div class="absolute bottom-4 inset-x-3 h-1 flex gap-1.5" aria-hidden="true">
    <span class="flex-1 bg-boost-jaune"></span><span class="flex-1"></span>
    <span class="flex-1 bg-boost-jaune"></span><span class="flex-1"></span>
    <span class="flex-1 bg-boost-jaune"></span><span class="flex-1"></span>
    <span class="flex-1 bg-boost-jaune"></span><span class="flex-1"></span>
  </div>

  <div class="absolute right-3 top-1/2 -translate-y-1/2 w-16 h-16 rounded-full border-[3px] border-boost-route bg-boost-acier flex items-center justify-center">
    <span class="font-archivo font-black text-boost-route text-[18px] leading-none">B</span>
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-archivo font-black text-boost-acier text-[11px] tracking-wide">BOOST <span class="text-boost-jaune bg-boost-noir px-1">.CONDUITE</span></span>
    <span class="font-archivo font-bold text-[6px] uppercase tracking-wider text-boost-feu">● Permis B</span>
  </div>

  <div class="absolute left-3 bottom-12 max-w-[60%]">
    <p class="font-archivo font-bold text-[5.5px] uppercase tracking-[0.25em] text-boost-feu mb-1">→ ta route commence ici.</p>
    <p class="font-archivo font-black leading-[0.88] text-boost-noir" style="font-size: clamp(17px, 3.6vw, 28px);">Permis<br/>au <span class="text-boost-acier">premier</span> coup.</p>
  </div>
  <span class="absolute bottom-1.5 left-3 inline-flex items-center h-3 px-2 bg-boost-jaune text-boost-noir font-archivo font-black text-[6.5px] uppercase tracking-wider">Je m'inscris</span>
</div>
