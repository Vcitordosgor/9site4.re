---
/**
 * Mini-preview Onde — studio audio.
 */
---

<div class="absolute inset-0 bg-onde-noir text-onde-creme overflow-hidden">
  <div class="absolute -top-12 -right-12 w-40 h-40 rounded-full" style="background: radial-gradient(circle, #7C3AED 0%, transparent 70%);" aria-hidden="true"></div>
  <div class="absolute -bottom-10 -left-10 w-32 h-32 rounded-full" style="background: radial-gradient(circle, #22D3EE 0%, transparent 70%); opacity: 0.5;" aria-hidden="true"></div>

  <svg class="absolute left-3 right-3 top-1/2 -translate-y-1/2 w-[calc(100%-1.5rem)]" height="60" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true">
    <g fill="#22D3EE">
      <rect x="0" y="26" width="3" height="8"/><rect x="6" y="20" width="3" height="20"/><rect x="12" y="10" width="3" height="40"/>
      <rect x="18" y="22" width="3" height="16"/><rect x="24" y="4" width="3" height="52" fill="#7C3AED"/><rect x="30" y="14" width="3" height="32"/>
      <rect x="36" y="22" width="3" height="16"/><rect x="42" y="8" width="3" height="44"/><rect x="48" y="20" width="3" height="20"/>
      <rect x="54" y="24" width="3" height="12"/><rect x="60" y="14" width="3" height="32" fill="#7C3AED"/><rect x="66" y="6" width="3" height="48"/>
      <rect x="72" y="20" width="3" height="20"/><rect x="78" y="24" width="3" height="12"/><rect x="84" y="10" width="3" height="40"/>
      <rect x="90" y="16" width="3" height="28" fill="#7C3AED"/><rect x="96" y="22" width="3" height="16"/><rect x="102" y="4" width="3" height="52"/>
      <rect x="108" y="20" width="3" height="20"/><rect x="114" y="24" width="3" height="12"/><rect x="120" y="14" width="3" height="32"/>
      <rect x="126" y="10" width="3" height="40" fill="#7C3AED"/><rect x="132" y="22" width="3" height="16"/><rect x="138" y="8" width="3" height="44"/>
      <rect x="144" y="20" width="3" height="20"/><rect x="150" y="24" width="3" height="12"/><rect x="156" y="14" width="3" height="32"/>
      <rect x="162" y="22" width="3" height="16"/><rect x="168" y="6" width="3" height="48" fill="#7C3AED"/><rect x="174" y="20" width="3" height="20"/>
      <rect x="180" y="26" width="3" height="8"/><rect x="186" y="22" width="3" height="16"/><rect x="192" y="26" width="3" height="8"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-space-grotesk font-bold text-onde-creme text-[10px]">ONDE <span class="text-onde-cyan">●</span></span>
    <span class="font-jetbrains text-[6px] uppercase tracking-[0.2em] text-onde-violet">// REC</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[70%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-onde-cyan mb-1">Studio · prod · mix · master</p>
    <p class="font-space-grotesk font-bold leading-[0.9] text-onde-creme" style="font-size: clamp(17px, 3.6vw, 28px);">Donner</p>
    <p class="font-instrument italic text-onde-violet leading-[0.9]" style="font-size: clamp(17px, 3.6vw, 28px);">du corps au son.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-onde-violet text-onde-creme font-space-grotesk font-bold text-[6.5px] uppercase tracking-wider rounded-full">Réserver le studio</span>
  </div>
</div>
