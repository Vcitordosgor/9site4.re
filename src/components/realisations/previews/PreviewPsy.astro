---
/**
 * Mini-preview Camille Aubry — photo plein cadre, ambiance feutrée.
 */
---

<div class="absolute inset-0 bg-aubry-perle text-aubry-encre font-albert overflow-hidden">


  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(28 30 45 / 0.32) 0%, rgb(28 30 45 / 0) 32%, rgb(28 30 45 / 0) 48%, rgb(28 30 45 / 0.92) 100%),
         linear-gradient(90deg, rgb(28 30 45 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-caslon text-aubry-perle text-[11px]">Camille Aubry<span class="text-aubry-rose">.</span></span>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-aubry-perle/85 font-light">
      <span>Approche</span>
      <span>Cadre</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-plex-mono text-[5.5px] uppercase tracking-[0.28em] text-aubry-rose mb-1">
      Cabinet · La Réunion
    </p>
    <p class="font-caslon italic text-aubry-rose leading-none mb-0.5" style="font-size: clamp(22px, 4.5vw, 36px);">I.</p>
    <p class="font-caslon text-aubry-perle leading-[1.05]" style="font-size: clamp(13px, 2.6vw, 22px);">
      Une consultation,<br/>
      <span class="italic">ça commence par un appel.</span>
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-aubry-rose text-aubry-encre font-albert font-semibold text-[6px] uppercase tracking-wider">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-aubry-perle/45 text-aubry-perle font-albert font-semibold text-[6px] uppercase tracking-wider">
        Le cadre
      </span>
    </div>
  </div>
</div>
