---
/**
 * Mini-preview Camille Aubry — carnet intime.
 */
---

<div class="absolute inset-0 bg-aubry-perle text-aubry-encre overflow-hidden">
  <div class="absolute inset-x-3 top-10 bottom-12 flex flex-col justify-between opacity-30" aria-hidden="true">
    <span class="block h-px bg-aubry-nuit/40"></span>
    <span class="block h-px bg-aubry-nuit/40"></span>
    <span class="block h-px bg-aubry-nuit/40"></span>
    <span class="block h-px bg-aubry-nuit/40"></span>
    <span class="block h-px bg-aubry-nuit/40"></span>
  </div>
  <div class="absolute top-0 right-6 w-3 h-12 bg-aubry-prune" aria-hidden="true"></div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-newsreader italic text-aubry-encre text-[10px]">Camille Aubry</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-aubry-prune font-semibold">Psychologue</span>
  </div>

  <div class="absolute left-3 right-3 bottom-3 max-w-[80%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-aubry-prune mb-1">— pour penser à voix basse</p>
    <p class="font-newsreader leading-[0.95] text-aubry-nuit" style="font-size: clamp(15px, 3.2vw, 25px);">
      <span class="italic">Parler,</span><br/>
      écouter,<br/>
      <span class="italic text-aubry-prune">comprendre.</span>
    </p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 ring-1 ring-aubry-nuit text-aubry-nuit font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Première séance</span>
  </div>
</div>
