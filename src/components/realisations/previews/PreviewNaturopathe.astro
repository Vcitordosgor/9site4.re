---

<div class="absolute inset-0 bg-source-eau text-source-charbon overflow-hidden">
  <div class="absolute -bottom-8 -right-8 w-40 h-40 rounded-full bg-source-amande/50" aria-hidden="true"></div>

  <svg class="absolute right-6 top-7" width="70" height="90" viewBox="0 0 60 80" aria-hidden="true">
    <path d="M30 4 Q14 30 14 46 Q14 60 30 60 Q46 60 46 46 Q46 30 30 4Z" fill="#5D7C68" opacity="0.85"/>
    <ellipse cx="42" cy="68" rx="14" ry="5" fill="#5D7C68" transform="rotate(20 42 68)" opacity="0.7"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-source-charbon text-[10px]">Source</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-source-mousse font-semibold">Naturopathe</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-source-mousse mb-1">Bilans · phytothérapie</p>
    <p class="font-fraunces leading-[0.92] font-medium text-source-charbon" style="font-size: clamp(15px, 3.2vw, 26px);">Revenir</p>
    <p class="font-fraunces italic text-source-mousse leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">à soi.</p>
