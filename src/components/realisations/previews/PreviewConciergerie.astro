---
import data from '../../../data/templates/concierge.json';
/**
 * Mini-preview Concierge & Co — photo plein cadre boutique-hôtel.
 */
---

<div class="absolute inset-0 bg-concierge-champagne text-concierge-encre font-hubot overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(20 30 50 / 0.32) 0%, rgb(20 30 50 / 0) 32%, rgb(20 30 50 / 0) 48%, rgb(20 30 50 / 0.92) 100%),
         linear-gradient(90deg, rgb(20 30 50 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-volkhov italic text-concierge-champagne text-[10px]">Concierge</span>
      <span class="font-volkhov text-concierge-laiton text-[9px] tracking-wide">&amp; Co</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-concierge-champagne/85 font-medium">
      <span>Services</span>
      <span>Formules</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-pinyon text-concierge-laiton leading-none mb-0.5" style="font-size: clamp(14px, 2.8vw, 22px);">
      Bienvenue.
    </p>
    <p class="font-volkhov italic text-concierge-champagne leading-[0.95]" style="font-size: clamp(15px, 3vw, 24px);">
      Concierge <span class="not-italic text-concierge-laiton">&amp; Co</span>
    </p>
    <p class="mt-0.5 font-hubot text-concierge-champagne/85 leading-tight" style="font-size: clamp(7px, 1.4vw, 11px);">
      Conciergerie privée · La Réunion
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-concierge-laiton text-concierge-nuit font-hubot font-medium text-[6px] uppercase tracking-[0.18em]">
        Nous contacter
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-concierge-champagne/45 text-concierge-champagne font-hubot text-[6px] uppercase tracking-[0.18em]">
        Formules
      </span>
    </div>
  </div>
</div>
