---
/**
 * Mini-preview Concierge & Co — service haut de gamme.
 */
---

<div class="absolute inset-0 bg-concierge-champagne text-concierge-encre overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-16 bg-concierge-nuit" aria-hidden="true"></div>

  <svg class="absolute right-3 top-2 z-10" width="60" height="60" viewBox="0 0 60 60" aria-hidden="true">
    <g stroke="#C49A5A" stroke-width="1.4" fill="none" stroke-linecap="round">
      <circle cx="14" cy="14" r="6"/>
      <line x1="18" y1="18" x2="48" y2="48"/>
      <line x1="44" y1="44" x2="48" y2="40"/>
      <line x1="40" y1="48" x2="44" y2="52"/>
      <circle cx="46" cy="14" r="6"/>
      <line x1="42" y1="18" x2="12" y2="48"/>
      <line x1="16" y1="44" x2="12" y2="40"/>
      <line x1="20" y1="48" x2="16" y2="52"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2 text-concierge-champagne">
    <span class="font-cormorant italic text-[10px]">Concierge &amp; Co</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.3em] text-concierge-laiton">— 24/7</span>
  </div>

  <span class="absolute top-[60px] left-3 right-3 h-px bg-concierge-laiton/40" aria-hidden="true"></span>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[65%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-concierge-bordeaux mb-1">Conciergerie locative · Réunion</p>
    <p class="font-cormorant leading-[0.92] font-medium text-concierge-encre" style="font-size: clamp(15px, 3.2vw, 26px);">Votre bien,</p>
    <p class="font-cormorant italic text-concierge-nuit leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">entre bonnes mains.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-concierge-nuit text-concierge-champagne font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Estimer mes revenus</span>
  </div>
</div>
