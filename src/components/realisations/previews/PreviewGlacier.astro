---
/**
 * Mini-preview Sorbet Péi — glacier artisanal POP.
 */
---

<div class="absolute inset-0 bg-sorbet-creme text-sorbet-cacao overflow-hidden">
  <div class="absolute top-6 left-6 w-2 h-2 rounded-full bg-sorbet-letchi-clair" aria-hidden="true"></div>
  <div class="absolute top-12 left-14 w-1.5 h-1.5 rounded-full bg-sorbet-mangue-clair" aria-hidden="true"></div>
  <div class="absolute bottom-12 left-4 w-2 h-2 rounded-full bg-sorbet-vert" aria-hidden="true"></div>

  <svg class="absolute right-3 bottom-3" width="100" height="140" viewBox="0 0 60 100" aria-hidden="true">
    <circle cx="30" cy="20" r="14" fill="#FFB347"/>
    <circle cx="20" cy="32" r="12" fill="#FF6F91"/>
    <circle cx="40" cy="34" r="11" fill="#A8D5BA"/>
    <polygon points="12,42 48,42 30,92" fill="#FFD93D" stroke="#3D2817" stroke-width="0.8"/>
    <line x1="20" y1="52" x2="40" y2="58" stroke="#3D2817" stroke-width="0.5"/>
    <line x1="18" y1="62" x2="42" y2="68" stroke="#3D2817" stroke-width="0.5"/>
    <line x1="22" y1="72" x2="38" y2="78" stroke="#3D2817" stroke-width="0.5"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bagel text-sorbet-cacao text-[12px]">Sorbet Péi</span>
    <span class="font-outfit font-bold text-[6px] uppercase tracking-wider text-sorbet-letchi">Glacier</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[55%]">
    <p class="font-outfit font-bold text-[5.5px] uppercase tracking-[0.25em] text-sorbet-vert mb-1">— 100 % fruits péi</p>
    <p class="font-bagel leading-[0.88] text-sorbet-cacao" style="font-size: clamp(15px, 3.2vw, 24px);">Mangue.<br/><span class="text-sorbet-letchi">Letchi.</span></p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-sorbet-mangue text-sorbet-cacao font-outfit font-bold text-[6.5px] uppercase tracking-wider rounded-full">Les parfums</span>
  </div>
</div>
