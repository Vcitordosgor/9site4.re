---
import data from '../../../data/templates/sorbetpei.json';
/**
 * Mini-preview Sorbet Péi — photo plein cadre + overlay pastel + wordmark Fraunces italique + sticker prix.
 */
---

<div class="absolute inset-0 overflow-hidden" style="background-color: #FFF8E7; color: #3D2817;">

  <!-- Photo plein cadre -->
  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.04]"
    loading="lazy"
    decoding="async"
  />

  <!-- Overlay : pastel chaud + assombrissement bas -->
  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(255 248 231 / 0.25) 0%, rgb(61 40 23 / 0) 30%, rgb(61 40 23 / 0) 45%, rgb(61 40 23 / 0.92) 100%),
         linear-gradient(90deg, rgb(61 40 23 / 0.35) 0%, transparent 55%);">
  </div>

  <!-- Mini top-bar -->
  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces font-semibold text-[10px]" style="color: #FFF8E7;">
      Sorbet <em class="italic" style="color: #FF6F91;">Péi</em>
    </span>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider font-semibold" style="color: rgba(255, 248, 231, 0.85);">
      <span>Parfums</span>
      <span>Tournée</span>
    </div>
  </div>

  <!-- Sticker prix flottant -->
  <div class="absolute top-7 right-3 w-9 h-9 rounded-full flex flex-col items-center justify-center font-dm-sans font-bold" style="background-color: #FFD93D; color: #3D2817; border: 1.5px solid #3D2817; transform: rotate(-12deg);">
    <span class="text-[10px] leading-none">3€</span>
    <span class="text-[5px] uppercase tracking-wider mt-0.5">la boule</span>
  </div>

  <!-- Boules SVG mini -->
  <div class="absolute top-9 left-3 flex gap-0.5">
    <div class="w-2 h-2 rounded-full" style="background-color: #FFB347; border: 0.5px solid #3D2817;"></div>
    <div class="w-2 h-2 rounded-full" style="background-color: #FF6F91; border: 0.5px solid #3D2817;"></div>
    <div class="w-2 h-2 rounded-full" style="background-color: #A8D5BA; border: 0.5px solid #3D2817;"></div>
  </div>

  <!-- Contenu bas gauche -->
  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-dm-sans font-semibold text-[5.5px] uppercase tracking-[0.25em] mb-1" style="color: #FFB347;">
      <span class="inline-block w-3 h-px" style="background-color: #FFB347;" aria-hidden="true"></span>
      <span>Depuis 2021 · La Réunion</span>
    </p>
    <p class="font-fraunces font-semibold leading-[0.92] tracking-tight" style="color: #FFF8E7; font-size: clamp(15px, 3.2vw, 25px);">
      Sorbet
      <em class="font-fraunces italic" style="color: #FF6F91;">Péi.</em>
    </p>
    <p class="mt-0.5 font-fraunces italic leading-tight" style="color: #FFB347; font-size: clamp(8px, 1.6vw, 13px);">
      Tous les fruits péi, en cône.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 font-dm-sans font-semibold text-[6px] uppercase tracking-wider rounded-full" style="background-color: #FF6F91; color: #FFF8E7;">
        Voir parfums
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 font-dm-sans font-semibold text-[6px] uppercase tracking-wider rounded-full" style="color: #FFF8E7; --tw-ring-color: rgba(255, 248, 231, 0.5);">
        Tournée
      </span>
    </div>
  </div>
</div>
