---
import data from '../../../data/templates/auberval.json';
/**
 * Mini-preview Cabinet Auberval — photo plein cadre institutionnel.
 */
---

<div class="absolute inset-0 bg-auberval-feutre text-auberval-marine font-plex-sans overflow-hidden">

  <img
    src={data.info.photoCabinet}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(20 30 50 / 0.30) 0%, rgb(20 30 50 / 0) 32%, rgb(20 30 50 / 0) 48%, rgb(20 30 50 / 0.92) 100%),
         linear-gradient(90deg, rgb(20 30 50 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-source-serif text-auberval-feutre text-[10px]">Auberval</span>
      <span class="font-source-serif italic text-auberval-or text-[8px]">&amp; Associés</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-auberval-feutre/85 font-medium">
      <span>Associés</span>
      <span>Expertise</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-dm-mono text-[5.5px] uppercase tracking-[0.32em] text-auberval-or mb-1">
      Cabinet · depuis 2009
    </p>
    <p class="font-source-serif text-auberval-feutre leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Auberval<br/>
      <span class="italic text-auberval-or">&amp; Associés.</span>
    </p>
    <p class="mt-0.5 font-plex-sans text-auberval-feutre/85 leading-tight" style="font-size: clamp(8px, 1.6vw, 12px);">
      Expertise comptable · La Réunion.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-auberval-or text-auberval-marine font-plex-sans font-semibold text-[6px] uppercase tracking-wider">
        Nous rencontrer
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-auberval-feutre/45 text-auberval-feutre font-plex-sans font-semibold text-[6px] uppercase tracking-wider">
        Notre expertise
      </span>
    </div>
  </div>
</div>
