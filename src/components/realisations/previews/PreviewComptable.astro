---
/**
 * Mini-preview Auberval & Associés — rapport annuel.
 */
---

<div class="absolute inset-0 bg-auberval-feutre text-auberval-marine overflow-hidden">
  <span class="absolute top-7 left-3 right-3 h-px bg-auberval-or/60" aria-hidden="true"></span>
  <span class="absolute top-8 left-3 right-3 h-px bg-auberval-or/30" aria-hidden="true"></span>
  <span class="absolute bottom-9 left-3 right-3 h-px bg-auberval-or/40" aria-hidden="true"></span>

  <svg class="absolute right-4 top-1/2 -translate-y-1/2" width="56" height="56" viewBox="0 0 60 60" aria-hidden="true">
    <circle cx="30" cy="30" r="26" fill="none" stroke="#A78A4F" stroke-width="1"/>
    <circle cx="30" cy="30" r="22" fill="none" stroke="#A78A4F" stroke-width="0.5"/>
    <text x="30" y="27" text-anchor="middle" font-size="6" font-family="serif" font-style="italic" fill="#1A2944">A&amp;A</text>
    <text x="30" y="37" text-anchor="middle" font-size="3.5" font-family="serif" fill="#A78A4F" letter-spacing="1">CERTIFIÉ</text>
    <circle cx="30" cy="44" r="1.2" fill="#4F7A5C"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-auberval-marine text-[10px]">Auberval &amp; Associés</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.3em] text-auberval-or font-semibold">— EST. 1978</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-auberval-encre mb-1">Expert-comptable · CAC</p>
    <p class="font-cormorant leading-[0.92] font-medium text-auberval-marine" style="font-size: clamp(16px, 3.4vw, 26px);">Les chiffres,</p>
    <p class="font-cormorant italic text-auberval-or leading-[0.92]" style="font-size: clamp(16px, 3.4vw, 26px);">l'évidence.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-auberval-marine text-auberval-feutre font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Bilan gratuit</span>
  </div>
</div>
