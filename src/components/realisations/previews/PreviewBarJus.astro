---
/**
 * Mini-preview Lagon Pressé — POP tropical saturé.
 */
---

<div class="absolute inset-0 bg-lagon-mangue text-lagon-charbon overflow-hidden">
  <div class="absolute -bottom-20 -left-10 w-[140%] h-40 rounded-full bg-lagon-turquoise" aria-hidden="true"></div>

  <svg class="absolute -top-10 -right-10" width="160" height="160" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="48" fill="#E84B7C"/>
    <circle cx="50" cy="50" r="38" fill="#FFF8EC"/>
    <g stroke="#E84B7C" stroke-width="1.5" fill="none">
      <line x1="50" y1="14" x2="50" y2="86"/>
      <line x1="14" y1="50" x2="86" y2="50"/>
      <line x1="24" y1="24" x2="76" y2="76"/>
      <line x1="76" y1="24" x2="24" y2="76"/>
    </g>
    <circle cx="50" cy="50" r="6" fill="#A8DC2A"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bagel text-lagon-charbon text-[12px]">Lagon Pressé</span>
    <span class="font-archivo font-black text-[6px] uppercase tracking-wider text-lagon-charbon">Menu</span>
  </div>

  <div class="absolute left-3 bottom-2.5 right-3">
    <p class="font-archivo font-black uppercase leading-[0.85] text-lagon-blanc tracking-tight" style="font-size: clamp(16px, 3.6vw, 30px);">Pressé <span class="text-lagon-lime">frais</span></p>
    <p class="font-archivo font-black uppercase leading-[0.85] text-lagon-blanc tracking-tight" style="font-size: clamp(16px, 3.6vw, 30px);">sur place.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-lagon-pitaya text-lagon-blanc font-archivo font-black text-[6.5px] uppercase tracking-wider rounded-full">Commander →</span>
  </div>
</div>
