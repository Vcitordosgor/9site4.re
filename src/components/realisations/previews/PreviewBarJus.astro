---
import data from '../../../data/templates/lagon.json';
/**
 * Mini-preview Le Lagon Frais — photo plein cadre + overlay + wordmark bas.
 */
---

<div class="absolute inset-0 bg-lagon-mangue text-lagon-charbon overflow-hidden">

  <!-- Photo plein cadre -->
  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.04]"
    loading="lazy"
    decoding="async"
  />

  <!-- Overlay : assombrissement bas pour lisibilité + voile mangue -->
  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(255 184 28 / 0.18) 0%, rgb(28 28 28 / 0) 35%, rgb(28 28 28 / 0) 45%, rgb(28 28 28 / 0.85) 100%),
         linear-gradient(90deg, rgb(28 28 28 / 0.45) 0%, transparent 55%);">
  </div>

  <!-- Mini top-bar transparente -->
  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bagel text-lagon-blanc text-[11px] tracking-tight">
      Le Lagon <span class="text-lagon-pitaya">Frais</span>
    </span>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-lagon-blanc/85 font-bold">
      <span>Carte</span>
      <span>Bowls</span>
    </div>
  </div>

  <!-- Sticker prix flottant -->
  <div class="absolute top-7 right-3 w-9 h-9 bg-lagon-lime text-lagon-charbon rounded-full flex flex-col items-center justify-center font-bagel ring-2 ring-lagon-charbon shadow-md" style="transform: rotate(10deg);">
    <span class="text-[10px] leading-none">5€</span>
    <span class="text-[5px] uppercase tracking-wider mt-0.5">le jus</span>
  </div>

  <!-- Annotation manuscrite -->
  <p class="absolute top-2 left-1/2 -translate-x-1/2 font-architects text-lagon-blanc/90 text-[7px] -rotate-2 mt-5">
    La Réunion · 974 ✿
  </p>

  <!-- Contenu : bas-gauche style éditorial POP -->
  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-bagel text-lagon-blanc leading-[0.88] tracking-tight" style="font-size: clamp(16px, 3.6vw, 30px);">
      LE LAGON<br/>
      <span class="text-lagon-pitaya">FRAIS.</span>
    </p>
    <p class="mt-1 font-onest font-medium text-lagon-blanc/85 text-[7px] leading-snug max-w-[78%]">
      Tout ce qui pousse, on le presse devant toi.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3.5 px-2 bg-lagon-pitaya text-lagon-blanc font-bagel text-[6.5px] rounded-full tracking-wide">
        COMMANDER →
      </span>
      <span class="inline-flex items-center h-3.5 px-2 ring-1 ring-lagon-blanc/50 text-lagon-blanc font-bagel text-[6.5px] rounded-full tracking-wide">
        VOIR LA CARTE
      </span>
    </div>
  </div>
</div>
