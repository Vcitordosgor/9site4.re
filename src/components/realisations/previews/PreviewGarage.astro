---
/**
 * Mini-preview Atelier Motorpiton — fiche atelier mécanique.
 */
---

<div class="absolute inset-0 bg-piton-asphalte text-piton-beton overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-1 bg-piton-feu" aria-hidden="true"></div>

  <svg class="absolute -right-6 -bottom-6" width="160" height="160" viewBox="0 0 100 100" aria-hidden="true">
    <g fill="#FF5A1F" opacity="0.92">
      <path d="M50 8l4 8h-8zM50 92l4-8h-8zM8 50l8-4v8zM92 50l-8-4v8zM20 20l8 2-6 6zM80 20l-8 2 6 6zM20 80l8-2-6-6zM80 80l-8-2 6-6z"/>
      <circle cx="50" cy="50" r="32"/>
    </g>
    <circle cx="50" cy="50" r="12" fill="#0F1014"/>
    <circle cx="50" cy="50" r="4" fill="#FF5A1F"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-3">
    <span class="font-bebas text-piton-feu text-[12px] tracking-wider">MOTORPITON</span>
    <span class="font-jetbrains text-[6px] uppercase tracking-wider text-piton-acide">// DIAG OK</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[60%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-piton-feu mb-1">Garage · Le Tampon</p>
    <p class="font-bebas leading-[0.85] tracking-wider text-piton-blanc" style="font-size: clamp(20px, 4.2vw, 34px);">RÉPARER<br/>VITE<span class="text-piton-feu">.</span></p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-piton-feu text-piton-asphalte font-bebas text-[7px] tracking-wider">Devis express</span>
  </div>
</div>
