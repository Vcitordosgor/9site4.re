---
/**
 * Mini-preview Le Pain Levé — boulangerie artisanale.
 */
---

<div class="absolute inset-0 bg-pain-mie text-pain-charbon overflow-hidden">
  <svg class="absolute right-3 top-6 bottom-6" width="60" viewBox="0 0 40 100" aria-hidden="true">
    <line x1="20" y1="20" x2="20" y2="98" stroke="#5C4A2E" stroke-width="1.5"/>
    <g fill="#A87842" stroke="#5C4A2E" stroke-width="0.4">
      <ellipse cx="20" cy="14" rx="3" ry="6"/>
      <ellipse cx="14" cy="22" rx="2.5" ry="5" transform="rotate(-30 14 22)"/>
      <ellipse cx="26" cy="22" rx="2.5" ry="5" transform="rotate(30 26 22)"/>
      <ellipse cx="14" cy="34" rx="2.5" ry="5" transform="rotate(-30 14 34)"/>
      <ellipse cx="26" cy="34" rx="2.5" ry="5" transform="rotate(30 26 34)"/>
      <ellipse cx="14" cy="46" rx="2.5" ry="5" transform="rotate(-30 14 46)"/>
      <ellipse cx="26" cy="46" rx="2.5" ry="5" transform="rotate(30 26 46)"/>
      <ellipse cx="14" cy="58" rx="2.5" ry="5" transform="rotate(-30 14 58)"/>
      <ellipse cx="26" cy="58" rx="2.5" ry="5" transform="rotate(30 26 58)"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-pain-charbon text-[10px]">Le Pain Levé</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-pain-croute font-semibold">Boulangerie</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-pain-or mb-1">Levain naturel · cuit au feu</p>
    <p class="font-fraunces leading-[0.92] font-medium text-pain-charbon" style="font-size: clamp(15px, 3.2vw, 26px);">Le pain,</p>
    <p class="font-fraunces italic text-pain-croute leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">vivant.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-pain-croute text-pain-mie font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Voir la fournée</span>
  </div>
</div>
