---
/**
 * Mini-preview Maison Adèle — noir/blanc/vert forêt.
 */
---

<div class="absolute inset-0 bg-salon-blanc text-salon-noir overflow-hidden">
  <div class="absolute top-0 bottom-0 left-0 w-2 bg-salon-vert" aria-hidden="true"></div>

  <svg class="absolute right-3 top-1/2 -translate-y-1/2 opacity-90" width="80" height="80" viewBox="0 0 64 64" aria-hidden="true">
    <g stroke="#2D4A3A" stroke-width="2" fill="none" stroke-linecap="round">
      <circle cx="14" cy="46" r="8"/>
      <circle cx="14" cy="18" r="8"/>
      <line x1="20" y1="22" x2="58" y2="40"/>
      <line x1="20" y1="42" x2="58" y2="24"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bodoni italic text-salon-noir text-[10px]">Maison Adèle</span>
    <span class="font-inter text-[6px] uppercase tracking-[0.2em] text-salon-vert font-semibold">Salon</span>
  </div>

  <div class="absolute left-3 right-16 bottom-2.5">
    <p class="font-inter text-[5.5px] uppercase tracking-[0.32em] text-salon-vert-clair mb-1">Coiffure · Saint-Pierre</p>
    <p class="font-bodoni leading-[0.9] font-medium" style="font-size: clamp(18px, 3.8vw, 32px);">Couper,</p>
    <p class="font-bodoni italic text-salon-vert leading-[0.9]" style="font-size: clamp(18px, 3.8vw, 32px);">sculpter.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-salon-noir text-salon-blanc font-inter font-semibold text-[6px] uppercase tracking-wider">Réserver</span>
  </div>
</div>
