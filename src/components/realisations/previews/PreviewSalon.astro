---
import data from '../../../data/templates/salon.json';
/**
 * Mini-preview Meg & Dan — photo plein cadre salon de coiffure.
 */
---

<div class="absolute inset-0 bg-salon-blanc text-salon-noir overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(20 25 22 / 0.30) 0%, rgb(20 25 22 / 0) 32%, rgb(20 25 22 / 0) 48%, rgb(20 25 22 / 0.92) 100%),
         linear-gradient(90deg, rgb(20 25 22 / 0.50) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-fraunces font-semibold text-salon-blanc text-[11px]">Meg</span>
      <span class="font-fraunces text-salon-vert-clair text-[11px]">&amp;</span>
      <span class="font-fraunces font-semibold text-salon-blanc text-[11px]">Dan</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-salon-blanc/85 font-medium">
      <span>Prestations</span>
      <span>Équipe</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-mulish text-[5.5px] uppercase tracking-[0.3em] text-salon-vert-clair mb-1 font-semibold">
      <span class="inline-block w-3 h-px bg-salon-vert-clair" aria-hidden="true"></span>
      <span>Salon · La Réunion</span>
    </p>
    <p class="font-fraunces font-bold text-salon-blanc leading-[0.95]" style="font-size: clamp(14px, 3vw, 24px);">
      Le geste juste,
    </p>
    <p class="font-fraunces italic font-semibold text-salon-vert-clair leading-[0.95]" style="font-size: clamp(14px, 3vw, 24px);">
      la coupe qui révèle.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-salon-vert text-salon-blanc font-mulish font-semibold text-[6.5px] uppercase tracking-wider rounded-full">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-salon-blanc/45 text-salon-blanc font-mulish font-semibold text-[6.5px] uppercase tracking-wider rounded-full">
        Prestations
      </span>
    </div>
  </div>
</div>
