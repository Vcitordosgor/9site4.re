---
/**
 * Mini-preview Bernard Plomberie — poster industriel.
 */
---

<div class="absolute inset-0 bg-bp-anthracite text-bp-blanc overflow-hidden">
  <div class="absolute -left-6 top-6 w-[140%] h-5 bg-bp-jaune rotate-[-12deg] flex items-center overflow-hidden" aria-hidden="true">
    <div class="flex gap-2 px-2 text-bp-anthracite font-bebas text-[9px] tracking-[0.3em] whitespace-nowrap">
      <span>BERNARD</span><span>★</span><span>PLOMBERIE</span><span>★</span><span>24/7</span><span>★</span><span>BERNARD</span><span>★</span><span>PLOMBERIE</span>
    </div>
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bebas text-bp-jaune text-[11px] tracking-wider">BERNARD</span>
    <span class="inline-flex items-center h-3 px-2 bg-bp-rouge text-bp-blanc font-bebas text-[7px] tracking-wider">URGENCE 24/7</span>
  </div>

  <svg class="absolute right-3 bottom-6 opacity-90" width="72" height="72" viewBox="0 0 64 64" aria-hidden="true">
    <path d="M44 8a12 12 0 0 0-11 17l-22 22 6 6 22-22a12 12 0 1 0 5-23zm0 6a6 6 0 1 1 0 12 6 6 0 0 1 0-12z" fill="#FFC72C"/>
  </svg>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[65%]">
    <p class="font-bebas text-bp-blanc leading-[0.9] tracking-wider" style="font-size: clamp(20px, 4.2vw, 36px);">Fuite ?</p>
    <p class="font-bebas text-bp-jaune leading-[0.9] tracking-wider" style="font-size: clamp(20px, 4.2vw, 36px);">On arrive.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-bp-jaune text-bp-anthracite font-bebas text-[7px] tracking-wider">Appeler →</span>
  </div>
</div>
