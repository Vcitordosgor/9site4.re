---
/**
 * Mini-preview Cabinet Verveine — photo plein cadre médical épuré.
 */
---

<div class="absolute inset-0 bg-verveine-creme text-verveine-encre font-public-sans overflow-hidden">

  <img
    src="https://images.unsplash.com/photo-1631815589968-fdb09a223b1e?w=1200&q=80"
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(30 32 30 / 0.30) 0%, rgb(30 32 30 / 0) 32%, rgb(30 32 30 / 0) 48%, rgb(30 32 30 / 0.90) 100%),
         linear-gradient(90deg, rgb(30 32 30 / 0.50) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-cardo text-verveine-creme text-[11px]">Verveine</span>
      <span class="font-karla text-[6px] uppercase tracking-[0.22em] text-verveine-sauge">D.O.</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-verveine-creme/85 font-medium">
      <span>Approche</span>
      <span>Motifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-karla text-[5.5px] uppercase tracking-[0.32em] text-verveine-sauge mb-1 font-medium">
      Cabinet · La Réunion
    </p>
    <p class="font-cardo text-verveine-creme leading-[1.0]" style="font-size: clamp(14px, 3vw, 24px);">
      Dr Hélène<br/>
      <span class="italic text-verveine-sauge">Vernet.</span>
    </p>
    <p class="mt-0.5 font-cardo italic text-verveine-creme/85 leading-tight" style="font-size: clamp(8px, 1.6vw, 12px);">
      Ostéopathe D.O.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-verveine-sauge text-verveine-creme font-public-sans font-semibold text-[6px] uppercase tracking-wider">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-verveine-creme/45 text-verveine-creme font-public-sans font-semibold text-[6px] uppercase tracking-wider">
        Approche
      </span>
    </div>
  </div>
</div>
