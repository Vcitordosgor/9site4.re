---
/**
 * Mini-preview Cabinet Verveine — médical épuré.
 */
---

<div class="absolute inset-0 bg-verveine-creme text-verveine-encre overflow-hidden">
  <div class="absolute -top-12 -right-12 w-44 h-44 rounded-full bg-verveine-glacier/70" aria-hidden="true"></div>
  <div class="absolute -bottom-10 -left-10 w-32 h-32 rounded-full bg-verveine-sauge/40" aria-hidden="true"></div>

  <svg class="absolute right-6 top-1/2 -translate-y-1/2" width="40" height="100" viewBox="0 0 30 100" aria-hidden="true">
    <g stroke="#5C5C58" stroke-width="1.2" fill="none">
      <path d="M15 5 Q22 15 15 25 Q8 35 15 45 Q22 55 15 65 Q8 75 15 85 Q22 95 15 100"/>
    </g>
    <g fill="#B5C2A8">
      <circle cx="15" cy="15" r="2"/>
      <circle cx="15" cy="30" r="2.5"/>
      <circle cx="15" cy="45" r="2.5"/>
      <circle cx="15" cy="60" r="2.5"/>
      <circle cx="15" cy="75" r="2.5"/>
      <circle cx="15" cy="90" r="2"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-verveine-encre text-[10px]">Cabinet Verveine</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-verveine-beton font-semibold">Ostéopathie</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[65%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-verveine-sauge mb-1">D.O. · Saint-Denis</p>
    <p class="font-cormorant leading-[0.92] font-medium" style="font-size: clamp(17px, 3.6vw, 28px);">Le geste</p>
    <p class="font-cormorant italic text-verveine-beton leading-[0.92]" style="font-size: clamp(17px, 3.6vw, 28px);">qui répare.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-verveine-encre text-verveine-creme font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Prendre RDV</span>
  </div>
</div>
