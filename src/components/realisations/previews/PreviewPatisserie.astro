---
import data from '../../../data/templates/vanille.json';
/**
 * Mini-preview La Vanille de Bel-Air — photo plein cadre pâtisserie.
 */
---

<div class="absolute inset-0 bg-vanille-creme text-vanille-gousse font-karla overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(45 30 22 / 0.32) 0%, rgb(45 30 22 / 0) 32%, rgb(45 30 22 / 0) 48%, rgb(45 30 22 / 0.92) 100%),
         linear-gradient(90deg, rgb(45 30 22 / 0.50) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-yeseva text-vanille-creme text-[10px]">La Vanille</span>
      <span class="font-italianno text-vanille-caramel text-[11px] leading-none">de Bel-Air</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-vanille-creme/85 font-medium">
      <span>Carte</span>
      <span>Commander</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-karla text-[5.5px] uppercase tracking-[0.32em] text-vanille-caramel mb-1 font-semibold">
      ✦ Pâtisserie créole · 2009
    </p>
    <p class="font-yeseva text-vanille-creme leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      La Vanille
    </p>
    <p class="font-italianno text-vanille-caramel leading-none" style="font-size: clamp(14px, 2.8vw, 22px);">
      de Bel-Air.
    </p>
    <p class="mt-0.5 font-yeseva italic text-vanille-creme/90 leading-tight" style="font-size: clamp(7px, 1.4vw, 11px);">
      Le sucre, la vanille, le geste.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-vanille-caramel text-vanille-creme font-karla font-semibold text-[6.5px] uppercase tracking-wider">
        Commander
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-vanille-creme/45 text-vanille-creme font-karla font-semibold text-[6.5px] uppercase tracking-wider">
        Voir la carte
      </span>
    </div>
  </div>
</div>
