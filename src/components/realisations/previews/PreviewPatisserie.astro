---
/**
 * Mini-preview La Vanille de Bel-Air — pâtisserie créole.
 */
---

<div class="absolute inset-0 bg-vanille-creme text-vanille-gousse overflow-hidden">
  <svg class="absolute right-2 top-4" width="100" height="120" viewBox="0 0 100 120" aria-hidden="true">
    <g stroke="#5C3A1E" stroke-width="1.5" fill="#3A2A18" stroke-linecap="round">
      <ellipse cx="18" cy="60" rx="3" ry="48" transform="rotate(8 18 60)" opacity="0.85"/>
      <ellipse cx="50" cy="65" rx="3" ry="48" transform="rotate(-12 50 65)" opacity="0.85"/>
      <ellipse cx="80" cy="62" rx="3" ry="48" transform="rotate(6 80 62)" opacity="0.85"/>
    </g>
    <path d="M14 70 Q44 60 76 72" stroke="#C68642" stroke-width="0.8" fill="none"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-vanille-gousse text-[10px]">La Vanille de Bel-Air</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-vanille-caramel font-semibold">Pâtisserie</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-vanille-pandan mb-1">Saint-André · pâtisserie créole</p>
    <p class="font-cormorant leading-[0.92] font-medium text-vanille-gousse" style="font-size: clamp(15px, 3.2vw, 26px);">Vanille</p>
    <p class="font-cormorant italic text-vanille-caramel leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">Bourbon.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-vanille-gousse text-vanille-creme font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Notre vitrine</span>
  </div>
</div>
