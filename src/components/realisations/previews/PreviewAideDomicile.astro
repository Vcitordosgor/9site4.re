---
import data from '../../../data/templates/doudou.json';
/**
 * Mini-preview Doudou Service — photo plein cadre + overlay doux.
 */
---

<div class="absolute inset-0 bg-doudou-creme text-doudou-encre font-be-vietnam overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(34 30 28 / 0.30) 0%, rgb(34 30 28 / 0) 32%, rgb(34 30 28 / 0) 48%, rgb(34 30 28 / 0.88) 100%),
         linear-gradient(90deg, rgb(34 30 28 / 0.45) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-nunito font-bold text-doudou-creme text-[10px]">
      Doudou <span class="text-doudou-rose">Service</span>
    </span>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-doudou-creme/85 font-semibold">
      <span>Engagements</span>
      <span>Tarifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-be-vietnam font-semibold text-[5.5px] uppercase tracking-[0.25em] text-doudou-soleil mb-1">
      <span class="inline-block w-3 h-px bg-doudou-soleil" aria-hidden="true"></span>
      <span>Agréé · depuis 2010</span>
    </p>
    <p class="font-nunito font-bold text-doudou-creme leading-[0.95]" style="font-size: clamp(14px, 3vw, 24px);">
      Une présence,<br/>
      <span class="text-doudou-soleil">au quotidien.</span>
    </p>
    <p class="mt-0.5 font-homemade text-doudou-rose leading-tight" style="font-size: clamp(9px, 1.7vw, 13px);">
      on prend soin, à La Réunion
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-doudou-rose text-doudou-creme font-be-vietnam font-semibold text-[6px] uppercase tracking-wider rounded-full">
        Visite gratuite
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-doudou-creme/45 text-doudou-creme font-be-vietnam font-semibold text-[6px] uppercase tracking-wider rounded-full">
        Nos services
      </span>
    </div>
  </div>
</div>
