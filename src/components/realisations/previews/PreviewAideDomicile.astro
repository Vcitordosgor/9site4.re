---
/**
 * Mini-preview Doudou Service — doux & humain.
 */
---

<div class="absolute inset-0 bg-doudou-creme text-doudou-encre overflow-hidden">
  <div class="absolute -top-8 -right-8 w-32 h-32 rounded-full bg-doudou-soleil/60" aria-hidden="true"></div>
  <div class="absolute -bottom-10 -left-6 w-32 h-32 rounded-full bg-doudou-ciel/80" aria-hidden="true"></div>

  <svg class="absolute right-4 top-1/2 -translate-y-1/2" width="80" height="60" viewBox="0 0 80 60" aria-hidden="true">
    <g fill="#D38B5E">
      <path d="M10 30 Q10 12 24 12 Q34 12 36 22 L36 40 Q36 50 26 50 L18 50 Q10 50 10 42 Z"/>
    </g>
    <g fill="#5B3B6E">
      <path d="M70 30 Q70 12 56 12 Q46 12 44 22 L44 40 Q44 50 54 50 L62 50 Q70 50 70 42 Z"/>
    </g>
    <ellipse cx="40" cy="32" rx="6" ry="3.5" fill="#3A2E2A" opacity="0.3"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-doudou-bleu text-[10px]">Doudou Service</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-doudou-rose font-semibold">Aide à domicile</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-doudou-bourgeon mb-1">— Lé là pou ou.</p>
    <p class="font-fraunces leading-[0.95] font-medium text-doudou-encre" style="font-size: clamp(15px, 3.2vw, 24px);">Bien vivre,</p>
    <p class="font-fraunces italic text-doudou-bleu leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 24px);">chez soi.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-doudou-bleu text-doudou-creme font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Nous appeler</span>
  </div>
</div>
