---
import data from '../../../data/templates/agapanthes.json';
/**
 * Mini-preview Les agapanthes — photo plein cadre jardin créole.
 */
---

<div class="absolute inset-0 bg-agap-lin text-agap-feuille overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(28 38 30 / 0.32) 0%, rgb(28 38 30 / 0) 32%, rgb(28 38 30 / 0) 48%, rgb(28 38 30 / 0.92) 100%),
         linear-gradient(90deg, rgb(28 38 30 / 0.50) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-0.5">
      <span class="font-cormorant italic text-agap-lin text-[10px]">Les</span>
      <span class="font-cormorant italic font-semibold text-agap-violet text-[10px]">agapanthes</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-agap-lin/85 font-medium">
      <span>Services</span>
      <span>Réalisations</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-outfit text-[5.5px] uppercase tracking-[0.32em] text-agap-violet mb-1 font-semibold">
      <span class="inline-block w-3 h-px bg-agap-violet" aria-hidden="true"></span>
      <span>Atelier paysagiste · 974</span>
    </p>
    <p class="font-cormorant font-medium text-agap-lin leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 26px);">
      L'art du jardin
    </p>
    <p class="font-cormorant italic font-medium text-agap-violet leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 26px);">
      à la créole.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-agap-violet text-agap-lin font-outfit font-semibold text-[6.5px] uppercase tracking-wider rounded-full">
        Devis gratuit
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-agap-lin/45 text-agap-lin font-outfit font-semibold text-[6.5px] uppercase tracking-wider rounded-full">
        Réalisations
      </span>
    </div>
  </div>
</div>
