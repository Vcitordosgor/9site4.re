---
/**
 * Mini-preview Elio Spa — Nature Distilled.
 */
---

<div class="absolute inset-0 bg-spa-creme text-spa-cacao overflow-hidden">
  <svg class="absolute -right-16 -top-12 opacity-90" width="220" height="220" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="46" fill="none" stroke="#C67B5C" stroke-width="0.6" opacity="0.35"/>
    <circle cx="50" cy="50" r="36" fill="none" stroke="#C67B5C" stroke-width="0.6" opacity="0.45"/>
    <circle cx="50" cy="50" r="26" fill="none" stroke="#9C5B3D" stroke-width="0.8" opacity="0.55"/>
    <circle cx="50" cy="50" r="16" fill="#E8C9B8" opacity="0.85"/>
    <circle cx="50" cy="50" r="8" fill="#C67B5C"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-spa-cacao text-[10px]">Elio · spa</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-spa-argile font-semibold">Massages</span>
  </div>

  <div class="absolute left-3 right-3 bottom-3 max-w-[65%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-spa-argile mb-1">Spa & massages</p>
    <p class="font-cormorant leading-[0.92] font-medium text-spa-cacao" style="font-size: clamp(18px, 3.8vw, 30px);">Respirer,</p>
    <p class="font-cormorant italic text-spa-terracotta leading-[0.92]" style="font-size: clamp(18px, 3.8vw, 30px);">se reposer.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-spa-argile text-spa-creme font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Réserver un soin</span>
  </div>
</div>
