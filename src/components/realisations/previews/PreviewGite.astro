---
import data from '../../../data/templates/crete-aurere.json';
/**
 * Mini-preview Le Cap Anglais — photo plein cadre gîte de cirque.
 */
---

<div class="absolute inset-0 bg-cap-papier text-cap-charbon font-bricolage overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(28 30 25 / 0.32) 0%, rgb(28 30 25 / 0) 32%, rgb(28 30 25 / 0) 48%, rgb(28 30 25 / 0.92) 100%),
         linear-gradient(90deg, rgb(28 30 25 / 0.50) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-center gap-1">
      <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="text-cap-rouge"><path d="M12 2L4 8l8 14 8-14-8-6z"/><circle cx="12" cy="9" r="2.5" fill="currentColor"/></svg>
      <span class="font-bricolage font-semibold text-cap-papier text-[10px]">Le Cap Anglais</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-cap-papier/85 font-medium">
      <span>Chambres</span>
      <span>Tables</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.28em] text-cap-papier/85 mb-1 font-medium">
      Alt. 1 220 m · Gîte de cirque
    </p>
    <p class="font-bricolage font-semibold text-cap-papier leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Le Cap<br/>
      <span class="text-cap-rouge">Anglais.</span>
    </p>
    <p class="mt-0.5 font-crimson-pro italic text-cap-papier/90 leading-tight" style="font-size: clamp(8px, 1.6vw, 12px);">
      Cilaos · La Réunion
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-cap-mousse text-cap-papier font-bricolage font-semibold text-[6.5px]">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-cap-papier/45 text-cap-papier font-bricolage font-semibold text-[6.5px]">
        Les chambres
      </span>
    </div>
  </div>
</div>
