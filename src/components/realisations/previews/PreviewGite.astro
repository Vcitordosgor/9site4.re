---
/**
 * Mini-preview Le Cap Anglais — topo-guide d'altitude.
 */
---

<div class="absolute inset-0 bg-cap-papier text-cap-charbon overflow-hidden">
  <svg class="absolute inset-x-0 bottom-0 w-full" height="100" viewBox="0 0 200 100" preserveAspectRatio="none" aria-hidden="true">
    <polygon points="0,100 40,40 80,70 130,20 180,60 200,30 200,100" fill="#3D5840" opacity="0.85"/>
    <polygon points="0,100 30,60 70,80 110,50 160,75 200,55 200,100" fill="#6B4F3B" opacity="0.7"/>
    <polygon points="0,100 50,80 100,90 150,82 200,88 200,100" fill="#1B1B17"/>
  </svg>

  <svg class="absolute top-3 right-3" width="34" height="34" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="18" fill="none" stroke="#1B1B17" stroke-width="1"/>
    <polygon points="20,6 23,20 20,34 17,20" fill="#C03A2C"/>
    <polygon points="20,6 20,20 17,20" fill="#1B1B17"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-cap-charbon text-[10px]">Cap Anglais</span>
    <span class="font-jetbrains text-[6px] uppercase tracking-[0.25em] text-cap-mousse font-semibold">2243 m</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[65%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-cap-papier mb-1">— gîte d'étape · Cilaos</p>
    <p class="font-fraunces leading-[0.92] font-medium text-cap-papier" style="font-size: clamp(15px, 3.2vw, 26px);">Dormir</p>
    <p class="font-fraunces italic text-cap-rouge leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">là-haut.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-cap-mousse text-cap-papier font-jetbrains font-semibold text-[6px] uppercase tracking-wider">Réserver une nuit</span>
  </div>
</div>
