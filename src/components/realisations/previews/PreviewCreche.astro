---
/**
 * Mini-preview Le Nid — micro-crèche.
 */
---

<div class="absolute inset-0 bg-nid-creme text-nid-charbon overflow-hidden">
  <div class="absolute -top-6 -left-6 w-28 h-28 rounded-full bg-nid-jaune/85" aria-hidden="true"></div>
  <div class="absolute top-8 right-4 w-16 h-16 rounded-full bg-nid-rose" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-12 w-12 h-12 rounded-full bg-nid-bleu" aria-hidden="true"></div>
  <div class="absolute bottom-3 right-6 w-10 h-10 rounded-full bg-nid-jaune" aria-hidden="true"></div>

  <svg class="absolute right-7 top-11" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="9" cy="10" r="1.5" fill="#2E2A26"/>
    <circle cx="15" cy="10" r="1.5" fill="#2E2A26"/>
    <path d="M8 14 Q12 18 16 14" stroke="#2E2A26" stroke-width="1.4" fill="none" stroke-linecap="round"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-nid-charbon text-[10px]">Le Nid</span>
    <span class="font-outfit font-bold text-[6px] uppercase tracking-wider text-nid-charbon">Micro-crèche</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit font-bold text-[5.5px] uppercase tracking-[0.25em] text-nid-charbon/70 mb-1">Berceau de douceur · 10 enfants</p>
    <p class="font-fraunces leading-[0.92] font-medium text-nid-charbon" style="font-size: clamp(15px, 3.2vw, 26px);">Grandir</p>
    <p class="font-fraunces italic text-nid-charbon leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">en confiance.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-nid-charbon text-nid-creme font-outfit font-bold text-[6px] uppercase tracking-wider rounded-full">Visiter la crèche</span>
  </div>
</div>
