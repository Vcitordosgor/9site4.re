---
import data from '../../../data/templates/borddeau.json';
/**
 * Mini-preview Bord d'eau — vague + wordmark Anton XXL + accents azur/sable.
 */
---

<div class="absolute inset-0 overflow-hidden" style="background-color: #0F2A36; color: #F4F8F7;">

  <!-- Photo plein cadre -->
  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.04]"
    loading="lazy"
    decoding="async"
  />

  <!-- Overlay océan -->
  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(15 42 54 / 0.45) 0%, rgb(15 42 54 / 0.1) 30%, rgb(15 42 54 / 0.4) 60%, rgb(15 42 54 / 0.94) 100%),
         linear-gradient(90deg, rgb(15 42 54 / 0.35) 0%, transparent 55%);">
  </div>

  <!-- Mini top-bar -->
  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-anton text-[10px] uppercase tracking-wider" style="color: #F4F8F7; font-family: 'Anton', Impact, sans-serif;">
      Bord d'eau
    </span>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider font-bold" style="color: rgba(244, 248, 247, 0.85);">
      <span>Formules</span>
      <span>Spots</span>
    </div>
  </div>

  <!-- Badge BEES -->
  <div class="absolute top-7 right-3 px-1.5 py-0.5 rounded-full font-anton text-[6px] uppercase tracking-wider" style="background-color: #E5C99A; color: #0F2A36; font-family: 'Anton', Impact, sans-serif;">
    BEES diplômé
  </div>

  <!-- Contenu : aligné bas-gauche -->
  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-inter font-semibold text-[5.5px] uppercase tracking-[0.25em] mb-1" style="color: #E5C99A;">
      <span class="inline-block w-3 h-px" style="background-color: #E5C99A;" aria-hidden="true"></span>
      <span>10 ans · La Réunion</span>
    </p>
    <p class="font-anton uppercase leading-[0.9] tracking-tight" style="color: #F4F8F7; font-size: clamp(18px, 4vw, 32px); font-family: 'Anton', Impact, sans-serif;">
      Bord<br/>
      <span style="color: #3CACAE;">d'eau.</span>
    </p>
    <p class="mt-0.5 font-inter italic font-medium leading-tight" style="color: #E5C99A; font-size: clamp(7px, 1.5vw, 11px);">
      L'océan, c'est l'école.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 font-anton text-[6.5px] uppercase tracking-wider rounded-full" style="background-color: #3CACAE; color: #F4F8F7; font-family: 'Anton', Impact, sans-serif;">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 font-anton text-[6.5px] uppercase tracking-wider rounded-full" style="color: #F4F8F7; --tw-ring-color: rgba(244, 248, 247, 0.5); font-family: 'Anton', Impact, sans-serif;">
        Formules
      </span>
    </div>
  </div>
</div>
