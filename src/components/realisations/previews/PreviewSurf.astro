---
/**
 * Mini-preview Bord d'eau — école de surf.
 */
---

<div class="absolute inset-0 overflow-hidden" style="background-color: #0F2A36; color: #F4F8F7;">
  <svg class="absolute inset-x-0 bottom-0 w-full" height="120" viewBox="0 0 200 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 80 Q50 30 110 60 Q150 80 200 50 L200 120 L0 120 Z" fill="#3CACAE"/>
    <path d="M0 90 Q40 50 90 75 Q130 95 200 70 L200 120 L0 120 Z" fill="#3CACAE" opacity="0.7"/>
    <path d="M0 102 Q40 78 100 90 Q160 100 200 88 L200 120 L0 120 Z" fill="#0F2A36"/>
    <path d="M50 60 Q70 50 90 60 Q70 56 50 60" fill="#F4F8F7" opacity="0.85"/>
    <path d="M150 58 Q170 50 180 56" stroke="#F4F8F7" stroke-width="1" fill="none" opacity="0.7"/>
  </svg>

  <div class="absolute top-3 right-4 w-8 h-8 rounded-full" style="background-color: #E5C99A;" aria-hidden="true"></div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bebas text-[12px] tracking-wider" style="color: #F4F8F7;">BORD D'EAU</span>
    <span class="font-inter font-bold text-[6px] uppercase tracking-wider" style="color: #E5C99A;">★ BEES</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[60%]">
    <p class="font-inter font-bold text-[5.5px] uppercase tracking-[0.25em] mb-1" style="color: #E5C99A;">École de surf · Saint-Leu</p>
    <p class="font-bebas leading-[0.85] tracking-wider" style="font-size: clamp(20px, 4.2vw, 34px); color: #F4F8F7;">BORD<br/><span style="color: #3CACAE;">D'EAU.</span></p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 font-bebas text-[7px] tracking-wider rounded-full" style="background-color: #3CACAE; color: #F4F8F7;">Premier cours</span>
  </div>
</div>
