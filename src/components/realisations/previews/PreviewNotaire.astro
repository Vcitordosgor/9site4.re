---
import data from '../../../data/templates/notaire.json';
/**
 * Mini-preview Étude Notariale & Associés — photo plein cadre bureau classique.
 */
---

<div class="absolute inset-0 overflow-hidden" style="background-color: #F5F1EB; color: #1A1715;">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(26 23 21 / 0.32) 0%, rgb(26 23 21 / 0) 30%, rgb(26 23 21 / 0) 45%, rgb(26 23 21 / 0.92) 100%),
         linear-gradient(90deg, rgb(26 23 21 / 0.48) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex flex-col leading-tight">
      <span class="font-cormorant italic text-[10px]" style="color: #F5F1EB;">Étude Notariale</span>
      <span class="font-inter uppercase tracking-[0.22em] text-[5.5px]" style="color: #A28B5C;">& Associés</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider font-inter" style="color: rgb(245 241 235 / 0.7);">
      <span>Domaines</span>
      <span>RDV</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-inter text-[5.5px] uppercase tracking-[0.32em] mb-1" style="color: #A28B5C;">
      ✦ Office notarial · 1998
    </p>
    <p class="font-cormorant leading-[0.95]" style="color: #F5F1EB; font-size: clamp(13px, 2.9vw, 22px);">
      Étude Notariale
    </p>
    <p class="font-cormorant italic leading-[0.95]" style="color: #A28B5C; font-size: clamp(13px, 2.9vw, 22px);">
      &amp; Associés.
    </p>
    <p class="mt-0.5 font-cormorant italic leading-tight" style="color: rgb(245 241 235 / 0.88); font-size: clamp(6.5px, 1.4vw, 10px);">
      L'acte qui sécurise, la parole qui rassure.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 font-inter font-semibold text-[6.5px] uppercase tracking-wider" style="background-color: #1A1715; color: #F5F1EB;">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 font-inter font-semibold text-[6.5px] uppercase tracking-wider border" style="border-color: rgb(245 241 235 / 0.5); color: #F5F1EB;">
        Domaines
      </span>
    </div>
  </div>
</div>
