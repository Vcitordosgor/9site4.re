---
/**
 * Mini-preview Étude Notariale — solennel.
 */
---

<div class="absolute inset-0 bg-notaire-marbre text-notaire-noir overflow-hidden">
  <span class="absolute top-9 left-3 right-3 h-px bg-notaire-or" aria-hidden="true"></span>
  <span class="absolute top-[40px] left-3 right-3 h-px bg-notaire-or/50" aria-hidden="true"></span>
  <span class="absolute bottom-9 left-3 right-3 h-px bg-notaire-or/50" aria-hidden="true"></span>

  <svg class="absolute right-3 top-1/2 -translate-y-1/2" width="64" height="64" viewBox="0 0 60 60" aria-hidden="true">
    <defs>
      <radialGradient id="waxgrad" cx="0.3" cy="0.3"><stop offset="0%" stop-color="#A04848"/><stop offset="100%" stop-color="#5C2A2A"/></radialGradient>
    </defs>
    <circle cx="30" cy="30" r="22" fill="url(#waxgrad)"/>
    <circle cx="30" cy="30" r="18" fill="none" stroke="#A28B5C" stroke-width="0.6"/>
    <text x="30" y="34" text-anchor="middle" font-size="11" font-family="serif" fill="#A28B5C" font-style="italic">N</text>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-notaire-noir text-[10px]">Étude Notariale</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.32em] text-notaire-or font-semibold">— Notaire</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[55%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-notaire-bordeaux mb-1">Office · Saint-Denis</p>
    <p class="font-cormorant leading-[0.92] font-medium text-notaire-noir" style="font-size: clamp(15px, 3.2vw, 26px);">Acter,</p>
    <p class="font-cormorant italic text-notaire-bordeaux leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">transmettre.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-notaire-noir text-notaire-marbre font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Prendre rendez-vous</span>
  </div>
</div>
