---
/**
 * Mini-preview Brûlerie d'altitude — café torréfacteur.
 */
---

<div class="absolute inset-0 bg-torref-charbon text-torref-creme overflow-hidden">
  <svg class="absolute left-4 top-4" width="60" height="80" viewBox="0 0 60 80" aria-hidden="true">
    <g fill="none" stroke="#E8DDC7" stroke-width="0.7" opacity="0.45">
      <path d="M10 70 Q20 60 14 50 Q8 40 18 30 Q26 22 20 12"/>
      <path d="M28 70 Q38 60 32 50 Q26 40 36 30 Q44 22 38 12"/>
    </g>
  </svg>

  <svg class="absolute right-3 bottom-3" width="110" height="110" viewBox="0 0 100 100" aria-hidden="true">
    <ellipse cx="50" cy="50" rx="38" ry="46" fill="#3E2A1F" stroke="#B57A4A" stroke-width="1.5" transform="rotate(-22 50 50)"/>
    <path d="M50 6 Q44 50 56 94" stroke="#B57A4A" stroke-width="1.4" fill="none" transform="rotate(-22 50 50)"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-torref-cuivre text-[10px]">Brûlerie d'altitude</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-torref-creme/70 font-semibold">Torréfacteur</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[58%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-torref-cuivre mb-1">— Bourbon Pointu · 1200 m</p>
    <p class="font-fraunces leading-[0.92] font-medium text-torref-creme" style="font-size: clamp(15px, 3.2vw, 25px);">Le café,</p>
    <p class="font-fraunces italic text-torref-cuivre leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 25px);">torréfié ici.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-torref-cuivre text-torref-charbon font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Boutique en ligne</span>
  </div>
</div>
