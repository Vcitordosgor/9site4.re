---
/**
 * Mini-preview Mona Levray — magazine cuisine & santé.
 */
---

<div class="absolute inset-0 bg-mona-creme text-mona-cacao overflow-hidden">
  <div class="absolute -top-10 -left-10 w-40 h-40 rounded-full bg-mona-vert/40" aria-hidden="true"></div>

  <svg class="absolute right-3 top-3" width="90" height="120" viewBox="0 0 60 100" aria-hidden="true">
    <g fill="#9BBC8B" stroke="#6B8C5C" stroke-width="0.6">
      <ellipse cx="20" cy="20" rx="8" ry="14" transform="rotate(-30 20 20)"/>
      <ellipse cx="40" cy="35" rx="9" ry="15" transform="rotate(25 40 35)"/>
      <ellipse cx="22" cy="55" rx="9" ry="16" transform="rotate(-15 22 55)"/>
      <ellipse cx="42" cy="75" rx="8" ry="14" transform="rotate(35 42 75)"/>
    </g>
    <line x1="30" y1="5" x2="30" y2="95" stroke="#6B8C5C" stroke-width="1.2"/>
    <circle cx="50" cy="20" r="3" fill="#C84A5C"/>
    <circle cx="14" cy="42" r="3" fill="#C84A5C"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-fraunces italic text-mona-cacao text-[10px]">Mona Levray</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-mona-vert-fonce font-semibold">Diététique</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[60%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-mona-terracotta mb-1">Nutritionniste · D.E.</p>
    <p class="font-fraunces leading-[0.92] font-medium" style="font-size: clamp(17px, 3.6vw, 28px);">Manger</p>
    <p class="font-fraunces italic text-mona-vert-fonce leading-[0.92]" style="font-size: clamp(17px, 3.6vw, 28px);">vivant.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-mona-vert-fonce text-mona-creme font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">1er rendez-vous</span>
  </div>
</div>
