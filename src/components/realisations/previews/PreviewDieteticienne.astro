---
import data from '../../../data/templates/mona.json';
/**
 * Mini-preview Mona Levray — photo plein cadre cuisine éditoriale.
 */
---

<div class="absolute inset-0 bg-mona-creme text-mona-cacao font-jakarta overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(62 42 30 / 0.30) 0%, rgb(62 42 30 / 0) 32%, rgb(62 42 30 / 0) 48%, rgb(62 42 30 / 0.90) 100%),
         linear-gradient(90deg, rgb(62 42 30 / 0.45) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-newsreader text-mona-creme text-[11px]">Mona Levray</span>
      <span class="block w-1 h-1 rounded-full bg-mona-vert"></span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-mona-creme/85 font-medium">
      <span>Approche</span>
      <span>Programmes</span>
    </div>
  </div>

  <p class="absolute top-2 right-3 mt-5 font-reenie text-mona-creme/90 text-[10px] -rotate-3">
    manger c'est ressentir ✿
  </p>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-jakarta font-semibold text-[5.5px] uppercase tracking-[0.32em] text-mona-creme/85 mb-1">
      Diététique · La Réunion
    </p>
    <p class="font-newsreader text-mona-creme leading-[0.95]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Manger mieux,
      <span class="block italic">sans se priver.</span>
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-mona-terracotta text-mona-creme font-jakarta font-semibold text-[6.5px] uppercase tracking-wider rounded-full">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-mona-creme/45 text-mona-creme font-jakarta font-semibold text-[6.5px] uppercase tracking-wider rounded-full">
        Approche
      </span>
    </div>
  </div>
</div>
