---
/**
 * Mini-preview Pizza Lé O — trattoria éditoriale.
 */
---

<div class="absolute inset-0 bg-pizza-creme text-pizza-charbon overflow-hidden">
  <svg class="absolute -right-8 -bottom-10 opacity-90" width="180" height="180" viewBox="0 0 100 100" aria-hidden="true">
    <circle cx="50" cy="50" r="48" fill="#B89766" opacity="0.18"/>
    <circle cx="50" cy="50" r="42" fill="#A82532" opacity="0.92"/>
    <ellipse cx="35" cy="40" rx="4" ry="2.5" fill="#2D6A4F" transform="rotate(-20 35 40)"/>
    <ellipse cx="62" cy="55" rx="3.5" ry="2" fill="#2D6A4F" transform="rotate(30 62 55)"/>
    <ellipse cx="48" cy="62" rx="3" ry="2" fill="#2D6A4F" transform="rotate(60 48 62)"/>
    <circle cx="42" cy="48" r="3" fill="#FAF7F0" opacity="0.9"/>
    <circle cx="58" cy="42" r="2.5" fill="#FAF7F0" opacity="0.9"/>
    <circle cx="55" cy="60" r="2.5" fill="#FAF7F0" opacity="0.9"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-playfair font-bold italic text-pizza-charbon text-[10px]">Pizza <span class="text-pizza-rouge">Lé O</span></span>
    <span class="font-dm-sans text-[6px] uppercase tracking-wider text-pizza-charbon/60">Commander</span>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5 max-w-[70%]">
    <p class="flex items-center gap-1.5 font-dm-sans font-semibold text-[5.5px] uppercase tracking-[0.25em] text-pizza-dore mb-1">
      <span class="inline-block w-3 h-px bg-pizza-dore" aria-hidden="true"></span>
      <span>Trattoria · depuis 2014</span>
    </p>
    <p class="font-playfair font-bold leading-[0.92] tracking-tight" style="font-size: clamp(18px, 3.8vw, 30px);">Pizza Lé O</p>
    <p class="mt-0.5 font-playfair italic font-medium text-pizza-rouge leading-tight" style="font-size: clamp(8px, 1.6vw, 13px);">La Réunion, à l'italienne.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-pizza-rouge text-pizza-creme font-dm-sans font-semibold text-[6px] uppercase tracking-wider rounded-full">Voir la carte</span>
  </div>
</div>
