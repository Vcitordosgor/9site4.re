---
/**
 * Mini-preview Étude Roussin — photo plein cadre cabinet d'avocat.
 */
---

<div class="absolute inset-0 bg-roussin-velin text-roussin-nuit font-public-sans overflow-hidden">

  <img
    src="https://images.unsplash.com/photo-1589994965851-a8f479c573a9?w=1200&q=80"
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(22 28 40 / 0.35) 0%, rgb(22 28 40 / 0) 32%, rgb(22 28 40 / 0) 48%, rgb(22 28 40 / 0.92) 100%),
         linear-gradient(90deg, rgb(22 28 40 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-eb-garamond text-roussin-velin text-[11px]">Roussin</span>
      <span class="font-eb-garamond italic text-roussin-or text-[8px]">&amp; Associés</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-roussin-velin/85 font-medium">
      <span>Domaines</span>
      <span>Associés</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="flex items-center gap-1.5 font-public-sans font-semibold text-[5.5px] uppercase tracking-[0.28em] text-roussin-or mb-1">
      <span class="inline-block w-3 h-px bg-roussin-or" aria-hidden="true"></span>
      <span>Barreau · depuis 2008</span>
    </p>
    <p class="font-eb-garamond text-roussin-velin leading-[0.95]" style="font-size: clamp(16px, 3.2vw, 26px);">
      Roussin
    </p>
    <p class="font-eb-garamond italic text-roussin-or leading-tight" style="font-size: clamp(10px, 2vw, 16px);">
      Le droit, sans la posture.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-roussin-bordeaux text-roussin-velin font-public-sans font-semibold text-[6px] uppercase tracking-wider">
        Prendre RDV
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-roussin-velin/45 text-roussin-velin font-public-sans font-semibold text-[6px] uppercase tracking-wider">
        Nos domaines
      </span>
    </div>
  </div>
</div>
