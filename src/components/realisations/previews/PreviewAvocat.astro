---
/**
 * Mini-preview Étude Roussin — cabinet d'avocats.
 */
---

<div class="absolute inset-0 bg-roussin-velin text-roussin-encre overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-9 bg-roussin-nuit" aria-hidden="true"></div>
  <span class="absolute top-10 left-3 right-3 h-px bg-roussin-or" aria-hidden="true"></span>
  <span class="absolute top-[44px] left-3 right-3 h-px bg-roussin-or/40" aria-hidden="true"></span>

  <svg class="absolute right-3 top-12" width="80" height="90" viewBox="0 0 60 70" aria-hidden="true">
    <g stroke="#A88B47" stroke-width="1.2" fill="none">
      <line x1="30" y1="6" x2="30" y2="58"/>
      <line x1="12" y1="18" x2="48" y2="18"/>
      <line x1="12" y1="18" x2="6" y2="28"/>
      <line x1="12" y1="18" x2="18" y2="28"/>
      <path d="M4 28 Q12 34 20 28" fill="#A88B47" fill-opacity="0.18"/>
      <line x1="48" y1="18" x2="42" y2="28"/>
      <line x1="48" y1="18" x2="54" y2="28"/>
      <path d="M40 28 Q48 34 56 28" fill="#A88B47" fill-opacity="0.18"/>
      <line x1="22" y1="58" x2="38" y2="58"/>
      <line x1="20" y1="62" x2="40" y2="62"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2 text-roussin-velin">
    <span class="font-cormorant italic text-[10px]">Étude Roussin</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.32em] text-roussin-laiton">— Avocat au Barreau</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[55%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-roussin-bordeaux mb-1">Cabinet · Saint-Pierre</p>
    <p class="font-cormorant leading-[0.92] font-medium text-roussin-encre" style="font-size: clamp(15px, 3.2vw, 26px);">Défendre</p>
    <p class="font-cormorant italic text-roussin-bordeaux leading-[0.92]" style="font-size: clamp(15px, 3.2vw, 26px);">votre droit.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-roussin-nuit text-roussin-velin font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Premier entretien</span>
  </div>
</div>
