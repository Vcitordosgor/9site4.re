---
import data from '../../../data/templates/vermeille.json';
/**
 * Mini-preview Vermeille — photo plein cadre danseuse, hero théâtre.
 */
---

<div class="absolute inset-0 bg-vermeille-velours text-vermeille-ivoire overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(26 15 18 / 0.45) 0%, rgb(26 15 18 / 0.10) 35%, rgb(26 15 18 / 0.10) 55%, rgb(26 15 18 / 0.95) 100%),
         linear-gradient(90deg, rgb(26 15 18 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-italiana text-vermeille-ivoire text-[11px] tracking-wide">Vermeille</span>
      <span class="text-vermeille-or text-[5px]">✦</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-vermeille-ivoire/80 font-light">
      <span>Disciplines</span>
      <span>Saison</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-italiana text-[5.5px] uppercase tracking-[0.3em] text-vermeille-or mb-1">
      École de danse · depuis 2008
    </p>
    <p class="font-italiana text-vermeille-ivoire leading-[0.9] tracking-tight" style="font-size: clamp(18px, 3.6vw, 30px);">
      Vermeille
    </p>
    <p class="mt-0.5 font-italiana italic text-vermeille-or leading-tight" style="font-size: clamp(8px, 1.6vw, 12px);">
      Le rideau ne se lève qu'avec vous.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-vermeille-bordeaux text-vermeille-ivoire font-italiana text-[6.5px] tracking-wide">
        S'inscrire
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-vermeille-ivoire/45 text-vermeille-ivoire font-italiana text-[6.5px] tracking-wide">
        La saison
      </span>
    </div>
  </div>
</div>
