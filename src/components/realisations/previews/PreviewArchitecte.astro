---
/**
 * Mini-preview Atelier Mahatma — photo plein cadre noir & blanc, vignette architectural.
 */
---

<div class="absolute inset-0 bg-mahatma-papier text-mahatma-encre font-atkinson overflow-hidden">

  <img
    src="/images/architecte/bureaux.webp"
    alt=""
    class="absolute inset-0 w-full h-full object-cover grayscale scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(10 10 12 / 0.25) 0%, rgb(10 10 12 / 0) 35%, rgb(10 10 12 / 0) 50%, rgb(10 10 12 / 0.90) 100%),
         linear-gradient(90deg, rgb(10 10 12 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-fira-mono text-mahatma-cachet text-[7px]">▢</span>
      <span class="font-schibsted font-bold text-mahatma-papier text-[8px] uppercase tracking-tight">ATELIER</span>
      <span class="font-schibsted font-light text-mahatma-papier text-[8px] uppercase tracking-tight">MAHATMA</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-mahatma-papier/80">
      <span>Projets</span>
      <span>Méthode</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-fira-mono text-[5.5px] uppercase tracking-[0.32em] text-mahatma-cachet mb-1">
      Œuvre n° 0001 · 2024
    </p>
    <p class="font-schibsted font-bold text-mahatma-papier uppercase tracking-tight leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Villa<br/>La Source.
    </p>
    <p class="mt-0.5 font-atkinson italic text-mahatma-papier/85 leading-tight" style="font-size: clamp(8px, 1.6vw, 12px);">
      280 m² · La Réunion.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-mahatma-cachet text-mahatma-papier font-atkinson font-bold text-[6px] uppercase tracking-wider">
        Voir les projets
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-mahatma-papier/45 text-mahatma-papier font-atkinson font-bold text-[6px] uppercase tracking-wider">
        Rendez-vous
      </span>
    </div>
  </div>
</div>
