---
/**
 * Mini-preview Villa Lazuli — brochure villa lifestyle.
 */
---

<div class="absolute inset-0 bg-lazuli-casse text-lazuli-marine overflow-hidden">
  <div class="absolute bottom-0 inset-x-0 h-16" style="background: linear-gradient(180deg, transparent 0%, #3A7188 40%, #1B2D3A 100%);" aria-hidden="true"></div>

  <svg class="absolute right-3 bottom-6" width="110" height="80" viewBox="0 0 110 80" aria-hidden="true">
    <rect x="10" y="34" width="48" height="34" fill="#FAF6ED"/>
    <polygon points="6,34 34,16 62,34" fill="#A85B3F"/>
    <rect x="20" y="48" width="8" height="14" fill="#3A7188"/>
    <rect x="38" y="48" width="8" height="14" fill="#3A7188"/>
    <line x1="84" y1="68" x2="86" y2="36" stroke="#8C7159" stroke-width="2"/>
    <g fill="#CDDDB1">
      <ellipse cx="76" cy="32" rx="14" ry="3" transform="rotate(-25 76 32)"/>
      <ellipse cx="96" cy="32" rx="14" ry="3" transform="rotate(25 96 32)"/>
      <ellipse cx="74" cy="40" rx="14" ry="3" transform="rotate(-50 74 40)"/>
      <ellipse cx="98" cy="40" rx="14" ry="3" transform="rotate(50 98 40)"/>
    </g>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-cormorant italic text-lazuli-marine text-[10px]">Villa Lazuli</span>
    <span class="font-outfit text-[6px] uppercase tracking-[0.25em] text-lazuli-terracotta font-semibold">Location · mer</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[55%]">
    <p class="font-outfit text-[5.5px] uppercase tracking-[0.32em] text-lazuli-lagon mb-1">L'Hermitage · pieds dans l'eau</p>
    <p class="font-cormorant leading-[0.92] font-medium text-lazuli-marine" style="font-size: clamp(16px, 3.4vw, 26px);">La villa,</p>
    <p class="font-cormorant italic text-lazuli-terracotta leading-[0.92]" style="font-size: clamp(16px, 3.4vw, 26px);">le lagon.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-lazuli-terracotta text-lazuli-casse font-outfit font-semibold text-[6px] uppercase tracking-[0.2em]">Voir disponibilités</span>
  </div>
</div>
