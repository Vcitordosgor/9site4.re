---
import data from '../../../data/templates/lazuli.json';
/**
 * Mini-preview Villa Lazuli — photo plein cadre villa.
 */
---

<div class="absolute inset-0 bg-lazuli-marine text-lazuli-casse overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(27 45 58 / 0.35) 0%, rgb(27 45 58 / 0.05) 30%, rgb(27 45 58 / 0.10) 50%, rgb(27 45 58 / 0.93) 100%),
         linear-gradient(90deg, rgb(27 45 58 / 0.50) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-italianno text-lazuli-coco text-[14px] leading-none">Villa</span>
      <span class="font-yeseva text-lazuli-casse text-[10px] tracking-wide leading-none">Lazuli</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-lazuli-casse/85 font-medium">
      <span>Visite</span>
      <span>Tarifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-geist text-[5.5px] uppercase tracking-[0.25em] text-lazuli-coco font-semibold mb-1">
      ★ 4,8/5 · Villa privée
    </p>
    <p class="font-italianno text-lazuli-coco leading-none" style="font-size: clamp(14px, 2.8vw, 22px);">Villa</p>
    <p class="font-yeseva text-lazuli-casse leading-[0.9] tracking-tight" style="font-size: clamp(20px, 4vw, 32px);">
      Lazuli.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-lazuli-terracotta text-lazuli-casse font-geist font-semibold text-[6.5px] rounded-full">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-lazuli-casse/45 text-lazuli-casse font-geist font-semibold text-[6.5px] rounded-full">
        Visite
      </span>
    </div>
  </div>
</div>
