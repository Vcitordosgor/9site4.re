---
/**
 * Mini-preview Foudre Coaching — brutalist athletic.
 */
---

<div class="absolute inset-0 bg-coach-noir text-coach-blanc overflow-hidden">
  <div class="absolute top-0 right-0 w-1/3 h-full bg-coach-lime" aria-hidden="true"></div>

  <svg class="absolute right-3 top-1/2 -translate-y-1/2" width="50" height="80" viewBox="0 0 40 60" aria-hidden="true">
    <path d="M22 0L4 32h12L12 60l24-36H22z" fill="#0A0A0A"/>
  </svg>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <span class="font-bebas text-coach-lime text-[12px] tracking-wider">FOUDRE</span>
    <span class="font-archivo font-black text-[6px] uppercase tracking-wider text-coach-noir bg-coach-lime px-1.5 py-0.5">COACH</span>
  </div>

  <div class="absolute left-3 bottom-2.5 max-w-[60%]">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-coach-lime mb-1">— 12 weeks. zéro excuse.</p>
    <p class="font-bebas text-coach-blanc leading-[0.85] tracking-wider" style="font-size: clamp(22px, 4.6vw, 38px);">PLUS<br/>FORT.</p>
    <p class="font-bebas text-coach-lime leading-[0.85] tracking-wider" style="font-size: clamp(22px, 4.6vw, 38px);">VITE.</p>
    <span class="mt-1.5 inline-flex items-center h-3 px-2 bg-coach-lime text-coach-noir font-archivo font-black text-[6.5px] uppercase tracking-wider">Je m'engage</span>
  </div>
</div>
