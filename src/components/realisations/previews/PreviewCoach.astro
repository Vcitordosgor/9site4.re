---
import data from '../../../data/templates/foudre.json';
/**
 * Mini-preview Foudre Coaching — photo plein cadre athletic.
 */
---

<div class="absolute inset-0 bg-coach-noir text-coach-blanc font-barlow overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover grayscale scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(10 10 12 / 0.35) 0%, rgb(10 10 12 / 0) 30%, rgb(10 10 12 / 0) 50%, rgb(10 10 12 / 0.95) 100%),
         linear-gradient(90deg, rgb(10 10 12 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-big-shoulders font-black text-coach-blanc text-[11px] tracking-tight uppercase">FOUDRE</span>
      <span class="font-jetbrains text-coach-lime text-[6px]">/974</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-coach-blanc/85 font-medium">
      <span>Programmes</span>
      <span>Tarifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.25em] text-coach-lime mb-1">
      EST. 2019 · LA RÉUNION
    </p>
    <p class="font-big-shoulders font-black uppercase text-coach-blanc leading-[0.85]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Ton corps mérite<br/>
      <span class="text-coach-lime">mieux qu'excuses.</span>
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-coach-lime text-coach-noir font-big-shoulders font-bold text-[6.5px] uppercase tracking-wider">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-coach-blanc/45 text-coach-blanc font-big-shoulders font-bold text-[6.5px] uppercase tracking-wider">
        Programmes
      </span>
    </div>
  </div>
</div>
