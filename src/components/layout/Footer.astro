---
import Wordmark from './Wordmark.astro';
import siteConfig from '../../data/siteConfig.json';
import { villes } from '../../data/villes.ts';

const navLinks = [
  { href: '/', label: 'Accueil' },
  { href: '/realisations', label: 'Exemples' },
  { href: '/tarifs', label: 'Tarifs' },
  { href: '/methode-9site4', label: 'La méthode 9site4' },
  { href: '/contact', label: 'Contact' },
  { href: '/questions-frequentes', label: 'Questions fréquentes' },
];

const currentYear = new Date().getFullYear();

const whatsappUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(
  siteConfig.contact.whatsappMessage
)}`;
---

<footer class="relative bg-bleu-nuit text-blanc-casse">
  <div class="max-w-content mx-auto px-6 pt-8 md:pt-16 pb-28 md:pb-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <!-- Bloc 1 — Identité -->
      <div>
        <Wordmark size="md" tone="light" />
        <p class="mt-4 text-sm text-blanc-casse/70 leading-relaxed max-w-xs">
          {siteConfig.baseline}
        </p>
        <p class="mt-6 text-sm text-blanc-casse/60">Fait à La Réunion 🌴</p>
      </div>

      <!-- Bloc 2 — Navigation -->
      <div>
        <h2 class="text-xs uppercase tracking-wider font-semibold text-bleu">
          Navigation
        </h2>
        <ul class="mt-4 space-y-2">
          {navLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="inline-block text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Bloc 3 — Offre -->
      <div>
        <h2 class="text-xs uppercase tracking-wider font-semibold text-bleu">
          Offre
        </h2>
        <p class="mt-4 text-sm text-blanc-casse/85 leading-relaxed">
          {siteConfig.pricing.highlight}
        </p>
        <a
          href="/tarifs"
          class="mt-3 inline-flex items-center gap-1 text-sm text-bleu hover:text-bleu transition-colors duration-200"
        >
          Voir les tarifs
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Bloc 4 — Contact -->
      <div>
        <h2 class="text-xs uppercase tracking-wider font-semibold text-bleu">
          Contact
        </h2>
        <ul class="mt-4 space-y-2">
          <li>
            <a
              href={`mailto:${siteConfig.contact.email}`}
              class="inline-block text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200 break-all"
            >
              {siteConfig.contact.email}
            </a>
          </li>
          <li>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-block text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200"
            >
              WhatsApp · {siteConfig.contact.whatsappDisplay}
            </a>
          </li>
          <li class="text-sm text-blanc-casse/65">
            Réunion {siteConfig.location.areaCode}
          </li>
        </ul>
      </div>
    </div>

    <!-- Maillage SEO : pages métiers -->
    <div class="mt-10 pt-6 border-t border-blanc-casse/10">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-bleu">Pages métiers</h2>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 [overflow-wrap:anywhere]">
        <li>
          <a href="/creation-site-internet-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Création de site internet à La Réunion
          </a>
        </li>
        <li>
          <a href="/site-internet-restaurant-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour restaurant
          </a>
        </li>
        <li>
          <a href="/site-internet-artisan-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour artisan
          </a>
        </li>
        <li>
          <a href="/site-internet-coiffeur-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour coiffeur
          </a>
        </li>
        <li>
          <a href="/site-internet-gite-location-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour gîte & location
          </a>
        </li>
        <li>
          <a href="/site-internet-profession-liberale-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour profession libérale
          </a>
        </li>
        <li>
          <a href="/site-internet-bien-etre-sante-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour praticien bien-être & santé
          </a>
        </li>
        <li>
          <a href="/site-internet-institut-beaute-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour institut, spa & coiffure
          </a>
        </li>
        <li>
          <a href="/site-internet-coach-independant-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour coach & indépendant
          </a>
        </li>
        <li>
          <a href="/site-internet-commerce-local-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour commerce local
          </a>
        </li>
        <li>
          <a href="/site-internet-tpe-pme-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site internet pour TPE/PME
          </a>
        </li>
        <li>
          <a href="/site-vitrine-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Site vitrine à La Réunion
          </a>
        </li>
        <li>
          <a href="/agence-web-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Agence web à La Réunion
          </a>
        </li>
        <li>
          <a href="/diagnostic-site-internet-la-reunion" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Diagnostic gratuit de site internet
          </a>
        </li>
        <li>
          <a href="/trouver-le-site-adapte" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            Trouver le site adapté à mon activité
          </a>
        </li>
        <li>
          <a href="/methode-9site4" class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
            La méthode 9site4
          </a>
        </li>
      </ul>
    </div>

    <!-- Maillage SEO : villes desservies -->
    <div class="mt-10 pt-6 border-t border-blanc-casse/10">
      <h2 class="text-xs uppercase tracking-wider font-semibold text-bleu">Villes desservies à La Réunion</h2>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
        {villes.map((v) => (
          <li>
            <a href={`/creation-site-internet-${v.slug}`} class="text-sm text-blanc-casse/85 hover:text-bleu transition-colors duration-200">
              Site internet à {v.nom}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div class="mt-12 pt-6 border-t border-blanc-casse/10 flex flex-col-reverse md:flex-row md:items-center md:justify-between gap-3">
      <p class="text-xs text-blanc-casse/50">
        © {currentYear} {siteConfig.siteName}. Tous droits réservés.
      </p>
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-1.5 text-xs">
        <li>
          <a
            href="/mentions-legales"
            class="text-blanc-casse/60 hover:text-blanc-casse transition-colors underline-offset-4 hover:underline"
          >
            Mentions légales
          </a>
        </li>
        <li class="hidden md:block text-blanc-casse/30" aria-hidden="true">·</li>
        <li>
          <a
            href="/mentions-legales#donnees"
            class="text-blanc-casse/60 hover:text-blanc-casse transition-colors underline-offset-4 hover:underline"
          >
            Confidentialité
          </a>
        </li>
        <li class="hidden md:block text-blanc-casse/30" aria-hidden="true">·</li>
        <li>
          <a
            href="/mentions-legales#cookies"
            class="text-blanc-casse/60 hover:text-blanc-casse transition-colors underline-offset-4 hover:underline"
          >
            Cookies
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
