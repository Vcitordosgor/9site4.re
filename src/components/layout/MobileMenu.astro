---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  navLinks: NavLink[];
}

const { navLinks } = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
};
---

<div
  id="mobile-menu"
  data-open="false"
  aria-hidden="true"
  inert
  class="md:hidden fixed inset-x-0 top-16 bottom-0 z-[45] bg-blanc-casse transition-opacity duration-300 ease-out data-[open=false]:opacity-0 data-[open=false]:pointer-events-none data-[open=true]:opacity-100"
>
  <nav
    class="h-full flex flex-col px-6 pt-8 pb-10 overflow-y-auto"
    aria-label="Navigation mobile"
  >
    <ul class="flex-1 flex flex-col gap-1">
      {navLinks.map((link) => (
        <li>
          <a
            href={link.href}
            data-mobile-link
            data-nav-link
            data-href={link.href}
            data-active={isActive(link.href) ? 'true' : 'false'}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class="block py-4 text-3xl font-sora font-semibold transition-colors duration-200 text-bleu-nuit hover:text-bleu data-[active=true]:text-bleu"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="pt-6 border-t border-bleu-nuit/10">
      <a
        href="/contact"
        data-mobile-link
        class="inline-flex items-center justify-center w-full h-14 px-8 text-lg font-inter font-semibold rounded-full bg-bleu text-bleu-nuit shadow-card transition-all duration-200 ease-out hover:bg-bleu-fonce hover:shadow-card-hover active:translate-y-px"
        data-track-event="cta_contact_click"
        data-track-category="conversion"
        data-track-source="mobile_menu"
        data-track-target="/contact"
      >
        Créer mon site
      </a>
    </div>
  </nav>
</div>

<script>
  // Le header (et donc #menu-toggle) est `transition:persist`, mais #mobile-menu est
  // remplacé à chaque navigation View Transitions : on résout les deux à chaque appel
  // et on écoute par délégation, sinon le burger pilote un menu détaché après la 1re navigation.
  const getToggle = () => document.getElementById('menu-toggle');
  const getMenu = () => document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    const toggle = getToggle();
    const menu = getMenu();
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.dataset.open = String(open);
    toggle.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
    menu.dataset.open = String(open);
    menu.setAttribute('aria-hidden', String(!open));
    // inert : empêche le focus tabbing et masque aux AT quand fermé
    if (open) {
      menu.removeAttribute('inert');
    } else {
      menu.setAttribute('inert', '');
    }
    document.body.style.overflow = open ? 'hidden' : '';
  };

  document.addEventListener('click', (e) => {
    const target = e.target as Element | null;
    const toggle = target?.closest('#menu-toggle');
    if (toggle) {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
      return;
    }
    if (target?.closest('#mobile-menu [data-mobile-link]')) setOpen(false);
  });

  document.addEventListener('keydown', (e) => {
    const toggle = getToggle();
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });

  // Nouvelle page : menu fermé et défilement rétabli, quel que soit l'état précédent.
  document.addEventListener('astro:after-swap', () => setOpen(false));

  // Ferme automatiquement si l'on passe en desktop (md+) pendant que le menu est ouvert
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
    if (e.matches) setOpen(false);
  });
</script>
