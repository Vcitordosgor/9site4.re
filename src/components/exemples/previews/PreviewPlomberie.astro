---
import data from '../../../data/templates/bernard.json';
/**
 * Mini-preview Bernard Plomberie — photo plein cadre artisan.
 */
---

<div class="absolute inset-0 bg-bp-anthracite text-bp-blanc overflow-hidden">

  <img
    src={data.info.photoBernard}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(20 22 28 / 0.40) 0%, rgb(20 22 28 / 0.05) 30%, rgb(20 22 28 / 0.10) 50%, rgb(20 22 28 / 0.95) 100%),
         linear-gradient(90deg, rgb(20 22 28 / 0.60) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-center gap-1">
      <span class="inline-flex items-center justify-center w-3.5 h-3.5 bg-bp-jaune text-bp-anthracite font-bebas text-[8px] leading-none">B</span>
      <span class="font-bebas text-[10px] tracking-wide text-bp-blanc leading-none">BERNARD</span>
      <span class="font-bebas text-[10px] tracking-wide text-bp-jaune leading-none">PLOMBERIE</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-bp-blanc/85 font-medium">
      <span>Services</span>
      <span>Tarifs</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-archivo font-bold text-[5.5px] uppercase tracking-[0.32em] text-bp-jaune mb-1">
      ▸ Plombier · La Réunion
    </p>
    <p class="font-bebas text-bp-blanc leading-[0.85] tracking-tight uppercase" style="font-size: clamp(15px, 3.2vw, 26px);">
      Fuite, bouchon ?<br/>
      <span class="text-bp-jaune">Bernard arrive.</span>
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-bp-jaune text-bp-anthracite font-bebas text-[7px] tracking-widest uppercase">
        ☎ 0692 12 34 56
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-bp-blanc/45 text-bp-blanc font-bebas text-[7px] tracking-widest uppercase">
        Devis gratuit
      </span>
    </div>
  </div>
</div>
