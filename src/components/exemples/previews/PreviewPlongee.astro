---
import data from '../../../data/templates/bleulagon.json';
/**
 * Mini-preview Bleu Lagon Plongée — photo plein cadre sous-marine.
 */
---

<div class="absolute inset-0 bg-plongee-abysse text-plongee-ecume font-inter overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(10 35 66 / 0.40) 0%, rgb(10 35 66 / 0.10) 30%, rgb(10 35 66 / 0.15) 50%, rgb(10 35 66 / 0.95) 100%),
         linear-gradient(90deg, rgb(10 35 66 / 0.55) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-1">
      <span class="font-space-grotesk font-bold text-plongee-ecume text-[10px]">Bleu Lagon</span>
      <span class="font-jetbrains text-plongee-corail text-[6px]">/974</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-wider text-plongee-ecume/85 font-medium">
      <span>Sorties</span>
      <span>Formations</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-jetbrains text-[5.5px] uppercase tracking-[0.3em] text-plongee-lagon mb-1">
      ▼ FFESSM · depuis 2014
    </p>
    <p class="font-space-grotesk font-bold text-plongee-ecume leading-[0.9]" style="font-size: clamp(15px, 3.2vw, 26px);">
      Voir le lagon
    </p>
    <p class="font-space-grotesk italic font-light text-plongee-lagon leading-[0.95]" style="font-size: clamp(11px, 2.3vw, 18px);">
      de l'intérieur.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-plongee-corail text-plongee-abysse font-space-grotesk font-bold text-[6.5px] uppercase tracking-wider rounded-full">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-plongee-ecume/45 text-plongee-ecume font-space-grotesk font-bold text-[6.5px] uppercase tracking-wider rounded-full">
        Sorties
      </span>
    </div>
  </div>
</div>
