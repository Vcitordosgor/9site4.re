---
import data from '../../../data/templates/spa.json';
/**
 * Mini-preview Elio Spa — photo plein cadre rituel.
 */
---

<div class="absolute inset-0 bg-spa-cacao text-spa-creme overflow-hidden">

  <img
    src={data.info.photoHero}
    alt=""
    class="absolute inset-0 w-full h-full object-cover scale-[1.03]"
    loading="lazy"
    decoding="async"
  />

  <div class="absolute inset-0" aria-hidden="true"
       style="background:
         linear-gradient(180deg, rgb(58 47 38 / 0.45) 0%, rgb(58 47 38 / 0.15) 35%, rgb(58 47 38 / 0.15) 55%, rgb(58 47 38 / 0.92) 100%),
         linear-gradient(90deg, rgb(58 47 38 / 0.40) 0%, transparent 55%);">
  </div>

  <div class="relative flex items-center justify-between px-3 pt-2">
    <div class="flex items-baseline gap-0.5">
      <span class="font-bodoni italic font-light text-spa-creme text-[11px]">Elio</span>
      <span class="font-bodoni italic font-light text-spa-rose text-[11px]">spa</span>
    </div>
    <div class="flex items-center gap-1.5 text-[6px] uppercase tracking-[0.18em] text-spa-creme/85 font-medium">
      <span>Rituels</span>
      <span>Soins</span>
    </div>
  </div>

  <div class="absolute left-3 right-3 bottom-2.5">
    <p class="font-raleway font-light text-[5.5px] uppercase tracking-[0.4em] text-spa-rose mb-1">
      Spa &amp; massages · La Réunion
    </p>
    <p class="font-lora text-spa-creme leading-[1.0] font-medium" style="font-size: clamp(14px, 3vw, 24px);">
      L'art du geste,
    </p>
    <p class="font-lora italic font-normal text-spa-rose leading-[1.0]" style="font-size: clamp(14px, 3vw, 24px);">
      le souffle du temps.
    </p>
    <div class="mt-1.5 flex items-center gap-1.5">
      <span class="inline-flex items-center h-3 px-2 bg-spa-terracotta text-spa-blanc font-raleway font-semibold text-[6.5px] uppercase tracking-[0.18em] rounded-full">
        Réserver
      </span>
      <span class="inline-flex items-center h-3 px-2 ring-1 ring-spa-creme/45 text-spa-creme font-raleway font-semibold text-[6.5px] uppercase tracking-[0.18em] rounded-full">
        Rituels
      </span>
    </div>
  </div>
</div>
