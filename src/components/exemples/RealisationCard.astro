---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';
import categories from '../../data/categories.json';

// Imports des 24 mini-previews custom (un par template)
import PreviewResto from './previews/PreviewResto.astro';
import PreviewPizzeria from './previews/PreviewPizzeria.astro';
import PreviewBarJus from './previews/PreviewBarJus.astro';
import PreviewSalon from './previews/PreviewSalon.astro';
import PreviewInstitut from './previews/PreviewInstitut.astro';
import PreviewSpa from './previews/PreviewSpa.astro';
import PreviewPlomberie from './previews/PreviewPlomberie.astro';
import PreviewElectricien from './previews/PreviewElectricien.astro';
import PreviewPaysagiste from './previews/PreviewPaysagiste.astro';
import PreviewOsteo from './previews/PreviewOsteo.astro';
import PreviewDieteticienne from './previews/PreviewDieteticienne.astro';
import PreviewPsy from './previews/PreviewPsy.astro';
import PreviewCoach from './previews/PreviewCoach.astro';
import PreviewYoga from './previews/PreviewYoga.astro';
import PreviewDanse from './previews/PreviewDanse.astro';
import PreviewGite from './previews/PreviewGite.astro';
import PreviewExcursions from './previews/PreviewExcursions.astro';
import PreviewLocation from './previews/PreviewLocation.astro';
import PreviewConsultant from './previews/PreviewConsultant.astro';
import PreviewComptable from './previews/PreviewComptable.astro';
import PreviewArchitecte from './previews/PreviewArchitecte.astro';
import PreviewAutoEcole from './previews/PreviewAutoEcole.astro';
import PreviewConciergerie from './previews/PreviewConciergerie.astro';
import PreviewAideDomicile from './previews/PreviewAideDomicile.astro';
import PreviewPlongee from './previews/PreviewPlongee.astro';
import PreviewWedding from './previews/PreviewWedding.astro';
import PreviewPatisserie from './previews/PreviewPatisserie.astro';
import PreviewGarage from './previews/PreviewGarage.astro';
import PreviewPhotographe from './previews/PreviewPhotographe.astro';
import PreviewAvocat from './previews/PreviewAvocat.astro';
import PreviewBoulangerie from './previews/PreviewBoulangerie.astro';
import PreviewGlacier from './previews/PreviewGlacier.astro';
import PreviewCafeTorref from './previews/PreviewCafeTorref.astro';
import PreviewSurf from './previews/PreviewSurf.astro';
import PreviewFleuriste from './previews/PreviewFleuriste.astro';
import PreviewTatoueur from './previews/PreviewTatoueur.astro';
import PreviewNaturopathe from './previews/PreviewNaturopathe.astro';
import PreviewCreche from './previews/PreviewCreche.astro';
import PreviewNotaire from './previews/PreviewNotaire.astro';
import PreviewStudioAudio from './previews/PreviewStudioAudio.astro';

/**
 * RealisationCard — chaque carte affiche un VRAI mini-preview du template
 * (composant Astro custom reproduisant fidèlement le hero du template),
 * encadré dans une frame navigateur ultra-minimaliste (3 ronds, pas d'URL).
 */
interface Realisation {
  id: number;
  nom: string;
  categorie: string;
  sousTitre: string;
  moduleInclus: string;
  slug: string;
  previewUrl?: string;
  thumbnail?: string;
}

interface Props {
  realisation: Realisation;
  ctaHref?: string;
}

const { realisation, ctaHref = '/contact' } = Astro.props;

const categoryName =
  categories.find((c) => c.id === realisation.categorie)?.nom ??
  realisation.categorie;

// Mapping slug → composant Preview correspondant
const previewMap: Record<string, any> = {
  'restaurant-gastronomique':         PreviewResto,
  'snack-pizzeria':                   PreviewPizzeria,
  'bar-a-jus-tropical':               PreviewBarJus,
  'salon-de-coiffure':                PreviewSalon,
  'institut-de-beaute':               PreviewInstitut,
  'spa-massage':                      PreviewSpa,
  'plomberie':                        PreviewPlomberie,
  'electricite-generale':             PreviewElectricien,
  'paysagiste':                       PreviewPaysagiste,
  'cabinet-osteopathie':              PreviewOsteo,
  'dieteticienne':                    PreviewDieteticienne,
  'psychologue':                      PreviewPsy,
  'coach-sportif':                    PreviewCoach,
  'studio-yoga':                      PreviewYoga,
  'ecole-de-danse':                   PreviewDanse,
  'gite-de-montagne':                 PreviewGite,
  'excursions-randonnee':             PreviewExcursions,
  'location-saisonniere-bord-de-mer': PreviewLocation,
  'consultant':                       PreviewConsultant,
  'cabinet-comptable':                PreviewComptable,
  'architecte':                       PreviewArchitecte,
  'auto-ecole':                       PreviewAutoEcole,
  'conciergerie':                     PreviewConciergerie,
  'aide-a-domicile':                  PreviewAideDomicile,
  'plongee':                          PreviewPlongee,
  'wedding-planner':                  PreviewWedding,
  'patisserie-creole':                PreviewPatisserie,
  'garage-mecanique':                 PreviewGarage,
  'photographe-auteur':               PreviewPhotographe,
  'avocat-cabinet':                   PreviewAvocat,
  'boulangerie-artisanale':           PreviewBoulangerie,
  'glacier-artisanal':                PreviewGlacier,
  'cafe-torrefaction':                PreviewCafeTorref,
  'ecole-de-surf':                    PreviewSurf,
  'fleuriste-atelier':                PreviewFleuriste,
  'studio-de-tatouage':               PreviewTatoueur,
  'naturopathe':                      PreviewNaturopathe,
  'micro-creche':                     PreviewCreche,
  'etude-notariale':                  PreviewNotaire,
  'studio-audio':                     PreviewStudioAudio,
};

const Preview = previewMap[realisation.slug] ?? null;

// Fallback visuel pour entrées sans preview
const visuals: Record<string, { icon: string }> = {
  restaurants: { icon: 'sparkle' },
  beaute: { icon: 'palette' },
  artisans: { icon: 'wrench' },
  sante: { icon: 'shield-check' },
  sport: { icon: 'sparkle' },
  tourisme: { icon: 'globe' },
  pro: { icon: 'file-text' },
  particuliers: { icon: 'headphones' },
};

const moduleIcons: Record<string, string> = {
  'Réservation': 'calendar-clock',
  'Rendez-vous': 'calendar-check',
  'Devis': 'file-text',
  'Intervention': 'wrench',
};
const moduleColors: Record<string, 'bleu' | 'orange'> = {
  'Rendez-vous': 'bleu',
  'Intervention': 'bleu',
  'Réservation': 'orange',
  'Devis': 'orange',
};

const visual = visuals[realisation.categorie] ?? visuals.pro;
const moduleIcon = moduleIcons[realisation.moduleInclus] ?? 'sparkle';
const moduleColor = moduleColors[realisation.moduleInclus] ?? 'orange';
---

<article class="tilt-card group relative rounded-2xl overflow-hidden flex flex-col transition-all duration-300 hover:-translate-y-1"
  style="background: #000000; box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 18px 40px -22px rgba(0,0,0,0.85), 0 0 0 1.5px #91a6ff, 0 0 28px -8px rgba(145,166,255,0.45);"
  onmouseover="this.style.boxShadow='0 1px 0 rgba(255,255,255,0.10) inset, 0 28px 60px -18px rgba(0,0,0,0.95), 0 0 0 2px #91a6ff, 0 0 44px -4px rgba(145,166,255,0.70)';"
  onmouseout="this.style.boxShadow='0 1px 0 rgba(255,255,255,0.06) inset, 0 18px 40px -22px rgba(0,0,0,0.85), 0 0 0 1.5px #91a6ff, 0 0 28px -8px rgba(145,166,255,0.45)';"
>

  {realisation.previewUrl && Preview ? (
    <!-- 🖥️ MINI-PREVIEW : la star de la carte, plus grand, avec overlay au survol -->
    <a
      href={realisation.previewUrl}
      target="_blank"
      rel="noopener"
      class="block relative group/preview overflow-hidden border-b border-white/10 bg-bleu-nuit"
      aria-label={`Voir le site ${realisation.nom}`}
    >
      <!-- Browser chrome minimaliste -->
      <div class="flex items-center gap-1.5 px-3 py-2 bg-bleu-nuit/95" aria-hidden="true">
        <span class="block w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
        <span class="block w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
        <span class="block w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
      </div>

      <!-- Viewport plus grand (4/3 au lieu de 5/3) -->
      <div class="relative aspect-[4/3] overflow-hidden bg-bleu-nuit">
        <div class="absolute inset-0 transition-transform duration-700 ease-out-soft group-hover/preview:scale-[1.03]">
          <Preview />
        </div>
        <!-- Badge "Démo métier" : signale clairement un exemple, pas un vrai client -->
        <span class="absolute top-3 left-3 z-10 inline-flex items-center px-2.5 py-1 rounded-full bg-orange text-white text-[10px] font-bold uppercase tracking-wide shadow-md pointer-events-none">
          Démo métier
        </span>
        <!-- Overlay au hover avec pill "Voir la démo" -->
        <div class="absolute inset-0 flex items-center justify-center bg-bleu-nuit/55 opacity-0 group-hover/preview:opacity-100 transition-opacity duration-300">
          <span class="inline-flex items-center gap-2 h-11 px-5 rounded-full bg-bleu text-white font-semibold text-sm shadow-[0_0_24px_rgba(145,166,255,0.6)]">
            Voir la démo
            <Icon name="arrow-right" size={16} strokeWidth={2.5} />
          </span>
        </div>
      </div>
    </a>
  ) : (
    <!-- Fallback -->
    <div class="relative aspect-[4/3] overflow-hidden bg-white/5">
      <div class="absolute inset-0 flex items-center justify-center text-blanc-casse/30">
        <Icon name={visual.icon} size={48} strokeWidth={1.5} />
      </div>
    </div>
  )}

  <!-- Corps : métadonnées épurées -->
  <div class="flex-1 flex flex-col p-5 md:p-6">

    <!-- Meta inline : catégorie + module sur une ligne discrète -->
    <div class="flex items-center gap-2 text-[10.5px] font-roboto-mono uppercase tracking-[0.18em] text-blanc-casse/55 font-semibold mb-3">
      <span>{categoryName}</span>
      {realisation.previewUrl && (
        <>
          <span aria-hidden="true" class="text-blanc-casse/30">·</span>
          <span class="inline-flex items-center gap-1.5 text-bleu">
            <Icon name={moduleIcon} size={11} strokeWidth={2.25} />
            Module {realisation.moduleInclus}
          </span>
        </>
      )}
    </div>

    <h3 class="font-sora font-bold text-xl text-blanc-casse leading-snug line-clamp-2 break-words" title={realisation.nom}>{realisation.nom}</h3>
    <p class="mt-2 text-sm text-blanc-casse/65 leading-relaxed line-clamp-2 break-words" title={realisation.sousTitre}>{realisation.sousTitre}</p>

    <!-- CTA ligne : bouton mauve + lien tertiaire -->
    <div class="mt-6 flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-5 border-t border-white/10">
      {realisation.previewUrl ? (
        <a
          href={realisation.previewUrl}
          target="_blank"
          rel="noopener"
          class="group/cta inline-flex items-center gap-1.5 h-10 px-4 text-sm font-semibold rounded-full bg-bleu text-white hover:bg-[#7e95ff] hover:-translate-y-0.5 shadow-[0_4px_16px_rgba(255,255,255,0.35)] transition-all duration-200"
        >
          Voir la démo
          <Icon name="arrow-right" size={14} strokeWidth={2.5} class="transition-transform duration-200 group-hover/cta:translate-x-0.5" />
        </a>
      ) : <span />}

      <a
        href={ctaHref}
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-blanc-casse/70 hover:text-bleu transition-colors"
      >
        Je veux celui-ci
        <Icon name="arrow-right" size={14} strokeWidth={2.5} class="transition-transform duration-200 group-hover:translate-x-0.5" />
      </a>
    </div>
  </div>
</article>
