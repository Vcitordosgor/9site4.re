---
import data from '../../../data/templates/salon.json';
---

<section aria-label="Reservation" class="bg-salon-vert text-salon-creme py-6 md:py-7">
  <div class="max-w-content mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
    <div class="flex items-center gap-3">
      <span class="font-fraunces italic text-2xl md:text-3xl text-salon-creme leading-none">Sur rendez-vous</span>
      <span class="hidden md:inline font-dm-sans text-[11px] uppercase tracking-[0.3em] text-salon-creme/85">mardi → samedi</span>
    </div>
    <p class="font-fraunces italic text-salon-creme text-base md:text-lg text-center">
      Coupe, couleur, soin profond — un atelier pour vos cheveux.
    </p>
    <a
      href={`https://wa.me/${data.info.whatsapp}`}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center justify-center h-11 px-6 bg-salon-creme text-salon-noir font-dm-sans font-semibold text-[11.5px] uppercase tracking-[0.22em] rounded-full hover:bg-salon-vert-clair hover:text-salon-creme transition-colors"
    >
      Reserver
    </a>
  </div>
</section>
