---
/**
 * Instants — quatre moments du salon, sans promesse de résultat.
 * Galerie éditoriale N&B en composition asymétrique. Remplace l'ancien Avant/Après.
 */
const instants = [
  {
    src: '/images/salon/instant-cut.webp',
    alt: 'Coupe précise au peigne et ciseaux devant le miroir double',
    legende: 'La coupe',
    span: 'lg:col-span-7 lg:row-span-2',
    ratio: '4/5',
  },
  {
    src: '/images/salon/instant-color.webp',
    alt: 'Application d\'une coloration au pinceau, gant noir',
    legende: 'La couleur',
    span: 'lg:col-span-5',
    ratio: '4/3',
  },
  {
    src: '/images/salon/instant-shampoo.webp',
    alt: 'Shampoing au bac, massage du cuir chevelu',
    legende: 'Le soin',
    span: 'lg:col-span-3',
    ratio: '1/1',
  },
  {
    src: '/images/salon/instant-scissors.webp',
    alt: 'Détail des mains : ciseaux et peigne au travail',
    legende: 'Le geste',
    span: 'lg:col-span-2',
    ratio: '1/1',
  },
];
---

<section id="instants" aria-labelledby="instants-titre" class="bg-salon-blanc py-20 md:py-32 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-14 md:mb-18">
      <p class="scroll-reveal flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-salon-vert">
        <span class="inline-block w-10 h-px bg-salon-vert" aria-hidden="true"></span>
        <span>Le salon en images</span>
        <span class="inline-block w-10 h-px bg-salon-vert" aria-hidden="true"></span>
      </p>
      <h2 id="instants-titre" class="scroll-reveal mt-5 font-fraunces font-bold text-salon-noir leading-[1.05]" style="font-size: clamp(34px, 5.4vw, 60px);">
        Quelques instants
        <span class="block italic font-medium text-salon-vert">chez Meg &amp; Dan.</span>
      </h2>
      <p class="scroll-reveal mt-5 text-salon-noir/70 leading-relaxed max-w-xl mx-auto">
        Coupe, couleur, soin — quatre gestes du quotidien, photographiés au fauteuil.
      </p>
    </header>

    <!-- Composition éditoriale asymétrique : 1 grand + 3 petits -->
    <div class="grid grid-cols-2 lg:grid-cols-12 gap-3 sm:gap-4 lg:gap-5 lg:auto-rows-fr">
      {instants.map((i) => (
        <figure class:list={['scroll-reveal relative group overflow-hidden bg-salon-gris', i.span ?? 'lg:col-span-3']} style={`aspect-ratio: ${i.ratio};`}>
          <img
            src={i.src}
            alt={i.alt}
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
            loading="lazy"
            decoding="async"
            width="900"
            height="1100"
          />
          <!-- Voile bas + label -->
          <div class="absolute inset-x-0 bottom-0 h-1/3 pointer-events-none" aria-hidden="true"
               style="background: linear-gradient(to top, rgb(10 10 10 / 0.55), transparent);"></div>
          <figcaption class="absolute bottom-3 left-4 right-4 font-fraunces italic text-salon-blanc text-sm md:text-base tracking-wide">
            {i.legende}
          </figcaption>
        </figure>
      ))}
    </div>

    <p class="scroll-reveal mt-10 text-center text-xs uppercase tracking-[0.28em] text-salon-noir/45 font-dm-sans">
      Photographies au salon — aucune retouche
    </p>
  </div>
</section>
