---
const polas = [
  {
    src: 'https://images.unsplash.com/photo-1605497788044-5a32c7078486?w=900&q=85',
    alt: 'Coupe courte feminine ondulee',
    legende: 'Coupe courte · ondulée',
    rotation: '-rotate-3 md:-rotate-6',
  },
  {
    src: 'https://images.unsplash.com/photo-1562322140-8baeececf3df?w=900&q=85',
    alt: 'Carre long balayage discret',
    legende: 'Carré long · balayage',
    rotation: 'rotate-2 md:rotate-3 md:translate-y-8',
  },
  {
    src: 'https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=900&q=85',
    alt: 'Travail de couleur en cabine, alu',
    legende: 'Couleur · cheveux longs',
    rotation: '-rotate-2 md:-rotate-3 md:-translate-y-4',
  },
];
---

<section class="bg-salon-gris py-20 md:py-32 relative overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-dm-sans uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-salon-vert mb-4">— Avant / après, en cadre —</p>
      <h2 class="font-fraunces text-salon-noir text-3xl md:text-5xl leading-tight">
        Trois coupes,
        <em class="font-fraunces italic text-salon-vert block md:inline">photographiées au fauteuil.</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-4 max-w-4xl mx-auto">
      {polas.map((p) => (
        <figure class={`bg-salon-blanc p-3 pb-14 shadow-xl ${p.rotation} hover:rotate-0 hover:scale-105 transition-transform duration-500`}>
          <div class="aspect-[4/5] overflow-hidden bg-salon-noir">
            <img src={p.src} alt={p.alt} loading="lazy" decoding="async" class="w-full h-full object-cover grayscale-[20%] hover:grayscale-0 transition-all duration-500" />
          </div>
          <figcaption class="mt-3 text-center font-fraunces italic text-salon-noir text-base">— {p.legende} —</figcaption>
        </figure>
      ))}
    </div>

    <p class="mt-12 text-center font-dm-sans uppercase tracking-[0.3em] text-[10px] md:text-[11px] text-salon-noir/70">
      Polaroids pris par Dan · pas de retouche, pas de filtre
    </p>
  </div>
</section>
