---
/**
 * Polaroids — devenue galerie Avant / Après.
 * Quatre transformations présentées en paires 2 colonnes (avant à gauche,
 * après à droite), encadrées polaroid, labels typés.
 */
const paires = [
  {
    titre: 'Coupe courte ondulée',
    avant: {
      src: 'https://images.unsplash.com/photo-1554519515-242161756769?w=900&q=85',
      alt: 'Avant : cheveux longs ternes',
    },
    apres: {
      src: 'https://images.unsplash.com/photo-1605497788044-5a32c7078486?w=900&q=85',
      alt: 'Après : coupe courte féminine ondulée',
    },
    note: 'Visage dégagé, mouvement naturel.',
  },
  {
    titre: 'Carré long balayage',
    avant: {
      src: 'https://images.unsplash.com/photo-1519699047748-de8e457a634e?w=900&q=85',
      alt: 'Avant : longueur sans coiffage',
    },
    apres: {
      src: 'https://images.unsplash.com/photo-1562322140-8baeececf3df?w=900&q=85',
      alt: 'Après : carré long balayage discret',
    },
    note: 'Reflets soleil, structure carré.',
  },
  {
    titre: 'Coloration cheveux longs',
    avant: {
      src: 'https://images.unsplash.com/photo-1626954079979-ec4f7b05e032?w=900&q=85',
      alt: 'Avant : racines apparentes',
    },
    apres: {
      src: 'https://images.unsplash.com/photo-1521590832167-7bcbfaa6381f?w=900&q=85',
      alt: 'Après : couleur uniforme cheveux longs',
    },
    note: 'Racines et longueurs harmonisées.',
  },
  {
    titre: 'Brushing événement',
    avant: {
      src: 'https://images.unsplash.com/photo-1612817288484-6f916006741a?w=900&q=85',
      alt: 'Avant : cheveux raides',
    },
    apres: {
      src: 'https://images.unsplash.com/photo-1595944946-1a4ed4b9d8d3?w=900&q=85',
      alt: 'Après : brushing avec volume',
    },
    note: 'Volume tenu sans rigidité.',
  },
];
---

<section class="bg-salon-gris py-20 md:py-32 relative overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-dm-sans uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-salon-vert mb-4">— Avant / après —</p>
      <h2 class="font-fraunces text-salon-noir text-3xl md:text-5xl leading-tight">
        Quatre transformations,
        <em class="font-fraunces italic text-salon-vert block md:inline">photographiées au fauteuil.</em>
      </h2>
      <p class="mt-5 text-salon-noir/70 leading-relaxed">
        Pas de retouche, pas de filtre. Juste la lumière du salon.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 max-w-5xl mx-auto">
      {paires.map((p) => (
        <article class="bg-salon-blanc p-4 pb-6 shadow-xl">
          <div class="grid grid-cols-2 gap-2">
            <figure class="relative">
              <span class="absolute top-2 left-2 z-10 inline-flex items-center px-2 py-0.5 bg-salon-noir/85 text-salon-blanc text-[10px] font-semibold uppercase tracking-[0.22em]">
                Avant
              </span>
              <div class="aspect-[4/5] overflow-hidden bg-salon-noir">
                <img src={p.avant.src} alt={p.avant.alt} width="400" height="500" loading="lazy" decoding="async" class="w-full h-full object-cover grayscale-[25%]" />
              </div>
            </figure>
            <figure class="relative">
              <span class="absolute top-2 left-2 z-10 inline-flex items-center px-2 py-0.5 bg-salon-vert text-salon-blanc text-[10px] font-semibold uppercase tracking-[0.22em]">
                Après
              </span>
              <div class="aspect-[4/5] overflow-hidden bg-salon-noir">
                <img src={p.apres.src} alt={p.apres.alt} width="400" height="500" loading="lazy" decoding="async" class="w-full h-full object-cover" />
              </div>
            </figure>
          </div>
          <figcaption class="mt-4 text-center">
            <p class="font-fraunces italic text-salon-noir text-lg">{p.titre}</p>
            <p class="mt-1 text-xs text-salon-noir/65">{p.note}</p>
          </figcaption>
        </article>
      ))}
    </div>
  </div>
</section>
