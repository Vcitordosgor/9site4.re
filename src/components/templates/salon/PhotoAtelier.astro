---
/**
 * PhotoAtelier — image éditoriale plein cadre entre Prestations et Processus.
 * Utilise le portrait résultat (image 3) pour incarner un visage souriant
 * après le passage au fauteuil. Caption sobre, sans promesse.
 */
---

<section aria-label="L'atelier en images" class="bg-salon-blanc py-0">
  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-salon-noir">
      <img
        src="/images/salon/portrait.webp"
        alt="Portrait au fauteuil, lumière naturelle, brushing soigné"
        width="2200"
        height="943"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        style="object-position: center 30%;"
      />
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-4 flex items-baseline justify-between gap-3 flex-wrap">
      <figcaption class="font-fraunces italic text-salon-vert text-sm md:text-base leading-relaxed">
        Après chaque rendez-vous — un brushing, un dernier regard au miroir.
      </figcaption>
      <span class="font-dm-sans text-[11px] uppercase tracking-[0.28em] text-salon-vert-clair">deux coiffeurs · une vision</span>
    </div>
  </figure>
</section>
