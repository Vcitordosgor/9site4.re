<section aria-label="L'atelier" class="bg-salon-blanc py-0">
  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-salon-noir">
      <img
        src="https://images.unsplash.com/photo-1560066984-138dadb4c035?q=80&w=2200&auto=format&fit=crop"
        alt="Atelier coiffure, ambiance contemporaine, fauteuils en cuir et lumière chaude"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-4 flex items-baseline justify-between gap-3 flex-wrap">
      <figcaption class="font-fraunces italic text-salon-vert text-sm md:text-base leading-relaxed">
        L'atelier — deux fauteuils, deux paires de ciseaux, zéro précipitation.
      </figcaption>
      <span class="font-dm-sans text-[11px] uppercase tracking-[0.28em] text-salon-vert-clair">deux coiffeurs · une vision</span>
    </div>
  </figure>
</section>
