---
/**
 * CTAFinal — bandeau full-width sombre, citation finale + bouton vert.
 */
import data from '../../../data/templates/salon.json';
---

<section class="relative bg-salon-noir text-salon-blanc py-20 md:py-32 px-6 md:px-10 text-center overflow-hidden">
  <!-- Halo vert subtle en arrière-plan -->
  <div class="pointer-events-none absolute inset-0" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[40rem] h-[40rem] rounded-full"
         style="background: radial-gradient(50% 50% at 50% 50%, rgb(92 122 102 / 0.20) 0%, transparent 70%);">
    </div>
  </div>

  <div class="relative max-w-2xl mx-auto">
    <p class="scroll-reveal flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-salon-vert-clair">
      <span class="inline-block w-8 h-px bg-salon-vert-clair" aria-hidden="true"></span>
      <span>{data.info.wordmark1} &amp; {data.info.wordmark2}</span>
      <span class="inline-block w-8 h-px bg-salon-vert-clair" aria-hidden="true"></span>
    </p>

    <h2 class="scroll-reveal mt-6 font-fraunces font-bold text-salon-blanc leading-[1.1]" style="font-size: clamp(36px, 5vw, 64px);">
      Envie de
      <span class="italic font-medium text-salon-vert-clair">changer de coupe ?</span>
    </h2>

    <p class="scroll-reveal mt-6 text-salon-blanc/75 leading-relaxed">
      Prenez rendez-vous, on s'occupe du reste. Diagnostic offert, conseils sans pression, résultat à votre image.
    </p>

    <div class="scroll-reveal mt-10 flex flex-col sm:flex-row gap-3 sm:gap-5 items-center justify-center">
      <a
        href="#rendez-vous"
        class="inline-flex items-center justify-center h-16 px-10 text-sm font-semibold uppercase tracking-[0.22em] rounded-full bg-salon-vert text-salon-blanc hover:bg-[#3D5C4A] hover:scale-[1.02] transition-all"
        style="box-shadow: 0 12px 40px rgb(92 122 102 / 0.50);"
      >
        Prendre rendez-vous
      </a>
      <a
        href={`tel:${data.info.telephoneHref}`}
        class="inline-flex items-center justify-center h-16 px-7 text-sm font-semibold uppercase tracking-[0.22em] text-salon-blanc/85 hover:text-salon-blanc transition-colors gap-2"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>ou j'appelle directement</span>
      </a>
    </div>
    <p class="scroll-reveal mt-6 text-xs uppercase tracking-[0.28em] text-salon-blanc/50">
      Réponse sous 24h ouvrées · Sans engagement
    </p>
  </div>
</section>
