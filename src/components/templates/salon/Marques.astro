---
/**
 * Marques — anciens noms de marques réelles supprimés.
 * Remplacé par un manifeste produit factuel et 4 critères de sélection.
 */
const filieres = [
  { label: 'Sans sulfates', value: '100%' },
  { label: 'Sans silicones', value: '85%' },
  { label: 'Filière courte', value: 'Privilégiée' },
  { label: 'Vegan friendly', value: 'Sur demande' },
];
---

<section aria-labelledby="produits-titre" class="bg-salon-vert text-salon-blanc py-20 md:py-28 relative">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="scroll-reveal font-dm-sans uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-salon-blanc/80 mb-4">— Les produits sur les étagères —</p>
      <h2 id="produits-titre" class="scroll-reveal font-fraunces text-salon-blanc text-3xl md:text-5xl leading-tight">
        Choisis un par un,
        <em class="font-fraunces italic block md:inline">pas un catalogue grossiste.</em>
      </h2>
      <p class="scroll-reveal mt-6 text-salon-blanc/80 leading-relaxed max-w-xl mx-auto">
        On travaille avec une poignée de marques pro, sélectionnées pour leur tenue, leur respect du cuir chevelu et leur transparence d'ingrédients.
      </p>
    </div>

    <div class="border-t border-salon-blanc/20 pt-10">
      <p class="scroll-reveal text-center font-dm-sans uppercase tracking-[0.3em] text-[10px] text-salon-blanc/70 mb-8">— Critères de sélection —</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-10">
        {filieres.map((f) => (
          <div class="scroll-reveal text-center">
            <p class="font-fraunces text-salon-blanc text-2xl md:text-3xl mb-2 leading-tight">{f.value}</p>
            <p class="font-dm-sans uppercase tracking-[0.18em] text-[10px] text-salon-blanc/80">{f.label}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
