---
/**
 * Manifesto — citation Fraunces italique grande, fond gris très clair.
 * Filets verts haut/bas pour cadrer la phrase.
 */
import data from '../../../data/templates/salon.json';
---

<section class="relative bg-salon-gris py-20 md:py-32 px-6 md:px-10 border-y border-salon-vert-clair/20 overflow-hidden">
  <!-- Mèche de cheveux SVG décorative — boucle douce, désactivée si reduce motion -->
  <svg
    class="salon-meche absolute top-6 right-6 md:top-10 md:right-12 w-16 md:w-24 h-auto pointer-events-none opacity-60"
    viewBox="0 0 80 200"
    fill="none"
    aria-hidden="true"
  >
    <path
      d="M40 0 C 38 30, 44 55, 36 85 S 42 140, 38 175 Q 36 190, 40 200"
      stroke="#C4A267"
      stroke-width="1.2"
      stroke-linecap="round"
      opacity="0.7"
    />
    <path
      d="M40 0 C 42 25, 36 60, 44 90 S 34 145, 42 178 Q 44 192, 40 200"
      stroke="#16282A"
      stroke-width="0.9"
      stroke-linecap="round"
      opacity="0.45"
    />
    <path
      d="M40 0 C 40 35, 40 70, 40 105 S 40 160, 40 200"
      stroke="#C4A267"
      stroke-width="0.6"
      stroke-linecap="round"
      opacity="0.35"
    />
  </svg>

  <div class="max-w-3xl mx-auto text-center relative">
    <!-- Filet vert supérieur -->
    <div class="scroll-reveal mx-auto w-12 h-px bg-salon-vert-clair mb-10" aria-hidden="true"></div>

    <blockquote class="scroll-reveal">
      <p class="font-fraunces italic text-salon-noir leading-[1.3]" style="font-size: clamp(26px, 4vw, 44px);">
        « {data.manifesto} »
      </p>
    </blockquote>

    <!-- Filet vert inférieur -->
    <div class="scroll-reveal mx-auto w-12 h-px bg-salon-vert-clair mt-10" aria-hidden="true"></div>
  </div>
</section>

<style>
  .salon-meche {
    transform-origin: 40px 0;
    animation: salon-meche-sway 10s ease-in-out infinite;
    will-change: transform;
  }
  @keyframes salon-meche-sway {
    0%, 100% { transform: rotate(-3deg); }
    50% { transform: rotate(3deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .salon-meche { animation: none; transform: none; }
  }
</style>
