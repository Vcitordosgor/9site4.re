---
/**
 * Duo — petite section sobre présentant Meg & Dan.
 * Pas de portraits stock, juste 2 avatars CSS avec initiales + rôle + 1 ligne.
 */
const duo = [
  {
    initiale: 'M',
    prenom: 'Meg',
    role: 'Coloration · Soin',
    note: 'Diagnostic capillaire, formules respectueuses.',
  },
  {
    initiale: 'D',
    prenom: 'Dan',
    role: 'Coupe · Coiffage',
    note: 'Méthode américaine, ciseaux à la mèche.',
  },
];
---

<section id="duo" aria-labelledby="duo-titre" class="bg-salon-blanc py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-xl mx-auto mb-12 md:mb-14">
      <p class="scroll-reveal flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-salon-vert">
        <span class="inline-block w-8 h-px bg-salon-vert" aria-hidden="true"></span>
        <span>Le duo</span>
        <span class="inline-block w-8 h-px bg-salon-vert" aria-hidden="true"></span>
      </p>
      <h2 id="duo-titre" class="scroll-reveal mt-5 font-fraunces font-bold text-salon-noir leading-[1.05]" style="font-size: clamp(30px, 4.4vw, 48px);">
        Meg <span class="italic font-medium text-salon-vert">&amp;</span> Dan.
      </h2>
      <p class="scroll-reveal mt-4 text-salon-noir/70 leading-relaxed text-base md:text-lg">
        Deux coiffeurs, une vision. Coupe et couleur à quatre mains.
      </p>
    </header>

    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-14 max-w-3xl mx-auto">
      {duo.map((p) => (
        <li class="scroll-reveal flex items-center gap-5 sm:gap-6">
          <div class="shrink-0 w-20 h-20 md:w-24 md:h-24 rounded-full flex items-center justify-center bg-salon-vert text-salon-blanc ring-1 ring-salon-vert">
            <span class="font-fraunces italic font-bold" style="font-size: clamp(36px, 5vw, 48px); line-height: 1;">{p.initiale}</span>
          </div>
          <div>
            <p class="font-fraunces font-bold text-salon-noir text-2xl md:text-3xl leading-tight">{p.prenom}</p>
            <p class="mt-1 text-xs uppercase tracking-[0.22em] text-salon-vert font-semibold">{p.role}</p>
            <p class="mt-2 text-sm text-salon-noir/70 leading-relaxed max-w-xs">{p.note}</p>
          </div>
        </li>
      ))}
    </ul>

  </div>
</section>
