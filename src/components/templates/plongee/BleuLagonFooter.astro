---
import data from '../../../data/templates/plongee.json';
const info = data.info;
const year = new Date().getFullYear();
---
<footer class="relative bg-plongee-charbon text-plongee-ecume overflow-hidden">
  <svg class="block w-full text-plongee-abysse -mb-px" viewBox="0 0 1440 80" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,40 C240,80 480,0 720,30 C960,60 1200,10 1440,40 L1440,0 L0,0 Z" fill="currentColor"/>
  </svg>

  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 py-16 lg:py-24 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-5">
      <a href="#top" class="flex items-baseline gap-1 font-fraunces leading-none">
        <span class="text-3xl">{info.wordmark1}</span>
        <span class="text-3xl italic text-plongee-lagon">{info.wordmark2}</span>
        <span class="text-[10px] uppercase tracking-[0.3em] ml-2 opacity-60">{info.wordmark3}</span>
      </a>
      <p class="mt-6 font-inter text-sm text-plongee-ecume/65 max-w-sm leading-relaxed">{info.soustitre} · depuis {info.annee}. Petit centre, gros respect du récif.</p>
    </div>

    <div class="lg:col-span-3">
      <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-corail mb-4">Contact</div>
      <ul class="space-y-2 font-inter text-sm text-plongee-ecume/80">
        <li>{info.adresseLigne1}</li>
        <li>{info.adresseLigne2}</li>
        <li><a href={`tel:${info.telephoneHref}`} class="hover:text-plongee-corail">{info.telephone}</a></li>
        <li><a href={`mailto:${info.email}`} class="hover:text-plongee-corail">{info.email}</a></li>
      </ul>
    </div>

    <div class="lg:col-span-4">
      <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-corail mb-4">Horaires</div>
      <ul class="space-y-2 font-inter text-sm text-plongee-ecume/80">
        {info.horaires.map(h => (
          <li class="flex justify-between gap-4 border-b border-plongee-ecume/10 py-1">
            <span>{h.jour}</span>
            <span class={h.ouvert ? 'text-plongee-lagon' : 'text-plongee-ecume/40'}>{h.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-plongee-ecume/10 py-6 text-center font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-ecume/40">
    © {year} {info.nom} · {info.agrement}
  </div>
</footer>
