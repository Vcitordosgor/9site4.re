---
import data from '../../../data/templates/plongee.json';
const g = data.galerie;
---
<section class="relative bg-plongee-abysse text-plongee-ecume py-24 lg:py-36 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-12">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-plongee-corail"></span>
        <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-ecume/60">05 — Galerie</span>
      </div>
      <h2 class="font-fraunces font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.98]">
        Sous la surface,<br/><em class="italic text-plongee-lagon">tout change.</em>
      </h2>
    </div>

    <div class="grid grid-cols-6 grid-rows-[180px_180px_180px_180px] lg:grid-rows-[220px_220px_220px] gap-3 lg:gap-4">
      <figure class="group col-span-3 row-span-2 relative rounded-2xl overflow-hidden">
        <img src={g[0]} alt="Plongée" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"/>
      </figure>
      <figure class="group col-span-3 lg:col-span-2 relative rounded-2xl overflow-hidden">
        <img src={g[1]} alt="Plongée" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"/>
      </figure>
      <figure class="group col-span-3 lg:col-span-1 relative rounded-2xl overflow-hidden">
        <img src={g[2]} alt="Plongée" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"/>
      </figure>
      <figure class="group col-span-2 lg:col-span-1 relative rounded-2xl overflow-hidden">
        <img src={g[3]} alt="Plongée" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"/>
      </figure>
      <figure class="group col-span-2 relative rounded-2xl overflow-hidden">
        <img src={g[4]} alt="Plongée" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"/>
      </figure>
      <figure class="group col-span-6 lg:col-span-3 relative rounded-2xl overflow-hidden">
        <img src={g[5]} alt="Plongée" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-110"/>
      </figure>
    </div>
  </div>
</section>
