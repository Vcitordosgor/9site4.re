---
/**
 * Galerie — masonry sous-marine, photos aspects variés.
 * Hover scale, ambiance plongée.
 */
const photos = [
  {
    src: '/images/plongee/extra-1.webp',
    alt: 'Tortue de mer nageant au-dessus d\'un récif corallien',
    span: 'sm:row-span-2',
  },
  {
    src: '/images/plongee/extra-2.webp',
    alt: 'Banc de poissons argentés en formation serrée',
    span: '',
  },
  {
    src: '/images/plongee/extra-3.webp',
    alt: 'Plongeur en silhouette devant la lumière de surface',
    span: 'sm:row-span-2',
  },
  {
    src: '/images/plongee/extra-4.webp',
    alt: 'Corail mou orange et bleu sur fond sableux',
    span: '',
  },
  {
    src: '/images/plongee/extra-5.webp',
    alt: 'Bouteille de plongée et matériel sur un ponton',
    span: '',
  },
];
---

<section class="relative bg-plongee-ecume py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="mb-14 md:mb-16 max-w-2xl">
      <p class="scroll-reveal font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-corail">
        Galerie sous-marine
      </p>
      <h2 class="scroll-reveal mt-4 font-space-grotesk font-bold text-plongee-marine leading-[1] tracking-tight" style="font-size: clamp(30px, 4.2vw, 48px);">
        Ce que vous verrez<br/>
        <span class="text-plongee-lagon">à dix mètres sous l'écume.</span>
      </h2>
    </header>

    <ul class="grid grid-cols-2 sm:grid-cols-4 gap-3 sm:auto-rows-[180px]">
      {photos.map((p, i) => (
        <li
          class:list={['scroll-reveal relative overflow-hidden rounded-2xl bg-plongee-marine', p.span]}
          style={`transition-delay: ${i * 60}ms`}
        >
          <img
            src={p.src}
            alt={p.alt}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover transition-transform duration-700 hover:scale-110"
          />
          <span class="pointer-events-none absolute inset-0 ring-1 ring-inset ring-plongee-ecume/20 rounded-2xl" aria-hidden="true"></span>
        </li>
      ))}
    </ul>
  </div>
</section>
