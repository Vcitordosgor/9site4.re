---
import data from '../../../data/templates/plongee.json';
const journee = data.journee;
---
<section id="journee" class="relative bg-plongee-sable/60 text-plongee-charbon py-24 lg:py-36 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="max-w-2xl mb-16">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-plongee-corail"></span>
        <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-charbon/60">03 — Une journée</span>
      </div>
      <h2 class="font-fraunces font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.98] tracking-tight">
        Six heures<br/><em class="italic text-plongee-lagon">sous l'eau ou pas loin.</em>
      </h2>
    </div>

    <!-- Timeline horizontale -->
    <div class="relative -mx-6 lg:mx-0 overflow-x-auto pb-4" style="scrollbar-width: thin;">
      <div class="flex gap-px min-w-max lg:min-w-0 lg:grid lg:grid-cols-6 px-6 lg:px-0">
        {journee.map((j, i) => (
          <div class="relative w-72 lg:w-auto flex flex-col bg-plongee-ecume rounded-2xl lg:rounded-none lg:first:rounded-l-2xl lg:last:rounded-r-2xl p-6 lg:p-8 border-r border-plongee-charbon/10 last:border-r-0">
            <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-corail">{String(i+1).padStart(2,'0')}</div>
            <div class="mt-2 font-fraunces text-4xl text-plongee-marine">{j.heure}</div>
            <h3 class="mt-4 font-inter font-semibold text-sm uppercase tracking-[0.16em] text-plongee-charbon">{j.titre}</h3>
            <p class="mt-3 font-inter text-sm text-plongee-charbon/65 leading-relaxed">{j.texte}</p>
            <div class="mt-6 h-px w-8 bg-plongee-corail"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
