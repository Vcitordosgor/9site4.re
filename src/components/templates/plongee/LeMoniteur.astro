---
import data from '../../../data/templates/plongee.json';
const m = data.moniteur;
---
<section id="moniteur" class="relative bg-plongee-ecume text-plongee-charbon py-24 lg:py-36">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 grid lg:grid-cols-12 gap-12 lg:gap-20">
    <div class="lg:col-span-6 relative">
      <div class="relative aspect-[4/5] rounded-3xl overflow-hidden bg-plongee-marine">
        <img src={m.photo} alt={m.photoAlt} loading="lazy" class="absolute inset-0 w-full h-full object-cover"/>
        <div class="absolute bottom-0 inset-x-0 h-1/3 bg-gradient-to-t from-plongee-abysse/80 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6 text-plongee-ecume">
          <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-corail">Le moniteur</div>
          <div class="mt-2 font-fraunces text-3xl">{m.nom}</div>
        </div>
      </div>
      <div class="absolute -top-6 -right-4 lg:-right-10 bg-plongee-corail text-plongee-ecume rounded-2xl px-5 py-4 rotate-3 shadow-xl">
        <div class="font-fraunces text-3xl leading-none">1 500+</div>
        <div class="font-jetbrains-mono text-[9px] uppercase tracking-[0.25em] mt-1">plongées</div>
      </div>
      <div class="absolute -bottom-6 -left-4 lg:-left-10 bg-plongee-abysse text-plongee-ecume rounded-2xl px-5 py-4 -rotate-2 shadow-xl">
        <div class="font-fraunces text-3xl leading-none">12 ans</div>
        <div class="font-jetbrains-mono text-[9px] uppercase tracking-[0.25em] mt-1">d'encadrement</div>
      </div>
    </div>

    <div class="lg:col-span-6 flex flex-col justify-center">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-plongee-corail"></span>
        <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-charbon/60">04 — Qui vous accompagne</span>
      </div>
      <h2 class="font-fraunces font-light text-[clamp(2.5rem,5vw,4rem)] leading-[1] tracking-tight">
        Antoine,<br/><em class="italic text-plongee-lagon">12 ans à descendre.</em>
      </h2>
      <p class="mt-8 font-inter text-base lg:text-lg leading-relaxed text-plongee-charbon/75 max-w-xl">{m.bio}</p>

      <div class="mt-10 space-y-3">
        {m.diplomes.map(d => (
          <div class="flex items-center gap-4 py-3 border-b border-plongee-charbon/10">
            <span class="w-8 h-8 rounded-full bg-plongee-lagon/15 text-plongee-lagon flex items-center justify-center flex-shrink-0">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M20 6L9 17l-5-5"/></svg>
            </span>
            <span class="font-inter text-sm">{d}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
