---
import data from '../../../data/templates/plongee.json';
const info = data.info;
const stats = data.stats;
---
<section id="top" class="relative min-h-screen w-full overflow-hidden bg-plongee-abysse text-plongee-ecume">
  <div class="absolute inset-0">
    <img src={info.photoHero} alt={info.photoHeroAlt} class="w-full h-full object-cover scale-105 motion-safe:animate-[hero-zoom_3s_ease-out_forwards]" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-b from-plongee-abysse/70 via-plongee-abysse/45 to-plongee-abysse"></div>
  </div>

  <svg class="absolute inset-0 w-full h-full mix-blend-overlay opacity-30 pointer-events-none" aria-hidden="true" preserveAspectRatio="none" viewBox="0 0 1440 900">
    <defs>
      <radialGradient id="bl-caustic" cx="50%" cy="0%" r="80%">
        <stop offset="0%" stop-color="#5BC0BE" stop-opacity="0.7"/>
        <stop offset="100%" stop-color="#0A2342" stop-opacity="0"/>
      </radialGradient>
    </defs>
    <ellipse cx="720" cy="0" rx="720" ry="380" fill="url(#bl-caustic)"/>
  </svg>

  <svg class="absolute -bottom-1 inset-x-0 w-full text-plongee-ecume" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,60 C240,120 480,0 720,40 C960,80 1200,30 1440,60 L1440,120 L0,120 Z" fill="currentColor" opacity="0.95"/>
  </svg>

  <div class="relative z-10 max-w-[1400px] mx-auto px-6 lg:px-12 pt-32 lg:pt-40 pb-40 lg:pb-48 min-h-screen flex flex-col justify-center">
    <div class="flex items-center gap-3 mb-8 motion-safe:animate-[hero-rise_900ms_ease-out_both]">
      <span class="inline-block w-10 h-px bg-plongee-corail"></span>
      <span class="font-inter text-[11px] uppercase tracking-[0.32em] text-plongee-ecume/70">{info.soustitre}</span>
    </div>

    <h1 class="font-fraunces font-light text-[clamp(3rem,9vw,8.5rem)] leading-[0.95] tracking-tight max-w-5xl motion-safe:animate-[hero-rise_1.1s_ease-out_120ms_both]">
      {info.tagline}<br/>
      <em class="italic text-plongee-lagon">{info.taglineItalic}</em>
    </h1>

    <p class="mt-10 max-w-xl text-base lg:text-lg leading-relaxed text-plongee-ecume/85 font-inter motion-safe:animate-[hero-rise_1.2s_ease-out_240ms_both]">
      {data.promesse}
    </p>

    <div class="mt-10 flex flex-wrap gap-4 motion-safe:animate-[hero-rise_1.3s_ease-out_360ms_both]">
      <a href="#formules" class="inline-flex items-center gap-3 h-14 px-8 rounded-full bg-plongee-corail text-plongee-ecume text-xs font-inter font-semibold uppercase tracking-[0.22em] hover:scale-[1.03] transition-transform">
        Réserver une plongée
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 12h14M14 5l7 7-7 7"/></svg>
      </a>
      <a href="#profondeurs" class="inline-flex items-center gap-3 h-14 px-8 rounded-full border border-plongee-ecume/30 text-plongee-ecume text-xs font-inter uppercase tracking-[0.22em] hover:bg-plongee-ecume/10 transition-colors">
        Choisir ma profondeur
      </a>
    </div>

    <div class="mt-20 grid grid-cols-2 lg:grid-cols-4 gap-px bg-plongee-ecume/10 border border-plongee-ecume/10 rounded-2xl overflow-hidden backdrop-blur-sm motion-safe:animate-[hero-rise_1.4s_ease-out_500ms_both]">
      {stats.map(s => (
        <div class="bg-plongee-abysse/40 px-5 py-6">
          <div class="font-fraunces text-2xl lg:text-3xl text-plongee-lagon">{s.valeur}</div>
          <div class="font-inter text-[11px] uppercase tracking-[0.2em] mt-2 text-plongee-ecume/60">{s.label}</div>
        </div>
      ))}
    </div>
  </div>

  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 flex flex-col items-center gap-2 motion-safe:animate-[float_3s_ease-in-out_infinite]">
    <span class="font-jetbrains-mono text-[10px] uppercase tracking-[0.4em] text-plongee-ecume/60">Plonger</span>
    <span class="block w-px h-12 bg-plongee-ecume/40"></span>
  </div>
</section>
<style>
  @keyframes hero-rise { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes hero-zoom { from { transform: scale(1.12); } to { transform: scale(1.04); } }
  @keyframes float { 0%,100% { transform: translate(-50%, 0); } 50% { transform: translate(-50%, 8px); } }
</style>
