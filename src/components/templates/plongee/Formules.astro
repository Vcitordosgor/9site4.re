---
import data from '../../../data/templates/plongee.json';
const formules = data.formules;
---
<section id="formules" class="relative bg-plongee-abysse text-plongee-ecume py-24 lg:py-36 overflow-hidden">
  <div class="absolute inset-0 opacity-[0.05]" style="background-image: radial-gradient(#5BC0BE 1px, transparent 1px); background-size: 28px 28px;"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-16">
      <div class="max-w-2xl">
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-10 h-px bg-plongee-corail"></span>
          <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-ecume/60">02 — Formules</span>
        </div>
        <h2 class="font-fraunces font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.98] tracking-tight">
          Trois formules,<br/><em class="italic text-plongee-lagon">une seule philosophie.</em>
        </h2>
      </div>
      <p class="font-inter text-sm lg:text-base text-plongee-ecume/70 max-w-sm">
        Tarifs démonstration. Pour une cotation réelle adaptée à votre niveau, appelez-nous.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {formules.map((f, i) => (
        <article class={`group relative flex flex-col p-7 lg:p-9 rounded-3xl transition-all duration-500 hover:-translate-y-1 ${i === 1 ? 'bg-plongee-corail text-plongee-abysse' : 'bg-plongee-marine/40 border border-plongee-ecume/10 hover:border-plongee-lagon/50'}`}>
          <div class={`font-jetbrains-mono text-[10px] uppercase tracking-[0.32em] ${i === 1 ? 'text-plongee-abysse/70' : 'text-plongee-lagon'}`}>{f.niveau}</div>
          <h3 class="mt-4 font-fraunces text-3xl lg:text-4xl leading-tight">{f.titre}</h3>
          <p class={`mt-4 text-sm font-inter leading-relaxed flex-1 ${i === 1 ? 'text-plongee-abysse/80' : 'text-plongee-ecume/70'}`}>{f.description}</p>
          <div class="mt-6 flex items-baseline gap-2">
            <span class="font-fraunces text-5xl">{f.prix}</span>
            <span class={`text-xs font-inter ${i === 1 ? 'text-plongee-abysse/60' : 'text-plongee-ecume/50'}`}>/pers · démo</span>
          </div>
          <ul class={`mt-6 space-y-2.5 text-sm font-inter ${i === 1 ? 'text-plongee-abysse/85' : 'text-plongee-ecume/80'}`}>
            {f.inclus.map(item => (
              <li class="flex gap-2.5">
                <span class={`mt-1.5 w-1.5 h-1.5 rounded-full flex-shrink-0 ${i === 1 ? 'bg-plongee-abysse' : 'bg-plongee-corail'}`}></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <div class={`mt-6 pt-6 border-t ${i === 1 ? 'border-plongee-abysse/15' : 'border-plongee-ecume/10'} flex items-center justify-between text-[10px] font-jetbrains-mono uppercase tracking-[0.2em]`}>
            <span>{f.duree.split(' · ')[0]}</span>
            <span>{f.profondeur}</span>
          </div>
          <a href="#contact" class={`mt-6 inline-flex items-center justify-center h-12 rounded-full text-[11px] font-semibold uppercase tracking-[0.22em] font-inter transition ${i === 1 ? 'bg-plongee-abysse text-plongee-ecume hover:bg-plongee-charbon' : 'border border-plongee-ecume/30 text-plongee-ecume hover:bg-plongee-ecume hover:text-plongee-abysse'}`}>
            Réserver
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
