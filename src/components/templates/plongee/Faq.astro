---
import data from '../../../data/templates/plongee.json';
const faq = data.faq;
---
<section class="relative bg-plongee-ecume text-plongee-charbon py-24 lg:py-36">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="inline-block w-10 h-px bg-plongee-corail"></span>
      <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-charbon/60">08 — Questions</span>
    </div>
    <h2 class="font-fraunces font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.98] tracking-tight max-w-3xl">
      Tout ce qu'on nous demande,<br/><em class="italic text-plongee-lagon">on y répond.</em>
    </h2>

    <div class="mt-14 divide-y divide-plongee-charbon/10 border-y border-plongee-charbon/10">
      {faq.map((f, i) => (
        <details class="group py-6">
          <summary class="flex items-center justify-between gap-6 cursor-pointer list-none">
            <div class="flex items-baseline gap-5">
              <span class="font-jetbrains-mono text-xs text-plongee-corail">{String(i+1).padStart(2,'0')}</span>
              <span class="font-fraunces text-xl lg:text-2xl text-plongee-charbon">{f.q}</span>
            </div>
            <span class="w-9 h-9 rounded-full border border-plongee-charbon/20 flex items-center justify-center flex-shrink-0 transition-transform group-open:rotate-45 group-open:bg-plongee-corail group-open:border-plongee-corail group-open:text-plongee-ecume">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <p class="mt-4 ml-10 font-inter text-base leading-relaxed text-plongee-charbon/70 max-w-3xl">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
