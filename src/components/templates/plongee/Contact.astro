---
import data from '../../../data/templates/plongee.json';
const info = data.info;
---
<section id="contact" class="relative bg-plongee-abysse text-plongee-ecume py-24 lg:py-36 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-6">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-plongee-corail"></span>
        <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-ecume/60">09 — Réserver</span>
      </div>
      <h2 class="font-fraunces font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[0.98] tracking-tight">
        Prêt pour<br/><em class="italic text-plongee-lagon">votre première bulle ?</em>
      </h2>
      <p class="mt-8 font-inter text-base lg:text-lg leading-relaxed text-plongee-ecume/75 max-w-md">Un appel, un sms WhatsApp, ou ce formulaire. On répond sous 24h en haute saison, plus vite hors saison.</p>

      <div class="mt-12 space-y-5">
        <a href={`tel:${info.telephoneHref}`} class="flex items-center gap-5 group">
          <span class="w-12 h-12 rounded-full bg-plongee-marine/50 flex items-center justify-center text-plongee-lagon group-hover:bg-plongee-corail group-hover:text-plongee-ecume transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.37 1.9.72 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.35 1.85.59 2.81.72A2 2 0 0 1 22 16.92Z"/></svg>
          </span>
          <div>
            <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-ecume/50">Téléphone</div>
            <div class="font-fraunces text-2xl text-plongee-ecume mt-1">{info.telephone}</div>
          </div>
        </a>
        <a href={`https://wa.me/${info.whatsapp}`} class="flex items-center gap-5 group">
          <span class="w-12 h-12 rounded-full bg-plongee-marine/50 flex items-center justify-center text-plongee-lagon group-hover:bg-plongee-corail group-hover:text-plongee-ecume transition-colors">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.7-.8-2-.9-.3-.1-.4-.1-.6.2-.2.3-.7.9-.8 1.1-.2.2-.3.2-.6.1-.3-.1-1.2-.4-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.3.4-.5.1-.2.2-.3.2-.5.1-.2 0-.4 0-.5 0-.1-.6-1.5-.9-2-.2-.5-.4-.4-.6-.4h-.5c-.2 0-.5.1-.7.4-.2.3-.9.9-.9 2.3 0 1.4 1 2.7 1.1 2.9.1.2 2 3 4.8 4.2 1.7.7 2.3.8 3.1.7.5-.1 1.7-.7 1.9-1.3.2-.7.2-1.2.2-1.3-.1-.1-.3-.2-.6-.3M12 2C6.5 2 2 6.5 2 12c0 1.8.5 3.5 1.3 4.9L2 22l5.3-1.4c1.4.7 3 1.1 4.7 1.1 5.5 0 10-4.5 10-10S17.5 2 12 2"/></svg>
          </span>
          <div>
            <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-ecume/50">WhatsApp</div>
            <div class="font-fraunces text-2xl text-plongee-ecume mt-1">Réponse rapide</div>
          </div>
        </a>
        <div class="flex items-center gap-5">
          <span class="w-12 h-12 rounded-full bg-plongee-marine/50 flex items-center justify-center text-plongee-lagon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          </span>
          <div>
            <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-ecume/50">Adresse</div>
            <div class="font-fraunces text-lg text-plongee-ecume mt-1">{info.adresseLigne1}</div>
          </div>
        </div>
      </div>
    </div>

    <form class="lg:col-span-6 bg-plongee-marine/40 border border-plongee-ecume/10 rounded-3xl p-6 lg:p-10 backdrop-blur-sm">
      <div class="font-jetbrains-mono text-[11px] uppercase tracking-[0.3em] text-plongee-lagon mb-2">Formulaire de pré-réservation</div>
      <h3 class="font-fraunces text-3xl lg:text-4xl mb-8">Choisissez votre formule</h3>

      <fieldset class="mb-7">
        <legend class="font-inter text-xs uppercase tracking-[0.2em] text-plongee-ecume/60 mb-3">Formule</legend>
        <div class="grid grid-cols-3 gap-2">
          {data.formules.map((f, i) => (
            <label class="relative cursor-pointer">
              <input type="radio" name="formule" value={f.id} class="peer sr-only" checked={i === 0} />
              <div class="p-3 rounded-xl border border-plongee-ecume/15 text-center peer-checked:bg-plongee-corail peer-checked:border-plongee-corail peer-checked:text-plongee-abysse transition">
                <div class="font-fraunces text-sm leading-tight">{f.titre.split(' ').slice(0,2).join(' ')}</div>
                <div class="font-jetbrains-mono text-[9px] mt-1 uppercase tracking-[0.2em] opacity-70">{f.profondeur}</div>
              </div>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="grid sm:grid-cols-2 gap-4 mb-4">
        <label class="block">
          <span class="font-inter text-xs uppercase tracking-[0.2em] text-plongee-ecume/60">Prénom</span>
          <input type="text" name="prenom" class="mt-2 w-full h-12 px-4 rounded-xl bg-plongee-abysse/60 border border-plongee-ecume/15 text-plongee-ecume font-inter text-sm focus:border-plongee-corail focus:outline-none"/>
        </label>
        <label class="block">
          <span class="font-inter text-xs uppercase tracking-[0.2em] text-plongee-ecume/60">Téléphone</span>
          <input type="tel" name="tel" class="mt-2 w-full h-12 px-4 rounded-xl bg-plongee-abysse/60 border border-plongee-ecume/15 text-plongee-ecume font-inter text-sm focus:border-plongee-corail focus:outline-none"/>
        </label>
      </div>

      <label class="block mb-4">
        <span class="font-inter text-xs uppercase tracking-[0.2em] text-plongee-ecume/60">Date souhaitée</span>
        <input type="date" name="date" class="mt-2 w-full h-12 px-4 rounded-xl bg-plongee-abysse/60 border border-plongee-ecume/15 text-plongee-ecume font-inter text-sm focus:border-plongee-corail focus:outline-none"/>
      </label>

      <label class="block mb-6">
        <span class="font-inter text-xs uppercase tracking-[0.2em] text-plongee-ecume/60">Message (optionnel)</span>
        <textarea name="message" rows="3" class="mt-2 w-full px-4 py-3 rounded-xl bg-plongee-abysse/60 border border-plongee-ecume/15 text-plongee-ecume font-inter text-sm focus:border-plongee-corail focus:outline-none resize-none"></textarea>
      </label>

      <button type="submit" class="w-full h-14 rounded-full bg-plongee-corail text-plongee-ecume text-xs font-inter font-semibold uppercase tracking-[0.22em] hover:scale-[1.02] transition-transform">
        Envoyer la demande
      </button>
      <p class="mt-4 font-inter text-[11px] text-plongee-ecume/50 text-center">À titre indicatif · formulaire non connecté.</p>
    </form>
  </div>
</section>
