---
import data from '../../../data/templates/plongee.json';
const sci = data.scientifique;
---
<section class="relative bg-plongee-marine text-plongee-ecume py-14 lg:py-20 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="inline-block w-2 h-2 rounded-full bg-plongee-corail animate-pulse"></span>
      <span class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-ecume/60">Aujourd'hui · côte ouest</span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-px bg-plongee-ecume/10 border border-plongee-ecume/10 rounded-2xl overflow-hidden">
      {sci.map(s => (
        <div class="bg-plongee-marine px-5 py-6 lg:py-8">
          <div class="font-jetbrains-mono text-[10px] uppercase tracking-[0.3em] text-plongee-lagon">{s.label}</div>
          <div class="mt-3 font-fraunces text-4xl lg:text-5xl">{s.valeur}</div>
        </div>
      ))}
    </div>
  </div>
</section>
