---
/**
 * Bandeau — bandeau plein largeur corail/marine, 3 garanties securite plongee.
 */
---

<section class="relative bg-plongee-corail text-plongee-abysse py-12 md:py-16 px-6 md:px-10 overflow-hidden">
  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-plongee-abysse/20">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2">
        <span class="font-space-grotesk font-bold text-plongee-abysse leading-none" style="font-size: clamp(36px, 4.6vw, 54px);">FFESSM</span>
        <p class="mt-2 font-jetbrains font-medium uppercase tracking-[0.22em] text-plongee-abysse/80 text-[11px]">
          Fédération française certifiée
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 80ms">
        <span class="font-space-grotesk font-bold text-plongee-abysse leading-none" style="font-size: clamp(36px, 4.6vw, 54px);">6 max</span>
        <p class="mt-2 font-jetbrains font-medium uppercase tracking-[0.22em] text-plongee-abysse/80 text-[11px]">
          Plongeurs par sortie, jamais plus
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 160ms">
        <span class="font-space-grotesk font-bold text-plongee-abysse leading-none" style="font-size: clamp(36px, 4.6vw, 54px);">O2 + DAE</span>
        <p class="mt-2 font-jetbrains font-medium uppercase tracking-[0.22em] text-plongee-abysse/80 text-[11px]">
          À bord de chaque sortie
        </p>
      </li>
    </ul>
  </div>
</section>
