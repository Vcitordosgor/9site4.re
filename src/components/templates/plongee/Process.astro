---
/**
 * Process — déroulé d'une journée de plongée.
 * Horodaté style log de plongée.
 */
const steps = [
  { hour: '08h00', titre: 'Accueil au club', desc: 'Café, briefing visuel du site, vérification du matériel personnel et adaptation des combis.' },
  { hour: '08h45', titre: 'Mise à l\'eau', desc: 'Briefing technique : profondeur max, points d\'intérêt, signaux. Départ semi-rigide vers le tombant.' },
  { hour: '09h30', titre: 'Plongée encadrée', desc: 'Immersion à 18 m, palanquée de 4 max par moniteur. Durée 40 à 50 min selon consommation.' },
  { hour: '11h00', titre: 'Pause surface', desc: 'Snack, hydratation, partage des observations. Discussion sur la deuxième plongée.' },
  { hour: '12h00', titre: 'Seconde palanquée', desc: 'Site différent, profondeur réduite à 15 m. Idéal pour la faune corallienne.' },
  { hour: '13h30', titre: 'Retour & débriefing', desc: 'Rinçage matériel, débrief individuel, photos sous-marines envoyées le soir.' },
];
---

<section id="journee" class="relative bg-plongee-abysse text-plongee-ecume py-20 md:py-28 px-6 md:px-10 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-[0.08]" aria-hidden="true"
       style="background-image: linear-gradient(to bottom, transparent 50%, rgb(63 169 214 / 0.4) 50.1%, transparent 51%); background-size: 100% 12px;">
  </div>

  <div class="relative max-w-content mx-auto">
    <header class="max-w-2xl mb-14 md:mb-16">
      <p class="scroll-reveal font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-plongee-lagon">
        LOG · JOURNÉE TYPE
      </p>
      <h2 class="scroll-reveal mt-4 font-space-grotesk font-bold text-plongee-ecume leading-[1] tracking-tight" style="font-size: clamp(34px, 4.8vw, 56px);">
        Une journée<br/>
        <span class="text-plongee-corail">six heures sous-marines.</span>
      </h2>
    </header>

    <ol class="relative space-y-0 border-l-2 border-plongee-lagon/30 ml-7 sm:ml-9 pl-8 sm:pl-12">
      {steps.map((s, i) => (
        <li class="scroll-reveal relative pb-10 last:pb-0" style={`transition-delay: ${i * 70}ms`}>
          <span class="absolute -left-[44px] sm:-left-[56px] top-0 inline-flex items-center justify-center w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-plongee-marine border-2 border-plongee-lagon font-jetbrains-mono text-plongee-lagon text-[11px]">
            {s.hour}
          </span>
          <h3 class="font-space-grotesk font-bold text-plongee-ecume leading-tight" style="font-size: clamp(20px, 2.2vw, 26px);">
            {s.titre}
          </h3>
          <p class="mt-2 max-w-xl font-inter text-plongee-ecume/75 leading-[1.7]" style="font-size: 14.5px;">
            {s.desc}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
