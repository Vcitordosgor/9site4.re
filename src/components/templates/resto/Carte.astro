---
/**
 * Carte — 3 colonnes éditoriales (Entrées / Plats / Desserts) sans
 * cards, juste lignes typographiques. Style "menu de restaurant
 * gastronomique imprimé". Sous la carte : 3 menus à prix fixe.
 *
 * Signature : le menu dégustation se révèle plat par plat au scroll,
 * comme un service en plusieurs temps. Chaque plat apparaît avec un
 * fondu lent et une légère translation, en stagger ceremonieux.
 */
import data from '../../../data/templates/jardin.json';

// Aplatir tous les plats avec un index global pour le stagger ceremonieux
const categories = Object.entries(data.carte);
let globalIndex = 0;
const indexed = categories.map(([key, cat], colIndex) => {
  const items = cat.items.map((item) => ({ ...item, gi: globalIndex++ }));
  return { key, cat, colIndex, items };
});
---

<section id="carte" class="relative bg-resto-blanc py-24 md:py-36 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <!-- Mini bandeau Menus & Formules inline -->
    <div class="scroll-reveal max-w-4xl mx-auto mb-16 md:mb-20 px-6 py-5 md:py-6 bg-resto-bleu-encre/[0.03] ring-1 ring-resto-or/30 rounded-sm">
      <p class="text-center text-[10px] font-manrope uppercase tracking-[0.32em] text-resto-or font-semibold mb-3">
        Menus &amp; Formules
      </p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-bodoni italic text-resto-bleu-encre" style="font-size: clamp(14px, 1.6vw, 17px);">
        <span>Formule midi <span class="not-italic font-medium text-resto-bleu-roi">28€</span></span>
        <span class="text-resto-or" aria-hidden="true">·</span>
        <span>Menu dégustation <span class="not-italic font-medium text-resto-bleu-roi">65€</span></span>
        <span class="text-resto-or" aria-hidden="true">·</span>
        <span>Accord mets-vins <span class="not-italic font-medium text-resto-bleu-roi">+25€</span></span>
      </div>
    </div>

    <!-- Eyebrow + titre de section -->
    <header class="text-center max-w-2xl mx-auto mb-16 md:mb-24">
      <p class="scroll-reveal font-manrope font-medium text-[11px] uppercase tracking-[0.42em] text-resto-bleu-roi">
        <span aria-hidden="true">·</span> La carte du chef <span aria-hidden="true">·</span>
      </p>
      <h2 class="scroll-reveal mt-6 font-bodoni text-resto-bleu-encre leading-[1.05]" style="font-size: clamp(36px, 5.5vw, 64px);">
        Au gré du marché,
        <span class="italic text-resto-bleu-roi">au fil des saisons.</span>
      </h2>
      <p class="scroll-reveal mt-6 font-manrope text-resto-bleu-encre/70 leading-relaxed max-w-xl mx-auto">
        La carte change toutes les semaines. Voici une sélection
        représentative des plats du moment — chaque service se révèle au fil du regard.
      </p>
    </header>

    <!-- 3 colonnes éditoriales avec filets or de séparation -->
    <div class="grid md:grid-cols-3 gap-x-10 lg:gap-x-16 gap-y-16">
      {indexed.map(({ key, cat, colIndex, items }) => (
        <section class="relative" data-course-col>
          <!-- Filet vertical or à droite de chaque colonne sauf la dernière -->
          {colIndex < 2 && (
            <span class="hidden md:block absolute right-[-20px] lg:right-[-32px] top-12 bottom-12 w-px bg-resto-or/30" aria-hidden="true"></span>
          )}

          <!-- Titre catégorie centré avec ornement or -->
          <header class="course-reveal text-center mb-10" style={`--course-delay: ${colIndex * 120}ms`}>
            <span class="inline-flex items-center justify-center gap-3 text-resto-or" aria-hidden="true">
              <span class="block w-8 h-px bg-resto-or"></span>
              <span class="block w-1 h-1 rotate-45 bg-resto-or"></span>
              <span class="block w-8 h-px bg-resto-or"></span>
            </span>
            <p class="mt-3 font-manrope text-[10px] uppercase tracking-[0.42em] text-resto-or/80">
              Service {colIndex + 1}
            </p>
            <h3 class="mt-2 font-bodoni italic text-resto-bleu-encre" style="font-size: clamp(28px, 3.5vw, 36px);">
              {cat.titre}
            </h3>
          </header>

          <!-- Liste des plats : reveal ceremonieux plat par plat -->
          <ul class="space-y-7">
            {items.map((item, i) => (
              <li
                class="course-reveal course-dish group"
                style={`--course-delay: ${(colIndex * 120) + 180 + (i * 220)}ms`}
              >
                <div class="flex items-baseline gap-3">
                  <h4 class="font-bodoni font-medium text-resto-bleu-encre uppercase tracking-[0.04em] leading-snug transition-colors duration-300 group-hover:text-resto-bleu-roi" style="font-size: 16px;">
                    {item.nom}
                    {item.signature && (
                      <span class="ml-2 inline-block w-1.5 h-1.5 rounded-full bg-resto-or align-middle" aria-label="Plat signature"></span>
                    )}
                  </h4>
                  <span class="course-dotline flex-1 mb-1.5 border-b border-dotted border-resto-bleu-encre/20 transition-colors duration-300 group-hover:border-resto-or/60" aria-hidden="true"></span>
                  <span class="font-manrope font-medium text-resto-bleu-encre tabular-nums whitespace-nowrap transition-colors duration-300 group-hover:text-resto-or" style="font-size: 15px;">
                    {item.prix}€
                  </span>
                </div>
                <p class="mt-1.5 font-bodoni italic text-resto-bleu-encre/65 leading-[1.55]" style="font-size: 14.5px;">
                  {item.description}
                </p>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <!-- Légende soin signature -->
    <p class="scroll-reveal mt-14 text-center text-xs font-manrope uppercase tracking-[0.25em] text-resto-bleu-encre/50">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-resto-or align-middle mr-2"></span>
      Plats signature de la maison
    </p>

    <!-- ====== Menus à prix fixes ====== -->
    <div class="mt-24 md:mt-32 max-w-5xl mx-auto">
      <header class="text-center mb-12 md:mb-16">
        <p class="scroll-reveal font-manrope font-medium text-[11px] uppercase tracking-[0.42em] text-resto-bleu-roi">
          <span aria-hidden="true">·</span> Nos menus <span aria-hidden="true">·</span>
        </p>
        <h3 class="scroll-reveal mt-6 font-bodoni text-resto-bleu-encre leading-[1.05]" style="font-size: clamp(28px, 3.8vw, 44px);">
          Trois manières
          <span class="italic text-resto-bleu-roi">de nous découvrir.</span>
        </h3>
      </header>

      <div class="grid md:grid-cols-3 gap-6 md:gap-8">
        {data.menus.map((m, i) => (
          <article class={`scroll-reveal relative bg-resto-blanc-casse rounded-sm p-8 md:p-10 ring-1 transition-all duration-500 ease-out flex flex-col hover:-translate-y-1 hover:shadow-[0_18px_40px_-18px_rgba(11,20,55,0.25)] ${m.id === 'decouverte' ? 'ring-2 ring-resto-or shadow-[0_12px_36px_-12px_rgba(200,166,94,0.45)] hover:ring-resto-or' : 'ring-resto-bleu-encre/10 hover:ring-resto-or/60'}`} style={`transition-delay: ${i * 80}ms`}>
            <!-- Mise en avant Carte blanche au milieu -->
            {m.id === 'decouverte' && (
              <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 h-7 inline-flex items-center text-[10px] font-manrope font-bold uppercase tracking-[0.22em] bg-resto-bleu-encre text-resto-or ring-2 ring-resto-or rounded-full whitespace-nowrap shadow-[0_4px_12px_rgba(11,20,55,0.3)]">
                Le plus choisi
              </span>
            )}
            <p class="text-[10px] font-manrope uppercase tracking-[0.32em] text-resto-or font-semibold">
              Menu
            </p>
            <h4 class="mt-3 font-bodoni italic text-resto-bleu-encre leading-tight" style="font-size: clamp(24px, 2.8vw, 30px);">
              {m.nom}
            </h4>
            <p class="mt-3 font-manrope text-sm text-resto-bleu-encre/65 leading-relaxed flex-1">
              {m.sousTitre}
            </p>
            <div class="mt-6 pt-6 border-t border-resto-bleu-encre/10 flex items-baseline gap-2">
              <span class="font-bodoni font-bold text-resto-bleu-roi tabular-nums" style="font-size: 38px; line-height: 1;">
                {m.prix}
              </span>
              <span class="font-bodoni italic text-resto-bleu-encre/65 text-xl">€</span>
              <span class="ml-auto text-[11px] font-manrope uppercase tracking-[0.18em] text-resto-bleu-encre/55">
                / personne
              </span>
            </div>
            <p class="mt-3 text-xs font-manrope italic text-resto-bleu-encre/55 leading-relaxed">
              Servi {m.service}.
            </p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  /* Reveal ceremonieux plat par plat — plus lent que scroll-reveal global */
  .course-reveal {
    opacity: 0;
    transform: translateY(28px);
    filter: blur(2px);
    transition:
      opacity 1100ms cubic-bezier(0.22, 1, 0.36, 1) var(--course-delay, 0ms),
      transform 1100ms cubic-bezier(0.22, 1, 0.36, 1) var(--course-delay, 0ms),
      filter 900ms ease-out var(--course-delay, 0ms);
    will-change: opacity, transform, filter;
  }
  .course-reveal.is-served {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
  /* Filet pointillé qui se teinte en or au survol — micro-interaction subtile */
  .course-dish:hover .course-dotline {
    border-bottom-style: dashed;
  }
  @media (prefers-reduced-motion: reduce) {
    .course-reveal {
      opacity: 1 !important;
      transform: none !important;
      filter: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  // IntersectionObserver dédié au service plat-par-plat : seuil + rootMargin
  // pour déclencher l'arrivée avant que le plat soit entièrement à l'écran.
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const targets = document.querySelectorAll('#carte .course-reveal');

  if (prefersReduced) {
    targets.forEach((el) => el.classList.add('is-served'));
  } else {
    const io = new IntersectionObserver(
      (entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-served');
            obs.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.18, rootMargin: '0px 0px -8% 0px' }
    );
    targets.forEach((el) => io.observe(el));
  }
</script>
