---
const faq = [
  ["Quel est le délai pour mettre mon bien en marché ?", "Entre 7 et 14 jours après la visite : reportage photo, rédaction et mise en ligne multi-plateformes, calage tarifaire. Vous validez tout avant publication."],
  ["Combien puis-je espérer gagner en plus ?", "Nous chiffrons un revenu cible dans les sept jours suivant l'audit, basé sur des données réelles de biens comparables que nous gérons. En moyenne, +38 % vs la gestion en direct."],
  ["Suis-je engagé sur une durée ?", "Aucun engagement de durée. Vous pouvez nous quitter avec un préavis de deux mois, le temps d'honorer les réservations déjà confirmées."],
  ["Quels travaux ou ajustements proposez-vous ?", "L'audit inclut une liste hiérarchisée de recommandations (gratuites à mettre en œuvre, ou nécessitant un budget) qui maximisent revenu et note voyageur."],
  ["Qui paie les charges (eau, électricité, internet) ?", "Vous, comme avant. Notre commission ne couvre que la gestion. Nous avançons les petits frais (kit d'accueil, consommables) et vous les refacturons en fin de mois."],
  ["Et si un voyageur dégrade le bien ?", "Caution prélevée à la réservation. Constat et gestion sinistre par nos soins, en lien avec votre assurance propriétaire non-occupant (recommandée)."],
];
---
<section class="relative bg-concierge-champagne text-concierge-encre py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-4">
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-bordeaux mb-4">§ FAQ propriétaires</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight sticky top-28" style="font-size: clamp(48px, 6vw, 92px);">
        Ce qu'on<br/>nous demande<br/>en visite.
      </h2>
    </div>
    <ul class="lg:col-span-8 divide-y divide-concierge-laiton/30 border-y border-concierge-laiton/30">
      {faq.map((q, i) => (
        <li>
          <details class="group">
            <summary class="cursor-pointer py-6 flex items-start justify-between gap-6 list-none">
              <div class="flex gap-5 items-start">
                <span class="font-cormorant italic text-concierge-bordeaux text-xl mt-1 shrink-0">{String(i+1).padStart(2,'0')}.</span>
                <span class="font-cormorant italic text-concierge-encre text-xl md:text-2xl leading-tight">{q[0]}</span>
              </div>
              <span class="font-cormorant italic text-concierge-laiton text-3xl leading-none mt-1 transition-transform group-open:rotate-45 shrink-0">+</span>
            </summary>
            <p class="pb-7 pl-10 font-inter text-concierge-graphite leading-relaxed max-w-3xl">{q[1]}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
