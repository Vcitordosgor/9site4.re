---
import data from '../../../data/templates/concierge.json';
---
<section id="formules" class="relative bg-concierge-champagne text-concierge-encre py-24 md:py-32 scroll-mt-20">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="text-center mb-14 max-w-3xl mx-auto">
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-bordeaux mb-4">§ Tarifs transparents</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
        Sans frais cachés.<br/>Jamais.
      </h2>
    </div>

    <div class="grid lg:grid-cols-3 gap-px bg-concierge-laiton/40">
      {data.formules.map(f => (
        <article class={`relative p-8 md:p-10 flex flex-col ${f.populaire ? 'bg-concierge-nuit text-white' : 'bg-concierge-champagne text-concierge-encre'}`}>
          {f.populaire && <span class="absolute -top-3 left-8 px-3 py-1 bg-concierge-laiton text-concierge-nuit font-inter text-[10px] uppercase tracking-[0.3em]">le plus pris</span>}
          <p class={`font-inter text-[11px] uppercase tracking-[0.35em] mb-3 ${f.populaire ? 'text-concierge-laiton' : 'text-concierge-bordeaux'}`}>{f.label}</p>
          <p class="font-cormorant italic leading-none" style="font-size: clamp(72px,9vw,120px);">{f.prix}</p>
          <p class={`mt-2 font-inter text-xs ${f.populaire ? 'text-white/65' : 'text-concierge-graphite'}`}>{f.frequence}</p>
          <p class={`mt-5 font-cormorant italic text-base md:text-lg leading-relaxed ${f.populaire ? 'text-white/85' : 'text-concierge-graphite'}`}>{f.description}</p>

          <ul class="mt-7 space-y-3 font-inter text-sm border-t pt-6 flex-1" style="border-color: rgba(184,151,88,0.30);">
            {f.inclus.map(i => (
              <li class="flex gap-3 items-start">
                <svg class={`w-4 h-4 mt-0.5 shrink-0 ${f.populaire ? 'text-concierge-laiton' : 'text-concierge-bordeaux'}`} viewBox="0 0 16 16" fill="none"><path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>{i}</span>
              </li>
            ))}
          </ul>
          <a href="#contact" class={`mt-8 inline-flex items-center justify-between h-12 px-5 font-inter text-xs uppercase tracking-[0.25em] ${f.populaire ? 'bg-concierge-laiton text-concierge-nuit' : 'bg-concierge-bordeaux text-white'}`}>
            Choisir {f.label} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
    <p class="mt-6 text-center font-inter text-xs text-concierge-graphite italic">
      Commission prélevée uniquement sur les nuits réellement louées. Aucune mise en service, aucun frais de dossier.
    </p>
  </div>
</section>
