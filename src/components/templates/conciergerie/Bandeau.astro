---
/**
 * Bandeau — bandeau laiton/champagne, 3 promesses de service signature.
 */
---

<section class="relative bg-concierge-laiton text-concierge-nuit py-12 md:py-16 px-6 md:px-10 overflow-hidden">
  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-concierge-nuit/25">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2">
        <span class="font-volkhov font-bold text-concierge-nuit leading-none italic" style="font-size: clamp(36px, 4.6vw, 54px);">Sur mesure</span>
        <p class="mt-2 font-hubot font-medium uppercase tracking-[0.22em] text-concierge-nuit/75 text-[11px]">
          Aucune formule rigide
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 80ms">
        <span class="font-volkhov font-bold text-concierge-nuit leading-none italic" style="font-size: clamp(36px, 4.6vw, 54px);">2h</span>
        <p class="mt-2 font-hubot font-medium uppercase tracking-[0.22em] text-concierge-nuit/75 text-[11px]">
          Réponse moyenne en journée
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 160ms">
        <span class="font-volkhov font-bold text-concierge-nuit leading-none italic" style="font-size: clamp(36px, 4.6vw, 54px);">NDA signé</span>
        <p class="mt-2 font-hubot font-medium uppercase tracking-[0.22em] text-concierge-nuit/75 text-[11px]">
          Accord de confidentialité à chaque mission
        </p>
      </li>
    </ul>
  </div>
</section>
