---
import data from '../../../data/templates/concierge.json';
---
<section class="relative w-full">
  <div class="relative h-[78vh] min-h-[560px] w-full overflow-hidden">
    <img src="/images/conciergerie/extra-1.webp" alt="Villa de standing à La Réunion"
         class="absolute inset-0 w-full h-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(15,27,46,0.20) 0%, rgba(15,27,46,0.55) 100%);"></div>
    <div class="absolute inset-0 flex items-end">
      <div class="max-w-content mx-auto w-full px-6 md:px-10 pb-14 md:pb-20">
        <div class="text-[11px] uppercase tracking-[0.32em] mb-5" style="color:#E8DEC6;">Conciergerie privée · La Réunion</div>
        <h1 class="font-cormorant text-5xl md:text-7xl leading-[1.02] max-w-3xl" style="color:#F7F4EE;">
          La discrétion d'un palace,<br/><em class="italic" style="color:#E8DEC6;">à votre domicile.</em>
        </h1>
        <p class="mt-6 max-w-xl text-base md:text-lg leading-relaxed" style="color:#F0EADD;">
          Check-in, ménage hôtelier, maintenance technique, accueil multilingue. Une équipe restreinte, fidèle, sous engagement de confidentialité.
        </p>
        <div class="mt-10 flex flex-wrap gap-3">
          <a href="#contact" class="inline-flex items-center h-12 px-7 text-[12px] uppercase tracking-[0.18em] font-semibold transition-colors"
             style="background:#F7F4EE; color:#0F1B2E;">Demander un devis</a>
          <a href="#services" class="inline-flex items-center h-12 px-7 text-[12px] uppercase tracking-[0.18em] font-semibold border transition-colors"
             style="border-color:#F7F4EE; color:#F7F4EE;">Découvrir les services</a>
        </div>
      </div>
    </div>
  </div>
</section>
