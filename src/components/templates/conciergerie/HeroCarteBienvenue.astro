---
import data from '../../../data/templates/concierge.json';
---
<section id="top" class="relative min-h-[100svh] overflow-hidden text-white scroll-mt-20" style="background:#0E1B2C;">
  <div class="absolute inset-0" aria-hidden="true">
    <img src={data.info.photoVilla} alt="" class="w-full h-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(14,27,44,0.55) 0%, rgba(14,27,44,0.25) 40%, rgba(14,27,44,0.95) 100%);"></div>
    <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(14,27,44,0.65) 0%, transparent 55%);"></div>
  </div>

  <div class="relative max-w-content mx-auto px-6 md:px-12 pt-32 md:pt-40 pb-20 min-h-[100svh] flex flex-col">
    <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-laiton flex items-center gap-3 mb-10">
      <span class="block w-12 h-px bg-concierge-laiton/60"></span>
      <span>Conciergerie locative · {data.info.ville} · depuis {data.info.annee}</span>
    </p>

    <div class="flex-1 flex flex-col justify-center max-w-4xl">
      <p class="font-cormorant italic text-concierge-laiton text-2xl md:text-3xl mb-5">{data.info.wordmark}</p>
      <h1 class="font-cormorant italic leading-[0.92] tracking-tight" style="font-size: clamp(56px, 12vw, 200px);">
        Votre bien,<br/>géré comme<br/>le nôtre.
      </h1>
      <p class="mt-10 max-w-xl font-inter text-white/80 text-lg leading-relaxed">
        Conciergerie locative haut de gamme à La Réunion. Seize biens au maximum, choisis pour la qualité — un revenu maximisé, un voyageur accueilli, un propriétaire serein.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-3">
        <a href="#contact" class="inline-flex items-center gap-3 h-13 px-7 bg-concierge-bordeaux text-white font-inter text-sm uppercase tracking-[0.2em] hover:bg-concierge-laiton hover:text-concierge-nuit transition-colors">Demander un audit gratuit →</a>
        <a href="#processus" class="inline-flex items-center gap-3 h-13 px-6 ring-1 ring-white/40 text-white font-inter text-xs uppercase tracking-[0.25em] hover:bg-white/10 transition-colors">Notre méthode</a>
      </div>
    </div>

    <!-- KPI badges en bas -->
    <div class="mt-auto pt-12 grid grid-cols-1 md:grid-cols-3 gap-px bg-white/15">
      {data.kpi.map(k => (
        <div class="px-6 py-5" style="background: rgba(14,27,44,0.85); backdrop-filter: blur(6px);">
          <p class="font-cormorant italic text-white leading-none" style="font-size: clamp(40px,5vw,72px);">{k.valeur}</p>
          <p class="mt-2 font-inter text-[10px] uppercase tracking-[0.3em] text-concierge-laiton">{k.label}</p>
          <p class="font-inter text-xs text-white/55 italic mt-1">{k.sous}</p>
        </div>
      ))}
    </div>
  </div>
</section>
