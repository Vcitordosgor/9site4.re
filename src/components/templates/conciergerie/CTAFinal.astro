---
import data from '../../../data/templates/concierge.json';
---
<section class="relative bg-concierge-bordeaux text-concierge-champagne py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 opacity-20 pointer-events-none" style="background: radial-gradient(ellipse 60% 70% at 80% 50%, #B89758, transparent 70%);"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-12 text-center">
    <p class="font-cormorant italic text-concierge-laiton text-2xl mb-3">— l'audit est gratuit —</p>
    <p class="font-cormorant italic leading-[0.95]" style="font-size: clamp(56px,9vw,140px);">
      Votre bien,<br/>chiffré sous 7 jours.
    </p>
    <div class="mt-12 flex flex-wrap gap-3 justify-center">
      <a href="#contact" class="inline-flex items-center gap-3 h-14 px-8 bg-concierge-champagne text-concierge-bordeaux font-inter text-sm uppercase tracking-[0.25em] hover:bg-concierge-laiton transition-colors">Demander un audit →</a>
      <a href={`tel:${data.info.telephoneHref}`} class="inline-flex items-center gap-3 h-14 px-8 ring-1 ring-concierge-champagne/40 text-concierge-champagne font-inter text-xs uppercase tracking-[0.25em] hover:bg-concierge-champagne/10 transition-colors">Nous joindre</a>
    </div>
  </div>
</section>
