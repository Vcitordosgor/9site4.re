---
/**
 * Citation — extrait carnet de mission, fond nuit profond, italique volkhov champagne.
 */
---

<section class="relative bg-concierge-nuit text-concierge-champagne py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-concierge-laiton/50" aria-hidden="true"></div>
  <div class="absolute bottom-0 inset-x-0 h-px bg-concierge-laiton/50" aria-hidden="true"></div>

  <div class="relative max-w-4xl mx-auto text-center">
    <p class="scroll-reveal font-pinyon text-concierge-laiton mb-8 leading-none" style="font-size: clamp(64px, 9vw, 120px);">
      Discrétion.
    </p>

    <blockquote class="scroll-reveal font-volkhov italic font-normal text-concierge-champagne leading-[1.2]" style="font-size: clamp(28px, 4.4vw, 52px);">
      Ce qui se passe chez nos clients reste chez nos clients.
      <span class="block mt-4 not-italic font-bold text-concierge-laiton">Le reste, on en parle volontiers.</span>
    </blockquote>

    <footer class="scroll-reveal mt-12 inline-flex items-center gap-3">
      <span class="block w-12 h-px bg-concierge-laiton" aria-hidden="true"></span>
      <p class="font-hubot uppercase tracking-[0.32em] text-concierge-champagne/65 text-[11px]">
        Charte interne — première ligne
      </p>
      <span class="block w-12 h-px bg-concierge-laiton" aria-hidden="true"></span>
    </footer>
  </div>
</section>
