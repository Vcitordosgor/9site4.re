---
const items = [
  { txt: 'Trois ans que je ne mets plus les pieds dans ma villa entre deux locataires. Tout est tenu, tout est propre, je reçois mon relevé le 1er du mois.', who: 'Propriétaire villa, ouest' },
  { txt: 'Nous sommes arrivés à 23h avec deux enfants endormis. Tout était prêt, frigo rempli, climatisation lancée. C\'était précisément la promesse.', who: 'Voyageurs, séjour familial' },
  { txt: 'Discrétion absolue, jamais une plainte de voisinage, jamais un dégât non signalé sous 24h. C\'est exactement ce que j\'attendais.', who: 'Propriétaire investisseur' },
  { txt: 'Recommandations restaurants impeccables, réservations gérées sans nous. On a vraiment senti que tout était pensé pour nous.', who: 'Voyageurs en lune de miel' },
];
---
<section class="py-20 md:py-28" style="background:#EDE6D6;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-4" style="color:#7A6A4E;">Ce qu'ils en disent</div>
      <h2 class="font-cormorant text-4xl md:text-5xl leading-tight" style="color:#0F1B2E;">
        Quelques retours, <em class="italic">anonymisés.</em>
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {items.map(i => (
        <figure class="p-8 md:p-10" style="background:#F7F4EE;">
          <div class="font-cormorant text-6xl leading-none mb-2" style="color:#B89758;">"</div>
          <blockquote class="font-cormorant italic text-xl md:text-2xl leading-snug mb-6" style="color:#0F1B2E;">{i.txt}</blockquote>
          <figcaption class="text-[11px] uppercase tracking-[0.22em]" style="color:#7A6A4E;">— {i.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
