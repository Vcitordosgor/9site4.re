---
import data from '../../../data/templates/concierge.json';
---
<section class="relative bg-concierge-nuit text-white py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 max-w-3xl">
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-laiton mb-4">§ Propriétaires</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
        Ils nous ont<br/>fait confiance.
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-px bg-concierge-laiton/25">
      {data.temoignages.map(t => (
        <article class="bg-concierge-nuit p-8 md:p-10 flex flex-col">
          <span class="font-cormorant italic text-concierge-laiton text-7xl leading-none mb-2">"</span>
          <p class="font-cormorant italic text-xl md:text-2xl leading-snug text-white">{t.texte}</p>
          <div class="mt-auto pt-6 border-t border-concierge-laiton/25 flex items-center gap-4">
            <span class="w-12 h-12 rounded-full ring-1 ring-concierge-laiton/40 flex items-center justify-center font-cormorant italic text-concierge-laiton text-lg">{t.initiales}</span>
            <div>
              <p class="font-inter text-sm text-white">{t.initiales} — {t.lieu}</p>
              <p class="font-inter text-xs text-white/55">{t.anciennete}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
