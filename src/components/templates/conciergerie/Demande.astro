---
import data from '../../../data/templates/concierge.json';
---
<section id="contact" class="py-20 md:py-28" style="background:#0F1B2E; color:#F7F4EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-5 gap-12 lg:gap-20">
      <div class="md:col-span-2">
        <div class="text-[11px] uppercase tracking-[0.28em] mb-4" style="color:#B89758;">Contact</div>
        <h2 class="font-cormorant text-4xl md:text-5xl leading-tight mb-6">
          Parlons de votre <em class="italic" style="color:#B89758;">bien.</em>
        </h2>
        <p class="text-[15px] leading-relaxed mb-8" style="color:#D8D2C0;">
          Premier échange téléphonique de 20 minutes pour comprendre votre situation, puis visite sur place gratuite si pertinent. Réponse sous 48h.
        </p>
        <ul class="space-y-3 text-[15px]" style="color:#F7F4EE;">
          <li><span class="text-[11px] uppercase tracking-[0.22em] block" style="color:#B89758;">Téléphone</span><a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a></li>
          <li><span class="text-[11px] uppercase tracking-[0.22em] block" style="color:#B89758;">Email</span><a href={`mailto:${data.info.email}`}>{data.info.email}</a></li>
          <li><span class="text-[11px] uppercase tracking-[0.22em] block" style="color:#B89758;">Zone</span>La Réunion · côte ouest et sud</li>
          <li><span class="text-[11px] uppercase tracking-[0.22em] block" style="color:#B89758;">Horaires</span>Lundi → samedi · 8h – 20h</li>
        </ul>
      </div>
      <form class="md:col-span-3 grid gap-4" onsubmit="event.preventDefault(); alert('Démonstration — formulaire non actif.');">
        <div class="grid md:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#B89758;">Nom</span>
            <input required type="text" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(247,244,238,0.30); color:#F7F4EE;"/>
          </label>
          <label class="block">
            <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#B89758;">Téléphone</span>
            <input required type="tel" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(247,244,238,0.30); color:#F7F4EE;"/>
          </label>
        </div>
        <label class="block">
          <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#B89758;">Email</span>
          <input required type="email" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(247,244,238,0.30); color:#F7F4EE;"/>
        </label>
        <label class="block">
          <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#B89758;">Type de demande</span>
          <select class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(247,244,238,0.30); color:#F7F4EE;">
            <option style="color:#0F1B2E;">Propriétaire — confier mon bien</option>
            <option style="color:#0F1B2E;">Voyageur — préparer mon séjour</option>
            <option style="color:#0F1B2E;">Autre</option>
          </select>
        </label>
        <label class="block">
          <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#B89758;">Votre message</span>
          <textarea rows="5" class="w-full px-4 py-3 bg-transparent border" style="border-color:rgba(247,244,238,0.30); color:#F7F4EE;"></textarea>
        </label>
        <button class="mt-2 h-12 text-[12px] uppercase tracking-[0.22em] font-semibold transition-colors"
                style="background:#B89758; color:#0F1B2E;">Envoyer ma demande</button>
      </form>
    </div>
  </div>
</section>
