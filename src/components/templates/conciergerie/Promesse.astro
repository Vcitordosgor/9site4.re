---
/**
 * Promesse (Propriétaires vs Voyageurs) — 2 colonnes avec chiffres.
 */
const blocs = [
  {
    label: 'Aux propriétaires',
    titre: 'Plus de revenu,\nzéro charge mentale.',
    items: [
      ['+38 %', "Revenu locatif moyen vs gestion en direct."],
      ['0 h', "Temps passé chaque semaine sur la gestion."],
      ['16 biens', "Plafond délibéré du portefeuille annuel."],
      ['4,9 / 5', "Note voyageur moyenne, tous biens confondus."],
    ],
    ton: 'light',
  },
  {
    label: 'Aux voyageurs',
    titre: 'Plus d\'attention,\nzéro mauvaise surprise.',
    items: [
      ['24h/24', "Accueil personnalisé, à toute heure, multilingue."],
      ['100 %', "Biens visités et vérifiés par nous, jamais photo seule."],
      ['< 1h', "Délai moyen de réponse WhatsApp pendant le séjour."],
      ['3 langues', "FR, EN, ES couramment. DE sur demande."],
    ],
    ton: 'dark',
  },
];
---
<section class="relative bg-concierge-champagne text-concierge-encre py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 max-w-3xl">
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-bordeaux mb-4">§ Promesse</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
        Deux côtés<br/>du même bien.
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-px bg-concierge-laiton/40">
      {blocs.map(b => (
        <div class={`p-8 md:p-12 ${b.ton === 'dark' ? 'bg-concierge-nuit text-white' : 'bg-concierge-champagne'}`}>
          <p class={`font-inter text-[11px] uppercase tracking-[0.4em] mb-3 ${b.ton === 'dark' ? 'text-concierge-laiton' : 'text-concierge-bordeaux'}`}>{b.label}</p>
          <h3 class="font-cormorant italic leading-[0.95] whitespace-pre-line" style="font-size: clamp(36px,5vw,64px);">{b.titre}</h3>
          <ul class="mt-8 grid grid-cols-2 gap-px bg-current/15">
            {b.items.map(([v, d]) => (
              <li class={`p-5 ${b.ton === 'dark' ? 'bg-concierge-nuit' : 'bg-concierge-champagne'}`}>
                <p class="font-cormorant italic leading-none" style="font-size: clamp(36px,5vw,56px);">{v}</p>
                <p class={`mt-2 font-inter text-xs leading-relaxed ${b.ton === 'dark' ? 'text-white/65' : 'text-concierge-graphite'}`}>{d}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
