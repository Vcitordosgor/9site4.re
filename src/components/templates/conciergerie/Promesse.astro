---
const proprio = [
  'Rendement locatif optimisé sans gestion quotidienne',
  'Reporting mensuel : occupation, revenus, interventions',
  'Maintenance préventive et inventaire annuel',
  'Photographies professionnelles et rédaction des annonces',
  'Gestion calendrier multi-plateformes (Airbnb, Booking, Abritel)',
  'Encaissement, fiscalité de la location meublée accompagnée',
];
const loc = [
  'Accueil 7j/7 jusqu\'à 22h, transferts aéroport sur demande',
  'Maison prête : linge frais, climatisation lancée, courses d\'arrivée',
  'Recommandations confidentielles : tables, spots, prestataires',
  'Ligne directe WhatsApp pendant tout le séjour',
  'Coordination événements privés (chef à domicile, massage)',
  'Service voiturier et chauffeur partenaire',
];
---
<section id="proprietaires" class="py-20 md:py-28" style="background:#0F1B2E;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-3xl">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-4" style="color:#B89758;">Pour qui ?</div>
      <h2 class="font-cormorant text-4xl md:text-5xl leading-tight" style="color:#F7F4EE;">
        Deux promesses distinctes, <em class="italic" style="color:#B89758;">un même standard.</em>
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-px" style="background:rgba(247,244,238,0.10);">
      <div class="p-8 md:p-12" style="background:#0F1B2E;">
        <div class="text-[11px] uppercase tracking-[0.28em] mb-5" style="color:#B89758;">Propriétaire</div>
        <h3 class="font-cormorant text-3xl mb-6" style="color:#F7F4EE;">Vous confiez votre bien.</h3>
        <ul class="space-y-3 text-[15px] leading-relaxed" style="color:#D8D2C0;">
          {proprio.map(t => (
            <li class="flex gap-3">
              <span class="mt-2 w-1 h-1 rounded-full flex-shrink-0" style="background:#B89758;"></span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="p-8 md:p-12" style="background:#0F1B2E;">
        <div class="text-[11px] uppercase tracking-[0.28em] mb-5" style="color:#B89758;">Locataire / Voyageur</div>
        <h3 class="font-cormorant text-3xl mb-6" style="color:#F7F4EE;">Vous arrivez en vacances.</h3>
        <ul class="space-y-3 text-[15px] leading-relaxed" style="color:#D8D2C0;">
          {loc.map(t => (
            <li class="flex gap-3">
              <span class="mt-2 w-1 h-1 rounded-full flex-shrink-0" style="background:#B89758;"></span>
              <span>{t}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
