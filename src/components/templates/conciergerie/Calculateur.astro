---
/**
 * Calculateur — estimation revenus locatifs mensuels.
 * Vanilla JS inline. Inputs : nb chambres + zone.
 */
const zones = [
  { id: 'ouest',  label: 'Côte Ouest (Saint-Gilles, L\'Hermitage)', nuit: 165 },
  { id: 'sud',    label: 'Sud sauvage (Saint-Pierre, Étang-Salé)',   nuit: 130 },
  { id: 'cirques',label: 'Cirques (Cilaos, Salazie)',                nuit: 110 },
  { id: 'est',    label: 'Côte Est (Saint-Benoît, Sainte-Suzanne)',  nuit: 95  },
  { id: 'nord',   label: 'Nord (Saint-Denis, Sainte-Marie)',         nuit: 120 },
];
---

<section id="calculateur" class="relative bg-concierge-champagne py-24 md:py-32 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
      <p class="font-hubot text-[10px] uppercase tracking-[0.4em] text-concierge-laiton font-medium mb-4">
        ✦ Estimation revenus ✦
      </p>
      <h2 class="font-volkhov text-concierge-nuit leading-[1.1]" style="font-size: clamp(32px, 4.5vw, 52px);">
        Combien votre bien
        <span class="italic block">peut-il vous rapporter ?</span>
      </h2>
      <p class="mt-5 font-hubot text-concierge-graphite leading-relaxed">
        Estimation indicative basée sur les taux d'occupation moyens observés sur le secteur.
      </p>
    </header>

    <div class="grid lg:grid-cols-2 gap-px bg-concierge-laiton/30 border border-concierge-laiton/30 max-w-4xl mx-auto">

      <!-- Inputs -->
      <div class="bg-concierge-blanc p-8 md:p-10">
        <label class="block">
          <span class="font-hubot text-[10px] uppercase tracking-[0.28em] text-concierge-graphite font-semibold">Zone géographique</span>
          <select id="ccc-zone" class="mt-3 w-full bg-concierge-champagne/40 border border-concierge-laiton/30 px-4 h-12 font-hubot text-concierge-nuit">
            {zones.map((z) => (
              <option value={z.nuit}>{z.label}</option>
            ))}
          </select>
        </label>

        <label class="block mt-8">
          <span class="font-hubot text-[10px] uppercase tracking-[0.28em] text-concierge-graphite font-semibold flex justify-between">
            <span>Nombre de chambres</span>
            <span id="ccc-ch-label" class="font-volkhov italic text-concierge-nuit text-base normal-case tracking-normal">2 chambres</span>
          </span>
          <input
            id="ccc-ch"
            type="range"
            min="1"
            max="6"
            step="1"
            value="2"
            class="mt-4 w-full accent-concierge-laiton"
          />
          <span class="flex justify-between mt-1 text-[10px] font-hubot text-concierge-graphite/60">
            <span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6+</span>
          </span>
        </label>

        <p class="mt-8 font-volkhov italic text-concierge-graphite text-sm leading-relaxed">
          Calcul basé sur 22 nuitées / mois en moyenne (taux d'occupation 73 %).
        </p>
      </div>

      <!-- Résultat -->
      <div class="bg-concierge-nuit text-concierge-champagne p-8 md:p-10 flex flex-col justify-center">
        <p class="font-hubot text-[10px] uppercase tracking-[0.4em] text-concierge-laiton font-medium mb-4">
          ✦ Estimation mensuelle ✦
        </p>

        <dl class="space-y-5">
          <div class="flex items-baseline justify-between gap-4 pb-3 border-b border-concierge-champagne/15">
            <dt class="font-hubot text-concierge-champagne/75 text-sm">Prix moyen / nuitée</dt>
            <dd id="ccc-nuit" class="font-volkhov text-concierge-champagne text-xl tabular-nums">165 €</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 pb-3 border-b border-concierge-champagne/15">
            <dt class="font-hubot text-concierge-champagne/75 text-sm">Nuitées estimées</dt>
            <dd id="ccc-nuits" class="font-volkhov text-concierge-champagne text-xl tabular-nums">22</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 pt-2">
            <dt class="font-hubot text-concierge-champagne font-semibold uppercase tracking-[0.16em] text-xs">Revenus bruts</dt>
            <dd id="ccc-total" class="font-volkhov italic text-concierge-laiton text-4xl tabular-nums">3 630 €</dd>
          </div>
        </dl>

        <p class="mt-6 font-volkhov italic text-concierge-champagne/75 text-sm leading-relaxed">
          Avant commission de gestion et frais de plateforme. Étude personnalisée gratuite sur rendez-vous.
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const zone = document.getElementById('ccc-zone');
      const ch = document.getElementById('ccc-ch');
      const chLabel = document.getElementById('ccc-ch-label');
      const nuit = document.getElementById('ccc-nuit');
      const nuits = document.getElementById('ccc-nuits');
      const total = document.getElementById('ccc-total');
      if (!zone || !ch) return;
      const fmt = (n) => new Intl.NumberFormat('fr-FR').format(Math.round(n)) + ' €';
      // Coefficient selon nb chambres (1ch base, +30 % par ch supplémentaire, plafonné)
      const coef = [0.65, 1.0, 1.35, 1.65, 1.9, 2.1];
      function update() {
        const base = parseFloat(zone.value) || 130;
        const c = parseInt(ch.value, 10);
        const prixNuit = base * (coef[c - 1] || 1);
        const nbNuits = 22;
        chLabel.textContent = (c >= 6 ? '6+ chambres' : c + (c > 1 ? ' chambres' : ' chambre'));
        nuit.textContent = fmt(prixNuit);
        nuits.textContent = String(nbNuits);
        total.textContent = fmt(prixNuit * nbNuits);
      }
      zone.addEventListener('change', update);
      ch.addEventListener('input', update);
      update();
    })();
  </script>
</section>
