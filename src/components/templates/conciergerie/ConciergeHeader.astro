---
import data from '../../../data/templates/concierge.json';
const nav = [
  { href: '#services', label: 'Services' },
  { href: '#proprietaires', label: 'Propriétaires & Locataires' },
  { href: '#tarification', label: 'Tarifs' },
  { href: '#zone', label: 'Zone' },
  { href: '#contact', label: 'Contact' },
];
---
<header id="cg-header" data-scrolled="false" class="sticky top-0 z-50 border-b transition-all duration-500"
  style="background:rgba(247,244,238,0.94); border-color:rgba(15,27,46,0.10);">
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="#top" class="flex items-center gap-3" aria-label="Concierge & Co">
      <svg viewBox="0 0 32 32" class="w-8 h-8" aria-hidden="true">
        <circle cx="16" cy="16" r="14" fill="none" stroke="#0F1B2E" stroke-width="1"/>
        <text x="16" y="20" text-anchor="middle" font-family="serif" font-size="13" font-style="italic" fill="#0F1B2E">C</text>
      </svg>
      <div class="leading-tight">
        <div class="font-cormorant italic text-lg md:text-xl" style="color:#0F1B2E;">Concierge & Co</div>
        <div class="text-[10px] uppercase tracking-[0.28em] mt-0.5" style="color:#7A6A4E;">Conciergerie privée · Réunion</div>
      </div>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[12px] uppercase tracking-[0.16em] font-medium" aria-label="Navigation">
      {nav.map(n => <a href={n.href} class="hover:opacity-60 transition-opacity" style="color:#0F1B2E;">{n.label}</a>)}
    </nav>
    <a href="#contact" class="hidden md:inline-flex items-center h-10 px-5 text-[12px] uppercase tracking-[0.14em] font-semibold transition-colors"
       style="background:#0F1B2E; color:#F7F4EE;">Demander un devis</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-11 px-4 text-[12px] uppercase tracking-wider font-semibold"
       style="background:#0F1B2E; color:#F7F4EE;">Appeler</a>
  </div>
</header>
<style>
  #cg-header[data-scrolled='true'] { backdrop-filter: saturate(180%) blur(10px); box-shadow:0 1px 3px rgba(15,27,46,0.08); }
</style>
<script>
  const h = document.getElementById('cg-header');
  if (h) {
    const u = () => { h.dataset.scrolled = String(window.scrollY > 8); };
    u(); window.addEventListener('scroll', u, { passive: true });
  }
</script>
