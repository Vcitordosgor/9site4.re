---
/**
 * ConciergeHeader — transparent qui passe ivoire au scroll.
 */
import data from '../../../data/templates/concierge.json';
---
<header id="concierge-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-500" data-scrolled="false">
  <div class="absolute inset-0 bg-concierge-champagne/0 transition-all duration-500 [[data-scrolled=true]_&]:bg-concierge-champagne/95 [[data-scrolled=true]_&]:backdrop-blur-md [[data-scrolled=true]_&]:border-b [[data-scrolled=true]_&]:border-concierge-laiton/25"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-12 h-20 flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-3">
      <span class="font-cormorant italic text-white [[data-scrolled=true]_&]:text-concierge-encre text-2xl md:text-3xl transition-colors duration-500">{data.info.wordmark}</span>
      <span class="hidden md:inline font-inter text-[10px] uppercase tracking-[0.4em] text-concierge-laiton transition-colors duration-500">Conciergerie locative</span>
    </a>
    <nav class="hidden md:flex items-center gap-8 font-inter text-[12px] uppercase tracking-[0.25em]">
      {[['#services','Services'],['#processus','Processus'],['#villas','Villas'],['#formules','Tarifs'],['#contact','Démarrer']].map(([href,label]) => (
        <a href={href} class="text-white [[data-scrolled=true]_&]:text-concierge-encre hover:text-concierge-laiton transition-colors">{label}</a>
      ))}
    </nav>
    <a href="#contact" class="hidden md:inline-flex items-center gap-2 h-11 px-5 bg-concierge-bordeaux text-white font-inter text-xs uppercase tracking-[0.2em] hover:bg-concierge-nuit transition-colors">Demander un audit →</a>
    <a href="#contact" class="md:hidden inline-flex items-center gap-2 h-10 px-4 bg-concierge-bordeaux text-white font-inter text-xs uppercase tracking-wide">Audit</a>
  </div>
</header>
<script is:inline>
  (() => {
    const h = document.getElementById('concierge-header');
    if (!h) return;
    const onScroll = () => { h.dataset.scrolled = String(window.scrollY > 60); };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
