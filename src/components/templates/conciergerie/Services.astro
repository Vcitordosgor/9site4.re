---
import data from '../../../data/templates/concierge.json';
/**
 * Icônes bespoke line-drawn — vocabulaire conciergerie :
 * accueil       = clé (check-in)
 * menage        = enveloppe + carte bienvenue (linge plié / livret)
 * maintenance   = calendrier check (entretien programmé)
 * multi         = bulle de dialogue multilingue
 * photo         = appareil photo posé
 * annonce       = branche d'olivier (signature insulaire, élégance)
 */
const icons: Record<string, string> = {
  // Clé sobre — anneau + dents
  accueil:    'M8 12a4 4 0 118 0 4 4 0 01-8 0z M12 12h10 M19 12v3 M22 12v2',
  // Enveloppe-carte de bienvenue
  menage:     'M3 6h18v12H3z M3 6l9 7 9-7 M8 13l-4 5 M16 13l4 5',
  // Calendrier avec check
  maintenance:'M4 6h16v14H4z M4 10h16 M8 4v4 M16 4v4 M9 15l2.5 2.5L16 13',
  // Bulle de dialogue avec méridiens (multilingue)
  multi:      'M4 5h16v10H8l-4 4z M8 10h8 M12 6v8 M9 7.5c2 2 4 2 6 0 M9 12.5c2-2 4-2 6 0',
  // Appareil photo (vu de face, lentille)
  photo:      'M3 8h4l2-2h6l2 2h4v11H3z M12 16a4 4 0 100-8 4 4 0 000 8z M12 12h.01',
  // Branche d'olivier — tige + 4 feuilles
  annonce:    'M4 20c6-2 10-6 16-16 M8 15c0-2 2-3 4-3 0 2-1 4-4 4z M11 12c0-2 2-3 4-3 0 2-1 4-4 4z M14 9c0-2 2-3 4-3 0 2-1 4-4 4z M7 18c-1 0-2-1-2-2 1 0 2 0 2 2z',
};
---
<section id="services" class="relative bg-concierge-champagne text-concierge-encre py-24 md:py-32 scroll-mt-20">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 max-w-3xl">
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-bordeaux mb-4">§ Services</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
        Six métiers,<br/>une seule équipe.
      </h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-concierge-laiton/30">
      {data.services.map(s => (
        <article class="bg-concierge-champagne p-8 md:p-10 group">
          <svg class="w-10 h-10 text-concierge-bordeaux mb-6 transition-transform group-hover:scale-110" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d={icons[s.id] || icons.accueil} /></svg>
          <h3 class="font-cormorant italic text-2xl md:text-3xl text-concierge-nuit leading-tight">{s.titre}</h3>
          <p class="mt-3 font-inter text-sm text-concierge-graphite leading-relaxed">{s.description}</p>
          <span class="mt-6 inline-block w-10 h-px bg-concierge-laiton"></span>
        </article>
      ))}
    </div>
  </div>
</section>
