---
const services = [
  { num: '01', titre: 'Check-in & check-out', texte: 'Accueil personnalisé des voyageurs 7j/7, remise des clés, état des lieux photographique, kit de bienvenue. Disponibilité jusqu\'à 22h.' },
  { num: '02', titre: 'Ménage hôtelier', texte: 'Équipe interne formée aux standards de l\'hôtellerie. Linge fourni, dressing impeccable, contrôle qualité après chaque rotation.' },
  { num: '03', titre: 'Maintenance technique', texte: 'Réseau d\'artisans partenaires : plomberie, climatisation, piscine, jardin. Interventions tracées, devis transparents.' },
  { num: '04', titre: 'Accueil multilingue', texte: 'Français, anglais, allemand. Recommandations sur-mesure restaurants, excursions, transferts aéroport.' },
];
---
<section id="services" class="py-20 md:py-28" style="background:#F7F4EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 md:mb-20 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-4" style="color:#7A6A4E;">Nos services</div>
      <h2 class="font-cormorant text-4xl md:text-5xl leading-tight" style="color:#0F1B2E;">
        Quatre métiers, <em class="italic">un seul interlocuteur.</em>
      </h2>
    </div>
    <div class="grid md:grid-cols-2 gap-px" style="background:rgba(15,27,46,0.10);">
      {services.map(s => (
        <article class="p-8 md:p-10" style="background:#F7F4EE;">
          <div class="flex items-baseline gap-5 mb-4">
            <span class="font-cormorant italic text-3xl" style="color:#7A6A4E;">{s.num}</span>
            <h3 class="font-cormorant text-2xl md:text-3xl" style="color:#0F1B2E;">{s.titre}</h3>
          </div>
          <p class="text-[15px] leading-relaxed" style="color:#3D4453;">{s.texte}</p>
        </article>
      ))}
    </div>
  </div>
</section>
