---
/**
 * Numbers — galerie 6 villas bento asymétrique.
 */
const photos = [
  { src: '/images/conciergerie/extra-1.webp', span: 'big',  legende: 'Villa Mahatma · Saint-Gilles' },
  { src: '/images/conciergerie/extra-2.webp', span: 'med',  legende: 'Lodge Cap Méchant · Saint-Joseph' },
  { src: '/images/conciergerie/extra-3.webp', span: 'small',legende: 'Bungalow Hermitage' },
  { src: '/images/conciergerie/extra-4.webp', span: 'med',  legende: 'Case créole · Cilaos' },
  { src: '/images/conciergerie/extra-5.webp', span: 'small',legende: 'Suite Bord-de-Mer · Saint-Leu' },
  { src: '/images/conciergerie/extra-6.webp', span: 'small',legende: 'Villa Plaine des Cafres' },
];
---
<section id="villas" class="relative bg-concierge-champagne text-concierge-encre py-24 md:py-32 scroll-mt-20">
  <div class="max-w-content mx-auto px-6 md:px-12 mb-12 flex items-baseline justify-between flex-wrap gap-4">
    <div>
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-bordeaux mb-4">§ Nos villas</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
        Seize biens,<br/>une signature.
      </h2>
    </div>
    <p class="font-inter text-sm text-concierge-graphite max-w-sm leading-relaxed">
      Du studio premium à la villa de cinq chambres avec piscine. Toutes nos références sont visitables sur audit.
    </p>
  </div>

  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="grid grid-cols-12 md:grid-rows-3 gap-3 md:gap-4 md:aspect-[16/12] md:min-h-[640px] auto-rows-[220px] md:auto-rows-auto">
      <a class="col-span-12 md:col-span-7 md:row-span-2 relative overflow-hidden group ring-1 ring-concierge-laiton/30 h-[280px] md:h-auto">
        <img src={photos[0].src} alt={photos[0].legende} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async"/>
        <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 50%, rgba(14,27,44,0.7) 100%);"></div>
        <span class="absolute bottom-5 left-5 font-cormorant italic text-white text-2xl md:text-3xl">{photos[0].legende}</span>
      </a>
      <a class="col-span-6 md:col-span-5 relative overflow-hidden group ring-1 ring-concierge-laiton/30">
        <img src={photos[1].src} alt={photos[1].legende} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async"/>
      </a>
      <a class="col-span-6 md:col-span-5 relative overflow-hidden group ring-1 ring-concierge-laiton/30">
        <img src={photos[2].src} alt={photos[2].legende} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async"/>
      </a>
      <a class="col-span-12 md:col-span-4 relative overflow-hidden group ring-1 ring-concierge-laiton/30">
        <img src={photos[3].src} alt={photos[3].legende} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async"/>
      </a>
      <a class="col-span-6 md:col-span-4 relative overflow-hidden group ring-1 ring-concierge-laiton/30">
        <img src={photos[4].src} alt={photos[4].legende} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async"/>
      </a>
      <a class="col-span-6 md:col-span-4 relative overflow-hidden group ring-1 ring-concierge-laiton/30">
        <img src={photos[5].src} alt={photos[5].legende} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async"/>
      </a>
    </div>
  </div>
</section>
