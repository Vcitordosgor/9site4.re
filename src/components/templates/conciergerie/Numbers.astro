---
/**
 * Numbers — chiffres clés conciergerie en typo élégante.
 * Filets laiton, ambiance hôtelière haut de gamme.
 */
const stats = [
  { value: '8', unit: 'ans', label: 'Au service de nos clients' },
  { value: '120+', unit: 'biens', label: 'Suivis en gestion conciergerie' },
  { value: '24/7', unit: 'astreinte', label: 'Réponse en moins de 30 minutes' },
  { value: '98%', unit: 'taux', label: 'D\'occupation moyen annuel' },
];
---

<section class="relative bg-concierge-champagne py-20 md:py-28 px-6 md:px-10 border-y border-concierge-laiton/30">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <span class="scroll-reveal inline-block w-12 h-px bg-concierge-laiton" aria-hidden="true"></span>
      <p class="scroll-reveal mt-4 text-xs font-hubot uppercase tracking-[0.4em] text-concierge-laiton">
        En quelques chiffres
      </p>
      <h2 class="scroll-reveal mt-5 font-volkhov text-concierge-nuit leading-[1.1]" style="font-size: clamp(34px, 4.8vw, 56px);">
        L'excellence,<br/>
        <span class="italic text-concierge-laiton">en mesures précises.</span>
      </h2>
    </header>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-8 items-end">
      {stats.map((s, i) => (
        <li class="scroll-reveal text-center" style={`transition-delay: ${i * 80}ms`}>
          <span class="relative inline-block">
            <span class="block font-volkhov font-bold text-concierge-nuit leading-[0.85] tabular-nums" style="font-size: clamp(60px, 9vw, 130px);">
              {s.value}
            </span>
            <span class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-12 h-px bg-concierge-laiton" aria-hidden="true"></span>
          </span>
          <span class="mt-6 block font-hubot uppercase tracking-[0.28em] text-concierge-laiton text-[11px]">
            {s.unit}
          </span>
          <p class="mt-2 font-volkhov italic text-concierge-graphite leading-snug max-w-[200px] mx-auto" style="font-size: 15px;">
            {s.label}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
