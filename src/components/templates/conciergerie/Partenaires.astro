---
/**
 * Partenaires — réseau de partenaires hôteliers et tourisme.
 * Wordmarks neutres, ambiance discrète.
 */
const partenaires = [
  'Maison Hibiscus',
  'Villa Lazuli',
  'Bourbon Resorts',
  'Domaine Verveine',
  'Lagon Privé',
  'Suites des Hauts',
];
---

<section class="relative bg-concierge-nuit text-concierge-champagne py-16 md:py-20 px-6 md:px-10">
  <div class="max-w-content mx-auto">
    <div class="text-center">
      <span class="scroll-reveal inline-block w-12 h-px bg-concierge-laiton" aria-hidden="true"></span>
      <p class="scroll-reveal mt-4 text-xs font-hubot uppercase tracking-[0.4em] text-concierge-laiton">
        Hôtels & villas partenaires
      </p>
    </div>

    <ul class="scroll-reveal mt-12 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-10 items-center">
      {partenaires.map((p, i) => (
        <li class="text-center" style={`transition-delay: ${i * 50}ms`}>
          <span class="block font-volkhov italic text-concierge-champagne/40 hover:text-concierge-champagne transition-colors" style="font-size: clamp(18px, 1.7vw, 22px);">
            {p}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
