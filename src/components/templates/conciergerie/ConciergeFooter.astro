---
import data from '../../../data/templates/concierge.json';
---
<footer class="relative bg-concierge-encre text-concierge-champagne pt-20 pb-12">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <p class="font-cormorant italic text-concierge-laiton leading-[0.92] mb-16" style="font-size: clamp(64px,12vw,200px);">
      {data.info.wordmark}.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12 pt-10 border-t border-concierge-laiton/25">
      <div>
        <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-concierge-laiton mb-3">Maison</p>
        <p class="font-cormorant italic text-lg">{data.info.nom}<br/>{data.info.ville}</p>
      </div>
      <div>
        <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-concierge-laiton mb-3">Contact</p>
        <a href={`tel:${data.info.telephoneHref}`} class="block font-cormorant italic text-lg hover:text-concierge-laiton">{data.info.telephone}</a>
        <a href={`mailto:${data.info.email}`} class="block font-inter text-sm text-concierge-champagne/65 mt-1 hover:text-concierge-laiton break-all">{data.info.email}</a>
      </div>
      <div>
        <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-concierge-laiton mb-3">Disponibilités</p>
        <ul class="space-y-1 font-inter text-sm text-concierge-champagne/70">
          {data.horaires.map(h => (
            <li class="flex flex-col"><span class="text-concierge-champagne">{h.jour}</span><span class="italic text-xs opacity-75">{h.label}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-inter text-[10px] uppercase tracking-[0.3em] text-concierge-laiton mb-3">Suivre</p>
        <p class="font-cormorant italic text-lg">{data.info.instagram}</p>
        <p class="font-inter text-xs text-concierge-champagne/55 mt-2">{data.info.siret}</p>
      </div>
    </div>
    <div class="pt-8 border-t border-concierge-laiton/20 flex flex-wrap items-center justify-between gap-3 font-inter text-[11px] uppercase tracking-[0.25em] text-concierge-champagne/50">
      <span>© {data.info.nom} {data.info.annee} — {new Date().getFullYear()}</span>
      <span class="italic font-cormorant normal-case tracking-normal text-concierge-laiton text-base">{data.info.tagline}</span>
    </div>
  </div>
</footer>
