---
import data from '../../../data/templates/concierge.json';
const year = new Date().getFullYear();
---
<footer class="py-12 md:py-16 border-t" style="background:#F7F4EE; border-color:rgba(15,27,46,0.12);">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-10">
    <div>
      <div class="font-cormorant italic text-2xl" style="color:#0F1B2E;">Concierge & Co</div>
      <p class="text-[12px] uppercase tracking-[0.22em] mt-1" style="color:#7A6A4E;">Conciergerie privée · Réunion</p>
      <p class="mt-5 text-[14px] leading-relaxed" style="color:#3D4453;">Fondée en {data.info.annee}. Trois conciergères temps plein, une trentaine de propriétés sous gestion.</p>
    </div>
    <div>
      <div class="text-[11px] uppercase tracking-[0.28em] mb-3" style="color:#7A6A4E;">Contact</div>
      <ul class="space-y-2 text-[14px]" style="color:#0F1B2E;">
        <li><a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a></li>
        <li><a href={`mailto:${data.info.email}`}>{data.info.email}</a></li>
        <li>Lundi → samedi · 8h – 20h</li>
      </ul>
    </div>
    <div>
      <div class="text-[11px] uppercase tracking-[0.28em] mb-3" style="color:#7A6A4E;">Navigation</div>
      <ul class="space-y-2 text-[14px]" style="color:#0F1B2E;">
        <li><a href="#services">Services</a></li>
        <li><a href="#tarification">Tarifs</a></li>
        <li><a href="#zone">Zone d'intervention</a></li>
        <li><a href="#contact">Contact</a></li>
      </ul>
    </div>
  </div>
  <div class="max-w-content mx-auto px-6 md:px-10 mt-10 pt-6 border-t flex flex-wrap justify-between gap-3 text-[11px] uppercase tracking-[0.22em]"
       style="border-color:rgba(15,27,46,0.12); color:#7A6A4E;">
    <span>© {year} Concierge & Co — Démonstration 9site4</span>
    <span>Tous droits réservés</span>
  </div>
</footer>
