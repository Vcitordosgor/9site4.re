---
/**
 * CommentCaMarche — 4 étapes en timeline horizontale scrollable.
 */
import data from '../../../data/templates/concierge.json';
---
<section id="processus" class="relative bg-concierge-nuit text-white py-24 md:py-32 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12 mb-12">
    <p class="font-inter text-[11px] uppercase tracking-[0.45em] text-concierge-laiton mb-4">§ Méthode</p>
    <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
      De la visite<br/>au reporting.
    </h2>
  </div>

  <div class="relative">
    <!-- ligne timeline -->
    <div class="absolute top-1/2 left-0 right-0 h-px bg-concierge-laiton/40 -translate-y-1/2 mx-12 hidden md:block"></div>
    <div class="overflow-x-auto md:overflow-visible no-scrollbar">
      <ol class="flex md:grid md:grid-cols-4 gap-6 md:gap-8 px-6 md:px-12 pb-10">
        {data.etapes.map((e, i) => (
          <li class="shrink-0 w-[80vw] md:w-auto relative">
            <div class="flex flex-col items-start gap-4">
              <span class="relative z-10 w-14 h-14 flex items-center justify-center bg-concierge-laiton text-concierge-nuit font-cormorant italic text-2xl">{e.n}</span>
              <div>
                <h3 class="font-cormorant italic text-2xl md:text-3xl text-white leading-tight">{e.titre}</h3>
                <p class="mt-2 font-inter text-sm text-white/70 leading-relaxed">{e.description}</p>
              </div>
            </div>
            {i < 3 && (
              <div class="absolute top-7 -right-3 md:right-0 w-6 md:w-8 h-px bg-concierge-laiton/60 hidden md:block"></div>
            )}
          </li>
        ))}
      </ol>
    </div>
  </div>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { scrollbar-width: none; }
  </style>
</section>
