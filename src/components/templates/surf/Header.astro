---
import data from '../../../data/templates/borddeau.json';
const nav = [
  { href: '#formules', label: 'Formules' },
  { href: '#spots', label: 'Spots' },
  { href: '#maree', label: 'Météo & marée' },
  { href: '#process', label: 'Réserver' },
];
---
<header id="sf-header" data-scrolled="false" class="fixed top-0 inset-x-0 z-50 transition-all duration-500">
  <div class="absolute inset-0 transition-all" id="sf-bg" style="background:transparent;"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="#top" class="flex items-baseline gap-2.5" aria-label="Bord d'eau">
      <svg viewBox="0 0 32 24" class="w-9 h-7" aria-hidden="true"><path d="M0 18 Q8 8 16 14 Q24 20 32 10" stroke="#FF6B5A" stroke-width="2" fill="none"/></svg>
      <span class="font-bebas text-3xl tracking-wide" style="color:#F4F8F7;" data-text>BORD D'EAU</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[12px] uppercase tracking-[0.18em] font-bold" aria-label="Navigation">
      {nav.map(n => <a href={n.href} style="color:#F4F8F7;" data-text class="hover:opacity-70 transition-opacity">{n.label}</a>)}
    </nav>
    <a href="#process" class="hidden md:inline-flex items-center h-11 px-5 text-[12px] uppercase tracking-[0.16em] font-bold transition-colors" style="background:#FF6B5A; color:#0F2A36;">Réserver un cours</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-10 px-4 text-[11px] uppercase tracking-wider font-bold" style="background:#FF6B5A; color:#0F2A36;">Appeler</a>
  </div>
</header>
<style>
  #sf-header[data-scrolled='true'] #sf-bg { background:rgba(15,42,54,0.96); backdrop-filter:blur(10px); }
</style>
<script>
  const h = document.getElementById('sf-header');
  if (h) { const u = () => { h.dataset.scrolled = String(window.scrollY > 24); }; u(); window.addEventListener('scroll', u, { passive: true }); }
</script>
