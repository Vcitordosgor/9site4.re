---
const faqs = [
  { q: 'JE SAIS PAS NAGER, JE PEUX ?', r: 'Savoir nager est obligatoire — au minimum 25m en eau profonde. Pour les vrais débutants en natation, on conseille les écoles de natation avant.' },
  { q: 'À PARTIR DE QUEL ÂGE ?', r: '8 ans pour l\'initiation. Cours enfants spécifiques 8-12 ans, encadrement renforcé.' },
  { q: 'SI ÇA NE SURFE PAS ?', r: 'On reporte ou rembourse. Pas de session = pas de paiement. La mer décide, on ne force jamais.' },
  { q: 'COMBIEN DE TEMPS POUR DÉBUTER ?', r: 'Une session pour le take-off mousse. 5 à 10 sessions pour la première vague verte. C\'est un sport de patience.' },
  { q: 'REQUINS ?', r: 'Sécurité totale : nous surfons uniquement dans le lagon ou les zones surveillées par le CRA. Briefing risque obligatoire avant chaque session.' },
];
---
<section class="py-24 md:py-32" style="background:#0F2A36; color:#F4F8F7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FF6B5A;">FAQ</div>
    <h2 class="font-bebas text-6xl md:text-7xl leading-[0.9] mb-12">DEMANDES<br/><span style="color:#3CACAE;">RÉCURRENTES.</span></h2>
    <div class="max-w-3xl">
      {faqs.map(f => (
        <details class="group py-6 border-t" style="border-color:rgba(244,248,247,0.15);">
          <summary class="cursor-pointer flex justify-between gap-4 font-bebas text-2xl md:text-3xl">
            {f.q}<span class="font-bebas text-3xl transition-transform group-open:rotate-45" style="color:#FF6B5A;">+</span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed" style="color:#D8E0E0;">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
