---
const spots = [
  { nom: 'SAINT-GILLES', niveau: 'Débutant → confirmé', vague: 'Beach break', desc: 'Notre spot principal pour les initiations. Fond de sable, vague mousseuse, lagune protégée. Conditions stables.', photo: '/images/surf/spot-saint-gilles.webp' },
  { nom: 'BOUCAN-CANOT', niveau: 'Intermédiaire → confirmé', vague: 'Reef break', desc: 'Pour les sessions perfectionnement. Vague plus creuse, lecture nécessaire. On sort par groupes de 4 max.', photo: '/images/surf/spot-boucan.webp' },
];
---
<section id="spots" class="py-24 md:py-32" style="background:#F4F8F7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FF6B5A;">Nos spots</div>
      <h2 class="font-bebas text-6xl md:text-7xl leading-[0.9]" style="color:#0F2A36;">DEUX SPOTS.<br/><span style="color:#3CACAE;">PAS PLUS.</span></h2>
      <p class="mt-4 text-base" style="color:#3A4A56;">Pourquoi deux ? Parce qu'on les connaît par cœur. La sécurité, ça passe par la maîtrise du terrain.</p>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {spots.map(s => (
        <article class="relative overflow-hidden group">
          <div class="aspect-[4/3]"><img src={s.photo} alt={s.nom} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy"/></div>
          <div class="absolute inset-0 flex flex-col justify-end p-7 md:p-8" style="background:linear-gradient(180deg, rgba(15,42,54,0.0) 40%, rgba(15,42,54,0.85) 100%);">
            <div class="text-[11px] uppercase tracking-[0.32em] mb-2 font-bold" style="color:#FF6B5A;">{s.vague} · {s.niveau}</div>
            <h3 class="font-bebas text-5xl leading-none mb-2" style="color:#F4F8F7;">{s.nom}</h3>
            <p class="text-[14px] leading-relaxed" style="color:#D8E0E0;">{s.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
