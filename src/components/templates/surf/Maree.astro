---
const jours = [
  { jour: 'LUN', date: '10', mar: '06:42 / 18:54', taille: '1.4m', periode: '11s', vent: '12kt', cond: 'OK' },
  { jour: 'MAR', date: '11', mar: '07:28 / 19:40', taille: '1.6m', periode: '12s', vent: '8kt', cond: 'BON' },
  { jour: 'MER', date: '12', mar: '08:14 / 20:26', taille: '1.8m', periode: '13s', vent: '6kt', cond: 'EXC' },
  { jour: 'JEU', date: '13', mar: '09:00 / 21:12', taille: '2.0m', periode: '14s', vent: '10kt', cond: 'EXC' },
  { jour: 'VEN', date: '14', mar: '09:46 / 21:58', taille: '1.7m', periode: '12s', vent: '14kt', cond: 'BON' },
  { jour: 'SAM', date: '15', mar: '10:32 / 22:44', taille: '1.3m', periode: '10s', vent: '18kt', cond: 'OK' },
  { jour: 'DIM', date: '16', mar: '11:18 / 23:30', taille: '1.0m', periode: '8s', vent: '22kt', cond: 'PETIT' },
];
const colorCond = { 'EXC': '#3CACAE', 'BON': '#E5C99A', 'OK': '#F4F8F7', 'PETIT': '#FF6B5A' };
---
<section id="maree" class="py-24 md:py-32" style="background:#0F2A36; color:#F4F8F7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-10 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FF6B5A;">Météo & marée</div>
      <h2 class="font-bebas text-5xl md:text-6xl leading-[0.9]">LA SEMAINE<br/>EN UN COUP D'ŒIL.</h2>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left" style="border-collapse:collapse;">
        <thead>
          <tr class="text-[10px] uppercase tracking-[0.28em] font-bold" style="color:#3CACAE;">
            <th class="py-3 px-3">JOUR</th><th class="py-3 px-3">DATE</th><th class="py-3 px-3">PLEINE / BASSE</th>
            <th class="py-3 px-3">HOULE</th><th class="py-3 px-3">PÉRIODE</th><th class="py-3 px-3">VENT</th><th class="py-3 px-3 text-right">COND.</th>
          </tr>
        </thead>
        <tbody>
          {jours.map(j => (
            <tr style="border-top:1px solid rgba(244,248,247,0.15);">
              <td class="py-4 px-3 font-bebas text-2xl">{j.jour}</td>
              <td class="py-4 px-3 font-bebas text-2xl" style="color:#3CACAE;">{j.date}</td>
              <td class="py-4 px-3 font-mono text-sm" style="font-family:monospace; color:#D8E0E0;">{j.mar}</td>
              <td class="py-4 px-3 font-bebas text-xl">{j.taille}</td>
              <td class="py-4 px-3 font-bebas text-xl">{j.periode}</td>
              <td class="py-4 px-3 font-bebas text-xl">{j.vent}</td>
              <td class="py-4 px-3 text-right"><span class="inline-block px-3 py-1 text-[11px] uppercase tracking-[0.22em] font-bold" style={`background:${colorCond[j.cond]}; color:#0F2A36;`}>{j.cond}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-6 text-[12px] uppercase tracking-[0.22em] font-bold" style="color:#3CACAE;">— Mise à jour quotidienne · données SHOM + windguru</p>
  </div>
</section>
