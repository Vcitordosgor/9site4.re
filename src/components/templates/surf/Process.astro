---
import data from '../../../data/templates/borddeau.json';
const etapes = [
  { num: '01', t: 'TU NOUS APPELLES', d: 'Téléphone, WhatsApp ou formulaire. On valide votre niveau, vos disponibilités, on propose un créneau.' },
  { num: '02', t: 'ON CONFIRME', d: 'La veille au plus tard. Selon météo, on peut décaler ou changer de spot — on prévient toujours.' },
  { num: '03', t: 'TU VIENS', d: 'Rendez-vous à la cabane 15 min avant l\'heure. Vestiaire, briefing rapide, on part à l\'eau.' },
  { num: '04', t: 'TU RENTRES', d: 'Douche, debrief sur la session. On peut programmer la suivante si l\'envie est là.' },
];
---
<section id="process" class="py-24 md:py-32" style="background:#F4F8F7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FF6B5A;">Réservation</div>
      <h2 class="font-bebas text-6xl md:text-7xl leading-[0.9]" style="color:#0F2A36;">QUATRE ÉTAPES.<br/><span style="color:#3CACAE;">PAS DE BLABLA.</span></h2>
    </div>
    <div class="grid md:grid-cols-4 gap-px" style="background:rgba(15,42,54,0.15);">
      {etapes.map(e => (
        <div class="p-7" style="background:#F4F8F7;">
          <div class="font-bebas text-6xl leading-none mb-3" style="color:#FF6B5A;">{e.num}</div>
          <h3 class="font-bebas text-2xl mb-3" style="color:#0F2A36;">{e.t}</h3>
          <p class="text-[14px] leading-relaxed" style="color:#3A4A56;">{e.d}</p>
        </div>
      ))}
    </div>
    <div class="mt-12 p-8 md:p-10 flex flex-col md:flex-row md:items-center gap-6" style="background:#0F2A36; color:#F4F8F7;">
      <div class="flex-grow">
        <div class="font-bebas text-4xl md:text-5xl leading-none">PRÊT À ALLER À L'EAU ?</div>
        <p class="mt-2 text-[14px]" style="color:#D8E0E0;">Réponse sous 2h, 7j/7.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={`tel:${data.info.telephoneHref}`} class="inline-flex items-center h-13 px-7 text-[12px] uppercase tracking-[0.22em] font-bold" style="background:#FF6B5A; color:#0F2A36; height:52px;">Appeler · {data.info.telephone}</a>
        <a href={`https://wa.me/${data.info.whatsapp}`} class="inline-flex items-center h-13 px-7 text-[12px] uppercase tracking-[0.22em] font-bold" style="background:#3CACAE; color:#0F2A36; height:52px;">WhatsApp</a>
      </div>
    </div>
  </div>
</section>
