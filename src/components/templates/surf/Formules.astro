---
import data from '../../../data/templates/borddeau.json';
---

<section id="formules" class="py-20 md:py-28 relative" style="background-color: #F4F8F7;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-inter text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #3CACAE;">— Trois formules —</p>
      <h2 class="font-anton uppercase leading-[0.92]" style="color: #0F2A36; font-size: clamp(40px, 6vw, 80px); font-family: 'Anton', Impact, sans-serif;">
        Initiation, perfectionnement,<br />
        <span style="color: #3CACAE;">stage 5 jours.</span>
      </h2>
      <p class="mt-5 font-inter text-[15px] leading-relaxed" style="color: rgba(15, 42, 54, 0.78);">
        Toutes nos formules incluent le matériel, l'encadrement BEES diplômé et les photos de session.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-7">
      {data.formules.map((f, i) => (
        <article class={`p-7 md:p-9 flex flex-col relative ${i === 1 ? 'ring-2' : ''}`} style={`background-color: ${i === 1 ? '#0F2A36' : '#FFFFFF'}; color: ${i === 1 ? '#F4F8F7' : '#0F2A36'}; border: 1px solid ${i === 1 ? '#0F2A36' : 'rgba(15, 42, 54, 0.2)'}; --tw-ring-color: #3CACAE;`}>

          <!-- Badge top -->
          <div class="absolute top-0 right-6 -translate-y-1/2 px-3 py-1 rounded-full font-anton text-[10px] uppercase tracking-[0.2em]" style={`background-color: ${i === 1 ? '#E5C99A' : '#3CACAE'}; color: #0F2A36; font-family: 'Anton', Impact, sans-serif;`}>
            {i === 1 ? 'Le plus populaire' : i === 0 ? 'Débutant' : 'Vacances'}
          </div>

          <p class="font-inter text-[10.5px] uppercase tracking-[0.3em] mt-2" style={`color: ${i === 1 ? '#3CACAE' : '#3CACAE'};`}>
            Formule {String(i + 1).padStart(2, '0')}
          </p>

          <h3 class="mt-2 font-anton uppercase leading-tight" style={`font-size: clamp(32px, 4vw, 44px); font-family: 'Anton', Impact, sans-serif;`}>
            {f.label}
          </h3>

          <p class="mt-1 font-inter italic text-lg md:text-xl leading-snug" style={`color: ${i === 1 ? '#E5C99A' : '#3CACAE'};`}>
            {f.tagline}
          </p>

          <div class="mt-5 pt-4 border-t flex items-baseline justify-between" style={`border-color: ${i === 1 ? 'rgba(229, 201, 154, 0.3)' : 'rgba(15, 42, 54, 0.2)'};`}>
            <div>
              <p class="font-inter text-[10px] uppercase tracking-[0.25em]" style={`color: ${i === 1 ? '#3CACAE' : '#3CACAE'};`}>Durée</p>
              <p class="font-anton text-2xl" style="font-family: 'Anton', Impact, sans-serif;">{f.duree}</p>
            </div>
            <div class="text-right">
              <p class="font-inter text-[10px] uppercase tracking-[0.25em]" style={`color: ${i === 1 ? '#3CACAE' : '#3CACAE'};`}>Tarif</p>
              <p class="font-anton text-3xl md:text-4xl" style="font-family: 'Anton', Impact, sans-serif;">{f.prix}</p>
            </div>
          </div>

          <p class="mt-5 font-inter text-[14px] leading-relaxed flex-1" style={`color: ${i === 1 ? 'rgba(244, 248, 247, 0.85)' : 'rgba(15, 42, 54, 0.82)'};`}>
            {f.description}
          </p>

          <ul class="mt-5 pt-4 border-t space-y-1.5 font-inter text-[13px]" style={`border-color: ${i === 1 ? 'rgba(229, 201, 154, 0.3)' : 'rgba(15, 42, 54, 0.2)'}; color: ${i === 1 ? 'rgba(244, 248, 247, 0.85)' : 'rgba(15, 42, 54, 0.82)'};`}>
            {f.inclus.map((inc) => (
              <li class="flex items-start gap-2">
                <span class="mt-1 inline-block w-1.5 h-1.5 rounded-full flex-shrink-0" style={`background-color: ${i === 1 ? '#E5C99A' : '#3CACAE'};`}></span>
                <span>{inc}</span>
              </li>
            ))}
          </ul>

          <a
            href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver la formule ' + f.label + '.')}`}
            target="_blank"
            rel="noopener"
            class="mt-6 inline-flex items-center justify-center h-12 px-6 font-anton text-[13px] uppercase tracking-[0.2em] rounded-full transition-opacity hover:opacity-90"
            style={`background-color: ${i === 1 ? '#3CACAE' : '#0F2A36'}; color: #F4F8F7; font-family: 'Anton', Impact, sans-serif;`}
          >
            Réserver
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
