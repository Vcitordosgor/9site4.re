---
const formules = [
  { titre: 'INITIATION', sous: 'Première vague', prix: '50€', duree: '1h30', niveau: 'Débutant', desc: 'Briefing sécurité, équipement fourni, premières vagues sur mousse. À partir de 8 ans.', tag: '01' },
  { titre: 'PERFECTIONNEMENT', sous: 'Stage 5 séances', prix: '220€', duree: '5×1h30', niveau: 'Intermédiaire', desc: 'Take-off propre, virages, lecture de vague. Sur 5 séances étalées sur la semaine.', tag: '02', populaire: true },
  { titre: 'COACHING', sous: 'Sur-mesure', prix: '75€', duree: '1h30 1-à-1', niveau: 'Confirmé', desc: 'Analyse vidéo, travail technique ciblé. Pour passer un cap ou préparer un voyage surf.', tag: '03' },
];
---
<section id="formules" class="py-20 sm:py-24 md:py-32" style="background:#F4F8F7;">
  <div class="max-w-content mx-auto px-6 sm:px-8 md:px-10">
    <div class="mb-12 sm:mb-14 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FF6B5A;">Trois formules</div>
      <h2 class="font-bebas text-5xl sm:text-6xl md:text-8xl leading-[0.9]" style="color:#0F2A36;">CHOISIS<br/>TA VAGUE.</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 sm:gap-6 md:gap-5">
      {formules.map(f => (
        <article class="formule-card relative flex flex-col" style={`background:${f.populaire ? '#0F2A36' : '#FFFFFF'}; color:${f.populaire ? '#F4F8F7' : '#0F2A36'};`}>
          <div class="relative aspect-[5/4] flex items-center justify-center overflow-hidden" style={`background:${f.populaire ? '#1A4654' : '#E5EFEF'};`}>
            <span class="font-bebas leading-none select-none" style={`font-size:clamp(180px,22vw,280px); color:${f.populaire ? '#FF6B5A' : '#3CACAE'}; opacity:0.85;`} aria-hidden="true">{f.tag}</span>
            <svg viewBox="0 0 400 80" class="absolute bottom-0 inset-x-0 w-full h-12" preserveAspectRatio="none" aria-hidden="true">
              <path d="M0,40 Q60,10 120,40 T240,40 T360,40 L400,40 L400,80 L0,80 Z" fill={f.populaire ? '#0F2A36' : '#FFFFFF'} opacity="0.85"/>
              <path d="M0,55 Q70,30 140,55 T280,55 T400,55 L400,80 L0,80 Z" fill={f.populaire ? '#0F2A36' : '#FFFFFF'}/>
            </svg>
          </div>
          <div class="p-7 sm:p-8 flex flex-col flex-grow">
            {f.populaire && <div class="text-[10px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FF6B5A;">LE PLUS POPULAIRE</div>}
            <h3 class="font-bebas text-4xl md:text-5xl leading-none mb-1">{f.titre}</h3>
            <div class="text-[11px] uppercase tracking-[0.22em] mb-5 font-bold" style={`color:${f.populaire ? '#3CACAE' : '#5A7080'};`}>{f.sous} · {f.niveau}</div>
            <p class="text-[14px] leading-relaxed mb-6 flex-grow" style={`color:${f.populaire ? '#D8E0E0' : '#3A4A56'};`}>{f.desc}</p>
            <div class="flex items-baseline justify-between mb-5">
              <div><div class="font-bebas text-5xl leading-none">{f.prix}</div><div class="text-[10px] uppercase tracking-[0.22em] mt-1" style={`color:${f.populaire ? '#3CACAE' : '#5A7080'};`}>{f.duree}</div></div>
            </div>
            <a href="#process" class="inline-flex items-center justify-center h-12 text-[12px] uppercase tracking-[0.22em] font-bold" style={f.populaire ? 'background:#FF6B5A; color:#0F2A36;' : 'background:#0F2A36; color:#F4F8F7;'}>RÉSERVER</a>
          </div>
          <!-- Mini-vague signature ondulante sous chaque carte -->
          <svg class="formule-signature absolute -bottom-2 inset-x-0 w-full h-4 pointer-events-none" viewBox="0 0 200 16" preserveAspectRatio="none" aria-hidden="true">
            <path class="formule-sig-path" d="M0,8 Q25,2 50,8 T100,8 T150,8 T200,8" fill="none" stroke={f.populaire ? '#FF6B5A' : '#3CACAE'} stroke-width="1.6" stroke-linecap="round"/>
          </svg>
        </article>
      ))}
    </div>
  </div>

  <style>
    .formule-card { padding-bottom: 4px; }
    .formule-signature { overflow: visible; }
    .formule-sig-path {
      stroke-dasharray: 220;
      stroke-dashoffset: 220;
      animation: formule-sig-roll 5s ease-in-out infinite;
      transform-box: fill-box;
      transform-origin: center;
    }
    .formule-card[data-paused="true"] .formule-sig-path { animation-play-state: paused; }
    @keyframes formule-sig-roll {
      0%   { stroke-dashoffset: 220; transform: translateX(0); }
      50%  { stroke-dashoffset: 0;   transform: translateX(-6px); }
      100% { stroke-dashoffset: -220; transform: translateX(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .formule-sig-path { animation: none; stroke-dashoffset: 0; transform: none; }
    }
  </style>

  <script>
    (() => {
      const cards = document.querySelectorAll('.formule-card');
      if (!cards.length || !('IntersectionObserver' in window)) return;
      cards.forEach(c => c.setAttribute('data-paused', 'true'));
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          e.target.setAttribute('data-paused', e.isIntersecting ? 'false' : 'true');
        });
      }, { threshold: 0.1 });
      cards.forEach(c => io.observe(c));
    })();
  </script>
</section>
