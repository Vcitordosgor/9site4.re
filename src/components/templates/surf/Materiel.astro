---
const items = [
  { i: '🏄', t: 'Planche adaptée', d: 'Mini-mal, longboard ou shortboard selon votre niveau et la condition du jour.' },
  { i: '🩱', t: 'Combinaison lycra', d: 'Tailles XS à XXL. Anti-UV, longues manches recommandées avec le soleil tropical.' },
  { i: '🪢', t: 'Leash + wax', d: 'Vérifié à chaque session. Wax tropical pré-appliquée — pas glissant.' },
  { i: '🧴', t: 'Crème solaire reef-safe', d: 'On en fournit pour qui en aurait oublié. Protection du récif obligatoire.' },
  { i: '🩹', t: 'Trousse premiers soins', d: 'Toujours à bord. Antiseptique, pansements, eau douce pour rinçage.' },
  { i: '📦', t: 'Vestiaire & douche', d: 'Cabane de surf : vestiaire séparé, douche d\'eau douce, casiers fermés.' },
];
---
<section class="py-24 md:py-32" style="background:#E5C99A;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-2xl">
      <div class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#0F2A36;">Matériel inclus</div>
      <h2 class="font-bebas text-6xl md:text-7xl leading-[0.9]" style="color:#0F2A36;">TOUT FOURNI.<br/><span style="color:#FF6B5A;">JUSTE VIENS.</span></h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {items.map(i => (
        <div class="p-6" style="background:#F4F8F7;">
          <div class="text-3xl mb-3">{i.i}</div>
          <h3 class="font-bebas text-2xl mb-2" style="color:#0F2A36;">{i.t}</h3>
          <p class="text-[14px] leading-relaxed" style="color:#3A4A56;">{i.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>
