---
/**
 * Bandeau — bandeau pleine largeur fond feu, 3 promesses garage courtes.
 */
---

<section class="relative bg-piton-feu text-piton-asphalte py-12 md:py-16 px-6 md:px-10 overflow-hidden border-y-2 border-piton-asphalte">
  <div class="absolute inset-0 opacity-[0.08]" aria-hidden="true"
       style="background-image: repeating-linear-gradient(135deg, rgb(15 16 20) 0 2px, transparent 2px 14px);">
  </div>

  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-piton-asphalte/25">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2">
        <span class="font-bebas text-piton-asphalte leading-none tracking-[0.04em]" style="font-size: clamp(40px, 5vw, 60px);">DEVIS GRATUIT</span>
        <p class="mt-2 font-jetbrains font-medium uppercase tracking-[0.22em] text-piton-asphalte/80 text-[11px]">
          Diagnostic sans engagement
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 80ms">
        <span class="font-bebas text-piton-asphalte leading-none tracking-[0.04em]" style="font-size: clamp(40px, 5vw, 60px);">VÉHICULE DE PRÊT</span>
        <p class="mt-2 font-jetbrains font-medium uppercase tracking-[0.22em] text-piton-asphalte/80 text-[11px]">
          Selon disponibilité atelier
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 160ms">
        <span class="font-bebas text-piton-asphalte leading-none tracking-[0.04em]" style="font-size: clamp(40px, 5vw, 60px);">PIÈCES TRACÉES</span>
        <p class="mt-2 font-jetbrains font-medium uppercase tracking-[0.22em] text-piton-asphalte/80 text-[11px]">
          Facture détaillée, référence fabricant
        </p>
      </li>
    </ul>
  </div>
</section>
