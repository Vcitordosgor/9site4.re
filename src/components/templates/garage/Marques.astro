---
/**
 * Marques traitées — liste textuelle (pas de logos).
 * Tous types de véhicules, généralistes français + asiatiques + européens.
 */
const marques = [
  'Renault', 'Peugeot', 'Citroën', 'Dacia', 'DS',
  'Toyota', 'Hyundai', 'Kia', 'Nissan', 'Mazda',
  'Volkswagen', 'Opel', 'Ford', 'Fiat', 'Suzuki',
  'Honda', 'Mitsubishi', 'Seat', 'Skoda', 'Mini',
];
---

<section id="marques" class="bg-piton-asphalte text-piton-beton py-20 md:py-28 relative overflow-hidden border-y border-piton-beton/10">

  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-12 md:mb-14">
      <p class="font-jetbrains text-[11px] uppercase tracking-[0.4em] text-piton-feu mb-4">▸ Marques traitées</p>
      <h2 class="font-bebas text-piton-blanc text-5xl md:text-7xl leading-[0.9] tracking-[0.02em]">
        TOUTES MARQUES,<br/>
        <span class="text-piton-feu">UN SEUL ATELIER.</span>
      </h2>
      <p class="mt-5 font-inter-tight text-piton-beton/75 text-base md:text-lg leading-relaxed">
        Mécanique généraliste pour véhicules essence, diesel et hybrides — françaises, européennes et asiatiques.
      </p>
    </div>

    <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-px bg-piton-beton/10 border border-piton-beton/10">
      {marques.map((m) => (
        <li class="bg-piton-asphalte px-5 py-5 flex items-center justify-center">
          <span class="font-bebas text-piton-blanc text-xl md:text-2xl tracking-[0.06em]">{m}</span>
        </li>
      ))}
    </ul>

    <p class="mt-8 font-jetbrains text-xs uppercase tracking-[0.25em] text-piton-beton/55">
      Votre marque n'est pas listée ? Appelez l'atelier, on regarde ensemble.
    </p>
  </div>
</section>
