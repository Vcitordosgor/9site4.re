---
/**
 * Agrements — 4 badges/agréments + certifications du garage.
 * Carte type fiche atelier, codes mono.
 */
const items = [
  { code: 'CT-001', label: 'Centre de Contrôle Technique partenaire', sub: 'Réseau agréé · revisites planifiées' },
  { code: 'BCS-002', label: 'Bosch Car Service Partner', sub: 'Outillage diagnostic certifié' },
  { code: 'ASS-003', label: 'Agréé toutes assurances', sub: 'Carrosserie & mécanique tous contrats' },
  { code: 'GAR-004', label: 'Garantie 12 mois pièces & MO', sub: 'Sur l\'ensemble des interventions atelier' },
];
---

<section class="relative bg-piton-acier text-piton-beton py-20 md:py-24 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="mb-12 md:mb-14 max-w-3xl">
      <p class="scroll-reveal font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-piton-feu">
        Certifications & agréments
      </p>
      <h2 class="scroll-reveal mt-4 font-bebas uppercase text-piton-blanc leading-[0.95] tracking-tight" style="font-size: clamp(34px, 4.8vw, 56px);">
        Réseau, outils, assurance —<br/><span class="text-piton-feu">tout est tracé.</span>
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 gap-4">
      {items.map((it, i) => (
        <li
          class="scroll-reveal group flex items-start gap-5 p-6 bg-piton-asphalte border border-piton-fonte hover:border-piton-feu transition-all duration-300 hover:translate-x-1"
          style={`transition-delay: ${i * 70}ms`}
        >
          <span class="shrink-0 inline-flex items-center justify-center w-14 h-14 bg-piton-acier border border-piton-feu/40 group-hover:bg-piton-feu transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-piton-feu group-hover:text-piton-blanc transition-colors" aria-hidden="true">
              <polyline points="9 11 12 14 22 4"/>
              <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>
            </svg>
          </span>
          <div class="min-w-0">
            <p class="font-jetbrains-mono text-[10px] text-piton-acide uppercase tracking-[0.28em]">
              {it.code}
            </p>
            <h3 class="mt-1 font-bebas uppercase text-piton-blanc leading-tight tracking-wide" style="font-size: 22px;">
              {it.label}
            </h3>
            <p class="mt-1.5 font-inter-tight text-piton-beton/65 leading-snug" style="font-size: 13.5px;">
              {it.sub}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
