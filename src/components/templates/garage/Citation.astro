---
/**
 * Citation — extrait carnet d'atelier, fond asphalte avec grain métal.
 */
---

<section class="relative bg-piton-asphalte text-piton-beton py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <div class="absolute inset-x-0 top-0 h-1 bg-piton-feu" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-1 bg-piton-feu" aria-hidden="true"></div>

  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true"
       style="background-image: repeating-linear-gradient(45deg, rgb(232 90 50) 0 2px, transparent 2px 14px);">
  </div>

  <div class="relative max-w-5xl mx-auto">
    <span class="scroll-reveal block font-bebas text-piton-feu/20 leading-none tracking-tight" style="font-size: clamp(120px, 18vw, 220px);" aria-hidden="true">
      &laquo;
    </span>

    <blockquote class="scroll-reveal -mt-12 md:-mt-20 font-inter-tight italic text-piton-blanc leading-[1.2] tracking-tight" style="font-size: clamp(30px, 4.6vw, 52px);">
      Une mécanique ne ment pas. Elle prévient, elle gronde, elle force.
      <span class="block mt-4 not-italic font-bebas text-piton-feu tracking-wide">Le mécanicien écoute.</span>
    </blockquote>

    <footer class="scroll-reveal mt-10 flex items-center gap-4">
      <span class="block w-10 h-[2px] bg-piton-feu" aria-hidden="true"></span>
      <p class="font-jetbrains uppercase tracking-[0.32em] text-piton-beton/60 text-[11px]">
        Carnet d'atelier — relevé du mois
      </p>
    </footer>
  </div>
</section>
