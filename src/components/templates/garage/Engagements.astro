---
import data from '../../../data/templates/motorpiton.json';
---

<section id="engagements" class="bg-piton-beton text-piton-asphalte py-20 md:py-28 relative overflow-hidden">
  <!-- Caution tape top -->
  <div class="absolute top-0 inset-x-0 h-2" aria-hidden="true"
       style="background: repeating-linear-gradient(45deg, #FF5A1F 0 14px, #0F1014 14px 28px);"></div>

  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-12 md:mb-16">
      <p class="font-jetbrains text-[11px] uppercase tracking-[0.4em] text-piton-feu mb-4">▸ Nos engagements</p>
      <h2 class="font-bebas text-piton-asphalte text-5xl md:text-7xl leading-[0.9] tracking-[0.02em]">
        QUATRE RÈGLES<br/>
        <span class="text-piton-feu">NON NÉGOCIABLES.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
      {data.engagements.map((e) => (
        <article class="bg-piton-asphalte text-piton-beton border-l-4 border-piton-feu p-6 md:p-7 relative">
          <span class="font-bebas text-piton-feu text-6xl md:text-7xl leading-none tracking-tight absolute top-4 right-5 opacity-30">
            {e.code}
          </span>
          <p class="font-jetbrains text-[10px] uppercase tracking-[0.25em] text-piton-feu mb-2">RÈGLE {e.code}</p>
          <h3 class="font-bebas text-piton-blanc text-2xl md:text-[28px] leading-tight tracking-[0.04em]">
            {e.titre}
          </h3>
          <p class="mt-3 font-inter-tight text-piton-beton/85 text-[14.5px] leading-relaxed">{e.texte}</p>
        </article>
      ))}
    </div>

    <!-- Module véhicule de prêt / navette -->
    <div class="mt-10 md:mt-12 grid md:grid-cols-[auto_1fr] gap-6 items-center bg-piton-asphalte text-piton-beton border-l-4 border-piton-feu p-7 md:p-8">
      <div class="flex items-center justify-center w-20 h-20 md:w-24 md:h-24 bg-piton-feu/10 border border-piton-feu/40 rounded-full flex-shrink-0">
        <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="text-piton-feu" aria-hidden="true">
          <path d="M3 13l2-5a2 2 0 0 1 2-1h10a2 2 0 0 1 2 1l2 5"/>
          <path d="M3 13v5h2v2h2v-2h10v2h2v-2h2v-5"/>
          <circle cx="7" cy="16" r="1.5"/>
          <circle cx="17" cy="16" r="1.5"/>
        </svg>
      </div>
      <div>
        <p class="font-jetbrains text-[10px] uppercase tracking-[0.25em] text-piton-feu mb-2">+ BONUS · MOBILITÉ</p>
        <h3 class="font-bebas text-piton-blanc text-2xl md:text-3xl leading-tight tracking-[0.04em]">
          VÉHICULE DE PRÊT GRATUIT OU NAVETTE
        </h3>
        <p class="mt-3 font-inter-tight text-piton-beton/85 text-[14.5px] leading-relaxed">
          Pour toute immobilisation supérieure à une demi-journée : un véhicule de courtoisie selon disponibilité, ou la navette atelier pour vous déposer et vous reprendre dans un rayon de 15 km. Sans frais supplémentaires.
        </p>
      </div>
    </div>
  </div>
</section>
