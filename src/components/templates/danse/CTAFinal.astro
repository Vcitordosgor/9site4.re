---
import data from '../../../data/templates/vermeille.json';
---
<section class="relative bg-vermeille-bordeaux text-vermeille-ivoire py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 opacity-30 pointer-events-none" aria-hidden="true" style="background: radial-gradient(ellipse 50% 60% at 80% 50%, rgba(184,149,106,0.25), transparent 65%);"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-12 text-center">
    <p class="font-caveat text-vermeille-rose text-2xl md:text-3xl mb-4 -rotate-1">au plaisir de vous accueillir,</p>
    <p class="font-italiana italic leading-[0.95]" style="font-size: clamp(56px,9vw,140px);">
      Le rideau<br/>vous attend.
    </p>
    <div class="mt-12 flex flex-wrap gap-3 justify-center">
      <a href="#inscription" class="inline-flex items-center gap-3 h-14 px-8 bg-vermeille-ivoire text-vermeille-bordeaux font-italiana text-lg tracking-wide hover:bg-vermeille-or transition-colors">S'inscrire à la saison →</a>
      <a href={`tel:${data.info.telephoneHref}`} class="inline-flex items-center gap-3 h-14 px-8 ring-1 ring-vermeille-ivoire/40 text-vermeille-ivoire font-inter-tight text-sm uppercase tracking-[0.25em] hover:bg-vermeille-velours transition-colors">Nous joindre</a>
    </div>
  </div>
</section>
