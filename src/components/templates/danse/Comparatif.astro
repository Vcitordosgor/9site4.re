---
/**
 * Comparatif — niveaux débutant / intermédiaire / avancé en cards verticales.
 */
const niveaux = [
  {
    n: 'I.', label: 'Débutant',
    pour: "Première année. Tout âge.",
    contenu: [
      "Vocabulaire fondamental",
      "Posture, alignement, écoute",
      "Une heure hebdomadaire",
      "Aucun pré-requis"
    ],
    sortie: "Démonstration en mi-année."
  },
  {
    n: 'II.', label: 'Intermédiaire',
    pour: "2–4 ans de pratique.",
    contenu: [
      "Technique approfondie",
      "Mémorisation longue",
      "Deux heures hebdomadaires",
      "Audition d'entrée"
    ],
    sortie: "Gala de fin d'année.",
    flag: true
  },
  {
    n: 'III.', label: 'Avancé',
    pour: "5+ ans, voie pré-pro.",
    contenu: [
      "Travail de scène & variations",
      "Coaching solo possible",
      "Trois heures hebdomadaires",
      "Audition + entretien"
    ],
    sortie: "Galas + sorties scéniques."
  },
];
---

<section class="relative bg-vermeille-ivoire text-vermeille-velours py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 md:mb-20 max-w-3xl">
      <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ III — Les niveaux</p>
      <h2 class="font-italiana italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 7vw, 104px);">
        Trois marches,<br/>une même rigueur.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-px bg-vermeille-or/30">
      {niveaux.map(n => (
        <article class={`relative p-8 md:p-10 bg-vermeille-ivoire transition-colors ${n.flag ? 'md:bg-vermeille-velours md:text-vermeille-ivoire' : ''}`}>
          {n.flag && <span class="absolute top-5 right-5 font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or">Le plus fréquent</span>}
          <p class="font-italiana italic leading-none mb-4 opacity-30" style="font-size: clamp(72px,8vw,112px);">{n.n}</p>
          <h3 class="font-italiana text-3xl md:text-4xl mb-2">{n.label}</h3>
          <p class="font-inter-tight italic text-sm opacity-80 mb-6">{n.pour}</p>
          <ul class="space-y-3 font-inter-tight text-sm border-t border-current/15 pt-5">
            {n.contenu.map(c => (
              <li class="flex gap-3 items-start">
                <span class="w-1 h-1 rounded-full bg-vermeille-or mt-2 shrink-0"></span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
          <div class={`mt-6 pt-5 border-t border-current/15 font-italiana italic text-base ${n.flag ? 'text-vermeille-or' : 'text-vermeille-bordeaux'}`}>
            {n.sortie}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
