---
const partenaires = [
  'Théâtre municipal',
  'Festival jeune création',
  'Conservatoire à rayonnement',
  'Maison des artistes',
  'Compagnie résidente',
  'Fédération nationale danse',
];

const distinctions = [
  { titre: 'Diplôme d\'État', sous: 'Tous les professeurs · ministère Culture' },
  { titre: 'École agréée', sous: 'Préparation aux concours nationaux' },
  { titre: 'Engagement Qualité', sous: 'Charte des écoles de danse · 2023' },
  { titre: 'Conventionné', sous: 'Mairie & département pour bourses' },
];
---

<section class="bg-vermeille-ivoire py-20 md:py-28 relative">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="font-inter-tight uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-vermeille-bordeaux mb-4">— Reconnus, agréés, conventionnés —</p>
      <h2 class="font-italiana text-vermeille-velours text-4xl md:text-6xl leading-tight">
        Une école qui
        <span class="text-vermeille-bordeaux">tient debout.</span>
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
      {distinctions.map((d) => (
        <div class="bg-vermeille-ivoire border-2 border-vermeille-or/40 hover:border-vermeille-bordeaux hover:shadow-md transition-all duration-300 p-5 md:p-7 text-center">
          <div class="font-italiana text-vermeille-bordeaux text-3xl mb-3" aria-hidden="true">★</div>
          <p class="font-italiana text-vermeille-velours text-lg md:text-xl leading-snug mb-2">{d.titre}</p>
          <p class="font-inter-tight uppercase tracking-[0.15em] text-[10px] text-vermeille-velours/70">{d.sous}</p>
        </div>
      ))}
    </div>

    <div class="border-t border-vermeille-velours/15 pt-12">
      <p class="font-inter-tight uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-vermeille-bordeaux text-center mb-8">— Nos scènes & partenaires —</p>
      <ul class="flex flex-wrap justify-center items-center gap-x-8 gap-y-5">
        {partenaires.map((p) => (
          <li class="font-italiana text-vermeille-velours text-lg md:text-2xl hover:text-vermeille-bordeaux transition-colors">
            {p}
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
