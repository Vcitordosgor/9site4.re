---
/**
 * Tarifs — 3 forfaits : trimestre / année / cours à l'unité.
 * Tarifs indicatifs, à confirmer à l'inscription.
 */

const forfaits = [
  {
    nom: 'À l’unité',
    cible: 'Pour essayer ou compléter',
    prix: '22€',
    suffixe: '/ cours',
    items: [
      'Carnet de 10 cours valable 4 mois',
      'Toutes disciplines, tous niveaux',
      'Idéal stages & ateliers ponctuels',
    ],
    cta: 'Acheter un carnet',
  },
  {
    nom: 'Trimestre',
    cible: 'Engagement court',
    prix: '210€',
    suffixe: '/ trimestre',
    items: [
      '1 cours hebdomadaire au choix',
      'Cours d’essai offert',
      'Accès aux stages weekend',
    ],
    cta: 'Choisir le trimestre',
    highlight: false,
  },
  {
    nom: 'Année complète',
    cible: 'Le meilleur tarif',
    prix: '560€',
    suffixe: '/ saison',
    items: [
      '1 cours hebdomadaire (32 séances)',
      'Spectacle de fin d’année inclus',
      'Paiement en 3 fois sans frais',
    ],
    cta: 'S’inscrire à la saison',
    highlight: true,
  },
];
---

<section id="tarifs" class="bg-vermeille-ivoire py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <p class="text-xs uppercase tracking-[0.4em] text-vermeille-bordeaux font-inter-tight font-medium">
        Tarifs & forfaits
      </p>
      <h2 class="mt-4 font-italiana text-vermeille-velours leading-[1.1]" style="font-size: clamp(32px, 5vw, 52px);">
        Trois manières de danser
      </h2>
      <p class="mt-5 text-vermeille-velours/75 font-inter-tight leading-relaxed">
        À l’unité pour essayer, au trimestre pour s’engager doucement,
        ou à l’année pour vivre la saison complète.
      </p>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
      {forfaits.map((f) => (
        <article class={`relative flex flex-col p-7 md:p-8 border ${f.highlight ? 'border-vermeille-bordeaux bg-vermeille-bordeaux/[0.04]' : 'border-vermeille-velours/15 bg-white'}`}>
          {f.highlight && (
            <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-vermeille-bordeaux text-vermeille-ivoire text-[10px] uppercase tracking-[0.3em] px-3 py-1 font-medium">
              Recommandé
            </span>
          )}
          <p class="text-[11px] uppercase tracking-[0.28em] text-vermeille-bordeaux font-medium">
            {f.cible}
          </p>
          <h3 class="mt-3 font-italiana text-vermeille-velours text-3xl">
            {f.nom}
          </h3>
          <p class="mt-5 flex items-baseline gap-2">
            <span class="font-italiana text-vermeille-velours" style="font-size: clamp(36px, 4vw, 48px);">{f.prix}</span>
            <span class="text-sm text-vermeille-velours/65">{f.suffixe}</span>
          </p>
          <ul class="mt-5 space-y-2.5 text-sm text-vermeille-velours/85 leading-relaxed flex-1">
            {f.items.map((i) => (
              <li class="flex gap-2.5">
                <span class="text-vermeille-bordeaux mt-1.5 shrink-0" aria-hidden="true">·</span>
                <span>{i}</span>
              </li>
            ))}
          </ul>
          <a
            href="#inscription"
            class={`mt-7 inline-flex items-center justify-center h-12 px-5 text-xs font-medium uppercase tracking-[0.22em] transition-colors ${f.highlight ? 'bg-vermeille-bordeaux text-vermeille-ivoire hover:bg-vermeille-velours' : 'border border-vermeille-velours/30 text-vermeille-velours hover:bg-vermeille-velours hover:text-vermeille-ivoire'}`}
          >
            {f.cta}
          </a>
        </article>
      ))}
    </div>

    <p class="mt-10 text-center text-xs text-vermeille-velours/60 font-inter-tight italic">
      Tarifs indicatifs, à confirmer lors de l’inscription. Paiement en plusieurs fois sur demande.
    </p>
  </div>
</section>
