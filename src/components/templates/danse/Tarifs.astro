---
/**
 * Tarifs — 3 formules essai / mensuel / annuel.
 */
const formules = [
  {
    label: 'Cours d\'essai', prix: 'Offert', sous: 'Un cours, aucune obligation.',
    incl: ['Choix libre de la discipline','Vêtements souples acceptés','Échange avec le ou la prof'],
    cta: 'Réserver l\'essai'
  },
  {
    label: 'Saison mensuelle', prix: '68', unite: '€/mois', sous: 'Engagement annuel mensualisé.',
    incl: ['1 discipline, 1 heure/semaine','Accès libre studio le mercredi','Galas inclus','Sans frais d\'inscription'],
    cta: 'M\'inscrire',
    flag: true
  },
  {
    label: 'Saison annuelle', prix: '620', unite: '€/an', sous: 'Tarif préférentiel, payable en une fois.',
    incl: ['1 discipline, 1 heure/semaine','Réduction de deux mois','Accès libre studio','Galas + sortie spectacle annuelle'],
    cta: 'M\'inscrire'
  },
];
---

<section id="tarifs" class="relative bg-vermeille-ivoire text-vermeille-velours py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="text-center mb-14 md:mb-20">
      <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ VI — Inscriptions</p>
      <h2 class="font-italiana italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 7vw, 104px);">
        Trois manières<br/>de commencer.
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-px bg-vermeille-or/30">
      {formules.map(f => (
        <article class={`relative p-8 md:p-10 flex flex-col ${f.flag ? 'bg-vermeille-velours text-vermeille-ivoire' : 'bg-vermeille-ivoire'}`}>
          {f.flag && <span class="absolute -top-3 left-8 px-3 py-1 bg-vermeille-bordeaux text-vermeille-ivoire font-inter-tight text-[10px] uppercase tracking-[0.3em]">Le plus pris</span>}
          <p class="font-italiana italic text-base mb-1 opacity-80">{f.label}</p>
          <p class="font-italiana leading-none" style="font-size: clamp(72px,9vw,120px);">
            {f.prix}<span class="font-italiana italic text-xl ml-1 opacity-70">{f.unite}</span>
          </p>
          <p class="mt-3 font-inter-tight italic text-sm opacity-75">{f.sous}</p>
          <ul class="mt-7 space-y-3 font-inter-tight text-sm border-t border-current/15 pt-6 flex-1">
            {f.incl.map(i => (
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 mt-0.5 shrink-0" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>{i}</span>
              </li>
            ))}
          </ul>
          <a href="#inscription" class={`mt-8 inline-flex items-center justify-between h-12 px-5 font-italiana tracking-wide text-base ${f.flag ? 'bg-vermeille-ivoire text-vermeille-velours' : 'bg-vermeille-bordeaux text-vermeille-ivoire'}`}>
            {f.cta} <span aria-hidden="true">→</span>
          </a>
        </article>
      ))}
    </div>
    <p class="mt-8 text-center font-inter-tight text-xs text-vermeille-velours/60 italic">
      Tarifs indicatifs {`{`}saison 2025–2026{`}`}. Réduction 15 % à partir du second membre d'une même famille.
    </p>
  </div>
</section>
