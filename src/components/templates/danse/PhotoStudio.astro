---
/**
 * PhotoStudio — séparateur visuel ornemental SVG (sans photo) entre Planning et Niveaux.
 */
---
<section class="relative bg-vermeille-ivoire py-16 md:py-20 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12 flex items-center gap-6">
    <span class="flex-1 h-px bg-gradient-to-r from-transparent via-vermeille-or/40 to-vermeille-or/40"></span>
    <svg viewBox="0 0 200 60" class="h-12 w-auto text-vermeille-bordeaux" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
      <path d="M10 30 Q50 5 100 30 T 190 30" />
      <circle cx="100" cy="30" r="4" fill="currentColor" />
      <path d="M70 30 L100 12 L130 30 L100 48 Z" stroke-dasharray="2 3"/>
    </svg>
    <span class="flex-1 h-px bg-gradient-to-l from-transparent via-vermeille-or/40 to-vermeille-or/40"></span>
  </div>
  <p class="mt-6 text-center font-italiana italic text-vermeille-or/70 text-base md:text-lg">— Vol. XVII —</p>
</section>
