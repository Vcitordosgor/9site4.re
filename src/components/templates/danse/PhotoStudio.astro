  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-vermeille-velours">
      <img
        src="https://images.unsplash.com/photo-1518834107812-67b0b7c58434?q=80&w=2200&auto=format&fit=crop"
