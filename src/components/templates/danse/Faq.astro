---
const faq = [
  ['À partir de quel âge peut-on s\'inscrire ?', "Le classique commence à 6 ans, le jazz à 8 ans, le hip-hop à 10 ans, le contemporain et le modern à partir de 12 ans. Aucune limite haute — nous accueillons des élèves jusqu'à 77 ans."],
  ['Peut-on essayer avant de s\'engager ?', "Oui, le cours d'essai est offert pour toute discipline. Sans aucune obligation d'inscription derrière. Réservez via le formulaire ou par téléphone."],
  ['Quel tenue prévoir pour le premier cours ?', "Une tenue souple suffit. Les tenues techniques (justaucorps classique, sneakers hip-hop, etc.) ne sont demandées qu'après quelques semaines, pour s'adapter au rythme de l'élève."],
  ['Comment se déroule le gala de fin d\'année ?', "Le gala se tient en juin, en salle de spectacle louée pour l'occasion. Deux représentations (samedi soir et dimanche après-midi). Tous les élèves passent, des plus jeunes aux plus avancés."],
  ['Y a-t-il des cours pour adultes complets débutants ?', "Oui. Le classique adulte du samedi matin et le contemporain du lundi soir sont ouverts aux adultes n'ayant jamais dansé. Ambiance bienveillante, progression à votre rythme."],
  ['Que se passe-t-il pendant les vacances scolaires ?', "Le studio reste ouvert pour des stages thématiques (1 à 3 jours) sur inscription. Les cours hebdomadaires s'arrêtent."],
];
---

<section class="relative bg-vermeille-ivoire text-vermeille-velours py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-4">
      <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ VIII — Questions</p>
      <h2 class="font-italiana italic leading-[0.95] tracking-tight sticky top-28" style="font-size: clamp(48px, 6vw, 92px);">
        Tout ce<br/>qu'on nous<br/>demande.
      </h2>
    </div>
    <ul class="lg:col-span-8 divide-y divide-vermeille-or/25 border-y border-vermeille-or/25">
      {faq.map((q, i) => (
        <li>
          <details class="group">
            <summary class="cursor-pointer py-6 flex items-start justify-between gap-6 list-none">
              <div class="flex gap-5 items-start">
                <span class="font-italiana italic text-vermeille-or text-xl mt-1 shrink-0">{String(i+1).padStart(2,'0')}.</span>
                <span class="font-italiana italic text-vermeille-velours text-xl md:text-2xl leading-tight">{q[0]}</span>
              </div>
              <span class="font-italiana italic text-vermeille-bordeaux text-3xl leading-none mt-1 transition-transform group-open:rotate-45 shrink-0">+</span>
            </summary>
            <p class="pb-7 pl-10 font-inter-tight text-vermeille-velours/75 leading-relaxed max-w-3xl">{q[1]}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
