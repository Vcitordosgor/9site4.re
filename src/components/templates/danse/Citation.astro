---
import data from '../../../data/templates/vermeille.json';
---
<section class="relative bg-vermeille-ivoire text-vermeille-velours py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12 max-w-4xl text-center">
    <span class="font-italiana italic text-vermeille-bordeaux leading-none" style="font-size: clamp(160px, 22vw, 280px);">"</span>
    <blockquote class="-mt-12 md:-mt-20 font-italiana italic text-vermeille-velours leading-[1.05]" style="font-size: clamp(32px, 5vw, 64px);">
      Le rideau ne se lève qu'avec vous. Le reste, c'est notre travail —
      apprendre, répéter, recommencer, jusqu'à ce que le geste devienne vous.
    </blockquote>
    <p class="mt-10 font-inter-tight text-[10px] uppercase tracking-[0.4em] text-vermeille-or">— {data.info.fondatrice}, fondatrice depuis {data.info.annee}</p>
  </div>
</section>
