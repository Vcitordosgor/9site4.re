---
/**
 * Planning — grille hebdomadaire 5 jours × 6 créneaux avec pastilles couleur discipline.
 */
const jours = ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi'];
const creneaux = ['14h', '16h', '17h', '18h', '19h', '20h'];
type Cell = { disc: string; nom: string; niv: string; color: string };
const grille: Record<string, Cell> = {
  'Lundi-17h':    { disc:'modern',       nom:'Modern jazz',    niv:'Inter.',  color:'#E8C4C0' },
  'Lundi-18h':    { disc:'contemporain', nom:'Contemporain',   niv:'Inter.',  color:'#1A0F12' },
  'Mardi-17h':    { disc:'classique',    nom:'Classique',      niv:'Débutant',color:'#7A1A2A' },
  'Mardi-19h':    { disc:'hip-hop',      nom:'Hip-hop',        niv:'Tous',    color:'#2A1F22' },
  'Mercredi-14h': { disc:'classique',    nom:'Classique',      niv:'Enfants', color:'#7A1A2A' },
  'Mercredi-16h': { disc:'jazz',         nom:'Jazz',           niv:'Enfants', color:'#B8956A' },
  'Jeudi-18h':    { disc:'modern',       nom:'Modern jazz',    niv:'Avancé',  color:'#E8C4C0' },
  'Jeudi-19h':    { disc:'contemporain', nom:'Contemporain',   niv:'Avancé',  color:'#1A0F12' },
  'Vendredi-18h': { disc:'jazz',         nom:'Jazz',           niv:'Ados',    color:'#B8956A' },
  'Samedi-14h':   { disc:'hip-hop',      nom:'Hip-hop',        niv:'Ados',    color:'#2A1F22' },
  'Samedi-16h':   { disc:'classique',    nom:'Classique',      niv:'Tous',    color:'#7A1A2A' },
};
const legende = [
  ['#7A1A2A','Classique'],['#1A0F12','Contemporain'],['#B8956A','Jazz'],['#2A1F22','Hip-hop'],['#E8C4C0','Modern jazz']
] as const;
---

<section id="planning" class="relative bg-vermeille-velours text-vermeille-ivoire py-24 md:py-32 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="flex items-baseline justify-between gap-6 flex-wrap mb-12 md:mb-16">
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ II — La semaine</p>
        <h2 class="font-italiana italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 7vw, 104px);">
          Le planning, en un coup d'œil.
        </h2>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-inter-tight text-xs">
        {legende.map(([c, n]) => (
          <li class="flex items-center gap-2"><span class="w-3 h-3 rounded-full" style={`background:${c}`}></span><span class="opacity-80">{n}</span></li>
        ))}
      </ul>
    </div>

    <!-- Grille -->
    <div class="overflow-x-auto -mx-6 px-6 md:mx-0 md:px-0">
      <div class="min-w-[820px] grid" style="grid-template-columns: 80px repeat(6, 1fr); gap: 1px; background:#B8956A33;">
        <!-- header -->
        <div class="bg-vermeille-velours"></div>
        {jours.map(j => (
          <div class="bg-vermeille-velours py-3 px-3 font-inter-tight text-[11px] uppercase tracking-[0.3em] text-vermeille-or">{j}</div>
        ))}
        {creneaux.map(h => (
          <>
            <div class="bg-vermeille-velours py-4 pr-3 font-italiana italic text-vermeille-or/80 text-right">{h}</div>
            {jours.map(j => {
              const cell = grille[`${j}-${h}`];
              if (!cell) return <div class="bg-vermeille-velours/60 min-h-[68px]"></div>;
              return (
                <div class="min-h-[68px] p-3 flex flex-col justify-between transition-transform hover:scale-[1.03] cursor-default" style={`background:${cell.color}; color:${['#1A0F12','#2A1F22','#7A1A2A'].includes(cell.color) ? '#F8F0E5' : '#1A0F12'};`}>
                  <span class="font-italiana italic text-sm md:text-base leading-tight">{cell.nom}</span>
                  <span class="font-inter-tight text-[9px] uppercase tracking-[0.25em] opacity-75">{cell.niv}</span>
                </div>
              );
            })}
          </>
        ))}
      </div>
    </div>

    <p class="mt-8 font-inter-tight text-xs text-vermeille-ivoire/60 italic">
      Planning indicatif {`{`}saison 2025–2026{`}`}. Réajusté selon les inscriptions. Dimanche : studio fermé.
    </p>
  </div>
</section>
