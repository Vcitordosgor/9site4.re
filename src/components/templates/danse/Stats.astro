---
import data from '../../../data/templates/vermeille.json';
---
<section class="relative bg-vermeille-bordeaux text-vermeille-ivoire py-16 md:py-24 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12 grid grid-cols-1 md:grid-cols-3 gap-10 md:gap-px">
    {data.stats.map((s, i) => (
      <div class={`px-6 md:px-10 py-6 ${i > 0 ? 'md:border-l border-vermeille-or/25' : ''}`}>
        <p class="font-italiana leading-none" style="font-size: clamp(80px,11vw,140px);">{s.valeur}</p>
        <p class="mt-3 font-inter-tight text-[11px] uppercase tracking-[0.35em] text-vermeille-or/90">{s.label}</p>
      </div>
    ))}
  </div>
</section>
