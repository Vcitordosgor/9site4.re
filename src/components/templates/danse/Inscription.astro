---
/**
 * Inscription — formulaire en stepper 4 étapes (discipline → niveau → créneau → coords).
 */
import data from '../../../data/templates/vermeille.json';
---

<section id="inscription" class="relative bg-vermeille-velours text-vermeille-ivoire py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 50% at 30% 80%, rgba(122,26,42,0.35) 0%, transparent 60%);" aria-hidden="true"></div>

  <div class="relative max-w-content mx-auto px-6 md:px-12">
    <div class="text-center mb-12 md:mb-16">
      <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ VII — Le rideau s'ouvre</p>
      <h2 class="font-italiana italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 7vw, 104px);">
        S'inscrire,<br/>en quatre temps.
      </h2>
    </div>

    <!-- Stepper -->
    <ol class="flex items-stretch justify-between gap-4 md:gap-6 mb-10 md:mb-14 max-w-3xl mx-auto">
      {[
        ['I.', 'Discipline'], ['II.', 'Niveau'], ['III.', 'Créneau'], ['IV.', 'Coordonnées']
      ].map(([n, l], i) => (
        <li class="flex-1 flex flex-col items-center text-center stepper-item" data-i={i}>
          <span class={`w-10 h-10 md:w-12 md:h-12 flex items-center justify-center font-italiana italic text-lg md:text-xl mb-2 ${i===0 ? 'bg-vermeille-bordeaux text-vermeille-ivoire' : 'ring-1 ring-vermeille-or/40 text-vermeille-or'}`}>{n}</span>
          <span class="font-inter-tight text-[10px] uppercase tracking-[0.25em] text-vermeille-ivoire/70">{l}</span>
        </li>
      ))}
    </ol>

    <form class="max-w-3xl mx-auto bg-vermeille-charbon ring-1 ring-vermeille-or/20 p-8 md:p-12" onsubmit="event.preventDefault();" novalidate>
      <!-- Étape 1 : Discipline -->
      <fieldset class="space-y-5">
        <legend class="font-italiana italic text-2xl md:text-3xl text-vermeille-or mb-4">I. Quelle discipline ?</legend>
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3">
          {data.disciplines.map(d => (
            <label class="cursor-pointer">
              <input type="radio" name="discipline" value={d.id} class="peer sr-only"/>
              <span class="block p-4 ring-1 ring-vermeille-or/25 peer-checked:ring-vermeille-or peer-checked:bg-vermeille-bordeaux/30 transition-colors">
                <span class="font-italiana italic text-xl">{d.nom}</span>
                <span class="block font-inter-tight text-[10px] uppercase tracking-[0.25em] mt-1 text-vermeille-ivoire/60">{d.niveaux}</span>
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <hr class="my-10 border-vermeille-or/15"/>

      <!-- Étape 2 : Niveau -->
      <fieldset class="space-y-5">
        <legend class="font-italiana italic text-2xl md:text-3xl text-vermeille-or mb-4">II. Quel niveau ?</legend>
        <div class="grid grid-cols-3 gap-3">
          {['Débutant','Intermédiaire','Avancé'].map(n => (
            <label class="cursor-pointer">
              <input type="radio" name="niveau" value={n} class="peer sr-only"/>
              <span class="block px-3 py-4 text-center ring-1 ring-vermeille-or/25 peer-checked:ring-vermeille-or peer-checked:bg-vermeille-bordeaux/30 font-italiana italic text-base md:text-lg">{n}</span>
            </label>
          ))}
        </div>
      </fieldset>

      <hr class="my-10 border-vermeille-or/15"/>

      <!-- Étape 3 : Créneau -->
      <fieldset class="space-y-5">
        <legend class="font-italiana italic text-2xl md:text-3xl text-vermeille-or mb-4">III. Quel créneau ?</legend>
        <select name="creneau" class="w-full h-12 px-4 bg-vermeille-velours/60 ring-1 ring-vermeille-or/25 font-inter-tight text-vermeille-ivoire">
          <option>Sélectionner un créneau —</option>
          <option>Lundi 17h30 — Modern jazz</option>
          <option>Mardi 17h — Classique débutant</option>
          <option>Mercredi 14h — Classique enfants</option>
          <option>Jeudi 19h — Contemporain</option>
          <option>Samedi 14h — Hip-hop ados</option>
          <option>Autre / à voir avec l'école</option>
        </select>
      </fieldset>

      <hr class="my-10 border-vermeille-or/15"/>

      <!-- Étape 4 : Coordonnées -->
      <fieldset class="space-y-5">
        <legend class="font-italiana italic text-2xl md:text-3xl text-vermeille-or mb-4">IV. Vos coordonnées</legend>
        <div class="grid sm:grid-cols-2 gap-4">
          <label class="block">
            <span class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-ivoire/60">Prénom</span>
            <input type="text" name="prenom" class="mt-1 w-full h-12 px-4 bg-vermeille-velours/60 ring-1 ring-vermeille-or/25 font-inter-tight text-vermeille-ivoire" />
          </label>
          <label class="block">
            <span class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-ivoire/60">Nom</span>
            <input type="text" name="nom" class="mt-1 w-full h-12 px-4 bg-vermeille-velours/60 ring-1 ring-vermeille-or/25 font-inter-tight text-vermeille-ivoire" />
          </label>
          <label class="block">
            <span class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-ivoire/60">Email</span>
            <input type="email" name="email" class="mt-1 w-full h-12 px-4 bg-vermeille-velours/60 ring-1 ring-vermeille-or/25 font-inter-tight text-vermeille-ivoire" />
          </label>
          <label class="block">
            <span class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-ivoire/60">Téléphone</span>
            <input type="tel" name="tel" class="mt-1 w-full h-12 px-4 bg-vermeille-velours/60 ring-1 ring-vermeille-or/25 font-inter-tight text-vermeille-ivoire" />
          </label>
        </div>
      </fieldset>

      <button type="submit" class="mt-10 w-full h-14 bg-vermeille-bordeaux text-vermeille-ivoire font-italiana text-lg tracking-wide hover:bg-vermeille-or hover:text-vermeille-velours transition-colors">
        Envoyer ma demande d'inscription →
      </button>
      <p class="mt-4 text-center font-inter-tight text-xs text-vermeille-ivoire/50 italic">
        Démonstration — formulaire non fonctionnel sur ce template.
      </p>
    </form>
  </div>
</section>
