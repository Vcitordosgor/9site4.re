---
/**
 * Disciplines — 5 cartes verticales hautes type AFFICHE de spectacle.
 * Photo portrait haute (3:4), nom serif italienne énorme, niveau, créneaux.
 * Layout : grid responsive avec hauteurs alternées qui décalent légèrement
 * (effet poster mural). PAS de cards horizontales équiangles.
 */
import data from '../../../data/templates/vermeille.json';
---

<section id="disciplines" class="bg-vermeille-ivoire py-24 md:py-36 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <!-- Header éditorial -->
    <header class="mb-16 md:mb-24 text-center max-w-2xl mx-auto">
      <p class="font-inter-tight text-[10px] uppercase tracking-[0.4em] text-vermeille-bordeaux mb-6">
        Les disciplines
      </p>
      <h2 class="font-italiana text-vermeille-velours leading-[1.0]" style="font-size: clamp(44px, 6vw, 80px);">
        Cinq langages,
        <span class="block italic text-vermeille-bordeaux">une même scène.</span>
      </h2>
      <div class="mt-8 flex items-center justify-center gap-3" aria-hidden="true">
        <span class="block h-px w-12 bg-vermeille-or/40"></span>
        <span class="text-vermeille-or text-sm">✦</span>
        <span class="block h-px w-12 bg-vermeille-or/40"></span>
      </div>
    </header>

    <!-- Grid de cartes affiches -->
    <ul class="grid grid-cols-2 lg:grid-cols-5 gap-x-4 md:gap-x-6 gap-y-12 md:gap-y-16">
      {data.disciplines.map((d, i) => (
        <li class:list={['group relative', i % 2 === 1 ? 'lg:mt-12' : '']}>
          <a href="#inscription" class="block">

            <!-- Carte discipline : composition CSS vermeille avec icône SVG par discipline -->
            <div class:list={[
              'relative aspect-[3/4] overflow-hidden flex flex-col items-center justify-center p-6 md:p-8',
              'bg-gradient-to-br from-vermeille-velours via-vermeille-velours to-vermeille-bordeaux',
            ]}>
              <!-- Texture pointillée subtile -->
              <div class="absolute inset-0 opacity-[0.12]" aria-hidden="true"
                   style="background-image: radial-gradient(circle at 1px 1px, #F5E6C8 1px, transparent 0); background-size: 14px 14px;"></div>

              <!-- Cadre intérieur or -->
              <div class="absolute inset-3 border border-vermeille-or/30" aria-hidden="true"></div>

              <!-- Numéro romain en haut -->
              <span class="absolute top-5 left-6 font-italiana italic text-vermeille-ivoire/80 text-2xl md:text-3xl">
                {d.numero}
              </span>
              <span class="absolute top-5 right-6 text-vermeille-or text-xl" aria-hidden="true">✦</span>

              <!-- Icône SVG centrale par discipline -->
              <svg class="relative w-24 md:w-28 h-24 md:h-28 text-vermeille-or" viewBox="0 0 100 100" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {d.id === 'classique' && (
                  <g>
                    {/* Pointe de chausson : ruban et arabesque */}
                    <path d="M50 12 C 56 25 62 38 60 52 C 58 64 50 72 50 80"/>
                    <path d="M50 12 C 44 25 38 38 40 52 C 42 64 50 72 50 80"/>
                    <ellipse cx="50" cy="84" rx="14" ry="5"/>
                    <path d="M36 84 C 32 88 28 92 25 95" opacity="0.7"/>
                    <path d="M64 84 C 68 88 72 92 75 95" opacity="0.7"/>
                  </g>
                )}
                {d.id === 'contemporain' && (
                  <g>
                    {/* Silhouette fluide */}
                    <path d="M28 22 C 38 18 50 24 56 34 C 62 44 58 56 50 62 C 42 68 32 76 38 86"/>
                    <circle cx="62" cy="20" r="6"/>
                    <path d="M60 26 C 70 32 78 44 76 58 C 74 70 64 80 52 82"/>
                  </g>
                )}
                {d.id === 'jazz' && (
                  <g>
                    {/* Chapeau jazz + étoile */}
                    <ellipse cx="50" cy="58" rx="32" ry="6"/>
                    <path d="M30 58 L 34 30 C 35 26 40 24 50 24 C 60 24 65 26 66 30 L 70 58"/>
                    <path d="M30 58 L 70 58"/>
                    <path d="M50 70 L 52 78 L 60 78 L 54 84 L 56 92 L 50 87 L 44 92 L 46 84 L 40 78 L 48 78 Z"/>
                  </g>
                )}
                {d.id === 'hip-hop' && (
                  <g>
                    {/* Casquette + boombox stylisé */}
                    <path d="M20 50 L 80 50 L 76 38 C 74 32 66 28 50 28 C 34 28 26 32 24 38 Z"/>
                    <path d="M20 50 L 88 50 L 88 56 L 20 56 Z"/>
                    <circle cx="36" cy="74" r="8"/>
                    <circle cx="64" cy="74" r="8"/>
                    <rect x="46" y="68" width="8" height="12"/>
                  </g>
                )}
                {d.id === 'modern' && (
                  <g>
                    {/* Spirale lyrique */}
                    <path d="M50 50 m -28 0 a 28 28 0 1 1 56 0 a 22 22 0 1 1 -44 0 a 16 16 0 1 1 32 0 a 10 10 0 1 1 -20 0"/>
                    <circle cx="50" cy="50" r="3" fill="currentColor"/>
                  </g>
                )}
              </svg>

              <!-- Nom de la discipline en grand -->
              <span class="relative mt-5 font-italiana italic text-vermeille-ivoire text-center leading-none" style="font-size: clamp(20px, 2.2vw, 28px);">
                {d.nom}
              </span>
            </div>

            <!-- Nom -->
            <h3 class="mt-5 font-italiana text-vermeille-velours leading-[1.0] group-hover:text-vermeille-bordeaux transition-colors duration-500" style="font-size: clamp(28px, 3.5vw, 44px);">
              {d.nom}
            </h3>

            <!-- Niveau -->
            <p class="mt-2 font-inter-tight text-[10px] uppercase tracking-[0.25em] text-vermeille-bordeaux">
              {d.niveaux}
            </p>

            <!-- Description -->
            <p class="mt-3 font-inter-tight text-vermeille-velours/65 text-[13px] leading-[1.65]">
              {d.description}
            </p>

            <!-- Créneaux discret -->
            <p class="mt-4 pt-3 border-t border-vermeille-velours/15 font-italiana italic text-vermeille-velours/55 text-[13px] leading-relaxed">
              {d.creneaux}
            </p>
          </a>
        </li>
      ))}
    </ul>

  </div>
</section>
