---
/**
 * Disciplines — carousel horizontal des 5 disciplines.
 * Chaque card change la couleur d'accent au scroll-snap.
 */
import data from '../../../data/templates/vermeille.json';
const accents = {
  'classique':    { bg: '#7A1A2A', fg: '#F8F0E5', tag: 'Bordeaux' },
  'contemporain': { bg: '#1A0F12', fg: '#B8956A', tag: 'Velours' },
  'jazz':         { bg: '#B8956A', fg: '#1A0F12', tag: 'Or' },
  'hip-hop':      { bg: '#2A1F22', fg: '#E8C4C0', tag: 'Charbon' },
  'modern':       { bg: '#E8C4C0', fg: '#7A1A2A', tag: 'Rose' },
};
---

<section id="disciplines" class="relative bg-vermeille-ivoire text-vermeille-velours py-24 md:py-32 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12 mb-14 md:mb-20">
    <div class="flex items-baseline justify-between gap-6 flex-wrap">
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ I — Le répertoire</p>
        <h2 class="font-italiana text-vermeille-velours leading-[0.95] tracking-tight" style="font-size: clamp(56px, 9vw, 132px);">
          Cinq langages,<br/><em class="italic text-vermeille-bordeaux">une même</em> scène.
        </h2>
      </div>
      <p class="font-inter-tight text-sm md:text-base text-vermeille-velours/70 max-w-sm leading-relaxed">
        Du classique au hip-hop, en passant par le contemporain, le jazz et le modern jazz. Chaque discipline a sa scène, son vocabulaire, ses créneaux.
      </p>
    </div>
  </div>

  <!-- Carousel animé : auto-advance + flèches + dots -->
  <div class="relative" data-disciplines-carousel>
    <!-- Flèches navigation desktop -->
    <button type="button" data-prev aria-label="Discipline précédente" class="hidden md:inline-flex absolute left-2 lg:left-6 top-1/2 -translate-y-1/2 z-20 items-center justify-center w-12 h-12 rounded-full bg-vermeille-velours text-vermeille-ivoire hover:bg-vermeille-bordeaux transition-colors shadow-lg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button type="button" data-next aria-label="Discipline suivante" class="hidden md:inline-flex absolute right-2 lg:right-6 top-1/2 -translate-y-1/2 z-20 items-center justify-center w-12 h-12 rounded-full bg-vermeille-velours text-vermeille-ivoire hover:bg-vermeille-bordeaux transition-colors shadow-lg">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="w-5 h-5"><path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <div data-track class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-6 px-6 md:px-12 scroll-smooth no-scrollbar">
      {data.disciplines.map((d, i) => {
        const a = accents[d.id] || accents.classique;
        return (
          <article
            data-slide={i}
            class="snap-start shrink-0 w-[80vw] md:w-[440px] aspect-[3/4] relative overflow-hidden discipline-card group cursor-pointer transition-transform duration-500"
            style={`background:${a.bg}; color:${a.fg};`}
          >
            <!-- Filet doré bordure -->
            <div class="absolute inset-3 ring-1 ring-current/15 pointer-events-none"></div>
            <!-- Texture diagonale subtile pour éviter l'effet "case noire" sur les cartes sombres -->
            <div class="absolute inset-0 pointer-events-none opacity-[0.06]" style="background-image: repeating-linear-gradient(135deg, currentColor 0 1px, transparent 1px 14px);"></div>
            <!-- Silhouette danseuse en filigrane -->
            <svg viewBox="0 0 100 200" class="absolute right-4 top-6 h-1/2 w-auto opacity-[0.12] pointer-events-none" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true">
              <circle cx="50" cy="22" r="8" />
              <path d="M50 30 Q54 70 60 110 Q70 150 78 180" />
              <path d="M52 50 Q70 30 90 18" />
              <path d="M48 48 Q26 26 8 14" />
              <path d="M60 110 Q42 130 14 130" />
              <path d="M78 180 L86 196 L70 196 Z" fill="currentColor" />
            </svg>
            <!-- Numéro géant en fond -->
            <span class="absolute -bottom-10 -right-4 font-italiana italic leading-none opacity-[0.10]" style="font-size: clamp(220px,32vw,360px);">{d.numero}</span>

            <div class="relative h-full flex flex-col p-7 md:p-9">
              <div class="flex items-center justify-between font-inter-tight text-[10px] uppercase tracking-[0.35em] opacity-70">
                <span>Discipline {d.numero}</span>
                <span>{a.tag}</span>
              </div>
              <div class="mt-auto">
                <h3 class="font-italiana italic leading-[0.9] tracking-tight" style="font-size: clamp(56px,7vw,88px);">{d.nom}</h3>
                <p class="mt-3 font-inter-tight text-xs uppercase tracking-[0.25em] opacity-80">{d.niveaux}</p>
                <p class="mt-5 font-inter-tight text-sm leading-relaxed max-w-[36ch] opacity-85">{d.description}</p>
                <div class="mt-6 pt-5 border-t border-current/20 flex items-center justify-between font-inter-tight text-xs">
                  <span class="opacity-70 max-w-[60%]">{d.creneaux}</span>
                  <a href="#planning" class="inline-flex items-center gap-1 underline underline-offset-4 hover:gap-2 transition-all">Planning →</a>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

    <!-- Dots indicateurs -->
    <div class="flex items-center justify-center gap-3 mt-6 mb-4" data-dots>
      {data.disciplines.map((_, i) => (
        <button type="button" data-dot={i} aria-label={`Aller à la discipline ${i + 1}`} class="w-2.5 h-2.5 rounded-full bg-vermeille-velours/25 hover:bg-vermeille-velours transition-colors data-[active=true]:bg-vermeille-bordeaux data-[active=true]:w-8" />
      ))}
    </div>
  </div>

  <style>
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { scrollbar-width: none; }
    [data-disciplines-carousel] [data-slide] { opacity: 0.55; filter: saturate(0.7); }
    [data-disciplines-carousel] [data-slide][data-active="true"] { opacity: 1; filter: none; transform: scale(1.02); }
  </style>

  <script is:inline>
    (() => {
      const root = document.querySelector('[data-disciplines-carousel]');
      if (!root) return;
      const track = root.querySelector('[data-track]');
      const slides = Array.from(root.querySelectorAll('[data-slide]'));
      const dots = Array.from(root.querySelectorAll('[data-dot]'));
      const prev = root.querySelector('[data-prev]');
      const next = root.querySelector('[data-next]');
      let active = 0;
      let timer = null;
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const scrollTo = (i) => {
        active = (i + slides.length) % slides.length;
        const el = slides[active];
        const left = el.offsetLeft - (track.clientWidth - el.clientWidth) / 2;
        track.scrollTo({ left, behavior: 'smooth' });
        slides.forEach((s, k) => s.dataset.active = String(k === active));
        dots.forEach((d, k) => d.dataset.active = String(k === active));
      };

      prev?.addEventListener('click', () => { scrollTo(active - 1); restart(); });
      next?.addEventListener('click', () => { scrollTo(active + 1); restart(); });
      dots.forEach((d, k) => d.addEventListener('click', () => { scrollTo(k); restart(); }));

      const tick = () => scrollTo(active + 1);
      const start = () => { if (reduce) return; timer = setInterval(tick, 4500); };
      const stop = () => { if (timer) clearInterval(timer); timer = null; };
      const restart = () => { stop(); start(); };

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      track.addEventListener('touchstart', stop, { passive: true });
      track.addEventListener('touchend', () => setTimeout(start, 1500), { passive: true });

      // Sync active on user scroll
      let scrollT;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollT);
        scrollT = setTimeout(() => {
          const center = track.scrollLeft + track.clientWidth / 2;
          let best = 0, bestDist = Infinity;
          slides.forEach((s, k) => {
            const c = s.offsetLeft + s.clientWidth / 2;
            const dist = Math.abs(c - center);
            if (dist < bestDist) { bestDist = dist; best = k; }
          });
          if (best !== active) {
            active = best;
            slides.forEach((s, k) => s.dataset.active = String(k === active));
            dots.forEach((d, k) => d.dataset.active = String(k === active));
          }
        }, 80);
      }, { passive: true });

      scrollTo(0);
      start();
    })();
  </script>
</section>
