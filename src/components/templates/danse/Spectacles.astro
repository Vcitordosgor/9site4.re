---
import data from '../../../data/templates/vermeille.json';
---
<section class="relative bg-vermeille-velours text-vermeille-ivoire py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-12 flex items-baseline justify-between flex-wrap gap-4">
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ IX — La saison</p>
        <h2 class="font-italiana italic leading-[0.95]" style="font-size: clamp(48px, 7vw, 104px);">Quatre rendez-vous.</h2>
      </div>
    </div>
    <ol class="space-y-px bg-vermeille-or/20">
      {data.spectacles.map((s, i) => (
        <li class="bg-vermeille-velours grid grid-cols-12 gap-4 px-6 md:px-10 py-7 md:py-9 items-baseline group hover:bg-vermeille-charbon transition-colors">
          <span class="col-span-12 md:col-span-1 font-italiana italic text-vermeille-or text-xl">{String(i+1).padStart(2,'0')}.</span>
          <span class="col-span-6 md:col-span-2 font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or/80">{s.date}</span>
          <h3 class="col-span-12 md:col-span-4 font-italiana italic text-vermeille-ivoire text-2xl md:text-3xl leading-tight">{s.titre}</h3>
          <p class="col-span-12 md:col-span-5 font-inter-tight text-sm text-vermeille-ivoire/70 leading-relaxed">{s.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
