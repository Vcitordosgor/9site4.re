---
import data from '../../../data/templates/vermeille.json';
---
<footer class="relative bg-vermeille-velours text-vermeille-ivoire pt-20 pb-12 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <!-- Phrase signature XXL italique -->
    <p class="font-italiana italic text-vermeille-or leading-[0.95] mb-16" style="font-size: clamp(56px,11vw,180px);">
      Vermeille.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-14 pt-10 border-t border-vermeille-or/20">
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or mb-3">Le studio</p>
        <p class="font-italiana italic text-lg leading-tight">{data.info.adresseLigne1}<br/>{data.info.adresseLigne2}</p>
      </div>
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or mb-3">Contact</p>
        <a href={`tel:${data.info.telephoneHref}`} class="block font-italiana italic text-lg hover:text-vermeille-or">{data.info.telephone}</a>
        <a href={`mailto:${data.info.email}`} class="block font-inter-tight text-sm text-vermeille-ivoire/70 mt-1 hover:text-vermeille-or break-all">{data.info.email}</a>
      </div>
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or mb-3">Accueil</p>
        <ul class="space-y-1 font-inter-tight text-sm text-vermeille-ivoire/75">
          {data.horairesAccueil.map(h => (
            <li class="flex justify-between gap-3 max-w-[200px]"><span>{h.jour}</span><span class="italic">{h.label}</span></li>
          ))}
        </ul>
      </div>
      <div>
        <p class="font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or mb-3">Suivre</p>
        <p class="font-italiana italic text-lg">{data.info.instagram}</p>
        <p class="font-inter-tight text-xs text-vermeille-ivoire/55 mt-2">{data.info.siret}</p>
      </div>
    </div>
    <div class="pt-8 border-t border-vermeille-or/15 flex flex-wrap items-center justify-between gap-3 font-inter-tight text-[11px] uppercase tracking-[0.25em] text-vermeille-ivoire/50">
      <span>© {data.info.nom} {data.info.annee} — {new Date().getFullYear()}</span>
      <span class="italic font-italiana normal-case tracking-normal text-vermeille-or/80 text-base">{data.info.tagline}</span>
    </div>
  </div>
</footer>
