---
const etapes = [
  { num: '01', titre: 'L\'essai', delai: 'Sept.', texte: 'Un cours d\'essai offert dans n\'importe quelle discipline. Vous arrivez en tenue confortable, on vous prête les chaussons.' },
  { num: '02', titre: 'L\'inscription', delai: 'Mi-sept.', texte: 'Si l\'essai vous a plu, on vous inscrit pour la saison. Trois paiements échelonnés, certificat médical à fournir sous quinze jours.' },
  { num: '03', titre: 'Les cours', delai: 'Sept. → mai', texte: 'Trente-deux semaines de cours hebdomadaires. Stages thématiques le samedi (deux par trimestre). Vacances scolaires intégralement fermées.' },
  { num: '04', titre: 'Le gala', delai: 'Juin', texte: 'Spectacle de fin d\'année sur la scène d\'un vrai théâtre. Costumes prêtés, répétition générale, photographe officiel.' },
];
---

<section class="bg-vermeille-ivoire py-20 md:py-32 relative">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-24">
      <p class="font-inter-tight uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-vermeille-bordeaux mb-4">— La saison, d'un coup d'œil —</p>
      <h2 class="font-italiana text-vermeille-velours text-4xl md:text-6xl leading-tight">
        Quatre temps, neuf mois,
        <span class="text-vermeille-bordeaux block">un gala.</span>
      </h2>
    </div>

    <ol class="relative grid grid-cols-1 md:grid-cols-4 gap-10 md:gap-0">
      <div class="hidden md:block absolute top-12 left-[12%] right-[12%] h-px bg-vermeille-or/40" aria-hidden="true"></div>

      {etapes.map((e) => (
        <li class="relative text-center md:px-4">
          <div class="relative inline-flex items-center justify-center w-24 h-24 rounded-full bg-vermeille-ivoire border-2 border-vermeille-or hover:border-vermeille-bordeaux hover:shadow-lg transition-all duration-300 mb-6">
            <span class="font-italiana text-vermeille-velours text-3xl leading-none">{e.num}</span>
          </div>
          <p class="font-inter-tight uppercase tracking-[0.3em] text-[10px] text-vermeille-bordeaux mb-2">{e.delai}</p>
          <h3 class="font-italiana text-vermeille-velours text-2xl md:text-[26px] mb-3">{e.titre}</h3>
          <p class="font-inter-tight text-[14.5px] text-vermeille-velours/80 leading-relaxed max-w-xs mx-auto">{e.texte}</p>
        </li>
      ))}
    </ol>

    <p class="mt-14 text-center font-caveat text-vermeille-bordeaux text-2xl md:text-3xl transform -rotate-1">
      — Et la deuxième saison commence en septembre suivant.
    </p>
  </div>
</section>
