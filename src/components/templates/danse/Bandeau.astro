---
import data from '../../../data/templates/vermeille.json';
---

<section aria-label="Inscriptions" class="bg-vermeille-bordeaux text-vermeille-ivoire py-6 md:py-7">
  <div class="max-w-content mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
    <div class="flex items-center gap-3">
      <span class="font-italiana text-2xl md:text-3xl text-vermeille-ivoire leading-none">Saison {data.info.saison}</span>
      <span class="hidden md:inline font-inter-tight text-[11px] uppercase tracking-[0.3em] text-vermeille-rose">cours d'essai gratuit · 1 séance</span>
    </div>
    <p class="font-italiana italic text-vermeille-ivoire text-base md:text-lg text-center">
      Le rideau ne se lève qu'avec vous.
    </p>
    <a
      href={`https://wa.me/${data.info.whatsapp}`}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center justify-center h-11 px-6 bg-vermeille-or text-vermeille-velours font-inter-tight font-semibold text-[11.5px] uppercase tracking-[0.22em] rounded-full hover:bg-vermeille-ivoire transition-colors"
    >
      Cours d'essai
    </a>
  </div>
</section>
