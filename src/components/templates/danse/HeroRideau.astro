---
/**
 * HeroRideau — hero éditorial sans photo.
 * Mot géant qui transitionne (Danser → Bouger → Vivre) avec SVG silhouette danseuse.
 */
import data from '../../../data/templates/vermeille.json';
const mots = ['Danser', 'Bouger', 'Vivre'];
---

<section id="top" class="relative bg-vermeille-velours text-vermeille-ivoire min-h-[100svh] overflow-hidden">

  <!-- Fond : gradient vermeille + grain + halo or -->
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 70% 30%, rgba(184,149,106,0.18) 0%, transparent 60%), radial-gradient(ellipse 60% 80% at 20% 80%, rgba(122,26,42,0.25) 0%, transparent 60%);"></div>
    <div class="absolute inset-0 opacity-[0.06] mix-blend-overlay" style="background-image: radial-gradient(#F8F0E5 1px, transparent 1px); background-size: 3px 3px;"></div>
  </div>

  <!-- Filets dorés latéraux -->
  <div class="absolute top-0 bottom-0 left-6 md:left-10 w-px bg-gradient-to-b from-transparent via-vermeille-or/30 to-transparent" aria-hidden="true"></div>
  <div class="absolute top-0 bottom-0 right-6 md:right-10 w-px bg-gradient-to-b from-transparent via-vermeille-or/30 to-transparent" aria-hidden="true"></div>

  <!-- SVG silhouette danseuse — à droite, géant, dorée -->
  <svg class="absolute right-0 top-1/2 -translate-y-1/2 h-[110vh] w-auto opacity-[0.12] pointer-events-none hidden md:block" viewBox="0 0 400 800" fill="none" aria-hidden="true" style="filter: blur(0.5px);">
    <g stroke="#B8956A" stroke-width="2.5" stroke-linecap="round" fill="none">
      <!-- tête -->
      <circle cx="200" cy="100" r="32" />
      <!-- corps arqué -->
      <path d="M200 132 Q210 220 230 320 Q260 420 290 480" />
      <!-- bras levés -->
      <path d="M210 200 Q260 140 320 80" />
      <path d="M195 195 Q150 140 100 95" />
      <!-- jambe appui -->
      <path d="M290 480 Q300 580 290 700" />
      <!-- jambe relevée arabesque -->
      <path d="M260 420 Q200 460 100 470" />
      <!-- pied pointe -->
      <path d="M285 700 L295 720 L280 720 Z" fill="#B8956A" />
    </g>
  </svg>

  <!-- Contenu hero -->
  <div class="relative max-w-content mx-auto px-10 md:px-16 pt-32 pb-20 md:pt-40 min-h-[100svh] flex flex-col">

    <!-- Saison -->
    <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or text-center md:text-left mb-10 md:mb-12 flex items-center gap-3 justify-center md:justify-start">
      <span class="font-italiana text-base normal-case tracking-normal italic">Vol. XVII</span>
      <span class="text-vermeille-or/40">·</span>
      <span>Saison {data.info.saison}</span>
    </p>

    <!-- Mot rotatif géant -->
    <div class="flex-1 flex flex-col justify-center">
      <p class="font-caveat text-vermeille-rose text-2xl md:text-3xl mb-4 -rotate-2 origin-left" aria-hidden="true">
        Cette saison, vous allez…
      </p>
      <div class="relative h-[clamp(96px,18vw,260px)] overflow-hidden" aria-label="Danser, Bouger, Vivre">
        {mots.map((m, i) => (
          <h1
            class="absolute inset-0 font-italiana italic text-vermeille-ivoire leading-[0.92] tracking-tight word-rotate"
            data-i={i}
            style={`font-size: clamp(88px, 17vw, 260px); animation-delay: ${i * 2.4}s;`}
          >{m}.</h1>
        ))}
      </div>
      <p class="mt-8 md:mt-10 max-w-xl font-inter-tight text-vermeille-ivoire/80 text-lg md:text-xl leading-relaxed">
        École de danse à {data.info.ville}. Cinq langages, une même scène — du classique au hip-hop, de 6 à 77 ans.
      </p>
    </div>

    <!-- Bas : CTA + scroll cue -->
    <div class="mt-auto pt-14 flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <div class="flex flex-wrap items-center gap-3">
        <a href="#inscription" class="inline-flex items-center gap-3 h-13 px-7 bg-vermeille-bordeaux text-vermeille-ivoire font-italiana text-lg tracking-wide hover:translate-y-[-2px] transition-transform">
          S'inscrire à la saison
          <span class="text-vermeille-or">→</span>
        </a>
        <a href="#disciplines" class="inline-flex items-center gap-3 h-13 px-6 ring-1 ring-vermeille-or/40 text-vermeille-ivoire font-inter-tight text-sm uppercase tracking-[0.2em] hover:bg-vermeille-or/10 transition-colors">
          Voir les disciplines
        </a>
      </div>
      <div class="flex items-center gap-4 text-vermeille-or/70 font-inter-tight text-xs uppercase tracking-[0.3em]">
        <span class="block w-12 h-px bg-vermeille-or/40"></span>
        <span>{data.info.tagline}</span>
      </div>
    </div>
  </div>

  <style>
    .word-rotate { opacity: 0; animation: vermeilleRotate 7.2s infinite; }
    @keyframes vermeilleRotate {
      0%, 5% { opacity: 0; transform: translateY(40px); }
      10%, 30% { opacity: 1; transform: translateY(0); }
      35%, 100% { opacity: 0; transform: translateY(-40px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .word-rotate { animation: none; opacity: 1; transform: none; }
      .word-rotate[data-i="1"], .word-rotate[data-i="2"] { display: none; }
    }
  </style>
</section>
