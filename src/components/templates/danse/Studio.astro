---
/**
 * Studio — carte signature du lieu avec mesures et caractéristiques.
 */
const specs = [
  { v: '200', u: 'm²', label: 'Surface totale' },
  { v: '12', u: 'm', label: 'Miroirs muraux' },
  { v: '4,2', u: 'm', label: 'Hauteur sous plafond' },
  { v: '24', u: '', label: 'Vestiaires individuels' },
];
const carac = [
  ['Parquet chêne massif sur lambourdes', 'Souplesse au saut, absence d\'écho.'],
  ['Barres modulables hauteur réglable', '40 cm de course, fixation murale + îlot central.'],
  ['Sonorisation Genelec studio', 'Deux retours plafond + sub. Aucun larsen.'],
  ['Climatisation discrète sans souffle', 'Maintien 22°C, aucune sensation d\'air froid.'],
];
---

<section id="studio" class="relative bg-vermeille-charbon text-vermeille-ivoire py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 60% 50% at 80% 20%, rgba(184,149,106,0.12) 0%, transparent 60%);"></div>
  </div>

  <div class="relative max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-10 md:gap-16">

    <!-- Col gauche : titre + intro -->
    <div class="lg:col-span-5">
      <p class="font-inter-tight text-[10px] uppercase tracking-[0.5em] text-vermeille-or mb-4">§ IV — Le lieu</p>
      <h2 class="font-italiana italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 7vw, 104px);">
        Notre studio,<br/>au cm près.
      </h2>
      <p class="mt-8 font-inter-tight text-vermeille-ivoire/75 leading-relaxed max-w-md">
        Un seul plateau, mais conçu autour du corps en mouvement. Aucun reflet parasite, aucune barre qui plie, aucun parquet qui grince à contretemps.
      </p>

      <!-- Carte plan stylisé SVG -->
      <div class="mt-10 relative aspect-[4/3] bg-vermeille-velours/60 ring-1 ring-vermeille-or/25 p-6">
        <svg viewBox="0 0 400 300" class="w-full h-full" aria-hidden="true">
          <!-- contour plateau -->
          <rect x="20" y="20" width="360" height="260" fill="none" stroke="#B8956A" stroke-width="1.5" stroke-dasharray="6 4"/>
          <!-- miroir mural -->
          <line x1="20" y1="20" x2="380" y2="20" stroke="#E8C4C0" stroke-width="3"/>
          <!-- barres -->
          <line x1="40" y1="50" x2="160" y2="50" stroke="#B8956A" stroke-width="2"/>
          <line x1="240" y1="50" x2="360" y2="50" stroke="#B8956A" stroke-width="2"/>
          <!-- îlot central -->
          <line x1="160" y1="150" x2="240" y2="150" stroke="#B8956A" stroke-width="2"/>
          <!-- mesures -->
          <text x="200" y="14" text-anchor="middle" fill="#B8956A" font-family="serif" font-style="italic" font-size="11">— miroir 12 m —</text>
          <text x="14" y="155" text-anchor="middle" fill="#B8956A" font-family="serif" font-style="italic" font-size="11" transform="rotate(-90 14 155)">— 14 m —</text>
        </svg>
        <span class="absolute bottom-3 right-4 font-inter-tight text-[10px] uppercase tracking-[0.3em] text-vermeille-or/70">Plan indicatif</span>
      </div>
    </div>

    <!-- Col droite : stats + caractéristiques -->
    <div class="lg:col-span-7">
      <div class="grid grid-cols-2 gap-px bg-vermeille-or/20">
        {specs.map(s => (
          <div class="p-7 bg-vermeille-charbon">
            <p class="font-italiana leading-none text-vermeille-ivoire" style="font-size: clamp(56px,7vw,80px);">{s.v}<span class="font-italiana italic text-vermeille-or text-2xl ml-1">{s.u}</span></p>
            <p class="mt-3 font-inter-tight text-xs uppercase tracking-[0.25em] text-vermeille-ivoire/60">{s.label}</p>
          </div>
        ))}
      </div>

      <ul class="mt-10 divide-y divide-vermeille-or/15">
        {carac.map(([t, d]) => (
          <li class="py-5 flex gap-6 items-start">
            <span class="font-italiana italic text-vermeille-or text-xl mt-1 shrink-0">·</span>
            <div>
              <p class="font-italiana italic text-vermeille-ivoire text-xl md:text-2xl leading-tight">{t}</p>
              <p class="mt-1 font-inter-tight text-sm text-vermeille-ivoire/65">{d}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
