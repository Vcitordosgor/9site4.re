---
/**
 * PhotoPanorama — photo full-bleed 21/9 entre deux blocs textuels.
 * Format panoramique de carnet topo-guide, légende type Fig. X.
 */
---

<section aria-label="Panorama du gîte" class="bg-cap-papier py-6 md:py-10 px-0">
  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-cap-charbon">
      <img
        src="/images/gite/panorama.webp"
        srcset="/images/gite/panorama-640.webp 640w, /images/gite/panorama-1024.webp 1024w, /images/gite/panorama.webp 1800w"
        sizes="100vw"
        alt="Panorama de la chaîne montagneuse, lumière dorée sur les sommets"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
        width="1800" height="771"
      />
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-4 flex items-baseline justify-between gap-3 flex-wrap">
      <figcaption class="font-crimson-pro italic text-cap-terre text-sm md:text-base leading-relaxed">
        Fig. 3 — Panorama depuis la terrasse, juin, 6h42, brume matinale sur les sommets voisins.
      </figcaption>
      <span class="font-jetbrains text-[10px] uppercase tracking-[0.22em] text-cap-mousse">Orientation E·NE · 1 220 m</span>
    </div>
  </figure>
</section>
