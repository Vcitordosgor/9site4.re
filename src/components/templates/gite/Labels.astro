---
const labels = [
  { titre: 'Gîte de France', sous: '4 épis · classement 2023', emoji: '★★★★' },
  { titre: 'Refuge FFRP', sous: 'Étape officielle GR R1 / GR R2', emoji: 'GR' },
  { titre: 'Esprit Parc national', sous: 'Charte hébergement engagé', emoji: '◉' },
  { titre: 'Accueil Vélo', sous: 'Stationnement sécurisé · outillage', emoji: '⌾' },
];

const partenaires = [
  'Office de tourisme du Cirque',
  'Maison de la montagne',
  'Parc national des Hauts',
  'Fédération de randonnée péi',
  'Réseau Vélo Liberté',
  'Camp de base biouac',
];
---

<section class="bg-cap-papier py-20 md:py-28 relative">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-18">
      <p class="font-jetbrains text-[10px] uppercase tracking-[0.28em] text-cap-mousse mb-4">— Labels & adhésions —</p>
      <h2 class="font-crimson italic text-cap-charbon text-4xl md:text-5xl leading-tight">
        Référencé par les bons réseaux.
      </h2>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 mb-16">
      {labels.map((l) => (
        <div class="bg-cap-papier border-2 border-cap-charbon/15 hover:border-cap-mousse/70 hover:shadow-md transition-all duration-300 p-5 md:p-7 text-center">
          <div class="font-crimson text-cap-mousse text-2xl md:text-3xl mb-3">{l.emoji}</div>
          <p class="font-bricolage font-semibold text-cap-charbon text-[14px] md:text-[15px] leading-snug mb-2">{l.titre}</p>
          <p class="font-jetbrains text-[10px] uppercase tracking-[0.18em] text-cap-terre/85">{l.sous}</p>
        </div>
      ))}
    </div>

    <div class="border-t border-cap-charbon/15 pt-12">
      <p class="font-jetbrains text-[10px] uppercase tracking-[0.28em] text-cap-terre text-center mb-8">— Partenaires & réseaux —</p>
      <ul class="flex flex-wrap justify-center items-center gap-x-8 gap-y-5">
        {partenaires.map((p) => (
          <li class="font-crimson italic text-cap-pierre text-lg md:text-xl tracking-tight hover:text-cap-mousse transition-colors">
            {p}
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
