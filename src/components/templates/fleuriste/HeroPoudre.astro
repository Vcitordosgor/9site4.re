---
/**
 * HeroPoudre — Wordmark Cormorant italique XXL pastel poudré + photo
 * bouquet éditorial à droite, plage généreuse.
 */
import data from '../../../data/templates/frangipane.json';
---

<section id="top" class="relative overflow-hidden" style="background-color: #F4E6E0;">
  <div class="max-w-content mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-16 md:pb-24 relative">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-center">

      <!-- Bloc texte gauche -->
      <div class="md:col-span-6">
        <p class="font-jakarta text-[11px] md:text-[12px] uppercase tracking-[0.45em]" style="color: #C49B62;">
          <span class="inline-block w-8 h-px mr-3 align-middle" style="background-color: #C49B62;"></span>
          Atelier floral éditorial · depuis {data.info.annee}
        </p>

        <h1 class="mt-7 font-cormorant leading-[0.92]" style="color: #2A2520; font-size: clamp(72px, 10vw, 152px); font-weight: 400; letter-spacing: -0.02em;">
          <em class="italic" style="color: #2A2520;">Frangipane</em>
          <span class="block font-jakarta text-base md:text-lg uppercase tracking-[0.3em] mt-4" style="color: #C49B62; font-weight: 600;">
            ∼ atelier floral ∼
          </span>
        </h1>

        <p class="mt-8 md:mt-10 font-cormorant italic text-2xl md:text-3xl leading-snug" style="color: #5C7448;">
          {data.info.tagline}
        </p>

        <p class="mt-5 font-jakarta text-[15px] md:text-[16px] leading-relaxed max-w-md" style="color: rgba(42, 37, 32, 0.78);">
          On compose avec ce que la saison donne. Anthuriums, frangipaniers, pivoines créoles, fougères des Hauts — la flore péi mise en bouquets éditoriaux.
        </p>

        <!-- CTAs -->
        <div class="mt-9 flex flex-col sm:flex-row items-start gap-3">
          <a
            href="#compositions"
            class="inline-flex items-center justify-center h-12 px-7 font-jakarta font-semibold text-[12.5px] uppercase tracking-[0.2em] rounded-full transition-opacity hover:opacity-90"
            style="background-color: #2A2520; color: #F4E6E0;"
          >
            Voir les compositions
          </a>
          <a
            href="#mariage"
            class="inline-flex items-center justify-center h-12 px-7 font-jakarta font-semibold text-[12.5px] uppercase tracking-[0.2em] rounded-full border-2 transition-colors duration-300"
            style="background-color: transparent; color: #2A2520; border-color: #2A2520;"
          >
            Projet mariage
          </a>
        </div>

        <!-- Stats discrètes -->
        <div class="mt-12 grid grid-cols-3 gap-4 pt-6 border-t" style="border-color: rgba(196, 155, 98, 0.4);">
          <div>
            <p class="font-cormorant italic text-3xl md:text-4xl leading-none" style="color: #5C7448;">7 ans</p>
            <p class="mt-1 font-jakarta text-[10.5px] uppercase tracking-[0.2em]" style="color: rgba(42, 37, 32, 0.65);">D'atelier</p>
          </div>
          <div>
            <p class="font-cormorant italic text-3xl md:text-4xl leading-none" style="color: #5C7448;">85</p>
            <p class="mt-1 font-jakarta text-[10.5px] uppercase tracking-[0.2em]" style="color: rgba(42, 37, 32, 0.65);">Mariages composés</p>
          </div>
          <div>
            <p class="font-cormorant italic text-3xl md:text-4xl leading-none" style="color: #5C7448;">Mardi</p>
            <p class="mt-1 font-jakarta text-[10.5px] uppercase tracking-[0.2em]" style="color: rgba(42, 37, 32, 0.65);">Bouquet renouvelé</p>
          </div>
        </div>
      </div>

      <!-- Photo droite -->
      <div class="md:col-span-6 relative">
        <div class="aspect-[4/5] overflow-hidden" style="border-radius: 4px;">
          <img
            src={data.info.photoHero}
            alt={data.info.photoHeroAlt}
            class="w-full h-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!-- Annotation manuscrite -->
        <div class="absolute -bottom-5 -left-5 md:-bottom-8 md:-left-8 max-w-[280px] p-5 md:p-7" style="background-color: #2A2520; color: #F4E6E0;">
          <p class="font-cormorant italic text-xl md:text-2xl leading-tight" style="color: #C49B62;">
            « La saison décide. »
          </p>
          <p class="mt-2 font-jakarta text-[10.5px] uppercase tracking-[0.25em]" style="color: rgba(244, 230, 224, 0.7);">
            — Inès, fleuriste
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
