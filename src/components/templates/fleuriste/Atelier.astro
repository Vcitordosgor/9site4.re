---
import data from '../../../data/templates/frangipane.json';
---

<section id="atelier" class="py-20 md:py-28 relative" style="background-color: #F4E6E0;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">

      <div class="md:col-span-5">
        <p class="font-jakarta text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #C49B62;">— L'atelier —</p>
        <h2 class="font-cormorant leading-[0.95]" style="color: #2A2520; font-size: clamp(40px, 6vw, 64px); font-weight: 400;">
          {data.atelier.titre}
          <em class="block italic text-lg mt-3" style="color: #5C7448; font-size: clamp(18px, 2.2vw, 24px);">
            {data.atelier.tagline}
          </em>
        </h2>

        <p class="mt-7 font-jakarta text-[15px] leading-relaxed" style="color: rgba(42, 37, 32, 0.82);">
          {data.atelier.texte}
        </p>

        <a
          href={`tel:${data.info.telephoneHref}`}
          class="mt-8 inline-flex items-center justify-center h-12 px-7 font-jakarta font-semibold text-[12.5px] uppercase tracking-[0.2em] rounded-full transition-opacity hover:opacity-90"
          style="background-color: #2A2520; color: #F4E6E0;"
        >
          Prendre rendez-vous
        </a>
      </div>

      <div class="md:col-span-7">
        <p class="font-jakarta text-[10.5px] uppercase tracking-[0.3em] mb-5" style="color: #C49B62;">Ateliers découverte</p>
        <div class="space-y-4">
          {data.ateliers.map((a) => (
            <article class="p-7 md:p-8" style="background-color: #FFFFFF; border: 1px solid rgba(196, 155, 98, 0.35);">
              <div class="flex flex-col md:flex-row md:items-baseline md:justify-between gap-2 mb-3">
                <h3 class="font-cormorant text-2xl md:text-[28px] leading-tight" style="color: #2A2520; font-weight: 500;">
                  {a.titre}
                </h3>
                <p class="font-cormorant italic text-2xl md:text-3xl" style="color: #5C7448;">
                  {a.prix}
                </p>
              </div>

              <div class="grid grid-cols-2 gap-3 mt-4 py-3 border-y" style="border-color: rgba(196, 155, 98, 0.25);">
                <div>
                  <p class="font-jakarta text-[10px] uppercase tracking-[0.2em]" style="color: #C49B62;">Durée</p>
                  <p class="font-cormorant italic text-lg" style="color: #2A2520;">{a.duree}</p>
                </div>
                <div>
                  <p class="font-jakarta text-[10px] uppercase tracking-[0.2em]" style="color: #C49B62;">Quand</p>
                  <p class="font-cormorant italic text-lg" style="color: #2A2520;">{a.quand}</p>
                </div>
              </div>

              <p class="mt-3 font-jakarta text-[14px] leading-relaxed" style="color: rgba(42, 37, 32, 0.82);">
                {a.details}
              </p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
