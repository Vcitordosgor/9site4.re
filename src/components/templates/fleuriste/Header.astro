---
import data from '../../../data/templates/frangipane.json';
const nav = [
  { href: '#petales', label: 'Compositions' },
  { href: '#atelier', label: 'Atelier' },
  { href: '#saison', label: 'Calendrier' },
  { href: '#livraison', label: 'Livraison' },
];
---
<header id="fl-header" data-scrolled="false" class="sticky top-0 z-50 transition-all duration-500 border-b"
  style="background:rgba(251,243,238,0.96); border-color:rgba(42,37,32,0.10);">
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="#top" class="flex items-baseline gap-2.5" aria-label="Frangipane">
      <svg viewBox="0 0 32 32" class="w-8 h-8" aria-hidden="true">
        <g transform="translate(16 16)">
          {[0,60,120,180,240,300].map(a => (<ellipse cx="6" cy="0" rx="6" ry="3" fill="#F4E6E0" stroke="#C49B62" stroke-width="0.5" transform={`rotate(${a})`}/>))}
          <circle r="2" fill="#C49B62"/>
        </g>
      </svg>
      <span class="font-cormorant italic text-2xl md:text-3xl" style="color:#2A2520;">Frangipane</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[12px] uppercase tracking-[0.20em] font-medium" aria-label="Navigation">
      {nav.map(n => <a href={n.href} class="hover:opacity-60 transition-opacity" style="color:#2A2520;">{n.label}</a>)}
    </nav>
    <a href="#contact" class="hidden md:inline-flex items-center h-10 px-5 text-[12px] uppercase tracking-[0.16em] font-semibold transition-colors" style="background:#2A2520; color:#FBF3EE;">Commander</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-10 px-4 text-[11px] uppercase tracking-wider font-semibold" style="background:#2A2520; color:#FBF3EE;">Appeler</a>
  </div>
</header>
<script>
  const h = document.getElementById('fl-header');
  if (h) { const u = () => { h.dataset.scrolled = String(window.scrollY > 8); }; u(); window.addEventListener('scroll', u, { passive: true }); }
</script>
