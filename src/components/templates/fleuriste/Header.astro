---
import data from '../../../data/templates/frangipane.json';

const navLinks = [
  { href: '#compositions', label: 'Compositions' },
  { href: '#saison', label: 'Saison' },
  { href: '#mariage', label: 'Mariage' },
  { href: '#galerie', label: 'Galerie' },
];
---

<header
  id="frangipane-header"
  data-scrolled="false"
  class="sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500"
  style="border-bottom: 1px solid rgba(42, 37, 32, 0.10);"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">

    <a href="#top" class="flex items-center gap-3 group" aria-label="Frangipane — accueil">
      <!-- Picto fleur frangipane stylisée -->
      <svg viewBox="0 0 32 32" class="w-7 h-7" aria-hidden="true">
        <g>
          <ellipse cx="16" cy="9" rx="3.5" ry="6" fill="#C49B62"/>
          <ellipse cx="22" cy="13" rx="3.5" ry="6" transform="rotate(60 22 13)" fill="#C49B62"/>
          <ellipse cx="22" cy="19" rx="3.5" ry="6" transform="rotate(120 22 19)" fill="#C49B62"/>
          <ellipse cx="16" cy="23" rx="3.5" ry="6" transform="rotate(180 16 23)" fill="#C49B62"/>
          <ellipse cx="10" cy="19" rx="3.5" ry="6" transform="rotate(240 10 19)" fill="#C49B62"/>
          <ellipse cx="10" cy="13" rx="3.5" ry="6" transform="rotate(300 10 13)" fill="#C49B62"/>
          <circle cx="16" cy="16" r="2" fill="#F4E6E0"/>
        </g>
      </svg>
      <div class="flex flex-col leading-none">
        <span class="font-cormorant italic font-medium text-xl md:text-2xl" style="color: #2A2520;">Frangipane</span>
        <span class="font-jakarta text-[10.5px] md:text-[11px] uppercase tracking-[0.22em] -mt-0.5" style="color: #C49B62;">atelier floral</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-9 font-jakarta text-[12.5px] uppercase tracking-[0.18em] font-medium" aria-label="Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors duration-300 hover:opacity-70" style="color: #2A2520;">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="hidden md:inline-flex items-center justify-center h-10 px-5 font-jakarta font-semibold text-[12px] uppercase tracking-[0.18em] rounded-full transition-opacity hover:opacity-90"
      style="background-color: #5C7448; color: #F4E6E0;"
    >
      Prendre rendez-vous
    </a>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="md:hidden inline-flex items-center justify-center h-11 px-4 font-jakarta font-semibold text-[12px] uppercase tracking-wider rounded-full"
      style="background-color: #5C7448; color: #F4E6E0;"
      aria-label="Appeler"
    >
      Appeler
    </a>
  </div>
</header>

<style>
  #frangipane-header {
    background-color: rgb(244 230 224 / 0.96);
  }
  #frangipane-header[data-scrolled='true'] {
    background-color: rgb(244 230 224 / 0.97);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 1px 3px rgb(42 37 32 / 0.08);
  }
</style>

<script>
  const header = document.getElementById('frangipane-header');
  if (header) {
    const update = () => { header.dataset.scrolled = String(window.scrollY > 8); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
