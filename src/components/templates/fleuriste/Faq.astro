---
const faqs = [
  { q: 'Combien de temps tiennent les fleurs ?', r: 'Bouquet de saison : 5 à 7 jours dans des conditions normales. Coupe quotidienne et changement d\'eau prolongent — fiche d\'entretien fournie.' },
  { q: 'Peut-on choisir des fleurs précises ?', r: 'Sur les compositions de mariage et d\'événementiel, oui. Sur les bouquets du moment, la cueillette du jour décide — mais on prend en compte vos couleurs préférées.' },
  { q: 'Vous faites du local ?', r: 'Autant que possible : anthuriums et héliconias du nord, roses des Hauts, hibiscus et frangipane d\'opportunité. Le reste vient de Hollande via une plateforme certifiée.' },
  { q: 'Délai pour un mariage ?', r: 'Idéalement 6 mois à l\'avance. Pour les last-minute (moins de 3 mois), on étudie, on accepte selon nos plannings — sans surcharge tarifaire.' },
  { q: 'Acceptez-vous les CB ?', r: 'Oui, dès 1€. Paiement en ligne via lien sécurisé pour les commandes à distance. Espèces bienvenues à l\'atelier.' },
];
---
<section class="py-24 md:py-32" style="background:#F4E6E0;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <p class="font-cormorant italic text-2xl mb-2" style="color:#5C7448;">vos questions —</p>
    <h2 class="font-cormorant text-5xl md:text-6xl leading-tight mb-12" style="color:#2A2520;">FAQ <em class="italic" style="color:#C49B62;">florale.</em></h2>
    <div class="max-w-3xl divide-y" style="border-color:rgba(42,37,32,0.20);">
      {faqs.map(f => (
        <details class="group py-6">
          <summary class="cursor-pointer flex justify-between gap-4 font-cormorant text-xl md:text-2xl" style="color:#2A2520;">
            {f.q}<span class="font-cormorant italic text-3xl transition-transform group-open:rotate-45" style="color:#C49B62;">+</span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed" style="color:#5A4F45;">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>details + details { border-top:1px solid rgba(42,37,32,0.20); }</style>
