---
import data from '../../../data/templates/frangipane.json';
---

<footer style="background-color: #2A2520; color: #F4E6E0;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 32 32" class="w-9 h-9" aria-hidden="true">
            <g>
              <ellipse cx="16" cy="9" rx="3.5" ry="6" fill="#C49B62"/>
              <ellipse cx="22" cy="13" rx="3.5" ry="6" transform="rotate(60 22 13)" fill="#C49B62"/>
              <ellipse cx="22" cy="19" rx="3.5" ry="6" transform="rotate(120 22 19)" fill="#C49B62"/>
              <ellipse cx="16" cy="23" rx="3.5" ry="6" transform="rotate(180 16 23)" fill="#C49B62"/>
              <ellipse cx="10" cy="19" rx="3.5" ry="6" transform="rotate(240 10 19)" fill="#C49B62"/>
              <ellipse cx="10" cy="13" rx="3.5" ry="6" transform="rotate(300 10 13)" fill="#C49B62"/>
              <circle cx="16" cy="16" r="2" fill="#2A2520"/>
            </g>
          </svg>
          <div class="leading-none">
            <p class="font-cormorant italic text-3xl" style="font-weight: 500;">Frangipane</p>
            <p class="font-jakarta text-[10.5px] uppercase tracking-[0.22em] mt-1" style="color: #C49B62;">atelier floral</p>
          </div>
        </div>
        <p class="mt-5 font-jakarta text-[14px] leading-relaxed max-w-sm" style="color: rgba(244, 230, 224, 0.8);">
          {data.info.tagline} — Atelier floral éditorial à La Réunion depuis {data.info.annee}.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-jakarta text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #C49B62;">L'atelier</p>
        <ul class="space-y-2 font-jakarta text-[13.5px]">
          <li><a href="#compositions" class="transition-colors hover:opacity-80">Compositions</a></li>
          <li><a href="#saison" class="transition-colors hover:opacity-80">Saison du moment</a></li>
          <li><a href="#mariage" class="transition-colors hover:opacity-80">Mariage</a></li>
          <li><a href="#galerie" class="transition-colors hover:opacity-80">Galerie</a></li>
          <li><a href="#atelier" class="transition-colors hover:opacity-80">Visiter</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-jakarta text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #C49B62;">Contact</p>
        <ul class="space-y-2 font-jakarta text-[13.5px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="transition-colors hover:opacity-80">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="transition-colors hover:opacity-80 break-all">{data.info.email}</a></li>
          <li style="color: rgba(244, 230, 224, 0.7);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-jakarta text-[11px]" style="border-color: rgba(196, 155, 98, 0.3); color: rgba(244, 230, 224, 0.65);">
      <p>© {data.info.annee}–2026 {data.info.nom} · SIRET …{data.info.siret.slice(-5)}</p>
      <p class="font-cormorant italic text-2xl leading-none" style="color: #C49B62;">{data.info.tagline}</p>
    </div>
  </div>
</footer>
