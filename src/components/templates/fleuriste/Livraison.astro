---
import data from '../../../data/templates/frangipane.json';
const zones = [
  { zone: 'Atelier (retrait)', delai: 'Le jour même', prix: 'Gratuit' },
  { zone: 'Côte ouest', delai: '2h', prix: '8€' },
  { zone: 'Saint-Denis & Nord', delai: '2-3h', prix: '12€' },
  { zone: 'Sud & Est', delai: '24h', prix: '15€' },
  { zone: 'Hauts', delai: '24h', prix: '20€' },
];
---
<section id="livraison" class="py-24 md:py-32" style="background:#FBF3EE;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-2 gap-12 lg:gap-20">
    <div>
      <p class="font-cormorant italic text-2xl mb-2" style="color:#5C7448;">livraison —</p>
      <h2 class="font-cormorant text-5xl md:text-6xl leading-tight mb-6" style="color:#2A2520;">Partout sur <em class="italic" style="color:#C49B62;">l'île.</em></h2>
      <p class="text-lg leading-relaxed mb-5" style="color:#5A4F45;">
        Nous livrons à La Réunion 6 jours sur 7. Commande passée avant 11h : livraison le jour même sur la côte ouest. Hors zone ou hors créneau : devis express.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={`tel:${data.info.telephoneHref}`} class="inline-flex items-center h-12 px-7 text-[12px] uppercase tracking-[0.22em] font-semibold" style="background:#2A2520; color:#FBF3EE;">Appeler · {data.info.telephone}</a>
        <a href={`mailto:${data.info.email}`} class="inline-flex items-center h-12 px-7 text-[12px] uppercase tracking-[0.22em] font-semibold border" style="border-color:#2A2520; color:#2A2520;">Email</a>
      </div>
    </div>
    <table class="w-full text-left">
      <thead>
        <tr class="text-[11px] uppercase tracking-[0.22em]" style="color:#5C7448;">
          <th class="py-3">Zone</th><th class="py-3">Délai</th><th class="py-3 text-right">Tarif</th>
        </tr>
      </thead>
      <tbody style="color:#2A2520;">
        {zones.map(z => (
          <tr class="border-t" style="border-color:rgba(42,37,32,0.15);">
            <td class="py-4 font-cormorant italic text-xl">{z.zone}</td>
            <td class="py-4 text-[14px]">{z.delai}</td>
            <td class="py-4 text-right font-cormorant text-xl" style="color:#C49B62;">{z.prix}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
