---
const photos = [
  '/images/fleuriste/extra-1.webp',
  '/images/fleuriste/bouquet.webp',
  '/images/fleuriste/extra-3.webp',
  '/images/fleuriste/extra-4.webp',
  '/images/fleuriste/extra-5.webp',
  '/images/fleuriste/extra-6.webp',
];
---
<section class="py-24 md:py-32" style="background:#5C7448; color:#FBF3EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-2xl">
      <p class="font-cormorant italic text-2xl mb-2" style="color:#F4E6E0;">notre galerie —</p>
      <h2 class="font-cormorant text-5xl md:text-6xl leading-tight">Quelques compositions <em class="italic" style="color:#F4E6E0;">récentes.</em></h2>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-3 gap-3">
      {photos.map((p, i) => (
        <figure class={`overflow-hidden ${i === 0 || i === 4 ? 'md:row-span-2' : ''}`}>
          <img src={p} alt="" class={`w-full object-cover transition-transform duration-700 hover:scale-105 ${i === 0 || i === 4 ? 'h-full min-h-[480px]' : 'aspect-square'}`} loading="lazy"/>
        </figure>
      ))}
    </div>
  </div>
</section>
