---
const saisons = [
  { mois: 'Jan-Mar', titre: 'Été austral', fleurs: ['Anthurium', 'Héliconia péi', 'Bougainvillier', 'Hibiscus', 'Frangipane'] },
  { mois: 'Avr-Juin', titre: 'Automne doux', fleurs: ['Rose locale', 'Strelitzia', 'Orchidée vanda', 'Gerbera', 'Eucalyptus'] },
  { mois: 'Juil-Sep', titre: 'Hiver austral', fleurs: ['Renoncule', 'Anémone', 'Pivoine import', 'Lisianthus', 'Branchage sec'] },
  { mois: 'Oct-Déc', titre: 'Printemps', fleurs: ['Pivoine locale', 'Hortensia', 'Dahlia', 'Tournesol', 'Branche fleurie'] },
];
---
<section id="saison" class="py-24 md:py-32" style="background:#FBF3EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-2xl">
      <p class="font-cormorant italic text-2xl mb-2" style="color:#5C7448;">au fil de l'année —</p>
      <h2 class="font-cormorant text-5xl md:text-6xl leading-tight" style="color:#2A2520;">Calendrier <em class="italic" style="color:#C49B62;">saisonnier.</em></h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 fl-saison-grid">
      {saisons.map((s, i) => (
        <article class="fl-saison-card relative p-6 border-2 transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_18px_36px_-18px_rgba(42,37,32,0.35)]" style={`background:#F4E6E0; border-color:#C49B62; border-radius:8px; --i:${i};`}>
          <!-- Tige qui pousse en haut de la card -->
          <svg aria-hidden="true" class="fl-stem absolute -top-px left-6 right-6 h-8 overflow-visible" viewBox="0 0 100 32" preserveAspectRatio="none">
            <path class="fl-stem-path" d="M50 32 C 48 22 54 14 50 4" fill="none" stroke="#5C7448" stroke-width="1.6" stroke-linecap="round"/>
            <circle class="fl-stem-bud" cx="50" cy="4" r="3" fill="#C49B62"/>
          </svg>
          <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#5C7448;">{s.mois}</div>
          <h3 class="font-cormorant text-2xl mb-4" style="color:#2A2520;">{s.titre}</h3>
          <ul class="space-y-1.5 text-[14px]" style="color:#5A4F45;">
            {s.fleurs.map(f => <li class="flex items-baseline gap-2"><span class="w-1 h-1 rounded-full" style="background:#C49B62;"></span><em class="font-cormorant italic text-lg" style="color:#2A2520;">{f}</em></li>)}
          </ul>
        </article>
      ))}
    </div>
  </div>

  <style>
    .fl-saison-card .fl-stem-path {
      stroke-dasharray: 40;
      stroke-dashoffset: 40;
      transition: stroke-dashoffset 1400ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i) * 180ms);
    }
    .fl-saison-card .fl-stem-bud {
      opacity: 0; transform: scale(0); transform-origin: 50% 4px;
      transition: opacity 500ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--i) * 180ms + 1100ms);
    }
    .fl-saison-grid.is-in .fl-stem-path { stroke-dashoffset: 0; }
    .fl-saison-grid.is-in .fl-stem-bud  { opacity: 1; transform: scale(1); }
    @media (prefers-reduced-motion: reduce) {
      .fl-saison-card .fl-stem-path { stroke-dashoffset: 0; transition: none; }
      .fl-saison-card .fl-stem-bud  { opacity: 1; transform: scale(1); transition: none; }
    }
  </style>
  <script>
    (() => {
      const grid = document.querySelector('#saison .fl-saison-grid');
      if (!grid) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { grid.classList.add('is-in'); io.disconnect(); } });
      }, { threshold: 0.2 });
      io.observe(grid);
    })();
  </script>
</section>
