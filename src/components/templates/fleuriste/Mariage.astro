---
import data from '../../../data/templates/frangipane.json';
---

<section id="mariage" class="py-20 md:py-28 relative" style="background-color: #F4E6E0;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-jakarta text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #C49B62;">— Mariage & événementiel —</p>
      <h2 class="font-cormorant leading-[0.95]" style="color: #2A2520; font-size: clamp(40px, 6vw, 72px); font-weight: 400;">
        {data.mariage.titre}
        <em class="block italic mt-2" style="color: #5C7448;">{data.mariage.soustitre}.</em>
      </h2>
      <p class="mt-5 font-jakarta text-[15px] leading-relaxed" style="color: rgba(42, 37, 32, 0.78);">
        {data.mariage.texte}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6 max-w-6xl">
      {data.mariage.etapes.map((e) => (
        <article class="p-7 md:p-8" style="background-color: #FFFFFF; border-left: 3px solid #C49B62;">
          <p class="font-cormorant italic leading-none" style="color: #C49B62; font-size: clamp(40px, 5vw, 56px);">
            {e.label}
          </p>
          <h3 class="mt-3 font-cormorant text-2xl leading-tight" style="color: #2A2520; font-weight: 500;">
            {e.titre}
          </h3>
          <p class="mt-3 font-jakarta text-[14px] leading-relaxed" style="color: rgba(42, 37, 32, 0.82);">
            {e.texte}
          </p>
        </article>
      ))}
    </div>

    <!-- Bio fondatrice -->
    <div class="mt-14 md:mt-20 p-7 md:p-10" style="background-color: #2A2520; color: #F4E6E0;">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        <div class="md:col-span-7">
          <p class="font-jakarta text-[10.5px] uppercase tracking-[0.3em] mb-3" style="color: #C49B62;">— Inès, fleuriste —</p>
          <h3 class="font-cormorant leading-[0.95]" style="font-size: clamp(30px, 4vw, 48px); font-weight: 400;">
            <em class="italic">{data.fondatrice.nom}</em>
          </h3>
          <p class="mt-2 font-cormorant italic text-lg" style="color: #C49B62;">
            {data.fondatrice.titre}
          </p>
          <p class="mt-5 font-jakarta text-[14.5px] leading-relaxed" style="color: rgba(244, 230, 224, 0.85);">
            {data.fondatrice.bio}
          </p>
          <p class="mt-5 font-cormorant italic text-xl md:text-2xl leading-snug" style="color: #C49B62;">
            {data.fondatrice.credo}
          </p>
        </div>
        <div class="md:col-span-5">
          <p class="font-jakarta text-[10.5px] uppercase tracking-[0.3em] mb-4" style="color: #C49B62;">Formation</p>
          <ul class="space-y-2.5 font-jakarta text-[13.5px]">
            {data.fondatrice.certif.map((c) => (
              <li class="flex items-start gap-2.5">
                <span class="font-cormorant italic mt-0.5 leading-none text-base" style="color: #C49B62;">∼</span>
                <span>{c}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
