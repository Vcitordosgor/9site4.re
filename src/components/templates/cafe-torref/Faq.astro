---
import data from '../../../data/templates/brulerie.json';
const faqs = [
  { q: 'Pourquoi pas du café péi ?', r: 'Le Bourbon Pointu de Réunion est un café d\'exception qu\'on n\'a pas encore les volumes pour intégrer. On y travaille avec un producteur des Hauts pour 2027.' },
  { q: 'Grains ou moulu ?', r: 'Les deux. La mouture est faite à votre commande, ajustée à votre méthode (filtre, espresso, italienne…). À consommer dans les 14 jours pour le moulu.' },
  { q: 'Combien de temps se conserve un café torréfié ?', r: 'Optimal entre J+5 et J+45 après torréfaction (en grains, sac valvé fermé). On vend uniquement dans cette fenêtre — chaque sac est daté.' },
  { q: 'Peut-on venir à la brûlerie ?', r: 'Oui, sur RDV pour les visites individuelles, ou pendant les ateliers. La torréfaction se fait le lundi et le jeudi.' },
  { q: 'Vous fournissez les pros ?', r: 'Restaurants, hôtels, bureaux : oui. Tarifs dégressifs à partir de 5kg/mois. Demande par mail.' },
];
---
<section class="py-24 md:py-32" style="background:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">FAQ</div>
    <h2 class="font-instrument text-5xl md:text-6xl leading-tight mb-12" style="color:#1A0F0A;">Questions <em class="italic">fréquentes.</em></h2>
    <div class="max-w-3xl divide-y" style="border-color:rgba(26,15,10,0.20);">
      {faqs.map(f => (
        <details class="group py-6">
          <summary class="cursor-pointer flex justify-between gap-4 font-instrument text-xl md:text-2xl" style="color:#1A0F0A;">
            {f.q}<span class="font-instrument italic text-2xl transition-transform group-open:rotate-45" style="color:#B57A4A;">+</span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed" style="color:#3A2418;">{f.r}</p>
        </details>
      ))}
    </div>
    <p class="mt-10 text-[14px]" style="font-family:'DM Mono',monospace; color:#3A2418;">— Une autre question ? <a href={`mailto:${data.info.email}`} class="underline">{data.info.email}</a></p>
  </div>
</section>
<style>details + details { border-top:1px solid rgba(26,15,10,0.20); }</style>
