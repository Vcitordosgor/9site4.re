---
const origines = [
  { lot: '#01', pays: 'Éthiopie', region: 'Hauts plateaux du Sidamo', alt: '1 900 — 2 100 m', notes: 'floral · bergamote · jasmin', desc: 'Lavé, séchage sur lits africains. Acidité vive, corps moyen, finale longue.' },
  { lot: '#02', pays: 'Brésil', region: 'Cerrado Mineiro', alt: '1 100 — 1 250 m', notes: 'cacao · noisette · sucre brun', desc: 'Natural pulped. Le café réconfortant — rondeur, faible amertume, corps plein.' },
  { lot: '#03', pays: 'Colombie', region: 'Huila — sud Andes', alt: '1 600 — 1 800 m', notes: 'caramel · agrumes · pomme', desc: 'Lavé. L\'équilibre absolu : acidité juste, sucrosité claire, corps moyen.' },
  { lot: '#04', pays: 'Vietnam', region: 'Plateau de Đà Lạt', alt: '1 400 m', notes: 'cacao noir · épices · pin', desc: 'Arabica typica. Corps dense, amertume noble, idéal en filtre lent.' },
];
---
<section id="origines" class="py-24 md:py-32" style="background:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">Quatre origines</div>
      <h2 class="font-instrument text-5xl md:text-6xl leading-tight" style="color:#1A0F0A;">Le café n'est jamais <em class="italic">au hasard.</em></h2>
    </div>
    <div class="grid sm:grid-cols-2 gap-px" style="background:rgba(26,15,10,0.20);">
      {origines.map(o => (
        <article class="p-7 md:p-8" style="background:#E8DDC7;">
          <div class="flex items-baseline justify-between mb-3">
            <div class="text-[10px] uppercase tracking-[0.28em]" style="font-family:'DM Mono',monospace; color:#B57A4A;">LOT {o.lot}</div>
            <div class="text-[10px] uppercase tracking-[0.28em]" style="font-family:'DM Mono',monospace; color:#5C3A1E;">{o.alt}</div>
          </div>
          <h3 class="font-instrument text-3xl md:text-4xl leading-tight" style="color:#1A0F0A;">{o.pays}</h3>
          <div class="font-instrument italic text-lg mb-3" style="color:#3E2A1F;">{o.region}</div>
          <div class="text-[12px] uppercase tracking-[0.22em] mb-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">{o.notes}</div>
          <p class="text-[14px] leading-relaxed" style="color:#3A2418;">{o.desc}</p>
        </article>
      ))}
    </div>
  </div>
</section>
