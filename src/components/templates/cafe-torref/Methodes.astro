---
const courbes = [
  { num: '01', titre: 'Torréfaction lente', duree: '14 min', temp: '195°C max', desc: 'Pour les grains de haute altitude (Éthiopie, Colombie). Préserve l\'acidité, les notes florales, la complexité.', filtres: ['Filtre', 'V60', 'AeroPress', 'Cold brew'] },
  { num: '02', titre: 'Torréfaction moyenne', duree: '11 min', temp: '210°C max', desc: 'Pour les grains de plaine et les naturels (Brésil, Vietnam). Corps plein, amertume contrôlée, sucres caramélisés.', filtres: ['Espresso', 'Italienne', 'French press', 'Latte'] },
];
---
<section id="methodes" class="py-24 md:py-32" style="background:#1A0F0A; color:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">Méthodes de torréfaction</div>
      <h2 class="font-instrument text-5xl md:text-6xl leading-tight">Deux courbes, <em class="italic" style="color:#B57A4A;">jamais trois.</em></h2>
    </div>
    <div class="grid md:grid-cols-2 gap-6">
      {courbes.map(c => (
        <article class="p-8 md:p-10" style="background:#3E2A1F;">
          <div class="flex items-baseline justify-between mb-5">
            <div class="font-instrument italic text-5xl" style="color:#B57A4A;">{c.num}</div>
            <div class="font-mono text-right text-[11px] uppercase tracking-[0.22em]" style="font-family:'DM Mono',monospace; color:#D8C9A8;">{c.duree} · {c.temp}</div>
          </div>
          <h3 class="font-instrument text-3xl mb-3">{c.titre}</h3>
          <p class="text-[15px] leading-relaxed mb-6" style="color:#D8C9A8;">{c.desc}</p>
          <div class="text-[10px] uppercase tracking-[0.28em] mb-2" style="font-family:'DM Mono',monospace; color:#B57A4A;">Idéale en</div>
          <div class="flex flex-wrap gap-2">
            {c.filtres.map(f => <span class="px-3 py-1 text-[11px] border" style="font-family:'DM Mono',monospace; border-color:#B57A4A; color:#E8DDC7;">{f}</span>)}
          </div>
        </article>
      ))}
    </div>
    <div class="mt-12 grid sm:grid-cols-3 gap-3">
      <img src="/images/cafe-torref/extra-1.webp" alt="" class="aspect-[4/3] object-cover" loading="lazy"/>
      <img src="/images/cafe-torref/extra-2.webp" alt="" class="aspect-[4/3] object-cover" loading="lazy"/>
      <img src="/images/cafe-torref/extra-3.webp" alt="" class="aspect-[4/3] object-cover" loading="lazy"/>
    </div>
  </div>
</section>
