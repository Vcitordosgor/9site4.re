---
const courbes = [
  {
    num: '01',
    titre: 'Torréfaction lente',
    duree: '14 min',
    temp: '195°C',
    desc: 'Pour les grains de haute altitude (Éthiopie, Colombie). Préserve l\'acidité, les notes florales, la complexité.',
    filtres: ['Filtre', 'V60', 'Aeropress', 'Cold brew'],
    intensite: 35,
    acidite: 78,
    corps: 55,
    path: 'M0,160 C40,150 80,128 120,98 C160,72 200,52 260,42 C320,34 360,32 400,30',
    crackY: 75,
    dropY: 38,
  },
  {
    num: '02',
    titre: 'Torréfaction moyenne',
    duree: '11 min',
    temp: '210°C',
    desc: 'Pour les grains de plaine et naturels (Brésil, Vietnam). Corps plein, amertume contrôlée, sucres caramélisés.',
    filtres: ['Espresso', 'Italienne', 'French press', 'Latte'],
    intensite: 68,
    acidite: 42,
    corps: 82,
    path: 'M0,160 C30,148 60,118 100,82 C140,52 180,32 240,22 C300,14 360,12 400,10',
    crackY: 50,
    dropY: 18,
  },
];
const ticks = ['0 min', '4 min', '8 min', '12 min', 'Final'];
---
<section id="methodes" class="py-24 md:py-32" style="background:#1A0F0A; color:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">Méthodes de torréfaction</div>
      <h2 class="font-instrument text-5xl md:text-6xl leading-tight">Deux courbes, <em class="italic" style="color:#B57A4A;">jamais trois.</em></h2>
      <p class="mt-5 text-[16px] leading-relaxed" style="color:#D8C9A8;">Chaque grain réclame sa courbe. Pas de raccourci, pas de torréfaction « universelle » : on adapte la rampe de température au profil aromatique.</p>
    </div>

    <div class="grid lg:grid-cols-2 gap-6 cf-curves">
      {courbes.map(c => (
        <article class="cf-curve p-7 md:p-9 relative transition-all duration-500" style="background:#3E2A1F;">
          <div class="flex items-baseline justify-between mb-6">
            <div class="font-instrument italic text-6xl leading-none" style="color:#B57A4A;">{c.num}</div>
            <div class="text-right text-[11px] uppercase tracking-[0.22em]" style="font-family:'DM Mono',monospace; color:#D8C9A8;">{c.duree} · {c.temp} max</div>
          </div>
          <h3 class="font-instrument text-3xl md:text-4xl mb-3">{c.titre}</h3>
          <p class="text-[14px] leading-relaxed mb-6" style="color:#D8C9A8;">{c.desc}</p>

          <div class="mb-6" style="background:rgba(232,221,199,0.04); padding:14px 12px 8px;">
            <div class="flex justify-between text-[9px] uppercase tracking-[0.22em] mb-2" style="font-family:'DM Mono',monospace; color:#B57A4A;">
              <span>Température °C</span><span>Temps</span>
            </div>
            <svg viewBox="0 0 400 180" class="w-full h-auto" preserveAspectRatio="none" aria-label={`Courbe de ${c.titre}`}>
              <defs>
                <linearGradient id={`grad-${c.num}`} x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0%" stop-color="#B57A4A" stop-opacity="0.35"/>
                  <stop offset="100%" stop-color="#B57A4A" stop-opacity="0"/>
                </linearGradient>
              </defs>
              {[40, 80, 120].map(y => <line x1="0" y1={y} x2="400" y2={y} stroke="rgba(232,221,199,0.10)" stroke-dasharray="2 4"/>)}
              <path class="cf-curve-fill" d={`${c.path} L400,180 L0,180 Z`} fill={`url(#grad-${c.num})`}/>
              <path class="cf-curve-line" d={c.path} fill="none" stroke="#D4A574" stroke-width="2" stroke-linecap="round"/>
              <circle cx="200" cy={c.crackY} r="3" fill="#E8DDC7"/>
              <text x="208" y={c.crackY - 5} fill="#E8DDC7" font-size="9" font-family="DM Mono, monospace" letter-spacing="1">1er crack</text>
              <circle cx="320" cy={c.dropY} r="3" fill="#E8DDC7" opacity="0.55"/>
              <text x="328" y={c.dropY - 5} fill="#E8DDC7" opacity="0.55" font-size="9" font-family="DM Mono, monospace" letter-spacing="1">drop</text>
            </svg>
            <div class="flex justify-between text-[9px] mt-1" style="font-family:'DM Mono',monospace; color:#7A5C3F;">
              {ticks.map(t => <span>{t}</span>)}
            </div>
          </div>

          <div class="space-y-3 mb-6">
            {[
              { label: 'Intensité', v: c.intensite },
              { label: 'Acidité', v: c.acidite },
              { label: 'Corps', v: c.corps },
            ].map(b => (
              <div>
                <div class="flex justify-between text-[10px] uppercase tracking-[0.22em] mb-1" style="font-family:'DM Mono',monospace; color:#D8C9A8;">
                  <span>{b.label}</span><span style="color:#B57A4A;">{b.v}/100</span>
                </div>
                <div class="h-[3px]" style="background:rgba(232,221,199,0.12);">
                  <div class="h-full" style={`width:${b.v}%; background:#B57A4A;`}></div>
                </div>
              </div>
            ))}
          </div>

          <div class="text-[10px] uppercase tracking-[0.28em] mb-2" style="font-family:'DM Mono',monospace; color:#B57A4A;">Idéale en</div>
          <div class="flex flex-wrap gap-2">
            {c.filtres.map(f => <span class="px-3 py-1 text-[11px] border" style="font-family:'DM Mono',monospace; border-color:#B57A4A; color:#E8DDC7;">{f}</span>)}
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 grid sm:grid-cols-3 gap-3 cf-curves-end">
      <img src="/images/cafe-torref/extra-1.webp" alt="Grains verts" class="aspect-[4/3] object-cover" loading="lazy"/>
      <img src="/images/cafe-torref/extra-2.webp" alt="En cours de torréfaction" class="aspect-[4/3] object-cover" loading="lazy"/>
      <img src="/images/cafe-torref/extra-3.webp" alt="Grains torréfiés" class="aspect-[4/3] object-cover" loading="lazy"/>
    </div>
  </div>
</section>

<style>
  .cf-curve { will-change: transform; }
  .cf-curve .cf-curve-line {
    transition: stroke 0.5s ease, stroke-width 0.5s ease, filter 0.5s ease;
  }
  .cf-curve .cf-curve-fill { transition: opacity 0.5s ease; }

  .cf-curves:hover .cf-curve:not(:hover) {
    opacity: 0.55;
  }
  .cf-curves:hover .cf-curve:not(:hover) .cf-curve-line {
    stroke: #7A5C3F;
    stroke-width: 1.4;
  }
  .cf-curves:hover .cf-curve:not(:hover) .cf-curve-fill { opacity: 0.3; }

  .cf-curve:hover {
    transform: translateY(-2px);
  }
  .cf-curve:hover .cf-curve-line {
    stroke: #E8DDC7;
    stroke-width: 2.6;
    filter: drop-shadow(0 0 6px rgba(212,165,116,0.55));
  }

  @media (prefers-reduced-motion: reduce) {
    .cf-curve, .cf-curve .cf-curve-line, .cf-curve .cf-curve-fill { transition: none; }
    .cf-curve:hover { transform: none; }
  }
</style>
