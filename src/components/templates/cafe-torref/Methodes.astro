---
import data from '../../../data/templates/brulerie.json';
---

<section id="methodes" class="py-20 md:py-28 relative" style="background-color: #1A0F0A; color: #E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-dm-mono text-[10.5px] uppercase tracking-[0.4em] mb-4" style="color: #B57A4A;">— Méthodes d'extraction —</p>
      <h2 class="font-plex-serif font-semibold leading-[0.95]" style="font-size: clamp(36px, 5vw, 56px); font-family: 'IBM Plex Serif', Georgia, serif;">
        Quatre façons
        <em class="block italic mt-2" style="color: #B57A4A; font-size: clamp(40px, 5.5vw, 60px);">
          de tirer le grain.
        </em>
      </h2>
      <p class="mt-5 font-dm-mono text-[13.5px] leading-relaxed" style="color: rgba(232, 221, 199, 0.78);">
        Le café change radicalement selon la méthode. Voici les quatre qu'on pratique et qu'on enseigne.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {data.methodes.map((m, i) => (
        <article class="p-6 md:p-7" style="background-color: rgba(232, 221, 199, 0.05); border: 1px solid rgba(181, 122, 74, 0.3);">
          <p class="font-dm-mono text-[10px] uppercase tracking-[0.25em]" style="color: #B57A4A;">
            [ Méthode {String(i + 1).padStart(2, '0')} ]
          </p>
          <h3 class="mt-2 font-plex-serif font-semibold text-2xl md:text-3xl leading-tight" style="font-family: 'IBM Plex Serif', Georgia, serif;">
            {m.nom}
          </h3>

          <!-- Stats clés -->
          <div class="mt-5 pt-4 border-t space-y-2 font-dm-mono text-[11.5px]" style="border-color: rgba(181, 122, 74, 0.25);">
            <div class="flex justify-between gap-2">
              <span style="color: rgba(232, 221, 199, 0.55);">Temps</span>
              <span style="color: #E8DDC7;">{m.duree}</span>
            </div>
            <div class="flex justify-between gap-2">
              <span style="color: rgba(232, 221, 199, 0.55);">Ratio</span>
              <span style="color: #E8DDC7;">{m.ratio}</span>
            </div>
            <div class="flex justify-between gap-2">
              <span style="color: rgba(232, 221, 199, 0.55);">Mouture</span>
              <span class="text-right" style="color: #E8DDC7;">{m.moutureLabel}</span>
            </div>
          </div>

          <p class="mt-5 font-plex-serif text-[14.5px] leading-relaxed" style="color: rgba(232, 221, 199, 0.85); font-family: 'IBM Plex Serif', Georgia, serif;">
            {m.description}
          </p>
        </article>
      ))}
    </div>

    <!-- Matrice grains x méthodes : quelle méthode pour quel grain ? -->
    <div class="mt-16 md:mt-20">
      <div class="max-w-2xl mb-8">
        <p class="font-dm-mono text-[10.5px] uppercase tracking-[0.4em] mb-3" style="color: #B57A4A;">— Le bon match —</p>
        <h3 class="font-plex-serif font-semibold leading-tight" style="font-size: clamp(26px, 3.4vw, 38px); font-family: 'IBM Plex Serif', Georgia, serif;">
          Quelle méthode
          <em class="italic" style="color: #B57A4A;">pour quel grain&nbsp;?</em>
        </h3>
      </div>

      <div class="overflow-x-auto" style="border: 1px solid rgba(181,122,74,0.3);">
        <table class="w-full text-left font-dm-mono text-[12.5px]" style="background-color: rgba(232,221,199,0.04);">
          <thead>
            <tr style="background-color: rgba(181,122,74,0.18); color: #E8DDC7;">
              <th scope="col" class="px-4 py-3 font-semibold uppercase tracking-[0.2em] text-[10.5px]">Grain</th>
              <th scope="col" class="px-4 py-3 font-semibold uppercase tracking-[0.2em] text-[10.5px] text-center">Espresso</th>
              <th scope="col" class="px-4 py-3 font-semibold uppercase tracking-[0.2em] text-[10.5px] text-center">V60</th>
              <th scope="col" class="px-4 py-3 font-semibold uppercase tracking-[0.2em] text-[10.5px] text-center">Piston</th>
            </tr>
          </thead>
          <tbody style="color: rgba(232,221,199,0.85);">
            {[
              { grain: 'Robusta péi · torréf. foncée', e: 3, v: 1, p: 2 },
              { grain: 'Arabica péi · torréf. ambrée', e: 3, v: 3, p: 2 },
              { grain: 'Bourbon pointu · torréf. claire', e: 2, v: 3, p: 3 },
              { grain: 'Éthiopie altitude · torréf. claire', e: 1, v: 3, p: 2 },
            ].map((row, i) => {
              const dot = (n: number) => (
                <span class="inline-flex items-center gap-0.5" aria-label={`${n} sur 3`}>
                  {[1,2,3].map((k) => (
                    <span class="inline-block w-2 h-2 rounded-full" style={`background-color: ${k <= n ? '#B57A4A' : 'rgba(181,122,74,0.2)'};`}></span>
                  ))}
                </span>
              );
              return (
                <tr style={i > 0 ? 'border-top: 1px solid rgba(181,122,74,0.18);' : ''}>
                  <th scope="row" class="px-4 py-3 font-plex-serif font-semibold text-[14px]" style="color: #E8DDC7; font-family: 'IBM Plex Serif', Georgia, serif;">{row.grain}</th>
                  <td class="px-4 py-3 text-center">{dot(row.e)}</td>
                  <td class="px-4 py-3 text-center">{dot(row.v)}</td>
                  <td class="px-4 py-3 text-center">{dot(row.p)}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="mt-4 font-dm-mono text-[11px]" style="color: rgba(232,221,199,0.6);">
        ● ● ● parfait · ● ● convient · ● à éviter
      </p>
    </div>
  </div>
</section>
