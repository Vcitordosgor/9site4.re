---
const valeurs = [
  { num: '01', titre: 'Direct trade', texte: 'Achats directs producteur ou coopérative, sans intermédiaire spéculatif. Prix payés 30 % au-dessus du marché Fairtrade.' },
  { num: '02', titre: 'Micro-lots', texte: 'Sacs de 60 kg à 200 kg max par origine. Aucun mélange entre fermes. Traçabilité jusqu\'à la parcelle.' },
  { num: '03', titre: 'Certifié bio', texte: 'Trois origines sur quatre certifiées agriculture biologique. Le Vietnam est en conversion (label fin 2026).' },
  { num: '04', titre: 'Juste prix', texte: '14 € à 32 € le sachet de 250 g. Marge transparente, on l\'écrit sur chaque étiquette : torréfacteur, transport, café vert.' },
];
---
<section id="engagement" class="py-24 md:py-32" style="background:#3E2A1F; color:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="font-family:'DM Mono',monospace; color:#D4A574;">Nos engagements</div>
      <h2 class="font-instrument text-5xl md:text-6xl leading-tight">Le café, <em class="italic" style="color:#D4A574;">on le doit aux producteurs.</em></h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:rgba(232,221,199,0.12);">
      {valeurs.map(v => (
        <article class="p-7 md:p-8 transition-colors duration-300 hover:bg-[#1A0F0A]/40" style="background:#3E2A1F;">
          <div class="font-instrument italic text-5xl mb-4" style="color:#D4A574;">{v.num}</div>
          <h3 class="font-instrument text-2xl mb-3" style="color:#E8DDC7;">{v.titre}</h3>
          <p class="text-[14px] leading-relaxed" style="color:#D8C9A8;">{v.texte}</p>
        </article>
      ))}
    </div>
  </div>
</section>
