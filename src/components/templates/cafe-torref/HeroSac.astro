---
---
<section class="relative w-full" style="background:#1A0F0A;">
  <div class="relative h-[88vh] min-h-[600px] overflow-hidden">
    <img src="/images/cafe-torref/hero.webp" alt="Grains de café fraîchement torréfiés" class="absolute inset-0 w-full h-full object-cover opacity-80" fetchpriority="high"/>
    <div class="absolute inset-0" style="background:linear-gradient(120deg, rgba(26,15,10,0.62) 0%, rgba(26,15,10,0.22) 100%);"></div>

    <!-- Grain subtil -->
    <svg class="absolute inset-0 w-full h-full opacity-[0.07] pointer-events-none mix-blend-overlay" aria-hidden="true">
      <filter id="cf-hero-grain"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2"/></filter>
      <rect width="100%" height="100%" filter="url(#cf-hero-grain)"/>
    </svg>

    <!-- Signature : tasse à café + vapeur continue -->
    <div aria-hidden="true" class="cf-cup absolute right-6 md:right-14 bottom-12 md:bottom-16 z-10 w-[120px] md:w-[180px] pointer-events-none">
      <svg viewBox="0 0 160 220" class="w-full h-auto" role="img" aria-label="Tasse fumante">
        <!-- Vapeur (3 volutes en boucle continue) -->
        <g class="cf-steam" fill="none" stroke="#E8DDC7" stroke-width="2.4" stroke-linecap="round" opacity="0.85">
          <path class="cf-steam-1" d="M55 90 C50 70 70 60 60 40 C50 20 70 10 65 0"/>
          <path class="cf-steam-2" d="M80 90 C75 70 95 60 85 40 C75 20 95 10 90 0"/>
          <path class="cf-steam-3" d="M105 90 C100 70 120 60 110 40 C100 20 120 10 115 0"/>
        </g>
        <!-- Soucoupe -->
        <ellipse cx="80" cy="200" rx="68" ry="9" fill="#B57A4A" opacity="0.95"/>
        <ellipse cx="80" cy="198" rx="68" ry="8" fill="#D4A574"/>
        <!-- Tasse corps -->
        <path d="M30 100 L130 100 L120 180 Q120 192 108 192 L52 192 Q40 192 40 180 Z" fill="#E8DDC7" stroke="#1A0F0A" stroke-width="2"/>
        <!-- Anse -->
        <path d="M130 120 Q156 124 156 148 Q156 172 130 174" fill="none" stroke="#E8DDC7" stroke-width="7" stroke-linecap="round"/>
        <path d="M130 120 Q156 124 156 148 Q156 172 130 174" fill="none" stroke="#1A0F0A" stroke-width="2"/>
        <!-- Café -->
        <ellipse cx="80" cy="106" rx="46" ry="7" fill="#3E2A1F"/>
        <ellipse cx="80" cy="104" rx="44" ry="6" fill="#1A0F0A"/>
        <!-- Reflet crema -->
        <ellipse cx="68" cy="103" rx="14" ry="2" fill="#B57A4A" opacity="0.5"/>
      </svg>
    </div>

    <div class="absolute inset-0 flex items-center">
      <div class="max-w-content mx-auto w-full px-6 md:px-14 relative z-[5]">
        <div class="cf-kicker text-[10px] uppercase tracking-[0.32em] mb-5 inline-flex items-center gap-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">
          <span class="cf-kicker-dot inline-block w-1.5 h-1.5 rounded-full" style="background:#B57A4A;"></span>
          Lot · #2026/04 · torréfié il y a 6 jours
        </div>
        <h1 class="font-instrument text-6xl md:text-8xl leading-[0.95] max-w-3xl" style="color:#E8DDC7;">
          <em class="italic">Du grain vert</em><br/>au noir parfait,<br/><em class="italic" style="color:#B57A4A;">douze minutes.</em>
        </h1>
        <p class="mt-7 max-w-xl text-base md:text-lg leading-relaxed" style="color:#D8C9A8;">
          Brûlerie artisanale. Quatre origines, deux courbes de torréfaction, vente directe en grains et moulu. Tout est traçable au lot, daté au jour.
        </p>
        <div class="mt-9 flex flex-wrap gap-3">
          <a href="#abonnement" class="inline-flex items-center h-12 px-7 text-[11px] uppercase tracking-[0.22em] font-semibold transition-transform hover:-translate-y-0.5" style="font-family:'DM Mono',monospace; background:#B57A4A; color:#1A0F0A;">Abonnement café · 14€</a>
          <a href="#origines" class="inline-flex items-center h-12 px-7 text-[11px] uppercase tracking-[0.22em] font-semibold border transition-colors hover:bg-[#E8DDC7] hover:text-[#1A0F0A]" style="font-family:'DM Mono',monospace; border-color:#E8DDC7; color:#E8DDC7;">Voir les origines</a>
        </div>
      </div>
    </div>
  </div>

  <style>
    .cf-steam path { stroke-dasharray: 140; stroke-dashoffset: 140; transform-origin: 50% 100%; }
    .cf-steam-1 { animation: cf-steam-rise 4.2s ease-in-out infinite; }
    .cf-steam-2 { animation: cf-steam-rise 4.6s ease-in-out infinite 1.1s; }
    .cf-steam-3 { animation: cf-steam-rise 4.0s ease-in-out infinite 2.2s; }
    @keyframes cf-steam-rise {
      0%   { stroke-dashoffset: 140; opacity: 0; transform: translateY(0) scale(1); }
      15%  { opacity: 0.85; }
      55%  { stroke-dashoffset: 0;   opacity: 0.55; }
      100% { stroke-dashoffset: -40; opacity: 0;    transform: translateY(-14px) scale(1.05); }
    }
    .cf-kicker-dot { animation: cf-kicker-pulse 2.8s ease-in-out infinite; }
    @keyframes cf-kicker-pulse {
      0%, 100% { opacity: 0.4; transform: scale(1); }
      50%      { opacity: 1;   transform: scale(1.4); }
    }
    @media (prefers-reduced-motion: reduce) {
      .cf-steam-1, .cf-steam-2, .cf-steam-3, .cf-kicker-dot { animation: none; }
      .cf-steam path { stroke-dashoffset: 0; opacity: 0.5; }
    }
  </style>
</section>
