---
import data from '../../../data/templates/brulerie.json';
---

<section id="atelier" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10 relative">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">

      <div class="md:col-span-5">
        <p class="font-dm-mono text-[10.5px] uppercase tracking-[0.4em] mb-4" style="color: #B57A4A;">— L'atelier —</p>
        <h2 class="font-plex-serif font-semibold leading-[0.95]" style="color: #1A0F0A; font-size: clamp(36px, 5vw, 56px); font-family: 'IBM Plex Serif', Georgia, serif;">
          {data.atelier.titre}
          <em class="block italic mt-2" style="color: #B57A4A; font-size: clamp(40px, 5.5vw, 60px);">{data.atelier.soustitre}</em>
        </h2>

        <p class="mt-7 font-plex-serif text-[15.5px] leading-relaxed" style="color: rgba(26, 15, 10, 0.82); font-family: 'IBM Plex Serif', Georgia, serif;">
          {data.atelier.texte}
        </p>

        <div class="mt-9 p-6" style="background-color: #1A0F0A; color: #E8DDC7;">
          <p class="font-dm-mono text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #B57A4A;">[ Manifeste ]</p>
          <p class="font-plex-serif italic text-xl md:text-2xl leading-snug" style="font-family: 'IBM Plex Serif', Georgia, serif;">
            « {data.manifesto.split('.')[0]}. »
          </p>
        </div>
      </div>

      <div class="md:col-span-7">
        <div class="grid grid-cols-2 gap-3 md:gap-4">
          {data.atelier.stats.map((s) => (
            <div class="p-6 md:p-8 text-center" style="background-color: rgba(255, 255, 255, 0.5); border: 1px solid rgba(62, 42, 31, 0.2);">
              <p class="font-plex-serif font-semibold leading-none" style="color: #1A0F0A; font-size: clamp(28px, 4vw, 42px); font-family: 'IBM Plex Serif', Georgia, serif;">
                {s.valeur}
              </p>
              <p class="mt-3 font-dm-mono text-[10px] uppercase tracking-[0.25em]" style="color: #B57A4A;">
                {s.label}
              </p>
            </div>
          ))}
        </div>

        <!-- Carte café -->
        <div class="mt-6">
          <p class="font-dm-mono text-[10.5px] uppercase tracking-[0.3em] mb-3" style="color: #B57A4A;">— Au comptoir de l'atelier —</p>
          <ul class="divide-y" style="background-color: rgba(255, 255, 255, 0.5); border: 1px solid rgba(62, 42, 31, 0.2);">
            {data.carte.map((c) => (
              <li class="flex items-center gap-4 px-5 py-3.5" style="--tw-divide-opacity: 0.15;">
                <div class="flex-1 min-w-0">
                  <p class="font-plex-serif text-[15px] leading-tight" style="color: #1A0F0A; font-family: 'IBM Plex Serif', Georgia, serif;">
                    {c.nom}
                  </p>
                  <p class="font-plex-serif italic text-[13px] leading-tight" style="color: #B57A4A; font-family: 'IBM Plex Serif', Georgia, serif;">
                    {c.tagline}
                  </p>
                </div>
                <p class="font-dm-mono font-semibold text-[13.5px] whitespace-nowrap" style="color: #1A0F0A;">
                  {c.prix}
                </p>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
