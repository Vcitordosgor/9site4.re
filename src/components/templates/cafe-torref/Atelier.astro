---
const ateliers = [
  { code: 'WS-01', titre: 'Cupping découverte', duree: '2h', prix: '35€', desc: 'Dégustation horizontale des quatre origines, vocabulaire de notation SCA, fiche d\'analyse à emporter.' },
  { code: 'WS-02', titre: 'Filtre lent à la maison', duree: '2h', prix: '45€', desc: 'V60, Chemex, Kalita. Ratios, mouture, eau, temps. Repartez avec un sachet 250g du café de votre choix.' },
  { code: 'WS-03', titre: 'Espresso & lait', duree: '3h', prix: '65€', desc: 'Réglages machine, latte art basique, choix du grain. Pour propriétaires de machine ou pros en reconversion.' },
];
---
<section id="atelier" class="py-24 md:py-32" style="background:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-2 gap-12 lg:gap-20">
    <div>
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="font-family:'DM Mono',monospace; color:#B57A4A;">Atelier dégustation</div>
      <h2 class="font-instrument text-5xl md:text-6xl leading-tight mb-6" style="color:#1A0F0A;">Apprenez <em class="italic">à goûter.</em></h2>
      <p class="text-lg leading-relaxed mb-6" style="color:#3A2418;">
        Trois ateliers par mois, en petit groupe (6 participants max), dans notre brûlerie. Vous repartez avec un palais affiné, des sachets, et l'envie d'arrêter le café soluble.
      </p>
      <div class="overflow-hidden">
        <img src="/images/cafe-torref/extra-4.webp" alt="Atelier dégustation" class="w-full aspect-[5/4] object-cover" loading="lazy"/>
      </div>
    </div>
    <ul class="space-y-px" style="background:rgba(26,15,10,0.18);">
      {ateliers.map(a => (
        <li class="p-7" style="background:#E8DDC7;">
          <div class="flex items-baseline justify-between mb-2">
            <div class="text-[10px] uppercase tracking-[0.28em]" style="font-family:'DM Mono',monospace; color:#B57A4A;">{a.code} · {a.duree}</div>
            <div class="font-instrument italic text-2xl" style="color:#3E2A1F;">{a.prix}</div>
          </div>
          <h3 class="font-instrument text-2xl mb-2" style="color:#1A0F0A;">{a.titre}</h3>
          <p class="text-[14px] leading-relaxed" style="color:#3A2418;">{a.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
