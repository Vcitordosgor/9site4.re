---
import data from '../../../data/templates/brulerie.json';
const nav = [
  { href: '#origines', label: 'Origines' },
  { href: '#methodes', label: 'Torréfaction' },
  { href: '#atelier', label: 'Atelier' },
  { href: '#abonnement', label: 'Abonnement' },
];
---
<header id="cf-header" data-scrolled="false" class="sticky top-0 z-50 transition-all duration-500 border-b"
  style="background:rgba(232,221,199,0.96); border-color:rgba(26,15,10,0.15);">
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="#top" class="flex items-baseline gap-2" aria-label="Brûlerie d'altitude">
      <svg viewBox="0 0 28 28" class="w-7 h-7" aria-hidden="true"><ellipse cx="14" cy="14" rx="6" ry="9" fill="#3E2A1F"/><path d="M14 5 Q14 14 14 23" stroke="#B57A4A" stroke-width="0.8" fill="none"/></svg>
      <span class="font-instrument italic text-xl md:text-2xl" style="color:#1A0F0A;">Brûlerie d'altitude</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 font-mono uppercase text-[11px] tracking-[0.16em]" style="font-family:'DM Mono',monospace; color:#1A0F0A;" aria-label="Navigation">
      {nav.map(n => <a href={n.href} class="hover:opacity-60 transition-opacity">{n.label}</a>)}
    </nav>
    <a href="#abonnement" class="hidden md:inline-flex items-center h-10 px-5 text-[11px] uppercase tracking-[0.16em] font-semibold transition-colors" style="font-family:'DM Mono',monospace; background:#1A0F0A; color:#E8DDC7;">S'abonner</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-10 px-4 text-[11px] uppercase tracking-wider font-semibold" style="font-family:'DM Mono',monospace; background:#1A0F0A; color:#E8DDC7;">Appeler</a>
  </div>
</header>
<script>
  const h = document.getElementById('cf-header');
  if (h) { const u = () => { h.dataset.scrolled = String(window.scrollY > 8); }; u(); window.addEventListener('scroll', u, { passive: true }); }
</script>
