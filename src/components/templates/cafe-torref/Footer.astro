---
import data from '../../../data/templates/brulerie.json';
const year = new Date().getFullYear();
---
<footer id="contact" class="py-14" style="background:#1A0F0A; color:#E8DDC7;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-8">
    <div>
      <div class="font-instrument italic text-3xl">Brûlerie d'altitude</div>
      <p class="mt-1 text-[11px] uppercase tracking-[0.28em]" style="font-family:'DM Mono',monospace; color:#B57A4A;">Torréfaction artisanale · Réunion</p>
    </div>
    <div class="text-[14px]" style="color:#D8C9A8; font-family:'DM Mono',monospace;">
      <div class="text-[10px] uppercase tracking-[0.28em] mb-2" style="color:#B57A4A;">CONTACT</div>
      <a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a><br/>
      <a href={`mailto:${data.info.email}`}>{data.info.email}</a><br/>
      Brûlerie · La Réunion
    </div>
    <div class="text-[14px]" style="color:#D8C9A8; font-family:'DM Mono',monospace;">
      <div class="text-[10px] uppercase tracking-[0.28em] mb-2" style="color:#B57A4A;">HORAIRES</div>
      Lundi · torréfaction<br/>Jeudi · torréfaction<br/>Mercredi/Vendredi · vente 9h-13h<br/>Samedi · ateliers
    </div>
  </div>
  <div class="max-w-content mx-auto px-6 md:px-10 mt-10 pt-5 border-t text-[10px] uppercase tracking-[0.28em]" style="font-family:'DM Mono',monospace; border-color:rgba(232,221,199,0.15); color:#7A5C3F;">© {year} Brûlerie d'altitude — Démonstration 9site4</div>
</footer>
