---
import data from '../../../data/templates/seve.json';
---
<section id="contact" class="py-24 md:py-32" style="background:#FAF4EA;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-2 gap-12 lg:gap-20">
      <div>
        <p class="font-caveat text-2xl mb-2" style="color:#8AA288;">Écrivons-nous</p>
        <h2 class="font-cormorant text-4xl md:text-5xl leading-tight mb-6" style="color:#3A352D;">Racontez-nous <em class="italic" style="color:#CC6B49;">votre projet.</em></h2>
        <p class="text-base leading-relaxed mb-8" style="color:#5A5045;">Quelques lignes suffisent. On vous répond personnellement sous 48h ouvrées avec une proposition de RDV vidéo.</p>
        <ul class="space-y-3 text-[15px]" style="color:#3A352D;">
          <li><strong class="text-[11px] uppercase tracking-[0.22em] block" style="color:#8AA288;">Téléphone</strong><a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a></li>
          <li><strong class="text-[11px] uppercase tracking-[0.22em] block" style="color:#8AA288;">Email</strong><a href={`mailto:${data.info.email}`}>{data.info.email}</a></li>
          <li><strong class="text-[11px] uppercase tracking-[0.22em] block" style="color:#8AA288;">Instagram</strong>{data.info.instagram}</li>
        </ul>
      </div>
      <form class="grid gap-4" onsubmit="event.preventDefault(); alert('Démonstration — formulaire non actif.');">
        <div class="grid md:grid-cols-2 gap-4">
          <label class="block">
            <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#8AA288;">Vos prénoms</span>
            <input required type="text" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(58,53,45,0.30); color:#3A352D;"/>
          </label>
          <label class="block">
            <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#8AA288;">Date envisagée</span>
            <input type="text" placeholder="Mois / année" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(58,53,45,0.30); color:#3A352D;"/>
          </label>
        </div>
        <label class="block">
          <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#8AA288;">Email</span>
          <input required type="email" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(58,53,45,0.30); color:#3A352D;"/>
        </label>
        <label class="block">
          <span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#8AA288;">Racontez-nous</span>
          <textarea rows="6" class="w-full px-4 py-3 bg-transparent border" style="border-color:rgba(58,53,45,0.30); color:#3A352D;"></textarea>
        </label>
        <button class="mt-2 h-12 text-[12px] uppercase tracking-[0.22em] font-semibold transition-colors"
                style="background:#CC6B49; color:#FAF4EA;">Envoyer</button>
      </form>
    </div>
  </div>
</section>
