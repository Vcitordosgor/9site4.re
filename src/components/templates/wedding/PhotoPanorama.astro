<section aria-label="Ceremonie sur l'ile" class="bg-seve-ivoire py-0">
  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-seve-marine">
      <img
        src="https://images.unsplash.com/photo-1519741497674-611481863552?q=80&w=2200&auto=format&fit=crop"
        alt="Arche florale tropicale au coucher de soleil sur la plage"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-seve-marine/30 via-transparent to-transparent" aria-hidden="true"></div>
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-4 flex items-baseline justify-between gap-3 flex-wrap">
      <figcaption class="font-cormorant italic text-seve-marine/80 text-sm md:text-base leading-relaxed">
        Ceremonie laique. arche tropicale. 18h32. coucher de soleil
      </figcaption>
      <span class="font-outfit text-[11px] uppercase tracking-[0.28em] text-seve-or">L'ile. 47 ceremonies en 2025</span>
    </div>
  </figure>
</section>
