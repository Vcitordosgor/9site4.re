---
import data from '../../../data/templates/seve.json';
const labels = ['Jour J', 'Mois complet', 'Intime — moins de 30 invités'];
const budgets = ['Coordination · 2 400 €', 'Suivi 12 mois · 3 200 €', 'Élopement · 1 100 €'];
---
<section id="formules" class="bg-[#FAF4EA] py-28 md:py-40">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-12 gap-10 mb-16">
      <div class="md:col-span-7" data-reveal>
        <p class="text-[#8AA288] text-[11px] tracking-[0.32em] uppercase mb-6 flex items-center gap-3">
          <span class="w-10 h-px bg-[#8AA288]"></span> Trois formules
        </p>
        <h2 class="text-[#3A352D] leading-[0.92]" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(52px,8vw,112px);">
          Choisissez,<br/><em class="text-[#CC6B49]">on adapte.</em>
        </h2>
      </div>
      <p class="md:col-span-4 md:col-start-9 self-end text-[#3A352D]/75 text-[17px] leading-[1.7]">
        Trois entrées, un même soin du détail. Les tarifs sont indicatifs — chaque mariage reçoit un devis ligne par ligne, sans forfait obscur.
      </p>
    </div>

    <div class="grid lg:grid-cols-3 gap-5">
      {data.ceremonies.map((c, idx) => (
        <article class="group relative bg-white rounded-[28px] overflow-hidden ring-1 ring-[#3A352D]/10 hover:ring-[#CC6B49]/40 transition-all hover:-translate-y-2" data-reveal>
          <div class="relative aspect-[5/4] overflow-hidden">
            <img src={`/images/wedding/extra-${idx + 2}.webp`} alt={c.titre} class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#3A352D]/60 via-transparent to-transparent"></div>
            <span class="absolute top-5 left-5 bg-[#FAF4EA]/95 px-3 py-1.5 rounded-full text-[11px] tracking-[0.18em] uppercase text-[#3A352D]">{labels[idx]}</span>
            <p class="absolute bottom-5 left-6 right-6 text-[#FAF4EA] text-[26px] leading-[1.1]" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;">{c.tagline}</p>
          </div>
          <div class="p-8">
            <h3 class="text-[#3A352D] text-[28px] leading-[1.1] mb-2" style="font-family:'Cormorant Garamond',serif;font-weight:500;">{c.titre.split(' · ')[0]}</h3>
            <p class="text-[12px] tracking-[0.2em] uppercase text-[#8AA288] mb-5">{budgets[idx]}</p>
            <div class="flex flex-wrap gap-x-4 gap-y-1 text-[12px] text-[#3A352D]/60 mb-5">
              <span>{c.duree}</span><span class="text-[#3A352D]/25">·</span><span>{c.invites}</span>
            </div>
            <ul class="space-y-2.5 mb-7">
              {c.inclus.slice(0, 5).map((line) => (
                <li class="flex items-start gap-3 text-[14px] text-[#3A352D]/80 leading-[1.5]">
                  <svg class="shrink-0 mt-1" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#CC6B49" stroke-width="2.2"><path d="M5 12l5 5 9-12"/></svg>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
            <p class="text-[13px] italic text-[#3A352D]/65 mb-6" style="font-family:'Cormorant Garamond',serif;">{c.ideal}</p>
            <a href="#contact" class="inline-flex items-center gap-2 text-[#CC6B49] text-[13px] tracking-[0.14em] uppercase font-medium hover:gap-3 transition-all">
              Réserver cette formule
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
