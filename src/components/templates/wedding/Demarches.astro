---
const etapes = [
  { num: '01', titre: 'Le brief', mois: 'J-12 à J-9 mois', texte: 'Un appel vidéo de 90 minutes. Vos envies, votre histoire, votre budget. À la fin : un dossier d\'intention écrit.' },
  { num: '02', titre: 'La sélection', mois: 'J-9 à J-6 mois', texte: 'Lieu, traiteur, photographe, fleuriste, DJ. Trois propositions par poste, choisies pour vous, présentées par nous.' },
  { num: '03', titre: 'Les détails', mois: 'J-6 à J-2 mois', texte: 'Papeterie, scénographie, livret de cérémonie, vœux, playlist, plan de table. La cérémonie prend forme.' },
  { num: '04', titre: 'Le jour J', mois: 'Jour J', texte: 'Nous arrivons à 7h. Nous repartons à 2h. Entre les deux, vous ne portez rien d\'autre que vos alliances.' },
];
---
<section id="methode" class="py-24 md:py-32" style="background:#FAF4EA;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-16 max-w-2xl">
      <div class="font-caveat text-2xl mb-2" style="color:#8AA288;">Comment ça se passe</div>
      <h2 class="font-cormorant text-4xl md:text-5xl" style="color:#3A352D;">Quatre étapes, douze mois, <em class="italic" style="color:#CC6B49;">un seul jour.</em></h2>
    </div>
    <div class="grid md:grid-cols-4 gap-px" style="background:rgba(58,53,45,0.15);">
      {etapes.map(e => (
        <div class="p-7 md:p-8" style="background:#FAF4EA;">
          <div class="font-cormorant italic text-5xl mb-2" style="color:#CC6B49;">{e.num}</div>
          <div class="text-[11px] uppercase tracking-[0.22em] mb-3" style="color:#8AA288;">{e.mois}</div>
          <h3 class="font-cormorant text-2xl mb-3" style="color:#3A352D;">{e.titre}</h3>
          <p class="text-[14px] leading-relaxed" style="color:#5A5045;">{e.texte}</p>
        </div>
      ))}
    </div>
  </div>
</section>
