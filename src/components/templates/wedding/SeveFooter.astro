---
import data from '../../../data/templates/seve.json';
const year = new Date().getFullYear();
---
<footer class="py-16" style="background:#3A352D; color:#FAF4EA;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="flex flex-col items-center text-center mb-10">
      <div class="font-cormorant italic text-4xl md:text-5xl">Sève <em style="color:#CC6B49;">&</em> Sel</div>
      <p class="font-caveat text-2xl mt-2" style="color:#F4D7C5;">l'océan vous marie</p>
    </div>
    <div class="grid md:grid-cols-3 gap-8 text-[14px] text-center md:text-left max-w-3xl mx-auto" style="color:#E8DCC9;">
      <div><div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#F4D7C5;">Contact</div><a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a><br/><a href={`mailto:${data.info.email}`}>{data.info.email}</a></div>
      <div><div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#F4D7C5;">Présence</div>Sur RDV<br/>La Réunion</div>
      <div><div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#F4D7C5;">Suivez-nous</div>{data.info.instagram}</div>
    </div>
    <div class="mt-12 pt-6 border-t text-center text-[11px] uppercase tracking-[0.24em]" style="border-color:rgba(250,244,234,0.15); color:#A8A095;">© {year} — Démonstration 9site4</div>
  </div>
</footer>
