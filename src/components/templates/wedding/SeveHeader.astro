---
import data from '../../../data/templates/seve.json';
const nav = [
  { href: '#formules', label: 'Formules' },
  { href: '#methode', label: 'Méthode' },
  { href: '#univers', label: 'Univers' },
  { href: '#couples', label: 'Couples' },
  { href: '#contact', label: 'Contact' },
];
---
<header id="we-header" data-scrolled="false" class="fixed top-0 inset-x-0 z-50 transition-all duration-500">
  <div class="absolute inset-0 transition-all duration-500" id="we-bg" style="background:transparent;"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="#top" class="flex items-center gap-3" aria-label="Sève & Sel">
      <span class="font-cormorant italic text-2xl md:text-3xl tracking-tight" style="color:#FAF4EA;" data-text>Sève <em style="color:#CC6B49;">&</em> Sel</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[12px] uppercase tracking-[0.22em] font-medium" aria-label="Navigation">
      {nav.map(n => <a href={n.href} style="color:#FAF4EA;" data-text class="hover:opacity-70 transition-opacity">{n.label}</a>)}
    </nav>
    <a href="#contact" class="hidden md:inline-flex items-center h-10 px-5 text-[12px] uppercase tracking-[0.16em] font-semibold border transition-colors"
       style="border-color:#FAF4EA; color:#FAF4EA;" data-cta>RDV découverte</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-10 px-4 text-[11px] uppercase tracking-wider font-semibold border" style="border-color:#FAF4EA; color:#FAF4EA;" data-cta>Appeler</a>
  </div>
</header>
<style>
  #we-header[data-scrolled='true'] #we-bg { background:rgba(250,244,234,0.96); backdrop-filter:blur(10px); box-shadow:0 1px 3px rgba(58,53,45,0.08); }
  #we-header[data-scrolled='true'] [data-text] { color:#3A352D !important; }
  #we-header[data-scrolled='true'] [data-cta] { border-color:#3A352D !important; color:#3A352D !important; }
</style>
<script>
  const h = document.getElementById('we-header');
  if (h) { const u = () => { h.dataset.scrolled = String(window.scrollY > 24); }; u(); window.addEventListener('scroll', u, { passive: true }); }
</script>
