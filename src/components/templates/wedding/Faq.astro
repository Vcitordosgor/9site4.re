---
const faqs = [
  { q: 'À quel moment vous contacter ?', r: 'Idéalement 9 à 14 mois avant la date souhaitée. Pour les cérémonies intimes ou last-minute, on peut faire plus court — appelez-nous, on vous dira honnêtement si c\'est tenable.' },
  { q: 'Vous occupez-vous des démarches civiles ?', r: 'Non. Le mariage civil reste à votre charge en mairie de votre domicile (ou de votre lieu de résidence depuis 40 jours). Nous proposons une cérémonie laïque, symbolique, à La Réunion.' },
  { q: 'On vit à l\'étranger — c\'est possible ?', r: 'Évidemment. La moitié de nos couples vit ailleurs. Tout se gère en visio, on vous prépare votre arrivée et on s\'occupe de chaque détail.' },
  { q: 'Vous travaillez avec quels prestataires ?', r: 'Une trentaine de prestataires réunionnais soigneusement choisis : photographes, traiteurs, fleuristes, DJ. Aucune commission cachée — on est rémunérées par vous, pas par eux.' },
  { q: 'Quel est votre budget moyen ?', r: 'Nos couples investissent en moyenne 18 000 € à 28 000 € pour 40 à 80 invités, hors honoraires. Nous adaptons toujours à votre enveloppe.' },
  { q: 'Plan B en cas de pluie ?', r: 'Toujours prévu. Chaque lieu extérieur a son alternative couverte, communiquée 48h avant. On respecte le ciel réunionnais — il a son mot à dire.' },
];
---
<section class="py-24 md:py-32" style="background:#F4ECDC;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-2xl">
      <div class="font-caveat text-2xl mb-2" style="color:#8AA288;">Vos questions</div>
      <h2 class="font-cormorant text-4xl md:text-5xl" style="color:#3A352D;">FAQ couples.</h2>
    </div>
    <div class="grid md:grid-cols-2 gap-px max-w-5xl" style="background:rgba(58,53,45,0.15);">
      {faqs.map(f => (
        <details class="p-6 md:p-7 group" style="background:#F4ECDC;">
          <summary class="cursor-pointer flex justify-between gap-4 font-cormorant text-xl" style="color:#3A352D;">
            {f.q}
            <span class="font-cormorant text-2xl transition-transform group-open:rotate-45" style="color:#CC6B49;">+</span>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed" style="color:#5A5045;">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
