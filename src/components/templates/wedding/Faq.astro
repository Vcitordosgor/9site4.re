---
const faqs = [
  { q: 'On vit en métropole — comment ça se passe à distance ?', r: 'Visioconférences mensuelles, comptes-rendus écrits après chaque étape, droit de regard sur chaque devis. À distance, c’est notre quotidien — plus de 60 % de nos couples vivent hors de l’île.' },
  { q: 'Vous parlez anglais ?', r: 'Couramment. Beaucoup de nos couples viennent d’Australie, Nouvelle-Zélande ou des États-Unis. Officiant bilingue inclus dans toutes les formules.' },
  { q: 'Et s’il pleut le jour-J ?', r: 'Plan B inclus dans tous nos contrats. Chapiteau, lieu couvert de secours, déplacement de l’horaire — décision prise 48h avant, avec vous.' },
  { q: 'On peut venir voir les lieux avant de réserver ?', r: 'Bien sûr. Beaucoup de couples viennent en repérage 4 à 6 mois avant. On organise une semaine sur-mesure (lieux, prestataires, dégustations).' },
  { q: 'Pourquoi pas de tarif fixe en ligne ?', r: 'Parce qu’un mariage pour 25 invités sur la plage n’a rien à voir avec 120 invités dans un domaine. Devis ligne par ligne, jamais de surprise.' },
  { q: 'Vous gérez aussi les formalités civiles ?', r: 'Pour les résidents : oui, dossier complet à la mairie. Pour les étrangers : cérémonie laïque uniquement (le mariage civil se fait dans le pays de résidence).' },
];
---
<section class="bg-[#FAF4EA] py-28 md:py-36">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid lg:grid-cols-12 gap-12">
      <div class="lg:col-span-4" data-reveal>
        <p class="text-[#8AA288] text-[11px] tracking-[0.32em] uppercase mb-6">— Questions couples</p>
        <h2 class="text-[#3A352D] leading-[0.95]" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(40px,5vw,72px);">
          Ce qu’on nous<br/><em class="text-[#CC6B49]">demande souvent.</em>
        </h2>
      </div>
      <div class="lg:col-span-8 space-y-3">
        {faqs.map((f, i) => (
          <details class="group bg-white rounded-2xl px-6 py-5 ring-1 ring-[#3A352D]/8 hover:ring-[#CC6B49]/30 transition-all" open={i === 0}>
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
              <h3 class="text-[#3A352D] text-[18px] md:text-[22px] leading-snug pr-4" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;">{f.q}</h3>
              <span class="w-9 h-9 rounded-full ring-1 ring-[#3A352D]/15 grid place-items-center transition-transform group-open:rotate-45 shrink-0">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#3A352D" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="mt-4 text-[#3A352D]/75 text-[15px] leading-[1.7]">{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
