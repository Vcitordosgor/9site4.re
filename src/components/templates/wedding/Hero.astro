---
import data from '../../../data/templates/seve.json';
---
<section id="top" class="relative h-[100svh] min-h-[640px] w-full overflow-hidden">
  <img src="/images/wedding/extra-1.webp" alt="Cérémonie de mariage à La Réunion" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
  <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(58,53,45,0.05) 0%, rgba(58,53,45,0.15) 40%, rgba(58,53,45,0.75) 100%);"></div>
  <div class="absolute inset-0" style="background:linear-gradient(110deg, rgba(58,53,45,0.55) 0%, transparent 55%);"></div>

  <div class="relative h-full max-w-content mx-auto px-6 md:px-10 flex flex-col justify-end pb-20 md:pb-28">
    <p class="text-[#FAF4EA]/85 text-[11px] tracking-[0.32em] uppercase mb-6 flex items-center gap-3" data-reveal>
      <span class="w-10 h-px bg-[#CC6B49]"></span>
      Wedding planner · La Réunion · depuis {data.info.annee}
    </p>
    <h1 class="text-[#FAF4EA] leading-[0.88] tracking-[-0.02em] max-w-[1100px]" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(72px,12vw,184px);" data-reveal>
      Sève. <em class="text-[#FAF4EA]/95" style="font-style:italic;">Wedding planner</em><br/>
      <span class="text-[#CC6B49]/95" style="font-style:italic;font-weight:300;">— La Réunion.</span>
    </h1>
    <p class="mt-8 text-[#FAF4EA]/90 text-[18px] md:text-[22px] max-w-2xl leading-[1.5]" data-reveal>
      Vous dites oui. On s’occupe du reste.
    </p>
    <div class="mt-10 flex flex-wrap items-center gap-6" data-reveal>
      <a href="#contact" class="inline-flex items-center gap-3 h-[56px] px-8 bg-[#FAF4EA] text-[#3A352D] rounded-full text-[14px] font-medium tracking-[0.08em] hover:bg-[#CC6B49] hover:text-[#FAF4EA] transition-all hover:translate-y-[-2px]" style="box-shadow:0 14px 32px rgba(0,0,0,0.25);">
        Réserver un RDV découverte
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
      </a>
      <a href="#formules" class="text-[#FAF4EA] text-[14px] tracking-[0.14em] uppercase underline underline-offset-[8px] decoration-[#CC6B49] decoration-2 hover:text-[#CC6B49] transition-colors">
        Voir nos formules
      </a>
    </div>
  </div>

  <div class="absolute bottom-8 right-6 md:right-10 hidden md:flex items-center gap-3 text-[#FAF4EA]/75 text-[11px] tracking-[0.28em] uppercase">
    <span>Défiler</span>
    <span class="w-12 h-px bg-[#FAF4EA]/40"></span>
  </div>
</section>
