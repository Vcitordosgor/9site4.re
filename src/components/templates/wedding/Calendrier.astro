---
const mois = [
  { m: 'Jan', s: 'cyclonique', dispo: 'restreint' },
  { m: 'Fév', s: 'cyclonique', dispo: 'restreint' },
  { m: 'Mar', s: 'transition', dispo: 'limité' },
  { m: 'Avr', s: 'haute saison', dispo: 'disponible' },
  { m: 'Mai', s: 'haute saison', dispo: 'limité' },
  { m: 'Juin', s: 'haute saison', dispo: 'disponible' },
  { m: 'Juil', s: 'haute saison', dispo: 'complet' },
  { m: 'Août', s: 'haute saison', dispo: 'complet' },
  { m: 'Sept', s: 'haute saison', dispo: 'disponible' },
  { m: 'Oct', s: 'haute saison', dispo: 'limité' },
  { m: 'Nov', s: 'transition', dispo: 'disponible' },
  { m: 'Déc', s: 'cyclonique', dispo: 'restreint' },
];
const couleurs = {
  'disponible': 'bg-[#8AA288] text-white',
  'limité': 'bg-[#CC6B49]/85 text-white',
  'complet': 'bg-[#3A352D] text-[#FAF4EA]',
  'restreint': 'bg-[#FAF4EA] text-[#3A352D]/55 ring-1 ring-[#3A352D]/15',
};
---
<section class="bg-[#FAF4EA] py-28 md:py-36">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="text-center mb-14" data-reveal>
      <p class="text-[#8AA288] text-[11px] tracking-[0.32em] uppercase mb-6">— Disponibilités 2026 —</p>
      <h2 class="text-[#3A352D] leading-[0.95]" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(44px,7vw,88px);">
        Quand <em class="text-[#CC6B49]">se marier</em><br/>à La Réunion ?
      </h2>
      <p class="mt-6 max-w-2xl mx-auto text-[#3A352D]/75 text-[16px] leading-[1.7]">
        D’avril à octobre, la saison sèche offre des lagons calmes et des températures parfaites. De décembre à mars, c’est la saison cyclonique — possible avec lieux couverts.
      </p>
    </div>

    <div class="grid grid-cols-3 md:grid-cols-6 lg:grid-cols-12 gap-2 md:gap-3 max-w-4xl mx-auto">
      {mois.map((mm) => (
        <div class:list={['rounded-2xl p-4 text-center transition-all hover:-translate-y-1', couleurs[mm.dispo]]}>
          <p class="text-[18px] mb-2" style="font-family:'Cormorant Garamond',serif;font-style:italic;">{mm.m}</p>
          <p class="text-[9px] tracking-[0.16em] uppercase opacity-80">{mm.dispo}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-4 text-[11px] tracking-[0.18em] uppercase text-[#3A352D]/65">
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#8AA288]"></span>Disponible</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#CC6B49]/85"></span>Limité</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#3A352D]"></span>Complet</span>
      <span class="flex items-center gap-2"><span class="w-3 h-3 rounded-full bg-[#3A352D]/15"></span>Saison cyclonique</span>
    </div>
  </div>
</section>
