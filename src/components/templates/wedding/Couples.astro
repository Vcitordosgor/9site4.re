---
import data from '../../../data/templates/seve.json';
const photos = ['/images/wedding/extra-4.webp', '/images/wedding/extra-5.webp', '/images/wedding/extra-6.webp'];
---
<section id="couples" class="bg-[#3A352D] text-[#FAF4EA] py-28 md:py-40">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-12 gap-10 mb-16">
      <div class="md:col-span-7" data-reveal>
        <p class="text-[#CC6B49] text-[11px] tracking-[0.32em] uppercase mb-6 flex items-center gap-3">
          <span class="w-10 h-px bg-[#CC6B49]"></span> Couples comme vous
        </p>
        <h2 class="leading-[0.92]" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(52px,8vw,112px);">
          Trois <em class="text-[#CC6B49]">oui</em>,<br/>trois histoires.
        </h2>
      </div>
      <p class="md:col-span-4 md:col-start-9 self-end text-[#FAF4EA]/70 text-[16px] leading-[1.7]">
        Témoignages anonymisés — prénoms initiales et lieu. Sur demande, nous mettons en relation directe avec d’anciens couples qui acceptent d’en parler.
      </p>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {data.couples.map((c, i) => (
        <article class="relative" data-reveal>
          <div class="relative aspect-[4/5] rounded-[24px] overflow-hidden ring-1 ring-[#FAF4EA]/10 mb-6">
            <img src={photos[i]} alt={c.prenoms} class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#3A352D]/60 to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5">
              <p class="text-[28px] leading-none mb-1" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;">{c.prenoms.split(' & ').map((p) => p.charAt(0)).join(' & ').replace(/\s/g, '.')}</p>
              <p class="text-[11px] tracking-[0.2em] uppercase text-[#FAF4EA]/75">{c.origine} · {c.date}</p>
            </div>
          </div>
          <p class="text-[#FAF4EA]/85 text-[17px] leading-[1.65]" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;">« {c.texte} »</p>
        </article>
      ))}
    </div>
  </div>
</section>
