---
const items = [
  { txt: 'Nous arrivions d\'Auckland huit jours avant. Sève & Sel ont tout pris en main — même nos parents perdus à l\'aéroport. Le 14, on a juste pleuré et dit oui.', who: 'M. & T. — janvier' },
  { txt: 'Notre mariage tenait dans 12 personnes. Pas un détail n\'a manqué, pas un excès n\'a pesé. C\'était exactement à notre image.', who: 'A. & L. — juin' },
  { txt: 'Elles ont compris ce que nous voulions avant même qu\'on le dise. Les filaos, le coucher de soleil, deux guitares, une heure. Magique.', who: 'C. & R. — octobre' },
];
---
<section id="couples" class="py-24 md:py-32" style="background:#FAF4EA;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-16 max-w-2xl">
      <div class="font-caveat text-2xl mb-2" style="color:#8AA288;">Quelques mots de couples</div>
      <h2 class="font-cormorant text-4xl md:text-5xl" style="color:#3A352D;">Ce qu'ils <em class="italic">en disent.</em></h2>
    </div>
    <div class="grid md:grid-cols-3 gap-8 lg:gap-10">
      {items.map(i => (
        <figure>
          <div class="font-cormorant text-7xl leading-none mb-2" style="color:#CC6B49;">"</div>
          <blockquote class="font-cormorant italic text-xl leading-snug mb-5" style="color:#3A352D;">{i.txt}</blockquote>
          <figcaption class="font-caveat text-xl" style="color:#8AA288;">— {i.who}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
