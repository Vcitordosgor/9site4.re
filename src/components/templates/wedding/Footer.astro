---
import data from '../../../data/templates/seve.json';
const i = data.info;
---
<footer class="relative bg-[#3A352D] text-[#FAF4EA] pt-28 pb-10 overflow-hidden">
  <div aria-hidden="true" class="absolute -top-40 -left-40 w-[500px] h-[500px] rounded-full bg-[#CC6B49]/15 blur-3xl"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-10">

    <p class="text-center leading-[0.9] mb-20" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:400;font-size:clamp(48px,8.5vw,128px);">
      Vous dites <em class="text-[#CC6B49]">oui</em>.<br/>
      On s’occupe du reste.
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 pt-12 border-t border-[#FAF4EA]/15">
      <div>
        <p class="mb-3" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:32px;">Sève</p>
        <p class="text-[11px] tracking-[0.28em] uppercase text-[#CC6B49] mb-4">Wedding · Réunion</p>
        <p class="text-[14px] text-[#FAF4EA]/65 leading-[1.65]">Wedding planner indépendant à La Réunion. Sur rendez-vous, depuis {i.annee}.</p>
      </div>
      <div>
        <p class="text-[11px] tracking-[0.18em] uppercase text-[#CC6B49] mb-4">Contact</p>
        <p class="text-[14px] mb-2"><a href={`tel:${i.telephoneHref}`} class="hover:text-[#CC6B49] tabular-nums">{i.telephone}</a></p>
        <p class="text-[14px] mb-2"><a href={`mailto:${i.email}`} class="hover:text-[#CC6B49]">{i.email}</a></p>
        <p class="text-[14px]"><span class="text-[#FAF4EA]/65">Instagram · </span><span>{i.instagram}</span></p>
      </div>
      <div>
        <p class="text-[11px] tracking-[0.18em] uppercase text-[#CC6B49] mb-4">Bureau</p>
        <p class="text-[14px] text-[#FAF4EA]/75">{i.adresseLigne1}</p>
        <p class="text-[14px] text-[#FAF4EA]/75">{i.adresseLigne2}</p>
        <p class="text-[12px] text-[#FAF4EA]/55 mt-2">Visites & repérages sur l’ensemble de l’île</p>
      </div>
      <div>
        <p class="text-[11px] tracking-[0.18em] uppercase text-[#CC6B49] mb-4">Légal</p>
        <p class="text-[14px] text-[#FAF4EA]/75">Wedding planner indépendant</p>
        <p class="text-[14px] text-[#FAF4EA]/75">Assurance RC Pro</p>
        <p class="text-[14px] text-[#FAF4EA]/75">Devis ligne par ligne</p>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mt-12 pt-8 border-t border-[#FAF4EA]/15 text-[12px] text-[#FAF4EA]/55">
      <p>© {new Date().getFullYear()} {i.nom} · La Réunion</p>
      <p class="text-[11px] tracking-[0.18em] uppercase">Site démo 9site4</p>
    </div>
  </div>
</footer>
