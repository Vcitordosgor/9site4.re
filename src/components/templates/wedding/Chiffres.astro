---
import data from '../../../data/templates/seve.json';

const ans = new Date().getFullYear() - parseInt(data.info.annee);
const chiffres = [
  { gros: data.info.ceremonies2025, unite: '', petit: 'cérémonies orchestrées en 2025' },
  { gros: ans + '', unite: 'ans', petit: 'auprès des couples de l\'île et d\'ailleurs' },
  { gros: data.info.ceremoniesPrevues2026, unite: '', petit: 'mariages déjà inscrits au calendrier 2026' },
  { gros: '0', unite: '', petit: 'annulation jour-J en huit saisons' },
];
---

<section class="bg-seve-creme py-20 md:py-32 relative overflow-hidden">

  <svg class="absolute -right-32 top-10 w-[480px] h-[480px] opacity-[0.10] pointer-events-none" viewBox="0 0 200 200" fill="none" stroke="#7A9461" stroke-width="0.6" aria-hidden="true">
    <path d="M40 100 Q70 30 100 100 Q130 170 160 100" />
    <path d="M40 120 Q70 50 100 120 Q130 190 160 120" opacity="0.7"/>
    <path d="M40 80 Q70 10 100 80 Q130 150 160 80" opacity="0.5"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">
    <div class="text-center mb-14 md:mb-20">
      <p class="font-outfit text-[11px] uppercase tracking-[0.4em] text-seve-or mb-4">— Notre saison en chiffres —</p>
      <h2 class="font-cormorant text-seve-marine text-4xl md:text-5xl leading-tight">
        Huit ans, deux mille
        <em class="font-italianno text-seve-corail text-5xl md:text-6xl not-italic">oui</em>
        prononcés.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-y-14 md:gap-y-20 md:gap-x-10">
      {chiffres.map((c, i) => (
        <div class={`md:col-span-6 ${i === 1 ? 'md:translate-y-10 md:text-right' : ''} ${i === 2 ? 'md:-translate-y-8' : ''} ${i === 3 ? 'md:translate-y-6 md:text-right' : ''}`}>
          <p class="font-cormorant italic text-seve-marine leading-[0.85] tracking-tight inline-flex items-end gap-3">
            <span style="font-size:clamp(72px,14vw,150px);">{c.gros}</span>
            {c.unite && <span class="font-outfit not-italic uppercase tracking-[0.2em] text-seve-or text-base md:text-xl mb-3 md:mb-6">{c.unite}</span>}
          </p>
          <p class="mt-4 font-italianno text-seve-corail text-3xl md:text-4xl leading-tight max-w-md">
            {c.petit}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
