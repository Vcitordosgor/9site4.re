---
const etapes = [
  {
    num: '01',
    titre: 'Premier appel',
    delai: 'J + 0',
    texte: 'Un visio d\'1h avec Cléa pour comprendre votre histoire, votre nombre d\'invités, votre saison rêvée, votre budget honnête.',
  },
  {
    num: '02',
    titre: 'Repérage',
    delai: 'M + 1',
    texte: 'Tournée des trois lieux pré-sélectionnés selon vos goûts. Plage, jardin botanique, domaine viticole : on visite ensemble.',
  },
  {
    num: '03',
    titre: 'Devis & équipe',
    delai: 'M + 2',
    texte: 'Mood-board, planning détaillé heure par heure, équipe complète (officiant, fleuriste, traiteur, photographe, DJ).',
  },
  {
    num: '04',
    titre: 'Essais',
    delai: 'M − 2',
    texte: 'Dégustation traiteur, essai bouquet, point coiffure-maquillage, répétition arche florale et marche nuptiale.',
  },
  {
    num: '05',
    titre: 'Jour J',
    delai: 'Le grand jour',
    texte: 'Cléa et son équipe sur place dès 8h. Vous arrivez à l\'heure dite, tout est prêt. Il ne vous reste plus qu\'à dire oui.',
  },
];
---

<section class="bg-seve-ivoire py-20 md:py-32 relative">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-16 md:mb-24">
      <p class="font-outfit text-[11px] uppercase tracking-[0.4em] text-seve-or mb-4">— Du premier appel au grand jour —</p>
      <h2 class="font-cormorant text-seve-marine text-4xl md:text-5xl leading-tight">
        Cinq rendez-vous,
        <em class="font-italianno text-seve-corail text-5xl md:text-6xl not-italic block">et c'est plié.</em>
      </h2>
    </div>

    <ol class="relative grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-0">
      <div class="hidden md:block absolute top-12 left-[10%] right-[10%] h-px bg-seve-or/40" aria-hidden="true"></div>

      {etapes.map((e) => (
        <li class="relative text-center md:px-3">
          <div class="relative inline-flex items-center justify-center w-24 h-24 rounded-full bg-seve-ivoire border-2 border-seve-or/70 hover:border-seve-corail hover:shadow-lg transition-all duration-300 mb-6">
            <span class="font-cormorant text-seve-marine text-3xl leading-none">{e.num}</span>
          </div>
          <p class="font-outfit text-[10px] uppercase tracking-[0.3em] text-seve-or mb-2">{e.delai}</p>
          <h3 class="font-cormorant text-seve-marine text-xl md:text-2xl mb-3">{e.titre}</h3>
          <p class="font-outfit text-[14px] text-seve-marine/80 leading-relaxed max-w-xs mx-auto">{e.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
