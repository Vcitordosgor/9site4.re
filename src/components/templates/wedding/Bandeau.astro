---
import data from '../../../data/templates/seve.json';
---

<section aria-label="Reservation premier appel" class="bg-seve-or text-seve-marine py-6 md:py-7">
  <div class="max-w-content mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
    <div class="flex items-center gap-3">
      <span class="font-italianno text-3xl md:text-4xl text-seve-marine leading-none">Sur rendez-vous</span>
      <span class="hidden md:inline font-outfit text-[11px] uppercase tracking-[0.3em] text-seve-marine/70">premier appel gratuit. 45 min</span>
    </div>
    <p class="font-cormorant italic text-seve-marine text-base md:text-lg text-center">
      « De l'appel decouverte au dernier verre de champagne. »
    </p>
    <a
      href={`https://wa.me/${data.info.whatsapp}`}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center justify-center h-11 px-6 bg-seve-marine text-seve-ivoire font-outfit font-semibold text-[11.5px] uppercase tracking-[0.2em] rounded-full hover:bg-seve-corail transition-colors"
    >
      Premier appel
    </a>
  </div>
</section>
