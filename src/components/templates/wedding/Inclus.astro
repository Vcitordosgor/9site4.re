---
const items = [
  { l: 'Lieu', p: 'M3 21V8l9-5 9 5v13M9 21V12h6v9' },
  { l: 'Fleurs', p: 'M12 2a4 4 0 014 4 4 4 0 01-4 4 4 4 0 01-4-4 4 4 0 014-4zM12 14v8' },
  { l: 'Traiteur', p: 'M4 4h16v2H4zM6 6v6a6 6 0 0012 0V6M12 18v3' },
  { l: 'Photographe', p: 'M4 8h4l2-3h4l2 3h4v12H4zM12 17a4 4 0 100-8 4 4 0 000 8z' },
  { l: 'DJ', p: 'M6 19V6l8-2v13M14 17a3 3 0 11-6 0 3 3 0 016 0z' },
  { l: 'Décoration', p: 'M12 2v20M4 12h16M6 6l12 12M18 6L6 18' },
  { l: 'Papeterie', p: 'M5 3h11l4 4v14H5zM16 3v4h4M9 13h6M9 17h6' },
  { l: 'Transport', p: 'M4 11l2-5h12l2 5v6h-2a2 2 0 11-4 0H10a2 2 0 11-4 0H4v-6z' },
  { l: 'Hébergement', p: 'M3 18v-7a2 2 0 012-2h4v9M11 18h10v-4a2 2 0 00-2-2h-6a2 2 0 00-2 2v4z' },
  { l: 'Coiffure & beauté', p: 'M12 2v6M8 8c0-2 2-3 4-3s4 1 4 3v3a4 4 0 11-8 0V8zM6 22c0-3 3-5 6-5s6 2 6 5' },
  { l: 'Programme', p: 'M5 4h14v16H5zM5 9h14M9 4v16' },
  { l: 'Urgences J-J', p: 'M12 22s-7-4.5-7-11a5 5 0 019-3 5 5 0 019 3c0 6.5-7 11-7 11h-4z' },
];
---
<section class="bg-[#8AA288]/15 py-28 md:py-36">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="text-center max-w-3xl mx-auto mb-16" data-reveal>
      <p class="text-[#8AA288] text-[11px] tracking-[0.32em] uppercase mb-6 flex items-center justify-center gap-3">
        <span class="w-10 h-px bg-[#8AA288]"></span>
        Ce qu’on couvre, vraiment
        <span class="w-10 h-px bg-[#8AA288]"></span>
      </p>
      <h2 class="text-[#3A352D] leading-[0.95]" style="font-family:'Cormorant Garamond',serif;font-weight:400;font-size:clamp(44px,7vw,88px);">
        Douze <em class="text-[#CC6B49]">métiers</em>,<br/>une seule porte d’entrée.
      </h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">
      {items.map((it) => (
        <div class="group bg-[#FAF4EA] rounded-2xl p-6 text-center ring-1 ring-[#3A352D]/8 hover:ring-[#CC6B49]/40 hover:-translate-y-1 transition-all">
          <div class="w-12 h-12 mx-auto mb-4 rounded-xl bg-[#CC6B49]/10 group-hover:bg-[#CC6B49] grid place-items-center transition-colors">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#CC6B49" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="group-hover:stroke-[#FAF4EA] transition-colors"><path d={it.p}/></svg>
          </div>
          <p class="text-[#3A352D] text-[13px] font-medium leading-tight">{it.l}</p>
        </div>
      ))}
    </div>
  </div>
</section>
