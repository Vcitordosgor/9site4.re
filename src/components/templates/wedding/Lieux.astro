---
const photos = [
  { src: '/images/wedding/extra-3.webp', label: 'Les voeux' },
  { src: '/images/wedding/extra-5.webp', label: 'Le décor' },
  { src: '/images/wedding/extra-7.webp', label: 'Le banquet' },
  { src: '/images/wedding/extra-8.webp', label: 'L\'instant' },
];
---
<section id="univers" class="py-24 md:py-32" style="background:#3A352D; color:#FAF4EA;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-16 max-w-2xl">
      <div class="font-caveat text-2xl mb-2" style="color:#F4D7C5;">Notre univers</div>
      <h2 class="font-cormorant text-4xl md:text-5xl">Quelques images, <em class="italic" style="color:#F4D7C5;">quelques instants.</em></h2>
    </div>
    <div class="grid md:grid-cols-4 gap-4">
      {photos.map((p, i) => (
        <figure class={`overflow-hidden ${i === 0 || i === 3 ? 'md:row-span-2 md:aspect-[3/5]' : 'aspect-square'}`}>
          <img src={p.src} alt={p.label} class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy"/>
        </figure>
      ))}
    </div>
  </div>
</section>
