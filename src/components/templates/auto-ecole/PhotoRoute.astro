---
/**
 * PhotoRoute — visuel full-bleed leçon de conduite.
 */
---

<section class="bg-boost-route">
  <figure class="relative aspect-[21/9] overflow-hidden bg-boost-noir">
    <img
      src="/images/auto-ecole/route.webp"
      alt="Élève au volant avec son moniteur en cours de conduite"
      width="1800"
      height="771"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-boost-noir/70 via-boost-noir/20 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-12 left-6 md:left-12 right-6 md:right-12 max-w-2xl">
      <p class="inline-flex items-center gap-2 font-geist-mono text-[11px] uppercase tracking-[0.18em] text-boost-jaune font-medium mb-3 bg-boost-noir/60 backdrop-blur-sm px-3 py-1.5 rounded-full">
        ▸ Conduite accompagnée
      </p>
      <p class="font-funnel-display font-bold text-boost-route leading-[1.05]" style="font-size: clamp(28px, 4vw, 56px);">
        Ta première route, c'est déjà une <span class="italic font-light text-boost-jaune">victoire</span>.
      </p>
    </figcaption>
  </figure>
</section>
