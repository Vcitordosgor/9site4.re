---
const mots = ['BOOST', 'CODE', 'CONDUITE', 'PERMIS·B', 'BVA', 'CONDUITE·ACCOMPAGNÉE', 'CODE·ILLIMITÉ', 'PERMIS·EN·1·MOIS'];
---

<section aria-hidden="true" class="bg-boost-acier text-boost-route border-y-4 border-boost-noir overflow-hidden">
  <div class="marquee-track flex gap-10 py-4 whitespace-nowrap font-funnel-display font-bold text-2xl md:text-4xl uppercase tracking-tight">
    {[0,1,2,3].map(() => (
      <span class="flex shrink-0 gap-10 items-center">
        {mots.map((m) => (
          <>
            <span>{m}</span>
            <span class="text-boost-jaune">◆</span>
          </>
        ))}
      </span>
    ))}
  </div>
</section>

<style>
  .marquee-track {
    animation: boost-marquee 40s linear infinite;
    will-change: transform;
  }
  @keyframes boost-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-25%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>
