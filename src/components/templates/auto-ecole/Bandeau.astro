---
import data from '../../../data/templates/boost.json';
---

<section class="bg-boost-jaune text-boost-noir relative">
  <div class="absolute inset-x-0 top-0 h-1 bg-boost-noir" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-1 bg-boost-noir" aria-hidden="true"></div>

  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-8">
        <p class="inline-flex items-center gap-2 font-geist-mono text-[11px] uppercase tracking-[0.18em] text-boost-noir font-bold mb-3 bg-boost-noir/10 px-3 py-1.5 rounded-full">
          <span class="w-1.5 h-1.5 rounded-full bg-boost-feu animate-pulse"></span>
          ✓ Offre permanente
        </p>
        <p class="font-funnel-display font-bold text-boost-noir leading-[1] tracking-tight" style="font-size: clamp(28px, 3.8vw, 48px);">
          Évaluation gratuite <span class="italic font-light">+ 1ʳᵉ heure de conduite offerte</span> à l'inscription.
        </p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a
          href="#inscription"
          class="inline-flex items-center justify-center h-14 px-8 bg-boost-noir text-boost-jaune font-funnel-display font-bold text-base rounded-full hover:bg-boost-acier hover:text-boost-route transition-all hover:scale-105"
        >
          Je réserve mon créneau →
        </a>
        <p class="mt-3 font-geist-mono text-[11px] uppercase tracking-[0.22em] text-boost-noir/70">
          {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
