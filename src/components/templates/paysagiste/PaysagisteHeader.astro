---
import data from '../../../data/templates/agapanthes.json';
const info = data.info;
const links = [
  { href: '#plan',     label: 'Plan' },
  { href: '#saisons',  label: '4 saisons' },
  { href: '#plantes',  label: 'Plantes' },
  { href: '#equipe',   label: 'Atelier' },
  { href: '#devis',    label: 'Devis' },
];
---
<header id="agap-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-500 ease-out">
  <div class="absolute inset-0 transition-all duration-500" id="agap-bg"></div>
  <div class="relative max-w-[1400px] mx-auto px-6 lg:px-12 h-16 lg:h-20 flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-2 font-cormorant text-agap-feuille">
      <span class="text-xl lg:text-2xl font-light italic">{info.wordmark1}</span>
      <span class="text-xl lg:text-2xl font-medium">{info.wordmark2}</span>
    </a>
    <nav class="hidden lg:flex items-center gap-8 font-manrope text-[12px] uppercase tracking-[0.22em] text-agap-feuille/80">
      {links.map(l => <a href={l.href} class="hover:text-agap-violet transition-colors">{l.label}</a>)}
    </nav>
    <a href={`tel:${info.telephoneHref}`} class="hidden md:inline-flex items-center h-10 px-5 rounded-full bg-agap-violet text-agap-lin text-[11px] font-manrope font-semibold uppercase tracking-[0.22em] hover:bg-agap-violet-fonce transition-colors">
      Devis gratuit
    </a>
    <button id="agap-burger" class="lg:hidden flex flex-col gap-1.5 w-9 h-9 items-center justify-center text-agap-feuille" aria-label="Menu">
      <span class="block w-5 h-px bg-current"></span>
      <span class="block w-5 h-px bg-current"></span>
      <span class="block w-5 h-px bg-current"></span>
    </button>
  </div>
  <div id="agap-mobile" class="lg:hidden hidden bg-agap-lin border-t border-agap-feuille/10">
    <nav class="flex flex-col px-6 py-6 gap-3 font-manrope text-sm uppercase tracking-[0.22em] text-agap-feuille">
      {links.map(l => <a href={l.href} class="py-2 border-b border-agap-feuille/10">{l.label}</a>)}
    </nav>
  </div>
</header>
<script>
  const header = document.getElementById('agap-header');
  const bg = document.getElementById('agap-bg');
  const onScroll = () => {
    const sc = window.scrollY > 40;
    if (bg) {
      bg.classList.toggle('bg-agap-lin/90', sc);
      bg.classList.toggle('backdrop-blur-md', sc);
      bg.classList.toggle('border-b', sc);
      bg.classList.toggle('border-agap-feuille/10', sc);
    }
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  const burger = document.getElementById('agap-burger');
  const mob = document.getElementById('agap-mobile');
  burger?.addEventListener('click', () => mob?.classList.toggle('hidden'));
  mob?.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mob?.classList.add('hidden')));
</script>
