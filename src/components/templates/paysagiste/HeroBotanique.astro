---
/**
 * HeroBotanique — composition florale.
 * Mobile : tagline + petite photo + CTA.
 * Desktop : grille 7/5 — texte à gauche avec ornements floraux SVG
 * flottants, photo principale CIRCULAIRE à droite (≠ rectangles
 * des autres templates) avec petite photo secondaire fleurs en
 * collage.
 */
import data from '../../../data/templates/agapanthes.json';
---

<section class="relative isolate overflow-hidden bg-agap-lin pt-28 md:pt-32 pb-20 md:pb-32 px-6 md:px-10">

  <!-- Ornements SVG floraux décoratifs (desktop) -->
  <svg class="hidden lg:block absolute top-32 left-6 w-24 h-24 text-agap-sauge/35" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <path d="M50 10 Q 60 30, 80 30 Q 60 35, 60 50 Q 50 35, 40 50 Q 40 35, 20 30 Q 40 30, 50 10z" />
  </svg>
  <svg class="hidden lg:block absolute bottom-20 right-12 w-32 h-32 text-agap-rose/45 rotate-45" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <circle cx="50" cy="30" r="14" opacity="0.85"/>
    <circle cx="32" cy="55" r="14" opacity="0.85"/>
    <circle cx="68" cy="55" r="14" opacity="0.85"/>
    <circle cx="42" cy="75" r="11" opacity="0.85"/>
    <circle cx="58" cy="75" r="11" opacity="0.85"/>
  </svg>

  <div class="relative max-w-content mx-auto grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

    <!-- Colonne texte gauche (7) -->
    <div class="lg:col-span-7 relative">
      <p class="hero-eyebrow flex items-center gap-3 text-xs font-outfit font-medium uppercase tracking-[0.32em] text-agap-violet">
        <span class="block w-8 h-px bg-agap-violet" aria-hidden="true"></span>
        <span>Atelier paysagiste · La Réunion</span>
      </p>

      <!-- Tagline en deux lignes Cormorant — italique sur la 2e -->
      <h1 class="hero-title mt-6 sm:mt-8 font-cormorant text-agap-feuille leading-[0.94] tracking-tight" style="font-size: clamp(60px, 11vw, 140px);">
        <span class="block font-medium">{data.info.tagline}</span>
        <span class="block italic font-medium text-agap-violet">{data.info.taglineItalic}</span>
      </h1>

      <p class="hero-intro mt-8 max-w-xl font-outfit text-agap-feuille/75 leading-[1.75]" style="font-size: clamp(15.5px, 1.6vw, 17.5px);">
        {data.info.intro}
      </p>

      <ul class="hero-intro mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-[11px] font-outfit font-medium uppercase tracking-[0.22em] text-agap-feuille/60">
        <li class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-agap-violet" aria-hidden="true"></span>Conception & entretien</li>
        <li class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-agap-violet" aria-hidden="true"></span>Plantes endémiques</li>
        <li class="inline-flex items-center gap-2"><span class="w-1.5 h-1.5 rounded-full bg-agap-violet" aria-hidden="true"></span>Île de La Réunion</li>
      </ul>

      <!-- 2 CTA -->
      <div class="hero-cta mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4">
        <a
          href="#devis"
          class="inline-flex items-center justify-center h-14 px-7 text-sm font-outfit font-semibold uppercase tracking-[0.2em] rounded-full bg-agap-violet text-agap-lin hover:bg-agap-violet-fonce transition-colors"
          style="box-shadow: 0 12px 32px rgb(107 91 149 / 0.30);"
        >
          Devis jardin · gratuit
        </a>
        <a
          href="#realisations"
          class="inline-flex items-center justify-center h-14 px-7 text-sm font-outfit font-semibold uppercase tracking-[0.2em] rounded-full bg-transparent text-agap-feuille ring-1 ring-agap-feuille/30 hover:ring-agap-violet hover:text-agap-violet transition-colors"
        >
          Voir nos jardins
        </a>
      </div>
    </div>

    <!-- Colonne composition graphique droite (5) — herbier tropical SVG -->
    <div class="hero-photo lg:col-span-5 relative">
      <figure class="relative mx-auto max-w-[420px] lg:max-w-none" aria-label="Composition botanique tropicale réunionnaise">
        <!-- Cercle décoratif violet derrière, décalé -->
        <div class="hidden lg:block absolute -top-4 -left-4 w-full h-full rounded-full ring-1 ring-agap-violet/40 pointer-events-none" aria-hidden="true"></div>

        <!-- Disque pastel lin/sauge avec composition botanique SVG -->
        <div class="relative overflow-hidden rounded-full border border-agap-violet/15 bg-gradient-to-br from-agap-lin via-agap-lin to-agap-sauge/25" style="aspect-ratio: 1/1;">
          <svg viewBox="0 0 400 400" class="absolute inset-0 w-full h-full" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
            <!-- Sol — terre rouge réunionnaise discrète -->
            <ellipse cx="200" cy="370" rx="170" ry="22" class="fill-agap-rose/35" />
            <!-- Palme (gauche) -->
            <g class="text-agap-feuille" fill="currentColor">
              <path d="M120 360 Q 118 280 90 210 Q 84 196 100 200 Q 122 210 130 250 Q 138 230 158 222 Q 152 248 138 270 Q 156 264 174 278 Q 156 286 138 290 Q 150 312 144 340 Q 132 322 124 304 Z" opacity="0.85"/>
              <path d="M120 360 L 120 230" stroke="currentColor" stroke-width="2" fill="none" opacity="0.6"/>
            </g>
            <!-- Fougère (centre arrière) -->
            <g class="text-agap-sauge" fill="currentColor" transform="translate(200 360)">
              <path d="M0 0 Q -2 -60 -10 -120 Q -14 -150 -6 -170" stroke="currentColor" stroke-width="2.5" fill="none"/>
              <g opacity="0.85">
                <ellipse cx="-6" cy="-30" rx="14" ry="5" transform="rotate(-22 -6 -30)"/>
                <ellipse cx="6" cy="-30" rx="14" ry="5" transform="rotate(22 6 -30)"/>
                <ellipse cx="-7" cy="-55" rx="13" ry="4.5" transform="rotate(-22 -7 -55)"/>
                <ellipse cx="7" cy="-55" rx="13" ry="4.5" transform="rotate(22 7 -55)"/>
                <ellipse cx="-8" cy="-78" rx="11" ry="4" transform="rotate(-22 -8 -78)"/>
                <ellipse cx="8" cy="-78" rx="11" ry="4" transform="rotate(22 8 -78)"/>
                <ellipse cx="-9" cy="-100" rx="9" ry="3.5" transform="rotate(-22 -9 -100)"/>
                <ellipse cx="9" cy="-100" rx="9" ry="3.5" transform="rotate(22 9 -100)"/>
                <ellipse cx="-9" cy="-122" rx="7" ry="3" transform="rotate(-22 -9 -122)"/>
                <ellipse cx="9" cy="-122" rx="7" ry="3" transform="rotate(22 9 -122)"/>
                <ellipse cx="-8" cy="-142" rx="5" ry="2.5" transform="rotate(-22 -8 -142)"/>
                <ellipse cx="8" cy="-142" rx="5" ry="2.5" transform="rotate(22 8 -142)"/>
              </g>
            </g>
            <!-- Agapanthe (droite) — tige et ombelle violette -->
            <g transform="translate(290 360)">
              <line x1="0" y1="0" x2="-4" y2="-180" stroke="currentColor" class="text-agap-feuille" stroke-width="2.5" opacity="0.75"/>
              <g transform="translate(-4 -180)" class="text-agap-violet" fill="currentColor">
                <circle cx="0" cy="0" r="6" opacity="0.85"/>
                <circle cx="-14" cy="-6" r="5.5" opacity="0.85"/>
                <circle cx="14" cy="-6" r="5.5" opacity="0.85"/>
                <circle cx="-9" cy="-18" r="5" opacity="0.85"/>
                <circle cx="9" cy="-18" r="5" opacity="0.85"/>
                <circle cx="0" cy="-22" r="5.5" opacity="0.85"/>
                <circle cx="-18" cy="6" r="5" opacity="0.85"/>
                <circle cx="18" cy="6" r="5" opacity="0.85"/>
                <circle cx="-6" cy="10" r="5" opacity="0.85"/>
                <circle cx="6" cy="10" r="5" opacity="0.85"/>
              </g>
              <!-- Longue feuille linéaire -->
              <path d="M0 0 Q -20 -90 -10 -170" stroke="currentColor" class="text-agap-feuille" stroke-width="3" fill="none" opacity="0.55"/>
              <path d="M0 0 Q 20 -90 12 -170" stroke="currentColor" class="text-agap-feuille" stroke-width="3" fill="none" opacity="0.55"/>
            </g>
            <!-- Petite feuille de monstera flottante en haut -->
            <g transform="translate(110 110)" class="text-agap-feuille" fill="currentColor" opacity="0.55">
              <path d="M0 0 Q 30 -10 50 10 Q 55 30 35 45 Q 10 45 -5 25 Z"/>
              <circle cx="20" cy="15" r="4" fill="#f5f1e8"/>
              <circle cx="32" cy="25" r="3.5" fill="#f5f1e8"/>
            </g>
          </svg>
        </div>

        <!-- Petite étiquette manuscrite au-dessus -->
        <span class="absolute -top-3 left-4 sm:-left-3 inline-flex items-center px-3 h-8 bg-agap-lin border border-agap-violet/30 font-cormorant italic text-agap-violet text-sm" aria-hidden="true">
          ✦ La Réunion · 2011
        </span>

        <!-- Petite carte botanique en collage (cercle) — fleur d'agapanthe stylisée -->
        <span class="absolute -bottom-4 -right-2 sm:-right-4 w-28 sm:w-36 lg:w-44 aspect-square rounded-full overflow-hidden border-4 border-agap-lin shadow-lg bg-agap-violet/15 flex items-center justify-center" aria-hidden="true">
          <svg viewBox="0 0 100 100" class="w-3/4 h-3/4 text-agap-violet" fill="currentColor">
            <g opacity="0.9">
              <ellipse cx="50" cy="30" rx="9" ry="6"/>
              <ellipse cx="36" cy="40" rx="9" ry="6"/>
              <ellipse cx="64" cy="40" rx="9" ry="6"/>
              <ellipse cx="42" cy="55" rx="9" ry="6"/>
              <ellipse cx="58" cy="55" rx="9" ry="6"/>
              <ellipse cx="50" cy="48" rx="9" ry="6"/>
            </g>
            <line x1="50" y1="60" x2="50" y2="92" stroke="currentColor" stroke-width="2.5" opacity="0.7"/>
          </svg>
        </span>
      </figure>
    </div>
  </div>
</section>

<style>
  @keyframes agap-rise {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes agap-fade {
    from { opacity: 0; transform: scale(0.94) rotate(-2deg); }
    to   { opacity: 1; transform: scale(1) rotate(0); }
  }

  .hero-eyebrow { animation: agap-rise 800ms cubic-bezier(0.16, 1, 0.3, 1) backwards;  animation-delay: 200ms; }
  .hero-title   { animation: agap-rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: 350ms; }
  .hero-intro   { animation: agap-rise 800ms cubic-bezier(0.16, 1, 0.3, 1) backwards;  animation-delay: 600ms; }
  .hero-cta     { animation: agap-rise 700ms cubic-bezier(0.16, 1, 0.3, 1) backwards;  animation-delay: 800ms; }
  .hero-photo   { animation: agap-fade 1200ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: 450ms; }

  @media (prefers-reduced-motion: reduce) {
    .hero-eyebrow, .hero-title, .hero-intro, .hero-cta, .hero-photo {
      animation: none !important; opacity: 1; transform: none !important;
    }
  }
</style>
