---
import data from '../../../data/templates/agapanthes.json';
const steps = data.process;
---
<section class="relative bg-agap-pierre/30 text-agap-feuille py-24 lg:py-36">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-agap-violet"></span>
        <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">05 — Méthode</span>
      </div>
      <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1]">
        Six étapes,<br/><em class="italic text-agap-violet">de la conversation au jardin.</em>
      </h2>
    </div>

    <div class="relative">
      <!-- Ligne timeline -->
      <div class="hidden lg:block absolute top-12 left-0 right-0 h-px bg-agap-feuille/15"></div>
      <ol class="grid md:grid-cols-2 lg:grid-cols-6 gap-6 lg:gap-4">
        {steps.map((st, i) => (
          <li class="relative">
            <div class="hidden lg:block absolute top-12 left-0 w-4 h-4 rounded-full bg-agap-violet ring-4 ring-agap-lin"></div>
            <div class="lg:pt-24">
              <div class="font-cormorant text-5xl italic text-agap-violet leading-none">{st.n}</div>
              <h3 class="mt-3 font-cormorant text-2xl text-agap-feuille">{st.titre}</h3>
              <p class="mt-3 font-manrope text-sm leading-relaxed text-agap-feuille/65">{st.texte}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
