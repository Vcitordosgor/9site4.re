---
/**
 * Process — 5 étapes de la création paysagère.
 * Style botanique : sauge + violet, numéros calligraphiés.
 */
const steps = [
  { num: 'I', titre: 'Première visite', desc: 'Sur le terrain, à n\'importe quelle heure. On regarde la lumière, le vent, le sol. On vous écoute parler du lieu.' },
  { num: 'II', titre: 'Esquisse à la main', desc: 'Quelques jours plus tard, une planche dessinée : grandes lignes, ambiances, intuitions. Pas encore d\'arbres précis.' },
  { num: 'III', titre: 'Choix botanique', desc: 'Plantes endémiques d\'abord, exotiques compatibles ensuite. On valide ensemble palette, hauteurs, saisons de floraison.' },
  { num: 'IV', titre: 'Plantation', desc: 'Travaux du sol, irrigation, mise en terre des sujets. Calendrier respecté, suivi photo hebdomadaire.' },
  { num: 'V', titre: 'Accompagnement', desc: 'Premières trois années suivies : taille, fertilisation, ajustements. Le jardin trouve son rythme.' },
];
---

<section id="processus" class="relative bg-agap-pierre/40 py-20 md:py-28 px-6 md:px-10 border-y border-agap-sauge-fonce/20">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="scroll-reveal text-xs font-outfit font-medium uppercase tracking-[0.32em] text-agap-violet">
        Notre méthode
      </p>
      <h2 class="scroll-reveal mt-4 font-cormorant text-agap-feuille leading-[1.05]" style="font-size: clamp(36px, 5vw, 60px);">
        Cinq saisons,<br/>
        <span class="italic font-medium text-agap-violet">cinq gestes.</span>
      </h2>
    </header>

    <ol class="grid md:grid-cols-5 gap-x-6 gap-y-12 relative">
      <span class="hidden md:block absolute top-12 left-12 right-12 h-px bg-agap-sauge-fonce/30" aria-hidden="true"></span>

      {steps.map((s, i) => (
        <li class="scroll-reveal relative flex flex-col items-center text-center" style={`transition-delay: ${i * 80}ms`}>
          <span class="relative z-10 inline-flex items-center justify-center w-24 h-24 rounded-full bg-agap-lin border-2 border-agap-violet font-cormorant italic font-semibold text-agap-violet" style="font-size: 38px;">
            {s.num}
          </span>
          <h3 class="mt-6 font-cormorant font-medium text-agap-feuille leading-tight" style="font-size: 24px;">
            {s.titre}
          </h3>
          <p class="mt-3 font-outfit text-agap-feuille/70 leading-[1.65] max-w-xs" style="font-size: 14.5px;">
            {s.desc}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
