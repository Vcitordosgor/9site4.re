---
import data from '../../../data/templates/agapanthes.json';
---
<section class="relative bg-agap-lin text-agap-feuille py-24 lg:py-36 overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]" style="background-image: radial-gradient(#3D2E5E 1px, transparent 1px); background-size: 24px 24px;"></div>
  <div class="relative max-w-4xl mx-auto px-6 lg:px-12 text-center">
    <div class="flex items-center justify-center gap-3 mb-8">
      <span class="inline-block w-10 h-px bg-agap-violet"></span>
      <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">Manifeste</span>
      <span class="inline-block w-10 h-px bg-agap-violet"></span>
    </div>
    <p class="font-cormorant font-light text-[clamp(1.75rem,4vw,3.25rem)] leading-[1.25] italic text-agap-feuille">
      « {data.manifeste} »
    </p>
  </div>
</section>
