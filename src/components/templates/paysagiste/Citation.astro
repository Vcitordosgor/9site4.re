---
/**
 * Citation — extrait botanique éditorial fond sauge, italique large.
 */
---

<section class="relative bg-agap-sauge text-agap-feuille py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <svg class="hidden lg:block absolute top-12 right-12 w-32 h-32 text-agap-lin/30" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true">
    <path d="M50 10 Q 60 30, 80 30 Q 60 35, 60 50 Q 50 35, 40 50 Q 40 35, 20 30 Q 40 30, 50 10z" />
  </svg>

  <div class="relative max-w-4xl mx-auto text-center">
    <span class="scroll-reveal block font-cormorant italic text-agap-lin/40 leading-none" style="font-size: clamp(120px, 18vw, 220px);" aria-hidden="true">
      &ldquo;
    </span>

    <blockquote class="scroll-reveal -mt-16 md:-mt-24 font-cormorant italic font-medium text-agap-feuille leading-[1.15] tracking-tight" style="font-size: clamp(32px, 4.8vw, 56px);">
      Un jardin ne se décore pas, il se compose.
      <span class="block mt-3 not-italic font-medium text-agap-violet">Comme une partition, lente et lue chaque mois.</span>
    </blockquote>

    <footer class="scroll-reveal mt-12 inline-flex items-center gap-3">
      <span class="block w-12 h-px bg-agap-violet" aria-hidden="true"></span>
      <p class="font-outfit uppercase tracking-[0.32em] text-agap-feuille/70 text-[11px]">
        Carnet de l'atelier
      </p>
      <span class="block w-12 h-px bg-agap-violet" aria-hidden="true"></span>
    </footer>
  </div>
</section>
