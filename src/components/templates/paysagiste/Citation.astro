---
import data from '../../../data/templates/agapanthes.json';
---
<section class="relative bg-agap-violet-fonce text-agap-lin py-24 lg:py-36 overflow-hidden">
  <svg class="absolute -left-10 -top-10 w-72 opacity-15" viewBox="0 0 200 200" aria-hidden="true">
    <path d="M100,10 Q140,80 120,180 Q100,150 100,100 Q100,80 100,10 Z" fill="#E8D4D9"/>
  </svg>
  <svg class="absolute -right-10 -bottom-10 w-80 opacity-15" viewBox="0 0 200 200" aria-hidden="true">
    <path d="M100,10 Q60,80 80,180 Q100,150 100,100 Q100,80 100,10 Z" fill="#9DAB8E"/>
  </svg>
  <div class="relative max-w-4xl mx-auto px-6 lg:px-12 text-center">
    <span class="font-cormorant text-7xl lg:text-9xl italic text-agap-rose leading-none block">"</span>
    <blockquote class="font-cormorant font-light text-3xl lg:text-5xl leading-[1.25] italic">{data.citation}</blockquote>
    <div class="mt-10 font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-lin/60">{data.citationAuteur}</div>
  </div>
</section>
