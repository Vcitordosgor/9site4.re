---
/**
 * PhotoPanorama — photo plein cadre 21/9 végétation luxuriante.
 */
---

<section class="relative bg-agap-lin px-0 py-0">
  <figure class="relative w-full overflow-hidden bg-agap-sauge" style="aspect-ratio: 21/9;">
    <img
      src="/images/paysagiste/extra-1.webp"
      alt="Végétation tropicale dense, lumière du matin"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 60%, rgb(28 36 30 / 0.55) 100%);"></div>

    <figcaption class="absolute bottom-6 md:bottom-10 left-6 md:left-12 right-6 md:right-12 flex items-baseline gap-4 text-agap-lin">
      <span class="block w-12 h-px bg-agap-lin/70 flex-shrink-0" aria-hidden="true"></span>
      <p class="font-cormorant italic" style="font-size: clamp(16px, 1.6vw, 20px);">
        La luxuriance réunionnaise, observée avant chaque dessin.
      </p>
    </figcaption>
  </figure>
</section>
