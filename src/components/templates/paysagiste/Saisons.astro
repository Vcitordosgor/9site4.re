---
import data from '../../../data/templates/agapanthes.json';
const saisons = data.saisons;
---
<section id="saisons" class="relative bg-agap-lin text-agap-feuille py-24 lg:py-36">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-agap-violet"></span>
        <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">02 — Quatre saisons péi</span>
      </div>
      <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1]">
        Le jardin change<br/><em class="italic text-agap-violet">d'humeur quatre fois par an.</em>
      </h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-6">
      {saisons.map((s, i) => (
        <article class="group relative p-7 rounded-3xl border border-agap-feuille/10 bg-agap-pierre/30 hover:bg-agap-lin hover:border-agap-violet/40 transition-all duration-500 hover:-translate-y-1">
          <div class="flex items-center justify-between mb-6">
            <span class="font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-feuille/50">0{i+1}</span>
            <span class="w-3 h-3 rounded-full" style={`background-color:${s.color}`}></span>
          </div>
          <h3 class="font-cormorant text-3xl text-agap-feuille">{s.nom}</h3>
          <div class="mt-1 font-manrope text-[11px] uppercase tracking-[0.25em]" style={`color:${s.color}`}>{s.mois}</div>
          <p class="mt-5 font-manrope text-sm leading-relaxed text-agap-feuille/70">{s.description}</p>
          <ul class="mt-6 space-y-2 font-manrope text-xs text-agap-feuille/70">
            {s.actions.map(a => (
              <li class="flex gap-2"><span class="mt-1.5 w-1 h-1 rounded-full" style={`background-color:${s.color}`}></span>{a}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
