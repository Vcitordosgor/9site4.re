---
/**
 * Pepinieres — wordmarks de pépinières / partenaires botaniques.
 * Section "ils nous fournissent les plus belles plantes".
 */
const pepinieres = [
  'Pépinière des Plaines',
  'Jardin Endémique',
  'Hauts Verts',
  'Tropic-Plantes',
  'Bambou & Co',
  'Bourbon Botanique',
];
---

<section class="relative bg-agap-sauge/30 py-16 md:py-20 px-6 md:px-10 border-y border-agap-sauge-fonce/25">
  <div class="max-w-content mx-auto">
    <p class="scroll-reveal text-center text-xs font-outfit font-medium uppercase tracking-[0.32em] text-agap-sauge-fonce">
      Pépinières & partenaires botaniques
    </p>

    <ul class="scroll-reveal mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-x-6 gap-y-8 items-center">
      {pepinieres.map((p, i) => (
        <li class="text-center" style={`transition-delay: ${i * 40}ms`}>
          <span class="block font-cormorant italic font-medium text-agap-feuille/45 hover:text-agap-feuille transition-colors" style="font-size: clamp(18px, 1.8vw, 24px);">
            {p}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
