---
import data from '../../../data/templates/agapanthes.json';
const eq = data.equipe;
---
<section id="equipe" class="relative bg-agap-lin text-agap-feuille py-24 lg:py-36">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-agap-violet"></span>
        <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">06 — L'atelier</span>
      </div>
      <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1]">
        Trois personnes,<br/><em class="italic text-agap-violet">un seul jardin à la fois.</em>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {eq.map((p, i) => (
        <article class="group flex flex-col">
          <div class="aspect-[3/4] relative rounded-3xl overflow-hidden bg-agap-pierre">
            <img src={p.photo} alt={`Portrait de ${p.nom}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"/>
            <div class="absolute bottom-0 inset-x-0 h-1/3 bg-gradient-to-t from-agap-violet-fonce/85 to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5 text-agap-lin">
              <div class="font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-rose">0{i+1}</div>
              <div class="mt-2 font-cormorant text-2xl">{p.nom}</div>
              <div class="font-manrope text-[11px] uppercase tracking-[0.22em] mt-1 text-agap-lin/70">{p.role}</div>
            </div>
          </div>
          <div class="mt-5">
            <div class="font-manrope text-[10px] uppercase tracking-[0.25em] text-agap-violet">{p.experience}</div>
            <p class="mt-2 font-manrope text-sm text-agap-feuille/70 leading-relaxed">{p.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
