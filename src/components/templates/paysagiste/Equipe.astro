---
import data from '../../../data/templates/agapanthes.json';
const eq = data.equipe;
// Une fleur SVG signature par personne (frangipanier blanc / hibiscus rouge / oiseau de paradis orange)
const fleurs = [
  { bg: 'linear-gradient(135deg,#E9E2D0 0%,#C8BFA6 100%)', accent: '#C49B62', petal: '#FFFCF5', center: '#F4C24A', name: 'Frangipanier' },
  { bg: 'linear-gradient(135deg,#7B3F3F 0%,#4A2424 100%)', accent: '#E6A8A8', petal: '#E53E3E', center: '#FBD38D', name: 'Hibiscus' },
  { bg: 'linear-gradient(135deg,#D4691A 0%,#A14010 100%)', accent: '#F4B860', petal: '#FF8C29', center: '#1B3A1F', name: 'Oiseau de paradis' },
];
---
<section id="equipe" class="relative bg-agap-lin text-agap-feuille py-24 lg:py-36">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-agap-violet"></span>
        <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">06 — L'atelier</span>
      </div>
      <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1]">
        Trois personnes,<br/><em class="italic text-agap-violet">un seul jardin à la fois.</em>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
      {eq.map((p, i) => {
        const f = fleurs[i % fleurs.length];
        return (
        <article class="group flex flex-col">
          <div class="aspect-[3/4] relative rounded-3xl overflow-hidden flex items-center justify-center transition-transform duration-700 group-hover:scale-[1.02]" style={`background:${f.bg};`}>
            <svg viewBox="0 0 200 200" class="w-3/4 h-3/4 transition-transform duration-[1500ms] ease-out group-hover:rotate-[18deg]" aria-hidden="true">
              {[0,1,2,3,4,5].map((k) => (
                <ellipse cx="100" cy="55" rx="22" ry="42" fill={f.petal} opacity="0.92" transform={`rotate(${k*60} 100 100)`} />
              ))}
              <circle cx="100" cy="100" r="18" fill={f.center} />
              <circle cx="100" cy="100" r="6" fill={f.accent} opacity="0.85" />
            </svg>
            <div class="absolute bottom-0 inset-x-0 h-1/3 bg-gradient-to-t from-agap-violet-fonce/85 to-transparent"></div>
            <div class="absolute bottom-5 left-5 right-5 text-agap-lin">
              <div class="font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-rose">0{i+1} · {f.name}</div>
              <div class="mt-2 font-cormorant text-2xl">{p.nom}</div>
              <div class="font-manrope text-[11px] uppercase tracking-[0.22em] mt-1 text-agap-lin/70">{p.role}</div>
            </div>
          </div>
          <div class="mt-5">
            <div class="font-manrope text-[10px] uppercase tracking-[0.25em] text-agap-violet">{p.experience}</div>
            <p class="mt-2 font-manrope text-sm text-agap-feuille/70 leading-relaxed">{p.bio}</p>
          </div>
        </article>
        );
      })}
    </div>
  </div>
</section>
