---
/**
 * Fourchettes — section transparente avant le bloc Devis.
 * Donne des ordres de prix lisibles pour entretien, création et élagage.
 */
const lignes = [
  { label: 'Entretien jardin', prix: '35 €', unite: '/ heure', note: 'Tonte, désherbage, arrosage. Forfait mensuel possible.' },
  { label: 'Création de terrasse', prix: '150 – 300 €', unite: '/ m²', note: 'Bois, pierre ou composite. Pose et finitions comprises.' },
  { label: 'Plantation massif', prix: '60 – 120 €', unite: '/ m²', note: 'Préparation du sol, plants, paillage. Hors achat plantes rares.' },
  { label: 'Élagage', prix: 'sur devis', unite: '', note: 'Tarif selon hauteur, accès et évacuation. Visite gratuite.' },
  { label: 'Arrosage automatique', prix: '12 – 25 €', unite: '/ m² installé', note: 'Programmateur, goutte-à-goutte ou aspersion.' },
];
---

<section id="fourchettes" class="relative bg-agap-lin py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <p class="scroll-reveal flex items-center justify-center gap-3 text-xs font-outfit font-medium uppercase tracking-[0.32em] text-agap-violet">
        <span class="block w-8 h-px bg-agap-violet" aria-hidden="true"></span>
        <span>Devis · nos fourchettes</span>
        <span class="block w-8 h-px bg-agap-violet" aria-hidden="true"></span>
      </p>
      <h2 class="scroll-reveal mt-5 font-cormorant text-agap-feuille leading-[1.05]" style="font-size: clamp(36px, 5.5vw, 60px);">
        Des ordres de prix
        <span class="block italic font-medium text-agap-violet">avant de se rencontrer.</span>
      </h2>
      <p class="scroll-reveal mt-6 font-outfit text-agap-feuille/70 leading-[1.7]">
        Les chiffres ci-dessous donnent une base de discussion honnête.
        Le devis définitif tient compte du terrain, de l'accès et du choix des végétaux.
      </p>
    </header>

    <ul class="scroll-reveal divide-y divide-agap-feuille/10 border border-agap-feuille/10 bg-agap-lin">
      {lignes.map((l) => (
        <li class="grid md:grid-cols-[1fr_auto] gap-4 md:gap-8 items-start px-6 md:px-8 py-6">
          <div>
            <p class="font-cormorant italic text-agap-feuille text-xl md:text-2xl leading-tight">{l.label}</p>
            <p class="mt-2 font-outfit text-sm text-agap-feuille/70 leading-snug">{l.note}</p>
          </div>
          <p class="font-outfit font-semibold text-agap-violet tabular-nums whitespace-nowrap text-lg md:text-xl">
            {l.prix} <span class="text-agap-feuille/55 font-normal text-sm">{l.unite}</span>
          </p>
        </li>
      ))}
    </ul>

    <p class="scroll-reveal mt-8 text-center text-sm font-outfit text-agap-feuille/65">
      Tous les tarifs s'entendent TTC. Crédit d'impôt 50 % applicable sur l'entretien de jardin chez les particuliers.
    </p>
  </div>
</section>
