---
import data from '../../../data/templates/agapanthes.json';
const f = data.formules;
---
<section class="relative bg-agap-pierre/30 text-agap-feuille py-24 lg:py-36">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="mb-16 max-w-2xl">
      <div class="flex items-center gap-3 mb-6">
        <span class="inline-block w-10 h-px bg-agap-violet"></span>
        <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">07 — Formules</span>
      </div>
      <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1]">
        Trois manières<br/><em class="italic text-agap-violet">de travailler ensemble.</em>
      </h2>
    </div>

    <div class="grid md:grid-cols-3 gap-6">
      {f.map(fo => (
        <article class={`relative p-7 lg:p-9 rounded-3xl flex flex-col transition-all duration-500 hover:-translate-y-1 ${fo.best ? 'bg-agap-violet text-agap-lin' : 'bg-agap-lin border border-agap-feuille/10'}`}>
          {fo.best && (<div class="absolute -top-3 left-7 px-3 py-1 rounded-full bg-agap-rose text-agap-violet-fonce text-[10px] font-manrope font-semibold uppercase tracking-[0.25em]">Le plus demandé</div>)}
          <h3 class="font-cormorant text-3xl lg:text-4xl">{fo.titre}</h3>
          <p class={`mt-2 font-manrope text-sm ${fo.best ? 'text-agap-lin/80' : 'text-agap-feuille/65'}`}>{fo.soustitre}</p>
          <div class="mt-6 flex items-baseline gap-2">
            <span class="font-cormorant text-5xl italic">{fo.prix}</span>
            <span class={`font-manrope text-xs ${fo.best ? 'text-agap-lin/70' : 'text-agap-feuille/55'}`}>{fo.unite}</span>
          </div>
          <ul class={`mt-8 space-y-2.5 font-manrope text-sm flex-1 ${fo.best ? 'text-agap-lin/85' : 'text-agap-feuille/75'}`}>
            {fo.inclus.map(it => (
              <li class="flex gap-2.5"><span class={`mt-2 w-1.5 h-1.5 rounded-full flex-shrink-0 ${fo.best ? 'bg-agap-rose' : 'bg-agap-violet'}`}></span>{it}</li>
            ))}
          </ul>
          <a href="#devis" class={`mt-8 inline-flex items-center justify-center h-12 rounded-full text-[11px] font-manrope font-semibold uppercase tracking-[0.22em] transition ${fo.best ? 'bg-agap-lin text-agap-violet hover:bg-agap-rose' : 'border border-agap-feuille/20 hover:bg-agap-violet hover:text-agap-lin hover:border-agap-violet'}`}>
            Demander
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
