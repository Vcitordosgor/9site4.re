---
import data from '../../../data/templates/agapanthes.json';
const r = data.realisations;
---
<section class="relative bg-agap-violet-fonce text-agap-lin py-24 lg:py-36 overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-12">
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="inline-block w-10 h-px bg-agap-rose"></span>
          <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-lin/60">03 — Réalisations</span>
        </div>
        <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1]">
          Huit jardins,<br/><em class="italic text-agap-rose">huit récits.</em>
        </h2>
      </div>
      <p class="font-manrope text-sm text-agap-lin/60 max-w-sm">Faites défiler horizontalement — chaque projet est un dessin différent.</p>
    </div>

    <div class="-mx-6 lg:-mx-12 overflow-x-auto pb-6" style="scrollbar-width: thin;">
      <div class="flex gap-4 lg:gap-6 px-6 lg:px-12 min-w-max">
        {r.map((p, i) => (
          <figure class={`group relative flex-shrink-0 ${i % 2 === 0 ? 'w-[280px] lg:w-[420px] aspect-[3/4]' : 'w-[320px] lg:w-[500px] aspect-[4/3]'} rounded-3xl overflow-hidden`}>
            <img src={p.photo} alt={p.titre} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] ease-out group-hover:scale-105"/>
            <div class="absolute inset-0 bg-gradient-to-t from-agap-violet-fonce/85 via-transparent to-transparent"></div>
            <figcaption class="absolute bottom-5 left-5 right-5 text-agap-lin">
              <div class="font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-rose/90">{String(i+1).padStart(2,'0')} · {p.type}</div>
              <div class="mt-2 font-cormorant text-2xl lg:text-3xl">{p.titre}</div>
              <div class="font-manrope text-[11px] uppercase tracking-[0.22em] mt-1 text-agap-lin/60">{p.lieu}</div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </div>
</section>
