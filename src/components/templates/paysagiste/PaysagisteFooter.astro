---
import data from '../../../data/templates/agapanthes.json';
const info = data.info;
const year = new Date().getFullYear();
---
<footer class="relative bg-agap-feuille text-agap-lin overflow-hidden">
  <div class="max-w-[1400px] mx-auto px-6 lg:px-12 py-16 lg:py-24 grid lg:grid-cols-12 gap-10">
    <div class="lg:col-span-5">
      <a href="#top" class="flex items-baseline gap-2 font-cormorant">
        <span class="text-3xl font-light italic">{info.wordmark1}</span>
        <span class="text-3xl">{info.wordmark2}</span>
      </a>
      <p class="mt-6 font-manrope text-sm text-agap-lin/65 max-w-sm leading-relaxed">{info.soustitre} · depuis {info.annee}. Jardins tropicaux pensés pour durer.</p>
      <div class="mt-8 font-cormorant italic text-xl text-agap-rose leading-snug max-w-xs">« Plante un arbre dont tu ne verras pas l'ombre. »</div>
    </div>

    <div class="lg:col-span-3">
      <div class="font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-rose mb-4">Contact</div>
      <ul class="space-y-2 font-manrope text-sm text-agap-lin/80">
        <li>{info.adresseLigne1}</li>
        <li>{info.adresseLigne2}</li>
        <li><a href={`tel:${info.telephoneHref}`} class="hover:text-agap-rose">{info.telephone}</a></li>
        <li><a href={`mailto:${info.email}`} class="hover:text-agap-rose">{info.email}</a></li>
      </ul>
    </div>

    <div class="lg:col-span-4">
      <div class="font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-rose mb-4">Horaires</div>
      <ul class="space-y-2 font-manrope text-sm text-agap-lin/80">
        {info.horaires.map(h => (
          <li class="flex justify-between gap-4 border-b border-agap-lin/10 py-1">
            <span>{h.jour}</span>
            <span class={h.ouvert ? 'text-agap-rose' : 'text-agap-lin/40'}>{h.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-agap-lin/10 py-6 text-center font-manrope text-[10px] uppercase tracking-[0.3em] text-agap-lin/40">
    © {year} {info.nom} · Atelier paysagiste · La Réunion
  </div>
</footer>
