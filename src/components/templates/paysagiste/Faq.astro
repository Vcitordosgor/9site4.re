---
import data from '../../../data/templates/agapanthes.json';
const faq = data.faq;
---
<section class="relative bg-agap-pierre/30 text-agap-feuille py-24 lg:py-36">
  <div class="max-w-[1100px] mx-auto px-6 lg:px-12">
    <div class="flex items-center gap-3 mb-6">
      <span class="inline-block w-10 h-px bg-agap-violet"></span>
      <span class="font-manrope text-[11px] uppercase tracking-[0.32em] text-agap-feuille/60">09 — Questions</span>
    </div>
    <h2 class="font-cormorant font-light text-[clamp(2.5rem,5vw,4.5rem)] leading-[1] tracking-tight max-w-3xl">
      Ce qu'on nous demande,<br/><em class="italic text-agap-violet">on y répond.</em>
    </h2>

    <div class="mt-14 divide-y divide-agap-feuille/15 border-y border-agap-feuille/15">
      {faq.map((f, i) => (
        <details class="group py-6">
          <summary class="flex items-center justify-between gap-6 cursor-pointer list-none">
            <div class="flex items-baseline gap-5">
              <span class="font-manrope text-xs text-agap-violet">{String(i+1).padStart(2,'0')}</span>
              <span class="font-cormorant text-xl lg:text-2xl">{f.q}</span>
            </div>
            <span class="w-9 h-9 rounded-full border border-agap-feuille/20 flex items-center justify-center flex-shrink-0 transition-transform group-open:rotate-45 group-open:bg-agap-violet group-open:border-agap-violet group-open:text-agap-lin">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
            </span>
          </summary>
          <p class="mt-4 ml-9 font-manrope text-base leading-relaxed text-agap-feuille/70 max-w-3xl">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
