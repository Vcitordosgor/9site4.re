---
/**
 * Faq — questions fréquentes paysagiste, ton botanique sobre.
 * Accordion natif sans dépendance.
 */
const faq = [
  {
    q: 'À quel moment faut-il commencer un projet de jardin ?',
    r: 'Idéalement avant la saison sèche (mai à septembre dans le sud, novembre à mars sur les hauts). Le sol est plus travaillable, et les plantes ont le temps de s\'enraciner avant les fortes chaleurs. On peut aussi planifier l\'étude un an à l\'avance.',
  },
  {
    q: 'Vous travaillez surtout avec des plantes endémiques ?',
    r: 'En priorité, oui. Les espèces locales — bois de joli cœur, fataque, vélo, mahot — sont mieux adaptées au climat et résistent aux cyclones. On complète avec des plantes exotiques compatibles si l\'envie est forte, sans dénaturer l\'écosystème.',
  },
  {
    q: 'Quel budget prévoir pour un jardin de 500 m² ?',
    r: 'Entre 4 000 et 12 000 € pour une création complète, selon le niveau de finition (terrassement, arrosage automatique, plantes adultes). Le devis est gratuit et détaillé poste par poste, sans surprise après signature.',
  },
  {
    q: 'Faites-vous l\'entretien après la création ?',
    r: 'Oui, sur abonnement annuel ou ponctuel. Tailles saisonnières, fertilisation organique, remplacement des sujets en cas de coup dur. La première année est suivie de près, c\'est crucial pour la reprise.',
  },
  {
    q: 'Quels types de jardins concevez-vous ?',
    r: 'Jardins de villa, terrasses, toits-terrasses, jardins méditerranéens, sec ou aquatique. On ne fait ni golf ni grands parcs publics — on reste à l\'échelle du jardin habité.',
  },
];
---

<section id="faq" class="relative bg-agap-lin py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-3xl mx-auto">

    <header class="mb-12 md:mb-14">
      <p class="scroll-reveal text-xs font-outfit font-medium uppercase tracking-[0.32em] text-agap-violet">
        Vos questions
      </p>
      <h2 class="scroll-reveal mt-4 font-cormorant text-agap-feuille leading-[1.05]" style="font-size: clamp(34px, 4.5vw, 52px);">
        Ce qu'on nous demande<br/>
        <span class="italic font-medium text-agap-violet">avant de signer.</span>
      </h2>
    </header>

    <ul class="divide-y divide-agap-feuille/15 border-y border-agap-feuille/15">
      {faq.map((item, i) => (
        <li class="scroll-reveal" style={`transition-delay: ${i * 50}ms`}>
          <details class="group agap-faq">
            <summary class="flex items-start justify-between gap-6 py-7 cursor-pointer list-none">
              <span class="font-cormorant font-medium text-agap-feuille leading-snug group-hover:text-agap-violet transition-colors" style="font-size: clamp(20px, 2vw, 24px);">
                {item.q}
              </span>
              <span class="shrink-0 mt-1 inline-flex items-center justify-center w-9 h-9 rounded-full border border-agap-feuille/25 text-agap-violet transition-transform duration-300 group-open:rotate-180" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"/>
                </svg>
              </span>
            </summary>
            <div class="pb-8 pr-14">
              <p class="font-outfit text-agap-feuille/75 leading-[1.75]" style="font-size: 15px;">
                {item.r}
              </p>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .agap-faq summary::-webkit-details-marker { display: none; }
  .agap-faq summary:focus-visible {
    outline: 2px solid rgb(107 91 149);
    outline-offset: 4px;
  }
</style>
