---
import data from '../../../data/templates/verveine.json';

const ans = new Date().getFullYear() - parseInt(data.info.annee);
const chiffres = [
  { gros: ans + '', unite: 'ans', petit: 'd\'exercice continu, au même cabinet' },
  { gros: '60', unite: 'min', petit: 'pour chaque consultation, sans exception' },
  { gros: '1-3', unite: 'séances', petit: 'suffisent souvent à régler la plainte' },
  { gros: '3', unite: 'D.U.', petit: 'pédiatrique, périnatale, sport' },
];
---

<section class="bg-verveine-papier py-20 md:py-32 relative overflow-hidden">

  <svg class="absolute -right-32 -top-32 w-[480px] h-[480px] opacity-[0.08] pointer-events-none" viewBox="0 0 200 200" fill="none" stroke="#5C5C58" stroke-width="0.7" aria-hidden="true">
    <circle cx="100" cy="100" r="90"/>
    <circle cx="100" cy="100" r="60"/>
    <circle cx="100" cy="100" r="30"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">

    <div class="text-center mb-14 md:mb-20">
      <p class="font-public-sans uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-verveine-sauge mb-4 font-medium">— Le cabinet en quelques repères —</p>
      <h2 class="font-cardo text-verveine-encre text-3xl md:text-5xl leading-tight">
        Quatre nombres
        <em class="font-cardo italic text-verveine-beton">qui posent le cadre.</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-y-14 md:gap-y-20 md:gap-x-10">
      {chiffres.map((c, i) => (
        <div class={`md:col-span-6 ${i === 1 ? 'md:translate-y-10' : ''} ${i === 2 ? 'md:-translate-y-6 md:text-right' : ''} ${i === 3 ? 'md:translate-y-4 md:text-right' : ''}`}>
          <p class="font-cardo text-verveine-encre leading-[0.85] inline-flex items-end gap-3">
            <span style="font-size:clamp(72px,14vw,150px);">{c.gros}</span>
            <span class="font-public-sans uppercase tracking-[0.2em] text-verveine-sauge text-base md:text-xl mb-3 md:mb-6 font-medium">{c.unite}</span>
          </p>
          <p class="mt-4 font-cardo italic text-verveine-beton text-lg md:text-xl leading-snug max-w-md">{c.petit}</p>
        </div>
      ))}
    </div>
  </div>
</section>
