---
const faqs = [
  { q: "Faut-il une ordonnance pour consulter un ostéopathe ?", r: "Non. L'ostéopathie est une médecine de premier recours en France. Vous pouvez consulter directement, sans passer par votre médecin traitant." },
  { q: "À partir de quel âge peut-on consulter ?", r: "Dès la naissance. L'approche du nourrisson est strictement crânio-sacrée, sans aucune manipulation forte. Très utile en cas de troubles digestifs, plagiocéphalie, troubles du sommeil." },
  { q: "Combien de séances faut-il prévoir ?", r: "Une à trois séances suffisent dans la majorité des cas. Si la plainte ne cède pas après trois consultations, je vous oriente vers le bon professionnel — kiné, médecin, spécialiste." },
  { q: "L'ostéopathie est-elle remboursée ?", r: "Pas par la Sécurité sociale, mais la plupart des mutuelles proposent un forfait annuel (souvent 3 à 5 séances). Une facture détaillée vous est remise systématiquement." },
  { q: "Peut-on consulter pendant la grossesse ?", r: "Oui, à tout moment de la grossesse. Les techniques sont strictement adaptées : positions latérales, pressions douces, manipulations crâniennes. Très utile pour les douleurs lombaires et pubiennes." },
  { q: "Quelles différences avec un kinésithérapeute ?", r: "Le kiné rééduque sur prescription, séance après séance. L'ostéopathe libère ponctuellement des restrictions de mobilité en une à trois séances. Les deux approches sont complémentaires, pas concurrentes." },
];
---

<section id="faq" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <div class="lg:col-span-4">
        <p class="font-inter text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #C9B79A;">— FAQ —</p>
        <h2 class="font-cormorant leading-[1.04] sticky top-28" style="color: #1F3A44; font-size: clamp(34px, 4vw, 52px);">
          Questions <em class="italic">fréquentes.</em>
        </h2>
      </div>

      <div class="lg:col-span-8">
        {faqs.map((f, i) => (
          <details class="group border-b py-5" style="border-color: rgba(31,58,68,0.12);" open={i === 0}>
            <summary class="cursor-pointer list-none flex items-baseline justify-between gap-4">
              <span class="font-cormorant text-xl md:text-2xl pr-4" style="color: #1F3A44;">{f.q}</span>
              <span class="font-cormorant text-2xl transition-transform group-open:rotate-45 shrink-0" style="color: #C9B79A;">+</span>
            </summary>
            <p class="mt-4 font-inter text-[14.5px] leading-relaxed" style="color: rgba(31,58,68,0.78);">
              {f.r}
            </p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
