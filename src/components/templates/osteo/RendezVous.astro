---
import data from '../../../data/templates/verveine.json';
const info = data.info;
---

<section id="rendez-vous" class="py-20 md:py-28" style="background-color: #1F3A44; color: #F7F4EE;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">

      <div class="lg:col-span-5">
        <p class="font-inter text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #C9B79A;">— Rendez-vous —</p>
        <h2 class="font-cormorant leading-[1.04]" style="font-size: clamp(34px, 5vw, 58px);">
          Réserver un <em class="italic" style="color: #C9B79A;">créneau.</em>
        </h2>
        <p class="mt-6 font-inter text-[15px] leading-relaxed" style="color: rgba(247,244,238,0.78);">
          Premier rendez-vous ? Prévoyez 5 minutes d'avance pour la fiche d'admission. Apportez vos derniers examens et prescriptions si pertinents.
        </p>

        <dl class="mt-10 space-y-5 font-inter text-[13.5px]">
          <div class="flex items-start gap-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="#C9B79A" stroke-width="1.8" class="w-5 h-5 mt-0.5 shrink-0"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div>
              <dt style="color: rgba(247,244,238,0.6);" class="text-[11px] uppercase tracking-wider mb-1">Horaires</dt>
              <dd>Lun–Ven · 09h–18h<br/>Mercredi matin · Samedi sur rdv</dd>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="#C9B79A" stroke-width="1.8" class="w-5 h-5 mt-0.5 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <div>
              <dt style="color: rgba(247,244,238,0.6);" class="text-[11px] uppercase tracking-wider mb-1">Téléphone</dt>
              <dd><a href={`tel:${info.telephoneHref}`} class="hover:text-[#C9B79A] transition-colors">{info.telephone}</a></dd>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <svg viewBox="0 0 24 24" fill="none" stroke="#C9B79A" stroke-width="1.8" class="w-5 h-5 mt-0.5 shrink-0"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <div>
              <dt style="color: rgba(247,244,238,0.6);" class="text-[11px] uppercase tracking-wider mb-1">Email</dt>
              <dd><a href={`mailto:${info.email}`} class="hover:text-[#C9B79A] transition-colors">{info.email}</a></dd>
            </div>
          </div>
        </dl>
      </div>

      <form class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4" onsubmit="event.preventDefault(); alert('Démo — formulaire non actif sur ce template.');">
        <label class="flex flex-col gap-2 sm:col-span-1">
          <span class="font-inter text-[11px] uppercase tracking-[0.2em]" style="color: rgba(247,244,238,0.7);">Nom</span>
          <input type="text" required class="h-12 px-4 font-inter text-[14px] outline-none border" style="background-color: rgba(247,244,238,0.06); color: #F7F4EE; border-color: rgba(247,244,238,0.2);" />
        </label>
        <label class="flex flex-col gap-2 sm:col-span-1">
          <span class="font-inter text-[11px] uppercase tracking-[0.2em]" style="color: rgba(247,244,238,0.7);">Prénom</span>
          <input type="text" required class="h-12 px-4 font-inter text-[14px] outline-none border" style="background-color: rgba(247,244,238,0.06); color: #F7F4EE; border-color: rgba(247,244,238,0.2);" />
        </label>
        <label class="flex flex-col gap-2 sm:col-span-1">
          <span class="font-inter text-[11px] uppercase tracking-[0.2em]" style="color: rgba(247,244,238,0.7);">Téléphone</span>
          <input type="tel" required class="h-12 px-4 font-inter text-[14px] outline-none border" style="background-color: rgba(247,244,238,0.06); color: #F7F4EE; border-color: rgba(247,244,238,0.2);" />
        </label>
        <label class="flex flex-col gap-2 sm:col-span-1">
          <span class="font-inter text-[11px] uppercase tracking-[0.2em]" style="color: rgba(247,244,238,0.7);">Email</span>
          <input type="email" required class="h-12 px-4 font-inter text-[14px] outline-none border" style="background-color: rgba(247,244,238,0.06); color: #F7F4EE; border-color: rgba(247,244,238,0.2);" />
        </label>
        <label class="flex flex-col gap-2 sm:col-span-2">
          <span class="font-inter text-[11px] uppercase tracking-[0.2em]" style="color: rgba(247,244,238,0.7);">Motif de consultation (facultatif)</span>
          <textarea rows="5" class="px-4 py-3 font-inter text-[14px] outline-none border resize-none" style="background-color: rgba(247,244,238,0.06); color: #F7F4EE; border-color: rgba(247,244,238,0.2);"></textarea>
        </label>
        <button type="submit" class="sm:col-span-2 inline-flex items-center justify-center h-12 font-inter font-medium text-[12px] uppercase tracking-[0.25em] transition-colors" style="background-color: #C9B79A; color: #1F3A44;">
          Demander un rendez-vous
        </button>
        <p class="sm:col-span-2 font-inter italic text-[11.5px]" style="color: rgba(247,244,238,0.55);">
          Confidentialité absolue. Réponse sous 24 h ouvrées.
        </p>
      </form>

    </div>
  </div>
</section>
