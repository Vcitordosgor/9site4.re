---
import data from '../../../data/templates/verveine.json';
---

<section class="bg-verveine-encre text-verveine-creme py-28 md:py-40 px-6 md:px-10 relative overflow-hidden">
  <div class="absolute top-10 left-10 right-10 h-px bg-verveine-sauge/40" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-10 right-10 h-px bg-verveine-sauge/40" aria-hidden="true"></div>
  <div class="max-w-4xl mx-auto relative text-center">
    <p class="font-public-sans text-[10px] uppercase tracking-[0.42em] text-verveine-sauge mb-10">
      — approche —
    </p>
    <blockquote class="font-cardo italic text-verveine-creme leading-[1.15]" style="font-size:clamp(28px,5vw,56px);">
      « Une consultation n'est pas un rendez-vous comme un autre. Elle suppose du temps, une écoute, une remise en mouvement progressive. »
    </blockquote>
    <div class="mt-12 flex items-center justify-center gap-4" aria-hidden="true">
      <span class="block w-14 h-px bg-verveine-sauge"></span>
      <span class="font-cardo italic text-verveine-sauge text-xl">H.</span>
      <span class="block w-14 h-px bg-verveine-sauge"></span>
    </div>
    <p class="mt-6 font-public-sans text-[11px] uppercase tracking-[0.32em] text-verveine-glacier">
      Cabinet Verveine · ostéopathie · {data.info.adeli}
    </p>
  </div>
</section>
