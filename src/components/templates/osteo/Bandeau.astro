---
import data from '../../../data/templates/verveine.json';
---

<section aria-label="Rendez-vous" class="bg-verveine-sauge text-verveine-encre py-6 md:py-7">
  <div class="max-w-content mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
    <div class="flex items-center gap-3">
      <span class="font-cardo italic text-2xl md:text-3xl text-verveine-encre leading-none">Sur rendez-vous</span>
      <span class="hidden md:inline font-public-sans text-[11px] uppercase tracking-[0.3em] text-verveine-encre/75">consultation 50 min · adulte / enfant / nourrisson</span>
    </div>
    <p class="font-cardo italic text-verveine-encre text-base md:text-lg text-center">
      L'ostéopathie, dans le calme et le détail.
    </p>
    <a
      href={`tel:${data.info.telephoneHref}`}
      class="inline-flex items-center justify-center h-11 px-6 bg-verveine-encre text-verveine-creme font-public-sans font-medium text-[11.5px] uppercase tracking-[0.22em] rounded-full hover:bg-verveine-beton transition-colors tabular-nums"
    >
      0692 12 34 56
    </a>
  </div>
</section>
