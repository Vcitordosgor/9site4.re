---
/**
 * Mutuelle — tableau indicatif de remboursement.
 * Labels génériques, montants indicatifs. Le cabinet remet une facture
 * conforme à transmettre à la mutuelle.
 */

const mutuelles = [
  { nom: 'MGEN', forfait: 'jusqu’à 40€', seances: '4 / an' },
  { nom: 'Harmonie', forfait: 'jusqu’à 50€', seances: '3 / an' },
  { nom: 'MAAF', forfait: 'jusqu’à 35€', seances: '5 / an' },
  { nom: 'Allianz', forfait: 'jusqu’à 60€', seances: '3 / an' },
  { nom: 'Malakoff', forfait: 'jusqu’à 45€', seances: '4 / an' },
  { nom: 'Swiss Life', forfait: 'jusqu’à 50€', seances: '4 / an' },
];
---

<section id="mutuelle" class="bg-verveine-papier py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="max-w-2xl mb-10 md:mb-14">
      <p class="font-karla text-[10px] uppercase tracking-[0.32em] text-verveine-beton mb-5">
        Remboursement
      </p>
      <h2 class="font-cardo text-verveine-encre leading-[1.1]" style="font-size: clamp(32px, 4.5vw, 48px);">
        Votre mutuelle prend
        <span class="italic text-verveine-sauge">souvent en charge.</span>
      </h2>
      <p class="mt-5 font-cardo italic text-verveine-beton text-base md:text-lg leading-relaxed">
        La consultation n’est pas remboursée par la Sécurité sociale,
        mais la plupart des complémentaires santé proposent un forfait
        annuel ostéopathie. Une facture conforme vous est remise à la fin
        de chaque séance.
      </p>
    </header>

    <div class="overflow-x-auto border border-verveine-encre/15 bg-white">
      <table class="w-full text-left font-public-sans text-sm">
        <thead class="bg-verveine-sauge/10 text-verveine-encre">
          <tr>
            <th scope="col" class="px-5 py-4 font-medium uppercase tracking-[0.18em] text-[11px]">Mutuelle</th>
            <th scope="col" class="px-5 py-4 font-medium uppercase tracking-[0.18em] text-[11px]">Forfait / séance</th>
            <th scope="col" class="px-5 py-4 font-medium uppercase tracking-[0.18em] text-[11px]">Séances / an</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-verveine-encre/10">
          {mutuelles.map((m) => (
            <tr>
              <th scope="row" class="px-5 py-4 font-cardo text-verveine-encre text-base font-normal">
                {m.nom}
              </th>
              <td class="px-5 py-4 tabular-nums text-verveine-encre/85">{m.forfait}</td>
              <td class="px-5 py-4 tabular-nums text-verveine-encre/85">{m.seances}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="mt-5 font-karla text-[11px] text-verveine-beton italic leading-relaxed">
      Montants indicatifs, susceptibles d’évoluer selon votre contrat.
      Vérifiez les conditions exactes auprès de votre mutuelle.
    </p>
  </div>
</section>
