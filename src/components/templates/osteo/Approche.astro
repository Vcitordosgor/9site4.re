---
import data from '../../../data/templates/verveine.json';
const etapes = [
  { num: '01', titre: 'Écouter', texte: "Anamnèse précise : antécédents, mode de vie, contexte d'apparition de la plainte. On comprend avant de toucher." },
  { num: '02', titre: 'Examiner', texte: 'Tests posturaux, palpation, mobilité articulaire et viscérale. On identifie les vraies zones à traiter, pas seulement la zone douloureuse.' },
  { num: '03', titre: 'Traiter', texte: 'Techniques fonctionnelles, viscérales ou crânio-sacrées selon ce qui est indiqué. Toujours dans le respect du confort.' },
];
---

<section id="approche" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="max-w-3xl mb-14 md:mb-20">
      <p class="font-inter text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #C9B79A;">— Méthode —</p>
      <h2 class="font-cormorant leading-[1.04]" style="color: #1F3A44; font-size: clamp(34px, 5vw, 58px);">
        Trois temps simples, <em class="italic">pour une séance utile.</em>
      </h2>
      <p class="mt-6 font-inter text-[15px] leading-relaxed" style="color: rgba(31,58,68,0.75);">
        {data.approche.intro}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background-color: rgba(31,58,68,0.12);">
      {etapes.map((e) => (
        <article class="p-8 md:p-10 flex flex-col gap-5" style="background-color: #FFFFFF;">
          <div class="flex items-baseline justify-between">
            <span class="font-cormorant italic text-5xl md:text-6xl leading-none" style="color: #C9B79A;">{e.num}</span>
            <span class="block w-12 h-px" style="background-color: #1F3A44;"></span>
          </div>
          <h3 class="font-cormorant text-2xl md:text-3xl" style="color: #1F3A44;">{e.titre}</h3>
          <p class="font-inter text-[14px] leading-relaxed" style="color: rgba(31,58,68,0.72);">{e.texte}</p>
        </article>
      ))}
    </div>
  </div>
</section>
