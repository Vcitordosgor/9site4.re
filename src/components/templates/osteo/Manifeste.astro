<section class="bg-verveine-encre text-verveine-creme py-24 md:py-40 relative overflow-hidden">

  <div class="absolute top-12 left-1/2 -translate-x-1/2 flex items-center gap-4 opacity-60" aria-hidden="true">
    <span class="block w-16 md:w-24 h-px bg-verveine-sauge"></span>
    <span class="text-verveine-sauge text-lg">◦</span>
    <span class="block w-16 md:w-24 h-px bg-verveine-sauge"></span>
