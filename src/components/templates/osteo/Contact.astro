---
import data from '../../../data/templates/verveine.json';
const info = data.info;
---

<section id="contact" class="py-20 md:py-28" style="background-color: #F7F4EE;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end mb-14">
      <div class="md:col-span-7">
        <p class="font-inter text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #C9B79A;">— Trouver le cabinet —</p>
        <h2 class="font-cormorant leading-[1.04]" style="color: #1F3A44; font-size: clamp(34px, 5vw, 56px);">
          {info.adresseLigne1}
        </h2>
        <p class="mt-3 font-cormorant italic text-2xl" style="color: rgba(31,58,68,0.7);">{info.adresseLigne2}</p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px" style="background-color: rgba(31,58,68,0.12);">
      {data.acces.map((a) => (
        <div class="p-7 md:p-8 flex flex-col gap-2" style="background-color: #FFFFFF;">
          <p class="font-inter text-[11px] uppercase tracking-[0.25em]" style="color: #C9B79A;">{a.label}</p>
          <p class="font-cormorant text-xl md:text-2xl leading-snug" style="color: #1F3A44;">{a.detail}</p>
        </div>
      ))}
    </div>

    <div class="mt-10 grid grid-cols-1 md:grid-cols-7 gap-px" style="background-color: rgba(31,58,68,0.12);">
      {data.horaires.map((h) => (
        <div class="p-4 md:p-5 text-center" style={`background-color: ${h.ouvert ? '#FFFFFF' : '#F7F4EE'};`}>
          <p class="font-inter text-[10px] uppercase tracking-[0.22em] mb-2" style="color: rgba(31,58,68,0.55);">{h.jour}</p>
          <p class="font-cormorant text-base md:text-lg" style={`color: ${h.ouvert ? '#1F3A44' : 'rgba(31,58,68,0.45)'};`}>{h.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>
