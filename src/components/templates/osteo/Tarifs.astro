---
import data from '../../../data/templates/verveine.json';
---

<section id="tarifs" class="py-20 md:py-28" style="background-color: #F7F4EE;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="max-w-2xl mb-14">
      <p class="font-inter text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #C9B79A;">— Tarifs —</p>
      <h2 class="font-cormorant leading-[1.04]" style="color: #1F3A44; font-size: clamp(34px, 5vw, 56px);">
        Une consultation, <em class="italic">un tarif clair.</em>
      </h2>
      <p class="mt-5 font-inter text-[14.5px] leading-relaxed" style="color: rgba(31,58,68,0.75);">
        {data.remboursement}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px" style="background-color: rgba(31,58,68,0.12);">
      {data.tarifs.map((t) => (
        <div class="p-7 md:p-8 flex flex-col gap-3" style="background-color: #FFFFFF;">
          <p class="font-inter text-[11px] uppercase tracking-[0.25em]" style="color: rgba(31,58,68,0.55);">{t.note}</p>
          <p class="font-cormorant text-lg md:text-xl" style="color: #1F3A44;">{t.label}</p>
          <p class="mt-auto font-cormorant text-4xl md:text-5xl leading-none" style="color: #C9B79A;">{t.prix}</p>
        </div>
      ))}
    </div>

    <p class="mt-8 font-inter text-[12px] italic" style="color: rgba(31,58,68,0.6);">
      Règlement espèces, chèque ou carte. Facture détaillée pour votre mutuelle remise systématiquement.
    </p>
  </div>
</section>
