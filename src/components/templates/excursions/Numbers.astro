---
/**
 * Numbers — chiffres clés guide / sentiers réunionnais.
 * Tinos italique, mono altimétrique.
 */
const stats = [
  { value: '12', unit: 'ans', label: 'Sur les sentiers de l\'île' },
  { value: '180+', unit: 'sorties', label: 'Encadrées chaque année' },
  { value: '8', unit: 'cirques', label: 'Régulièrement parcourus' },
  { value: '3070m', unit: 'altitude', label: 'Au sommet du Piton, plusieurs fois par mois' },
];
---

<section class="relative bg-sentiers-foret text-sentiers-brume py-20 md:py-28 px-6 md:px-10 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-[0.08]" aria-hidden="true"
       style="background-image: repeating-linear-gradient(0deg, rgb(217 224 218 / 0.4) 0 1px, transparent 1px 80px);">
  </div>

  <div class="relative max-w-content mx-auto">

    <header class="mb-14 md:mb-16 max-w-2xl">
      <p class="scroll-reveal font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-sentiers-soleil">
        Carnet d'altitude
      </p>
      <h2 class="scroll-reveal mt-4 font-tinos text-sentiers-brume leading-[1.05]" style="font-size: clamp(34px, 4.8vw, 56px);">
        Des sentiers en chiffres,<br/>
        <span class="italic text-sentiers-soleil">le reste en silence.</span>
      </h2>
    </header>

    <!-- SIGNATURE : tracé de sentier qui se dessine -->
    <figure class="mb-14 md:mb-16 max-w-3xl" aria-hidden="true">
      <svg viewBox="0 0 800 140" class="w-full h-auto" preserveAspectRatio="none">
        <path
          d="M10,110 C80,108 110,100 150,80 C190,60 220,75 270,70 C320,65 350,40 410,32 C470,24 510,55 560,50 C610,45 650,18 720,16 L790,12"
          fill="none"
          stroke="#F5D78A"
          stroke-width="2.4"
          stroke-linecap="round"
          stroke-dasharray="6 7"
          class="sentier-trace"
        />
        <circle cx="10" cy="110" r="5" fill="#F5D78A" class="sentier-pin"/>
        <circle cx="790" cy="12" r="6" fill="#B85A3D" stroke="#F5D78A" stroke-width="1.5" class="sentier-pin sentier-pin-end"/>
        <text x="22" y="128" font-family="ui-monospace, monospace" font-size="11" fill="#F5D78A" opacity="0.75">Départ · 1 580 m</text>
        <text x="788" y="6" font-family="ui-monospace, monospace" font-size="11" fill="#F5D78A" text-anchor="end" opacity="0.75">Sommet · 3 070 m</text>
      </svg>
    </figure>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-8">
      {stats.map((s, i) => (
        <li class="scroll-reveal border-l border-sentiers-soleil/40 pl-5" style={`transition-delay: ${i * 80}ms`}>
          <span class="block font-tinos italic font-bold text-sentiers-brume leading-[0.88] tabular-nums" style="font-size: clamp(56px, 9vw, 130px);">
            {s.value}
          </span>
          <span class="mt-4 block font-roboto-mono uppercase tracking-[0.28em] text-sentiers-soleil text-[11px]">
            {s.unit}
          </span>
          <p class="mt-2 font-familjen text-sentiers-brume/70 leading-snug" style="font-size: 14.5px;">
            {s.label}
          </p>
        </li>
      ))}
    </ul>
  </div>

  <style>
    .sentier-trace {
      stroke-dashoffset: 1100;
      stroke-dasharray: 1100;
      transition: stroke-dashoffset 2.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .sentier-trace.is-in {
      stroke-dashoffset: 0;
      stroke-dasharray: 6 7;
    }
    .sentier-pin { opacity: 0; transition: opacity 600ms ease 1.8s; }
    .is-in ~ .sentier-pin, .sentier-trace.is-in + .sentier-pin { opacity: 1; }
    .sentier-pin-end { animation: sentier-pin-pulse 2s ease-in-out infinite 2s; transform-origin: center; transform-box: fill-box; }
    @keyframes sentier-pin-pulse {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.3); }
    }
    @media (prefers-reduced-motion: reduce) {
      .sentier-trace { transition: none; stroke-dashoffset: 0; stroke-dasharray: 6 7; }
      .sentier-pin { opacity: 1; animation: none; }
    }
  </style>

  <script>
    (function(){
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const paths = document.querySelectorAll<SVGPathElement>('.sentier-trace');
      const pins = document.querySelectorAll<SVGElement>('.sentier-pin');
      if (reduce) { paths.forEach(p => p.classList.add('is-in')); pins.forEach(p => (p as any).style.opacity = '1'); return; }
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            (e.target as SVGPathElement).classList.add('is-in');
            pins.forEach(pin => (pin as any).style.opacity = '1');
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.35 });
      paths.forEach(p => io.observe(p));
    })();
  </script>
</section>
