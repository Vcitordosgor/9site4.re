---
/**
 * Numbers — chiffres clés guide / sentiers réunionnais.
 * Tinos italique, mono altimétrique.
 */
const stats = [
  { value: '12', unit: 'ans', label: 'Sur les sentiers de l\'île' },
  { value: '180+', unit: 'sorties', label: 'Encadrées chaque année' },
  { value: '8', unit: 'cirques', label: 'Régulièrement parcourus' },
  { value: '3070m', unit: 'altitude', label: 'Au sommet du Piton, plusieurs fois par mois' },
];
---

<section class="relative bg-sentiers-foret text-sentiers-brume py-20 md:py-28 px-6 md:px-10 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-[0.08]" aria-hidden="true"
       style="background-image: repeating-linear-gradient(0deg, rgb(217 224 218 / 0.4) 0 1px, transparent 1px 80px);">
  </div>

  <div class="relative max-w-content mx-auto">

    <header class="mb-14 md:mb-16 max-w-2xl">
      <p class="scroll-reveal font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-sentiers-soleil">
        Carnet d'altitude
      </p>
      <h2 class="scroll-reveal mt-4 font-tinos text-sentiers-brume leading-[1.05]" style="font-size: clamp(34px, 4.8vw, 56px);">
        Des sentiers en chiffres,<br/>
        <span class="italic text-sentiers-soleil">le reste en silence.</span>
      </h2>
    </header>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-y-12 gap-x-8">
      {stats.map((s, i) => (
        <li class="scroll-reveal border-l border-sentiers-soleil/40 pl-5" style={`transition-delay: ${i * 80}ms`}>
          <span class="block font-tinos italic font-bold text-sentiers-brume leading-[0.88] tabular-nums" style="font-size: clamp(56px, 9vw, 130px);">
            {s.value}
          </span>
          <span class="mt-4 block font-roboto-mono uppercase tracking-[0.28em] text-sentiers-soleil text-[11px]">
            {s.unit}
          </span>
          <p class="mt-2 font-familjen text-sentiers-brume/70 leading-snug" style="font-size: 14.5px;">
            {s.label}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
