---
/**
 * SansAvecGuide — comparaison "seul vs accompagné".
 * Deux colonnes contrastées, ton honnête sans mépriser le hors-guide.
 */
const sansGuide = [
  'Vous cherchez longtemps les sentiers les moins fréquentés.',
  'Vous traversez sans savoir nommer ce que vous voyez.',
  'En cas de météo qui tourne, vous décidez seul.',
  'Vous rentrez avec une belle balade — et c\'est très bien.',
];

const avecGuide = [
  'On vous emmène sur des spots discrets, jamais sur Instagram.',
  'Chaque arbre, oiseau, pierre, a son histoire et son nom local.',
  'Vingt ans de météo locale : on lit le ciel comme un journal.',
  'Vous rentrez avec un récit, des images, et une île un peu plus à vous.',
];
---

<section class="relative bg-sentiers-brume py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="scroll-reveal font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-sentiers-terre">
        Sans guide, avec guide
      </p>
      <h2 class="scroll-reveal mt-4 font-tinos text-sentiers-noir leading-[1.05]" style="font-size: clamp(32px, 4.2vw, 48px);">
        Vous pouvez marcher seul.<br/>
        <span class="italic text-sentiers-lichen">Mais voici la différence.</span>
      </h2>
    </header>

    <div class="grid md:grid-cols-2 gap-0 border-2 border-sentiers-foret/20">
      <div class="scroll-reveal p-8 md:p-10 bg-sentiers-brume border-b-2 md:border-b-0 md:border-r-2 border-sentiers-foret/20">
        <p class="font-roboto-mono text-[10px] uppercase tracking-[0.32em] text-sentiers-noir/55">
          En autonomie
        </p>
        <h3 class="mt-3 font-tinos italic text-sentiers-noir/85 leading-tight" style="font-size: clamp(24px, 2.6vw, 32px);">
          Sans nous.
        </h3>
        <ul class="mt-6 space-y-4">
          {sansGuide.map((line) => (
            <li class="flex items-start gap-3 font-familjen text-sentiers-noir/65 leading-[1.65]" style="font-size: 15px;">
              <span class="shrink-0 mt-2 inline-block w-3 h-px bg-sentiers-noir/40" aria-hidden="true"></span>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="scroll-reveal p-8 md:p-10 bg-sentiers-foret text-sentiers-brume" style="transition-delay: 100ms">
        <p class="font-roboto-mono text-[10px] uppercase tracking-[0.32em] text-sentiers-soleil">
          Encadré
        </p>
        <h3 class="mt-3 font-tinos italic text-sentiers-soleil leading-tight" style="font-size: clamp(24px, 2.6vw, 32px);">
          Avec nous.
        </h3>
        <ul class="mt-6 space-y-4">
          {avecGuide.map((line) => (
            <li class="flex items-start gap-3 font-familjen text-sentiers-brume leading-[1.65]" style="font-size: 15px;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-1 text-sentiers-soleil" aria-hidden="true">
                <polyline points="20 6 9 17 4 12"/>
              </svg>
              <span>{line}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
