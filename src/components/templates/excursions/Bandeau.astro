---
/**
 * Bandeau — bandeau soleil sur forêt, 3 promesses encadrement sortie.
 */
---

<section class="relative bg-sentiers-soleil text-sentiers-forêt py-12 md:py-16 px-6 md:px-10 overflow-hidden">
  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-sentiers-forêt/25">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2">
        <span class="font-tinos italic text-sentiers-forêt leading-none" style="font-size: clamp(36px, 4.6vw, 54px);">8 max</span>
        <p class="mt-2 font-roboto-mono font-medium uppercase tracking-[0.22em] text-sentiers-forêt/80 text-[11px]">
          Randonneurs par sortie, pas plus
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 80ms">
        <span class="font-tinos italic text-sentiers-forêt leading-none" style="font-size: clamp(36px, 4.6vw, 54px);">Brevet d'État</span>
        <p class="mt-2 font-roboto-mono font-medium uppercase tracking-[0.22em] text-sentiers-forêt/80 text-[11px]">
          Accompagnateur en montagne
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 160ms">
        <span class="font-tinos italic text-sentiers-forêt leading-none" style="font-size: clamp(36px, 4.6vw, 54px);">Pluie ?</span>
        <p class="mt-2 font-roboto-mono font-medium uppercase tracking-[0.22em] text-sentiers-forêt/80 text-[11px]">
          Report sans frais, décision la veille
        </p>
      </li>
    </ul>
  </div>
</section>
