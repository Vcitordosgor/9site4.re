---
/**
 * Citation — extrait carnet de guide, fond terre cuite, italique tinos.
 */
---

<section class="relative bg-sentiers-terre text-sentiers-brume py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <div class="absolute top-0 inset-x-0 h-px bg-sentiers-soleil/50" aria-hidden="true"></div>
  <div class="absolute bottom-0 inset-x-0 h-px bg-sentiers-soleil/50" aria-hidden="true"></div>

  <div class="relative max-w-4xl mx-auto">
    <span class="scroll-reveal block font-tinos italic text-sentiers-soleil/30 leading-none" style="font-size: clamp(120px, 18vw, 220px);" aria-hidden="true">
      &ldquo;
    </span>

    <blockquote class="scroll-reveal -mt-12 md:-mt-20 font-tinos italic text-sentiers-brume leading-[1.18] tracking-tight" style="font-size: clamp(30px, 4.6vw, 52px);">
      Un sentier ne se conquiert pas, il se mérite.
      <span class="block mt-3 not-italic font-bold text-sentiers-soleil">Et un guide, c'est d'abord celui qui sait quand redescendre.</span>
    </blockquote>

    <footer class="scroll-reveal mt-12 flex items-center gap-3">
      <span class="block w-12 h-px bg-sentiers-soleil" aria-hidden="true"></span>
      <p class="font-roboto-mono uppercase tracking-[0.32em] text-sentiers-brume/70 text-[11px]">
        Carnet du guide — 12 hivernages
      </p>
    </footer>
  </div>
</section>
