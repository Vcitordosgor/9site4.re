---
import data from '../../../data/templates/mona.json';
const info = data.info;
---

<footer style="background-color: #2D3823; color: #F4EFE6;">
  <div class="max-w-content mx-auto px-5 md:px-10 py-14 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10">
      <div class="md:col-span-5">
        <p class="font-fraunces text-4xl">{info.wordmark}</p>
        <p class="mt-2 font-dm-sans text-[11px] uppercase tracking-[0.28em]" style="color: #C56A4D;">{info.soustitre}</p>
        <p class="mt-6 font-fraunces italic text-xl max-w-md leading-snug" style="color: rgba(244,239,230,0.85);">
          « {info.tagline} »
        </p>
      </div>
      <div class="md:col-span-3">
        <p class="font-dm-sans text-[10.5px] uppercase tracking-[0.28em] mb-3" style="color: #C56A4D;">Cabinet</p>
        <p class="font-dm-sans text-[13.5px] leading-relaxed" style="color: rgba(244,239,230,0.85);">
          {info.adresseLigne1}<br/>{info.adresseLigne2}
        </p>
      </div>
      <div class="md:col-span-4">
        <p class="font-dm-sans text-[10.5px] uppercase tracking-[0.28em] mb-3" style="color: #C56A4D;">Contact</p>
        <ul class="font-dm-sans text-[13.5px] space-y-2" style="color: rgba(244,239,230,0.85);">
          <li><a href={`tel:${info.telephoneHref}`} class="hover:text-[#C56A4D]">{info.telephone}</a></li>
          <li><a href={`mailto:${info.email}`} class="hover:text-[#C56A4D]">{info.email}</a></li>
          {info.instagram && <li><a href={`https://instagram.com/${info.instagram.replace('@','')}`} class="hover:text-[#C56A4D]">Instagram · {info.instagram}</a></li>}
        </ul>
      </div>
    </div>
    <div class="mt-14 pt-6 border-t flex flex-col md:flex-row gap-3 justify-between font-dm-sans text-[11px]" style="border-color: rgba(244,239,230,0.15); color: rgba(244,239,230,0.55);">
      <p>© {new Date().getFullYear()} {info.nom} — Démo 9site4 (fictif).</p>
      <p>Diplômée d'État · ADELI sur demande.</p>
    </div>
  </div>
</footer>
