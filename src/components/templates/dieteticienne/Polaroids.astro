---
const polaroids = [
  {
    src: 'https://images.unsplash.com/photo-1490645935967-10de6ba17061?w=900&q=85',
    leg: "Marché du samedi · brèdes péi & fruits frais",
    rot: '-rotate-3',
  },
  {
    src: 'https://images.unsplash.com/photo-1466637574441-749b8f19452f?w=900&q=85',
    leg: "Assiette type · légumes locaux, féculents, protéines",
    rot: 'rotate-2',
  },
  {
    src: 'https://images.unsplash.com/photo-1543362906-acfc16c67564?w=900&q=85',
    leg: "Carnet de bord · partagé en consultation",
    rot: '-rotate-2',
  },
];
---

<section class="bg-mona-creme py-20 md:py-28 px-6 md:px-10 relative overflow-hidden">
  <div class="max-w-content mx-auto">

    <header class="text-center mb-14 max-w-2xl mx-auto">
      <p class="font-jakarta text-[11px] uppercase tracking-[0.3em] text-mona-terracotta font-semibold mb-3">
        ❀ Carnet de bord
      </p>
      <h2 class="font-newsreader italic text-mona-cacao text-3xl md:text-4xl leading-tight">
        Quelques instantanés<br/>du cabinet.
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-y-16 md:gap-x-8 justify-items-center">
      {polaroids.map((p) => (
        <li class:list={["group inline-block transform transition-transform hover:rotate-0 hover:scale-105", p.rot]}>
          <figure class="bg-mona-creme p-3 pb-12 shadow-[0_18px_36px_rgba(62,42,30,0.22)] ring-1 ring-mona-cacao/8 relative">
            <img
              src={p.src}
              alt={p.leg}
              class="w-full aspect-square object-cover"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="absolute bottom-3 left-3 right-3 text-center" style="font-family: 'Reenie Beanie', cursive;">
              <p class="text-mona-cacao text-lg md:text-xl leading-tight">
                {p.leg}
              </p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
