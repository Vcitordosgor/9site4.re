---
const stats = [
  { val: '11', sfx: 'ans', leg: "d'accompagnement en cabinet" },
  { val: '850', sfx: '+', leg: "patient·es suivis en consultation" },
  { val: '0', sfx: '', leg: "régime miracle proposé" },
  { val: '92', sfx: '%', leg: "des suivis renouvelés à 6 mois" },
];
---

<section class="bg-mona-papier py-20 md:py-28 px-6 md:px-10 border-y border-mona-vert-fonce/15">
  <div class="max-w-content mx-auto">

    <header class="text-center mb-14 max-w-2xl mx-auto">
      <p class="font-jakarta text-[11px] uppercase tracking-[0.3em] text-mona-terracotta font-semibold mb-3">
        ❀ Bilan annuel
      </p>
      <h2 class="font-newsreader italic text-mona-cacao text-3xl md:text-4xl leading-tight">
        Dix années,<br/>en quelques chiffres ronds.
      </h2>
    </header>

    <ul class="grid grid-cols-2 md:grid-cols-4 gap-y-12 md:gap-x-8 text-center">
      {stats.map((s, i) => (
        <li>
          <p class="font-jakarta text-[10px] uppercase tracking-[0.3em] text-mona-vert-fonce mb-3">
            ◯ /{String(i + 1).padStart(2, '0')}
          </p>
          <p class="font-newsreader text-mona-cacao tabular-nums leading-[0.88]" style="font-size: clamp(72px, 13vw, 140px);">
            {s.val}<span class="italic text-mona-terracotta font-newsreader" style="font-size: 0.4em;">{s.sfx}</span>
          </p>
          <p class="mt-5 pt-5 border-t border-mona-vert-fonce/20 font-newsreader italic text-mona-cacao/80 text-sm md:text-base leading-relaxed max-w-[200px] mx-auto">
            {s.leg}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
