---
const regime = [
  "Privation totale d'aliments « interdits »",
  "Menus figés, sans tenir compte du goût",
  "Perte de poids rapide, reprise garantie",
  "Vous mangez seule, jamais en famille",
  "Frustration, culpabilité, échec",
];

const accomp = [
  "Aucun aliment interdit, des dosages adaptés",
  "Vos repas habituels ajustés progressivement",
  "Stabilisation durable à 6-12 mois",
  "On tient compte de votre rythme familial",
  "Plaisir préservé, sans culpabilité",
];
---

<section class="bg-mona-papier py-20 md:py-28 px-6 md:px-10 border-y border-mona-vert-fonce/15">
  <div class="max-w-content mx-auto">

    <header class="text-center mb-14 max-w-3xl mx-auto">
      <p class="font-jakarta text-[11px] uppercase tracking-[0.3em] text-mona-terracotta font-semibold mb-3">
        ❀ Recette comparée
      </p>
      <h2 class="font-newsreader text-mona-cacao text-3xl md:text-5xl leading-tight">
        Régime restrictif <em class="italic text-mona-framboise">vs.</em><br/>
        accompagnement.
      </h2>
    </header>

    <div class="grid md:grid-cols-2 gap-6 md:gap-8 max-w-4xl mx-auto">

      <div class="bg-mona-creme border border-mona-cacao/15 rounded-2xl p-7 md:p-9 relative">
        <div class="inline-block bg-mona-framboise/15 text-mona-framboise px-3 py-1 rounded-full font-jakarta font-semibold text-xs uppercase tracking-wider mb-5">
          ✗ Régime classique
        </div>
        <ul class="space-y-3">
          {regime.map((it) => (
            <li class="flex gap-3 items-start font-jakarta text-mona-cacao/75 text-[14.5px] leading-relaxed">
              <span class="text-mona-framboise font-bold text-lg leading-none shrink-0 mt-px">✗</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-mona-vert/15 border-2 border-mona-vert-fonce rounded-2xl p-7 md:p-9 relative shadow-lg">
        <div class="inline-block bg-mona-vert-fonce text-mona-creme px-3 py-1 rounded-full font-jakarta font-semibold text-xs uppercase tracking-wider mb-5">
          ✓ Avec Mona
        </div>
        <ul class="space-y-3">
          {accomp.map((it) => (
            <li class="flex gap-3 items-start font-jakarta text-mona-cacao text-[14.5px] leading-relaxed font-medium">
              <span class="text-mona-vert-fonce font-bold text-lg leading-none shrink-0 mt-px">✓</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
