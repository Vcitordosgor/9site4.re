---
/**
 * HeroTable — photo top-shot table + titre serif Newsreader en superposition
 * + annotation manuscrite Reenie. Layout magazine culinaire éditorial.
 */
import data from '../../../data/templates/mona.json';
---

<section id="top" class="relative bg-mona-creme overflow-hidden">

  <!-- Top-shot CSS : nappe motif pois + composition picto végétal -->
  <div class="relative aspect-[16/10] md:aspect-[16/9] lg:aspect-[21/9] overflow-hidden bg-mona-vert-fonce hero-vivant">
    <!-- Nappe à pois -->
    <div class="absolute inset-0 pointer-events-none opacity-[0.18]" aria-hidden="true"
         style="background-image: radial-gradient(circle, #F4ECD8 1.5px, transparent 2px); background-size: 28px 28px;"></div>

    <!-- Picto végétal grand format : assiette + légumes SVG -->
    <svg viewBox="0 0 1200 600" preserveAspectRatio="xMidYMid slice" class="absolute inset-0 w-full h-full" aria-hidden="true">
      <!-- Cercle assiette -->
      <circle cx="600" cy="320" r="240" fill="#F4ECD8" fill-opacity="0.08" stroke="#F4ECD8" stroke-opacity="0.35" stroke-width="2"/>
      <circle cx="600" cy="320" r="210" fill="none" stroke="#F4ECD8" stroke-opacity="0.2" stroke-width="1" stroke-dasharray="3 4"/>
      <!-- Tomate -->
      <g transform="translate(500 260)">
        <circle r="42" fill="#AA5032"/>
        <path d="M-8 -38 Q0 -50 10 -38 L6 -34 L0 -42 L-6 -34 Z" fill="#3D5E32"/>
      </g>
      <!-- Citron -->
      <g transform="translate(710 280)">
        <ellipse rx="36" ry="28" fill="#E8B84B"/>
        <ellipse rx="32" ry="24" fill="none" stroke="#3E2A1E" stroke-opacity="0.2" stroke-width="0.8"/>
      </g>
      <!-- Avocat coupé -->
      <g transform="translate(610 410)">
        <ellipse rx="48" ry="36" fill="#7A8F4D"/>
        <ellipse rx="40" ry="28" fill="#C9D8A7" fill-opacity="0.85"/>
        <circle r="12" fill="#5C3B1F"/>
      </g>
      <!-- Brocoli -->
      <g transform="translate(450 380)">
        <circle cx="-12" cy="-6" r="14" fill="#3D5E32"/>
        <circle cx="6" cy="-10" r="12" fill="#4A6B3D"/>
        <circle cx="0" cy="6" r="13" fill="#5C7A45"/>
        <rect x="-4" y="10" width="8" height="14" fill="#E8DFC8"/>
      </g>
      <!-- Carotte -->
      <g transform="translate(740 410) rotate(20)">
        <path d="M-6 -28 L6 -28 L10 24 L-10 24 Z" fill="#D9763B"/>
        <path d="M-8 -28 Q-4 -42 0 -36 Q4 -42 8 -28 Z" fill="#3D5E32"/>
      </g>
      <!-- Couverts simplifiés -->
      <g stroke="#F4ECD8" stroke-opacity="0.4" stroke-width="3" stroke-linecap="round" fill="none">
        <line x1="280" y1="200" x2="280" y2="460"/>
        <line x1="920" y1="200" x2="920" y2="460"/>
      </g>
    </svg>

    <!-- Voile pour lisibilité texte -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(62,42,30,0.35) 0%, rgba(62,42,30,0.05) 35%, rgba(62,42,30,0.65) 100%);"></div>

    <!-- Annotation manuscrite en surimpression -->
    <p class="absolute top-24 md:top-32 right-6 md:right-12 font-reenie text-mona-creme text-3xl md:text-5xl rotate-[-4deg] drop-shadow-lg" aria-hidden="true">
      manger c'est aussi ressentir
      <span class="text-mona-terracotta">✿</span>
    </p>

    <!-- Sticker tampon : '1ère séance 20 min offerte' (style sceau magazine) -->
    <div
      class="absolute top-6 left-6 md:top-10 md:left-10 w-[88px] h-[88px] md:w-[112px] md:h-[112px] rounded-full bg-mona-terracotta text-mona-creme flex flex-col items-center justify-center text-center rotate-[-12deg] shadow-[0_8px_24px_rgba(170,80,50,0.45)] ring-2 ring-mona-creme/40"
      aria-label="Première consultation de 20 minutes offerte"
    >
      <span class="font-reenie text-base md:text-lg leading-none">1ère séance</span>
      <span class="font-newsreader italic text-xl md:text-2xl leading-none mt-1">20 min</span>
      <span class="font-jakarta uppercase tracking-[0.18em] font-bold text-[8px] md:text-[9px] leading-none mt-1.5 text-mona-creme/85">offerte</span>
    </div>

    <!-- Titre principal en bas à gauche -->
    <div class="absolute bottom-6 md:bottom-12 left-6 md:left-12 right-6 md:right-12 max-w-3xl">
      <p class="font-jakarta text-[10px] md:text-[11px] uppercase tracking-[0.32em] text-mona-creme/85 mb-3 md:mb-5">
        Diététique · Nutrition · {data.info.ville}
      </p>
      <h1 class="font-newsreader text-mona-creme leading-[0.92]" style="font-size: clamp(52px, 10vw, 144px);">
        Manger mieux,<br/>
        <span class="italic">sans se priver.</span>
      </h1>
    </div>
  </div>

  <!-- Sous-bande : pitch + CTA -->
  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16 grid lg:grid-cols-12 gap-8 items-center">

    <div class="lg:col-span-7">
      <p class="font-jakarta text-[10px] uppercase tracking-[0.32em] text-mona-vert-fonce mb-4">
        Bienvenue
      </p>
      <p class="font-newsreader text-mona-cacao text-xl md:text-2xl leading-[1.55]">
        Je m'appelle <span class="italic text-mona-vert-fonce">Mona Levray</span>, je vous reçois au cabinet ou en téléconsultation. <span class="text-mona-cacao/65">On part de votre quotidien, on bouge un curseur à la fois.</span>
      </p>

      <!-- Mini-bandeau 'Au menu' : 3 chips façon carte du jour -->
      <div class="mt-7">
        <p class="font-reenie text-mona-terracotta text-xl md:text-2xl leading-none mb-3" aria-hidden="true">
          au menu de la consultation —
        </p>
        <ul class="flex flex-wrap gap-2">
          {[
            'Bilan personnalisé',
            'Plan sur-mesure',
            'Suivi continu',
          ].map((item) => (
            <li class="inline-flex items-center gap-2 h-8 px-3.5 rounded-full bg-mona-creme ring-1 ring-mona-cacao/15 font-jakarta text-xs font-medium text-mona-cacao">
              <span class="text-mona-terracotta" aria-hidden="true">✿</span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- CTA + tél compact -->
    <div class="lg:col-span-5 flex flex-col sm:flex-row lg:flex-col items-start gap-4">
      <a
        href="#rendez-vous"
        class="inline-flex items-center justify-center w-full sm:w-auto lg:w-full px-8 bg-mona-terracotta text-mona-creme font-jakarta text-base font-bold rounded-full hover:bg-mona-cacao transition-colors shadow-[0_10px_28px_rgba(170,80,50,0.32)]"
        style="height: 60px;"
      >
        Prendre rendez-vous →
      </a>
      <a
        href={`tel:${data.info.telephoneHref}`}
        class="font-newsreader text-mona-cacao/85 text-base tabular-nums underline underline-offset-4 decoration-mona-vert/60 hover:decoration-mona-vert-fonce hover:text-mona-vert-fonce transition-colors"
      >
        ou par téléphone : {data.info.telephone}
      </a>
      <p class="font-jakarta text-[11px] uppercase tracking-[0.2em] text-mona-vert-fonce">
        Cabinet · Téléconsultation · Lun–sam
      </p>
    </div>
  </div>
</section>

<style>
  @keyframes hero-vivant {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }
  .hero-vivant {
    transform-origin: center;
    animation: hero-vivant 2400ms cubic-bezier(0.22, 1, 0.36, 1) both;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-vivant { animation: none !important; transform: none !important; }
  }
</style>
