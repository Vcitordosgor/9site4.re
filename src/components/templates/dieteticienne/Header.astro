---
import data from '../../../data/templates/mona.json';
const info = data.info;
---

<header class="sticky top-0 z-40 backdrop-blur-md border-b" style="background-color: rgba(244,239,230,0.92); border-color: rgba(107,127,92,0.18);">
  <div class="max-w-content mx-auto px-5 md:px-10 h-16 md:h-20 flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-3">
      <span class="font-fraunces text-2xl md:text-3xl leading-none" style="color: #2D3823;">{info.wordmark}</span>
      <span class="hidden md:inline font-dm-sans text-[10.5px] uppercase tracking-[0.28em]" style="color: #6B7F5C;">Diététicienne D.E.</span>
    </a>

    <nav class="hidden lg:flex items-center gap-7 font-dm-sans text-[12.5px]" style="color: #2D3823;">
      <a href="#accompagnements" class="hover:opacity-70 transition-opacity">Accompagnements</a>
      <a href="#methode" class="hover:opacity-70 transition-opacity">Méthode</a>
      <a href="#praticienne" class="hover:opacity-70 transition-opacity">Praticienne</a>
      <a href="#tarifs" class="hover:opacity-70 transition-opacity">Tarifs</a>
      <a href="#faq" class="hover:opacity-70 transition-opacity">FAQ</a>
    </nav>

    <a href="#rendez-vous" class="inline-flex items-center gap-2 font-dm-sans font-medium text-[12px] md:text-[13px] h-10 md:h-11 px-4 md:px-6 rounded-full transition-colors" style="background-color: #C56A4D; color: #F4EFE6;">
      Prendre RDV
    </a>
  </div>
</header>
