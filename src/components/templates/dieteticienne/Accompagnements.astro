---
import data from '../../../data/templates/mona.json';
const publics = data.publics.slice(0, 4);
---

<section id="accompagnements" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="max-w-3xl mb-14 md:mb-16">
      <p class="font-dm-sans text-[11px] uppercase tracking-[0.3em] mb-4" style="color: #6B7F5C;">— Accompagnements —</p>
      <h2 class="font-fraunces leading-[1.04]" style="color: #2D3823; font-size: clamp(34px, 5vw, 58px);">
        À qui s'adresse <em class="italic" style="color: #C56A4D;">la consultation ?</em>
      </h2>
      <p class="mt-6 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(45,56,35,0.75);">
        Quatre profils principaux, des dizaines de situations particulières. Le bilan initial sert à comprendre où vous en êtes — pas à vous faire entrer dans une case.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {publics.map((p) => (
        <article class="flex flex-col overflow-hidden rounded-2xl border" style="background-color: #F4EFE6; border-color: rgba(107,127,92,0.18);">
          <div class="aspect-[4/5] overflow-hidden">
            <img src={p.photo} alt={p.label} loading="lazy" class="w-full h-full object-cover" />
          </div>
          <div class="p-5 md:p-6 flex flex-col gap-2 flex-1">
            <h3 class="font-fraunces text-xl" style="color: #2D3823;">{p.label}</h3>
            <p class="font-dm-sans text-[13.5px] leading-relaxed" style="color: rgba(45,56,35,0.72);">{p.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
