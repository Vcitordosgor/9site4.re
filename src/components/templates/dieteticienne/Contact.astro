---
import data from '../../../data/templates/mona.json';
const info = data.info;
---

<section id="contact" class="py-20 md:py-28" style="background-color: #F4EFE6;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <p class="font-dm-sans text-[11px] uppercase tracking-[0.3em] mb-4" style="color: #6B7F5C;">— Trouver le cabinet —</p>
        <h2 class="font-fraunces leading-[1.04]" style="color: #2D3823; font-size: clamp(34px, 5vw, 56px);">
          {info.adresseLigne1}
        </h2>
        <p class="mt-3 font-fraunces italic text-2xl" style="color: rgba(45,56,35,0.7);">{info.adresseLigne2}</p>

        <div class="mt-8 aspect-[4/3] overflow-hidden rounded-3xl">
          <img src="/images/dieteticienne/cabinet.webp" alt="Cabinet diététicienne — La Réunion" loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="lg:col-span-7">
        <p class="font-dm-sans text-[11px] uppercase tracking-[0.3em] mb-4" style="color: #6B7F5C;">— Horaires —</p>
        <h3 class="font-fraunces text-3xl md:text-4xl mb-7" style="color: #2D3823;">Ouverture du cabinet</h3>
        <ul class="rounded-3xl overflow-hidden border" style="border-color: rgba(107,127,92,0.18);">
          {data.horaires.map((h, i) => (
            <li class={`flex items-center justify-between px-5 py-4 font-dm-sans text-[14px] ${i < data.horaires.length-1 ? 'border-b' : ''}`} style="border-color: rgba(107,127,92,0.15); background-color: #FFFFFF;">
              <span style="color: #2D3823;" class="font-medium">{h.jour}</span>
              <span style={`color: ${h.ouvert ? 'rgba(45,56,35,0.75)' : 'rgba(45,56,35,0.45)'};`}>{h.label}</span>
            </li>
          ))}
        </ul>

        <div class="mt-8 p-6 rounded-3xl flex flex-col sm:flex-row gap-4 items-center" style="background-color: #C56A4D; color: #F4EFE6;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="w-10 h-10 shrink-0"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <div class="flex-1 text-center sm:text-left">
            <p class="font-dm-sans text-[11px] uppercase tracking-[0.22em] opacity-80">Une question rapide ?</p>
            <a href={`tel:${info.telephoneHref}`} class="font-fraunces text-3xl md:text-4xl">{info.telephone}</a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
