---
import data from '../../../data/templates/mona.json';
---

<section id="methode" class="py-20 md:py-28" style="background-color: #F4EFE6;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 mb-14 md:mb-20 items-end">
      <div class="lg:col-span-7">
        <p class="font-dm-sans text-[11px] uppercase tracking-[0.3em] mb-4" style="color: #6B7F5C;">— Méthode —</p>
        <h2 class="font-fraunces leading-[1.04]" style="color: #2D3823; font-size: clamp(34px, 5vw, 58px);">
          Bilan, suivi, <em class="italic" style="color: #C56A4D;">autonomie.</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="font-dm-sans text-[15px] leading-relaxed" style="color: rgba(45,56,35,0.75);">
          Trois temps pensés pour que vous reveniez de moins en moins souvent. L'autonomie alimentaire est l'objectif réel — pas la fidélisation.
        </p>
      </div>
    </div>

    <div class="relative grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="hidden md:block absolute left-0 right-0 top-12 h-px" style="background-color: rgba(107,127,92,0.25);" aria-hidden="true"></div>

      {data.etapes.map((e) => (
        <article class="relative flex flex-col gap-4">
          <div class="relative flex items-center justify-center w-24 h-24 rounded-full mx-auto" style="background-color: #FFFFFF; border: 2px solid #C56A4D;">
            <span class="font-fraunces italic text-4xl" style="color: #C56A4D;">{e.num}</span>
          </div>
          <div class="text-center md:text-left mt-4">
            <p class="font-dm-sans text-[11px] uppercase tracking-[0.22em] mb-2" style="color: #6B7F5C;">{e.duree}</p>
            <h3 class="font-fraunces text-2xl mb-3" style="color: #2D3823;">{e.titre}</h3>
            <p class="font-dm-sans text-[14px] leading-relaxed" style="color: rgba(45,56,35,0.72);">{e.description}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
