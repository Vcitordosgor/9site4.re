---
import data from '../../../data/templates/mona.json';
const info = data.info;
---

<section id="rendez-vous" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #2D3823; color: #F4EFE6;">
  <div class="absolute inset-0 pointer-events-none opacity-[0.06]" aria-hidden="true" style="background-image: radial-gradient(circle at 1px 1px, #F4EFE6 1px, transparent 0); background-size: 24px 24px;"></div>

  <div class="max-w-content mx-auto px-5 md:px-10 relative">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <div class="lg:col-span-5">
        <p class="font-dm-sans text-[11px] uppercase tracking-[0.3em] mb-4" style="color: #C56A4D;">— Prise de rendez-vous —</p>
        <h2 class="font-fraunces leading-[1.04]" style="font-size: clamp(34px, 5vw, 58px);">
          Prenons rendez-vous <em class="italic" style="color: #C56A4D;">simplement.</em>
        </h2>
        <p class="mt-6 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(244,239,230,0.78);">
          Aucun engagement, aucun jugement. Le premier échange sert à comprendre votre situation et à voir si je suis la bonne personne pour vous accompagner.
        </p>

        <dl class="mt-10 space-y-5 font-dm-sans text-[14px]">
          <div>
            <dt class="text-[11px] uppercase tracking-[0.22em] mb-1" style="color: #C56A4D;">Cabinet</dt>
            <dd style="color: rgba(244,239,230,0.9);">{info.adresseLigne1} · {info.adresseLigne2}</dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-[0.22em] mb-1" style="color: #C56A4D;">Téléphone</dt>
            <dd><a href={`tel:${info.telephoneHref}`} class="hover:opacity-70" style="color: #F4EFE6;">{info.telephone}</a></dd>
          </div>
          <div>
            <dt class="text-[11px] uppercase tracking-[0.22em] mb-1" style="color: #C56A4D;">Email</dt>
            <dd><a href={`mailto:${info.email}`} class="hover:opacity-70" style="color: #F4EFE6;">{info.email}</a></dd>
          </div>
        </dl>
      </div>

      <form class="lg:col-span-7 grid grid-cols-1 md:grid-cols-2 gap-4" onsubmit="event.preventDefault(); alert('Démo — formulaire non actif.');">
        <label class="md:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11px] uppercase tracking-[0.2em]" style="color: rgba(244,239,230,0.7);">Prénom</span>
          <input type="text" required class="h-12 px-4 rounded-lg outline-none font-dm-sans text-[14px]" style="background-color: rgba(244,239,230,0.08); color: #F4EFE6; border: 1px solid rgba(244,239,230,0.18);" />
        </label>
        <label class="md:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11px] uppercase tracking-[0.2em]" style="color: rgba(244,239,230,0.7);">Nom</span>
          <input type="text" required class="h-12 px-4 rounded-lg outline-none font-dm-sans text-[14px]" style="background-color: rgba(244,239,230,0.08); color: #F4EFE6; border: 1px solid rgba(244,239,230,0.18);" />
        </label>
        <label class="md:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11px] uppercase tracking-[0.2em]" style="color: rgba(244,239,230,0.7);">Email</span>
          <input type="email" required class="h-12 px-4 rounded-lg outline-none font-dm-sans text-[14px]" style="background-color: rgba(244,239,230,0.08); color: #F4EFE6; border: 1px solid rgba(244,239,230,0.18);" />
        </label>
        <label class="md:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11px] uppercase tracking-[0.2em]" style="color: rgba(244,239,230,0.7);">Téléphone</span>
          <input type="tel" required class="h-12 px-4 rounded-lg outline-none font-dm-sans text-[14px]" style="background-color: rgba(244,239,230,0.08); color: #F4EFE6; border: 1px solid rgba(244,239,230,0.18);" />
        </label>
        <label class="md:col-span-2 flex flex-col gap-2">
          <span class="font-dm-sans text-[11px] uppercase tracking-[0.2em]" style="color: rgba(244,239,230,0.7);">Objectif (facultatif)</span>
          <textarea rows="4" class="px-4 py-3 rounded-lg outline-none font-dm-sans text-[14px] resize-none" style="background-color: rgba(244,239,230,0.08); color: #F4EFE6; border: 1px solid rgba(244,239,230,0.18);"></textarea>
        </label>
        <button type="submit" class="md:col-span-2 h-12 rounded-full font-dm-sans font-medium text-[13px] uppercase tracking-[0.2em] transition-colors" style="background-color: #C56A4D; color: #F4EFE6;">
          Réserver mon bilan
        </button>
      </form>
    </div>
  </div>
</section>
