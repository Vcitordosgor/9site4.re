---
/**
 * Galerie — fusion de Polaroids + PhotoMarche.
 * Une grande photo full-bleed marché + trois polaroids carnet de bord.
 */

const polaroids = [
  {
    src: '/images/dieteticienne/public-diabete.webp',
    leg: 'Marché du samedi · brèdes péi & fruits frais',
    rot: '-rotate-3',
  },
  {
    src: '/images/dieteticienne/public-famille.webp',
    leg: 'Assiette type · légumes locaux, féculents, protéines',
    rot: 'rotate-2',
  },
  {
    src: '/images/dieteticienne/public-perte.webp',
    leg: 'Carnet de bord · partagé en consultation',
    rot: '-rotate-2',
  },
];
---

<section class="bg-mona-creme">

  <!-- Bande full-bleed marché -->
  <figure class="relative aspect-[21/9] overflow-hidden bg-mona-cacao">
    <img
      src="/images/dieteticienne/public-sportif.webp"
      alt="Étal de marché coloré de fruits et légumes frais"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-mona-cacao/60 via-mona-cacao/10 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-12 left-6 md:left-12 right-6 md:right-12 max-w-2xl">
      <p class="font-reenie text-mona-terracotta text-3xl md:text-4xl mb-2 rotate-[-3deg]">
        au marché du samedi
      </p>
      <p class="font-newsreader italic text-mona-creme leading-[1.1]" style="font-size: clamp(24px, 3.4vw, 42px);">
        On commence dans votre assiette, pas sur la balance.
      </p>
    </figcaption>
  </figure>

  <!-- Polaroids carnet de bord -->
  <div class="py-20 md:py-28 px-6 md:px-10 max-w-content mx-auto">
    <header class="text-center mb-14 max-w-2xl mx-auto">
      <p class="font-jakarta text-[11px] uppercase tracking-[0.3em] text-mona-terracotta font-semibold mb-3">
        ❀ Carnet de bord
      </p>
      <h2 class="font-newsreader italic text-mona-cacao text-3xl md:text-4xl leading-tight">
        Quelques instantanés<br/>du cabinet.
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 md:grid-cols-3 gap-y-16 md:gap-x-8 justify-items-center">
      {polaroids.map((p) => (
        <li class:list={['group inline-block transform transition-transform hover:rotate-0 hover:scale-105', p.rot]}>
          <figure class="bg-mona-creme p-3 pb-12 shadow-[0_18px_36px_rgba(62,42,30,0.22)] ring-1 ring-mona-cacao/8 relative">
            <img
              src={p.src}
              alt={p.leg}
              class="w-full aspect-square object-cover"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="absolute bottom-3 left-3 right-3 text-center" style="font-family: 'Reenie Beanie', cursive;">
              <p class="text-mona-cacao text-lg md:text-xl leading-tight">
                {p.leg}
              </p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
