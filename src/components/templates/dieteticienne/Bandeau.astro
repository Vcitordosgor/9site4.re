---
import data from '../../../data/templates/mona.json';
---

<section class="bg-mona-vert-fonce text-mona-creme">
  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-2">
        <p class="font-reenie text-mona-terracotta text-4xl rotate-[-4deg]">
          en visio !
        </p>
      </div>
      <div class="md:col-span-7">
        <p class="font-jakarta text-[10.5px] uppercase tracking-[0.32em] text-mona-terracotta mb-3">
          ✿ Téléconsultations
        </p>
        <p class="font-newsreader text-mona-creme leading-[1.1]" style="font-size: clamp(26px, 3.4vw, 44px);">
          Téléconsultations possibles — <span class="italic">même qualité d'écoute, où que vous soyez</span>.
        </p>
      </div>
      <div class="md:col-span-3 md:text-right">
        <a
          href="#rendez-vous"
          class="inline-flex items-center justify-center h-12 px-7 bg-mona-terracotta text-mona-creme font-jakarta text-sm font-semibold rounded-full hover:bg-mona-creme hover:text-mona-cacao transition-colors"
        >
          Réserver →
        </a>
        <p class="mt-3 font-jakarta text-[10.5px] uppercase tracking-[0.32em] text-mona-terracotta">
          {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
