---
import data from '../../../data/templates/mona.json';
const info = data.info;
---

<section id="top" class="relative" style="background-color: #F4EFE6;">
  <style>
    /* Assiette : se compose puis respire (scale subtil) sans rotation continue */
    .plate-svg {
      filter: drop-shadow(0 8px 24px rgba(45,56,35,0.2));
      transform-origin: center;
      animation: plate-breathe 7s ease-in-out 2s infinite;
    }
    .plate-slice {
      transform-origin: 50px 50px;
      transform: scale(0);
      opacity: 0;
      animation: plate-fill 700ms cubic-bezier(0.34, 1.3, 0.5, 1) forwards;
      animation-delay: calc(0.4s + var(--i) * 0.18s);
    }
    @keyframes plate-fill    { to { transform: scale(1); opacity: 1; } }
    @keyframes plate-breathe {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.025); }
    }
    @media (prefers-reduced-motion: reduce) {
      .plate-svg { animation: none; }
      .plate-slice { animation: none; transform: none; opacity: 1; }
    }
  </style>
  <div class="max-w-content mx-auto px-5 md:px-10 pt-12 md:pt-20 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">

      <div class="lg:col-span-6">
        <div class="inline-flex items-center gap-3 px-4 py-2 rounded-full mb-7" style="background-color: rgba(107,127,92,0.12);">
          <span class="block w-1.5 h-1.5 rounded-full" style="background-color: #6B7F5C;"></span>
          <span class="font-dm-sans text-[11px] uppercase tracking-[0.22em]" style="color: #2D3823;">Bilan nutritionnel · La Réunion</span>
        </div>

        <h1 class="font-fraunces leading-[1.02]" style="color: #2D3823; font-size: clamp(42px, 6.2vw, 80px); font-variation-settings: 'opsz' 144;">
          Manger mieux,<br/>
          <em class="italic" style="color: #C56A4D;">sans se priver.</em>
        </h1>

        <p class="mt-7 font-dm-sans text-[15.5px] leading-relaxed max-w-xl" style="color: rgba(45,56,35,0.78);">
          Diététicienne diplômée d'État depuis {info.annee}. Bilans personnalisés, plans réalistes,
          accompagnement à votre rythme. Aucun interdit alimentaire — juste un meilleur équilibre.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <a href="#rendez-vous" class="inline-flex items-center justify-center h-12 px-7 font-dm-sans font-medium text-[13.5px] rounded-full transition-colors" style="background-color: #2D3823; color: #F4EFE6;">
            Première consultation
          </a>
          <a href="#accompagnements" class="inline-flex items-center justify-center h-12 px-7 font-dm-sans font-medium text-[13.5px] rounded-full border transition-colors" style="border-color: rgba(45,56,35,0.30); color: #2D3823;">
            Découvrir l'approche
          </a>
        </div>

        <div class="mt-10 grid grid-cols-3 gap-5 max-w-md">
          <div>
            <p class="font-fraunces text-3xl italic" style="color: #6B7F5C;">{info.annee}</p>
            <p class="mt-1 font-dm-sans text-[10.5px] uppercase tracking-wider" style="color: rgba(45,56,35,0.6);">Installée depuis</p>
          </div>
          <div>
            <p class="font-fraunces text-3xl italic" style="color: #6B7F5C;">60′</p>
            <p class="mt-1 font-dm-sans text-[10.5px] uppercase tracking-wider" style="color: rgba(45,56,35,0.6);">Première séance</p>
          </div>
          <div>
            <p class="font-fraunces text-3xl italic" style="color: #6B7F5C;">D.E.</p>
            <p class="mt-1 font-dm-sans text-[10.5px] uppercase tracking-wider" style="color: rgba(45,56,35,0.6);">Diplôme d'État</p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 relative">
        <div class="relative aspect-[5/6] overflow-hidden rounded-tl-[120px] rounded-br-[120px]">
          <img src={info.photoHero} alt="Diététicienne nutritionniste — consultation à La Réunion" loading="eager" fetchpriority="high" class="w-full h-full object-cover" />
        </div>
        <!-- Signature diét : assiette équilibrée qui se compose -->
        <div class="hidden md:flex absolute -top-6 -right-6 w-36 h-36 items-center justify-center" aria-hidden="true">
          <svg viewBox="0 0 100 100" class="w-full h-full plate-svg">
            <circle cx="50" cy="50" r="46" fill="#F4EFE6" stroke="#2D3823" stroke-width="1" />
            <circle cx="50" cy="50" r="42" fill="none" stroke="rgba(45,56,35,0.2)" stroke-width="0.5" />
            <!-- 50% légumes -->
            <path class="plate-slice" style="--i:0" d="M50 50 L50 4 A46 46 0 0 1 96 50 Z" fill="#6B7F5C" />
            <!-- 25% protéines -->
            <path class="plate-slice" style="--i:1" d="M50 50 L96 50 A46 46 0 0 1 50 96 Z" fill="#C56A4D" />
            <!-- 25% féculents -->
            <path class="plate-slice" style="--i:2" d="M50 50 L50 96 A46 46 0 0 1 4 50 Z" fill="#D9B26A" />
            <!-- 25% non rempli (vide / hydratation) -->
            <path class="plate-slice" style="--i:3" d="M50 50 L4 50 A46 46 0 0 1 50 4 Z" fill="#E8DCC6" />
            <circle cx="50" cy="50" r="3" fill="#2D3823" />
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
