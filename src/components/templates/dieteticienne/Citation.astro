---
import data from '../../../data/templates/mona.json';
---

<section class="bg-mona-papier py-28 md:py-40 px-6 md:px-10 border-y border-mona-cacao/10 relative overflow-hidden">
  <span aria-hidden="true" class="absolute top-12 right-12 font-reenie text-mona-terracotta/40 text-7xl rotate-[8deg] select-none">
    ✿
  </span>
  <span aria-hidden="true" class="absolute bottom-12 left-12 font-reenie text-mona-vert/50 text-7xl rotate-[-8deg] select-none">
    ✿
  </span>

  <div class="relative max-w-4xl mx-auto text-center">
    <p class="font-reenie text-mona-terracotta text-3xl md:text-4xl mb-4 rotate-[-3deg]">
      au menu, aujourd'hui
    </p>
    <span aria-hidden="true" class="block font-newsreader italic text-mona-vert leading-none mb-2 select-none" style="font-size: clamp(100px, 16vw, 220px);">
      &ldquo;
    </span>
    <blockquote class="font-newsreader italic text-mona-cacao leading-[1.2]" style="font-size: clamp(30px, 4.4vw, 52px);">
      Le bon régime, c'est celui qui tient dans une vie — pas dans un cahier de <span class="text-mona-vert-fonce not-italic font-medium">comptes</span>.
    </blockquote>
    <footer class="mt-12 flex items-center justify-center gap-3">
      <span class="block w-12 h-px bg-mona-terracotta" aria-hidden="true"></span>
      <p class="font-jakarta text-[10.5px] uppercase tracking-[0.32em] text-mona-vert-fonce">
        {data.info.nom} · {data.info.soustitre}
      </p>
      <span class="block w-12 h-px bg-mona-terracotta" aria-hidden="true"></span>
    </footer>
  </div>
</section>
