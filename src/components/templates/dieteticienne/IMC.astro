---
/**
 * IMC — petit calculateur d'indice de masse corporelle (vanilla JS).
 * Le résultat est purement indicatif et n'a aucune valeur médicale.
 */
---

<section id="imc" class="bg-mona-creme py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-3xl mx-auto">

    <header class="mb-10 md:mb-12">
      <p class="font-jakarta text-[11px] uppercase tracking-[0.3em] text-mona-terracotta font-semibold mb-3">
        Petit repère
      </p>
      <h2 class="font-newsreader italic text-mona-cacao leading-tight" style="font-size: clamp(30px, 4.5vw, 44px);">
        Calculer votre IMC,
        <span class="not-italic font-light text-mona-cacao/75">juste pour situer.</span>
      </h2>
      <p class="mt-4 text-mona-cacao/75 leading-relaxed">
        L’indice de masse corporelle est un repère parmi d’autres. Il ne dit rien
        de votre santé réelle, de votre masse musculaire ou de votre rapport à
        la nourriture. On en discute en consultation.
      </p>
    </header>

    <form id="imc-form" class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-4 items-end" onsubmit="return false;">
      <label class="block">
        <span class="block text-xs uppercase tracking-[0.22em] text-mona-cacao/70 mb-2">Poids (kg)</span>
        <input
          type="number"
          name="poids"
          id="imc-poids"
          min="20"
          max="300"
          step="0.1"
          inputmode="decimal"
          placeholder="65"
          class="w-full bg-white/70 border border-mona-cacao/20 px-4 py-3 text-mona-cacao text-lg font-newsreader focus:outline-none focus:border-mona-terracotta"
        />
      </label>
      <label class="block">
        <span class="block text-xs uppercase tracking-[0.22em] text-mona-cacao/70 mb-2">Taille (cm)</span>
        <input
          type="number"
          name="taille"
          id="imc-taille"
          min="80"
          max="240"
          step="0.5"
          inputmode="decimal"
          placeholder="170"
          class="w-full bg-white/70 border border-mona-cacao/20 px-4 py-3 text-mona-cacao text-lg font-newsreader focus:outline-none focus:border-mona-terracotta"
        />
      </label>
      <button
        type="button"
        id="imc-btn"
        class="h-13 px-6 bg-mona-terracotta text-mona-creme text-xs font-semibold uppercase tracking-[0.22em] hover:bg-mona-cacao transition-colors"
        style="height: 52px;"
      >
        Calculer
      </button>
    </form>

    <div id="imc-result" class="mt-8 hidden" aria-live="polite">
      <div class="bg-white/70 border-l-2 border-mona-terracotta p-6 md:p-7">
        <p class="text-xs uppercase tracking-[0.28em] text-mona-terracotta font-semibold">Votre IMC indicatif</p>
        <p class="mt-3 font-newsreader text-mona-cacao" style="font-size: clamp(40px, 6vw, 56px);">
          <span id="imc-value" class="tabular-nums">—</span>
          <span class="text-base text-mona-cacao/55 italic"> kg/m²</span>
        </p>
        <p id="imc-label" class="mt-2 font-newsreader italic text-mona-cacao/80 text-lg"></p>
      </div>
    </div>

    <p class="mt-6 text-xs text-mona-cacao/55 italic leading-relaxed">
      Ce calcul est purement informatif. Il ne remplace pas un avis professionnel,
      ni un bilan complet en consultation.
    </p>
  </div>

  <script is:inline>
    (function () {
      var btn = document.getElementById('imc-btn');
      var poidsEl = document.getElementById('imc-poids');
      var tailleEl = document.getElementById('imc-taille');
      var box = document.getElementById('imc-result');
      var val = document.getElementById('imc-value');
      var lab = document.getElementById('imc-label');
      if (!btn || !poidsEl || !tailleEl || !box || !val || !lab) return;

      function labelFor(imc) {
        if (imc < 16.5) return 'Repère bas — à évaluer en consultation.';
        if (imc < 18.5) return 'Repère sous la moyenne.';
        if (imc < 25)   return 'Repère dans la moyenne.';
        if (imc < 30)   return 'Repère au-dessus de la moyenne.';
        if (imc < 35)   return 'Repère haut — à évaluer en consultation.';
        return 'Repère très haut — à évaluer en consultation.';
      }

      function compute() {
        var p = parseFloat(poidsEl.value);
        var t = parseFloat(tailleEl.value);
        if (!p || !t || t < 50) {
          box.classList.add('hidden');
          return;
        }
        var m = t / 100;
        var imc = p / (m * m);
        val.textContent = imc.toFixed(1).replace('.', ',');
        lab.textContent = labelFor(imc);
        box.classList.remove('hidden');
      }

      btn.addEventListener('click', compute);
      poidsEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') compute(); });
      tailleEl.addEventListener('keydown', function (e) { if (e.key === 'Enter') compute(); });
    })();
  </script>
</section>
