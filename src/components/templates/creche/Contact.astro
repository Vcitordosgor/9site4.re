---
import data from '../../../data/templates/nid.json';
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #F8D77E;">

  <!-- Bulles déco -->
  <div class="absolute top-12 left-12 w-20 h-20 rounded-full opacity-50 hidden md:block" style="background-color: #F5C4C4;" aria-hidden="true"></div>
  <div class="absolute bottom-16 right-16 w-32 h-32 rounded-full opacity-40 hidden md:block" style="background-color: #A8C9E4;" aria-hidden="true"></div>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">

    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #2E2A26; opacity: 0.7;">— Venir visiter —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        Pousser la porte
        <span class="font-caveat font-normal block">du Nid.</span>
      </h2>
      <p class="mt-6 font-nunito text-[15.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.82);">
        Visite obligatoire avant toute inscription. Sur rendez-vous, en présence de votre enfant.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 max-w-4xl mx-auto">

      <a
        href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver une visite du Nid.')}`}
        target="_blank"
        rel="noopener"
        class="p-7 md:p-9 rounded-3xl text-center transition-all hover:-translate-y-1 hover:shadow-xl"
        style="background-color: #FFFFFF;"
      >
        <svg viewBox="0 0 32 32" class="w-10 h-10 mx-auto mb-4" style="color: #2E2A26;" aria-hidden="true">
          <path fill="currentColor" d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.3.6 4.4 1.7 6.3L3 29l7.4-1.9c1.8 1 3.8 1.5 5.6 1.5 7 0 12.5-5.5 12.5-12.5S23 3 16 3zm0 22.7c-1.6 0-3.3-.4-4.7-1.2l-.3-.2-4.4 1.1 1.2-4.3-.2-.4c-1-1.6-1.5-3.4-1.5-5.2 0-5.5 4.4-9.9 9.9-9.9s9.9 4.4 9.9 9.9-4.4 10.2-9.9 10.2z"/>
        </svg>
        <p class="font-caveat text-xl mb-1" style="color: #2E2A26; opacity: 0.7;">
          WhatsApp
        </p>
        <p class="font-nunito font-extrabold text-lg md:text-xl" style="color: #2E2A26;">
          Réserver une visite
        </p>
      </a>

      <a
        href={`tel:${data.info.telephoneHref}`}
        class="p-7 md:p-9 rounded-3xl text-center transition-all hover:-translate-y-1 hover:shadow-xl"
        style="background-color: #FFFFFF;"
      >
        <svg viewBox="0 0 24 24" class="w-10 h-10 mx-auto mb-4" style="color: #2E2A26;" aria-hidden="true">
          <path fill="currentColor" d="M6.62 10.79a15.46 15.46 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        <p class="font-caveat text-xl mb-1" style="color: #2E2A26; opacity: 0.7;">
          Téléphone
        </p>
        <p class="font-nunito font-extrabold text-lg md:text-xl" style="color: #2E2A26;">
          {data.info.telephone}
        </p>
      </a>

      <a
        href={`mailto:${data.info.email}`}
        class="p-7 md:p-9 rounded-3xl text-center transition-all hover:-translate-y-1 hover:shadow-xl"
        style="background-color: #FFFFFF;"
      >
        <svg viewBox="0 0 24 24" class="w-10 h-10 mx-auto mb-4" style="color: #2E2A26;" aria-hidden="true">
          <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <p class="font-caveat text-xl mb-1" style="color: #2E2A26; opacity: 0.7;">
          Email
        </p>
        <p class="font-nunito font-bold text-[14px] md:text-base break-all" style="color: #2E2A26;">
          {data.info.email}
        </p>
      </a>
    </div>

    <!-- Horaires -->
    <div class="mt-14 md:mt-20 text-center max-w-md mx-auto p-7 rounded-3xl" style="background-color: #FFFFFF;">
      <p class="font-caveat text-2xl mb-2" style="color: #2E2A26; opacity: 0.7;">
        Ouvert
      </p>
      <p class="font-nunito font-bold text-lg md:text-xl" style="color: #2E2A26;">{data.info.ouvertureHebdo}</p>
      <p class="mt-2 font-nunito text-[13px]" style="color: rgb(46 42 38 / 0.7);">
        Fermé {data.info.fermeture}
      </p>
    </div>
  </div>
</section>
