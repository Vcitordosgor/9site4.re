---
import data from '../../../data/templates/nid.json';
---

<section id="top" class="relative overflow-hidden" style="background-color: #FFF8EE;">

  <!-- Bulles décoratives -->
  <div class="absolute top-12 right-12 w-28 h-28 rounded-full opacity-50 hidden md:block" style="background-color: #F5C4C4;" aria-hidden="true"></div>
  <div class="absolute top-32 right-32 w-12 h-12 rounded-full opacity-60 hidden md:block" style="background-color: #A8C9E4;" aria-hidden="true"></div>
  <div class="absolute bottom-28 left-12 w-20 h-20 rounded-full opacity-40 hidden md:block" style="background-color: #F8D77E;" aria-hidden="true"></div>

  <div class="max-w-content mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-16 md:pb-24 relative">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-14 items-center">

      <!-- Texte -->
      <div class="lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full mb-6 md:mb-8" style="background-color: #F8D77E;">
          <span style="color: #2E2A26;">✦</span>
          <p class="font-nunito text-[11.5px] font-bold uppercase tracking-[0.15em]" style="color: #2E2A26;">
            Micro-crèche 0-3 ans · agréée PMI
          </p>
        </div>

        <h1 class="font-nunito leading-[0.95]" style="color: #2E2A26;">
          <span class="block font-extrabold" style="font-size: clamp(52px, 9vw, 124px);">
            Un nid
          </span>
          <span class="block font-extrabold" style="font-size: clamp(52px, 9vw, 124px);">
            pour grandir
          </span>
          <span class="block font-caveat" style="font-size: clamp(54px, 9.5vw, 130px); color: #2E2A26;">
            à son rythme.
          </span>
        </h1>

        <p class="mt-8 font-nunito text-[15.5px] md:text-[17.5px] leading-relaxed max-w-lg" style="color: rgb(46 42 38 / 0.78);">
          Dix berceaux maximum, trois professionnelles diplômées en permanence,
          inspiration Montessori, rythme respecté. Le quotidien des tout-petits,
          en douceur.
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-3 md:gap-4">
          <a
            href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite visiter Le Nid pour une inscription.')}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center h-13 py-3.5 px-7 font-nunito font-bold text-[13.5px] rounded-full shadow-lg transition-all duration-300"
            style="background-color: #F8D77E; color: #2E2A26;"
            onmouseover="this.style.backgroundColor='#2E2A26'; this.style.color='#F8D77E';"
            onmouseout="this.style.backgroundColor='#F8D77E'; this.style.color='#2E2A26';"
          >
            Inscrire mon enfant
          </a>
          <a
            href="#pedagogie"
            class="inline-flex items-center justify-center h-13 py-3.5 px-7 font-nunito font-bold text-[13.5px] rounded-full transition-all duration-300"
            style="background-color: #FFFFFF; color: #2E2A26; border: 2px solid #2E2A26;"
            onmouseover="this.style.backgroundColor='#A8C9E4';"
            onmouseout="this.style.backgroundColor='#FFFFFF';"
          >
            Notre pédagogie
          </a>
        </div>
        <p class="mt-4 font-nunito text-[12.5px] font-semibold" style="color: rgb(46 42 38 / 0.65);">
          Visite découverte offerte · Réponse sous 48 h
        </p>
      </div>

      <!-- Photo + chiffres -->
      <div class="lg:col-span-5 relative">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[60px_20px_60px_20px]" style="background-color: #F5C4C4;">
          <img
            src={data.info.photoHero}
            alt={data.info.photoHeroAlt}
            class="w-full h-full object-cover"
            width="1600" height="900" loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <!-- Sticker chiffres -->
        <div class="absolute -top-4 -left-4 md:-top-6 md:-left-6 w-24 h-24 md:w-32 md:h-32 rounded-full flex flex-col items-center justify-center shadow-xl" style="background-color: #A8C9E4;">
          <p class="font-nunito font-extrabold text-3xl md:text-5xl leading-none" style="color: #2E2A26;">10</p>
          <p class="font-nunito text-[10px] md:text-[11px] uppercase tracking-wider font-bold mt-1" style="color: #2E2A26;">berceaux<br/>max</p>
        </div>
        <!-- Sticker bas droite -->
        <div class="absolute -bottom-4 -right-4 md:-bottom-6 md:-right-6 w-24 h-24 md:w-32 md:h-32 rounded-full flex flex-col items-center justify-center shadow-xl" style="background-color: #F8D77E;">
          <p class="font-nunito font-extrabold text-3xl md:text-5xl leading-none" style="color: #2E2A26;">3</p>
          <p class="font-nunito text-[10px] md:text-[11px] uppercase tracking-wider font-bold mt-1 text-center" style="color: #2E2A26;">pros<br/>diplômées</p>
        </div>
      </div>
    </div>
  </div>
</section>
