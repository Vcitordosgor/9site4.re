---
/**
 * Disponibilites — grille places restantes par session 2026.
 */
const sessions = [
  { mois: 'Septembre 2026', places: 3, tranche: '3 mois → 18 mois', statut: 'open' },
  { mois: 'Janvier 2027',   places: 5, tranche: '3 mois → 3 ans',   statut: 'open' },
  { mois: 'Juin 2027',      places: 2, tranche: '18 mois → 3 ans',  statut: 'limited' },
  { mois: 'Liste d\'attente', places: null, tranche: 'Toutes tranches', statut: 'wait' },
];
---

<section id="disponibilites" class="py-20 md:py-28" style="background-color: #FFF8EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12">
      <div class="md:col-span-7">
        <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #A8C9E4;">— Inscriptions 2026 —</p>
        <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
          Places encore <span class="font-caveat font-normal block">disponibles cette année.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-nunito text-[14.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
          Les sessions d'entrée sont calées sur la rentrée scolaire et les périodes de reprise. Inscription en deux temps : visite puis dossier.
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-5">
      {sessions.map((s) => (
        <li class="p-6 md:p-7 rounded-2xl flex flex-col" style={`background-color: ${s.statut === 'wait' ? '#FFFFFF' : '#FFFFFF'}; border: 2px solid ${s.statut === 'limited' ? '#F5C4C4' : s.statut === 'wait' ? '#A8C9E4' : '#F8D77E'};`}>
          <p class="font-nunito font-bold text-[11px] uppercase tracking-wider" style="color: rgb(46 42 38 / 0.6);">Session</p>
          <h3 class="mt-1 font-nunito font-extrabold text-xl md:text-2xl leading-tight" style="color: #2E2A26;">
            {s.mois}
          </h3>

          {s.places !== null ? (
            <p class="mt-4 font-caveat text-5xl leading-none" style={`color: ${s.statut === 'limited' ? '#C26B6B' : '#2E2A26'};`}>
              {s.places} <span class="font-nunito font-bold text-base align-middle">place{s.places > 1 ? 's' : ''}</span>
            </p>
          ) : (
            <p class="mt-4 font-caveat text-3xl leading-none" style="color: #2E2A26;">Ouverte</p>
          )}

          <p class="mt-3 font-nunito text-[13px]" style="color: rgb(46 42 38 / 0.7);">{s.tranche}</p>

          <span class="mt-5 inline-flex w-fit items-center gap-2 px-3 py-1 rounded-full font-nunito font-bold text-[11px] uppercase tracking-wider" style={`background-color: ${s.statut === 'limited' ? '#F5C4C4' : s.statut === 'wait' ? '#A8C9E4' : '#F8D77E'}; color: #2E2A26;`}>
            {s.statut === 'limited' ? '⏳ Bientôt complet' : s.statut === 'wait' ? '✓ Liste ouverte' : '● Inscriptions ouvertes'}
          </span>
        </li>
      ))}
    </ul>

    <p class="mt-8 font-nunito italic text-[13px]" style="color: rgb(46 42 38 / 0.6);">
      Disponibilités actualisées chaque début de mois. Pour les fratries, priorité accordée selon la politique d'accueil.
    </p>
  </div>
</section>
