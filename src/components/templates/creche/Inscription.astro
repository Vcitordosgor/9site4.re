---
import data from '../../../data/templates/nid.json';
const info = data.info;
---

<section id="inscription" class="py-20 md:py-28" style="background-color: #E4B6B6;">
  <div class="max-w-content mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">

      <div class="lg:col-span-5">
        <p class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.28em] mb-4" style="color: #8B4848;">— Inscription —</p>
        <h2 class="font-nunito font-extrabold leading-[1.05]" style="color: #5C3D3D; font-size: clamp(34px, 5vw, 58px);">
          Visite obligatoire <span style="color: #FDF7F0;">avant inscription.</span>
        </h2>
        <p class="mt-6 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(92,61,61,0.85);">
          Vous venez avec votre enfant, on prend le temps de discuter, on visite, on vous montre la journée concrète. Aucun engagement.
        </p>

        <div class="mt-8 space-y-4 font-dm-sans text-[14px]" style="color: #5C3D3D;">
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-[12px] shrink-0" style="background-color: #FDF7F0;">1</span>
            <p>Vous remplissez le formulaire ci-contre.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-[12px] shrink-0" style="background-color: #FDF7F0;">2</span>
            <p>On vous propose un créneau de visite sous 48 h.</p>
          </div>
          <div class="flex items-start gap-3">
            <span class="w-7 h-7 rounded-full flex items-center justify-center font-bold text-[12px] shrink-0" style="background-color: #FDF7F0;">3</span>
            <p>Si tout convient, on planifie la période d'adaptation.</p>
          </div>
        </div>
      </div>

      <form class="lg:col-span-7 p-7 md:p-10 rounded-[40px] grid grid-cols-1 sm:grid-cols-2 gap-4" style="background-color: #FDF7F0;" onsubmit="event.preventDefault(); alert('Démo — formulaire non actif.');">
        <label class="sm:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.2em]" style="color: #C18888;">Votre prénom</span>
          <input type="text" required class="h-12 px-4 rounded-full font-dm-sans text-[14px] outline-none border-2" style="border-color: rgba(228,182,182,0.5); color: #5C3D3D;" />
        </label>
        <label class="sm:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.2em]" style="color: #C18888;">Téléphone</span>
          <input type="tel" required class="h-12 px-4 rounded-full font-dm-sans text-[14px] outline-none border-2" style="border-color: rgba(228,182,182,0.5); color: #5C3D3D;" />
        </label>
        <label class="sm:col-span-2 flex flex-col gap-2">
          <span class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.2em]" style="color: #C18888;">Email</span>
          <input type="email" required class="h-12 px-4 rounded-full font-dm-sans text-[14px] outline-none border-2" style="border-color: rgba(228,182,182,0.5); color: #5C3D3D;" />
        </label>
        <label class="sm:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.2em]" style="color: #C18888;">Âge de l'enfant</span>
          <input type="text" placeholder="ex: 18 mois" class="h-12 px-4 rounded-full font-dm-sans text-[14px] outline-none border-2" style="border-color: rgba(228,182,182,0.5); color: #5C3D3D;" />
        </label>
        <label class="sm:col-span-1 flex flex-col gap-2">
          <span class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.2em]" style="color: #C18888;">Date d'entrée souhaitée</span>
          <input type="text" placeholder="ex: septembre" class="h-12 px-4 rounded-full font-dm-sans text-[14px] outline-none border-2" style="border-color: rgba(228,182,182,0.5); color: #5C3D3D;" />
        </label>
        <label class="sm:col-span-2 flex flex-col gap-2">
          <span class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.2em]" style="color: #C18888;">Mot libre (facultatif)</span>
          <textarea rows="4" class="px-4 py-3 rounded-3xl font-dm-sans text-[14px] outline-none border-2 resize-none" style="border-color: rgba(228,182,182,0.5); color: #5C3D3D;"></textarea>
        </label>
        <button type="submit" class="sm:col-span-2 inline-flex items-center justify-center gap-2 h-13 py-3.5 rounded-full font-dm-sans font-bold text-[14px] transition-transform hover:scale-[1.02]" style="background-color: #5C3D3D; color: #FDF7F0;">
          Demander une visite 🌼
        </button>

        {/* Tarifs résumé */}
        <div class="sm:col-span-2 mt-4 pt-5 border-t" style="border-color: rgba(228,182,182,0.4);">
          <p class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.22em] mb-3" style="color: #C18888;">Tarifs indicatifs</p>
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 font-dm-sans text-[13px]" style="color: #5C3D3D;">
            {data.tarifs.map((t) => (
              <li class="flex justify-between gap-3"><span class="font-semibold">{t.type}</span><span style="color: rgba(92,61,61,0.7);">{t.indication}</span></li>
            ))}
          </ul>
        </div>
      </form>

    </div>
  </div>
</section>
