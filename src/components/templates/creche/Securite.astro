---
import data from '../../../data/templates/nid.json';
---

<section class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Sécurité & cadre —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        Quatre engagements
        <span class="font-caveat font-normal block">qui rassurent les parents.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 md:gap-6">
      {data.securite.map((s, i) => (
        <div class="p-7 md:p-8 rounded-3xl text-center" style={`background-color: ${i % 2 === 0 ? '#A8C9E4' : '#F5C4C4'};`}>
          <!-- Icône check -->
          <div class="inline-flex items-center justify-center w-14 h-14 rounded-full mb-5" style="background-color: #FFFFFF;">
            <svg viewBox="0 0 24 24" class="w-7 h-7" style="color: #2E2A26;" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <h3 class="font-nunito font-extrabold text-lg md:text-xl leading-tight" style="color: #2E2A26;">
            {s.titre}
          </h3>
          <p class="mt-3 font-nunito text-[13px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
            {s.texte}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
