---
import data from '../../../data/templates/nid.json';
---

<section id="pedagogie" class="py-20 md:py-28" style="background-color: #FDF7F0;">
  <div class="max-w-content mx-auto px-5 md:px-10">
    <div class="max-w-3xl mb-14">
      <p class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.28em] mb-4" style="color: #C18888;">— Notre pédagogie —</p>
      <h2 class="font-nunito font-extrabold leading-[1.05]" style="color: #5C3D3D; font-size: clamp(34px, 5vw, 58px);">
        Quatre <span style="color: #B89441;">repères</span> au quotidien.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {data.pedagogie.map((p, i) => {
        const bgs = ['#E4B6B6', '#FCDA89', '#A8C3A0', '#F6C9A1'];
        return (
          <article class="p-7 md:p-8 rounded-3xl" style={`background-color: ${bgs[i]};`}>
            <p class="font-dm-sans text-[11px] font-bold uppercase tracking-[0.2em]" style="color: #5C3D3D; opacity: 0.7;">{p.tagline}</p>
            <h3 class="font-nunito font-extrabold text-2xl md:text-3xl mt-2 mb-3" style="color: #5C3D3D;">{p.titre}</h3>
            <p class="font-dm-sans text-[14.5px] leading-relaxed" style="color: rgba(92,61,61,0.85);">{p.description}</p>
          </article>
        );
      })}
    </div>
  </div>
</section>
