---
import data from '../../../data/templates/nid.json';

const bgColors = ['#F5C4C4', '#A8C9E4', '#F8D77E', '#FFFFFF'];
---

<section id="pedagogie" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Notre approche —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        Quatre piliers,
        <span class="font-caveat font-normal block" style="color: #2E2A26;">une seule philosophie.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {data.pedagogie.map((p, i) => (
        <article class="p-7 md:p-10 rounded-3xl transition-all hover:-translate-y-1 hover:shadow-xl" style={`background-color: ${bgColors[i]};`}>
          <div class="flex items-start gap-5 mb-5">
            <div class="shrink-0 w-14 h-14 rounded-full flex items-center justify-center" style="background-color: #FFFFFF;">
              {p.icon === 'leaf' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" style="color: #2E2A26;" fill="currentColor" aria-hidden="true">
                  <path d="M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
                </svg>
              )}
              {p.icon === 'moon' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" style="color: #2E2A26;" fill="currentColor" aria-hidden="true">
                  <path d="M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z"/>
                </svg>
              )}
              {p.icon === 'hand' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" style="color: #2E2A26;" fill="currentColor" aria-hidden="true">
                  <path d="M9 11.5V8a3 3 0 016 0v3.5M5 11.5h14v8a4 4 0 01-4 4H9a4 4 0 01-4-4v-8z"/>
                </svg>
              )}
              {p.icon === 'sun' && (
                <svg viewBox="0 0 24 24" class="w-7 h-7" style="color: #2E2A26;" fill="currentColor" aria-hidden="true">
                  <circle cx="12" cy="12" r="5"/>
                  <path d="M12 1v3M12 20v3M4.22 4.22l2.12 2.12M17.66 17.66l2.12 2.12M1 12h3M20 12h3M4.22 19.78l2.12-2.12M17.66 6.34l2.12-2.12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              )}
            </div>
            <div class="flex-1">
              <h3 class="font-nunito font-extrabold text-2xl md:text-3xl leading-tight" style="color: #2E2A26;">
                {p.titre}
              </h3>
              <p class="mt-1 font-caveat text-xl md:text-2xl" style="color: #2E2A26; opacity: 0.75;">
                {p.tagline}
              </p>
            </div>
          </div>

          <p class="font-nunito text-[14.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.82);">
            {p.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
