---
import data from '../../../data/templates/nid.json';
const roles = data.equipe;
---

<section id="equipe" class="py-20 md:py-28" style="background-color: #FCDA89;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 items-end">
      <div class="lg:col-span-7">
        <p class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.28em] mb-4" style="color: #8C6A1A;">— Notre équipe —</p>
        <h2 class="font-nunito font-extrabold leading-[1.05]" style="color: #5C3D3D; font-size: clamp(34px, 5vw, 58px);">
          Diplômée, présente, <span style="color: #C18888;">constante.</span>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="font-dm-sans text-[15px] leading-relaxed" style="color: rgba(92,61,61,0.78);">
          Quatre professionnelles formées petite enfance. Pas d'intérim, pas de turn-over. Une référente par enfant pour mieux comprendre ses signaux.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-5">
      {roles.map((r) => (
        <article class="p-6 md:p-7 rounded-3xl flex flex-col gap-3" style="background-color: #FDF7F0;">
          <div class="w-14 h-14 rounded-full flex items-center justify-center font-nunito font-bold text-xl" style="background-color: #E4B6B6; color: #5C3D3D;">{r.nom}</div>
          <p class="font-nunito font-bold text-lg" style="color: #5C3D3D;">{r.role}</p>
          <p class="font-dm-sans text-[12.5px] leading-relaxed" style="color: rgba(92,61,61,0.7);">
            Formée petite enfance, présente toute la journée. Référente d'un petit groupe d'enfants pour assurer la continuité.
          </p>
        </article>
      ))}
    </div>

    <p class="mt-10 font-dm-sans italic text-[12.5px] max-w-2xl" style="color: rgba(92,61,61,0.6);">
      Pour préserver la vie privée des enfants, aucun nom complet ni photo des enfants n'apparaît sur ce site.
    </p>
  </div>
</section>
