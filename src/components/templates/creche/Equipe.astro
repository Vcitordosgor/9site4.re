---
import data from '../../../data/templates/nid.json';
---

<section id="equipe" class="py-20 md:py-28" style="background-color: #FFF8EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Notre équipe —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        Quatre professionnelles
        <span class="font-caveat font-normal block">qui connaissent vos enfants par cœur.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {data.equipe.map((m) => (
        <article class="group p-5 rounded-3xl transition-all hover:-translate-y-1 hover:shadow-lg" style="background-color: #FFFFFF;">
          <div class="relative aspect-square overflow-hidden rounded-2xl mb-4">
            <img
              src={m.photo}
              alt={`Portrait de ${m.nom}, ${m.role}`}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
          </div>
          <h3 class="font-nunito font-extrabold text-lg md:text-xl leading-tight" style="color: #2E2A26;">
            {m.nom}
          </h3>
          <p class="mt-1 font-caveat text-lg" style="color: #2E2A26; opacity: 0.7;">
            {m.role}
          </p>
          <div class="mt-3 pt-3 border-t" style="border-color: rgb(46 42 38 / 0.1);">
            <p class="font-nunito text-[12px] font-semibold" style="color: #2E2A26;">
              {m.diplome}
            </p>
            <p class="mt-1 font-nunito text-[11.5px]" style="color: rgb(46 42 38 / 0.6);">
              ✦ {m.anciennete}
            </p>
          </div>
          <p class="mt-4 font-nunito text-[12.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.75);">
            {m.bio}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
