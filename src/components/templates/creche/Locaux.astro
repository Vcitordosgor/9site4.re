---
import data from '../../../data/templates/nid.json';
---

<section id="locaux" class="py-20 md:py-28" style="background-color: #FFF8EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Les locaux —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        120 m² + jardin,
        <span class="font-caveat font-normal block">pensés pour les tout-petits.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {data.locaux.map((l, i) => (
        <article class="group rounded-3xl overflow-hidden transition-all hover:-translate-y-1 hover:shadow-xl" style="background-color: #FFFFFF;">
          <div class="relative aspect-[16/10] overflow-hidden">
            <img
              src={l.photo}
              alt={l.espace}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute top-4 left-4 px-3 py-1.5 rounded-full" style="background-color: #FFFFFF;">
              <p class="font-nunito font-bold text-[11px] uppercase tracking-wider" style="color: #2E2A26;">
                0{i + 1} · espace {i + 1}/4
              </p>
            </div>
          </div>
          <div class="p-6 md:p-7">
            <h3 class="font-nunito font-extrabold text-xl md:text-2xl leading-tight" style="color: #2E2A26;">
              {l.espace}
            </h3>
            <p class="mt-2 font-nunito text-[14px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
              {l.description}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
