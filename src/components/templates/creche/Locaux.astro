---
const galerie = [
  { photo: '/images/creche/extra-9.webp', label: 'Coin lecture & câlins' },
  { photo: '/images/creche/extra-10.webp', label: 'Activité libre' },
  { photo: '/images/creche/salle-vie.webp', label: 'Salle de vie principale' },
  { photo: '/images/creche/coin-jouets.webp', label: 'Coin jouets en bois' },
];
---

<section id="locaux" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-12 items-end">
      <div class="lg:col-span-7">
        <p class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.28em] mb-4" style="color: #C18888;">— Nos locaux —</p>
        <h2 class="font-nunito font-extrabold leading-[1.05]" style="color: #5C3D3D; font-size: clamp(34px, 5vw, 58px);">
          Un espace pensé <span style="color: #B89441;">à hauteur d'enfant.</span>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="font-dm-sans text-[15px] leading-relaxed" style="color: rgba(92,61,61,0.78);">
          Lumière naturelle, mobilier bas, matériaux nobles. Tout est conçu pour que l'enfant puisse explorer en sécurité, choisir, ranger seul.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 md:gap-5">
      {galerie.map((g, i) => (
        <figure class={`relative aspect-square overflow-hidden rounded-[32px] ${i === 0 || i === 2 ? 'lg:row-span-2 lg:aspect-[3/4]' : ''}`}>
          <img src={g.photo} alt={g.label} loading="lazy" class="w-full h-full object-cover" />
          <figcaption class="absolute bottom-3 left-3 px-3 py-1.5 rounded-full font-dm-sans text-[11.5px] font-semibold" style="background-color: rgba(253,247,240,0.92); color: #5C3D3D;">{g.label}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>
