---
import data from '../../../data/templates/nid.json';
---

<section id="tarifs" class="py-20 md:py-28" style="background-color: #FFF8EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Tarifs & CAF —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        Modulé selon
        <span class="font-caveat font-normal block">votre quotient familial.</span>
      </h2>
      <p class="mt-5 font-nunito text-[15px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
        Nous appliquons le barème CAF : votre tarif horaire est calculé selon vos revenus.
        La prestation d'accueil du jeune enfant (PAJE) prend en charge une part importante.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 max-w-4xl mx-auto">
      {data.tarifs.map((t, i) => (
        <div class="p-7 md:p-9 rounded-3xl" style={`background-color: ${i % 2 === 0 ? '#FFFFFF' : '#F8D77E'};`}>
          <div class="flex items-start justify-between gap-4 mb-4">
            <h3 class="font-nunito font-extrabold text-xl md:text-2xl leading-tight" style="color: #2E2A26;">
              {t.type}
            </h3>
            <span class="shrink-0 px-3 py-1.5 rounded-full font-nunito font-bold text-[10.5px] uppercase tracking-wider" style={`background-color: ${i % 2 === 0 ? '#A8C9E4' : '#FFFFFF'}; color: #2E2A26;`}>
              0{i + 1}
            </span>
          </div>
          <p class="font-caveat text-xl md:text-2xl" style="color: #2E2A26; opacity: 0.75;">
            {t.duree}
          </p>
          <p class="mt-4 font-nunito font-bold text-[14px]" style="color: #2E2A26;">
            ✦ {t.indication}
          </p>
          <p class="mt-2 font-nunito text-[13px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
            {t.detail}
          </p>
        </div>
      ))}
    </div>

    <p class="mt-12 text-center font-caveat text-2xl md:text-3xl" style="color: #2E2A26; opacity: 0.7;">
      ✦ Crédit d'impôt 50% sur le reste à charge ✦
    </p>
  </div>
</section>
