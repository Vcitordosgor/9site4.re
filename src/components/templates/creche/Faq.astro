---
import data from '../../../data/templates/nid.json';
---

<section class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-3xl mx-auto px-6 md:px-10">

    <div class="text-center mb-12 md:mb-16">
      <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Vos questions —</p>
      <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
        Avant d'inscrire
        <span class="font-caveat font-normal block">votre tout-petit.</span>
      </h2>
    </div>

    <div class="space-y-3">
      {data.faq.map((f) => (
        <details class="group rounded-2xl border-2 transition-colors" style="background-color: #FFF8EE; border-color: transparent;" onmouseover="this.style.borderColor='#F8D77E';" onmouseout="this.style.borderColor='transparent';">
          <summary class="cursor-pointer list-none flex items-start gap-4 p-5 md:p-7">
            <span class="font-nunito font-extrabold text-3xl leading-none mt-0.5 transition-transform duration-300 group-open:rotate-45" style="color: #F8D77E;" aria-hidden="true">+</span>
            <span class="flex-1 font-nunito font-bold text-base md:text-lg leading-snug" style="color: #2E2A26;">{f.q}</span>
          </summary>
          <div class="px-5 md:px-7 pb-6 md:pb-8 pl-14 md:pl-16">
            <p class="font-nunito text-[14px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">{f.r}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
