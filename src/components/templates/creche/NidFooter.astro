---
import data from '../../../data/templates/nid.json';
---

<footer style="background-color: #2E2A26; color: #FFF8EE;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 36 36" class="w-10 h-10" aria-hidden="true">
            <path d="M5 24 Q 18 14 31 24 Q 31 30 18 30 Q 5 30 5 24 Z" fill="#F8D77E"/>
            <circle cx="14" cy="22" r="2.5" fill="#F5C4C4"/>
            <circle cx="19" cy="20.5" r="2.5" fill="#A8C9E4"/>
            <circle cx="24" cy="22" r="2.5" fill="#F5C4C4"/>
          </svg>
          <div class="leading-tight">
            <p class="font-nunito font-extrabold text-2xl">Le Nid</p>
            <p class="font-caveat text-lg" style="color: #F8D77E;">micro-crèche</p>
          </div>
        </div>
        <p class="mt-5 font-nunito text-[14px] leading-relaxed max-w-sm" style="color: rgb(255 248 238 / 0.78);">
          {data.info.tagline} — Micro-crèche agréée PMI à La Réunion depuis {data.info.annee}.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-nunito font-bold text-[11px] uppercase tracking-[0.18em] mb-3" style="color: #F8D77E;">Le Nid</p>
        <ul class="space-y-2 font-nunito text-[14px]">
          <li><a href="#pedagogie" class="transition-colors hover:underline">Pédagogie</a></li>
          <li><a href="#equipe" class="transition-colors hover:underline">Équipe</a></li>
          <li><a href="#journee" class="transition-colors hover:underline">Une journée</a></li>
          <li><a href="#locaux" class="transition-colors hover:underline">Les locaux</a></li>
          <li><a href="#tarifs" class="transition-colors hover:underline">Tarifs CAF</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-nunito font-bold text-[11px] uppercase tracking-[0.18em] mb-3" style="color: #F8D77E;">Contact</p>
        <ul class="space-y-2 font-nunito text-[14px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="hover:underline">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="hover:underline">{data.info.email}</a></li>
          <li style="color: rgb(255 248 238 / 0.6);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-nunito text-[11px]" style="border-color: rgb(248 215 126 / 0.25); color: rgb(255 248 238 / 0.55);">
      <p>© {data.info.annee}–2026 {data.info.nom} · SIRET …{data.info.siret.slice(-5)} · Agrément PMI 974</p>
      <p class="font-caveat text-xl normal-case" style="color: #F8D77E;">Un nid pour grandir.</p>
    </div>
  </div>
</footer>
