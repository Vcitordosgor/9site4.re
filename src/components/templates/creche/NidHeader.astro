---
import data from '../../../data/templates/nid.json';

const navLinks = [
  { href: '#pedagogie', label: 'Pédagogie' },
  { href: '#equipe', label: 'Équipe' },
  { href: '#journee', label: 'Une journée' },
  { href: '#locaux', label: 'Les locaux' },
  { href: '#tarifs', label: 'Tarifs' },
];
---

<header
  id="nid-header"
  data-scrolled="false"
  class="sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500 border-b"
  style="background-color: rgb(255 248 238 / 0.95); border-color: rgb(46 42 38 / 0.1);"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">

    <a href="#top" class="flex items-center gap-3 group" aria-label="Le Nid — accueil">
      <!-- Picto nid avec œufs -->
      <svg viewBox="0 0 36 36" class="w-9 h-9" aria-hidden="true">
        <path d="M5 24 Q 18 14 31 24 Q 31 30 18 30 Q 5 30 5 24 Z" fill="#F8D77E"/>
        <circle cx="14" cy="22" r="2.5" fill="#F5C4C4"/>
        <circle cx="19" cy="20.5" r="2.5" fill="#A8C9E4"/>
        <circle cx="24" cy="22" r="2.5" fill="#F5C4C4"/>
      </svg>
      <div class="flex flex-col leading-tight">
        <span class="font-nunito font-bold text-xl md:text-2xl" style="color: #2E2A26;">Le Nid</span>
        <span class="font-caveat text-base -mt-1" style="color: #2E2A26; opacity: 0.6;">micro-crèche</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-9 font-nunito text-[13px] font-semibold" aria-label="Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors duration-300" style="color: #2E2A26;" onmouseover="this.style.color='#F8D77E';" onmouseout="this.style.color='#2E2A26';">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite visiter Le Nid et étudier une inscription.')}`}
      target="_blank"
      rel="noopener"
      class="hidden md:inline-flex items-center justify-center h-11 px-6 font-nunito font-bold text-[13px] rounded-full transition-all duration-300 shadow-md"
      style="background-color: #F8D77E; color: #2E2A26;"
      onmouseover="this.style.backgroundColor='#2E2A26'; this.style.color='#F8D77E';"
      onmouseout="this.style.backgroundColor='#F8D77E'; this.style.color='#2E2A26';"
    >
      Visiter Le Nid
    </a>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="md:hidden inline-flex items-center justify-center h-11 px-4 font-nunito font-bold text-[13px] rounded-full"
      style="background-color: #F8D77E; color: #2E2A26;"
      aria-label="Appeler"
    >
      Appeler
    </a>
  </div>
</header>

<style>
  #nid-header[data-scrolled='true'] {
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 1px 3px rgb(46 42 38 / 0.08);
  }
</style>

<script>
  const header = document.getElementById('nid-header');
  if (header) {
    const update = () => { header.dataset.scrolled = String(window.scrollY > 8); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
