---
import data from '../../../data/templates/nid.json';

// Icône SVG inline associée à chaque moment, déduite du mot-clé du titre.
const iconFor = (moment: string): string => {
  const m = moment.toLowerCase();
  if (m.includes('arrivée') || m.includes('câlin')) return 'hug';
  if (m.includes('activité') || m.includes('atelier')) return 'blocks';
  if (m.includes('jardin') || m.includes('extérieur')) return 'leaf';
  if (m.includes('repas')) return 'bowl';
  if (m.includes('sieste')) return 'moon';
  if (m.includes('goûter') || m.includes('réveil')) return 'apple';
  if (m.includes('départ')) return 'wave';
  return 'star';
};
---

<section id="journee" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Une journée type —</p>
        <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
          De 7h à 19h,
          <span class="font-caveat font-normal block">chaque moment compte.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-nunito text-[14.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
          Le rythme ci-dessous est indicatif. Chaque enfant a son rythme propre — sommeil,
          repas, jeux — toujours respecté.
        </p>
      </div>
    </div>

    <!-- Bande horaire 7h → 19h -->
    <div class="mb-8 flex items-center justify-between text-[11px] font-nunito font-bold uppercase tracking-wider px-1" style="color: rgb(46 42 38 / 0.55);">
      <span>7h</span><span class="hidden sm:inline">10h</span><span class="hidden sm:inline">13h</span><span class="hidden sm:inline">16h</span><span>19h</span>
    </div>
    <div class="h-1.5 rounded-full mb-10" style="background: linear-gradient(90deg, #F8D77E 0%, #F5C4C4 50%, #A8C9E4 100%);" aria-hidden="true"></div>

    <div class="relative">
      <!-- Ligne verticale colorée -->
      <div class="absolute left-[68px] md:left-[120px] top-4 bottom-4 w-1 rounded-full hidden sm:block" style="background: linear-gradient(180deg, #F8D77E 0%, #F5C4C4 50%, #A8C9E4 100%);" aria-hidden="true"></div>

      <ol class="space-y-5">
        {data.journee.map((j, i) => {
          const ic = iconFor(j.moment);
          return (
          <li class="relative grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start">
            <!-- Horaire -->
            <div class="sm:col-span-2">
              <p class="font-nunito font-bold text-[13.5px] uppercase tracking-wider" style="color: #2E2A26; opacity: 0.7;">
                {j.horaire}
              </p>
            </div>
            <!-- Bullet + icône -->
            <div class="hidden sm:flex sm:col-span-1 justify-center pt-1">
              <div class="relative z-10 w-10 h-10 rounded-full ring-4 flex items-center justify-center" style={`background-color: ${i % 3 === 0 ? '#F8D77E' : i % 3 === 1 ? '#F5C4C4' : '#A8C9E4'}; --tw-ring-color: #FFFFFF;`}>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#2E2A26" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  {ic === 'hug' && <><circle cx="12" cy="8" r="3"/><path d="M5 21c1.5-3 4-5 7-5s5.5 2 7 5"/></>}
                  {ic === 'blocks' && <><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="8" y="14" width="8" height="7" rx="1"/></>}
                  {ic === 'leaf' && <><path d="M11 20A7 7 0 0 1 4 13c0-5 6-9 16-9-1 8-4 16-9 16Z"/><path d="M4 20c2-4 6-7 11-8"/></>}
                  {ic === 'bowl' && <><path d="M3 10h18a9 9 0 0 1-18 0Z"/><path d="M12 4v3"/></>}
                  {ic === 'moon' && <><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></>}
                  {ic === 'apple' && <><path d="M12 7c0-2 1-4 4-4-1 3-2 4-4 4Z"/><path d="M8 20a6 6 0 0 1-2-9c1.5-1.5 4-1.5 6 0 2-1.5 4.5-1.5 6 0a6 6 0 0 1-2 9c-1.5 1-3 1-4 0-1 1-2.5 1-4 0Z"/></>}
                  {ic === 'wave' && <><path d="M5 8c2 2 4 2 7 0s5-2 7 0"/><path d="M5 14c2 2 4 2 7 0s5-2 7 0"/></>}
                  {ic === 'star' && <polygon points="12 3 14.5 9.5 21 10 16 14.5 17.5 21 12 17.5 6.5 21 8 14.5 3 10 9.5 9.5 12 3"/>}
                </svg>
              </div>
            </div>
            <!-- Texte -->
            <div class="sm:col-span-9 p-5 md:p-6 rounded-2xl" style="background-color: #FFF8EE;">
              <h3 class="font-nunito font-extrabold text-lg md:text-xl leading-tight flex items-center gap-3" style="color: #2E2A26;">
                <span class="sm:hidden inline-flex w-8 h-8 rounded-full items-center justify-center" style={`background-color: ${i % 3 === 0 ? '#F8D77E' : i % 3 === 1 ? '#F5C4C4' : '#A8C9E4'};`}>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#2E2A26" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    {ic === 'hug' && <><circle cx="12" cy="8" r="3"/><path d="M5 21c1.5-3 4-5 7-5s5.5 2 7 5"/></>}
                    {ic === 'blocks' && <><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="8" y="14" width="8" height="7" rx="1"/></>}
                    {ic === 'leaf' && <><path d="M11 20A7 7 0 0 1 4 13c0-5 6-9 16-9-1 8-4 16-9 16Z"/><path d="M4 20c2-4 6-7 11-8"/></>}
                    {ic === 'bowl' && <><path d="M3 10h18a9 9 0 0 1-18 0Z"/><path d="M12 4v3"/></>}
                    {ic === 'moon' && <><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></>}
                    {ic === 'apple' && <><path d="M12 7c0-2 1-4 4-4-1 3-2 4-4 4Z"/><path d="M8 20a6 6 0 0 1-2-9c1.5-1.5 4-1.5 6 0 2-1.5 4.5-1.5 6 0a6 6 0 0 1-2 9c-1.5 1-3 1-4 0-1 1-2.5 1-4 0Z"/></>}
                    {ic === 'wave' && <><path d="M5 8c2 2 4 2 7 0s5-2 7 0"/><path d="M5 14c2 2 4 2 7 0s5-2 7 0"/></>}
                    {ic === 'star' && <polygon points="12 3 14.5 9.5 21 10 16 14.5 17.5 21 12 17.5 6.5 21 8 14.5 3 10 9.5 9.5 12 3"/>}
                  </svg>
                </span>
                {j.moment}
              </h3>
              <p class="mt-2 font-nunito text-[13.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
                {j.detail}
              </p>
            </div>
          </li>
        );})}
      </ol>
    </div>
  </div>
</section>
