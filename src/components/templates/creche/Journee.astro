---
import data from '../../../data/templates/nid.json';
const photos = [
  '/images/creche/extra-1.webp',
  '/images/creche/extra-2.webp',
  '/images/creche/extra-3.webp',
  '/images/creche/extra-4.webp',
  '/images/creche/extra-5.webp',
  '/images/creche/extra-6.webp',
  '/images/creche/extra-7.webp',
  '/images/creche/extra-8.webp',
];
const journee = data.journee;
---

<section id="journee" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="max-w-3xl mb-14 md:mb-20">
      <p class="font-dm-sans text-[11.5px] font-semibold uppercase tracking-[0.28em] mb-4" style="color: #C18888;">— Une journée au Nid —</p>
      <h2 class="font-nunito font-extrabold leading-[1.05]" style="color: #5C3D3D; font-size: clamp(34px, 5vw, 58px);">
        De 7h à 19h, <span style="color: #B89441;">heure par heure.</span>
      </h2>
      <p class="mt-6 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(92,61,61,0.75);">
        Une journée rythmée mais souple. Pas de minuteur, pas de groupe forcé — chaque moment respire selon les enfants présents.
      </p>
    </div>

    <ol class="relative">
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px -translate-x-1/2" style="background-color: rgba(228,182,182,0.4);" aria-hidden="true"></div>

      {journee.map((j, i) => (
        <li class="relative mb-10 md:mb-16 md:grid md:grid-cols-2 md:gap-12 items-center">
          {/* Photo */}
          <div class={`md:col-span-1 ${i % 2 === 0 ? 'md:order-1' : 'md:order-2'}`}>
            <div class="relative aspect-[4/3] overflow-hidden rounded-[40px]">
              <img src={photos[i]} alt={`Moment crèche · ${j.moment}`} loading="lazy" class="w-full h-full object-cover" />
            </div>
          </div>

          {/* Centre dot */}
          <div class="hidden md:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-14 h-14 rounded-full items-center justify-center z-10" style="background-color: #FDF7F0; border: 2px solid #E4B6B6;">
            <span class="font-nunito font-bold text-[11px]" style="color: #5C3D3D;">{String(i+1).padStart(2,'0')}</span>
          </div>

          {/* Text */}
          <div class={`md:col-span-1 mt-5 md:mt-0 ${i % 2 === 0 ? 'md:order-2 md:pl-10' : 'md:order-1 md:pr-10 md:text-right'}`}>
            <p class="font-nunito font-extrabold text-3xl md:text-4xl" style="color: #C18888;">{j.horaire}</p>
            <h3 class="font-nunito font-bold text-2xl md:text-3xl mt-2 mb-3" style="color: #5C3D3D;">{j.moment}</h3>
            <p class="font-dm-sans text-[14.5px] leading-relaxed max-w-md" style={`color: rgba(92,61,61,0.78); ${i % 2 === 1 ? 'margin-left: auto;' : ''}`}>{j.detail}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
