---
import data from '../../../data/templates/nid.json';
---

<section id="journee" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-caveat text-3xl md:text-4xl mb-2" style="color: #F8D77E;">— Une journée type —</p>
        <h2 class="font-nunito font-extrabold text-4xl md:text-5xl leading-tight" style="color: #2E2A26;">
          De 7h à 19h,
          <span class="font-caveat font-normal block">chaque moment compte.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-nunito text-[14.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
          Le rythme ci-dessous est indicatif. Chaque enfant a son rythme propre — sommeil,
          repas, jeux — toujours respecté.
        </p>
      </div>
    </div>

    <div class="relative">
      <!-- Ligne verticale colorée -->
      <div class="absolute left-[68px] md:left-[120px] top-4 bottom-4 w-1 rounded-full hidden sm:block" style="background: linear-gradient(180deg, #F8D77E 0%, #F5C4C4 50%, #A8C9E4 100%);" aria-hidden="true"></div>

      <ol class="space-y-5">
        {data.journee.map((j, i) => (
          <li class="relative grid grid-cols-1 sm:grid-cols-12 gap-4 sm:gap-6 items-start">
            <!-- Horaire -->
            <div class="sm:col-span-2">
              <p class="font-nunito font-bold text-[13.5px] uppercase tracking-wider" style="color: #2E2A26; opacity: 0.7;">
                {j.horaire}
              </p>
            </div>
            <!-- Bullet -->
            <div class="hidden sm:flex sm:col-span-1 justify-center pt-1">
              <div class="relative z-10 w-6 h-6 rounded-full ring-4" style={`background-color: ${i % 3 === 0 ? '#F8D77E' : i % 3 === 1 ? '#F5C4C4' : '#A8C9E4'}; --tw-ring-color: #FFFFFF;`}></div>
            </div>
            <!-- Texte -->
            <div class="sm:col-span-9 p-5 md:p-6 rounded-2xl" style="background-color: #FFF8EE;">
              <h3 class="font-nunito font-extrabold text-lg md:text-xl leading-tight" style="color: #2E2A26;">
                {j.moment}
              </h3>
              <p class="mt-2 font-nunito text-[13.5px] leading-relaxed" style="color: rgb(46 42 38 / 0.78);">
                {j.detail}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
