<section class="relative w-full overflow-hidden" style="background:#FFD93D;">
  <div class="grid md:grid-cols-2 items-center min-h-[88vh]">
    <div class="relative order-2 md:order-1 px-6 md:px-14 py-14 md:py-0">
      <p class="font-fraunces italic text-2xl md:text-3xl mb-4" style="color:#FF6F91;">vanille, letchi, mangue, coco —</p>
      <h1 class="font-fraunces text-6xl md:text-8xl leading-[0.92]" style="color:#3D2817;">
        Le sorbet,<br/><em class="italic" style="color:#FF6F91;">à l'île.</em>
      </h1>
      <p class="mt-7 max-w-md text-lg leading-relaxed" style="color:#5C3A1E;">
        Sorbets et glaces artisanaux, 100% fruits de l'île. Sans colorant, sans arôme, sans poudre. Juste de la pulpe pressée le matin même et un peu de sucre de canne.
      </p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#parfums" class="inline-flex items-center h-13 px-7 text-[12px] uppercase tracking-[0.22em] font-bold transition-transform hover:scale-105"
           style="background:#3D2817; color:#FFD93D; border-radius:999px; height:52px;">Découvrir les parfums</a>
        <a href="#tournee" class="inline-flex items-center h-13 px-7 text-[12px] uppercase tracking-[0.22em] font-bold transition-transform hover:scale-105 border-2"
           style="border-color:#3D2817; color:#3D2817; border-radius:999px; height:52px;">Où nous croiser</a>
      </div>
    </div>
    <div class="relative order-1 md:order-2 min-h-[340px] md:min-h-[88vh]">
      <img src="/images/glacier/hero.webp" alt="Cornet glacé artisanal" class="absolute inset-0 w-full h-full object-cover" fetchpriority="high"/>
      <div class="absolute top-8 left-8 px-4 py-2 text-[11px] uppercase tracking-[0.28em] font-bold" style="background:#FF6F91; color:#FFF6E2; border-radius:999px;">Tournée Sud · ce dimanche</div>
    </div>
  </div>
</section>
