---
import data from '../../../data/templates/sorbetpei.json';
const icons = ['producteur', 'pulpe', 'turbine', 'repos', 'service'];
const colors = ['#FFB347', '#FF6F91', '#FFD93D', '#A8D5BA', '#3D2817'];
const fonds = ['#FFE4B8', '#FFD9E1', '#FFF3B8', '#DDEFE4', '#D4B89E'];

const etapes = [
  ...data.processus,
  { etape: '05', titre: 'Service direct', texte: "Le camion roule, on déguste. Les bacs partent en boutique éphémère, les pots à emporter en marché, les cornets sur le camion." },
];
---
<section id="processus" class="relative py-24 md:py-36" style="background:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="max-w-3xl mb-14 md:mb-20">
      <p class="text-[11px] uppercase tracking-[0.42em] mb-3 font-bold flex items-center gap-3" style="color:#FF6F91;">
        <span class="block w-10 h-px" style="background:#FF6F91;"></span>
        Processus artisanal
      </p>
      <h2 class="font-fraunces leading-[0.92] tracking-[-0.015em]" style="font-size:clamp(40px,6vw,84px); color:#3D2817;">
        Du fruit
        <span class="block italic" style="color:#FF6F91; font-size:clamp(54px,7.8vw,108px);">au cornet, en 24 h.</span>
      </h2>
    </div>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-5">
      {etapes.map((e, i) => (
        <li class="relative p-7 rounded-[28px] transition-all duration-500 hover:-translate-y-1" style={`background:${fonds[i] ?? '#FFF6E2'}; color:#3D2817;`}>
          <div class="w-16 h-16 rounded-full flex items-center justify-center mb-5" style={`background:${colors[i] ?? '#FF6F91'}; color:#FFF6E2;`}>
            <svg viewBox="0 0 32 32" class="w-9 h-9" aria-hidden="true">
              {icons[i] === 'producteur' && <path d="M16 4 L20 12 L28 14 L22 20 L23 28 L16 24 L9 28 L10 20 L4 14 L12 12 Z" fill="currentColor"/>}
              {icons[i] === 'pulpe' && <g><circle cx="16" cy="16" r="11" fill="currentColor"/><path d="M16 7 L18 13 L24 14 L19 18 L20 24 L16 21 L12 24 L13 18 L8 14 L14 13 Z" fill="#FFF6E2" opacity="0.5"/></g>}
              {icons[i] === 'turbine' && <g><circle cx="16" cy="16" r="10" fill="none" stroke="currentColor" stroke-width="2"/><path d="M16 7 L16 16 L22 19" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round"/></g>}
              {icons[i] === 'repos' && <g><rect x="6" y="10" width="20" height="14" rx="3" fill="currentColor"/><path d="M11 14 L13 18 L21 14" stroke="#FFF6E2" stroke-width="1.5" fill="none"/></g>}
              {icons[i] === 'service' && <g><path d="M6 14 Q16 4 26 14 L26 22 Q16 28 6 22 Z" fill="currentColor"/><circle cx="12" cy="13" r="1.5" fill="#FFF6E2"/><circle cx="16" cy="11" r="1.5" fill="#FFF6E2"/><circle cx="20" cy="13" r="1.5" fill="#FFF6E2"/></g>}
            </svg>
          </div>
          <p class="font-fraunces italic text-3xl leading-none" style="color:#FF6F91;">{e.etape}</p>
          <h3 class="mt-3 font-fraunces text-xl md:text-2xl leading-tight">{e.titre}</h3>
          <p class="mt-3 text-[13.5px] leading-relaxed" style="font-family:'DM Sans',system-ui,sans-serif; color:#5C3A1E;">{e.texte}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
