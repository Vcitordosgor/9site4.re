---
const etapes = [
  { num: '01', t: 'Marché 6h', d: 'On part avant le soleil chercher la pulpe du jour. Mangue à Saint-Joseph, ananas au Tampon.' },
  { num: '02', t: 'Pressage main', d: 'Tout est pelé, dénoyauté, pressé à la centrifugeuse. Pas de pulpe industrielle, jamais.' },
  { num: '03', t: 'Mélange minute', d: 'Pulpe + sucre de canne + un soupçon de citron. Aucun stabilisant, aucun arôme.' },
  { num: '04', t: 'Turbinage', d: 'Glaçage à la turbine -10°C, 18 minutes. Texture aérée, cristaux fins.' },
  { num: '05', t: 'Service direct', d: 'On charge le camion et on roule. Le sorbet est meilleur dans les 24h qui suivent.' },
];
---
<section id="processus" class="py-24 md:py-32" style="background:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <p class="font-fraunces italic text-2xl mb-2" style="color:#FF6F91;">l'atelier —</p>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#3D2817;">Du fruit au cornet, <em class="italic">en 24h.</em></h2>
    </div>
    <div class="grid md:grid-cols-5 gap-4">
      {etapes.map(e => (
        <div class="p-6 transition-transform hover:-translate-y-1 duration-300" style="background:#FFD93D; border-radius:20px; color:#3D2817;">
          <div class="font-fraunces italic text-4xl mb-2" style="color:#FF6F91;">{e.num}</div>
          <h3 class="font-fraunces text-xl mb-2">{e.t}</h3>
          <p class="text-[13px] leading-relaxed">{e.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>
