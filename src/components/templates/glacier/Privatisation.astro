---
import data from '../../../data/templates/sorbetpei.json';
const formules = [
  { titre: 'Mariage / Cérémonie', prix: 'à partir de 380€', desc: '2 parfums au choix, 3h sur place, service à la cuillère, jusqu\'à 80 invités.' },
  { titre: 'Anniversaire enfant', prix: 'à partir de 220€', desc: '2 parfums, 2h sur place, cornets enfants jusqu\'à 30 invités, animation possible.' },
  { titre: 'Événement pro', prix: 'sur devis', desc: 'Pot d\'accueil, lancement produit, séminaire — 3 parfums, signalétique personnalisable.' },
];
---
<section id="privatisation" class="py-24 md:py-28" style="background:#FFB347;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-2 gap-12 mb-12 items-end">
      <div>
        <p class="font-fraunces italic text-2xl mb-2" style="color:#3D2817;">privatisation —</p>
        <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#3D2817;">Le camion <em class="italic" style="color:#FFF6E2;">pour vous.</em></h2>
      </div>
      <p class="text-lg leading-relaxed" style="color:#3D2817;">
        Mariages, anniversaires, lancements de marque. On débarque le camion, on sert les invités, on remballe. Une présence solaire pour vos moments importants.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-5 mb-10">
      {formules.map(f => (
        <article class="p-7" style="background:#FFF6E2; color:#3D2817; border-radius:24px;">
          <h3 class="font-fraunces text-2xl mb-3">{f.titre}</h3>
          <div class="font-fraunces italic text-xl mb-3" style="color:#FF6F91;">{f.prix}</div>
          <p class="text-[14px] leading-relaxed">{f.desc}</p>
        </article>
      ))}
    </div>
    <div class="flex flex-wrap gap-3">
      <a href={`mailto:${data.info.email}`} class="inline-flex items-center h-13 px-7 text-[12px] uppercase tracking-[0.22em] font-bold" style="background:#3D2817; color:#FFD93D; border-radius:999px; height:52px;">Demander un devis</a>
      <a href={`https://wa.me/${data.info.whatsapp}`} class="inline-flex items-center h-13 px-7 text-[12px] uppercase tracking-[0.22em] font-bold border-2" style="border-color:#3D2817; color:#3D2817; border-radius:999px; height:52px;">WhatsApp</a>
    </div>
  </div>
</section>
