---
import data from '../../../data/templates/sorbetpei.json';
---

<section id="privatisation" class="py-20 md:py-28 relative" style="background-color: #FFF8E7;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-dm-sans text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #FF6F91;">— Événementiel —</p>
      <h2 class="font-fraunces font-semibold leading-[0.95]" style="color: #3D2817; font-size: clamp(36px, 5vw, 56px);">
        Privatiser
        <em class="block font-fraunces italic mt-2" style="color: #FF6F91; font-size: clamp(44px, 6vw, 64px);">le camion</em>
      </h2>
      <p class="mt-5 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(61, 40, 23, 0.78);">
        On vient se garer chez vous. Anniversaires d'enfants, mariages, afterworks d'entreprise.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-7 max-w-6xl mx-auto">
      {data.prive.map((p, i) => (
        <article class="p-7 md:p-8 flex flex-col" style={`background-color: ${i === 0 ? '#FFD9E1' : i === 1 ? '#FFE4B8' : '#FFD93D'}; border: 2px solid #3D2817; border-radius: 28px;`}>
          <h3 class="font-fraunces font-semibold text-xl md:text-2xl leading-tight" style="color: #3D2817;">
            {p.titre}
          </h3>
          <p class="mt-2 font-fraunces italic text-xl md:text-2xl leading-snug" style="color: #FF6F91;">
            {p.tagline}
          </p>
          <p class="mt-4 font-dm-sans text-[14px] leading-relaxed flex-1" style="color: rgba(61, 40, 23, 0.82);">
            {p.details}
          </p>
          <div class="mt-5 pt-4 border-t flex items-center gap-2" style="border-color: rgba(61, 40, 23, 0.25);">
            <span class="font-dm-sans text-[10px] uppercase tracking-[0.25em]" style="color: rgba(61, 40, 23, 0.65);">Délai</span>
            <span class="font-dm-sans font-semibold text-[13px]" style="color: #3D2817;">{p.minimum}</span>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a
        href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour Léna, je souhaite privatiser le camion pour un événement.')}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center h-12 px-7 font-dm-sans font-semibold text-[12.5px] uppercase tracking-[0.18em] rounded-full transition-opacity hover:opacity-90"
        style="background-color: #FF6F91; color: #FFF8E7;"
      >
        WhatsApp pour devis privatisation
      </a>
    </div>
  </div>
</section>
