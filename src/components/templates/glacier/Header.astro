---
import data from '../../../data/templates/sorbetpei.json';
const nav = [
  { href: '#parfums', label: 'Parfums' },
  { href: '#processus', label: 'Atelier' },
  { href: '#tournee', label: 'Tournée' },
  { href: '#privatisation', label: 'Événements' },
];
---
<header id="gl-header" data-scrolled="false" class="sticky top-0 z-50 transition-all duration-500"
  style="background:rgba(255,246,226,0.96);">
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">
    <a href="#top" class="flex items-baseline gap-2.5" aria-label="Sorbet Péi">
      <svg viewBox="0 0 32 32" class="w-9 h-9" aria-hidden="true">
        <circle cx="16" cy="13" r="9" fill="#FF6F91"/><path d="M9 18 L16 32 L23 18 Z" fill="#FFB347"/><circle cx="16" cy="13" r="5" fill="#FFD93D"/>
      </svg>
      <span class="font-fraunces italic text-2xl md:text-3xl" style="color:#3D2817;">Sorbet Péi</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[12px] uppercase tracking-[0.20em] font-semibold" aria-label="Navigation">
      {nav.map(n => <a href={n.href} class="hover:opacity-60 transition-opacity" style="color:#3D2817;">{n.label}</a>)}
    </nav>
    <a href="#tournee" class="hidden md:inline-flex items-center h-10 px-5 text-[12px] uppercase tracking-[0.16em] font-bold transition-transform hover:scale-105"
       style="background:#FF6F91; color:#FFF6E2; border-radius:999px;">Voir la tournée</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-10 px-4 text-[11px] uppercase tracking-wider font-bold" style="background:#FF6F91; color:#FFF6E2; border-radius:999px;">Appeler</a>
  </div>
</header>
<script>
  const h = document.getElementById('gl-header');
  if (h) { const u = () => { h.dataset.scrolled = String(window.scrollY > 8); }; u(); window.addEventListener('scroll', u, { passive: true }); }
</script>
