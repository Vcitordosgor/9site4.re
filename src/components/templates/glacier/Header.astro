---
import data from '../../../data/templates/sorbetpei.json';

const navLinks = [
  { href: '#parfums', label: 'Parfums' },
  { href: '#moment', label: 'Du moment' },
  { href: '#processus', label: 'Notre process' },
  { href: '#tournee', label: 'Tournée' },
];
---

<header
  id="sorbet-header"
  data-scrolled="false"
  class="sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500"
  style="border-bottom: 1px solid rgba(61, 40, 23, 0.10);"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">

    <a href="#top" class="flex items-center gap-3 group" aria-label="Sorbet Péi — accueil">
      <!-- Picto cône glace -->
      <svg viewBox="0 0 32 32" class="w-8 h-8" aria-hidden="true">
        <g>
          <!-- Boules -->
          <circle cx="16" cy="11" r="6" fill="#FFB347"/>
          <circle cx="13" cy="9" r="3.5" fill="#FF6F91"/>
          <circle cx="19" cy="9" r="3" fill="#A8D5BA"/>
          <!-- Cône -->
          <path d="M10 14 L16 28 L22 14 Z" fill="#3D2817"/>
          <path d="M11.5 16 L14.5 22 M14 16 L16 21 M16.5 16 L17.5 21 M19 16 L18 22" stroke="#FFF8E7" stroke-width="0.4" opacity="0.6" fill="none"/>
        </g>
      </svg>
      <div class="flex flex-col leading-none">
        <span class="font-fraunces font-semibold text-lg md:text-xl" style="color: #3D2817;">Sorbet <em class="font-fraunces italic" style="color: #FF6F91;">Péi</em></span>
        <span class="font-dm-sans text-[10.5px] md:text-[11px] uppercase tracking-[0.18em] -mt-0.5" style="color: rgba(61, 40, 23, 0.7);">Glacier artisanal</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-9 font-dm-sans text-[12.5px] uppercase tracking-[0.15em] font-medium" aria-label="Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors duration-300 hover:opacity-70" style="color: #3D2817;">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="hidden md:inline-flex items-center justify-center h-10 px-5 font-dm-sans font-semibold text-[12px] uppercase tracking-[0.16em] rounded-full transition-opacity hover:opacity-90"
      style="background-color: #FF6F91; color: #FFF8E7;"
    >
      Suivre le camion
    </a>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="md:hidden inline-flex items-center justify-center h-11 px-4 font-dm-sans font-semibold text-[12px] uppercase tracking-wider rounded-full"
      style="background-color: #FF6F91; color: #FFF8E7;"
      aria-label="Appeler"
    >
      Appeler
    </a>
  </div>
</header>

<style>
  #sorbet-header {
    background-color: rgb(255 248 231 / 0.96);
  }
  #sorbet-header[data-scrolled='true'] {
    background-color: rgb(255 248 231 / 0.97);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 1px 3px rgb(61 40 23 / 0.08);
  }
</style>

<script>
  const header = document.getElementById('sorbet-header');
  if (header) {
    const update = () => { header.dataset.scrolled = String(window.scrollY > 8); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
