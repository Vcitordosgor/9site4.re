---
import data from '../../../data/templates/sorbetpei.json';
const year = new Date().getFullYear();
---
<footer id="contact" class="py-14" style="background:#3D2817; color:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-8">
    <div>
      <div class="font-fraunces italic text-3xl">Sorbet Péi</div>
      <p class="mt-1 text-[12px] uppercase tracking-[0.28em]" style="color:#FFD93D;">Le sorbet, à l'île</p>
    </div>
    <div class="text-[14px]" style="color:#E8DFC9;">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#FFD93D;">Contact</div>
      <a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a><br/>
      <a href={`mailto:${data.info.email}`}>{data.info.email}</a><br/>
      La Réunion · toute l'île
    </div>
    <div class="text-[14px]" style="color:#E8DFC9;">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#FFD93D;">Suivez-nous</div>
      Instagram · {data.info.instagram}<br/>
      Stories quotidiennes · tournée + ruptures
    </div>
  </div>
  <div class="max-w-content mx-auto px-6 md:px-10 mt-10 pt-5 border-t text-[10px] uppercase tracking-[0.28em]" style="border-color:rgba(255,246,226,0.15); color:#A8957D;">© {year} Sorbet Péi — Démonstration 9site4</div>
</footer>
