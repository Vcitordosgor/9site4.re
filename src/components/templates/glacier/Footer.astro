---
import data from '../../../data/templates/sorbetpei.json';
const year = new Date().getFullYear();
---
<footer id="contact" class="relative pt-20 pb-14 overflow-hidden" style="background:#3D2817; color:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-12 relative">
    <p class="font-fraunces italic tracking-[-0.02em] leading-[0.95]" style="color:#FFD93D; font-size:clamp(72px,14vw,200px);">
      Sorbet Péi.
    </p>
    <p class="mt-4 max-w-xl text-2xl md:text-3xl font-fraunces italic" style="color:#FFF6E2;">
      — tous les fruits péi, en cône.
    </p>

    <div class="mt-16 grid md:grid-cols-3 gap-10">
      <div>
        <p class="text-[10px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FFD93D;">Contact</p>
        <p class="text-[14px] leading-relaxed" style="font-family:'DM Sans',system-ui,sans-serif;">
          <a href={`tel:${data.info.telephoneHref}`} class="hover:underline">{data.info.telephone}</a><br/>
          <a href={`mailto:${data.info.email}`} class="hover:underline">{data.info.email}</a><br/>
          <span style="color:#E8DFC9;">Instagram {data.info.instagram}</span>
        </p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FFD93D;">Le camion</p>
        <p class="text-[14px] leading-relaxed" style="font-family:'DM Sans',system-ui,sans-serif; color:#E8DFC9;">
          {data.info.adresseLigne1}<br/>{data.info.adresseLigne2}<br/>{data.info.ouvertureHebdo}
        </p>
      </div>
      <div>
        <p class="text-[10px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FFD93D;">Plan</p>
        <ul class="text-[14px] space-y-1.5" style="font-family:'DM Sans',system-ui,sans-serif;">
          <li><a href="#parfums" class="hover:underline">Carte des parfums</a></li>
          <li><a href="#moment" class="hover:underline">Un moment glace</a></li>
          <li><a href="#processus" class="hover:underline">Processus artisanal</a></li>
          <li><a href="#tournee" class="hover:underline">La tournée du camion</a></li>
          <li><a href="#prive" class="hover:underline">Privatisation · ateliers</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 text-[11px] uppercase tracking-[0.22em]" style="border-color:rgba(255,217,61,0.18); color:#A8957D; font-family:'DM Sans',system-ui,sans-serif;">
      <p>© {data.info.annee}–{year} {data.info.nom}</p>
      <p class="font-fraunces normal-case text-2xl tracking-normal italic" style="color:#FFD93D;">— une mangue Carotte ne mérite pas un sirop industriel.</p>
    </div>
  </div>
</footer>
