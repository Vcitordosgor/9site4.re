---
import data from '../../../data/templates/sorbetpei.json';
---

<footer style="background-color: #3D2817; color: #FFF8E7;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 32 32" class="w-10 h-10" aria-hidden="true">
            <circle cx="16" cy="11" r="6" fill="#FFB347"/>
            <circle cx="13" cy="9" r="3.5" fill="#FF6F91"/>
            <circle cx="19" cy="9" r="3" fill="#A8D5BA"/>
            <path d="M10 14 L16 28 L22 14 Z" fill="#FFF8E7"/>
          </svg>
          <div class="leading-none">
            <p class="font-fraunces font-semibold text-2xl">Sorbet <em class="font-fraunces italic" style="color: #FF6F91;">Péi</em></p>
            <p class="font-dm-sans text-[10.5px] uppercase tracking-[0.18em] mt-1" style="color: #FFB347;">Glacier artisanal</p>
          </div>
        </div>
        <p class="mt-5 font-dm-sans text-[14px] leading-relaxed max-w-sm" style="color: rgba(255, 248, 231, 0.78);">
          {data.info.tagline} — Glacier artisanal à La Réunion depuis {data.info.annee}.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-dm-sans text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #FFB347;">Carte</p>
        <ul class="space-y-2 font-dm-sans text-[13.5px]">
          <li><a href="#parfums" class="transition-colors hover:opacity-80">Parfums</a></li>
          <li><a href="#moment" class="transition-colors hover:opacity-80">Du moment</a></li>
          <li><a href="#processus" class="transition-colors hover:opacity-80">Notre process</a></li>
          <li><a href="#tournee" class="transition-colors hover:opacity-80">Tournée</a></li>
          <li><a href="#privatisation" class="transition-colors hover:opacity-80">Privatisation</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-dm-sans text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #FFB347;">Le camion</p>
        <ul class="space-y-2 font-dm-sans text-[13.5px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="transition-colors hover:opacity-80">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="transition-colors hover:opacity-80 break-all">{data.info.email}</a></li>
          <li style="color: rgba(255, 248, 231, 0.7);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-dm-sans text-[11px]" style="border-color: rgba(255, 179, 71, 0.3); color: rgba(255, 248, 231, 0.65);">
      <p>© {data.info.annee}–2026 {data.info.nom} · SIRET …{data.info.siret.slice(-5)}</p>
      <p class="font-fraunces italic text-2xl leading-none" style="color: #FFB347;">{data.info.tagline}</p>
    </div>
  </div>
</footer>
