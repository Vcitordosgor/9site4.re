---
import data from '../../../data/templates/sorbetpei.json';
---

<section id="moment" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #A8D5BA;">
  <div class="max-w-content mx-auto px-6 md:px-10 relative">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="font-dm-sans text-[11px] uppercase tracking-[0.45em] mb-4" style="color: rgba(61, 40, 23, 0.75);">— En ce moment —</p>
      <h2 class="font-fraunces font-semibold leading-[0.95]" style="color: #3D2817; font-size: clamp(36px, 5vw, 56px);">
        Les saveurs
        <em class="block font-fraunces italic mt-2" style="color: #FF6F91; font-size: clamp(44px, 6vw, 64px);">du moment</em>
      </h2>
      <p class="mt-5 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(61, 40, 23, 0.78);">
        Ce qu'on turbine cette semaine, ce qui arrive bientôt, ce qui ferme la saison.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-7 max-w-5xl mx-auto">
      {data.saveursMoment.map((s) => (
        <article class="relative p-7 md:p-8" style="background-color: #FFF8E7; border: 2px solid #3D2817; border-radius: 28px;">
          <p class="font-dm-sans text-[10.5px] uppercase tracking-[0.3em] mb-3" style="color: #FF6F91;">
            {s.label}
          </p>
          <h3 class="font-fraunces font-semibold text-xl md:text-2xl leading-tight" style="color: #3D2817;">
            {s.parfum}
          </h3>
          <p class="mt-3 font-dm-sans text-[14px] leading-relaxed" style="color: rgba(61, 40, 23, 0.8);">
            {s.texte}
          </p>
        </article>
      ))}
    </div>

    <!-- CTA Instagram -->
    <div class="mt-12 text-center">
      <a
        href={`https://instagram.com/${(data.info.instagram).replace('@', '')}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-3 font-dm-sans font-semibold text-[12.5px] uppercase tracking-[0.18em] px-6 h-12 rounded-full transition-opacity hover:opacity-90"
        style="background-color: #3D2817; color: #FFF8E7;"
      >
        <span>Suivre les annonces · Instagram {data.info.instagram}</span>
      </a>
    </div>
  </div>
</section>
