---
// Bento étendue avec 6 photos disponibles (extras 1-6 libérés par Parfums + 7-9)
const photos = [
  '/images/glacier/extra-1.webp',
  '/images/glacier/extra-2.webp',
  '/images/glacier/extra-3.webp',
  '/images/glacier/extra-4.webp',
  '/images/glacier/extra-5.webp',
  '/images/glacier/extra-6.webp',
  '/images/glacier/extra-7.webp',
];
---
<section id="moment" class="relative py-24 md:py-36 overflow-hidden" style="background:#FF6F91; color:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end">
      <div class="lg:col-span-7 grid grid-cols-12 gap-3 md:gap-4">
        <figure class="col-span-8 row-span-2 rounded-[28px] overflow-hidden aspect-[4/5]">
          <img src={photos[0]} alt="Cornet glace tendu vers la lumière dorée" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
        </figure>
        <figure class="col-span-4 rounded-[24px] overflow-hidden aspect-square">
          <img src={photos[1]} alt="Boule sorbet péi sur cornet artisanal" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
        </figure>
        <figure class="col-span-4 rounded-[24px] overflow-hidden aspect-square">
          <img src={photos[2]} alt="Détail texture sorbet mangue" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
        </figure>
        <figure class="col-span-4 rounded-[24px] overflow-hidden aspect-[5/4]">
          <img src={photos[3]} alt="Cornet sur le sable, lagon en arrière-plan" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
        </figure>
        <figure class="col-span-4 rounded-[24px] overflow-hidden aspect-[5/4]">
          <img src={photos[4]} alt="Vitrine du glacier, lumière chaude" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
        </figure>
        <figure class="col-span-4 rounded-[24px] overflow-hidden aspect-[5/4]">
          <img src={photos[5]} alt="Cornet mordu, paradis tropical" class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
        </figure>
      </div>

      <div class="lg:col-span-5">
        <p class="text-[11px] uppercase tracking-[0.42em] mb-3 font-bold" style="color:#FFD93D;">— un moment glace</p>
        <p class="font-fraunces italic leading-[1.05] tracking-[-0.01em]" style="font-size:clamp(38px,5.4vw,76px);">
          “Une glace, c'est sept minutes
          <span class="block" style="color:#FFD93D;">de plage en plus.”</span>
        </p>
        <p class="mt-7 text-base md:text-lg leading-relaxed max-w-md" style="font-family:'DM Sans',system-ui,sans-serif; color:#FFF6E2;">
          Posée sur un banc, sur le sable, à la sortie de l'école. Le sorbet péi rallonge la journée d'un fruit, d'une couleur, d'un instant.
        </p>
        <ul class="mt-9 grid grid-cols-2 gap-5 text-[14px]" style="font-family:'DM Sans',system-ui,sans-serif;">
          <li class="border-l-2 pl-4" style="border-color:#FFD93D;">
            <p class="text-[10px] uppercase tracking-[0.24em] font-bold" style="color:#FFD93D;">Boule</p>
            <p class="mt-1 font-fraunces text-2xl leading-none">3 €</p>
          </li>
          <li class="border-l-2 pl-4" style="border-color:#FFD93D;">
            <p class="text-[10px] uppercase tracking-[0.24em] font-bold" style="color:#FFD93D;">Bac 500 ml</p>
            <p class="mt-1 font-fraunces text-2xl leading-none">14 €</p>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
