---
const photos = ['/images/glacier/extra-7.webp', '/images/glacier/extra-8.webp', '/images/glacier/extra-9.webp'];
---
<section class="py-20 md:py-28" style="background:#FF6F91; color:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-3 gap-4 mb-12">
      {photos.map((p, i) => <figure class={`overflow-hidden ${i === 1 ? 'md:mt-8' : ''}`} style="border-radius:24px;"><img src={p} alt="" class="w-full h-72 object-cover" loading="lazy"/></figure>)}
    </div>
    <div class="text-center max-w-3xl mx-auto">
      <p class="font-fraunces italic text-3xl md:text-4xl mb-4">— un moment glace —</p>
      <h2 class="font-fraunces text-4xl md:text-5xl leading-tight">
        Le sorbet, c'est <em class="italic" style="color:#FFD93D;">15 minutes de pause.</em><br/>Sur un banc, sur le sable, dans la voiture chaude.
      </h2>
    </div>
  </div>
</section>
