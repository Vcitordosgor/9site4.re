---
import data from '../../../data/templates/sorbetpei.json';
const faqs = [
  { q: 'Vous travaillez sans lait ?', r: 'Les sorbets, oui. Les glaces (vanille, coco) contiennent de la crème entière. Toutes nos préparations véganes sont signalées.' },
  { q: 'Vos parfums sont saisonniers ?', r: 'Le letchi novembre-janvier, l\'ananas avril-juillet. Mangue, vanille, coco, fruit de la passion toute l\'année.' },
  { q: 'Sans sucre ?', r: 'Sucre canne bio dosé au minimum (12-14%). Nous ne proposons pas de version 0 sucre — le sorbet a besoin de sucre pour son glaçage.' },
  { q: 'Peut-on commander pour une fête à la maison ?', r: 'Oui, à partir de 3L (≈30 personnes). Livraison côte ouest et sud. Commande 72h à l\'avance.' },
  { q: 'Allergènes ?', r: 'Aucun œuf, aucun gluten. Glaces traditionnelles contiennent lait. Liste détaillée disponible sur demande, traçabilité complète.' },
];
---
<section class="py-24 md:py-32" style="background:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <p class="font-fraunces italic text-2xl mb-2" style="color:#FF6F91;">vos questions —</p>
    <h2 class="font-fraunces text-5xl md:text-6xl leading-tight mb-12" style="color:#3D2817;">FAQ <em class="italic">glacée.</em></h2>
    <div class="grid md:grid-cols-2 gap-5">
      {faqs.map(f => (
        <details class="group p-6 transition-all" style="background:#FFD93D; color:#3D2817; border-radius:20px;">
          <summary class="cursor-pointer flex justify-between gap-4 font-fraunces text-xl">
            {f.q}<span class="font-fraunces text-2xl transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-[14px] leading-relaxed">{f.r}</p>
        </details>
      ))}
    </div>
    <p class="mt-10 text-base" style="color:#3D2817;">Une autre question ? <a href={`mailto:${data.info.email}`} class="underline font-semibold">{data.info.email}</a></p>
  </div>
</section>
