---
const tournee = [
  { jour: 'Mercredi', lieu: 'Marché de l\'ouest', horaire: '15h → 19h', zone: 'Côte ouest' },
  { jour: 'Jeudi', lieu: 'Front de mer ouest', horaire: '16h → 20h', zone: 'Côte ouest' },
  { jour: 'Vendredi', lieu: 'Sentier littoral sud', horaire: '15h → 19h', zone: 'Sud sauvage' },
  { jour: 'Samedi', lieu: 'Marché bio sud', horaire: '9h → 13h', zone: 'Sud' },
  { jour: 'Samedi soir', lieu: 'Place du village est', horaire: '17h → 21h', zone: 'Est' },
  { jour: 'Dimanche', lieu: 'Pique-nique des Hauts', horaire: '11h → 17h', zone: 'Plaines' },
];
---
<section id="tournee" class="py-24 md:py-32" style="background:#3D2817; color:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-3 gap-12 lg:gap-16">
      <div>
        <p class="font-fraunces italic text-2xl mb-2" style="color:#FFD93D;">le camion glacé —</p>
        <h2 class="font-fraunces text-4xl md:text-5xl leading-tight mb-5">La tournée <em class="italic" style="color:#FFD93D;">de la semaine.</em></h2>
        <p class="text-lg leading-relaxed" style="color:#E8DFC9;">
          Notre camion sillonne l'île toute l'année. Suivez-nous sur Instagram pour les imprévus, les ruptures de stock et les fournées limitées (letchi en saison).
        </p>
        <img src="/images/glacier/extra-10.webp" alt="Camion glacier" class="mt-8 w-full h-56 object-cover" style="border-radius:24px;" loading="lazy"/>
      </div>
      <ul class="md:col-span-2 grid sm:grid-cols-2 gap-4">
        {tournee.map(t => (
          <li class="p-6" style="background:#FFD93D; color:#3D2817; border-radius:20px;">
            <div class="text-[11px] uppercase tracking-[0.28em] font-bold mb-2" style="color:#FF6F91;">{t.zone}</div>
            <div class="font-fraunces text-2xl mb-1">{t.jour}</div>
            <div class="font-fraunces italic text-lg">{t.lieu}</div>
            <div class="mt-2 text-[14px] font-semibold">{t.horaire}</div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
