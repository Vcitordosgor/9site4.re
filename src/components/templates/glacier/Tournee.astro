---
import data from '../../../data/templates/sorbetpei.json';
---

<section id="tournee" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #FFB347;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="font-dm-sans text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #3D2817;">— Le camion glacé —</p>
      <h2 class="font-fraunces font-semibold leading-[0.95]" style="color: #3D2817; font-size: clamp(36px, 5vw, 56px);">
        Tournée
        <em class="block font-fraunces italic mt-2" style="color: #FFF8E7; font-size: clamp(44px, 6vw, 64px);">de la semaine</em>
      </h2>
      <p class="mt-5 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(61, 40, 23, 0.78);">
        Le programme peut bouger en cas de pluie ou de panne — vérifier Instagram avant de venir.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="overflow-hidden" style="background-color: #FFF8E7; border: 2px solid #3D2817; border-radius: 28px;">
        {data.tournee.map((j, i) => (
          <div class="grid grid-cols-12 gap-3 px-6 md:px-8 py-5 md:py-6 items-center" style={`${i > 0 ? 'border-top: 1px solid rgba(61, 40, 23, 0.18);' : ''}`}>
            <div class="col-span-3 md:col-span-2">
              <p class="font-fraunces italic text-xl md:text-2xl leading-none" style="color: #FF6F91;">
                {j.jour}
              </p>
            </div>
            <div class="col-span-5 md:col-span-7">
              <p class="font-dm-sans font-semibold text-[14px] md:text-[15px] leading-snug" style="color: #3D2817;">
                {j.lieu}
              </p>
            </div>
            <div class="col-span-4 md:col-span-3 text-right">
              <p class="font-dm-sans font-medium text-[12.5px] md:text-[13.5px] leading-tight" style="color: rgba(61, 40, 23, 0.85);">
                {j.horaire}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center font-fraunces italic text-lg md:text-xl" style="color: #3D2817;">
        — Le lundi et mardi, le camion lave les bacs et turbine les nouveaux parfums —
      </p>
    </div>
  </div>
</section>
