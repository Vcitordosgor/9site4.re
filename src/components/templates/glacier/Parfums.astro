---
import data from '../../../data/templates/sorbetpei.json';
---

<section id="parfums" class="py-20 md:py-28 relative" style="background-color: #FFF8E7;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-dm-sans text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #FF6F91;">— La carte —</p>
      <h2 class="font-fraunces font-semibold leading-[0.95]" style="color: #3D2817; font-size: clamp(36px, 5vw, 56px);">
        Six parfums,
        <em class="block font-fraunces italic mt-2" style="color: #FF6F91; font-size: clamp(44px, 6vw, 64px);">
          turbinés à la main.
        </em>
      </h2>
      <p class="mt-5 font-dm-sans text-[15px] leading-relaxed" style="color: rgba(61, 40, 23, 0.78);">
        Carte permanente — la saison fait varier les sorbets disponibles. Crèmes glacées toute l'année.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-7">
      {data.parfumsPhares.map((p, i) => (
        <li class="group relative overflow-hidden p-7 md:p-8 transition-transform hover:-translate-y-1" style={`background-color: ${p.couleurFond}; border: 2px solid #3D2817; border-radius: 32px;`}>
          <!-- Numéro en haut droite -->
          <p class="absolute top-4 right-5 font-fraunces italic text-3xl" style="color: rgba(61, 40, 23, 0.4);">
            n°{String(i + 1).padStart(2, '0')}
          </p>

          <!-- Boule glace SVG -->
          <div class="mb-5">
            <div class="w-20 h-20 rounded-full shadow-inner relative" style={`background-color: ${p.couleur};`}>
              <div class="absolute top-2 left-3 w-5 h-5 rounded-full opacity-40" style="background-color: rgba(255, 255, 255, 0.7);"></div>
            </div>
          </div>

          <!-- Type badge -->
          <p class="font-dm-sans text-[10px] uppercase tracking-[0.3em] mb-2" style="color: rgba(61, 40, 23, 0.6);">
            {p.type}
          </p>

          <h3 class="font-fraunces font-semibold text-2xl md:text-[28px] leading-tight" style="color: #3D2817;">
            {p.nom}
          </h3>

          <p class="mt-1.5 font-fraunces italic text-xl md:text-2xl leading-snug" style="color: #FF6F91;">
            {p.tagline}
          </p>

          <p class="mt-3.5 font-dm-sans text-[14px] leading-relaxed" style="color: rgba(61, 40, 23, 0.82);">
            {p.description}
          </p>

          <div class="mt-5 pt-4 border-t" style="border-color: rgba(61, 40, 23, 0.2);">
            <p class="font-dm-sans text-[10.5px] uppercase tracking-[0.25em]" style="color: rgba(61, 40, 23, 0.6);">
              Saison
            </p>
            <p class="font-fraunces text-base mt-0.5" style="color: #3D2817;">
              {p.saison}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
