---
/**
 * Signature WOAW : "Carte des parfums péi" — grille 6 parfums avec card
 * pop, photo, tag sorbet/glace, couleur de fond signature par parfum.
 */
import data from '../../../data/templates/sorbetpei.json';
const marqueeMots = ['Mangue Carotte', 'Letchi', 'Ananas Victoria', 'Goyave rose', 'Vanille bourbon', 'Chocolat 70%', 'Combava (édition)'];
---
<section id="parfums" class="relative pb-24 md:pb-36 overflow-hidden" style="background:#FFF6E2;">
  <!-- Marquee Fraunces italique défilant -->
  <div class="py-5 border-y overflow-hidden" style="background:#3D2817; color:#FFF6E2; border-color:rgba(255,217,61,0.25);">
    <div class="flex whitespace-nowrap will-change-transform" style="animation:gl-marquee 36s linear infinite;">
      {Array.from({ length: 3 }).map(() => (
        <div class="flex items-center shrink-0">
          {marqueeMots.map((m) => (
            <span class="font-fraunces italic text-3xl md:text-4xl px-8 md:px-12 flex items-center gap-6">
              {m}<span style="color:#FFD93D;">·</span>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
  <style>@keyframes gl-marquee { from { transform: translateX(0); } to { transform: translateX(-33.333%); } } @media (prefers-reduced-motion: reduce) { [style*='gl-marquee'] { animation: none !important; } }</style>

  <div class="max-w-content mx-auto px-6 md:px-12 pt-24 md:pt-32 relative">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 md:mb-20">
      <div class="max-w-3xl">
        <p class="text-[11px] uppercase tracking-[0.42em] mb-3 flex items-center gap-3 font-bold" style="color:#FF6F91;">
          <span class="block w-10 h-px" style="background:#FF6F91;"></span>
          La carte
        </p>
        <h2 class="font-fraunces leading-[0.9] tracking-[-0.015em]" style="font-size:clamp(42px,6.4vw,92px); color:#3D2817;">
          Six parfums
          <span class="block italic" style="color:#FF6F91; font-size:clamp(58px,8.4vw,118px);">qui sentent l'île.</span>
        </h2>
      </div>
      <p class="max-w-xs text-[14px] leading-relaxed" style="color:#5C3A1E;">
        Les fruits arrivent du producteur le matin. Quand ils s'arrêtent, le parfum aussi.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 md:gap-7">
      {data.parfumsPhares.map((p, i) => (
        <li class="group">
          <article class="relative flex flex-col h-full overflow-hidden transition-all duration-500 hover:-translate-y-1.5 hover:shadow-[0_22px_44px_-18px_rgba(61,40,23,0.35)] rounded-[28px]" style={`background:${p.couleurFond};`}>
            <!-- Bandeau couleur signature + grande boule SVG (plus de photo) -->
            <div class="relative aspect-[5/4] flex items-end justify-center overflow-hidden" style={`background:${p.couleur};`}>
              <!-- Pattern points discret -->
              <div class="absolute inset-0 opacity-20" style="background-image:radial-gradient(circle, #ffffff 1px, transparent 1.5px);background-size:14px 14px;" aria-hidden="true"></div>
              <!-- Grande boule de glace SVG -->
              <svg viewBox="0 0 200 200" class="relative w-3/4 h-3/4 -mb-6 transition-transform duration-700 group-hover:-translate-y-2" aria-hidden="true">
                <circle cx="100" cy="110" r="68" fill={p.couleurFond} opacity="0.95"/>
                <ellipse cx="80" cy="92" rx="18" ry="8" fill="#FFF6E2" opacity="0.42"/>
                <circle cx="100" cy="110" r="68" fill="none" stroke={p.couleurFond} stroke-width="1.5" opacity="0.6"/>
              </svg>
              <span class="absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.22em] font-bold" style={`background:${p.couleurFond}; color:#3D2817;`}>
                {p.type}
              </span>
              <span class="absolute top-4 right-4 inline-flex items-center px-3 py-1 rounded-full text-[10px] uppercase tracking-[0.22em] font-bold" style="background:#FFF6E2; color:#3D2817;">
                {p.saison}
              </span>
            </div>
            <div class="p-7 flex-1 flex flex-col">
              <h3 class="font-fraunces leading-tight" style="color:#3D2817; font-size:clamp(28px,3.2vw,38px);">{p.nom}</h3>
              <p class="mt-1 font-fraunces italic text-xl md:text-2xl leading-tight" style={`color:${p.couleur === '#FFF8E7' || p.couleur === '#FFD93D' ? '#3D2817' : p.couleur};`}>— {p.tagline}</p>
              <p class="mt-4 text-[14.5px] leading-relaxed flex-1" style="color:#5C3A1E; font-family:'DM Sans',system-ui,sans-serif;">{p.description}</p>
              <a href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent(`Bonjour, je voudrais commander un bac : ${p.nom}.`)}`}
                 target="_blank" rel="noopener"
                 class="mt-6 inline-flex items-center justify-center w-full px-6 rounded-full text-[12px] uppercase tracking-[0.22em] font-bold transition-all hover:scale-[1.02]"
                 style="background:#3D2817; color:#FFD93D; height:48px; font-family:'DM Sans',system-ui,sans-serif;">
                Commander un bac
                <svg viewBox="0 0 24 24" width="13" height="13" class="ml-2"><path d="M5 12h14m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <!-- Édition limitée -->
    <div class="mt-16 md:mt-20 p-8 md:p-12 rounded-[32px] grid md:grid-cols-12 gap-6 items-center" style="background:#FF6F91; color:#FFF6E2;">
      <div class="md:col-span-7">
        <p class="text-[11px] uppercase tracking-[0.32em] mb-3 font-bold" style="color:#FFD93D;">— édition limitée</p>
        <h3 class="font-fraunces italic leading-[0.95]" style="font-size:clamp(34px,4.8vw,64px);">Combava-citron vert · sortie le mois prochain.</h3>
        <p class="mt-4 text-[15px] leading-relaxed max-w-xl" style="font-family:'DM Sans',system-ui,sans-serif;">
          200 bacs prévus, ça partira en deux week-ends. Réservez votre cornet sur Instagram dès l'annonce.
        </p>
      </div>
      <div class="md:col-span-5 flex md:justify-end">
        <a href={`https://www.instagram.com/${data.info.instagram.replace('@', '')}`} target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 px-7 rounded-full text-[12px] uppercase tracking-[0.22em] font-bold transition-all hover:scale-[1.04]"
           style="background:#FFD93D; color:#3D2817; height:54px; font-family:'DM Sans',system-ui,sans-serif;">
          Suivre sur Instagram
          <svg viewBox="0 0 24 24" width="14" height="14"><path d="M5 12h14m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
