---
const parfums = [
  { nom: 'Mangue Carotte', sous: 'L\'incontournable', desc: 'Mangue mûre du nord pressée le matin, sucre canne, citron vert. Acidité juste, parfum solaire.', color: '#FFB347', text: '#3D2817', photo: '/images/glacier/extra-1.webp' },
  { nom: 'Vanille Bourbon', sous: 'Classique tropical', desc: 'Gousses de Bras-Panon, infusion lente, crème entière. Une vanille noire, fumée, longue en bouche.', color: '#FFF6E2', text: '#3D2817', photo: '/images/glacier/extra-2.webp' },
  { nom: 'Letchi', sous: 'Hiver austral', desc: 'Letchi pelé main, sucre minimum. Vendu en saison uniquement (novembre → janvier).', color: '#FF6F91', text: '#FFF6E2', photo: '/images/glacier/extra-3.webp' },
  { nom: 'Coco fraîche', sous: 'Onctueux', desc: 'Coco râpée + eau de coco, sucre roux. Texture rappelant la lait concentré, sans lait concentré.', color: '#FFF6E2', text: '#3D2817', photo: '/images/glacier/extra-4.webp' },
  { nom: 'Fruit de la passion', sous: 'Acidulé pur', desc: 'Pulpe et graines, juste sucrée. La cuillère fait crouch — on garde les pépins.', color: '#FFD93D', text: '#3D2817', photo: '/images/glacier/extra-5.webp' },
  { nom: 'Ananas Victoria', sous: 'Doux sucré', desc: 'Ananas péi rôti à la plancha avant pressurage. Note caramélisée, fond miel.', color: '#FFB347', text: '#3D2817', photo: '/images/glacier/extra-6.webp' },
];
---
<section id="parfums" class="py-24 md:py-32" style="background:#FFF6E2;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <p class="font-fraunces italic text-2xl mb-2" style="color:#FF6F91;">les parfums péi —</p>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#3D2817;">Six fruits, <em class="italic">six étés.</em></h2>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {parfums.map(p => (
        <article class="overflow-hidden flex flex-col transition-transform hover:-translate-y-1 duration-300" style={`background:${p.color}; color:${p.text}; border-radius:24px;`}>
          <div class="aspect-square overflow-hidden">
            <img src={p.photo} alt={p.nom} class="w-full h-full object-cover" loading="lazy"/>
          </div>
          <div class="p-6">
            <div class="text-[10px] uppercase tracking-[0.28em] font-bold mb-2 opacity-70">{p.sous}</div>
            <h3 class="font-fraunces text-3xl mb-2">{p.nom}</h3>
            <p class="text-[14px] leading-relaxed opacity-90">{p.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
