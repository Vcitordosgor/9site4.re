---
import data from '../../../data/templates/latitude.json';
---
<section id="contact" class="py-24 md:py-32" style="background:#FAF7F0;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-2 gap-16 lg:gap-24">
    <div>
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="color:#6E6A60;">Contact</div>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight mb-8" style="color:#0A0A0B;">Écrivez-moi.</h2>
      <ul class="space-y-5" style="color:#0A0A0B;">
        <li><div class="text-[10px] uppercase tracking-[0.28em]" style="color:#B89766;">Téléphone</div><a class="font-fraunces text-2xl" href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a></li>
        <li><div class="text-[10px] uppercase tracking-[0.28em]" style="color:#B89766;">Email</div><a class="font-fraunces text-2xl" href={`mailto:${data.info.email}`}>{data.info.email}</a></li>
        <li><div class="text-[10px] uppercase tracking-[0.28em]" style="color:#B89766;">Studio</div><span class="font-fraunces text-2xl">Saint-Denis, La Réunion</span></li>
        <li><div class="text-[10px] uppercase tracking-[0.28em]" style="color:#B89766;">Sur RDV</div><span class="text-[15px]">Lundi → samedi · 9h-19h</span></li>
      </ul>
    </div>
    <form class="grid gap-4" onsubmit="event.preventDefault(); alert('Démonstration — formulaire non actif.');">
      <label><span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#6E6A60;">Votre nom</span>
        <input required type="text" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(10,10,11,0.30);"/></label>
      <label><span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#6E6A60;">Email</span>
        <input required type="email" class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(10,10,11,0.30);"/></label>
      <label><span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#6E6A60;">Type de séance</span>
        <select class="w-full h-12 px-4 bg-transparent border" style="border-color:rgba(10,10,11,0.30);">
          <option>Portrait</option><option>Couple / Famille</option><option>Lifestyle marque</option><option>Mariage</option>
        </select></label>
      <label><span class="text-[11px] uppercase tracking-[0.22em] block mb-2" style="color:#6E6A60;">Message</span>
        <textarea rows="5" class="w-full px-4 py-3 bg-transparent border" style="border-color:rgba(10,10,11,0.30);"></textarea></label>
      <button class="mt-2 h-12 text-[12px] uppercase tracking-[0.22em] font-semibold" style="background:#0A0A0B; color:#FAF7F0;">Envoyer</button>
    </form>
  </div>
</section>
