---
/**
 * Forfaits — fourchettes tarifaires par typologie (mariage / portrait / corporate).
 */
const forfaits = [
  {
    cat: 'Mariage',
    code: '✦ M',
    tagline: 'De la préparation à la dernière danse',
    prix: 'à partir de 1 850 €',
    duree: '8 à 12h sur place',
    livraison: '300 à 500 photos sous 6 semaines',
    inclus: [
      'Repérages 1 mois avant',
      'Reportage continu, deux objectifs',
      'Galerie privée en ligne',
      'Tirages baryté en option',
    ],
  },
  {
    cat: 'Portrait',
    code: '✦ P',
    tagline: 'Famille, individuel, maternité',
    prix: 'à partir de 280 €',
    duree: '1h30 à 2h en extérieur ou studio',
    livraison: '25 à 40 photos sous 10 jours',
    inclus: [
      'Conseil tenue & lieu',
      'Direction posée + spontanée',
      'Retouche fine sur sélection',
      'Tirages fine-art en option',
    ],
  },
  {
    cat: 'Corporate',
    code: '✦ C',
    tagline: 'Identité d\'équipe, métier, événement',
    prix: 'à partir de 650 €',
    duree: '½ ou journée complète',
    livraison: '40 à 120 photos sous 2 semaines',
    inclus: [
      'Brief cadrage marque',
      'Portraits équipe + ambiance',
      'Droits d\'usage web & print',
      'Format paysage + carré',
    ],
  },
];
---

<section id="forfaits" class="bg-latitude-papier text-latitude-noir py-20 md:py-28">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-hanken text-[11px] uppercase tracking-[0.4em] text-latitude-cendre mb-4">✦ Tarifs forfaits</p>
      <h2 class="font-dm-serif text-latitude-noir text-5xl md:text-6xl leading-[0.95] tracking-tight">
        Trois typologies,<br/>
        <span class="italic text-latitude-or">trois fourchettes claires.</span>
      </h2>
      <p class="mt-6 font-hanken text-base text-latitude-noir/75 leading-relaxed">
        Chaque projet est devisé sur-mesure après échange. Voici les bases pour situer l'investissement.
      </p>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-px bg-latitude-cendre/40 border border-latitude-cendre/40">
      {forfaits.map((f) => (
        <li class="bg-latitude-papier p-7 md:p-8 flex flex-col">
          <p class="font-hanken text-[10px] uppercase tracking-[0.3em] text-latitude-or">{f.code} · {f.cat}</p>
          <h3 class="mt-3 font-dm-serif text-latitude-noir text-3xl md:text-4xl leading-tight">
            {f.cat}
          </h3>
          <p class="mt-1 font-instrument italic text-latitude-noir/70 text-lg">{f.tagline}</p>

          <p class="mt-6 font-dm-serif text-latitude-noir text-2xl md:text-[26px]">{f.prix}</p>

          <dl class="mt-5 space-y-1.5 font-hanken text-[13px] text-latitude-noir/85 border-t border-latitude-cendre/40 pt-5">
            <div><dt class="text-[10px] uppercase tracking-wider text-latitude-or/85">Durée</dt><dd>{f.duree}</dd></div>
            <div><dt class="text-[10px] uppercase tracking-wider text-latitude-or/85">Livraison</dt><dd>{f.livraison}</dd></div>
          </dl>

          <ul class="mt-5 pt-5 border-t border-latitude-cendre/40 space-y-2 font-instrument italic text-latitude-noir/85 text-base">
            {f.inclus.map((x) => (
              <li class="flex items-start gap-2"><span class="text-latitude-or mt-0.5">✦</span> {x}</li>
            ))}
          </ul>
        </li>
      ))}
    </ul>

    <p class="mt-8 font-hanken italic text-latitude-noir/55 text-sm">
      Devis personnalisé envoyé sous 48h après échange · acompte 30% à la réservation.
    </p>
  </div>
</section>
