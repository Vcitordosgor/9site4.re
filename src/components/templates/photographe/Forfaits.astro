---
import IrisIcon from './IrisIcon.astro';
const forfaits = [
  { titre: 'Portrait', duree: '1h', prix: '250 €', inclus: ['15 photos retouchées', 'Galerie en ligne 30 jours', 'Droits usage personnel'] },
  { titre: 'Famille / Couple', duree: '2h', prix: '420 €', inclus: ['40 photos retouchées', 'Galerie en ligne 60 jours', 'Tirages 10×15 inclus (×5)'], populaire: true },
  { titre: 'Lifestyle marque', duree: '4h', prix: '780 €', inclus: ['60 photos retouchées', 'Cession droits commerciaux web', 'Livraison sous 21 jours'] },
  { titre: 'Mariage éditorial', duree: '10h', prix: 'sur devis', inclus: ['400+ photos retouchées', 'Livre photo baryté A4 inclus', 'Reportage pleine journée'] },
];
---
<section id="tarifs" class="py-24 md:py-32" style="background:#FAF7F0;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3 inline-flex items-center gap-2" style="color:#6E6A60;"><IrisIcon size={12} tone="dark" /> Tarifs</div>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#0A0A0B;">Forfaits <em class="italic">indicatifs.</em></h2>
    </div>
    <div class="grid md:grid-cols-4 gap-6">
      {forfaits.map(f => (
        <article class="p-7 md:p-8 flex flex-col border" style={`background:${f.populaire ? '#0A0A0B' : '#FAF7F0'}; color:${f.populaire ? '#FAF7F0' : '#0A0A0B'}; border-color:${f.populaire ? '#0A0A0B' : 'rgba(10,10,11,0.15)'};`}>
          {f.populaire && <div class="text-[10px] uppercase tracking-[0.32em] mb-4" style="color:#B89766;">Le plus demandé</div>}
          <h3 class="font-fraunces text-2xl mb-1">{f.titre}</h3>
          <div class="text-[11px] uppercase tracking-[0.22em] mb-5" style={`color:${f.populaire ? '#B89766' : '#6E6A60'};`}>{f.duree}</div>
          <div class="font-fraunces text-4xl mb-5">{f.prix}</div>
          <ul class="space-y-2 text-[14px] mb-6 flex-grow">
            {f.inclus.map(i => <li class="flex gap-2"><span style="color:#B89766;">—</span>{i}</li>)}
          </ul>
          <a href="#contact" class="inline-flex items-center justify-center h-11 text-[11px] uppercase tracking-[0.22em] font-semibold border transition-colors"
             style={f.populaire ? 'background:#FAF7F0; color:#0A0A0B; border-color:#FAF7F0;' : 'border-color:#0A0A0B; color:#0A0A0B;'}>Réserver</a>
        </article>
      ))}
    </div>
  </div>
</section>
