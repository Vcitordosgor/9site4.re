---
import data from '../../../data/templates/latitude.json';
---

<section id="series" class="bg-latitude-papier text-latitude-noir py-20 md:py-28">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-hanken text-[11px] uppercase tracking-[0.4em] text-latitude-cendre mb-4">✦ Catalogue des séries</p>
      <h2 class="font-dm-serif text-latitude-noir text-5xl md:text-6xl leading-[0.95] tracking-tight">
        Quatre formats,<br/>
        <span class="italic text-latitude-or">une exigence.</span>
      </h2>
    </div>

    <ul class="space-y-12 md:space-y-16">
      {data.series.map((s, i) => (
        <li class={`grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start ${i % 2 === 1 ? 'md:[&>:first-child]:order-2' : ''}`}>

          <!-- Plaque-cartouche n° + format -->
          <div class="md:col-span-4">
            <div class="bg-latitude-noir text-latitude-blanc p-6 relative">
              <!-- Encoches sprocket décoratives -->
              <div class="absolute top-1.5 inset-x-2 flex justify-around" aria-hidden="true">
                {Array.from({length:8}).map(()=>(<span class="block w-2 h-1.5 bg-latitude-charbon rounded-sm"></span>))}
              </div>
              <div class="absolute bottom-1.5 inset-x-2 flex justify-around" aria-hidden="true">
                {Array.from({length:8}).map(()=>(<span class="block w-2 h-1.5 bg-latitude-charbon rounded-sm"></span>))}
              </div>

              <div class="py-6">
                <p class="font-hanken text-[10px] uppercase tracking-[0.25em] text-latitude-or mb-2">{s.code}</p>
                <h3 class="font-dm-serif text-latitude-blanc text-3xl md:text-4xl leading-tight tracking-tight">
                  {s.titre}
                </h3>
                <p class="font-instrument italic text-latitude-or text-xl mt-1">{s.tagline}</p>

                <ul class="mt-5 pt-5 border-t border-latitude-cendre/40 space-y-1.5 font-hanken text-[12px]">
                  <li><span class="text-latitude-or/85 uppercase tracking-wider text-[10px]">Format</span><br/>{s.format}</li>
                  <li><span class="text-latitude-or/85 uppercase tracking-wider text-[10px]">Durée</span><br/>{s.duree}</li>
                  <li><span class="text-latitude-or/85 uppercase tracking-wider text-[10px]">Livraison</span><br/>{s.livraison}</li>
                </ul>

                <p class="mt-5 pt-4 border-t border-latitude-cendre/40 font-dm-serif text-latitude-blanc text-2xl md:text-[26px]">
                  {s.prix}
                </p>
              </div>
            </div>
          </div>

          <!-- Description + moments -->
          <div class="md:col-span-8">
            <p class="font-hanken text-[10px] uppercase tracking-[0.3em] text-latitude-or mb-3">Série n°{String(i+1).padStart(2,'0')}</p>
            <p class="font-hanken text-[15.5px] md:text-base text-latitude-noir/85 leading-relaxed max-w-xl">
              {s.description}
            </p>

            <div class="mt-7">
              <p class="font-hanken text-[10px] uppercase tracking-[0.25em] text-latitude-noir/55 mb-3">— Sujets / moments couverts</p>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {s.moments.map((m) => (
                  <li class="flex items-center gap-2.5 font-instrument italic text-lg text-latitude-noir/85">
                    <span class="text-latitude-or">✦</span> {m}
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3">
              <a
                href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent(`Bonjour Aurélien, je voudrais discuter d'un projet : ${s.titre}.`)}`}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center justify-center h-11 px-6 bg-latitude-noir text-latitude-blanc font-hanken font-semibold text-[12px] uppercase tracking-[0.18em] hover:bg-latitude-or hover:text-latitude-noir transition-colors"
              >
                Discuter ce projet ✦
              </a>
              <a
                href={`#lb-serie-${i + 1}`}
                class="inline-flex items-center gap-2 h-11 px-5 border border-latitude-noir/40 text-latitude-noir font-hanken font-semibold text-[12px] uppercase tracking-[0.18em] hover:bg-latitude-noir hover:text-latitude-blanc transition-colors"
              >
                ⛶ Voir la fiche en grand
              </a>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <!-- Lightbox immersive (CSS :target, vanilla) — une fiche plein écran par série -->
  {data.series.map((s, i) => (
    <div
      id={`lb-serie-${i + 1}`}
      class="lb fixed inset-0 z-50 bg-latitude-noir/95 text-latitude-blanc opacity-0 pointer-events-none target:opacity-100 target:pointer-events-auto transition-opacity duration-300 overflow-y-auto"
      role="dialog"
      aria-modal="true"
      aria-label={`Fiche ${s.titre}`}
    >
      <a href="#series" aria-label="Fermer" class="absolute inset-0" tabindex="-1"></a>
      <div class="relative max-w-4xl mx-auto px-6 md:px-10 py-16 md:py-24">
        <a
          href="#series"
          class="absolute top-6 right-6 inline-flex items-center justify-center w-10 h-10 bg-latitude-blanc/10 hover:bg-latitude-or hover:text-latitude-noir text-latitude-blanc font-hanken text-xl transition-colors"
          aria-label="Fermer la fiche"
        >×</a>

        <p class="font-hanken text-[10px] uppercase tracking-[0.3em] text-latitude-or">{s.code}</p>
        <h3 class="mt-3 font-dm-serif text-latitude-blanc leading-[0.95] tracking-tight" style="font-size: clamp(40px, 7vw, 88px);">
          {s.titre}
        </h3>
        <p class="mt-3 font-instrument italic text-latitude-or text-2xl md:text-3xl">{s.tagline}</p>

        <div class="mt-10 grid grid-cols-2 md:grid-cols-4 gap-px bg-latitude-blanc/15 border border-latitude-blanc/15">
          <div class="bg-latitude-noir p-5"><p class="font-hanken text-[10px] uppercase tracking-wider text-latitude-or/85">Format</p><p class="mt-1 font-dm-serif text-latitude-blanc text-lg">{s.format}</p></div>
          <div class="bg-latitude-noir p-5"><p class="font-hanken text-[10px] uppercase tracking-wider text-latitude-or/85">Durée</p><p class="mt-1 font-dm-serif text-latitude-blanc text-lg">{s.duree}</p></div>
          <div class="bg-latitude-noir p-5"><p class="font-hanken text-[10px] uppercase tracking-wider text-latitude-or/85">Livraison</p><p class="mt-1 font-dm-serif text-latitude-blanc text-lg">{s.livraison}</p></div>
          <div class="bg-latitude-noir p-5"><p class="font-hanken text-[10px] uppercase tracking-wider text-latitude-or/85">Investissement</p><p class="mt-1 font-dm-serif text-latitude-blanc text-lg">{s.prix}</p></div>
        </div>

        <p class="mt-10 font-hanken text-latitude-blanc/85 text-base md:text-lg leading-relaxed max-w-2xl">
          {s.description}
        </p>

        <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-2">
          {s.moments.map((m) => (
            <li class="flex items-center gap-2.5 font-instrument italic text-lg text-latitude-blanc/85">
              <span class="text-latitude-or">✦</span> {m}
            </li>
          ))}
        </ul>

        <a href="#series" class="mt-10 inline-flex items-center gap-2 font-hanken text-[12px] uppercase tracking-[0.18em] text-latitude-or hover:text-latitude-blanc">
          ← Retour aux séries
        </a>
      </div>
    </div>
  ))}

  <style>
    .lb:target { opacity: 1; pointer-events: auto; }
  </style>
</section>
