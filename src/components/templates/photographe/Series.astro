---
import IrisIcon from './IrisIcon.astro';
const seances = [
  { num: '01', titre: 'Couple', sous: 'Engagement, anniversaire, escapade', photo: '/images/photographe/extra-2.webp' },
  { num: '02', titre: 'Famille', sous: 'Du nourrisson aux grands-parents', photo: '/images/photographe/extra-3.webp' },
  { num: '03', titre: 'Pro & marque', sous: 'Portrait corporate, lifestyle brand', photo: '/images/photographe/extra-4.webp' },
  { num: '04', titre: 'Mariage', sous: 'Reportage éditorial pleine journée', photo: '/images/photographe/extra-5.webp' },
];
---
<section id="seances" class="py-24 md:py-32" style="background:#FAF7F0;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-16 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3 inline-flex items-center gap-2" style="color:#6E6A60;"><IrisIcon size={12} tone="dark" /> Séances proposées</div>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#0A0A0B;">Quatre façons <em class="italic">de regarder.</em></h2>
    </div>
    <div class="grid md:grid-cols-2 gap-10 lg:gap-16">
      {seances.map(s => (
        <article class="group">
          <div class="aspect-[5/4] overflow-hidden mb-5">
            <img src={s.photo} alt={s.titre} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy"/>
          </div>
          <div class="flex items-baseline gap-4">
            <span class="font-fraunces italic text-3xl" style="color:#B89766;">{s.num}</span>
            <div>
              <h3 class="font-fraunces text-2xl md:text-3xl" style="color:#0A0A0B;">{s.titre}</h3>
              <p class="text-[13px] uppercase tracking-[0.22em] mt-1" style="color:#6E6A60;">{s.sous}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
