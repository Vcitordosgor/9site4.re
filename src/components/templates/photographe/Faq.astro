---
import IrisIcon from './IrisIcon.astro';
const faqs = [
  { q: 'Argentique ou numérique ?', r: 'Les deux, selon le projet. Argentique 35mm pour les séances éditoriales et le mariage ; numérique pour la corporate et les délais courts. Toujours discuté en amont.' },
  { q: 'Délai de livraison ?', r: 'Sélection sous 7 jours, retouches finales sous 21 jours pour le portrait, 6 semaines pour un mariage. Express possible (+30%).' },
  { q: 'Où se passent les séances ?', r: 'En studio à Saint-Denis ou en extérieur partout sur l\'île. Repérage gratuit si vous avez un lieu précis en tête.' },
  { q: 'Droits d\'usage ?', r: 'Usage personnel inclus dans tous les forfaits. Pour usage commercial (marque, presse) : cession à part, négociée selon la diffusion.' },
  { q: 'Annulation / report ?', r: 'Annulation possible jusqu\'à 14 jours avant la séance. Report météo offert pour les séances extérieures.' },
];
---
<section class="py-24 md:py-32" style="background:#F2EBDD;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3 inline-flex items-center gap-2" style="color:#6E6A60;"><IrisIcon size={12} tone="dark" /> Questions fréquentes</div>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#0A0A0B;">FAQ.</h2>
    </div>
    <div class="max-w-3xl divide-y" style="border-color:rgba(10,10,11,0.15);">
      {faqs.map(f => (
        <details class="group py-6">
          <summary class="cursor-pointer flex justify-between gap-4 font-fraunces text-xl md:text-2xl" style="color:#0A0A0B;">
            {f.q}
            <span class="font-fraunces text-2xl transition-transform group-open:rotate-45" style="color:#B89766;">+</span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed max-w-2xl" style="color:#3A3A3D;">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>details + details { border-top: 1px solid rgba(10,10,11,0.15); }</style>
