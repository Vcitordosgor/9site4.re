---
import data from '../../../data/templates/latitude.json';
const year = new Date().getFullYear();
---
<footer class="py-14 border-t" style="background:#0A0A0B; color:#FAF7F0; border-color:rgba(250,247,240,0.10);">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-10">
    <div>
      <div class="font-fraunces text-2xl">Studio Latitude</div>
      <p class="text-[11px] uppercase tracking-[0.28em] mt-1" style="color:#B89766;">Photographe argentique · Réunion</p>
    </div>
    <div class="text-[13px]" style="color:#E8DFCB;">
      <a href={`mailto:${data.info.email}`}>{data.info.email}</a><br/>
      <a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a><br/>
      Saint-Denis · La Réunion
    </div>
    <div class="text-[13px]" style="color:#E8DFCB;">
      <a href="#seances">Séances</a> · <a href="#portfolio">Portfolio</a> · <a href="#tarifs">Tarifs</a> · <a href="#contact">Contact</a>
    </div>
  </div>
  <div class="max-w-content mx-auto px-6 md:px-10 mt-10 pt-6 border-t text-[10px] uppercase tracking-[0.28em]" style="border-color:rgba(250,247,240,0.10); color:#6E6A60;">
    © {year} Studio Latitude — Démonstration 9site4
  </div>
</footer>
