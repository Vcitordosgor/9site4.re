---
/**
 * Citation — extrait carnet de prise de vue, fond charbon dm-serif italique or.
 */
---

<section class="relative bg-latitude-charbon text-latitude-blanc py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.08]" aria-hidden="true">
    <filter id="lat-quote-grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#lat-quote-grain)"/>
  </svg>

  <div class="relative max-w-4xl mx-auto">
    <span class="scroll-reveal block font-dm-serif italic text-latitude-or/25 leading-none" style="font-size: clamp(120px, 18vw, 220px);" aria-hidden="true">
      &laquo;
    </span>

    <blockquote class="scroll-reveal -mt-12 md:-mt-20 font-dm-serif italic font-normal text-latitude-blanc leading-[1.18] tracking-tight" style="font-size: clamp(32px, 5vw, 56px);">
      Une photographie ne se prend pas. Elle se reçoit,
      <span class="block mt-3 not-italic font-normal text-latitude-or">si l'on a eu la patience d'attendre.</span>
    </blockquote>

    <footer class="scroll-reveal mt-12 flex items-center gap-3">
      <span class="block w-12 h-px bg-latitude-or" aria-hidden="true"></span>
      <p class="font-hanken uppercase tracking-[0.32em] text-latitude-blanc/65 text-[11px]">
        Note du carnet — automne dernier
      </p>
    </footer>
  </div>
</section>
