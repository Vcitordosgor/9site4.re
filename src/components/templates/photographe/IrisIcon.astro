---
/**
 * IrisIcon — mini iris d'obturateur SVG (12-16px), 6 lames.
 * Anime l'ouverture au scroll-into-view (IntersectionObserver via classe is-open).
 * Renforce l'identité visuelle photo argentique sur tout le scroll.
 */
interface Props {
  size?: number;
  tone?: 'dark' | 'light';
  class?: string;
}
const { size = 14, tone = 'dark', class: className = '' } = Astro.props;
const stroke = tone === 'light' ? '#FAF7F0' : '#0A0A0B';
---
<span class:list={["iris-mini inline-block align-middle", className]} style={`width:${size}px;height:${size}px;`} aria-hidden="true">
  <svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke={stroke} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="10.5" opacity="0.55"/>
    <g class="iris-blades" style="transform-origin:12px 12px;">
      <path d="M12 12 L12 2.5 L18 5"/>
      <path d="M12 12 L21.5 14 L20 20.5"/>
      <path d="M12 12 L14 21.5 L7.5 21"/>
      <path d="M12 12 L4 19 L2 13"/>
      <path d="M12 12 L3 9 L7 3.5"/>
      <path d="M12 12 L10 2.5 L16.5 3"/>
    </g>
  </svg>
</span>

<style>
  .iris-mini svg { display:block; }
  .iris-mini .iris-blades {
    transform: rotate(0deg) scale(0.6);
    opacity: 0.45;
    transition: transform 700ms cubic-bezier(0.22,1,0.36,1), opacity 500ms ease;
  }
  .iris-mini:hover .iris-blades,
  .iris-mini.is-open .iris-blades {
    transform: rotate(30deg) scale(1);
    opacity: 0.9;
  }
  @media (prefers-reduced-motion: reduce) {
    .iris-mini .iris-blades { transition: none; transform: rotate(15deg) scale(0.85); opacity: 0.7; }
  }
</style>

<script>
  const irises = document.querySelectorAll('.iris-mini');
  if (irises.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          (e.target as HTMLElement).classList.add('is-open');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.5 });
    irises.forEach(i => io.observe(i));
  }
</script>
