---
/**
 * PhotoPleine — section image plein cadre 21/9 sous Series.
 */
---

<section class="relative bg-latitude-noir px-0 py-0">
  <figure class="relative w-full overflow-hidden bg-latitude-charbon" style="aspect-ratio: 21/9;">
    <img
      src="https://images.unsplash.com/photo-1452587925148-ce544e77e70d?w=1800&q=85"
      alt="Détail argentique, planche-contact en lumière rasante"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(15,15,15,0.10) 0%, rgba(15,15,15,0.55) 100%);"></div>

    <figcaption class="absolute bottom-5 md:bottom-10 left-6 md:left-12 right-6 md:right-12 flex items-baseline gap-3 text-latitude-blanc">
      <span class="block w-10 h-px bg-latitude-or flex-shrink-0" aria-hidden="true"></span>
      <p class="font-instrument italic" style="font-size: clamp(15px, 1.5vw, 20px);">
        Hors-cadre — un détail trouvé avant le déclic.
      </p>
    </figcaption>
  </figure>
</section>
