---
import data from '../../../data/templates/latitude.json';
const nav = [
  { href: '#seances', label: 'Séances' },
  { href: '#portfolio', label: 'Portfolio' },
  { href: '#methode', label: 'Méthode' },
  { href: '#tarifs', label: 'Tarifs' },
  { href: '#contact', label: 'Contact' },
];
---
<header id="ph-header" data-scrolled="false" class="sticky top-0 z-50 transition-all duration-500"
  style="background:rgba(250,247,240,0.96);">
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6 border-b" style="border-color:rgba(10,10,11,0.10);">
    <a href="#top" class="flex items-baseline gap-3" aria-label="Studio Latitude">
      <span class="font-fraunces text-2xl md:text-3xl tracking-tight" style="color:#0A0A0B;">Studio Latitude</span>
      <span class="hidden md:inline text-[10px] uppercase tracking-[0.32em]" style="color:#6E6A60;">·  Réunion · argentique</span>
    </a>
    <nav class="hidden md:flex items-center gap-7 text-[12px] uppercase tracking-[0.20em] font-medium" aria-label="Navigation">
      {nav.map(n => <a href={n.href} class="hover:opacity-60 transition-opacity" style="color:#0A0A0B;">{n.label}</a>)}
    </nav>
    <a href="#contact" class="hidden md:inline-flex items-center h-10 px-5 text-[12px] uppercase tracking-[0.16em] font-semibold transition-colors"
       style="background:#0A0A0B; color:#FAF7F0;">Réserver une séance</a>
    <a href={`tel:${data.info.telephoneHref}`} class="md:hidden inline-flex items-center h-10 px-4 text-[11px] uppercase tracking-wider font-semibold"
       style="background:#0A0A0B; color:#FAF7F0;">Appeler</a>
  </div>
</header>
<script>
  const h = document.getElementById('ph-header');
  if (h) { const u = () => { h.dataset.scrolled = String(window.scrollY > 8); }; u(); window.addEventListener('scroll', u, { passive: true }); }
</script>
