---
const etapes = [
  { num: '01', titre: 'Brief', texte: 'Appel ou café. On parle de vous, du contexte, du livrable. Repérage du lieu si nécessaire.' },
  { num: '02', titre: 'Shoot', texte: 'Séance d\'1 à 6 heures selon la formule. Direction douce, beaucoup d\'écoute, jamais de pose figée.' },
  { num: '03', titre: 'Retouche', texte: 'Tri éditorial sous 7 jours. Retouche couleur fine, sans filtre — au plus près de la lumière du moment.' },
  { num: '04', titre: 'Livraison', texte: 'Galerie privée en ligne sous 4 semaines max. Tirages baryté livrés sous 6 semaines (option).' },
];
---
<section id="methode" class="py-24 md:py-32" style="background:#F2EBDD;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <div class="text-[10px] uppercase tracking-[0.32em] mb-3" style="color:#6E6A60;">Méthode</div>
      <h2 class="font-fraunces text-5xl md:text-6xl leading-tight" style="color:#0A0A0B;">Du brief <em class="italic">à la livraison.</em></h2>
    </div>
    <div class="grid md:grid-cols-4 gap-px" style="background:rgba(10,10,11,0.15);">
      {etapes.map(e => (
        <div class="p-8" style="background:#F2EBDD;">
          <div class="font-fraunces italic text-6xl mb-4" style="color:#B89766;">{e.num}</div>
          <h3 class="font-fraunces text-2xl mb-3" style="color:#0A0A0B;">{e.titre}</h3>
          <p class="text-[14px] leading-relaxed" style="color:#3A3A3D;">{e.texte}</p>
        </div>
      ))}
    </div>
  </div>
</section>
