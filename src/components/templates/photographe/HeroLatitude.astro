---
---
<section class="relative w-full">
  <div class="relative h-screen min-h-[600px] w-full overflow-hidden" style="background:#0A0A0B;">
    <img src="/images/photographe/extra-1.webp" alt="Photographie éditoriale par Studio Latitude"
         class="absolute inset-0 w-full h-full object-cover" fetchpriority="high"/>
    <div class="absolute inset-0" style="background:linear-gradient(180deg, rgba(10,10,11,0.10) 0%, rgba(10,10,11,0.60) 100%);"></div>
    <div class="absolute inset-x-0 bottom-0 p-6 md:p-12">
      <div class="max-w-content mx-auto">
        <div class="text-[10px] uppercase tracking-[0.32em] mb-5" style="color:#E8DFCB;">Studio Latitude · La Réunion</div>
        <h1 class="font-fraunces text-5xl md:text-8xl leading-[0.95]" style="color:#FAF7F0;">
          Une lumière, <em class="italic">un instant,</em><br/>une image qui reste.
        </h1>
        <div class="mt-10 flex flex-wrap gap-3 items-baseline">
          <a href="#portfolio" class="inline-flex items-center h-12 px-7 text-[12px] uppercase tracking-[0.22em] font-semibold"
             style="background:#FAF7F0; color:#0A0A0B;">Voir le portfolio</a>
          <a href="#contact" class="inline-flex items-center h-12 px-7 text-[12px] uppercase tracking-[0.22em] font-semibold border"
             style="border-color:#FAF7F0; color:#FAF7F0;">Demander un devis</a>
          <span class="ml-auto hidden md:inline text-[11px] uppercase tracking-[0.28em]" style="color:#C9C2B0;">ISO 400 · f/2.8 · 1/250</span>
        </div>
      </div>
    </div>
  </div>
</section>
