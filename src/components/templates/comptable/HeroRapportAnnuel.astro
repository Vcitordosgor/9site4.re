---
/**
 * HeroRapportAnnuel — page de couverture rapport annuel.
 * Pattern lignes verticales fines en arrière-plan, format institutionnel sobre.
 */
import data from '../../../data/templates/auberval.json';
---

<section id="top" class="relative bg-auberval-feutre overflow-hidden">

  <!-- Pattern papier ligné en arrière-plan -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true"
       style="background-image: repeating-linear-gradient(90deg, transparent 0, transparent 35px, rgba(167,138,79,0.08) 35px, rgba(167,138,79,0.08) 36px);">
  </div>

  <!-- Filet doré en haut -->
  <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-auberval-or to-transparent" aria-hidden="true"></div>

  <div class="relative max-w-content mx-auto px-6 md:px-10 pt-32 pb-24 md:pt-44 md:pb-28">

    <!-- En-tête type rapport annuel -->
    <div class="flex items-baseline justify-between font-dm-mono text-[10px] uppercase tracking-[0.32em] text-auberval-or mb-14 sm:mb-12 md:mb-20 pb-3 border-b border-auberval-marine/15">
      <span>Cabinet n° {data.info.agrement}</span>
      <span class="hidden sm:inline">La Réunion</span>
      <span>Édition {new Date().getFullYear()}</span>
    </div>

    <!-- Titre principal -->
    <div class="grid lg:grid-cols-12 gap-10 lg:gap-16 items-end mb-16 md:mb-20">

      <div class="lg:col-span-9">
        <p class="font-plex-sans text-[10px] uppercase tracking-[0.32em] text-auberval-marine font-semibold mb-6">
          ✦ Service — Expertise comptable · OEC · depuis {data.info.annee}
        </p>

        <h1 class="font-source-serif text-auberval-marine leading-[0.95]" style="font-size: clamp(48px, 9vw, 144px);">
          {data.info.wordmark}<br/>
          <span class="italic text-auberval-or">{data.info.wordmark2}</span>
        </h1>

        <p class="mt-7 font-plex-sans text-auberval-encre text-lg md:text-2xl leading-snug max-w-2xl">
          {data.info.soustitre}
        </p>
      </div>

      <!-- CTA bloc droite -->
      <div class="lg:col-span-3 lg:pl-6 lg:border-l lg:border-auberval-marine/15">
        <p class="font-dm-mono text-[10px] uppercase tracking-[0.28em] text-auberval-or mb-3">
          Prendre contact
        </p>
        <p class="font-source-serif text-auberval-marine text-lg tabular-nums mb-2">
          {data.info.telephone}
        </p>
        <p class="font-plex-sans text-auberval-encre/75 text-sm break-all mb-6">
          {data.info.email}
        </p>
        <a
          href="#rendez-vous"
          class="inline-flex items-center h-12 px-6 bg-auberval-marine text-auberval-feutre font-plex-sans font-medium text-sm hover:bg-auberval-encre transition-colors"
        >
          Demander un audit gratuit →
        </a>
        <p class="mt-3 font-dm-mono text-[9.5px] uppercase tracking-[0.22em] text-auberval-encre/55">
          Diagnostic offert · Sans engagement
        </p>
      </div>
    </div>

    <!-- Bandeau 4 stats — compteurs animés (signature) -->
    <ul class="mt-2 md:mt-0 grid grid-cols-2 md:grid-cols-4 gap-px bg-auberval-marine/15 border-t border-b border-auberval-marine/15" data-counters>
      {data.stats.map((s) => {
        const m = String(s.valeur).match(/^(\D*)(\d+(?:[.,]\d+)?)(.*)$/);
        const prefix = m ? m[1] : '';
        const target = m ? m[2] : '';
        const suffix = m ? m[3] : String(s.valeur);
        return (
          <li class="bg-auberval-feutre py-6 md:py-8 px-4 text-center">
            <p class="font-source-serif text-auberval-marine leading-none" style="font-size: clamp(28px, 4vw, 48px); font-variant-numeric: tabular-nums lining-nums; font-feature-settings: 'tnum' 1, 'lnum' 1;">
              <span aria-hidden="true">{prefix}</span><span class="auberval-count" data-target={target} data-final={s.valeur}>0</span><span aria-hidden="true">{suffix}</span>
              <span class="sr-only">{s.valeur}</span>
            </p>
            <p class="mt-3 font-dm-mono text-[10px] uppercase tracking-[0.22em] text-auberval-encre/65">
              {s.label}
            </p>
          </li>
        );
      })}
    </ul>

    <!-- Courbe progression — trait sobre qui se dessine -->
    <figure class="auberval-chart mt-10 md:mt-8" aria-label="Évolution du cabinet sur dix ans">
      <div class="flex items-baseline justify-between font-dm-mono text-[10px] uppercase tracking-[0.28em] text-auberval-or/80 mb-2">
        <span>Progression — 10 dernières années</span>
        <span class="hidden sm:inline" style="font-variant-numeric: tabular-nums;">indice 100 → 240</span>
      </div>
      <svg viewBox="0 0 600 120" preserveAspectRatio="none" class="block w-full h-[88px] md:h-[104px]" role="img" aria-hidden="true">
        <defs>
          <linearGradient id="auberval-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#a78a4f" stop-opacity="0.18"/>
            <stop offset="100%" stop-color="#a78a4f" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <g stroke="rgba(26,41,68,0.08)" stroke-width="1">
          <line x1="0" x2="600" y1="30" y2="30"/>
          <line x1="0" x2="600" y1="60" y2="60"/>
          <line x1="0" x2="600" y1="90" y2="90"/>
        </g>
        <path class="auberval-area" d="M0,100 L60,94 L120,88 L180,80 L240,72 L300,62 L360,54 L420,42 L480,34 L540,24 L600,16 L600,120 L0,120 Z" fill="url(#auberval-fill)" opacity="0"/>
        <path class="auberval-line" d="M0,100 L60,94 L120,88 L180,80 L240,72 L300,62 L360,54 L420,42 L480,34 L540,24 L600,16"
              fill="none" stroke="#a78a4f" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </figure>

    <style>
      .auberval-line { stroke-dasharray: 1400; stroke-dashoffset: 1400; }
      .auberval-chart[data-revealed="true"] .auberval-line { animation: auberval-draw 1800ms cubic-bezier(0.22, 0.61, 0.36, 1) forwards; }
      .auberval-chart[data-revealed="true"] .auberval-area { animation: auberval-fade 1400ms ease-out 600ms forwards; }
      @keyframes auberval-draw { to { stroke-dashoffset: 0; } }
      @keyframes auberval-fade { to { opacity: 1; } }
      @media (prefers-reduced-motion: reduce) {
        .auberval-line { stroke-dashoffset: 0 !important; animation: none !important; }
        .auberval-area { opacity: 1 !important; animation: none !important; }
      }
    </style>

    <script is:inline>
      (function () {
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function ease(t) { return 1 - Math.pow(1 - t, 3); } /* easeOutCubic — pas de rebond */
        function formatNum(target, value) {
          if (/[.,]/.test(target)) {
            var dec = (target.split(/[.,]/)[1] || '').length;
            return value.toFixed(dec).replace('.', target.indexOf(',') > -1 ? ',' : '.');
          }
          return Math.round(value).toString();
        }
        function animateCounter(el) {
          var raw = el.getAttribute('data-target') || '0';
          var target = parseFloat(raw.replace(',', '.'));
          if (!isFinite(target)) { el.textContent = el.getAttribute('data-final') || raw; return; }
          if (reduce) { el.textContent = formatNum(raw, target); return; }
          var duration = 1600, start = null;
          function step(ts) {
            if (start === null) start = ts;
            var t = Math.min(1, (ts - start) / duration);
            el.textContent = formatNum(raw, target * ease(t));
            if (t < 1) requestAnimationFrame(step);
          }
          requestAnimationFrame(step);
        }
        var list = document.querySelector('[data-counters]');
        var chart = document.querySelector('.auberval-chart');
        if (!list && !chart) return;
        var fired = false;
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (!e.isIntersecting || fired) return;
            fired = true;
            if (list) list.querySelectorAll('.auberval-count').forEach(animateCounter);
            if (chart) chart.setAttribute('data-revealed', 'true');
            io.disconnect();
          });
        }, { threshold: 0.35 });
        if (list) io.observe(list);
        if (chart) io.observe(chart);
      })();
    </script>

    <!-- Mot de l'associé fondateur (lettre du président style rapport annuel) -->
    <figure class="auberval-lettre mt-16 md:mt-14 max-w-3xl" data-open="false">
      <p class="flex items-baseline gap-3 font-dm-mono text-[10px] uppercase tracking-[0.32em] text-auberval-or mb-3">
        <span aria-hidden="true">§</span>
        <span>Mot de l'associé fondateur</span>
        <span class="flex-1 h-px bg-auberval-or/30 ml-2" aria-hidden="true"></span>
      </p>

      <!-- Bouton toggle mobile uniquement -->
      <button
        type="button"
        class="auberval-lettre-toggle md:hidden mt-2 inline-flex items-center gap-2 h-11 px-5 ring-1 ring-auberval-marine/25 text-auberval-marine font-plex-sans text-xs uppercase tracking-[0.22em] hover:bg-auberval-marine/5 transition-colors"
        aria-expanded="false"
        aria-controls="auberval-lettre-body"
      >
        <span class="auberval-lettre-label">Lire la lettre</span>
        <span aria-hidden="true" class="auberval-lettre-chevron transition-transform">↓</span>
      </button>

      <div id="auberval-lettre-body" class="auberval-lettre-body">
        <blockquote class="font-source-serif italic text-auberval-marine leading-[1.55] text-lg md:text-xl">
          « L'expertise comptable mérite qu'on prenne le temps. Pas l'expédient d'un mail laconique trois mois après l'envoi du bilan. Du temps de décision, partagé. »
        </blockquote>
        <figcaption class="mt-4 font-plex-sans text-auberval-encre text-sm leading-snug">
          <span class="font-source-serif italic text-auberval-marine text-base">— Marc Auberval</span>,
          <span class="text-auberval-encre/75">associé fondateur · OEC inscrit</span><br/>
          <span class="font-dm-mono text-[10px] uppercase tracking-[0.28em] text-auberval-or/85">
            La Réunion · Janvier {new Date().getFullYear()}
          </span>
        </figcaption>
      </div>
    </figure>

    <style>
      /* Desktop : toujours visible */
      @media (min-width: 768px) {
        .auberval-lettre-body { display: block !important; opacity: 1 !important; max-height: none !important; }
      }
      /* Mobile : collapse par défaut */
      @media (max-width: 767px) {
        .auberval-lettre-body {
          overflow: hidden;
          max-height: 0;
          opacity: 0;
          margin-top: 0;
          transition: max-height 420ms ease, opacity 320ms ease, margin-top 420ms ease;
        }
        .auberval-lettre[data-open="true"] .auberval-lettre-body {
          max-height: 1200px;
          opacity: 1;
          margin-top: 1rem;
        }
        .auberval-lettre[data-open="true"] .auberval-lettre-chevron { transform: rotate(180deg); }
      }
      @media (prefers-reduced-motion: reduce) {
        .auberval-lettre-body { transition: none !important; }
      }
    </style>

    <script is:inline>
      (function () {
        var fig = document.querySelector('.auberval-lettre');
        if (!fig) return;
        var btn = fig.querySelector('.auberval-lettre-toggle');
        var label = fig.querySelector('.auberval-lettre-label');
        if (!btn || !label) return;
        btn.addEventListener('click', function () {
          var open = fig.getAttribute('data-open') === 'true';
          fig.setAttribute('data-open', String(!open));
          btn.setAttribute('aria-expanded', String(!open));
          label.textContent = !open ? 'Masquer la lettre' : 'Lire la lettre';
        });
      })();
    </script>

    <!-- Pied page rapport -->
    <div class="mt-16 md:mt-12 flex items-baseline justify-between font-dm-mono text-[10px] uppercase tracking-[0.28em] text-auberval-or/65">
      <span>Document à caractère informatif</span>
      <span class="hidden sm:inline">— Page 01 / 10 —</span>
      <span>↓ Continuer</span>
    </div>
  </div>
</section>
