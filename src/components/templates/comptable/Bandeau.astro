---
import data from '../../../data/templates/auberval.json';
---

<section class="bg-auberval-vert text-auberval-feutre relative">
  <div class="absolute inset-x-0 top-0 h-px bg-auberval-or" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-auberval-or" aria-hidden="true"></div>

  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-2">
        <p class="font-dm-mono text-[10px] uppercase tracking-[0.32em] text-auberval-or mb-2">
          ✦ § VII·b
        </p>
        <p class="font-dm-mono text-[10px] uppercase tracking-[0.28em] text-auberval-feutre/80">
          Premier rendez-vous
        </p>
      </div>
      <div class="md:col-span-7">
        <p class="font-source-serif text-auberval-feutre leading-[1.05]" style="font-size: clamp(26px, 3.4vw, 44px);">
          Premier rendez-vous <span class="italic text-auberval-or">offert</span> — diagnostic comptable en 45 minutes.
        </p>
      </div>
      <div class="md:col-span-3 md:text-right">
        <a
          href="#rendez-vous"
          class="inline-flex items-center justify-center h-12 px-6 bg-auberval-feutre text-auberval-marine font-plex-sans font-semibold text-[12px] uppercase tracking-[0.22em] hover:bg-auberval-or hover:text-auberval-feutre transition-colors"
        >
          Réserver la séance
        </a>
        <p class="mt-3 font-dm-mono text-[11px] uppercase tracking-[0.22em] text-auberval-or">
          {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
