---
/**
 * Comparaison — bilan comparé "Avec / Sans expert-comptable de proximité",
 * traité comme une page de rapport en deux colonnes.
 */
const sansItems = [
  "Bilan rendu en juin, dans l'urgence",
  "Honoraires variables, factures imprévues",
  "Aucun rendez-vous de pilotage en cours d'année",
  "Veille fiscale à votre charge",
  "Réponse aux questions sous 5 à 10 jours",
  "Aucune anticipation des optimisations",
];

const avecItems = [
  "Bilan livré avant le 31 mars, sans urgence",
  "Forfait fixe annoncé, zéro frais caché",
  "Rendez-vous trimestriel inclus dans le forfait",
  "Veille fiscale hebdomadaire transmise",
  "Réponse aux mails sous 24h ouvrées",
  "Optimisations préparées dès novembre N",
];
---

<section class="bg-auberval-feutre py-24 md:py-32 px-6 md:px-10 border-t border-auberval-marine/15">
  <div class="max-w-content mx-auto">

    <header class="mb-14 max-w-3xl">
      <p class="font-plex-sans text-[10px] uppercase tracking-[0.32em] text-auberval-or font-semibold mb-6">
        ✦ Bilan comparé
      </p>
      <h2 class="font-source-serif text-auberval-marine leading-[0.95]" style="font-size: clamp(36px, 5vw, 72px);">
        Ce que change<br/>
        <span class="italic text-auberval-or font-light">un cabinet de proximité.</span>
      </h2>
    </header>

    <div class="grid md:grid-cols-2 gap-px bg-auberval-marine/20 border border-auberval-marine/20">

      <div class="bg-auberval-gris p-7 md:p-9">
        <p class="font-dm-mono text-[10px] uppercase tracking-[0.3em] text-auberval-encre mb-4">
          Colonne A
        </p>
        <h3 class="font-source-serif text-auberval-encre text-2xl md:text-3xl mb-6 pb-5 border-b border-auberval-marine/20">
          Sans accompagnement régulier
        </h3>
        <ul class="space-y-4">
          {sansItems.map((it) => (
            <li class="flex gap-3 items-start font-plex-sans text-auberval-encre text-[14.5px] leading-relaxed">
              <svg viewBox="0 0 16 16" class="w-4 h-4 mt-1 shrink-0 text-auberval-encre/55" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                <line x1="3" y1="3" x2="13" y2="13"/>
                <line x1="13" y1="3" x2="3" y2="13"/>
              </svg>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-auberval-marine text-auberval-feutre p-7 md:p-9 relative">

        <div class="absolute top-3 right-3 px-2 py-1 bg-auberval-or text-auberval-marine font-dm-mono text-[10px] uppercase tracking-[0.22em]">
          ◆ Cabinet Auberval
        </div>

        <p class="font-dm-mono text-[10px] uppercase tracking-[0.3em] text-auberval-or mb-4">
          Colonne B
        </p>
        <h3 class="font-source-serif text-auberval-feutre text-2xl md:text-3xl mb-6 pb-5 border-b border-auberval-or/40">
          <span class="italic text-auberval-or font-light">Avec</span> le cabinet Auberval
        </h3>
        <ul class="space-y-4">
          {avecItems.map((it) => (
            <li class="flex gap-3 items-start font-plex-sans text-auberval-feutre text-[14.5px] leading-relaxed">
              <svg viewBox="0 0 16 16" class="w-4 h-4 mt-1 shrink-0 text-auberval-vert" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 8 L7 12 L13 4"/>
              </svg>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
