---
/**
 * Associes — trombinoscope avec avatars stylisés (cercle silhouette neutre).
 * Palette en nuances de gris (plus de doré).
 */
import data from '../../../data/templates/auberval.json';

// 4 nuances de gris — du clair au foncé
const avatarVariants = [
  { bg: '#3D424A', fg: '#F1F0EC' }, // gris ardoise
  { bg: '#9A9A93', fg: '#1B2330' }, // gris pierre
  { bg: '#2A2D33', fg: '#F1F0EC' }, // gris anthracite
  { bg: '#E6E4DD', fg: '#1B2330' }, // gris perle
];
---

<section id="associes" class="bg-auberval-blanc py-24 md:py-32 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="mb-14 md:mb-20 max-w-3xl">
      <p class="font-plex-sans text-[10px] uppercase tracking-[0.32em] text-auberval-encre/55 font-semibold mb-5">
        ✦ Les associés
      </p>
      <h2 class="font-source-serif text-auberval-marine leading-[1.05]" style="font-size: clamp(36px, 5vw, 64px);">
        Quatre experts-comptables<br/>
        <span class="italic text-auberval-encre/60">à votre service.</span>
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {data.associes.map((a, i) => {
        const v = avatarVariants[i % avatarVariants.length];
        return (
        <li>
          <article class="h-full">
            <!-- Avatar SVG silhouette neutre -->
            <div
              class="relative aspect-square overflow-hidden mb-5 flex items-center justify-center"
              style={`background-color:${v.bg};color:${v.fg};`}
              role="img"
              aria-label={`Avatar de ${a.prenom} ${a.nom}`}
            >
              <!-- Filet gris horizontal en haut -->
              <div class="absolute top-0 inset-x-0 h-px bg-current/30" aria-hidden="true"></div>
              <!-- Silhouette buste -->
              <svg viewBox="0 0 200 200" class="relative w-3/5 h-3/5" fill="currentColor" aria-hidden="true">
                <circle cx="100" cy="78" r="34" opacity="0.92" />
                <path d="M40 200 C40 145 65 122 100 122 C135 122 160 145 160 200 Z" opacity="0.85" />
              </svg>
              <!-- Étiquette OEC -->
              <span class="absolute bottom-3 left-3 inline-block bg-auberval-marine text-auberval-feutre font-dm-mono text-[10px] uppercase tracking-[0.18em] px-2.5 py-1.5">
                ✦ {a.memberOEC}
              </span>
            </div>

            <!-- Identité -->
            <p class="font-dm-mono text-[10px] uppercase tracking-[0.28em] text-auberval-encre/55 mb-2">
              Associé n°{String(i + 1).padStart(2, '0')}
            </p>
            <h3 class="font-source-serif text-auberval-marine text-2xl leading-tight mb-1">
              {a.prenom} {a.nom}
            </h3>
            <p class="font-plex-sans text-auberval-encre text-sm font-medium mb-3">
              {a.titre}
            </p>
            <p class="pt-3 border-t border-auberval-marine/15 font-source-serif italic text-auberval-encre/75 text-sm leading-snug">
              {a.specialite}
            </p>
          </article>
        </li>
        );
      })}
    </ul>

    <!-- Note -->
    <p class="mt-12 font-source-serif italic text-auberval-encre/65 text-base leading-relaxed max-w-2xl">
      Tous nos associés sont régulièrement inscrits à l'Ordre des Experts-Comptables (OEC) et soumis à la déontologie de la profession. Code interne consultable sur demande.
    </p>
  </div>
</section>
