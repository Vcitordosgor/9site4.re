---
const faqs = [
  {
    q: "Combien coûte un forfait expert-comptable pour une TPE ?",
    r: "À partir de 95 € HT par mois pour une micro-entreprise, EURL ou SASU sans salarié. Le forfait inclut la tenue, le bilan annuel, la liasse fiscale, les déclarations TVA, l'attestation bancaire et un rendez-vous trimestriel de pilotage. Aucun frais caché en fin d'exercice.",
  },
  {
    q: "Reprenez-vous un dossier en cours d'exercice ?",
    r: "Oui, fréquemment. Reprise sans frais des écritures de l'exercice en cours auprès de votre cabinet précédent. Bilan d'ouverture validé contradictoirement. Période de transition de 4 à 6 semaines.",
  },
  {
    q: "Sous quel délai rendez-vous le bilan annuel ?",
    r: "Garantie de remise avant le 31 mars de l'année N+1, dès lors que les pièces sont transmises avant le 15 février. Nous communiquons un calendrier détaillé en début d'année.",
  },
  {
    q: "Êtes-vous compétents en optimisation fiscale du dirigeant ?",
    r: "Oui, c'est l'un des domaines de Me Pradel : schémas de holding, transmission, dividendes vs rémunération, démembrement, PEA et PEE. Audit fiscal patrimonial sur devis.",
  },
  {
    q: "Comment échangez-vous les pièces comptables ?",
    r: "Plateforme sécurisée RGPD, hébergement UE, accès 24/7. Application mobile pour scanner factures et notes de frais. Aucune externalisation hors Union européenne.",
  },
];
---

<section class="bg-auberval-feutre py-24 md:py-32 px-6 md:px-10 border-t border-auberval-marine/15">
  <div class="max-w-content mx-auto">

    <header class="mb-14 max-w-3xl">
      <p class="font-plex-sans text-[10px] uppercase tracking-[0.32em] text-auberval-or font-semibold mb-6">
        ✦ Annexes — Questions fréquentes
      </p>
      <h2 class="font-source-serif text-auberval-marine leading-[0.95]" style="font-size: clamp(36px, 5vw, 72px);">
        Cinq questions,<br/>
        <span class="italic text-auberval-or font-light">avant un premier rendez-vous.</span>
      </h2>
    </header>

    <ul class="border-t border-auberval-marine/25 max-w-4xl">
      {faqs.map((f, i) => (
        <li class="border-b border-auberval-marine/15">
          <details class="group">
            <summary class="flex gap-5 md:gap-7 py-6 md:py-7 cursor-pointer list-none items-baseline hover:bg-auberval-gris transition-colors px-2 -mx-2">
              <span class="font-dm-mono text-[11px] uppercase tracking-[0.22em] text-auberval-or shrink-0 mt-1">
                Q·{String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="flex-1 font-source-serif text-auberval-marine text-lg md:text-2xl leading-snug">
                {f.q}
              </h3>
              <span class="font-source-serif text-auberval-or text-2xl md:text-3xl leading-none transition-transform group-open:rotate-45 inline-block shrink-0">
                +
              </span>
            </summary>
            <div class="pb-7 pl-16 md:pl-20 pr-6">
              <p class="font-plex-sans text-auberval-encre text-[14.5px] md:text-base leading-[1.8]">
                {f.r}
              </p>
            </div>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
