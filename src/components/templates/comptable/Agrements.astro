---
const agrements = [
  { label: 'OEC', sub: 'Inscription à l\'Ordre des experts-comptables' },
  { label: 'CAC', sub: 'Commissariat aux comptes' },
  { label: 'RCP', sub: 'Responsabilité civile professionnelle' },
  { label: 'RGPD', sub: 'Hébergement données conforme UE' },
];
---

<section class="bg-auberval-gris py-16 md:py-20 px-6 md:px-10 border-t border-auberval-marine/15">
  <div class="max-w-content mx-auto">

    <div class="mb-10 flex items-center gap-3">
      <span class="block w-12 h-px bg-auberval-or" aria-hidden="true"></span>
      <p class="font-dm-mono text-[10px] uppercase tracking-[0.3em] text-auberval-or">Agréments & garanties — Annexe</p>
      <span class="block flex-1 h-px bg-auberval-or/40" aria-hidden="true"></span>
    </div>

    <ul class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
      {agrements.map((a) => (
        <li class="bg-auberval-feutre border border-auberval-marine/20 px-5 py-7 text-center relative hover:border-auberval-or transition-colors group">

          <svg viewBox="0 0 64 64" class="w-14 h-14 mx-auto mb-4 text-auberval-or" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
            <circle cx="32" cy="32" r="22"/>
            <circle cx="32" cy="32" r="16"/>
            <path d="M22 32 L29 39 L42 26" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>

          <p class="font-source-serif text-auberval-marine text-2xl md:text-3xl leading-none tracking-tight">
            {a.label}
          </p>
          <p class="mt-3 pt-3 border-t border-auberval-marine/15 font-plex-sans text-auberval-encre text-[11.5px] md:text-xs leading-relaxed">
            {a.sub}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
