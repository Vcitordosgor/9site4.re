---
/**
 * Process — 5 étapes d'intervention numérotées en timeline horizontale.
 * Du premier appel à la facture, sans surprise.
 */
const steps = [
  { num: '01', titre: 'Appel ou WhatsApp', desc: 'Vous décrivez la panne. Je vous rappelle sous 15 minutes avec une estimation orale.' },
  { num: '02', titre: 'Diagnostic sur place', desc: 'Je passe, je regarde, je vous explique. Devis écrit signé avant de toucher au moindre boulon.' },
  { num: '03', titre: 'Intervention', desc: 'Travail propre, sol bâché, matériel certifié. Je vous montre ce que je remplace.' },
  { num: '04', titre: 'Essais & contrôle', desc: 'Mise en eau, vérification de pression, contrôle d\'étanchéité. Vous validez avec moi.' },
  { num: '05', titre: 'Facture & garantie', desc: 'Facture détaillée remise sur place. Garantie écrite 10 ans sur la main d\'œuvre.' },
];
---

<section id="process" class="relative bg-bp-anthracite text-bp-blanc py-20 md:py-28 px-6 md:px-10 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-[0.04]" aria-hidden="true"
       style="background-image: radial-gradient(circle, rgb(255 199 44) 1px, transparent 1px); background-size: 18px 18px;">
  </div>

  <div class="relative max-w-content mx-auto">
    <header class="max-w-3xl mb-14 md:mb-16">
      <p class="scroll-reveal inline-flex items-center gap-3 text-[11px] sm:text-xs font-archivo font-bold uppercase tracking-[0.32em] text-bp-jaune">
        <span class="block w-8 h-[3px] bg-bp-jaune" aria-hidden="true"></span>
        <span>Comment ça se passe</span>
      </p>
      <h2 class="scroll-reveal mt-5 font-bebas uppercase text-bp-blanc leading-[0.95] tracking-tight" style="font-size: clamp(40px, 5.5vw, 72px);">
        Du premier appel<br/>
        <span class="text-bp-jaune">à la facture.</span>
      </h2>
    </header>

    <ol class="relative grid md:grid-cols-5 gap-0 border-t-2 border-bp-jaune/30">
      {steps.map((s, i) => (
        <li class:list={[
          'group scroll-reveal relative pt-10 pr-5 pb-2 md:pr-7',
          i > 0 ? 'md:border-l-2 border-bp-jaune/30 md:pl-7' : '',
          i > 0 ? 'border-t-2 md:border-t-0 mt-8 md:mt-0' : '',
        ]} style={`transition-delay: ${i * 80}ms`}>
          <span class="absolute -top-[2px] left-0 right-0 h-[2px] bg-bp-jaune scale-x-0 origin-left transition-transform duration-700 group-[.is-visible]:scale-x-100" aria-hidden="true"></span>
          <span class="block font-bebas text-bp-jaune leading-none tabular-nums" style="font-size: clamp(56px, 7vw, 88px);">
            {s.num}
          </span>
          <h3 class="mt-4 font-bebas uppercase text-bp-blanc leading-tight tracking-wide" style="font-size: 22px;">
            {s.titre}
          </h3>
          <p class="mt-3 font-archivo text-bp-blanc/70 leading-[1.6]" style="font-size: 14.5px;">
            {s.desc}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
