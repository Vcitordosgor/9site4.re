---
/**
 * Citation — bandeau éditorial jaune avec citation pleine page.
 * Texte italique massif en Bebas/Archivo, attribution discrète.
 */
---

<section class="relative bg-bp-jaune text-bp-anthracite py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <!-- Bandes diagonales chantier -->
  <span class="absolute top-0 left-0 right-0 h-2 bg-bp-anthracite" aria-hidden="true"></span>
  <span class="absolute top-2 left-0 right-0 h-2" aria-hidden="true"
        style="background: repeating-linear-gradient(135deg, rgb(26 29 36) 0 12px, transparent 12px 24px);">
  </span>
  <span class="absolute bottom-0 left-0 right-0 h-2 bg-bp-anthracite" aria-hidden="true"></span>

  <div class="relative max-w-5xl mx-auto">
    <span class="scroll-reveal block font-bebas text-bp-anthracite/15 leading-none select-none" style="font-size: clamp(120px, 18vw, 220px);" aria-hidden="true">
      &ldquo;
    </span>

    <blockquote class="scroll-reveal -mt-12 md:-mt-20 font-archivo italic text-bp-anthracite leading-[1.15] tracking-tight" style="font-size: clamp(32px, 5vw, 56px);">
      Un bon plombier, c'est celui qui dort tranquille parce que ses chantiers tiennent.
      <span class="block mt-3 not-italic text-bp-anthracite/80">Pas celui qui finit le sien à 23h.</span>
    </blockquote>

    <footer class="scroll-reveal mt-10 flex items-center gap-4">
      <span class="block w-12 h-[3px] bg-bp-anthracite" aria-hidden="true"></span>
      <p class="font-archivo font-bold uppercase tracking-[0.28em] text-bp-anthracite/80 text-xs">
        Bernard, atelier, mardi matin
      </p>
    </footer>
  </div>
</section>
