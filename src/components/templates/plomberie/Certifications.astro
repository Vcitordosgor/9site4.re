---
/**
 * Certifications — badges/médailles métier avec icônes et labels précis.
 * Donne de la crédibilité technique : décennale, RGE, CAPEB, QualiPAC.
 */
const certifs = [
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/>',
    label: 'Garantie décennale',
    annee: 'MMA · à jour',
  },
  {
    icon: '<circle cx="12" cy="8" r="6"/><polyline points="8.21 13.89 7 22 12 19 17 22 15.79 13.88"/>',
    label: 'RGE QualiPAC',
    annee: 'Chauffe-eau solaire',
  },
  {
    icon: '<path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9v.01"/><path d="M9 12v.01"/><path d="M9 15v.01"/><path d="M9 18v.01"/>',
    label: 'Membre CAPEB',
    annee: 'Fédération artisans',
  },
  {
    icon: '<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/>',
    label: 'SIRET vérifié',
    annee: '498 217 583 00021',
  },
];
---

<section class="relative bg-bp-blanc py-20 md:py-24 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
      <p class="scroll-reveal text-[11px] sm:text-xs font-archivo font-bold uppercase tracking-[0.32em] text-bp-anthracite/70">
        Certifications & assurances
      </p>
      <h2 class="scroll-reveal mt-4 font-bebas uppercase text-bp-anthracite leading-[0.95] tracking-tight" style="font-size: clamp(32px, 4.5vw, 56px);">
        Papiers en règle,<br/>
        <span class="text-bp-anthracite/55">contrôlables sur demande.</span>
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {certifs.map((c, i) => (
        <li
          class="scroll-reveal group relative flex flex-col items-start gap-4 p-6 bg-bp-ciment border-2 border-bp-anthracite/10 hover:border-bp-anthracite transition-all duration-300 hover:-translate-y-1 hover:shadow-[6px_6px_0_0_rgb(255_199_44)]"
          style={`transition-delay: ${i * 70}ms`}
        >
          <span class="inline-flex items-center justify-center w-14 h-14 border-2 border-bp-anthracite bg-bp-blanc text-bp-anthracite group-hover:bg-bp-jaune transition-colors">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
          </span>
          <div>
            <h3 class="font-bebas uppercase text-bp-anthracite leading-tight tracking-wide" style="font-size: 21px;">
              {c.label}
            </h3>
            <p class="mt-1 font-archivo text-bp-anthracite/60 text-xs uppercase tracking-[0.2em]">
              {c.annee}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
