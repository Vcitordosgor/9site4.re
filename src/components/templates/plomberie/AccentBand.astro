---
/**
 * AccentBand — bandeau anthracite plein écran, message éditorial court,
 * 3 mentions clés en bandes horizontales.
 */
---

<section class="relative bg-bp-anthracite text-bp-blanc py-14 md:py-20 px-6 md:px-10 overflow-hidden border-y-4 border-bp-jaune">
  <div class="pointer-events-none absolute inset-0 opacity-[0.05]" aria-hidden="true"
       style="background-image: radial-gradient(circle, rgb(255 199 44) 1px, transparent 1px); background-size: 16px 16px;">
  </div>

  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-bp-jaune/30">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-6 sm:py-2">
        <span class="font-bebas text-bp-jaune leading-none" style="font-size: clamp(44px, 6vw, 64px);">7/7</span>
        <p class="mt-2 font-archivo font-bold uppercase tracking-[0.22em] text-bp-blanc/80 text-xs">
          Astreinte toute l'année
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-6 sm:py-2" style="transition-delay: 80ms">
        <span class="font-bebas text-bp-jaune leading-none" style="font-size: clamp(44px, 6vw, 64px);">DEVIS</span>
        <p class="mt-2 font-archivo font-bold uppercase tracking-[0.22em] text-bp-blanc/80 text-xs">
          Gratuit sur place, sous 24h
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-6 sm:py-2" style="transition-delay: 160ms">
        <span class="font-bebas text-bp-jaune leading-none" style="font-size: clamp(44px, 6vw, 64px);">10 ANS</span>
        <p class="mt-2 font-archivo font-bold uppercase tracking-[0.22em] text-bp-blanc/80 text-xs">
          Garantie décennale couverte
        </p>
      </li>
    </ul>
  </div>
</section>
