---
/**
 * Partenaires — logos de fournisseurs/marques en wordmarks neutres
 * (pas d'image SVG de marques réelles : juste des wordmarks typographiques génériques).
 */
const partenaires = [
  'Sanitaire Pro',
  'AquaSud',
  'ThermoTech',
  'Hydro 974',
  'CuivrEx',
  'BatimatSud',
  'PVC Réunion',
  'Conduit+',
];
---

<section class="relative bg-bp-ciment py-16 md:py-20 px-6 md:px-10">
  <div class="max-w-content mx-auto">
    <p class="scroll-reveal text-center text-[11px] sm:text-xs font-archivo font-bold uppercase tracking-[0.32em] text-bp-anthracite/55">
      Fournisseurs & partenaires de confiance
    </p>

    <ul class="scroll-reveal mt-10 grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-x-6 gap-y-8 items-center">
      {partenaires.map((p, i) => (
        <li class="text-center" style={`transition-delay: ${i * 40}ms`}>
          <span class="block font-bebas uppercase text-bp-anthracite/35 hover:text-bp-anthracite/80 transition-colors tracking-wide" style="font-size: clamp(16px, 1.6vw, 22px);">
            {p}
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
