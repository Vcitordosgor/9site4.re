---
/**
 * PressionSignature — moment signature plomberie.
 * Une jauge de pression (manomètre) SVG dont l'aiguille balaie
 * de la zone rouge (panne) à la zone verte (réparé) au scroll-into-view.
 * Trois LEDs s'allument en cascade : Détection → Diagnostic → Réparation.
 *
 * Pure CSS + IntersectionObserver. Respecte prefers-reduced-motion.
 */
---

<section
  id="pression"
  class="bp-pression relative bg-bp-anthracite text-bp-blanc py-20 md:py-28 px-6 md:px-10 overflow-hidden border-y-4 border-bp-jaune"
>
  <div class="pointer-events-none absolute inset-0 opacity-[0.05]" aria-hidden="true"
       style="background-image: radial-gradient(circle, rgb(255 199 44) 1px, transparent 1px); background-size: 16px 16px;"></div>

  <div class="relative max-w-content mx-auto grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">

    <figure class="lg:col-span-5 flex justify-center lg:justify-start">
      <svg
        class="bp-gauge w-[260px] h-[260px] sm:w-[320px] sm:h-[320px]"
        viewBox="0 0 200 200"
        role="img"
        aria-label="Manomètre indiquant la pression remontée à 3 bar après intervention"
      >
        <circle cx="100" cy="100" r="96" fill="rgb(232 230 225)" stroke="rgb(255 199 44)" stroke-width="3"/>
        <circle cx="100" cy="100" r="88" fill="rgb(26 29 36)"/>

        <path d="M 32 134 A 70 70 0 0 1 47 71" fill="none" stroke="#e8463c" stroke-width="10" stroke-linecap="butt"/>
        <path d="M 47 71 A 70 70 0 0 1 100 30" fill="none" stroke="rgb(255 199 44)" stroke-width="10" stroke-linecap="butt"/>
        <path d="M 100 30 A 70 70 0 0 1 168 134" fill="none" stroke="#2ea84a" stroke-width="10" stroke-linecap="butt"/>

        <g stroke="rgb(232 230 225)" stroke-width="1.5" opacity="0.85">
          <line x1="100" y1="42" x2="100" y2="50"/>
          <line x1="58" y1="58" x2="63" y2="64"/>
          <line x1="142" y1="58" x2="137" y2="64"/>
          <line x1="42" y1="100" x2="50" y2="100"/>
          <line x1="158" y1="100" x2="150" y2="100"/>
          <line x1="55" y1="140" x2="60" y2="135"/>
          <line x1="145" y1="140" x2="140" y2="135"/>
        </g>

        <g fill="rgb(232 230 225)" font-family="Bebas Neue, sans-serif" font-size="11" text-anchor="middle">
          <text x="36" y="142">0</text>
          <text x="51" y="68">1</text>
          <text x="100" y="28">2</text>
          <text x="149" y="68">3</text>
          <text x="164" y="142">3.5</text>
        </g>

        <text x="100" y="155" fill="rgb(255 199 44)" font-family="Bebas Neue, sans-serif" font-size="14" text-anchor="middle" letter-spacing="2">BAR</text>

        <g class="bp-gauge-needle" style="transform-origin: 100px 100px;">
          <line x1="100" y1="100" x2="100" y2="46" stroke="rgb(255 199 44)" stroke-width="3" stroke-linecap="round"/>
          <line x1="100" y1="100" x2="100" y2="115" stroke="rgb(255 199 44)" stroke-width="3" stroke-linecap="round"/>
        </g>

        <circle cx="100" cy="100" r="8" fill="rgb(26 29 36)" stroke="rgb(255 199 44)" stroke-width="2"/>
        <circle cx="100" cy="100" r="3" fill="rgb(255 199 44)"/>

        <ellipse cx="80" cy="70" rx="40" ry="14" fill="rgb(255 255 255)" opacity="0.06"/>
      </svg>
    </figure>

    <div class="lg:col-span-7">
      <p class="scroll-reveal inline-flex items-center gap-3 text-[11px] sm:text-xs font-archivo font-bold uppercase tracking-[0.32em] text-bp-jaune">
        <span class="block w-8 h-[3px] bg-bp-jaune" aria-hidden="true"></span>
        <span>La signature Bernard</span>
      </p>

      <h2 class="scroll-reveal mt-5 font-bebas uppercase text-bp-blanc leading-[0.92] tracking-tight" style="font-size: clamp(40px, 6vw, 84px);">
        De la zone rouge<br/>
        <span class="text-bp-jaune">à la zone verte.</span>
      </h2>

      <p class="scroll-reveal mt-6 max-w-xl font-archivo text-bp-blanc/80 leading-[1.7]" style="font-size: 16px;">
        Avant de partir, Bernard remet toujours la pression à <strong class="text-bp-jaune font-bold">3 bar</strong>
        et vous montre l'aiguille. Si elle bouge, il revient. Pas de devinette,
        pas de doute&nbsp;: le manomètre tranche.
      </p>

      <ul class="bp-leds mt-10 grid sm:grid-cols-3 gap-4 sm:gap-6">
        <li class="bp-led flex items-start gap-3" data-step="1">
          <span class="bp-dot relative flex-shrink-0 mt-1 inline-flex items-center justify-center w-4 h-4 rounded-full bg-bp-blanc/15 border border-bp-blanc/25" aria-hidden="true">
            <span class="bp-dot-core absolute inset-[3px] rounded-full"></span>
          </span>
          <div>
            <p class="font-bebas text-bp-blanc tracking-wide leading-none" style="font-size: 22px;">Détection</p>
            <p class="mt-1.5 font-archivo text-bp-blanc/65 text-sm leading-snug">Lecture instantanée de la chute de pression.</p>
          </div>
        </li>
        <li class="bp-led flex items-start gap-3" data-step="2">
          <span class="bp-dot relative flex-shrink-0 mt-1 inline-flex items-center justify-center w-4 h-4 rounded-full bg-bp-blanc/15 border border-bp-blanc/25" aria-hidden="true">
            <span class="bp-dot-core absolute inset-[3px] rounded-full"></span>
          </span>
          <div>
            <p class="font-bebas text-bp-blanc tracking-wide leading-none" style="font-size: 22px;">Diagnostic</p>
            <p class="mt-1.5 font-archivo text-bp-blanc/65 text-sm leading-snug">Localisation de la fuite, expliquée devant vous.</p>
          </div>
        </li>
        <li class="bp-led flex items-start gap-3" data-step="3">
          <span class="bp-dot relative flex-shrink-0 mt-1 inline-flex items-center justify-center w-4 h-4 rounded-full bg-bp-blanc/15 border border-bp-blanc/25" aria-hidden="true">
            <span class="bp-dot-core absolute inset-[3px] rounded-full"></span>
          </span>
          <div>
            <p class="font-bebas text-bp-blanc tracking-wide leading-none" style="font-size: 22px;">Réparation</p>
            <p class="mt-1.5 font-archivo text-bp-blanc/65 text-sm leading-snug">Mise en eau, contrôle, pression stable à 3&nbsp;bar.</p>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .bp-gauge-needle {
    transform: rotate(-135deg);
    transition: transform 2200ms cubic-bezier(0.34, 1.16, 0.64, 1);
  }
  .bp-pression.is-running .bp-gauge-needle {
    transform: rotate(90deg);
  }

  .bp-led .bp-dot-core {
    background: transparent;
    transition: background-color 350ms ease, box-shadow 350ms ease;
  }
  .bp-pression.is-running .bp-led[data-step="1"] .bp-dot-core {
    background: rgb(255 199 44);
    box-shadow: 0 0 0 3px rgb(255 199 44 / 0.18);
    transition-delay: 600ms;
  }
  .bp-pression.is-running .bp-led[data-step="2"] .bp-dot-core {
    background: rgb(255 199 44);
    box-shadow: 0 0 0 3px rgb(255 199 44 / 0.18);
    transition-delay: 1200ms;
  }
  .bp-pression.is-running .bp-led[data-step="3"] .bp-dot-core {
    background: #2ea84a;
    box-shadow: 0 0 0 3px rgb(46 168 74 / 0.22);
    transition-delay: 1900ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .bp-gauge-needle { transition: none !important; transform: rotate(90deg) !important; }
    .bp-led .bp-dot-core {
      transition: none !important;
      background: rgb(255 199 44) !important;
    }
    .bp-pression .bp-led[data-step="3"] .bp-dot-core {
      background: #2ea84a !important;
    }
  }
</style>

<script>
  const section = document.getElementById('pression');
  if (section && 'IntersectionObserver' in window) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) {
      section.classList.add('is-running');
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              section.classList.add('is-running');
            } else {
              section.classList.remove('is-running');
            }
          });
        },
        { threshold: 0.35 }
      );
      io.observe(section);
    }
  }
</script>
