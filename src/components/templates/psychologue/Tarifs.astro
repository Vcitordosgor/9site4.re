---
/**
 * Tarifs — tableau ligne par ligne sobre + note mutuelles.
 * Format honoraires éthique : durée + prix tabulaire.
 */
import data from '../../../data/templates/aubry.json';
---

<section id="tarifs" class="bg-aubry-papier py-24 md:py-36 px-6 md:px-10">
  <div class="max-w-3xl mx-auto">

    <header class="mb-14 md:mb-16">
      <p class="font-plex-mono text-[10px] uppercase tracking-[0.32em] text-aubry-prune mb-5">
        Chapitre IV — Modalités
      </p>
      <h2 class="font-caslon text-aubry-encre leading-[1.05]" style="font-size: clamp(36px, 5vw, 60px);">
        Honoraires<span class="italic text-aubry-prune"> & remboursement.</span>
      </h2>
    </header>

    <!-- Modalité : cabinet vs visio (pastilles tarif) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
      <article class="border border-aubry-encre/20 p-5 md:p-6 bg-white/40">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-aubry-prune" aria-hidden="true">
            <path d="M3 9.5 12 3l9 6.5"/><path d="M5 9v11h14V9"/><path d="M10 20v-6h4v6"/>
          </svg>
          <p class="font-plex-mono text-[10px] uppercase tracking-[0.28em] text-aubry-prune">Au cabinet</p>
        </div>
        <p class="mt-3 font-caslon text-aubry-encre text-2xl md:text-3xl tabular-nums">75€ <span class="text-base text-aubry-encre/60 italic">/ 50 min</span></p>
        <p class="mt-2 font-caslon italic text-aubry-encre/70 text-sm leading-relaxed">
          Tarif de référence — pour le suivi régulier en présentiel.
        </p>
      </article>
      <article class="border border-aubry-encre/20 p-5 md:p-6 bg-white/40">
        <div class="flex items-center gap-2">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-aubry-prune" aria-hidden="true">
            <rect x="3" y="6" width="14" height="12" rx="1"/><path d="m17 10 4-2v8l-4-2"/>
          </svg>
          <p class="font-plex-mono text-[10px] uppercase tracking-[0.28em] text-aubry-prune">En visio</p>
        </div>
        <p class="mt-3 font-caslon text-aubry-encre text-2xl md:text-3xl tabular-nums">65€ <span class="text-base text-aubry-encre/60 italic">/ 50 min</span></p>
        <p class="mt-2 font-caslon italic text-aubry-encre/70 text-sm leading-relaxed">
          Pour les suivis à distance — lien sécurisé envoyé avant la séance.
        </p>
      </article>
    </div>

    <!-- Tableau honoraires -->
    <div class="border-t-2 border-aubry-encre">
      {data.tarifs.map((t) => (
        <div class="grid grid-cols-12 gap-4 py-5 items-baseline border-b border-aubry-encre/15">
          <div class="col-span-7 sm:col-span-7">
            <p class="font-caslon text-aubry-encre text-lg md:text-xl">{t.label}</p>
          </div>
          <div class="col-span-3 sm:col-span-3">
            <p class="font-plex-mono text-[11px] uppercase tracking-[0.22em] text-aubry-prune tabular-nums">
              {t.duree}
            </p>
          </div>
          <div class="col-span-2 text-right">
            <p class="font-caslon text-aubry-encre text-xl md:text-2xl tabular-nums">{t.prix}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Note mutuelles dans encart prune subtil -->
    <div class="mt-12 p-6 md:p-8 bg-aubry-prune/8 border-l-2 border-aubry-prune">
      <p class="font-plex-mono text-[10px] uppercase tracking-[0.28em] text-aubry-prune mb-3">
        Note sur le remboursement
      </p>
      <p class="font-caslon text-aubry-encre/85 text-base md:text-lg leading-[1.8]">
        {data.noteTarif}
      </p>
    </div>
  </div>
</section>
