---
/**
 * PhotoCabinet — section visuelle full-bleed cabinet et ouvrages.
 */
---

<section class="bg-aubry-perle">
  <figure class="relative aspect-[21/9] overflow-hidden bg-aubry-encre">
    <img
      src="https://images.unsplash.com/photo-1507842217343-583bb7270b66?w=1800&q=85"
      alt="Étagère d'ouvrages dans un cabinet calme"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-aubry-encre/55 via-aubry-encre/20 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-12 left-6 md:left-12 right-6 md:right-12 max-w-2xl">
      <p class="font-plex-mono text-[10px] uppercase tracking-[0.32em] text-aubry-rose mb-2">
        — Le cabinet
      </p>
      <p class="font-caslon italic text-aubry-perle leading-[1.15]" style="font-size: clamp(22px, 3vw, 38px);">
        Un lieu, un silence, et le temps qu'il faut.
      </p>
    </figcaption>
  </figure>
</section>
