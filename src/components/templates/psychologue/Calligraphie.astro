---
import '@fontsource/pinyon-script/latin-400.css';
---

<section class="bg-aubry-perle py-28 md:py-40 px-6 md:px-10 relative overflow-hidden">

  <div class="absolute inset-x-12 inset-y-10 border border-aubry-rose/30 pointer-events-none" aria-hidden="true"></div>
  <div class="absolute inset-x-14 inset-y-12 border border-aubry-rose/20 pointer-events-none" aria-hidden="true"></div>

  <div class="max-w-content mx-auto relative text-center">

    <p class="font-ibm-plex-mono text-[10px] uppercase tracking-[0.32em] text-aubry-prune mb-10">
      — Une phrase, lue souvent —
    </p>

    <p class="text-aubry-nuit leading-[1.05]" style="font-family: 'Pinyon Script', cursive; font-size: clamp(64px, 12vw, 180px);">
      Prendre soin
    </p>
    <p class="mt-4 text-aubry-prune leading-[1.05]" style="font-family: 'Pinyon Script', cursive; font-size: clamp(64px, 12vw, 180px);">
      de ses propres pensées.
    </p>

    <div class="mt-12 flex items-center justify-center gap-3">
      <span class="block w-12 h-px bg-aubry-rose"></span>
      <span class="font-libre-caslon italic text-aubry-prune text-base md:text-lg">
        ∼ Marc Aurèle, libre adaptation ∼
      </span>
      <span class="block w-12 h-px bg-aubry-rose"></span>
    </div>
  </div>
</section>
