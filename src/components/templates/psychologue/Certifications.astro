---
import data from '../../../data/templates/aubry.json';
---

<section class="bg-aubry-perle py-20 md:py-28 px-6 md:px-10 border-y border-aubry-encre/10">
  <div class="max-w-content mx-auto">

    <header class="text-center mb-12 max-w-2xl mx-auto">
      <p class="font-ibm-plex-mono text-[10px] uppercase tracking-[0.32em] text-aubry-prune mb-3">
        — Carnet de pratique —
      </p>
      <h2 class="font-libre-caslon italic text-aubry-nuit text-2xl md:text-3xl leading-tight">
        Diplômes & inscriptions.
      </h2>
    </header>

    <ul class="max-w-3xl mx-auto space-y-3">
      {data.diplomes.map((d, i) => (
        <li class="flex gap-5 md:gap-6 bg-aubry-blanc/70 border border-aubry-encre/10 px-5 md:px-6 py-4 md:py-5 hover:border-aubry-prune transition-colors items-start">
          <span class="font-libre-caslon italic text-aubry-prune text-2xl md:text-3xl leading-none shrink-0 mt-1 tabular-nums">
            §{i + 1}
          </span>
          <p class="flex-1 font-libre-caslon text-aubry-encre text-[15px] md:text-base leading-[1.7]">
            {d}
          </p>
          <svg viewBox="0 0 32 32" class="w-7 h-7 md:w-8 md:h-8 text-aubry-rose shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <circle cx="16" cy="14" r="8"/>
            <path d="M12 22 L10 30 L16 26 L22 30 L20 22"/>
          </svg>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-center font-ibm-plex-mono text-[10px] uppercase tracking-[0.24em] text-aubry-prune">
      N° ADELI {data.info.adeli} · {data.info.ville}
    </p>
  </div>
</section>
