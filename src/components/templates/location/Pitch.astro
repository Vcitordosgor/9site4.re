---
/**
 * Pitch (Vivre ici) — 4 ambiances : matin / midi / soir / nuit.
 */
import data from '../../../data/templates/lazuli.json';
const moments = [
  { id: 'matin', heure: '07h', titre: 'Le matin', desc: 'Café sur la terrasse, le lagon encore désert, les sternes en vol bas.', icon: 'sun-rise', photo: '/images/location/extra-2.webp' },
  { id: 'midi',  heure: '13h', titre: 'Le midi',  desc: 'Piscine, transats, brumisateur. Les enfants ne veulent plus en sortir.', icon: 'sun', photo: '/images/location/extra-6.webp' },
  { id: 'soir',  heure: '19h', titre: 'L\'apéro', desc: 'Coucher de soleil orange sur l\'océan, rhum arrangé et samoussas tièdes.', icon: 'cocktail', photo: '/images/location/extra-4.webp' },
  { id: 'nuit',  heure: '22h', titre: 'La nuit',  desc: 'Le bruit des vagues plus loin, la voie lactée au-dessus. Aucune lumière parasite.', icon: 'moon', photo: '/images/location/extra-3.webp' },
];
---
<section id="vivre" class="relative bg-lazuli-casse text-lazuli-marine py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 md:mb-20 max-w-3xl">
      <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-terracotta mb-4">§ Vivre ici</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px, 8vw, 116px);">
        Quatre lumières,<br/>une même villa.
      </h2>
      <p class="mt-6 font-geist text-lazuli-marine/70 max-w-2xl leading-relaxed">
        {data.pitch[0]}
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-lazuli-sable/40">
      {moments.map(m => (
        <article class="bg-lazuli-casse group">
          <div class="relative aspect-[4/5] overflow-hidden">
            <img src={m.photo} alt="" class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" decoding="async" />
            <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 40%, rgba(15,76,117,0.85) 100%);"></div>
            <span class="absolute top-5 left-5 font-cormorant italic text-white text-3xl">{m.heure}</span>
            <div class="absolute bottom-5 left-5 right-5 text-white">
              <h3 class="font-cormorant italic text-3xl leading-tight">{m.titre}</h3>
              <p class="mt-2 font-geist text-sm text-white/85 leading-snug">{m.desc}</p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
