---
const mots = ['Lagon', 'Soleil', 'Silence'];
---
<section class="relative bg-lazuli-casse text-lazuli-marine py-20 md:py-28 overflow-hidden">
  <div class="space-y-2">
    {mots.map((m, i) => (
      <div class="overflow-hidden">
        <p
          class={`font-cormorant italic leading-[0.95] whitespace-nowrap px-6 md:px-12 ${i % 2 === 1 ? 'text-right' : 'text-left'}`}
          style={`font-size: clamp(72px,13vw,200px); color: ${i === 1 ? '#A85B3F' : i === 2 ? '#3A7188' : '#1B2D3A'};`}
        >
          {m}<span class="text-lazuli-sable ml-4">·</span>
        </p>
      </div>
    ))}
  </div>
</section>
