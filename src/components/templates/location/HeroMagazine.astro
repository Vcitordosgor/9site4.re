---
/**
 * HeroMagazine — full-bleed extra-1 + overlay + titre italique géant bas-gauche.
 */
import data from '../../../data/templates/lazuli.json';
---
<section id="top" class="relative min-h-[100svh] overflow-hidden bg-lazuli-marine text-white">
  <!-- Photo full-bleed -->
  <div class="absolute inset-0" aria-hidden="true">
    <img src={data.info.photoHero} alt={data.info.photoHeroAlt} class="w-full h-full object-cover" width="1600" height="900" loading="eager" fetchpriority="high" decoding="async" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(15,76,117,0.25) 0%, rgba(15,76,117,0.10) 35%, rgba(27,45,58,0.85) 100%);"></div>
    <div class="absolute inset-0" style="background: linear-gradient(90deg, rgba(27,45,58,0.55) 0%, transparent 45%);"></div>
  </div>

  <!-- Top : wordmark editorial -->
  <div class="relative max-w-content mx-auto px-6 md:px-12 pt-32 md:pt-36">
    <div class="flex items-center gap-5 text-lazuli-sable font-geist text-[11px] uppercase tracking-[0.45em]">
      <span class="block w-12 h-px bg-lazuli-sable/60"></span>
      <span>Saison {new Date().getFullYear()} · {data.info.ville}</span>
    </div>
  </div>

  <!-- Bottom-left : titre + sous-titre -->
  <div class="relative max-w-content mx-auto px-6 md:px-12 pb-16 md:pb-24 mt-auto">
    <div class="min-h-[58svh] flex flex-col justify-end">
      <p class="font-geist text-lazuli-sable text-sm md:text-base mb-3 uppercase tracking-[0.4em]">— Bord de mer —</p>
      <h1 class="font-cormorant italic text-white leading-[0.92] tracking-tight" style="font-size: clamp(72px, 13vw, 200px);">
        Villa<br/><em>Lazuli.</em>
      </h1>
      <div class="mt-8 max-w-xl flex flex-col gap-5">
        <p class="font-cormorant italic text-lazuli-sable text-2xl md:text-3xl leading-snug">
          « {data.info.tagline} »
        </p>
        <p class="font-geist text-white/80 leading-relaxed text-base md:text-lg max-w-md">
          {data.info.hotes} — vos hôtes, à 200 m de la villa. Présents si vous le souhaitez, discrets si vous préférez.
        </p>
        <div class="flex flex-wrap items-center gap-3 mt-2">
          <a href="#reservation" class="inline-flex items-center gap-3 h-12 px-7 bg-lazuli-terracotta text-white rounded-full font-geist text-sm tracking-wider hover:bg-lazuli-lagon transition-colors">
            Réserver mon séjour <span aria-hidden="true">→</span>
          </a>
          <a href="#galerie" class="inline-flex items-center gap-3 h-12 px-6 ring-1 ring-white/40 text-white rounded-full font-geist text-xs uppercase tracking-[0.25em] hover:bg-white/10 transition-colors">
            Voir la villa
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- SIGNATURE : vague océan stylisée qui ondule en bas du hero -->
  <svg class="lazuli-wave absolute bottom-0 inset-x-0 w-full h-24 md:h-32 pointer-events-none" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <linearGradient id="lazuli-wave-grad" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0%" stop-color="#E8C9A5" stop-opacity="0"/>
        <stop offset="100%" stop-color="#E8C9A5" stop-opacity="0.55"/>
      </linearGradient>
    </defs>
    <path class="lazuli-wave-path lazuli-wave-back" fill="url(#lazuli-wave-grad)" d="M0,60 C240,100 480,20 720,55 C960,90 1200,40 1440,70 L1440,120 L0,120 Z"/>
    <path class="lazuli-wave-path lazuli-wave-front" fill="rgba(232,201,165,0.35)" d="M0,80 C220,40 460,110 720,75 C980,40 1220,100 1440,70 L1440,120 L0,120 Z"/>
  </svg>

  <!-- SIGNATURE : indicateur d'heure dorée -->
  <div class="hidden md:flex absolute top-32 right-12 items-center gap-2 px-3 py-1.5 rounded-full bg-white/10 backdrop-blur-sm ring-1 ring-white/20" aria-hidden="true">
    <span class="block w-2 h-2 rounded-full lazuli-sun"></span>
    <span class="font-geist text-[10px] uppercase tracking-[0.32em] text-lazuli-sable" id="lazuli-hour-label">Golden hour</span>
  </div>

  <!-- Stats coin bas-droit -->
  <div class="absolute bottom-12 right-6 md:right-12 hidden md:flex flex-col items-end gap-3 text-right">
    {data.stats.slice(0,3).map(s => (
      <div class="text-white">
        <p class="font-cormorant italic leading-none" style="font-size: clamp(40px,4.5vw,72px);">{s.valeur}</p>
        <p class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">{s.label}</p>
      </div>
    ))}
  </div>

  <style>
    .lazuli-wave-path { will-change: transform; transform-origin: center; }
    .lazuli-wave-back { animation: lazuli-wave-roll 11s ease-in-out infinite; }
    .lazuli-wave-front { animation: lazuli-wave-roll 7s ease-in-out infinite reverse; }
    @keyframes lazuli-wave-roll {
      0%, 100% { transform: translateX(0) translateY(0); }
      50%      { transform: translateX(-14px) translateY(3px); }
    }
    .lazuli-sun {
      background: radial-gradient(circle, #FFD79A 0%, #E8A05C 70%);
      box-shadow: 0 0 12px rgba(255,179,90,0.85);
      animation: lazuli-sun-pulse 4s ease-in-out infinite;
    }
    @keyframes lazuli-sun-pulse {
      0%, 100% { transform: scale(1); opacity: 0.8; }
      50%      { transform: scale(1.25); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .lazuli-wave-back, .lazuli-wave-front, .lazuli-sun { animation: none; }
    }
  </style>
</section>
