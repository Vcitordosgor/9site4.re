---
import data from '../../../data/templates/lazuli.json';
---

<section class="bg-lazuli-marine text-lazuli-casse py-28 md:py-44 px-6 md:px-10 relative overflow-hidden">
  <span aria-hidden="true" class="absolute -top-12 -right-6 font-italianno text-lazuli-terracotta/20 leading-none select-none" style="font-size: clamp(240px, 40vw, 560px);">
    Lazuli
  </span>

  <div class="relative max-w-4xl mx-auto">
    <p class="font-geist text-[10.5px] uppercase tracking-[0.32em] text-lazuli-coco mb-6 font-medium">
      — Mot des hôtes
    </p>
    <span aria-hidden="true" class="block font-italianno text-lazuli-terracotta leading-none mb-2 select-none" style="font-size: clamp(120px, 18vw, 240px);">
      &ldquo;
    </span>
    <blockquote class="font-yeseva text-lazuli-casse leading-[1.15]" style="font-size: clamp(32px, 4.6vw, 56px);">
      Une maison qu'on prête, ce n'est pas un produit qu'on loue — c'est un lieu qu'on partage, avec ses <span class="text-lazuli-terracotta italic font-normal">silences</span> et son lagon.
    </blockquote>
    <footer class="mt-12 flex items-baseline gap-4">
      <span class="block w-12 h-px bg-lazuli-terracotta" aria-hidden="true"></span>
      <div>
        <p class="font-italianno text-lazuli-coco text-3xl leading-none">
          {data.info.hotes}
        </p>
        <p class="font-geist text-[10.5px] uppercase tracking-[0.32em] text-lazuli-sable mt-2">
          Hôtes · {data.info.wordmark}
        </p>
      </div>
    </footer>
  </div>
</section>
