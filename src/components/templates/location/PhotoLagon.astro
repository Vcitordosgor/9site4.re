---
import data from '../../../data/templates/lazuli.json';
---
<section class="relative">
  <div class="relative h-[60svh] md:h-[80svh] overflow-hidden">
    <img src={data.info.photoSticker} alt={data.info.photoStickerAlt} class="absolute inset-0 w-full h-full object-cover" loading="lazy" decoding="async" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, transparent 40%, rgba(15,76,117,0.65) 100%);"></div>
    <div class="absolute bottom-12 left-6 md:left-12 right-6 md:right-12 text-white">
      <p class="font-geist text-[10px] uppercase tracking-[0.4em] text-lazuli-sable mb-3">— Le lagon —</p>
      <p class="font-cormorant italic leading-[0.95]" style="font-size: clamp(48px,8vw,116px);">À 3 minutes,<br/>en sandales.</p>
    </div>
  </div>
</section>
