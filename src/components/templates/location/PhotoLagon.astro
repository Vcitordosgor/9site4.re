---
/**
 * PhotoLagon — section visuelle full-bleed lagon panoramique.
 */
---

<section class="bg-lazuli-casse">
  <figure class="relative aspect-[21/9] overflow-hidden bg-lazuli-marine">
    <img
      src="/images/location/extra-4.webp"
      alt="Lagon turquoise vu depuis la plage, palmiers en premier plan"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-lazuli-marine/55 via-lazuli-marine/10 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-12 left-6 md:left-12 right-6 md:right-12 max-w-2xl">
      <p class="font-geist text-[10.5px] uppercase tracking-[0.32em] text-lazuli-sable mb-2 font-medium">
        — Vue depuis la villa
      </p>
      <p class="font-italianno text-lazuli-coco mb-1 leading-none" style="font-size: clamp(40px, 6vw, 84px);">
        depuis la terrasse,
      </p>
      <p class="font-yeseva text-lazuli-casse leading-[1.05]" style="font-size: clamp(24px, 3.4vw, 42px);">
        le lagon commence à dix pas.
      </p>
    </figcaption>
  </figure>
</section>
