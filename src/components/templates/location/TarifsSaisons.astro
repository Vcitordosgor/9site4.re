---
import data from '../../../data/templates/lazuli.json';
const mois = ['J','F','M','A','M','J','J','A','S','O','N','D'];
const couleurs = {
  basse:   '#CDDDB1', moyenne: '#E6CC8A', haute: '#E47465', tres:   '#A85B3F'
};
const carteAnnuelle = [
  'basse','moyenne','moyenne','basse','basse','basse','haute','haute','basse','basse','moyenne','tres'
];
---
<section id="tarifs" class="relative bg-lazuli-marine text-lazuli-casse py-24 md:py-32 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 max-w-3xl">
      <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-sable mb-4">§ Tarifs</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px,7vw,96px);">
        Quatre saisons,<br/>quatre tarifs clairs.
      </h2>
    </div>

    <!-- Bandeau année visuelle 12 mois -->
    <div class="mb-12 ring-1 ring-lazuli-sable/30 p-4 md:p-6">
      <div class="grid grid-cols-12 gap-1">
        {mois.map((m, i) => {
          const c = couleurs[carteAnnuelle[i]];
          return (
            <div class="flex flex-col items-center gap-2">
              <span class="w-full h-8 md:h-10" style={`background:${c}`}></span>
              <span class="font-geist text-[10px] uppercase tracking-[0.2em] text-lazuli-sable">{m}</span>
            </div>
          );
        })}
      </div>
      <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-2 font-geist text-xs text-white/75">
        {Object.entries(couleurs).map(([k,v]) => (
          <li class="flex items-center gap-2"><span class="w-3 h-3" style={`background:${v}`}></span><span class="capitalize">{k} saison</span></li>
        ))}
      </ul>
    </div>

    <!-- 4 cartes tarifs -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px bg-lazuli-sable/30">
      {data.tarifs.map(t => (
        <article class={`relative p-7 md:p-8 flex flex-col ${t.populaire ? 'bg-lazuli-terracotta text-white' : 'bg-lazuli-marine'}`}>
          {t.populaire && <span class="absolute -top-2 left-6 px-3 py-1 bg-lazuli-casse text-lazuli-marine font-geist text-[10px] uppercase tracking-[0.3em]">le plus pris</span>}
          <p class="font-cormorant italic text-2xl mb-1">{t.saison}</p>
          <p class="font-geist text-xs uppercase tracking-[0.2em] opacity-65 mb-5">{t.periode}</p>
          <p class="font-cormorant leading-none" style="font-size: clamp(56px,6vw,84px);">{t.prix}<span class="font-geist italic text-base ml-1 opacity-70">/nuit</span></p>
          <p class="mt-3 font-geist text-xs italic opacity-75">Séjour minimum : {t.minimum}.</p>
        </article>
      ))}
    </div>
    <p class="mt-6 font-geist text-xs text-white/55 italic max-w-2xl">{data.tarifsExtras} Caution : {data.caution}</p>
  </div>
</section>
