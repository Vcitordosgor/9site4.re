---
import data from '../../../data/templates/lazuli.json';
const cats = [
  { key: 'interieur', label: 'Intérieur' },
  { key: 'exterieur', label: 'Extérieur' },
  { key: 'services',  label: 'Services' },
] as const;
---
<section class="relative bg-lazuli-casse text-lazuli-marine py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 max-w-3xl">
      <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-terracotta mb-4">§ Équipements</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px,7vw,96px);">
        Tout est prévu,<br/>rien n'est laissé au hasard.
      </h2>
    </div>
    <div class="grid lg:grid-cols-3 gap-px bg-lazuli-sable/30">
      {cats.map(c => (
        <div class="bg-lazuli-casse p-8 md:p-10">
          <p class="font-cormorant italic text-3xl text-lazuli-lagon mb-6">{c.label}</p>
          <ul class="space-y-3 font-geist text-sm md:text-base">
            {data.equipements[c.key].map(e => (
              <li class="flex gap-3 items-start">
                <svg class="w-4 h-4 mt-1 text-lazuli-terracotta shrink-0" viewBox="0 0 16 16" fill="none"><path d="M3 8l3.5 3.5L13 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                <span>{e}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
