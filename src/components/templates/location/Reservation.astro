---
import data from '../../../data/templates/lazuli.json';
---
<section id="reservation" class="relative bg-lazuli-marine text-white py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 50% 60% at 80% 30%, rgba(168,91,63,0.30), transparent 60%);"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-12">
    <div class="mb-12 max-w-3xl">
      <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-sable mb-4">§ Demande de réservation</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px,8vw,116px);">
        On commence<br/>par les dates.
      </h2>
    </div>

    <form class="max-w-3xl ring-1 ring-lazuli-sable/30 bg-lazuli-marine/60 p-8 md:p-12" onsubmit="event.preventDefault();" novalidate>
      <div class="grid sm:grid-cols-2 gap-5">
        <label class="block">
          <span class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">Arrivée</span>
          <input type="date" name="arrivee" class="mt-2 w-full h-12 px-4 bg-white/10 ring-1 ring-white/20 font-geist text-white" />
        </label>
        <label class="block">
          <span class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">Départ</span>
          <input type="date" name="depart" class="mt-2 w-full h-12 px-4 bg-white/10 ring-1 ring-white/20 font-geist text-white" />
        </label>
        <label class="block">
          <span class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">Voyageurs</span>
          <select name="voyageurs" class="mt-2 w-full h-12 px-4 bg-white/10 ring-1 ring-white/20 font-geist text-white">
            <option>1</option><option>2</option><option>3</option><option>4</option><option>5</option><option>6</option><option>7</option><option>8</option>
          </select>
        </label>
        <label class="block">
          <span class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">Saison estimée</span>
          <select name="saison" class="mt-2 w-full h-12 px-4 bg-white/10 ring-1 ring-white/20 font-geist text-white">
            <option>Basse — 180 €/nuit</option>
            <option>Moyenne — 220 €/nuit</option>
            <option>Haute — 320 €/nuit</option>
            <option>Très haute — 450 €/nuit</option>
          </select>
        </label>
        <label class="block sm:col-span-2">
          <span class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">Votre nom & email</span>
          <input type="text" name="contact" placeholder="Prénom Nom · email" class="mt-2 w-full h-12 px-4 bg-white/10 ring-1 ring-white/20 font-geist text-white placeholder:text-white/40" />
        </label>
        <label class="block sm:col-span-2">
          <span class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable">Un mot pour {data.info.hotes.split(' & ')[0]}</span>
          <textarea name="message" rows="4" class="mt-2 w-full px-4 py-3 bg-white/10 ring-1 ring-white/20 font-geist text-white placeholder:text-white/40" placeholder="Famille, occasion, demandes particulières…"></textarea>
        </label>
      </div>
      <button type="submit" class="mt-8 w-full h-14 bg-lazuli-terracotta text-white font-geist text-sm uppercase tracking-[0.3em] hover:bg-lazuli-sable hover:text-lazuli-marine transition-colors">
        Envoyer ma demande de réservation
      </button>
      <p class="mt-4 text-center font-geist text-xs text-white/55 italic">Réponse sous 24h. Démonstration — formulaire non fonctionnel.</p>
    </form>
  </div>
</section>
