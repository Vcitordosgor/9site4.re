---
import data from '../../../data/templates/lazuli.json';
---
<section class="relative bg-lazuli-terracotta text-white py-16 md:py-24">
  <div class="max-w-content mx-auto px-6 md:px-12 grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-px">
    {data.stats.map((s, i) => (
      <div class={`px-2 md:px-8 py-4 ${i > 0 ? 'md:border-l border-white/25' : ''}`}>
        <p class="font-cormorant leading-none" style="font-size: clamp(64px,8vw,112px);">{s.valeur}</p>
        <p class="mt-2 font-geist text-[10px] uppercase tracking-[0.35em] text-white/85">{s.label}</p>
      </div>
    ))}
  </div>
</section>
