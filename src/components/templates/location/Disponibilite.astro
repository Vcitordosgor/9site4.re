---
/**
 * Disponibilite — mini calendar 3 mois (Nov/Déc/Jan) avec dates occupées visuelles.
 */
import data from '../../../data/templates/lazuli.json';
const occupSet = new Set(data.occupation);

function buildMonth(year: number, month: number) {
  const first = new Date(year, month, 1);
  const startDay = (first.getDay() + 6) % 7; // lundi=0
  const days: ({n: number; iso: string; busy: boolean} | null)[] = Array(startDay).fill(null);
  const last = new Date(year, month + 1, 0).getDate();
  for (let d = 1; d <= last; d++) {
    const iso = `${year}-${String(month+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    days.push({ n: d, iso, busy: occupSet.has(iso) });
  }
  while (days.length % 7) days.push(null);
  return days;
}
const labels = ['L','M','M','J','V','S','D'];
const mois = [
  { y: 2025, m: 10, label: 'Novembre 2025' },
  { y: 2025, m: 11, label: 'Décembre 2025' },
  { y: 2026, m: 0,  label: 'Janvier 2026' },
];
---
<section class="relative bg-lazuli-casse text-lazuli-marine py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14 flex items-baseline justify-between flex-wrap gap-6">
      <div>
        <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-terracotta mb-4">§ Disponibilités</p>
        <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px,7vw,96px);">
          Les prochains<br/>créneaux.
        </h2>
      </div>
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-geist text-xs">
        <li class="flex items-center gap-2"><span class="w-3 h-3 ring-1 ring-lazuli-marine/30"></span>Libre</li>
        <li class="flex items-center gap-2"><span class="w-3 h-3 bg-lazuli-terracotta"></span>Occupé</li>
      </ul>
    </div>

    <div class="grid md:grid-cols-3 gap-6 md:gap-10">
      {mois.map(M => {
        const days = buildMonth(M.y, M.m);
        return (
          <div class="ring-1 ring-lazuli-sable/40 p-5 bg-white/60">
            <p class="font-cormorant italic text-xl text-lazuli-lagon mb-4">{M.label}</p>
            <div class="grid grid-cols-7 gap-1 mb-2">
              {labels.map(l => <span class="font-geist text-[10px] uppercase tracking-[0.2em] text-lazuli-marine/55 text-center">{l}</span>)}
            </div>
            <div class="grid grid-cols-7 gap-1">
              {days.map(d => d ? (
                <span class={`aspect-square flex items-center justify-center font-geist text-xs ring-1 ring-lazuli-marine/10 ${d.busy ? 'bg-lazuli-terracotta text-white ring-lazuli-terracotta' : 'bg-white text-lazuli-marine'}`}>{d.n}</span>
              ) : <span></span>)}
            </div>
          </div>
        );
      })}
    </div>
    <p class="mt-6 font-geist text-xs text-lazuli-marine/55 italic">Calendrier indicatif. Pour une confirmation officielle, écrivez-nous via le formulaire de réservation.</p>
  </div>
</section>
