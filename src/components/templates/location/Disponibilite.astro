---
/**
 * Disponibilite — mini calendrier 60 jours (2 mois).
 * Affiche les nuits libres / occupées en un coup d'œil.
 */
import data from '../../../data/templates/lazuli.json';
const occupation: string[] = (data as any).occupation ?? [];
const occupiedJson = JSON.stringify(occupation);
---

<section id="disponibilite" class="bg-lazuli-casse py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="max-w-2xl mb-10 md:mb-14">
      <p class="font-geist text-[10px] uppercase tracking-[0.32em] text-lazuli-terracotta font-semibold mb-4">
        ✦ Disponibilité
      </p>
      <h2 class="font-yeseva text-lazuli-marine leading-[1.05]" style="font-size: clamp(32px, 4.5vw, 52px);">
        Les 60 prochains jours,
        <span class="font-italianno text-lazuli-lagon normal-case"> en un coup d'œil.</span>
      </h2>
      <p class="mt-4 font-geist text-lazuli-marine/70">
        Une nuit colorée = villa libre. Grisée = déjà réservée. Pour une demande ferme, descendez jusqu'au formulaire.
      </p>
    </header>

    <!-- Légende -->
    <div class="mb-5 flex flex-wrap items-center gap-x-5 gap-y-2 font-geist text-[11px] uppercase tracking-[0.18em] text-lazuli-marine/70">
      <span class="inline-flex items-center gap-2">
        <span class="block w-3.5 h-3.5 bg-lazuli-lagon/80"></span>
        Disponible
      </span>
      <span class="inline-flex items-center gap-2">
        <span class="block w-3.5 h-3.5 bg-lazuli-marine/20"></span>
        Occupée
      </span>
    </div>

    <div class="grid md:grid-cols-2 gap-6 md:gap-10">
      <div id="ldispo-m1" class="bg-white ring-1 ring-lazuli-marine/10 p-5"></div>
      <div id="ldispo-m2" class="bg-white ring-1 ring-lazuli-marine/10 p-5"></div>
    </div>

    <p class="mt-6 font-italianno text-lazuli-marine/80 text-2xl">
      Une date vous intéresse ? <a href="#reservation" class="underline decoration-lazuli-terracotta decoration-2 underline-offset-4 hover:text-lazuli-terracotta transition-colors">Envoyer une demande →</a>
    </p>
  </div>
</section>

<script define:vars={{ occupiedJson }}>
  const occupied = new Set(JSON.parse(occupiedJson));
  const moisNoms = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
  const joursAbbr = ['L','M','M','J','V','S','D'];
  const pad = (n) => (n < 10 ? '0' + n : '' + n);

  function buildMonth(el, year, month) {
    const first = new Date(year, month, 1);
    const last = new Date(year, month + 1, 0);
    const startDay = (first.getDay() + 6) % 7;
    const daysInMonth = last.getDate();
    const today = new Date(); today.setHours(0,0,0,0);

    let html = `
      <p class="font-yeseva text-lazuli-marine text-lg mb-3">${moisNoms[month]} <span class="font-geist text-sm text-lazuli-marine/55 tabular-nums">${year}</span></p>
      <div class="grid grid-cols-7 gap-1 mb-1.5 font-geist text-[10px] uppercase tracking-wider text-lazuli-marine/55 text-center">
        ${joursAbbr.map((j) => `<span>${j}</span>`).join('')}
      </div>
      <div class="grid grid-cols-7 gap-1">
    `;

    for (let i = 0; i < startDay; i++) html += '<div class="aspect-square"></div>';

    for (let d = 1; d <= daysInMonth; d++) {
      const iso = `${year}-${pad(month + 1)}-${pad(d)}`;
      const dateObj = new Date(year, month, d);
      const isPast = dateObj < today;
      const isOcc = occupied.has(iso);
      let cls = 'aspect-square flex items-center justify-center font-geist text-[11px] tabular-nums';
      if (isPast) cls += ' bg-lazuli-casse text-lazuli-marine/25';
      else if (isOcc) cls += ' bg-lazuli-marine/20 text-lazuli-marine/55';
      else cls += ' bg-lazuli-lagon/80 text-lazuli-marine font-medium';
      html += `<span class="${cls}" aria-label="${d} ${moisNoms[month]} ${year}${isOcc ? ', occupée' : isPast ? ', passée' : ', disponible'}">${d}</span>`;
    }
    html += '</div>';
    el.innerHTML = html;
  }

  const today = new Date();
  const m1 = document.getElementById('ldispo-m1');
  const m2 = document.getElementById('ldispo-m2');
  if (m1) buildMonth(m1, today.getFullYear(), today.getMonth());
  if (m2) {
    const n = new Date(today.getFullYear(), today.getMonth() + 1, 1);
    buildMonth(m2, n.getFullYear(), n.getMonth());
  }
</script>
