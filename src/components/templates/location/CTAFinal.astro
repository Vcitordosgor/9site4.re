---
import data from '../../../data/templates/lazuli.json';
---
<section class="relative bg-lazuli-terracotta text-white py-24 md:py-32 overflow-hidden">
  <div class="absolute inset-0 opacity-25 pointer-events-none" style="background: radial-gradient(ellipse 60% 60% at 20% 50%, #E6CC8A, transparent 70%);"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-12 text-center">
    <p class="font-cormorant italic text-lazuli-sable text-2xl mb-3">— votre prochain séjour —</p>
    <p class="font-cormorant italic leading-[0.95]" style="font-size: clamp(56px,9vw,140px);">
      Et si c'était<br/>vous, l'été prochain ?
    </p>
    <div class="mt-12 flex flex-wrap gap-3 justify-center">
      <a href="#reservation" class="inline-flex items-center gap-3 h-14 px-8 bg-white text-lazuli-terracotta rounded-full font-geist text-sm tracking-wider hover:bg-lazuli-sable transition-colors">Demander une date →</a>
      <a href={`tel:${data.info.telephoneHref}`} class="inline-flex items-center gap-3 h-14 px-8 rounded-full ring-1 ring-white/40 text-white font-geist text-xs uppercase tracking-[0.25em] hover:bg-white/10 transition-colors">Joindre les hôtes</a>
    </div>
  </div>
</section>
