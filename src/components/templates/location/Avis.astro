---
const avis = [
  { profil: "Famille avec 2 enfants", date: "Juillet 2025", note: 5,
    texte: "Vue à couper le souffle, villa très bien équipée. La piscine a fait l'unanimité. Les hôtes très disponibles sans jamais être intrusifs. On reviendra." },
  { profil: "Couple, séjour de noces", date: "Septembre 2025", note: 5,
    texte: "Calme absolu, lever de soleil sur le lagon, jardin clos. Le brumisateur en pleine journée, parfait. Marina nous a recommandé un super traiteur." },
  { profil: "Groupe de 6 amis", date: "Mai 2025", note: 5,
    texte: "Quatre chambres très espacées, on ne s'est jamais marchés dessus. Cuisine équipée pour cuisiner vraiment. Plage à pied en 5 minutes." },
];
---
<section class="relative bg-lazuli-marine text-white py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="mb-14">
      <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-sable mb-4">§ Avis voyageurs</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight" style="font-size: clamp(48px,7vw,96px);">
        Ce qu'ils en disent.
      </h2>
    </div>
    <div class="grid md:grid-cols-3 gap-px bg-lazuli-sable/30">
      {avis.map(a => (
        <article class="bg-lazuli-marine p-8 md:p-10 flex flex-col">
          <div class="flex gap-1 text-lazuli-sable mb-5">
            {Array.from({length: a.note}).map(() => (
              <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 1l2.2 4.5 5 .7-3.6 3.5.85 4.95L8 12.3 3.55 14.65 4.4 9.7.8 6.2l5-.7L8 1z"/></svg>
            ))}
          </div>
          <p class="font-cormorant italic text-xl md:text-2xl leading-snug text-white">« {a.texte} »</p>
          <div class="mt-auto pt-6 border-t border-lazuli-sable/25">
            <p class="font-geist text-sm text-lazuli-sable">{a.profil}</p>
            <p class="font-geist text-xs text-white/55 mt-1">Séjour {a.date}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
