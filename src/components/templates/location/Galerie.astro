---
const photos = [
  { src: 'https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?w=900&q=85', alt: 'Lagon turquoise au lever du soleil', wide: false },
  { src: 'https://images.unsplash.com/photo-1582719508461-905c673771fd?w=1200&q=85', alt: 'Piscine privée vue mer', wide: true },
  { src: 'https://images.unsplash.com/photo-1591474200742-8e512e6f98f8?w=900&q=85', alt: 'Petit-déjeuner sur la terrasse', wide: false },
  { src: 'https://images.unsplash.com/photo-1505691938895-1758d7feb511?w=900&q=85', alt: 'Salon avec vue lagon', wide: false },
  { src: 'https://images.unsplash.com/photo-1540541338287-41700207dee6?w=1200&q=85', alt: 'Chambre parentale et son hublot', wide: true },
  { src: 'https://images.unsplash.com/photo-1499856871958-5b9627545d1a?w=900&q=85', alt: 'Coucher de soleil sur le lagon', wide: false },
];
---

<section class="bg-lazuli-casse py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center mb-12 max-w-2xl mx-auto">
      <p class="font-geist text-[11px] uppercase tracking-[0.32em] text-lazuli-terracotta mb-3">
        ✦ Galerie · 06 vues
      </p>
      <h2 class="text-lazuli-marine leading-tight" style="font-family: 'Yeseva One', serif; font-size: clamp(36px, 5vw, 60px);">
        Quelques images,<br/>
        <span class="italic text-lazuli-terracotta" style="font-family: 'Italianno', cursive; font-size: 1.4em;">par la fenêtre.</span>
      </h2>
    </header>

    <ul class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 auto-rows-[180px] md:auto-rows-[240px]">
      {photos.map((p, i) => (
        <li class:list={[
          'overflow-hidden ring-1 ring-lazuli-marine/15 group relative',
          p.wide ? 'col-span-2 md:col-span-2' : 'col-span-1',
          i === 0 && 'md:row-span-2',
        ]}>
          <img
            src={p.src}
            alt={p.alt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
            decoding="async"
          />
          <div class="absolute inset-0 bg-lazuli-marine/0 group-hover:bg-lazuli-marine/40 transition-colors flex items-end p-4">
            <p class="font-geist italic text-lazuli-casse text-sm md:text-base opacity-0 group-hover:opacity-100 transition-opacity">
              {p.alt}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
