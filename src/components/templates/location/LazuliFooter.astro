---
import data from '../../../data/templates/lazuli.json';
---
<footer class="relative bg-lazuli-marine text-lazuli-casse pt-20 pb-12">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <p class="font-cormorant italic text-lazuli-sable leading-[0.92] mb-16" style="font-size: clamp(64px,12vw,200px);">
      Lazuli.
    </p>
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-12 pt-10 border-t border-lazuli-sable/25">
      <div>
        <p class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable mb-3">Adresse</p>
        <p class="font-cormorant italic text-lg">{data.info.adresseLigne1}<br/>{data.info.adresseLigne2}</p>
      </div>
      <div>
        <p class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable mb-3">Contact</p>
        <a href={`tel:${data.info.telephoneHref}`} class="block font-cormorant italic text-lg hover:text-lazuli-terracotta">{data.info.telephone}</a>
        <a href={`mailto:${data.info.email}`} class="block font-geist text-sm text-white/70 mt-1 hover:text-lazuli-terracotta break-all">{data.info.email}</a>
      </div>
      <div>
        <p class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable mb-3">Vos hôtes</p>
        <p class="font-cormorant italic text-lg">{data.info.hotes}</p>
        <p class="font-geist text-xs text-white/55 mt-2">{data.info.siret}</p>
      </div>
      <div>
        <p class="font-geist text-[10px] uppercase tracking-[0.3em] text-lazuli-sable mb-3">Suivre</p>
        <p class="font-cormorant italic text-lg">{data.info.instagram}</p>
      </div>
    </div>
    <div class="pt-8 border-t border-lazuli-sable/20 flex flex-wrap items-center justify-between gap-3 font-geist text-[11px] uppercase tracking-[0.25em] text-white/50">
      <span>© {data.info.nom} {data.info.annee} — {new Date().getFullYear()}</span>
      <span class="italic font-cormorant normal-case tracking-normal text-lazuli-sable text-base">{data.info.tagline}</span>
    </div>
  </div>
</footer>
