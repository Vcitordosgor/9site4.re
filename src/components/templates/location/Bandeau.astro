---
import data from '../../../data/templates/lazuli.json';
---
<section class="relative bg-lazuli-marine text-lazuli-sable py-10 md:py-12 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-12 flex flex-wrap items-center justify-center gap-x-10 gap-y-3 font-cormorant italic">
    <span class="text-lazuli-sable text-xl md:text-3xl">— {data.info.tagline} —</span>
    <span class="text-lazuli-terracotta text-xl md:text-3xl">{data.info.ville}</span>
    <span class="text-white text-xl md:text-3xl">{data.info.adresseLigne1}</span>
    <span class="text-lazuli-sable text-xl md:text-3xl">depuis {data.info.annee}</span>
  </div>
</section>
