---
import data from '../../../data/templates/lazuli.json';
---

<section class="bg-lazuli-terracotta text-lazuli-casse">
  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-2">
        <p class="font-italianno text-lazuli-sable text-5xl leading-none">
          flexible
        </p>
      </div>
      <div class="md:col-span-7">
        <p class="font-geist text-[10.5px] uppercase tracking-[0.32em] text-lazuli-sable mb-3 font-medium">
          — Politique de réservation
        </p>
        <p class="font-yeseva text-lazuli-casse leading-[1.1]" style="font-size: clamp(26px, 3.4vw, 44px);">
          Annulation gratuite <span class="italic">jusqu'à 14 jours</span> avant l'arrivée. On comprend que la vie change.
        </p>
      </div>
      <div class="md:col-span-3 md:text-right">
        <a
          href="#reservation"
          class="inline-flex items-center justify-center h-12 px-7 bg-lazuli-casse text-lazuli-marine font-geist font-medium text-sm rounded-full hover:bg-lazuli-sable transition-colors"
        >
          Vérifier les dates →
        </a>
        <p class="mt-3 font-geist text-[10.5px] uppercase tracking-[0.32em] text-lazuli-sable">
          {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
