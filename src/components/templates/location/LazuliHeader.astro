---
import data from '../../../data/templates/lazuli.json';
---
<header id="lazuli-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-500" data-scrolled="false">
  <div class="absolute inset-0 bg-lazuli-casse/0 backdrop-blur-0 transition-all duration-500 [[data-scrolled=true]_&]:bg-lazuli-casse/95 [[data-scrolled=true]_&]:backdrop-blur-md [[data-scrolled=true]_&]:border-b [[data-scrolled=true]_&]:border-lazuli-sable/40"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-12 h-20 flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-3">
      <span class="font-yeseva text-white [[data-scrolled=true]_&]:text-lazuli-marine text-2xl md:text-3xl tracking-wide transition-colors duration-500">{data.info.wordmark}</span>
      <span class="hidden md:inline font-geist text-[10px] uppercase tracking-[0.35em] text-lazuli-sable transition-colors duration-500">{data.info.soustitre}</span>
    </a>
    <nav class="hidden md:flex items-center gap-9 font-geist text-[12px] uppercase tracking-[0.25em]">
      {[['#vivre','Vivre ici'],['#galerie','Galerie'],['#espace','L\'espace'],['#tarifs','Tarifs'],['#reservation','Réserver']].map(([href,label]) => (
        <a href={href} class="text-white [[data-scrolled=true]_&]:text-lazuli-marine hover:text-lazuli-terracotta transition-colors">{label}</a>
      ))}
    </nav>
    <a href="#reservation" class="hidden md:inline-flex items-center gap-2 h-11 px-5 bg-lazuli-terracotta text-lazuli-casse rounded-full font-geist text-sm tracking-wide hover:bg-lazuli-lagon transition-colors">Réserver →</a>
    <a href="#reservation" class="md:hidden inline-flex items-center gap-2 h-10 px-4 bg-lazuli-terracotta text-lazuli-casse rounded-full font-geist text-xs uppercase tracking-wide">Réserver</a>
  </div>
</header>
<script is:inline>
  (() => {
    const h = document.getElementById('lazuli-header');
    if (!h) return;
    const onScroll = () => { h.dataset.scrolled = String(window.scrollY > 60); };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>
