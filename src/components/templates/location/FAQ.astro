---
const faq = [
  ["Comment se passe l'arrivée ?", "Accueil personnalisé entre 16h et 19h, sur place. Visite de la villa, remise des clés et carte du quartier. Stéphane ou Marina vous reçoit, jamais une boîte à clés impersonnelle."],
  ["Y a-t-il un séjour minimum ?", "Trois nuits en basse et moyenne saison, sept nuits en haute saison, quatorze nuits sur la période fêtes de fin d'année."],
  ["Quelle est la politique d'annulation ?", "Annulation gratuite jusqu'à 30 jours avant l'arrivée. Au-delà, premier acompte non remboursable. Sinistre majeur étudié au cas par cas."],
  ["Les animaux sont-ils acceptés ?", "Oui, un chien moyen calme est accepté sur demande, sans supplément. Pas de chat (allergies hôtes voisins)."],
  ["Y a-t-il du wifi correct pour télétravailler ?", "Fibre 600 Mbps symétrique, couverture intégrale villa + terrasse. Idéal télétravail ou visios."],
  ["Peut-on louer du matériel de plage ?", "Oui : surf, paddle, palmes/masque, transats déportés. Tarifs préférentiels chez Pacific Surf, à 500 m."],
];
---
<section class="relative bg-lazuli-casse text-lazuli-marine py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-12">
    <div class="lg:col-span-4">
      <p class="font-geist text-[11px] uppercase tracking-[0.45em] text-lazuli-terracotta mb-4">§ FAQ</p>
      <h2 class="font-cormorant italic leading-[0.95] tracking-tight sticky top-28" style="font-size: clamp(48px, 6vw, 92px);">
        Avant de<br/>réserver.
      </h2>
    </div>
    <ul class="lg:col-span-8 divide-y divide-lazuli-sable/50 border-y border-lazuli-sable/50">
      {faq.map((q, i) => (
        <li>
          <details class="group">
            <summary class="cursor-pointer py-6 flex items-start justify-between gap-6 list-none">
              <div class="flex gap-5 items-start">
                <span class="font-cormorant italic text-lazuli-terracotta text-xl mt-1 shrink-0">{String(i+1).padStart(2,'0')}.</span>
                <span class="font-cormorant italic text-lazuli-marine text-xl md:text-2xl leading-tight">{q[0]}</span>
              </div>
              <span class="font-cormorant italic text-lazuli-lagon text-3xl leading-none mt-1 transition-transform group-open:rotate-45 shrink-0">+</span>
            </summary>
            <p class="pb-7 pl-10 font-geist text-lazuli-marine/75 leading-relaxed max-w-3xl">{q[1]}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>
