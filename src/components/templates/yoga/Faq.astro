---
const faq = [
  {
    q: 'Je n\'ai jamais pratiqué — est-ce pour moi ?',
    r: 'Oui. Beaucoup d\'élèves démarrent ici sans expérience. On propose toujours des variantes adaptées.',
  },
  {
    q: 'Je ne suis pas souple. Est-ce un problème ?',
    r: 'Non. La souplesse est une conséquence, pas un prérequis. On commence d\'où vous êtes.',
  },
  {
    q: 'Faut-il du matériel pour commencer ?',
    r: 'Non. Tapis, briques, sangles et coussins sont prêtés gratuitement pour le cours d\'essai.',
  },
  {
    q: 'Quelle pratique choisir pour démarrer ?',
    r: 'Hatha pour comprendre les bases. Yin pour relâcher. Le Vinyasa viendra plus tard.',
  },
];
---

<section class="bg-yoga-papier py-20 md:py-28">
  <div class="max-w-3xl mx-auto px-6 md:px-10">

    <div class="text-center mb-12 md:mb-16">
      <p class="font-lexend uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-yoga-ocre mb-4 font-light">— Avant de poser le tapis —</p>
      <h2 class="font-dm-serif text-yoga-encre text-3xl md:text-5xl leading-tight">
        Questions
        <em class="font-dm-serif italic text-yoga-ocre">qu'on nous pose souvent</em>
      </h2>
    </div>

    <div class="space-y-2">
      {faq.map((f) => (
        <details class="group border-b border-yoga-encre/15 hover:border-yoga-ocre transition-colors">
          <summary class="cursor-pointer list-none flex items-start gap-5 py-5 md:py-7">
            <span class="font-dm-serif italic text-yoga-ocre text-3xl leading-none mt-0 transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
            <span class="flex-1 font-dm-serif text-yoga-encre text-lg md:text-xl leading-snug">{f.q}</span>
          </summary>
          <div class="pb-6 md:pb-8 pl-12 pr-2">
            <p class="font-spectral text-[15px] md:text-[16px] text-yoga-encre/85 leading-relaxed">{f.r}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
