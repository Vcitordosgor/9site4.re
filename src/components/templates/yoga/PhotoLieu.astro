<section aria-label="Le studio" class="bg-yoga-creme py-0">
  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-yoga-encre">
      <img
        src="/images/yoga/cours.webp"
        alt="Cours de yoga, étirements alignés sur tapis, gros plan sur les pieds et mains"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-4 flex items-baseline justify-between gap-3 flex-wrap">
      <figcaption class="font-dm-serif italic text-yoga-encre text-base md:text-lg leading-relaxed">
        Le studio · quatre tapis, beaucoup de bois, peu de bruit.
      </figcaption>
      <span class="font-lexend text-[11px] uppercase tracking-[0.28em] text-yoga-ocre">12 élèves max · séance complète</span>
    </div>
  </figure>
</section>
