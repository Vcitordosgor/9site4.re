---
import data from '../../../data/templates/roussin.json';
---

<section class="bg-roussin-nuit text-roussin-velin relative">
  <div class="absolute inset-x-0 top-0 h-[2px] bg-roussin-or" aria-hidden="true"></div>
  <div class="absolute inset-x-0 top-[5px] h-px bg-roussin-or/50" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-[2px] bg-roussin-or" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-[5px] h-px bg-roussin-or/50" aria-hidden="true"></div>

  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-8">
        <p class="font-public-sans text-[10.5px] uppercase tracking-[0.32em] text-roussin-or mb-3">
          ⚖ Premier contact
        </p>
        <p class="font-eb-garamond text-roussin-velin leading-[1.05]" style="font-size: clamp(26px, 3.4vw, 44px);">
          Consultation de cadrage <span class="italic text-roussin-laiton">offerte</span> — 30 minutes, sous secret professionnel.
        </p>
      </div>
      <div class="md:col-span-4 md:text-right">
        <a
          href="#contact"
          class="inline-flex items-center justify-center h-12 px-7 bg-roussin-or text-roussin-nuit font-public-sans font-semibold text-[12px] uppercase tracking-[0.22em] hover:bg-roussin-velin transition-colors"
        >
          Réserver le créneau
        </a>
        <p class="mt-3 font-public-sans text-[11px] uppercase tracking-[0.22em] text-roussin-laiton">
          {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
