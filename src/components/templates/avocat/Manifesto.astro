---
import data from '../../../data/templates/roussin.json';
const para = data.promesse;
const first = para.charAt(0);
const rest = para.slice(1);
---

<section class="bg-roussin-papier py-24 md:py-32 px-6 md:px-10 relative">

  <div class="max-w-3xl mx-auto relative">

    <div class="text-center mb-12">
      <p class="font-public-sans text-[11px] uppercase tracking-[0.4em] text-roussin-or mb-3">— Notre conviction —</p>
      <div class="w-12 h-px bg-roussin-bordeaux mx-auto"></div>
    </div>

    <p class="font-eb-garamond text-roussin-nuit text-2xl md:text-[28px] leading-[1.55]">
      <span class="float-left font-eb-garamond text-roussin-bordeaux leading-[0.78] mr-4 mt-1.5" style="font-size: clamp(96px, 14vw, 160px); font-style: italic;">
        {first}
      </span>
      {rest}
    </p>

    <div class="mt-12 text-center">
      <div class="w-12 h-px bg-roussin-or mx-auto mb-4"></div>
      <p class="font-eb-garamond italic text-roussin-bordeaux text-lg md:text-xl">
        — {data.info.fondateur}, fondateur
      </p>
    </div>
  </div>
</section>
