---
const items = [
  { label: 'Barreau de La Réunion', sub: 'Tous les associés inscrits' },
  { label: 'Aide juridictionnelle', sub: 'Acceptée totale et partielle' },
  { label: 'Médiateur CMAP', sub: 'Médiation conventionnelle' },
  { label: 'CNB · RCP', sub: 'Responsabilité civile garantie' },
];
---

<section class="bg-roussin-velin py-16 md:py-20 px-6 md:px-10 border-y border-roussin-or/30">
  <div class="max-w-content mx-auto">

    <div class="text-center mb-12">
      <p class="font-public-sans text-[11px] uppercase tracking-[0.4em] text-roussin-or mb-3">— Garanties professionnelles —</p>
      <p class="font-eb-garamond italic text-roussin-nuit text-xl md:text-2xl">Quatre engagements opposables.</p>
    </div>

    <ul class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {items.map((it) => (
        <li class="bg-roussin-blanc border border-roussin-or/40 relative p-5 md:p-7 text-center hover:border-roussin-bordeaux transition-colors">

          <div class="absolute inset-1.5 border border-roussin-or/15 pointer-events-none" aria-hidden="true"></div>

          <div class="relative">
            <svg viewBox="0 0 64 64" class="w-12 h-12 mx-auto mb-4 text-roussin-bordeaux" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
              <circle cx="32" cy="28" r="14"/>
              <circle cx="32" cy="28" r="10"/>
              <path d="M24 38 L20 56 L32 50 L44 56 L40 38"/>
              <path d="M28 26 L31 30 L36 24" stroke-width="1.6"/>
            </svg>
            <p class="font-eb-garamond text-roussin-nuit text-base md:text-lg leading-tight">
              {it.label}
            </p>
            <p class="mt-2 font-public-sans text-[11px] uppercase tracking-[0.18em] text-roussin-or/85">
              {it.sub}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
