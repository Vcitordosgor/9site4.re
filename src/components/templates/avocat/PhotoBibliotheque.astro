---
/**
 * PhotoBibliotheque — section full-bleed visuelle entre Associés et Démarche.
 */
---

<section class="bg-roussin-velin py-0">
  <figure class="relative aspect-[21/9] overflow-hidden bg-roussin-nuit">
    <img
      src="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1800&q=85"
      alt="Bibliothèque juridique d'un cabinet d'avocats"
      class="w-full h-full object-cover"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-roussin-nuit/55 via-roussin-nuit/10 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-10 left-6 md:left-12 right-6 md:right-12">
      <p class="font-public-sans text-[10.5px] uppercase tracking-[0.28em] text-roussin-laiton mb-2">
        — Bibliothèque du cabinet —
      </p>
      <p class="font-eb-garamond italic text-roussin-velin leading-[1.15]" style="font-size: clamp(22px, 3vw, 36px);">
        Quinze ans de jurisprudence, à portée de main.
      </p>
    </figcaption>
  </figure>
</section>
