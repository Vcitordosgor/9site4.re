---
import data from '../../../data/templates/doudou.json';
const i = data.info;
const nav = [
  { href: '#journee', label: 'Une journée' },
  { href: '#pour-qui', label: 'Pour qui' },
  { href: '#equipe', label: 'L’équipe' },
  { href: '#process', label: 'Comment ça se passe' },
  { href: '#tarifs', label: 'Tarifs' },
  { href: '#contact', label: 'Contact' },
];
---
<header
  id="ad-header"
  data-scrolled="false"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 data-[scrolled=true]:bg-[#F8F0E3]/95 data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:shadow-[0_4px_24px_rgba(61,42,30,0.08)]"
  style="font-family:'Inter',system-ui,sans-serif;"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-[72px] flex items-center justify-between">
    <a href="#top" class="flex items-baseline gap-2">
      <span class="text-[#3D2A1E] text-[28px] leading-none" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;">{i.wordmark1}</span>
      <span class="text-[#C4674C] text-[14px] tracking-[0.18em] uppercase font-medium">{i.wordmark2}</span>
    </a>
    <nav class="hidden lg:flex items-center gap-8 text-[14px] text-[#3D2A1E]/75">
      {nav.map((n) => (
        <a href={n.href} class="hover:text-[#C4674C] transition-colors">{n.label}</a>
      ))}
    </nav>
    <div class="flex items-center gap-3">
      <a href={`tel:${i.telephoneHref}`} class="hidden sm:inline text-[14px] font-medium text-[#3D2A1E] tabular-nums">{i.telephone}</a>
      <a href="#contact" class="inline-flex items-center h-10 px-5 rounded-full bg-[#3D2A1E] text-[#F8F0E3] text-[13px] font-medium hover:bg-[#C4674C] transition-colors">
        Visite gratuite
      </a>
    </div>
  </div>
</header>
<script>
  const h = document.getElementById('ad-header');
  if (h) {
    const upd = () => { h.dataset.scrolled = String(window.scrollY > 20); };
    upd(); window.addEventListener('scroll', upd, { passive: true });
  }
</script>
