---
import data from '../../../data/templates/doudou.json';
const i = data.info;
---
<footer class="relative bg-[#3D2A1E] text-[#F8F0E3] pt-24 pb-10 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <p class="text-center leading-[0.95] mb-16" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;font-size:clamp(40px,7vw,96px);">
      Chaque famille, son <em class="text-[#C4674C]">rythme.</em>
    </p>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-10 mb-16 pt-10 border-t border-[#F8F0E3]/15">
      <div>
        <p class="text-[28px] mb-4" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;">{i.wordmark1} <span class="text-[#C4674C] tracking-[0.12em] text-[14px] uppercase ml-2">{i.wordmark2}</span></p>
        <p class="text-[#F8F0E3]/65 text-[14px] leading-[1.65]">Aide à domicile pour les familles réunionnaises. Depuis {i.annee}.</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-[0.18em] text-[#C4674C] mb-4">Contact</p>
        <p class="text-[14px] mb-2"><a href={`tel:${i.telephoneHref}`} class="hover:text-[#C4674C] tabular-nums">{i.telephone}</a></p>
        <p class="text-[14px]"><a href={`mailto:${i.email}`} class="hover:text-[#C4674C]">{i.email}</a></p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-[0.18em] text-[#C4674C] mb-4">Horaires</p>
        <p class="text-[14px] text-[#F8F0E3]/75">Lun — Dim</p>
        <p class="text-[14px] text-[#F8F0E3]/75">7h — 22h</p>
        <p class="text-[12px] text-[#F8F0E3]/55 mt-2">Astreinte 24/24 sur abonnement</p>
      </div>
      <div>
        <p class="text-[11px] uppercase tracking-[0.18em] text-[#C4674C] mb-4">Légal</p>
        <p class="text-[14px] text-[#F8F0E3]/75">Agrément Services à la personne</p>
        <p class="text-[14px] text-[#F8F0E3]/75">CESU déclaré</p>
        <p class="text-[14px] text-[#F8F0E3]/75">Assurance RC Pro</p>
      </div>
    </div>

    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-8 border-t border-[#F8F0E3]/15 text-[12px] text-[#F8F0E3]/55">
      <p>© {new Date().getFullYear()} {i.nom} · La Réunion</p>
      <p class="text-[11px] uppercase tracking-[0.18em]">Site démo 9site4</p>
    </div>
  </div>
</footer>
