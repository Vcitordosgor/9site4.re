---
import data from '../../../data/templates/doudou.json';
const i = data.info;
---
<section id="hero" class="relative bg-[#F8F0E3] overflow-hidden pt-[120px] md:pt-[140px] pb-24 md:pb-32">
  <div aria-hidden="true" class="absolute -top-32 -right-40 w-[560px] h-[560px] rounded-full bg-[#C4674C]/10 blur-3xl pointer-events-none"></div>
  <div aria-hidden="true" class="absolute top-1/2 -left-32 w-[420px] h-[420px] rounded-full bg-[#6B7F5C]/10 blur-3xl pointer-events-none"></div>

  <div class="relative max-w-content mx-auto px-6 md:px-10 grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">

    <div class="lg:col-span-7 order-2 lg:order-1" data-reveal>
      <p class="inline-flex items-center gap-2 text-[#6B7F5C] text-[11px] font-medium uppercase tracking-[0.22em] mb-8">
        <span class="w-8 h-px bg-[#6B7F5C]"></span> Aide à domicile · La Réunion
      </p>
      <h1 class="text-[#3D2A1E] leading-[0.92] tracking-[-0.02em]" style="font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(64px,11vw,148px);">
        Comme à la<br/>
        <em class="text-[#C4674C]" style="font-style:italic;font-weight:500;">maison.</em>
      </h1>
      <p class="mt-4 text-[22px] md:text-[26px] text-[#C4674C] rotate-[-2deg] inline-block" style="font-family:'Caveat',cursive;">
        depuis {i.annee}, on prend soin
      </p>
      <p class="mt-8 text-[#3D2A1E]/80 text-[17px] md:text-[19px] leading-[1.6] max-w-xl">
        Pour vos parents, votre conjoint, ou vous-même. Une présence chaleureuse, des aidants formés, une famille rassurée.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-6 gap-y-4">
        <a href="#contact" class="group inline-flex items-center justify-center h-[54px] px-8 bg-[#3D2A1E] text-[#F8F0E3] rounded-full text-[15px] font-medium hover:bg-[#C4674C] transition-all hover:translate-y-[-2px]" style="box-shadow:0 12px 28px rgba(61,42,30,0.18);">
          Demander une visite gratuite
          <svg class="ml-2 transition-transform group-hover:translate-x-1" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </a>
        <a href={`tel:${i.telephoneHref}`} class="text-[#3D2A1E] text-[15px] font-medium underline underline-offset-[6px] decoration-[#C4674C] decoration-2 tabular-nums">{i.telephone}</a>
      </div>

      <div class="mt-12 flex flex-wrap gap-3">
        {[
          { label: 'CESU agréé', sub: 'Crédit d’impôt 50 %' },
          { label: 'Aidants formés', sub: 'Auxiliaires de vie diplômés' },
          { label: 'Mutuelle équipe', sub: 'Assurance RC pro' },
        ].map((s) => (
          <span class="inline-flex items-center gap-3 pl-1.5 pr-4 py-1 rounded-full bg-white/70 ring-1 ring-[#3D2A1E]/10 hover:bg-white/90 transition-colors">
            <span class="w-7 h-7 rounded-full bg-[#6B7F5C] text-[#F8F0E3] grid place-items-center text-[11px]">✓</span>
            <span class="leading-tight">
              <span class="block text-[12px] font-semibold text-[#3D2A1E]">{s.label}</span>
              <span class="block text-[11px] text-[#3D2A1E]/55">{s.sub}</span>
            </span>
          </span>
        ))}
      </div>
    </div>

    <div class="lg:col-span-5 order-1 lg:order-2 px-2 sm:px-0 pt-6 lg:pt-0" data-reveal>
      <div class="relative mx-auto max-w-[420px] lg:max-w-none">
        <div class="relative aspect-[4/5] rounded-[28px] overflow-hidden ring-1 ring-[#3D2A1E]/10" style="box-shadow:0 40px 80px -30px rgba(61,42,30,0.35);">
          <img src={i.photoHero} alt="Une aidante et une personne âgée à domicile" class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#3D2A1E]/30 via-transparent to-transparent"></div>
        </div>
        <div class="absolute -bottom-5 left-2 sm:-bottom-6 sm:-left-6 bg-[#F8F0E3] rounded-2xl px-5 py-4 ring-1 ring-[#3D2A1E]/10" style="box-shadow:0 16px 40px rgba(61,42,30,0.12);">
          <p class="text-[#C4674C]" style="font-family:'Caveat',cursive;font-size:28px;line-height:1;">7 jours / 7</p>
          <p class="mt-1 text-[11px] text-[#3D2A1E]/60 uppercase tracking-[0.15em]">07h — 22h</p>
        </div>
        <div class="absolute -top-4 right-2 sm:-top-5 sm:-right-5 bg-[#C4674C] text-[#F8F0E3] rounded-2xl px-4 py-3 rotate-[4deg]" style="box-shadow:0 10px 24px rgba(196,103,76,0.35);">
          <p class="text-[12px] uppercase tracking-[0.18em] opacity-90">M. André</p>
          <p class="text-[17px] font-medium" style="font-family:'Cormorant Garamond',serif;font-style:italic;">82 ans, Le Tampon</p>
        </div>
      </div>
    </div>
  </div>

  <div class="relative max-w-content mx-auto px-6 md:px-10 mt-16 md:mt-20">
    <div class="flex flex-wrap items-baseline gap-x-3 text-[#3D2A1E]/55 text-[12px] uppercase tracking-[0.22em]">
      <span class="w-12 h-px bg-[#3D2A1E]/30"></span>
      <span>Défilez — une journée avec Marie</span>
    </div>
  </div>
</section>
