---
import data from '../../../data/templates/doudou.json';
---
<section class="relative bg-[#C4674C] text-[#F8F0E3] py-12 md:py-14 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-5">
      <span class="w-12 h-12 rounded-full bg-[#F8F0E3]/15 grid place-items-center shrink-0">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 22s-7-4.5-7-11a5 5 0 0 1 9-3 5 5 0 0 1 9 3c0 6.5-7 11-7 11h-4z"/></svg>
      </span>
      <div>
        <p class="text-[11px] uppercase tracking-[0.22em] opacity-80 mb-1">Besoin d’aide rapide ?</p>
        <p class="text-[24px] md:text-[32px] leading-tight" style="font-family:'Cormorant Garamond',serif;font-style:italic;font-weight:500;">Mise en place sous 48 h.</p>
      </div>
    </div>
    <a href={`tel:${data.info.telephoneHref}`} class="inline-flex items-center gap-3 h-[54px] px-7 bg-[#F8F0E3] text-[#3D2A1E] rounded-full font-medium text-[15px] hover:bg-[#3D2A1E] hover:text-[#F8F0E3] transition-colors tabular-nums">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      {data.info.telephone}
    </a>
  </div>
</section>
