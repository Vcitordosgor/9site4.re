---
/**
 * Bandeau — bandeau bleu pleine largeur, 3 mentions financement et garanties.
 */
---

<section class="relative bg-doudou-bleu text-doudou-creme py-14 md:py-20 px-6 md:px-10 overflow-hidden">
  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-doudou-creme/25">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-6 sm:py-2">
        <span class="font-nunito font-extrabold text-doudou-creme leading-none" style="font-size: clamp(40px, 5vw, 60px);">- 50 %</span>
        <p class="mt-2 font-be-vietnam font-medium uppercase tracking-[0.18em] text-doudou-creme/85 text-[11px]">
          Crédit d'impôt service à la personne
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-6 sm:py-2" style="transition-delay: 80ms">
        <span class="font-nunito font-extrabold text-doudou-creme leading-none" style="font-size: clamp(40px, 5vw, 60px);">APA · PCH</span>
        <p class="mt-2 font-be-vietnam font-medium uppercase tracking-[0.18em] text-doudou-creme/85 text-[11px]">
          Prise en charge intégrale possible
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-6 sm:py-2" style="transition-delay: 160ms">
        <span class="font-nunito font-extrabold text-doudou-creme leading-none" style="font-size: clamp(40px, 5vw, 60px);">7 / 7</span>
        <p class="mt-2 font-be-vietnam font-medium uppercase tracking-[0.18em] text-doudou-creme/85 text-[11px]">
          Continuité assurée 365 jours
        </p>
      </li>
    </ul>
  </div>
</section>
