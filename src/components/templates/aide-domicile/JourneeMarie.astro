---
const moments = [
  { h: '08h', titre: 'Le café du matin', texte: 'Toilette, habillage avec respect, petit-déjeuner partagé. Marie note la nuit de Mme R. dans le carnet.', img: '/images/aide-domicile/extra-1.webp' },
  { h: '10h', titre: 'Ménage léger', texte: 'Lit fait, vaisselle, un coin propre. On n’est pas une femme de ménage — on garde la maison vivante.', img: '/images/aide-domicile/extra-2.webp' },
  { h: '11h', titre: 'Promenade au jardin', texte: 'Quinze minutes dehors, le soleil sur le visage. Ça vaut tous les médicaments du monde.', img: '/images/aide-domicile/extra-3.webp' },
  { h: '12h', titre: 'Repas mijoté', texte: 'Cari poulet ou rougail saucisses, comme à la maison. On mange ensemble, sans précipitation.', img: '/images/aide-domicile/extra-4.webp' },
  { h: '14h', titre: 'Lecture à voix haute', texte: 'Le Quotidien, une lettre du petit-fils, un roman. La voix qui tient compagnie.', img: '/images/aide-domicile/extra-5.webp' },
  { h: '15h30', titre: 'Une partie de cartes', texte: 'Belote, dominos, scrabble. Le cerveau qui s’amuse — et qui gagne, souvent.', img: '/images/aide-domicile/extra-6.webp' },
  { h: '17h', titre: 'Course à la pharmacie', texte: 'Retrait des médicaments, courses au plus proche. Marie revient avec une fleur.', img: '/images/aide-domicile/extra-7.webp' },
  { h: '19h', titre: 'Coucher en douceur', texte: 'Dîner léger, toilette du soir, une dernière tisane. Bonne nuit — à demain.', img: '/images/aide-domicile/extra-8.webp' },
];
---
<section id="journee" class="relative bg-[#3D2A1E] text-[#F8F0E3] py-24 md:py-32 overflow-hidden">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-12">
      <div data-reveal>
        <p class="text-[#C4674C] text-[12px] uppercase tracking-[0.24em] mb-4">Signature · une journée</p>
        <h2 class="leading-[0.95] tracking-[-0.02em]" style="font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(48px,7vw,96px);">
          Une journée avec <em class="text-[#C4674C]">Marie</em>.
        </h2>
        <p class="mt-6 text-[#F8F0E3]/75 text-[17px] leading-[1.6] max-w-2xl">
          Pour comprendre vraiment ce qu’on fait. Du café du matin à la dernière tisane, le quotidien d’une aidante chez Mme R., 87 ans, au Tampon.
        </p>
      </div>
      <div class="hidden md:flex items-center gap-4 text-[12px] uppercase tracking-[0.18em] text-[#F8F0E3]/55">
        <button id="jm-prev" aria-label="Précédent" class="w-11 h-11 rounded-full ring-1 ring-[#F8F0E3]/25 hover:bg-[#C4674C] hover:ring-[#C4674C] hover:text-white transition-all grid place-items-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        </button>
        <button id="jm-next" aria-label="Suivant" class="w-11 h-11 rounded-full ring-1 ring-[#F8F0E3]/25 hover:bg-[#C4674C] hover:ring-[#C4674C] hover:text-white transition-all grid place-items-center">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>

    <div id="jm-track" class="flex gap-6 overflow-x-auto snap-x snap-mandatory pb-6 -mx-6 px-6 md:mx-0 md:px-0" style="scrollbar-width:none;">
      {moments.map((m, idx) => (
        <article class="snap-start shrink-0 w-[300px] md:w-[360px] group cursor-pointer">
          <div class="relative aspect-[3/4] rounded-[24px] overflow-hidden ring-1 ring-white/10">
            <img src={m.img} alt={m.titre} class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#3D2A1E] via-[#3D2A1E]/40 to-transparent"></div>
            <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-[#3D2A1E]/55 to-transparent pointer-events-none"></div>
            <div class="absolute top-5 left-5 text-[#F8F0E3]" style="font-family:'Cormorant Garamond',serif;font-style:italic;">
              <span class="text-[44px] leading-none">{m.h}</span>
            </div>
            <div class="absolute bottom-0 inset-x-0 p-6">
              <p class="text-[11px] uppercase tracking-[0.2em] text-[#C4674C] mb-2">{String(idx + 1).padStart(2, '0')} / 08</p>
              <h3 class="text-[24px] leading-[1.1] mb-3" style="font-family:'Cormorant Garamond',serif;font-style:italic;">{m.titre}</h3>
              <p class="text-[14px] text-[#F8F0E3]/85 leading-[1.55]">{m.texte}</p>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- SIGNATURE: une semaine type qui se remplit au scroll -->
    <div class="mt-20 md:mt-24 grid lg:grid-cols-12 gap-10 lg:gap-14 items-start" data-reveal>
      <div class="lg:col-span-4">
        <p class="text-[#C4674C] text-[12px] uppercase tracking-[0.24em] mb-4">— Une semaine type</p>
        <h3 class="leading-[0.98] tracking-[-0.01em] mb-6" style="font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(34px,4vw,52px);">
          Régulière,<br/><em class="text-[#C4674C]">prévisible.</em>
        </h3>
        <p class="text-[#F8F0E3]/75 text-[16px] leading-[1.65]">
          La même aidante, aux mêmes heures, presque chaque jour. Les habitudes rassurent — et libèrent la famille.
        </p>
        <div class="mt-7 flex flex-wrap gap-x-5 gap-y-2 text-[12px] text-[#F8F0E3]/70">
          <span class="inline-flex items-center gap-2"><span class="w-3 h-3 rounded-sm bg-[#C4674C]"></span> Visite matin</span>
          <span class="inline-flex items-center gap-2"><span class="w-3 h-3 rounded-sm bg-[#6B7F5C]"></span> Visite après-midi</span>
          <span class="inline-flex items-center gap-2"><span class="w-3 h-3 rounded-sm bg-[#F8F0E3]/15 ring-1 ring-[#F8F0E3]/25"></span> Famille / repos</span>
        </div>
      </div>

      <div id="jm-week" class="lg:col-span-8 rounded-[24px] bg-[#F8F0E3]/[0.04] ring-1 ring-[#F8F0E3]/12 p-4 sm:p-6">
        <div class="grid grid-cols-[44px_repeat(7,1fr)] gap-1.5 sm:gap-2 text-[10px] sm:text-[11px] uppercase tracking-[0.14em] text-[#F8F0E3]/55 mb-2">
          <span></span>
          {['lun','mar','mer','jeu','ven','sam','dim'].map((d) => (<span class="text-center">{d}</span>))}
        </div>
        {[
          { h: '08h', cells: [1,1,1,1,1,0,0] },
          { h: '10h', cells: [1,0,1,0,1,0,0] },
          { h: '12h', cells: [1,1,1,1,1,1,1] },
          { h: '15h', cells: [0,2,0,2,0,2,0] },
          { h: '19h', cells: [2,2,2,2,2,2,2] },
        ].map((row, r) => (
          <div class="grid grid-cols-[44px_repeat(7,1fr)] gap-1.5 sm:gap-2 mb-1.5 sm:mb-2 last:mb-0">
            <span class="text-[11px] sm:text-[12px] text-[#F8F0E3]/60 tabular-nums self-center" style="font-family:'Cormorant Garamond',serif;font-style:italic;">{row.h}</span>
            {row.cells.map((v, c) => (
              <span
                class="jm-cell aspect-square rounded-md sm:rounded-lg ring-1 ring-[#F8F0E3]/10 bg-[#F8F0E3]/[0.04]"
                data-fill={v}
                style={`--d:${(r * 7 + c) * 55}ms;`}
                aria-hidden="true"
              ></span>
            ))}
          </div>
        ))}
        <p class="mt-5 text-[12px] text-[#F8F0E3]/55 italic" style="font-family:'Cormorant Garamond',serif;">
          Exemple — Mme R., maintien à domicile, 18 h / semaine.
        </p>
      </div>
    </div>

    <div class="mt-16 md:mt-20 flex items-center gap-4">
      <div class="flex-1 h-px bg-[#F8F0E3]/15"></div>
      <p class="text-[14px] text-[#F8F0E3]/65 italic text-center" style="font-family:'Cormorant Garamond',serif;">
        « Ce qu’on offre, ce n’est pas une prestation. C’est un rythme. »
      </p>
      <div class="flex-1 h-px bg-[#F8F0E3]/15"></div>
    </div>
  </div>
</section>
<script>
  const track = document.getElementById('jm-track');
  const prev = document.getElementById('jm-prev');
  const next = document.getElementById('jm-next');
  if (track && prev && next) {
    const step = () => Math.min(track.clientWidth * 0.8, 380);
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
  }

  // Signature: weekly grid soft-fills cell by cell on scroll-in.
  const week = document.getElementById('jm-week');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (week) {
    if (reduceMotion) {
      week.classList.add('is-on');
    } else {
      const wio = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            week.classList.add('is-on');
            wio.unobserve(e.target);
          }
        }
      }, { threshold: 0.25 });
      wio.observe(week);
    }
  }
</script>
<style>
  #jm-track::-webkit-scrollbar{display:none}
  /* Weekly grid: cells are pre-sized to avoid CLS; only opacity/color animates. */
  #jm-week .jm-cell{
    transition: background-color .9s ease, box-shadow .9s ease, transform .9s ease;
    transform: scale(.92);
  }
  #jm-week.is-on .jm-cell{
    transform: scale(1);
    transition-delay: var(--d, 0ms);
  }
  #jm-week.is-on .jm-cell[data-fill="1"]{
    background-color: rgba(196,103,76,.85);
    box-shadow: inset 0 0 0 1px rgba(196,103,76,.35), 0 4px 12px -6px rgba(196,103,76,.6);
  }
  #jm-week.is-on .jm-cell[data-fill="2"]{
    background-color: rgba(107,127,92,.78);
    box-shadow: inset 0 0 0 1px rgba(107,127,92,.35), 0 4px 12px -6px rgba(107,127,92,.5);
  }
  @media (prefers-reduced-motion: reduce){
    #jm-week .jm-cell{ transition: none; transform: none; }
  }
</style>
