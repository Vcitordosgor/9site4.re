---
import data from '../../../data/templates/doudou.json';
const phrases = [
  'On ne soigne pas, on accompagne. Et ça change tout.',
  'J’aime quand on me raconte les vieilles histoires.',
  'La patience, c’est le plus beau des métiers.',
  'Le sourire qu’on laisse en partant, voilà la paye.',
];
const years = ['12 ans', '7 ans', '5 ans', '9 ans'];
---
<section id="equipe" class="relative bg-[#6B7F5C]/12 py-24 md:py-32 overflow-hidden">
  <div aria-hidden="true" class="absolute top-0 right-0 w-[400px] h-[400px] rounded-full bg-[#6B7F5C]/15 blur-3xl -translate-y-1/3 translate-x-1/3"></div>
  <div class="relative max-w-content mx-auto px-6 md:px-10">
    <div class="flex items-end justify-between flex-wrap gap-6 mb-14">
      <div data-reveal>
        <p class="text-[#6B7F5C] text-[12px] uppercase tracking-[0.24em] mb-4">— Notre équipe</p>
        <h2 class="text-[#3D2A1E] leading-[0.95]" style="font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(44px,6.5vw,84px);">
          Quatre <em class="text-[#C4674C]">visages</em>, une même attention.
        </h2>
      </div>
      <p class="max-w-md text-[#3D2A1E]/75 text-[15px] leading-[1.65]">
        Tous nos aidants sont formés, mutuellisés, sourient pour de vrai. Une fois choisi, votre aidant ne change pas — la confiance, ça se bâtit.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {data.aidants.map((a, idx) => (
        <article class="group" data-reveal>
          <div class="relative aspect-[4/5] rounded-[24px] overflow-hidden ring-1 ring-[#3D2A1E]/10 mb-5">
            <img src={a.photo} alt={a.prenom} class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-[1.04]" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#3D2A1E]/40 via-transparent to-transparent"></div>
            <div class="absolute top-4 left-4 bg-[#F8F0E3]/95 rounded-full px-3 py-1.5">
              <span class="text-[11px] text-[#3D2A1E] font-medium tracking-[0.08em]">{years[idx]} · expérience</span>
            </div>
          </div>
          <h3 class="text-[#3D2A1E] text-[32px] leading-none mb-1" style="font-family:'Cormorant Garamond',serif;font-weight:500;">{a.prenom}</h3>
          <p class="text-[12px] uppercase tracking-[0.16em] text-[#C4674C] mb-3">{a.specialite}</p>
          <p class="text-[#3D2A1E]/75 rotate-[-1deg] inline-block" style="font-family:'Caveat',cursive;font-size:22px;line-height:1.35;">
            « {phrases[idx]} »
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
