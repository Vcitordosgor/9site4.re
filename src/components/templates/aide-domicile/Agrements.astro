---
/**
 * Agrements — agréments et certifications service à la personne.
 * SAP, CESU, APA/PCH, assurance.
 */
const items = [
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/>',
    label: 'Service déclaré',
    sub: 'Cadre service à la personne',
  },
  {
    icon: '<rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/><path d="M6 14h.01M10 14h2"/>',
    label: 'Accepte CESU & APA',
    sub: 'Tiers payant possible',
  },
  {
    icon: '<path d="M20 7L9 18l-5-5"/>',
    label: 'Qualité du service',
    sub: 'Engagement écrit aux familles',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    label: 'RC pro & multirisques',
    sub: 'Assurance professionnelle à jour',
  },
];
---

<section class="relative bg-doudou-ciel/30 py-18 md:py-24 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-xl mx-auto mb-12">
      <p class="scroll-reveal text-xs font-nunito font-bold uppercase tracking-[0.32em] text-doudou-bleu">
        Cadre & garanties
      </p>
      <h2 class="scroll-reveal mt-4 font-nunito font-extrabold text-doudou-encre leading-[1.05]" style="font-size: clamp(28px, 3.8vw, 42px);">
        Agréés, assurés,<br/>
        <span class="text-doudou-rose">transparents.</span>
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {items.map((it, i) => (
        <li
          class="scroll-reveal group flex flex-col items-center text-center gap-4 p-7 bg-doudou-creme rounded-2xl border-2 border-doudou-bleu/15 hover:border-doudou-bleu hover:-translate-y-1 transition-all duration-300"
          style={`transition-delay: ${i * 70}ms`}
        >
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-doudou-bleu/10 text-doudou-bleu group-hover:bg-doudou-bleu group-hover:text-doudou-creme transition-colors">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={it.icon} />
          </span>
          <div>
            <h3 class="font-nunito font-extrabold text-doudou-encre leading-tight" style="font-size: 17px;">
              {it.label}
            </h3>
            <p class="mt-1.5 font-be-vietnam text-doudou-encre/60 text-xs">
              {it.sub}
            </p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
