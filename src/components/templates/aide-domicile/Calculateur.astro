---
/**
 * Calculateur — reste à charge après crédit d'impôt 50%.
 * Vanilla JS inline, pas de lib. Input heures + select catégorie.
 * Catégorie pondère le tarif horaire moyen.
 */
const categories = [
  { id: 'menage', label: 'Ménage / repassage', taux: 22 },
  { id: 'aide', label: 'Aide à la personne', taux: 26 },
  { id: 'garde', label: 'Garde de jour', taux: 24 },
  { id: 'nuit', label: 'Présence de nuit', taux: 18 },
];
---

<section id="calculateur" class="relative bg-doudou-creme py-20 md:py-28 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-12">
      <p class="font-be-vietnam text-[11px] uppercase tracking-[0.28em] font-semibold text-doudou-bleu mb-3">
        ♡ Estimer mon reste à charge
      </p>
      <h2 class="font-nunito font-bold text-doudou-encre text-3xl md:text-5xl leading-tight">
        Combien ça coûte vraiment,
        <span class="block font-homemade text-doudou-bleu text-4xl md:text-5xl mt-2 rotate-[-1deg]">
          après crédit d'impôt 50 % ?
        </span>
      </h2>
      <p class="mt-5 font-be-vietnam text-doudou-encre/70 leading-relaxed">
        Simulation indicative. Le crédit d'impôt s'applique aux particuliers employeurs ou via un organisme agréé.
      </p>
    </header>

    <div class="grid lg:grid-cols-2 gap-6 max-w-4xl mx-auto">

      <!-- Inputs -->
      <div class="bg-doudou-bleu/5 border border-doudou-bleu/15 rounded-3xl p-7 md:p-8">
        <label class="block">
          <span class="font-be-vietnam font-semibold text-doudou-encre text-sm">Catégorie de prestation</span>
          <select id="calc-cat" class="mt-2 w-full bg-doudou-creme border border-doudou-bleu/25 rounded-xl px-4 h-12 font-be-vietnam text-doudou-encre">
            {categories.map((c) => (
              <option value={c.taux} data-label={c.label}>{c.label} — {c.taux} €/h</option>
            ))}
          </select>
        </label>

        <label class="block mt-6">
          <span class="font-be-vietnam font-semibold text-doudou-encre text-sm flex justify-between">
            <span>Heures par mois</span>
            <span id="calc-h-label" class="font-bold text-doudou-bleu tabular-nums">20 h</span>
          </span>
          <input
            id="calc-h"
            type="range"
            min="4"
            max="120"
            step="2"
            value="20"
            class="mt-3 w-full accent-doudou-bleu"
          />
          <span class="flex justify-between mt-1 text-[11px] font-be-vietnam text-doudou-encre/50">
            <span>4 h</span><span>120 h</span>
          </span>
        </label>

        <p class="mt-6 font-be-vietnam italic text-doudou-encre/65 text-sm leading-relaxed">
          Les tarifs affichés sont des moyennes indicatives. Devis personnalisé après visite gratuite.
        </p>
      </div>

      <!-- Résultat -->
      <div class="bg-doudou-bleu text-doudou-creme rounded-3xl p-7 md:p-8 flex flex-col justify-center">
        <p class="font-be-vietnam text-[10px] uppercase tracking-[0.28em] font-semibold text-doudou-soleil mb-3">
          ♡ Estimation mensuelle
        </p>

        <dl class="space-y-4">
          <div class="flex items-baseline justify-between gap-4 pb-3 border-b border-doudou-creme/15">
            <dt class="font-be-vietnam text-doudou-creme/80 text-sm">Coût brut</dt>
            <dd id="calc-brut" class="font-nunito font-bold text-doudou-creme text-2xl tabular-nums">440 €</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 pb-3 border-b border-doudou-creme/15">
            <dt class="font-be-vietnam text-doudou-creme/80 text-sm">Crédit d'impôt 50 %</dt>
            <dd id="calc-ci" class="font-nunito font-semibold text-doudou-soleil text-xl tabular-nums">– 220 €</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 pt-2">
            <dt class="font-nunito font-bold text-doudou-creme">Reste à charge</dt>
            <dd id="calc-net" class="font-nunito font-bold text-doudou-soleil text-4xl tabular-nums">220 €</dd>
          </div>
        </dl>

        <p class="mt-6 font-be-vietnam italic text-doudou-creme/75 text-sm leading-relaxed">
          Hors aides complémentaires (APA, PCH, mutuelle, caisse de retraite) qui peuvent réduire encore la note.
        </p>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const cat = document.getElementById('calc-cat');
      const h = document.getElementById('calc-h');
      const hLabel = document.getElementById('calc-h-label');
      const brut = document.getElementById('calc-brut');
      const ci = document.getElementById('calc-ci');
      const net = document.getElementById('calc-net');
      if (!cat || !h || !brut) return;
      const fmt = (n) => new Intl.NumberFormat('fr-FR').format(Math.round(n)) + ' €';
      function update() {
        const taux = parseFloat(cat.value) || 22;
        const heures = parseInt(h.value, 10) || 0;
        const b = taux * heures;
        const c = b * 0.5;
        hLabel.textContent = heures + ' h';
        brut.textContent = fmt(b);
        ci.textContent = '– ' + fmt(c);
        net.textContent = fmt(b - c);
      }
      cat.addEventListener('change', update);
      h.addEventListener('input', update);
      update();
    })();
  </script>
</section>
