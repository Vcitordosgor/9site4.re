---
const faqs = [
  { q: 'Comment marche le crédit d’impôt 50 % ?', r: 'Vous payez 100 % au départ, l’État vous rembourse 50 % via votre déclaration de revenus. Même les non-imposables y ont droit — c’est un crédit, pas une réduction.' },
  { q: 'Vous êtes agréé CESU ?', r: 'Oui. Nous émettons une attestation fiscale annuelle, acceptée par l’administration. Tout est déclaré, tout est en règle.' },
  { q: 'Que se passe-t-il si l’aidant tombe malade ?', r: 'Un remplaçant est présenté à la famille avant la première intervention. Pas de visage inconnu, jamais.' },
  { q: 'On peut commencer par une seule heure ?', r: 'Bien sûr. Beaucoup commencent par un ou deux passages par semaine, et augmentent quand la confiance est là.' },
  { q: 'Les aidants parlent créole ?', r: 'Oui, la plupart sont réunionnais. Pour les aînés, c’est souvent un déclic dès la première visite.' },
  { q: 'On peut arrêter quand on veut ?', r: 'Aucun engagement de durée. Préavis 7 jours, c’est tout. On ne retient personne.' },
];
---
<section class="bg-white py-24 md:py-32">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid lg:grid-cols-12 gap-10">
      <div class="lg:col-span-4" data-reveal>
        <p class="text-[#6B7F5C] text-[12px] uppercase tracking-[0.24em] mb-4">— Questions familles</p>
        <h2 class="text-[#3D2A1E] leading-[0.95]" style="font-family:'Cormorant Garamond',serif;font-weight:500;font-size:clamp(40px,5vw,64px);">
          Ce qu’on nous<br/><em class="text-[#C4674C]">demande souvent.</em>
        </h2>
      </div>
      <div class="lg:col-span-8 space-y-3">
        {faqs.map((f, i) => (
          <details class="group bg-[#F8F0E3] rounded-2xl px-6 py-5 ring-1 ring-[#3D2A1E]/10 hover:ring-[#C4674C]/30 transition-all" open={i === 0}>
            <summary class="cursor-pointer list-none flex items-center justify-between gap-4">
              <h3 class="text-[#3D2A1E] text-[18px] md:text-[20px] leading-snug pr-4" style="font-family:'Cormorant Garamond',serif;font-weight:500;">{f.q}</h3>
              <span class="w-8 h-8 rounded-full ring-1 ring-[#3D2A1E]/15 grid place-items-center transition-transform group-open:rotate-45 shrink-0">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3D2A1E" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <p class="mt-4 text-[#3D2A1E]/75 text-[15px] leading-[1.65]">{f.r}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>
