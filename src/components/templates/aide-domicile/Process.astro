---
/**
 * Process — de l'appel à la première visite.
 * 4 étapes douces, ton chaleureux.
 */
const steps = [
  { num: '01', titre: 'Votre appel', desc: 'Vous parlez à un humain, jamais à un robot. On écoute le besoin, sans jugement, sans vente forcée.' },
  { num: '02', titre: 'Visite à domicile', desc: 'Gratuite, sans engagement. On rencontre la personne aidée, on regarde le lieu, on évalue ensemble.' },
  { num: '03', titre: 'Mise en place', desc: 'On choisit l\'aidante avec vous (caractère, disponibilité, langues parlées). Période d\'essai d\'une semaine.' },
  { num: '04', titre: 'Suivi régulier', desc: 'Point téléphonique chaque mois, visite coordinatrice tous les 3 mois. Ajustements possibles à tout moment.' },
];
---

<section id="comment-ca-marche" class="relative bg-doudou-ciel/30 py-20 md:py-28 px-6 md:px-10 border-y-2 border-doudou-bleu/15">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="scroll-reveal text-xs font-nunito font-bold uppercase tracking-[0.32em] text-doudou-bleu">
        Comment ça se passe
      </p>
      <h2 class="scroll-reveal mt-4 font-nunito font-extrabold text-doudou-encre leading-[1.05]" style="font-size: clamp(34px, 4.5vw, 54px);">
        De votre appel<br/>
        <span class="text-doudou-rose">à la première visite.</span>
      </h2>
    </header>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
      {steps.map((s, i) => (
        <li
          class="scroll-reveal group relative p-7 bg-doudou-creme rounded-3xl border-2 border-doudou-bleu/15 hover:border-doudou-bleu hover:-translate-y-1 transition-all duration-300"
          style={`transition-delay: ${i * 80}ms; box-shadow: 0 4px 12px rgba(59,110,143,0.05);`}
        >
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-doudou-bleu text-doudou-creme font-nunito font-extrabold text-lg group-hover:bg-doudou-rose transition-colors">
            {s.num}
          </span>
          <h3 class="mt-5 font-nunito font-extrabold text-doudou-encre leading-tight" style="font-size: 22px;">
            {s.titre}
          </h3>
          <p class="mt-3 font-be-vietnam text-doudou-encre/70 leading-[1.65]" style="font-size: 14.5px;">
            {s.desc}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
