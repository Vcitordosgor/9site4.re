---
/**
 * HeroFullBleed — photo full-bleed verticale (mains/huile),
 * overlay gradient cacao bas, tagline en grand Lora italique au centre.
 * Différent du salon (split) et de la pizzeria (cards).
 */
import data from '../../../data/templates/spa.json';
---

<section class="relative isolate overflow-hidden bg-spa-cacao text-spa-creme min-h-[100svh] flex items-center justify-center">
  <!-- Photo full-bleed -->
  <img
    src={data.info.photoHero} srcset={`${(data.info.photoHero).replace(/\.webp$/, "-640.webp")} 640w, ${(data.info.photoHero).replace(/\.webp$/, "-1024.webp")} 1024w, ${data.info.photoHero} 1600w`} sizes="100vw"
    alt={data.info.photoHeroAlt}
    width="1400"
    height="1750"
    class="absolute inset-0 w-full h-full object-cover" loading="eager" fetchpriority="high" decoding="async">

  <!-- Overlay double gradient pour lisibilité (palier bas adouci pour laisser respirer la signature) -->
  <div class="absolute inset-0 bg-spa-cacao/40" aria-hidden="true"></div>
  <div class="absolute inset-0" aria-hidden="true"
       style="background: linear-gradient(180deg, rgb(58 47 38 / 0.55) 0%, rgb(58 47 38 / 0.18) 35%, rgb(58 47 38 / 0.22) 65%, rgb(58 47 38 / 0.55) 100%);">
  </div>

  <!-- Signature spa : goutte d'eau + ondulations concentriques (CSS pure) -->
  <div class="ripple-stage absolute inset-x-0 pointer-events-none z-[5]" aria-hidden="true">
    <span class="ripple ripple-1"></span>
    <span class="ripple ripple-2"></span>
    <span class="ripple ripple-3"></span>
    <span class="ripple ripple-4"></span>
    <span class="ripple-drop"></span>
  </div>

  <!-- Ornement vague terracotta supérieur -->
  <svg class="hero-ornament absolute top-24 sm:top-28 lg:top-32 left-1/2 -translate-x-1/2 w-24 h-6 text-spa-terracotta/85" viewBox="0 0 100 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
    <path d="M2 12 Q 15 4, 28 12 T 54 12 T 80 12 T 98 12" />
  </svg>

  <!-- Contenu centré -->
  <div class="relative z-10 max-w-3xl mx-auto px-6 md:px-10 text-center pt-28 pb-20">
    <p class="hero-eyebrow text-xs sm:text-sm uppercase tracking-[0.4em] text-spa-rose font-raleway font-light">
      Spa &amp; massages · La Réunion
    </p>
    <p class="hero-eyebrow mt-3 font-lora italic text-spa-creme/70 text-sm md:text-base">
      Cabines closes · accueil personnalisé
    </p>

    <h1 class="hero-title mt-8 sm:mt-10 font-lora text-spa-creme leading-[1.02]" style="font-size: clamp(48px, 10vw, 128px);">
      <span class="block font-medium">{data.info.tagline}</span>
      <span class="block italic font-normal text-spa-rose mt-1 sm:mt-2">{data.info.taglineItalic}</span>
    </h1>

    <p class="hero-intro mt-8 sm:mt-10 max-w-xl mx-auto text-spa-creme/85 font-raleway font-light leading-[1.8]" style="font-size: 17px;">
      {data.info.intro}
    </p>

    <div class="hero-cta mt-10 flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
      <a
        href="#reservation"
        class="inline-flex items-center justify-center h-14 px-8 text-sm font-semibold uppercase tracking-[0.22em] rounded-full bg-spa-terracotta text-spa-blanc hover:bg-spa-argile transition-colors"
        style="box-shadow: 0 12px 32px rgb(58 47 38 / 0.45);"
      >
        Réserver un soin
      </a>
      <a
        href="#soins"
        class="inline-flex items-center justify-center h-14 px-8 text-sm font-semibold uppercase tracking-[0.22em] rounded-full bg-transparent text-spa-creme ring-1 ring-spa-creme/40 hover:ring-spa-creme hover:bg-spa-creme/5 transition-all"
      >
        Découvrir nos soins
      </a>
    </div>
  </div>

  <!-- Indicateur scroll bas -->
  <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-spa-creme/55" aria-hidden="true">
    <span class="text-[10px] uppercase tracking-[0.3em] font-raleway">Scroll</span>
    <span class="block w-px h-10 bg-spa-creme/40 hero-scroll"></span>
  </div>
</section>

<style>
  /* Animations d'entrée — apparition contemplative très lente */
  @keyframes spa-rise {
    from { opacity: 0; transform: translateY(28px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes spa-pulse {
    0%   { transform: scaleY(0.4); transform-origin: top; opacity: 0.4; }
    50%  { transform: scaleY(1);   opacity: 1; }
    100% { transform: scaleY(0.4); transform-origin: bottom; opacity: 0.4; }
  }

  .hero-ornament { animation: spa-rise 1100ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: 200ms; }
  .hero-eyebrow  { animation: spa-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) backwards;  animation-delay: 350ms; }
  .hero-title    { animation: spa-rise 1200ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: 500ms; }
  .hero-intro    { animation: spa-rise 1000ms cubic-bezier(0.16, 1, 0.3, 1) backwards; animation-delay: 750ms; }
  .hero-cta      { animation: spa-rise 900ms cubic-bezier(0.16, 1, 0.3, 1) backwards;  animation-delay: 950ms; }
  .hero-scroll   { animation: spa-pulse 2400ms ease-in-out infinite; }

  /* Signature : goutte qui tombe + ondulations concentriques toutes les 5s
     Stage repositionné au tiers bas (laisse l'overlay tranquille) et plus large */
  .ripple-stage {
    left: 50%;
    top: 28%;
    height: 60%;
    transform: translateX(-50%);
    width: min(820px, 96vw);
  }
  .ripple-drop {
    position: absolute; left: 50%; top: 0; width: 8px; height: 18px;
    margin-left: -4px;
    background: radial-gradient(ellipse at 50% 70%, rgba(244,229,209,0.98), rgba(244,229,209,0));
    border-radius: 50%;
    filter: drop-shadow(0 0 4px rgba(244,229,209,0.45));
    animation: drop 5s cubic-bezier(0.55, 0, 0.4, 1) infinite;
  }
  .ripple {
    position: absolute; left: 50%; bottom: 18%;
    width: 90px; height: 22px;
    margin-left: -45px;
    border: 1.5px solid rgba(244,229,209,0.7);
    border-radius: 50%;
    opacity: 0;
    transform: scale(0.3);
    animation: ripple 5s cubic-bezier(0.16, 1, 0.3, 1) infinite;
    will-change: transform, opacity;
  }
  .ripple-2 { animation-delay: 0.4s; }
  .ripple-3 { animation-delay: 0.8s; }
  .ripple-4 { animation-delay: 1.2s; }
  @keyframes drop {
    0%, 58%   { transform: translateY(0); opacity: 0; }
    60%       { opacity: 1; }
    76%       { transform: translateY(42vh); opacity: 1; }
    80%, 100% { transform: translateY(44vh); opacity: 0; }
  }
  @keyframes ripple {
    0%, 76%  { transform: scale(0.3); opacity: 0; border-width: 2px; }
    80%      { opacity: 0.95; }
    100%     { transform: scale(11); opacity: 0; border-width: 0.4px; }
  }

  /* Mobile : amplitude réduite (largeur plus petite) mais ondulation toujours visible */
  @media (max-width: 640px) {
    .ripple-stage { top: 32%; height: 56%; }
    .ripple { width: 70px; height: 18px; margin-left: -35px; bottom: 14%; }
    .ripple-drop { width: 7px; height: 15px; margin-left: -3.5px; }
    @keyframes drop {
      0%, 58%   { transform: translateY(0); opacity: 0; }
      60%       { opacity: 1; }
      76%       { transform: translateY(36vh); opacity: 1; }
      80%, 100% { transform: translateY(38vh); opacity: 0; }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-ornament, .hero-eyebrow, .hero-title, .hero-intro, .hero-cta {
      animation: none !important;
      opacity: 1;
      transform: none !important;
    }
    .hero-scroll, .ripple, .ripple-drop { animation: none !important; opacity: 0 !important; }
  }
</style>
