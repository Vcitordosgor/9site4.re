<section aria-label="Rituel signature" class="bg-spa-creme py-0">
  <figure class="relative">
    <div class="aspect-[21/9] w-full overflow-hidden bg-spa-cacao">
      <img
        src="/images/spa/extra-3.webp"
        alt="Rituel signature au spa, ambiance feutrée et huiles tièdes"
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-4 flex items-baseline justify-between gap-3 flex-wrap">
      <figcaption class="font-lora italic text-spa-argile text-sm md:text-base leading-relaxed">
        Rituel signature — huiles tièdes à l'orange douce, pression lente.
      </figcaption>
      <span class="font-raleway text-[11px] uppercase tracking-[0.3em] text-spa-terracotta">90 minutes · sur rendez-vous</span>
    </div>
  </figure>
</section>
