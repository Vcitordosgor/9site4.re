---
import data from '../../../data/templates/spa.json';

const ans = new Date().getFullYear() - data.info.annee;
const chiffres = [
  { gros: ans + '', unite: 'ans', petit: 'sanctuaire ouvert sans interruption' },
  { gros: '4', unite: 'cabines', petit: 'insonorisées, lumière variable' },
  { gros: '120', unite: 'min', petit: 'rituel signature, sans montre' },
  { gros: '14', unite: 'huiles', petit: 'pressées localement, mélangées chaque matin' },
];
---

<section class="bg-spa-sable py-20 md:py-32 relative overflow-hidden">

  <svg class="absolute -right-20 -top-20 w-[400px] h-[400px] opacity-[0.10] pointer-events-none" viewBox="0 0 200 200" fill="none" stroke="#9C5B3D" stroke-width="0.7" aria-hidden="true">
    <circle cx="100" cy="100" r="90"/>
    <circle cx="100" cy="100" r="65"/>
    <circle cx="100" cy="100" r="40"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">

    <div class="text-center mb-14 md:mb-20">
      <p class="font-raleway uppercase tracking-[0.4em] text-[10px] md:text-[11px] text-spa-argile mb-4">— Le sanctuaire en quelques repères —</p>
      <h2 class="font-lora text-spa-cacao text-3xl md:text-5xl leading-tight italic">
        Quatre nombres,
        <span class="not-italic font-lora text-spa-terracotta block md:inline">aucune urgence.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-y-14 md:gap-y-20 md:gap-x-10">
      {chiffres.map((c, i) => (
        <div class={`md:col-span-6 ${i === 1 ? 'md:translate-y-12' : ''} ${i === 2 ? 'md:-translate-y-6 md:text-right' : ''} ${i === 3 ? 'md:translate-y-6 md:text-right' : ''}`}>
          <p class="font-lora italic text-spa-cacao leading-[0.85] inline-flex items-end gap-3">
            <span style="font-size:clamp(72px,14vw,150px);">{c.gros}</span>
            <span class="font-raleway not-italic uppercase tracking-[0.2em] text-spa-argile text-base md:text-xl mb-3 md:mb-6">{c.unite}</span>
          </p>
          <p class="mt-4 font-lora italic text-spa-terracotta text-xl md:text-2xl leading-snug max-w-md">{c.petit}</p>
        </div>
      ))}
    </div>
  </div>
</section>
