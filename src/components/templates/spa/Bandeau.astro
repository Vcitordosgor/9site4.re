---
import data from '../../../data/templates/spa.json';
---

<section aria-label="Reservation" class="bg-spa-terracotta text-spa-creme py-6 md:py-7">
  <div class="max-w-content mx-auto px-6 md:px-10 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-8">
    <div class="flex items-center gap-3">
      <span class="font-lora italic text-2xl md:text-3xl text-spa-creme leading-none">Sur rendez-vous</span>
      <span class="hidden md:inline font-raleway text-[11px] uppercase tracking-[0.3em] text-spa-creme/85">mardi → dimanche</span>
    </div>
    <p class="font-lora italic text-spa-creme text-base md:text-lg text-center">
      « On prend le temps qu'il faut, pour vous. »
    </p>
    <a
      href={`https://wa.me/${data.info.whatsapp}`}
      target="_blank"
      rel="noopener"
      class="inline-flex items-center justify-center h-11 px-6 bg-spa-creme text-spa-cacao font-raleway font-semibold text-[11.5px] uppercase tracking-[0.22em] rounded-full hover:bg-spa-rose transition-colors"
    >
      Reserver
    </a>
  </div>
</section>
