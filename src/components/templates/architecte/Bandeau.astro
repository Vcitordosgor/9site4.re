---
import data from '../../../data/templates/mahatma.json';
---

<section class="bg-mahatma-cachet text-mahatma-papier">
  <div class="max-w-content mx-auto px-6 md:px-10 py-10 md:py-14">
    <div class="grid grid-cols-12 gap-4 items-center">
      <div class="col-span-12 md:col-span-2">
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-papier/80">
          ▢ Engagement
        </p>
      </div>
      <div class="col-span-12 md:col-span-7">
        <p class="font-schibsted font-bold uppercase tracking-tight leading-[1] text-mahatma-papier" style="font-size: clamp(22px, 2.6vw, 36px);">
          Première rencontre <span class="font-light italic">offerte</span> · visite de site comprise.
        </p>
      </div>
      <div class="col-span-12 md:col-span-3 md:text-right">
        <a
          href="#rendez-vous"
          class="inline-flex items-center justify-center h-12 px-6 bg-mahatma-papier text-mahatma-cachet font-atkinson font-bold text-sm hover:bg-mahatma-encre hover:text-mahatma-papier transition-colors"
        >
          Réserver le RDV →
        </a>
        <p class="mt-3 font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-papier/80">
          ◯ {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
