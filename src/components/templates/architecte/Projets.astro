---
/**
 * Projets — grille portfolio architectural 8 projets.
 * Photos B&W carrées, métadonnées en mono, statut.
 */
import data from '../../../data/templates/mahatma.json';

// Fiches enrichies (mini-études de cas) par index projet — données génériques.
const fiches = [
  { surface: '280 m²',  budget: '650 – 850 k€', duree: '14 mois', contrainte: 'Pente forte, ravine voisine' },
  { surface: '180 m²',  budget: '380 – 480 k€', duree: '10 mois', contrainte: 'Orientation tropicale, alizés' },
  { surface: '420 m²',  budget: '900 k€ – 1,2 M€', duree: '18 mois', contrainte: 'Site classé, accès chantier' },
  { surface: '95 m²',   budget: '180 – 230 k€', duree: '7 mois',  contrainte: 'Extension d\'existant patrimonial' },
  { surface: '320 m²',  budget: '700 – 900 k€', duree: '15 mois', contrainte: 'Zonage PLU restrictif' },
  { surface: '210 m²',  budget: '450 – 580 k€', duree: '11 mois', contrainte: 'Vue mer, vis-à-vis à filtrer' },
  { surface: '160 m²',  budget: '320 – 410 k€', duree: '9 mois',  contrainte: 'Rénovation lourde structure bois' },
  { surface: '540 m²',  budget: '1,2 – 1,6 M€', duree: '22 mois', contrainte: 'ERP, normes accessibilité PMR' },
];
---

<section id="projets" class="bg-mahatma-papier py-24 md:py-32 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="grid grid-cols-12 gap-4 mb-12 md:mb-16">
      <div class="col-span-12 md:col-span-3">
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-cachet mb-4">
          ▢ § III
        </p>
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton">
          Portfolio · 2020 → 2024
        </p>
      </div>
      <div class="col-span-12 md:col-span-9">
        <h2 class="font-schibsted font-bold text-mahatma-encre leading-[0.95] tracking-tight uppercase" style="font-size: clamp(36px, 5vw, 64px);">
          Huit projets<br/>livrés récemment.
        </h2>
      </div>
    </header>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {data.projets.map((p, i) => (
        <li class="group">
          <article>
            <!-- Photo carrée B&W -->
            <div class="relative aspect-square overflow-hidden bg-mahatma-charbon mb-4">
              <img
                src={p.photo}
                alt={`${p.nom}, ${p.lieu} (${p.annee})`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700"
              />
              <!-- Numéro projet -->
              <span class="absolute top-3 left-3 inline-block bg-mahatma-papier text-mahatma-encre font-fira-mono text-[10px] uppercase tracking-[0.18em] px-2 py-1">
                /{String(i + 1).padStart(2, '0')}
              </span>
              {p.statut.includes('primé') && (
                <span class="absolute top-3 right-3 inline-block bg-mahatma-cachet text-mahatma-papier font-fira-mono text-[10px] uppercase tracking-[0.18em] px-2 py-1">
                  ◯ Primé
                </span>
              )}
            </div>

            <!-- Métadonnées -->
            <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton mb-1.5 tabular-nums">
              {p.annee} · {p.lieu}
            </p>
            <h3 class="font-schibsted font-bold text-mahatma-encre text-lg uppercase tracking-tight leading-tight">
              {p.nom}
            </h3>
            <p class="mt-2 font-atkinson italic text-mahatma-beton text-sm leading-snug">
              {p.typologie}
            </p>
            <p class="mt-3 pt-2 border-t border-mahatma-encre/15 font-fira-mono text-[10px] uppercase tracking-[0.18em] text-mahatma-cachet">
              ▸ {p.statut}
            </p>

            {fiches[i] && (
              <dl class="mt-3 grid grid-cols-2 gap-x-3 gap-y-1.5 font-fira-mono text-[10px] uppercase tracking-[0.18em] tabular-nums">
                <div>
                  <dt class="text-mahatma-beton">Surface</dt>
                  <dd class="text-mahatma-encre font-medium normal-case tracking-normal font-atkinson text-xs">{fiches[i].surface}</dd>
                </div>
                <div>
                  <dt class="text-mahatma-beton">Budget</dt>
                  <dd class="text-mahatma-encre font-medium normal-case tracking-normal font-atkinson text-xs">{fiches[i].budget}</dd>
                </div>
                <div>
                  <dt class="text-mahatma-beton">Durée</dt>
                  <dd class="text-mahatma-encre font-medium normal-case tracking-normal font-atkinson text-xs">{fiches[i].duree}</dd>
                </div>
                <div>
                  <dt class="text-mahatma-beton">Contrainte</dt>
                  <dd class="text-mahatma-encre font-medium normal-case tracking-normal font-atkinson text-xs">{fiches[i].contrainte}</dd>
                </div>
              </dl>
            )}
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>
