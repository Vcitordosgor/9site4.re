---
/**
 * Citation — section éditoriale plein cadre.
 */
---

<section class="bg-mahatma-papier border-t border-b border-mahatma-encre/15 py-28 md:py-40 px-6 md:px-10">
  <div class="max-w-content mx-auto">
    <div class="grid grid-cols-12 gap-4">
      <div class="col-span-12 md:col-span-2">
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-cachet mb-4">
          ▢ § II·b
        </p>
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton">
          Prise de parole
        </p>
      </div>
      <div class="col-span-12 md:col-span-10">
        <span aria-hidden="true" class="block font-schibsted font-bold text-mahatma-cachet leading-none mb-6" style="font-size: clamp(72px, 12vw, 160px);">
          &ldquo;
        </span>
        <blockquote class="font-atkinson italic text-mahatma-encre leading-[1.15] tracking-tight" style="font-size: clamp(32px, 4.5vw, 56px);">
          On ne dessine pas une maison pour qu'elle soit jolie ; on la dessine pour qu'elle <span class="text-mahatma-cachet">tienne au climat</span>, qu'elle vieillisse bien, et qu'elle reste habitable dans trente ans.
        </blockquote>
        <footer class="mt-10 pt-5 border-t border-mahatma-encre/15 flex flex-wrap items-baseline justify-between gap-3">
          <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton">
            ▸ Manifeste de l'atelier
          </p>
          <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-encre">
            Atelier Mahatma · depuis 2014
          </p>
        </footer>
      </div>
    </div>
  </div>
</section>
