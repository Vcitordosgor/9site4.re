---
/**
 * HeroProjet — projet emblématique en grande photo + grille typographique
 * stricte 12 cols. Photo B&W. Légendes en Fira Mono technique.
 */
import data from '../../../data/templates/mahatma.json';
---

<section id="top" class="relative bg-mahatma-papier overflow-hidden">

  <!-- Pattern grille technique en arrière-plan ultra-subtil -->
  <div class="absolute inset-0 pointer-events-none opacity-[0.04]" aria-hidden="true"
       style="background-image: linear-gradient(to right, #0A0A0C 1px, transparent 1px), linear-gradient(to bottom, #0A0A0C 1px, transparent 1px); background-size: 40px 40px;">
  </div>

  <div class="relative max-w-content mx-auto px-6 md:px-10 pt-32 pb-20 md:pt-44 md:pb-28">

    <!-- En-tête grille typo -->
    <div class="grid grid-cols-12 gap-4 mb-12 md:mb-16 font-fira-mono text-[10px] uppercase tracking-[0.2em] text-mahatma-beton">
      <span class="col-span-3">▢ Cabinet — Architecture · Réunion 974</span>
      <span class="col-span-6 text-center hidden sm:block">— Portfolio en cours · Première rencontre offerte —</span>
      <span class="col-span-3 text-right">{new Date().getFullYear()}</span>
    </div>

    <!-- Photo du projet + overlay plan d'architecte au survol -->
    <figure
      class="relative aspect-[16/10] mb-8 overflow-hidden bg-mahatma-papier ring-1 ring-mahatma-encre/30 hero-vivant hero-photo group"
      tabindex="0"
    >
      <!-- Photo de fond -->
      <img
        src="/images/architecte/ecole.webp"
        alt="Projet d'architecture — école livrée récemment"
        class="absolute inset-0 w-full h-full object-cover hero-photo-img"
        loading="eager"
        decoding="async"
        width="1600"
        height="1000"
      />
      <!-- Voile clair par défaut, plus opaque au survol pour révéler le plan -->
      <div class="hero-photo-veil absolute inset-0 pointer-events-none bg-mahatma-papier/0 transition-[background-color] duration-700" aria-hidden="true"></div>

      <!-- Grille millimétrée (visible avec le plan) -->
      <div class="hero-photo-grid absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-700" aria-hidden="true"
           style="background-image: linear-gradient(to right, #0A0A0C 1px, transparent 1px), linear-gradient(to bottom, #0A0A0C 1px, transparent 1px); background-size: 24px 24px;"></div>
      <div class="hero-photo-grid absolute inset-0 pointer-events-none opacity-0 transition-opacity duration-700" aria-hidden="true"
           style="background-image: linear-gradient(to right, #0A0A0C 1px, transparent 1px), linear-gradient(to bottom, #0A0A0C 1px, transparent 1px); background-size: 120px 120px;"></div>

      <!-- Plan axonométrique SVG (overlay) -->
      <svg viewBox="0 0 800 500" class="absolute inset-0 w-full h-full blueprint-svg hero-photo-plan opacity-0 transition-opacity duration-700" aria-hidden="true" preserveAspectRatio="xMidYMid meet" data-blueprint>
        <g stroke="#0A0A0C" fill="none" stroke-linecap="square" stroke-linejoin="miter" class="bp-strokes">
          <!-- Volume principal (axonométrie) -->
          <polygon points="220,220 520,220 600,160 300,160" stroke-width="1.5" fill="#0A0A0C" fill-opacity="0.04"/>
          <polygon points="520,220 520,360 600,300 600,160" stroke-width="1.5" fill="#0A0A0C" fill-opacity="0.08"/>
          <polygon points="220,220 220,360 520,360 520,220" stroke-width="1.5" fill="#0A0A0C" fill-opacity="0.02"/>
          <!-- Annexe -->
          <polygon points="100,300 220,300 220,380 100,380" stroke-width="1.2" fill="#0A0A0C" fill-opacity="0.03"/>
          <polygon points="220,300 220,380 260,355 260,275" stroke-width="1.2" fill="#0A0A0C" fill-opacity="0.06"/>
          <polygon points="100,300 220,300 260,275 140,275" stroke-width="1.2" fill="#0A0A0C" fill-opacity="0.02"/>
          <!-- Ouvertures -->
          <rect x="260" y="260" width="40" height="60" stroke-width="1"/>
          <rect x="340" y="260" width="40" height="60" stroke-width="1"/>
          <rect x="420" y="260" width="40" height="60" stroke-width="1"/>
          <!-- Toiture détail -->
          <line x1="220" y1="220" x2="300" y2="160" stroke-width="0.8" stroke-dasharray="4 3"/>
          <line x1="520" y1="220" x2="600" y2="160" stroke-width="0.8" stroke-dasharray="4 3"/>
          <!-- Cotations horizontales -->
          <line x1="220" y1="410" x2="520" y2="410" stroke-width="0.6"/>
          <line x1="220" y1="405" x2="220" y2="415" stroke-width="0.6"/>
          <line x1="520" y1="405" x2="520" y2="415" stroke-width="0.6"/>
          <!-- Axes -->
          <line x1="60" y1="220" x2="700" y2="220" stroke-width="0.4" stroke-dasharray="2 4" opacity="0.5"/>
          <line x1="370" y1="80" x2="370" y2="460" stroke-width="0.4" stroke-dasharray="2 4" opacity="0.5"/>
        </g>
        <!-- Cotation text -->
        <text x="370" y="430" text-anchor="middle" font-family="ui-monospace, monospace" font-size="11" fill="#6B6863" letter-spacing="2">12,40 m</text>
        <text x="80" y="225" font-family="ui-monospace, monospace" font-size="10" fill="#6B6863" letter-spacing="2">A</text>
        <text x="365" y="76" font-family="ui-monospace, monospace" font-size="10" fill="#6B6863" letter-spacing="2">1</text>
      </svg>

      <!-- Indice d'interaction -->
      <div class="hero-photo-hint absolute bottom-4 right-4 md:bottom-6 md:right-6 z-10 font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-papier bg-mahatma-encre/75 px-3 py-1.5 backdrop-blur-[2px] pointer-events-none transition-opacity duration-500" aria-hidden="true">
        <span class="hero-hint-default">Survol · voir le plan</span>
        <span class="hero-hint-touch hidden">Toucher · voir le plan</span>
      </div>

      <!-- Toggle plan/photo (mobile, accessible) -->
      <button
        type="button"
        class="hero-photo-toggle absolute top-4 left-4 md:top-8 md:left-8 z-10 font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-encre bg-mahatma-papier/90 ring-1 ring-mahatma-encre/40 px-3 py-1.5 hover:bg-mahatma-papier focus:outline-none focus-visible:ring-2 focus-visible:ring-mahatma-cachet"
        aria-pressed="false"
        aria-label="Afficher le plan d'architecte"
      >
        <span class="hero-toggle-on">▢ Voir le plan</span>
        <span class="hero-toggle-off hidden">▢ Voir la photo</span>
      </button>

      <!-- Cachet rouge en surimpression -->
      <div class="absolute top-4 right-4 md:top-8 md:right-8 border-2 border-mahatma-cachet text-mahatma-cachet px-3 py-1.5 font-fira-mono text-[10px] uppercase tracking-[0.22em] bg-mahatma-papier/90 transform rotate-[-3deg]">
        ◯ Récent · {data.heroProjet.annee}
      </div>

      <!-- Cartouche d'architecte (bloc d'identification de plan technique) -->
      <div class="absolute bottom-4 left-4 md:bottom-6 md:left-6 bg-mahatma-papier/95 ring-1 ring-mahatma-encre/60 shadow-sm">
        <!-- Ligne d'en-tête : nom de l'agence -->
        <p class="px-3 py-1.5 border-b border-mahatma-encre/30 font-fira-mono text-[9px] uppercase tracking-[0.28em] text-mahatma-encre">
          Atelier Mahatma <span class="text-mahatma-cachet">·</span> Cartouche
        </p>
        <!-- Grille de données technique -->
        <dl class="px-3 py-2 font-fira-mono text-[10px] uppercase tracking-[0.18em] grid grid-cols-[3.5rem_1fr] gap-x-3 gap-y-1">
          <dt class="text-mahatma-beton">N°</dt>
          <dd class="text-mahatma-encre tabular-nums">0001-A</dd>
          <dt class="text-mahatma-beton">Éch.</dt>
          <dd class="text-mahatma-encre tabular-nums">1:200</dd>
          <dt class="text-mahatma-beton">Phase</dt>
          <dd class="text-mahatma-encre">APD · plan masse</dd>
          <dt class="text-mahatma-beton">Arch.</dt>
          <dd class="text-mahatma-encre tabular-nums">M.MA · {data.heroProjet.annee}</dd>
        </dl>
      </div>
    </figure>

    <!-- Légende technique en grille -->
    <div class="grid grid-cols-12 gap-4 md:gap-8 items-baseline">

      <!-- Numéro projet -->
      <div class="col-span-12 md:col-span-2">
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton mb-2">
          Projet n°
        </p>
        <p class="font-schibsted font-light text-mahatma-encre text-3xl tabular-nums leading-none">
          0001
        </p>
      </div>

      <!-- Nom du projet -->
      <div class="col-span-12 md:col-span-7">
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton mb-2">
          Œuvre
        </p>
        <h1 class="font-schibsted font-bold text-mahatma-encre leading-[0.92] tracking-tight" style="font-size: clamp(48px, 7.5vw, 108px);">
          {data.heroProjet.nom}
        </h1>
        <p class="mt-3 font-atkinson italic text-mahatma-beton text-base md:text-lg leading-relaxed max-w-xl">
          {data.heroProjet.description}
        </p>
      </div>

      <!-- Métadonnées techniques -->
      <div class="col-span-12 md:col-span-3">
        <ul class="space-y-2 font-fira-mono text-[11px] uppercase tracking-[0.18em]">
          <li class="flex items-baseline justify-between gap-3 py-1.5 border-b border-mahatma-encre/15">
            <span class="text-mahatma-beton">Année</span>
            <span class="text-mahatma-encre tabular-nums">{data.heroProjet.annee}</span>
          </li>
          <li class="flex items-baseline justify-between gap-3 py-1.5 border-b border-mahatma-encre/15">
            <span class="text-mahatma-beton">Lieu</span>
            <span class="text-mahatma-encre">{data.heroProjet.lieu}</span>
          </li>
          <li class="flex items-baseline justify-between gap-3 py-1.5 border-b border-mahatma-encre/15">
            <span class="text-mahatma-beton">Surface</span>
            <span class="text-mahatma-encre tabular-nums">{data.heroProjet.surface}</span>
          </li>
          <li class="flex items-baseline justify-between gap-3 py-1.5">
            <span class="text-mahatma-beton">Type</span>
            <span class="text-mahatma-encre text-right">{data.heroProjet.typologie}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bandeau wordmark de l'agence + CTA discret en bas -->
    <div class="mt-20 md:mt-28 grid grid-cols-12 gap-4 items-end pt-6 border-t border-mahatma-encre/15">
      <div class="col-span-12 md:col-span-9">
        <p class="font-fira-mono text-[10px] uppercase tracking-[0.22em] text-mahatma-beton mb-3">
          ▢ Maître d'œuvre
        </p>
        <p class="font-schibsted font-bold text-mahatma-encre leading-[0.95] tracking-tight uppercase" style="font-size: clamp(36px, 6vw, 96px);">
          {data.info.wordmark}<span class="text-mahatma-cachet">.</span> {data.info.wordmark2}
        </p>
        <p class="mt-3 font-atkinson italic text-mahatma-beton text-base md:text-lg">
          {data.info.soustitre}
        </p>
      </div>
      <div class="col-span-12 md:col-span-3 md:text-right">
        <a
          href="#rendez-vous"
          class="inline-flex items-center font-atkinson font-bold text-mahatma-encre text-sm border-b-2 border-mahatma-cachet pb-1 hover:text-mahatma-cachet transition-colors"
        >
          Demander un rendez-vous →
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes hero-vivant {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }
  .hero-vivant {
    transform-origin: center;
    animation: hero-vivant 2400ms cubic-bezier(0.22, 1, 0.36, 1) both;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-vivant { animation: none !important; transform: none !important; }
  }

  /* Hero photo + plan overlay */
  .hero-photo-img {
    filter: grayscale(0.6) contrast(1.02);
    transition: filter 700ms ease, transform 1200ms ease;
  }
  .hero-photo.is-plan .hero-photo-img,
  .hero-photo:hover .hero-photo-img,
  .hero-photo:focus-within .hero-photo-img {
    filter: grayscale(1) contrast(1.1) brightness(1.05);
  }
  .hero-photo.is-plan .hero-photo-veil,
  .hero-photo:hover .hero-photo-veil,
  .hero-photo:focus-within .hero-photo-veil {
    background-color: rgba(244, 240, 232, 0.82);
  }
  .hero-photo.is-plan .hero-photo-grid,
  .hero-photo:hover .hero-photo-grid,
  .hero-photo:focus-within .hero-photo-grid {
    opacity: 0.35;
  }
  .hero-photo.is-plan .hero-photo-plan,
  .hero-photo:hover .hero-photo-plan,
  .hero-photo:focus-within .hero-photo-plan {
    opacity: 1;
  }
  .hero-photo.is-plan .hero-photo-hint,
  .hero-photo:hover .hero-photo-hint,
  .hero-photo:focus-within .hero-photo-hint {
    opacity: 0;
  }
  @media (hover: none) {
    .hero-photo-hint .hero-hint-default { display: none; }
    .hero-photo-hint .hero-hint-touch { display: inline; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-photo-img,
    .hero-photo-veil,
    .hero-photo-grid,
    .hero-photo-plan,
    .hero-photo-hint { transition: none !important; }
  }

  /* Signature : plan d'architecte qui se dessine au scroll */
  .blueprint-svg .bp-strokes > * {
    stroke-dasharray: var(--bp-len, 1200);
    stroke-dashoffset: var(--bp-len, 1200);
  }
  .blueprint-svg[data-drawn="true"] .bp-strokes > * {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1800ms cubic-bezier(0.65, 0, 0.35, 1);
    transition-delay: calc(var(--bp-i, 0) * 110ms);
  }
  .blueprint-svg text {
    opacity: 0;
    transition: opacity 600ms ease 1600ms;
  }
  .blueprint-svg[data-drawn="true"] text { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .blueprint-svg .bp-strokes > * {
      stroke-dasharray: none !important;
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }
    .blueprint-svg text { opacity: 1 !important; transition: none !important; }
  }
</style>

<script>
  (() => {
    const svg = document.querySelector<SVGSVGElement>('svg[data-blueprint]');
    if (!svg) return;
    const strokes = svg.querySelectorAll<SVGGeometryElement>('.bp-strokes > *');
    strokes.forEach((el, i) => {
      let len = 0;
      try { len = (el as any).getTotalLength ? (el as any).getTotalLength() : 0; } catch {}
      if (!len || !isFinite(len)) len = 1200;
      el.style.setProperty('--bp-len', String(Math.ceil(len)));
      el.style.setProperty('--bp-i', String(i));
    });
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) { svg.setAttribute('data-drawn', 'true'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          svg.setAttribute('data-drawn', 'true');
          io.disconnect();
        }
      });
    }, { threshold: 0.25 });
    io.observe(svg);
  })();

  // Toggle photo <-> plan (tactile & accessibilité)
  (() => {
    const fig = document.querySelector<HTMLElement>('.hero-photo');
    const btn = document.querySelector<HTMLButtonElement>('.hero-photo-toggle');
    if (!fig || !btn) return;
    const on = btn.querySelector<HTMLElement>('.hero-toggle-on');
    const off = btn.querySelector<HTMLElement>('.hero-toggle-off');
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const active = fig.classList.toggle('is-plan');
      btn.setAttribute('aria-pressed', active ? 'true' : 'false');
      btn.setAttribute('aria-label', active ? 'Afficher la photo du projet' : "Afficher le plan d'architecte");
      if (on && off) {
        on.classList.toggle('hidden', active);
        off.classList.toggle('hidden', !active);
      }
    });
  })();
</script>
