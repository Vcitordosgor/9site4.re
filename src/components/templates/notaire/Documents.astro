---
import data from '../../../data/templates/notaire.json';
---

<section id="documents" class="py-20 md:py-28" style="background-color: #F5F1EB;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-inter text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A28B5C;">— Préparer son dossier —</p>
      <h2 class="font-cormorant text-4xl md:text-6xl leading-[0.95]" style="color: #1A1715;">
        Documents
        <em class="italic" style="color: #A28B5C;">à apporter.</em>
      </h2>
      <p class="mt-5 font-inter text-[14.5px] leading-relaxed" style="color: rgb(26 23 21 / 0.78);">
        Liste indicative selon le type d'acte. Un collaborateur vous confirme
        la liste exacte par mail avant votre rendez-vous.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {data.documents.map((d, i) => (
        <article class="p-7 md:p-9 border-2" style="background-color: #FFFFFF; border-color: #1A1715;">
          <p class="font-cormorant italic text-3xl md:text-4xl leading-none mb-2" style="color: #A28B5C;">
            0{i + 1}
          </p>
          <h3 class="font-cormorant text-2xl md:text-3xl leading-tight" style="color: #1A1715;">
            {d.categorie}
          </h3>
          <div class="mt-5 pt-5 border-t" style="border-color: rgba(26, 23, 21, 0.12);">
            <ul class="space-y-3">
              {d.items.map((item) => (
                <li class="flex items-start gap-3 font-inter text-[13px] leading-snug" style="color: rgb(26 23 21 / 0.78);">
                  <svg viewBox="0 0 24 24" class="shrink-0 w-4 h-4 mt-0.5" style="color: #A28B5C;" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                    <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
