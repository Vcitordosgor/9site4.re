---
import data from '../../../data/templates/notaire.json';
---

<section id="documents" class="py-20 md:py-28" style="background-color: #F5F1EB;">
  <div class="max-w-content mx-auto px-5 md:px-10">
    <div class="max-w-3xl mb-14">
      <p class="font-inter text-[11px] uppercase tracking-[0.38em] mb-4" style="color: #A28B5C;">— Documents à fournir —</p>
      <h2 class="font-cormorant leading-[1.02]" style="color: #1A1715; font-size: clamp(34px, 5vw, 58px);">
        Préparer <em class="italic" style="color: #A28B5C;">son dossier.</em>
      </h2>
      <p class="mt-5 font-inter text-[14.5px] leading-relaxed" style="color: rgba(26,23,21,0.72);">
        Liste des pièces les plus courantes. Une fiche personnalisée vous est remise au premier rendez-vous selon votre dossier.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {data.documents.map((d, i) => (
        <article class="p-7 md:p-8 flex flex-col gap-4" style="background-color: #FFFFFF;">
          <p class="font-cormorant italic text-4xl leading-none" style="color: #A28B5C;">{String(i+1).padStart(2,'0')}</p>
          <h3 class="font-cormorant text-2xl" style="color: #1A1715;">{d.categorie}</h3>
          <ul class="space-y-2.5 font-inter text-[13.5px]" style="color: rgba(26,23,21,0.78);">
            {d.items.map((it) => (
              <li class="flex items-start gap-2.5">
                <svg viewBox="0 0 24 24" fill="none" stroke="#A28B5C" stroke-width="1.8" class="w-4 h-4 mt-0.5 shrink-0"><path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
