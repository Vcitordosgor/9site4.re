---
import data from '../../../data/templates/notaire.json';
---

<section id="contact" class="py-20 md:py-28" style="background-color: #5C2A2A; color: #F5F1EB;">

  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <p class="font-inter text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A28B5C;">— Prendre rendez-vous —</p>
      <h2 class="font-cormorant text-4xl md:text-6xl leading-[0.95]">
        Premier entretien
        <em class="italic block" style="color: #A28B5C;">gratuit.</em>
      </h2>
      <p class="mt-6 font-cormorant italic text-lg md:text-xl leading-relaxed max-w-xl mx-auto" style="color: rgb(245 241 235 / 0.85);">
        30 à 60 minutes d'écoute pour cadrer votre projet,
        ses enjeux et ses options. Sans aucun engagement.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-px max-w-4xl mx-auto" style="background-color: rgb(245 241 235 / 0.18);">

      <a
        href={`tel:${data.info.telephoneHref}`}
        class="group p-7 md:p-10 text-center transition-colors"
        style="background-color: #5C2A2A;"
        onmouseover="this.style.backgroundColor='#1A1715';"
        onmouseout="this.style.backgroundColor='#5C2A2A';"
      >
        <svg viewBox="0 0 24 24" class="w-9 h-9 mx-auto mb-4" style="color: #A28B5C;" aria-hidden="true">
          <path fill="currentColor" d="M6.62 10.79a15.46 15.46 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        <p class="font-inter text-[10.5px] uppercase tracking-[0.25em] mb-2" style="color: rgb(245 241 235 / 0.6);">
          Téléphone
        </p>
        <p class="font-cormorant text-xl md:text-2xl">
          {data.info.telephone}
        </p>
      </a>

      <a
        href={`mailto:${data.info.email}`}
        class="group p-7 md:p-10 text-center transition-colors"
        style="background-color: #5C2A2A;"
        onmouseover="this.style.backgroundColor='#1A1715';"
        onmouseout="this.style.backgroundColor='#5C2A2A';"
      >
        <svg viewBox="0 0 24 24" class="w-9 h-9 mx-auto mb-4" style="color: #A28B5C;" aria-hidden="true">
          <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <p class="font-inter text-[10.5px] uppercase tracking-[0.25em] mb-2" style="color: rgb(245 241 235 / 0.6);">
          Email
        </p>
        <p class="font-cormorant text-base md:text-lg break-all">
          {data.info.email}
        </p>
      </a>

      <a
        href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite prendre rendez-vous à l\'étude.')}`}
        target="_blank"
        rel="noopener"
        class="group p-7 md:p-10 text-center transition-colors"
        style="background-color: #5C2A2A;"
        onmouseover="this.style.backgroundColor='#1A1715';"
        onmouseout="this.style.backgroundColor='#5C2A2A';"
      >
        <svg viewBox="0 0 32 32" class="w-9 h-9 mx-auto mb-4" style="color: #A28B5C;" aria-hidden="true">
          <path fill="currentColor" d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.3.6 4.4 1.7 6.3L3 29l7.4-1.9c1.8 1 3.8 1.5 5.6 1.5 7 0 12.5-5.5 12.5-12.5S23 3 16 3zm0 22.7c-1.6 0-3.3-.4-4.7-1.2l-.3-.2-4.4 1.1 1.2-4.3-.2-.4c-1-1.6-1.5-3.4-1.5-5.2 0-5.5 4.4-9.9 9.9-9.9s9.9 4.4 9.9 9.9-4.4 10.2-9.9 10.2z"/>
        </svg>
        <p class="font-inter text-[10.5px] uppercase tracking-[0.25em] mb-2" style="color: rgb(245 241 235 / 0.6);">
          WhatsApp
        </p>
        <p class="font-cormorant text-xl md:text-2xl">
          Écrire à l'étude
        </p>
      </a>
    </div>

    <!-- Horaires -->
    <div class="mt-16 md:mt-20 text-center max-w-md mx-auto">
      <p class="font-inter text-[10.5px] uppercase tracking-[0.3em] mb-3" style="color: #A28B5C;">
        Office ouvert
      </p>
      <p class="font-cormorant text-xl md:text-2xl">{data.info.ouvertureHebdo}</p>
      <p class="mt-2 font-cormorant italic text-base" style="color: rgb(245 241 235 / 0.75);">
        {data.info.fermeture}
      </p>
    </div>
  </div>
</section>
