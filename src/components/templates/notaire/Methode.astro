---
import data from '../../../data/templates/notaire.json';
---

<section id="methode" class="py-20 md:py-28" style="background-color: #1A1715; color: #F5F1EB;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-inter text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A28B5C;">— Notre méthode —</p>
      <h2 class="font-cormorant text-4xl md:text-6xl leading-[0.95]">
        Quatre étapes,
        <em class="italic block" style="color: #A28B5C;">une rigueur constante.</em>
      </h2>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px" style="background-color: rgb(245 241 235 / 0.18);">
      {data.methode.map((m) => (
        <li class="p-7 md:p-9" style="background-color: #1A1715;">
          <p class="font-cormorant italic leading-none" style="color: #A28B5C; font-size: clamp(48px, 5vw, 72px);">
            {m.etape}
          </p>
          <div class="mt-6 mb-5 w-12 h-px" style="background-color: #A28B5C;" aria-hidden="true"></div>
          <h3 class="font-cormorant text-2xl md:text-3xl leading-tight">
            {m.titre}
          </h3>
          <p class="mt-4 font-inter text-[13px] leading-relaxed" style="color: rgb(245 241 235 / 0.7);">
            {m.texte}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
