---
import data from '../../../data/templates/notaire.json';
---

<section id="methode" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 md:mb-20 items-end">
      <div class="lg:col-span-7">
        <p class="font-inter text-[11px] uppercase tracking-[0.38em] mb-4" style="color: #A28B5C;">— Méthode —</p>
        <h2 class="font-cormorant leading-[1.02]" style="color: #1A1715; font-size: clamp(34px, 5vw, 58px);">
          Du premier mot <em class="italic" style="color: #A28B5C;">à la signature.</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="font-inter text-[14.5px] leading-relaxed" style="color: rgba(26,23,21,0.72);">
          Quatre étapes formalisées. Vous savez à tout instant où en est votre dossier, qui le pilote, quels sont les délais et les coûts à venir.
        </p>
      </div>
    </div>

    <ol class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px" style="background-color: rgba(26,23,21,0.12);">
      {data.methode.map((m) => (
        <li class="p-7 md:p-8 flex flex-col gap-4" style="background-color: #F5F1EB;">
          <span class="font-cormorant italic text-6xl leading-none" style="color: #A28B5C;">{m.etape}</span>
          <h3 class="font-cormorant text-2xl md:text-3xl" style="color: #1A1715;">{m.titre}</h3>
          <p class="font-inter text-[13.5px] leading-relaxed" style="color: rgba(26,23,21,0.78);">{m.texte}</p>
        </li>
      ))}
    </ol>

    <div class="mt-16 md:mt-24 flex flex-col items-center text-center">
      <div class="seal-wrap" data-seal>
        <div class="seal" aria-hidden="true">
          <svg viewBox="0 0 200 200" width="172" height="172" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="waxGrad" cx="38%" cy="34%" r="72%">
                <stop offset="0%" stop-color="#A12433"/>
                <stop offset="55%" stop-color="#6E1622"/>
                <stop offset="100%" stop-color="#3E0A12"/>
              </radialGradient>
            </defs>
            <circle cx="100" cy="100" r="86" fill="url(#waxGrad)"/>
            <circle cx="100" cy="100" r="86" fill="none" stroke="#2B0710" stroke-width="2" opacity="0.55"/>
            <circle cx="100" cy="100" r="72" fill="none" stroke="#F5D9A8" stroke-width="1.2" opacity="0.7"/>
            <circle cx="100" cy="100" r="66" fill="none" stroke="#F5D9A8" stroke-width="0.6" opacity="0.45" stroke-dasharray="2 3"/>
            <text x="100" y="84" text-anchor="middle" font-family="'Cormorant Garamond', serif" font-size="11" font-style="italic" fill="#F5D9A8" letter-spacing="2">Foi publique</text>
            <text x="100" y="116" text-anchor="middle" font-family="'Cormorant Garamond', serif" font-size="34" font-weight="600" fill="#F5D9A8">E.N.</text>
            <text x="100" y="134" text-anchor="middle" font-family="'Cormorant Garamond', serif" font-size="9" fill="#F5D9A8" letter-spacing="3">&amp; ASSOCIÉS</text>
            <text x="100" y="150" text-anchor="middle" font-family="'Cormorant Garamond', serif" font-size="7" fill="#F5D9A8" letter-spacing="2" opacity="0.75">RÉPUBLIQUE FRANÇAISE</text>
          </svg>
        </div>
      </div>
      <p class="mt-7 font-cormorant italic" style="color: rgba(26,23,21,0.78); font-size: clamp(18px, 2vw, 22px);">— L'acte est scellé. La parole est tenue.</p>
    </div>
  </div>
</section>

<style>
  .seal-wrap { perspective: 800px; min-height: 172px; min-width: 172px; display: inline-block; }
  .seal {
    display: inline-block;
    transform: scale(1.45) rotate(-14deg);
    opacity: 0;
    filter: drop-shadow(0 18px 24px rgba(110,22,34,0));
    will-change: transform, opacity, filter;
  }
  .seal-wrap.is-stamped .seal {
    animation: sealStamp 900ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }
  @keyframes sealStamp {
    0%   { transform: scale(1.45) rotate(-14deg); opacity: 0;   filter: drop-shadow(0 18px 24px rgba(110,22,34,0)); }
    55%  { transform: scale(0.94) rotate(-3deg);  opacity: 1;   filter: drop-shadow(0 4px 6px rgba(110,22,34,0.55)); }
    72%  { transform: scale(1.04) rotate(-5deg);                filter: drop-shadow(0 14px 22px rgba(110,22,34,0.45)); }
    100% { transform: scale(1) rotate(-4deg);     opacity: 1;   filter: drop-shadow(0 10px 18px rgba(110,22,34,0.38)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .seal { opacity: 1; transform: scale(1) rotate(-4deg); filter: drop-shadow(0 10px 18px rgba(110,22,34,0.38)); animation: none !important; }
  }
</style>

<script>
  (() => {
    if (typeof window === 'undefined') return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wrap = document.querySelector('[data-seal]');
    if (!wrap) return;
    if (reduce) { wrap.classList.add('is-stamped'); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { wrap.classList.add('is-stamped'); io.disconnect(); }
      });
    }, { threshold: 0.45 });
    io.observe(wrap);
  })();
</script>
