---
import data from '../../../data/templates/notaire.json';

const navLinks = [
  { href: '#domaines', label: 'Domaines' },
  { href: '#notaires', label: 'Les notaires' },
  { href: '#methode', label: 'Méthode' },
  { href: '#frais', label: 'Frais' },
  { href: '#documents', label: 'Documents' },
];
---

<header
  id="notaire-header"
  data-scrolled="false"
  class="sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500 border-b"
  style="background-color: rgb(245 241 235 / 0.96); border-color: rgb(26 23 21 / 0.12);"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">

    <a href="#top" class="flex items-center gap-3 group" aria-label="Étude Notariale & Associés — accueil">
      <!-- Picto blason ornemental -->
      <svg viewBox="0 0 36 36" class="w-9 h-9" style="color: #A28B5C;" aria-hidden="true">
        <path d="M18 4 L28 8 L28 18 Q28 26 18 32 Q8 26 8 18 L8 8 Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <text x="18" y="22" text-anchor="middle" font-family="serif" font-size="11" font-style="italic" fill="currentColor">N</text>
      </svg>
      <div class="flex flex-col leading-tight">
        <span class="font-cormorant italic text-lg md:text-xl" style="color: #1A1715;">Étude Notariale</span>
        <span class="font-inter text-[10px] uppercase tracking-[0.28em] mt-0.5" style="color: #A28B5C;">& Associés</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-8 font-inter text-[12px] uppercase tracking-[0.16em] font-medium" aria-label="Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors duration-300" style="color: #1A1715;" onmouseover="this.style.color='#A28B5C';" onmouseout="this.style.color='#1A1715';">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href="#contact"
      class="hidden md:inline-flex items-center justify-center h-10 px-5 font-inter font-semibold text-[12px] uppercase tracking-[0.14em] transition-colors duration-300"
      style="background-color: #1A1715; color: #F5F1EB;"
      onmouseover="this.style.backgroundColor='#A28B5C';"
      onmouseout="this.style.backgroundColor='#1A1715';"
    >
      Prendre RDV
    </a>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="md:hidden inline-flex items-center justify-center h-10 px-4 font-inter font-semibold text-[12px] uppercase tracking-wider"
      style="background-color: #1A1715; color: #F5F1EB;"
      aria-label="Appeler"
    >
      Appeler
    </a>
  </div>
</header>

<style>
  #notaire-header[data-scrolled='true'] {
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 1px 3px rgb(26 23 21 / 0.08);
  }
</style>

<script>
  const header = document.getElementById('notaire-header');
  if (header) {
    const update = () => { header.dataset.scrolled = String(window.scrollY > 8); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
