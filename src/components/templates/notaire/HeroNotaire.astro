---
import data from '../../../data/templates/notaire.json';
---

<section id="top" class="relative overflow-hidden" style="background-color: #F5F1EB;">

  <!-- Texture marbre subtile -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.05]" aria-hidden="true">
    <filter id="notaire-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.6" numOctaves="2" seed="3" />
      <feColorMatrix values="0 0 0 0 0.10  0 0 0 0 0.09  0 0 0 0 0.08  0 0 0 1 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#notaire-grain)" />
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 pt-12 md:pt-20 pb-16 md:pb-24 relative">

    <!-- Eyebrow blason -->
    <div class="text-center mb-10 md:mb-14">
      <div class="flex items-center justify-center gap-3 mb-3" aria-hidden="true">
        <span class="block w-12 h-px" style="background-color: #A28B5C;"></span>
        <svg viewBox="0 0 24 24" class="w-5 h-5" style="color: #A28B5C;" fill="currentColor" aria-hidden="true">
          <path d="M12 2 L18 4 L18 12 Q18 18 12 22 Q6 18 6 12 L6 4 Z" stroke="currentColor" stroke-width="1.2" fill="none"/>
        </svg>
        <span class="block w-12 h-px" style="background-color: #A28B5C;"></span>
      </div>
      <p class="font-inter text-[11px] md:text-[12px] uppercase tracking-[0.4em]" style="color: #A28B5C;">
        Office Notarial · La Réunion · depuis {data.info.annee}
      </p>
    </div>

    <!-- Wordmark XXL -->
    <h1 class="text-center font-cormorant leading-[0.95]" style="color: #1A1715;">
      <span class="block font-light" style="font-size: clamp(56px, 10.5vw, 132px);">
        Étude Notariale
      </span>
      <span class="block italic mt-1" style="font-size: clamp(60px, 11vw, 140px); color: #A28B5C;">
        &amp; Associés
      </span>
    </h1>

    <!-- Tagline -->
    <p class="mt-8 md:mt-10 text-center font-cormorant italic max-w-2xl mx-auto leading-snug" style="color: #1A1715; font-size: clamp(20px, 2.4vw, 28px);">
      {data.info.tagline}
    </p>

    <!-- Description -->
    <p class="mt-6 text-center font-inter text-[14px] md:text-[15px] leading-relaxed max-w-xl mx-auto" style="color: rgb(26 23 21 / 0.72);">
      Trois notaires associés, douze collaborateurs. Droit de la famille, succession,
      immobilier, sociétés. Tradition rigoureuse, accompagnement contemporain.
    </p>

    <!-- CTAs -->
    <div class="mt-10 md:mt-12 flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4">
      <a
        href="#contact"
        class="inline-flex items-center justify-center h-12 px-8 font-inter font-semibold text-[12px] uppercase tracking-[0.18em] transition-colors duration-300"
        style="background-color: #1A1715; color: #F5F1EB;"
        onmouseover="this.style.backgroundColor='#A28B5C';"
        onmouseout="this.style.backgroundColor='#1A1715';"
      >
        Premier rendez-vous offert
      </a>
      <a
        href="#domaines"
        class="inline-flex items-center justify-center h-12 px-8 font-inter font-semibold text-[12px] uppercase tracking-[0.18em] border-2 transition-colors duration-300"
        style="border-color: #1A1715; color: #1A1715;"
        onmouseover="this.style.backgroundColor='#1A1715'; this.style.color='#F5F1EB';"
        onmouseout="this.style.backgroundColor='transparent'; this.style.color='#1A1715';"
      >
        Nos domaines d'intervention
      </a>
    </div>
    <p class="mt-5 text-center font-inter text-[11px] uppercase tracking-[0.22em]" style="color: rgb(26 23 21 / 0.55);">
      Confidentialité absolue · Réponse sous 48 h ouvrées
    </p>

    <!-- Composition héraldique bas — sceau notarial CSS -->
    <div class="mt-16 md:mt-24 max-w-5xl mx-auto">
      <div class="relative aspect-[16/8] overflow-hidden border-2 flex items-center justify-center" style="border-color: #A28B5C; background-color: #1A1715;">
        <!-- Trame héraldique -->
        <div class="absolute inset-0 pointer-events-none opacity-[0.08]" aria-hidden="true"
             style="background-image: repeating-linear-gradient(45deg, #A28B5C 0 1px, transparent 1px 14px), repeating-linear-gradient(-45deg, #A28B5C 0 1px, transparent 1px 14px);"></div>

        <!-- Filets dorés haut/bas -->
        <div class="absolute top-6 left-10 right-10 h-px" style="background-color: rgba(162,139,92,0.5);" aria-hidden="true"></div>
        <div class="absolute bottom-6 left-10 right-10 h-px" style="background-color: rgba(162,139,92,0.5);" aria-hidden="true"></div>

        <!-- Mentions latérales -->
        <p class="absolute left-6 top-1/2 -translate-y-1/2 -rotate-90 origin-center font-inter text-[10px] uppercase tracking-[0.4em]" style="color: rgba(245,241,235,0.45);">Étude · Conseil · Acte</p>
        <p class="absolute right-6 top-1/2 -translate-y-1/2 rotate-90 origin-center font-inter text-[10px] uppercase tracking-[0.4em]" style="color: rgba(245,241,235,0.45);">Lex · Fides · Tempus</p>

        <!-- Sceau central -->
        <div class="relative flex flex-col items-center px-6 text-center">
          <svg viewBox="0 0 120 120" class="w-32 h-32 md:w-40 md:h-40 mb-4" aria-hidden="true">
            <circle cx="60" cy="60" r="58" fill="none" stroke="#A28B5C" stroke-width="0.8"/>
            <circle cx="60" cy="60" r="50" fill="none" stroke="#A28B5C" stroke-width="0.4" stroke-dasharray="2 3"/>
            <circle cx="60" cy="60" r="38" fill="none" stroke="#A28B5C" stroke-width="0.6"/>
            <!-- Balance -->
            <g stroke="#A28B5C" stroke-width="1.2" fill="none" stroke-linecap="round">
              <line x1="60" y1="40" x2="60" y2="78"/>
              <line x1="44" y1="50" x2="76" y2="50"/>
              <path d="M44 50 L40 64 L48 64 Z" fill="#A28B5C" fill-opacity="0.25"/>
              <path d="M76 50 L72 64 L80 64 Z" fill="#A28B5C" fill-opacity="0.25"/>
              <line x1="54" y1="78" x2="66" y2="78"/>
            </g>
          </svg>
          <p class="font-cormorant italic" style="color: #F5F1EB; font-size: clamp(20px, 2.6vw, 32px);">
            Foi publique · {data.info.annee}
          </p>
          <p class="mt-2 font-inter text-[10px] md:text-[11px] uppercase tracking-[0.4em]" style="color: #A28B5C;">
            Office Notarial · La Réunion
          </p>
        </div>
      </div>
    </div>

    <!-- Chiffres bas -->
    <div class="mt-12 md:mt-16 grid grid-cols-3 gap-4 md:gap-8 max-w-3xl mx-auto">
      <div class="text-center">
        <p class="font-cormorant italic text-3xl md:text-5xl leading-none" style="color: #A28B5C;">27</p>
        <p class="mt-2 font-inter text-[10.5px] uppercase tracking-[0.2em]" style="color: rgb(26 23 21 / 0.65);">ans d'office</p>
      </div>
      <div class="text-center">
        <p class="font-cormorant italic text-3xl md:text-5xl leading-none" style="color: #A28B5C;">3</p>
        <p class="mt-2 font-inter text-[10.5px] uppercase tracking-[0.2em]" style="color: rgb(26 23 21 / 0.65);">notaires associés</p>
      </div>
      <div class="text-center">
        <p class="font-cormorant italic text-3xl md:text-5xl leading-none" style="color: #A28B5C;">12</p>
        <p class="mt-2 font-inter text-[10.5px] uppercase tracking-[0.2em]" style="color: rgb(26 23 21 / 0.65);">collaborateurs</p>
      </div>
    </div>
  </div>
</section>
