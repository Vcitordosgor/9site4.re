---
import data from '../../../data/templates/notaire.json';
---

<section class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-3xl mx-auto px-6 md:px-10">

    <div class="text-center mb-12 md:mb-16">
      <p class="font-inter text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A28B5C;">— Questions fréquentes —</p>
      <h2 class="font-cormorant text-4xl md:text-6xl leading-[0.95]" style="color: #1A1715;">
        Avant de pousser
        <em class="italic" style="color: #A28B5C;">la porte.</em>
      </h2>
    </div>

    <div class="space-y-3">
      {data.faq.map((f) => (
        <details class="group border-2 transition-colors" style="background-color: #F5F1EB; border-color: rgba(26, 23, 21, 0.15);" onmouseover="this.style.borderColor='#A28B5C';" onmouseout="this.style.borderColor='rgba(26, 23, 21, 0.15)';">
          <summary class="cursor-pointer list-none flex items-start gap-4 p-5 md:p-7">
            <span class="font-cormorant italic text-3xl leading-none mt-0.5 transition-transform duration-300 group-open:rotate-45" style="color: #A28B5C;" aria-hidden="true">+</span>
            <span class="flex-1 font-cormorant text-lg md:text-xl leading-snug" style="color: #1A1715;">{f.q}</span>
          </summary>
          <div class="px-5 md:px-7 pb-6 md:pb-8 pl-14 md:pl-16">
            <p class="font-inter text-[13.5px] leading-relaxed" style="color: rgb(26 23 21 / 0.78);">{f.r}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
