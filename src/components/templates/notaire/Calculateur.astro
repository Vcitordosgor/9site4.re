---
/* Simulateur frais de notaire — ancien ~8%, neuf ~3% — formule indicative. */
---

<section id="calculateur" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 items-end mb-12">
      <div class="md:col-span-7">
        <p class="font-inter text-[11px] uppercase tracking-[0.38em] mb-4" style="color: #A28B5C;">— Simulateur —</p>
        <h2 class="font-cormorant leading-[1.02]" style="color: #1A1715; font-size: clamp(34px, 5vw, 58px);">
          Estimez vos <em class="italic" style="color: #A28B5C;">frais.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-inter text-[14px] leading-relaxed" style="color: rgba(26,23,21,0.72);">
          Estimation indicative basée sur les barèmes en vigueur. Le détail exact dépend du bien, de la commune et de votre situation.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-px border-2" style="background-color: rgba(26,23,21,0.1); border-color: #1A1715;">

      <form data-notaire-calc class="lg:col-span-6 p-7 md:p-10 flex flex-col gap-6" style="background-color: #F5F1EB;" onsubmit="event.preventDefault();">
        <div>
          <div class="flex items-baseline justify-between mb-2">
            <label for="notaire-calc-prix" class="font-cormorant text-xl md:text-2xl" style="color: #1A1715;">Prix du bien</label>
            <span class="font-cormorant text-2xl tabular-nums" style="color: #1A1715;"><span data-notaire-prix-out>250 000</span> <span style="color: #A28B5C;">€</span></span>
          </div>
          <input id="notaire-calc-prix" name="prix" type="range" min="50000" max="2000000" step="5000" value="250000" class="w-full notaire-slider" aria-label="Prix du bien en euros" />
          <div class="flex justify-between mt-1 font-inter text-[10px] uppercase tracking-[0.18em]" style="color: rgba(26,23,21,0.5);">
            <span>50 k€</span>
            <span>2 M€</span>
          </div>
        </div>

        <div>
          <p class="block font-cormorant text-xl md:text-2xl mb-3" style="color: #1A1715;">Type de bien</p>
          <div role="radiogroup" class="grid grid-cols-2 gap-3">
            <label class="cursor-pointer">
              <input type="radio" name="type" value="ancien" class="peer sr-only" checked />
              <span class="block px-5 py-4 border-2 font-cormorant text-lg text-center peer-checked:bg-[#1A1715] peer-checked:text-[#F5F1EB]" style="background-color: #FFFFFF; color: #1A1715; border-color: #1A1715;">
                Ancien
                <span class="block font-inter text-[11px] uppercase tracking-wider mt-1 opacity-70">~ 8 %</span>
              </span>
            </label>
            <label class="cursor-pointer">
              <input type="radio" name="type" value="neuf" class="peer sr-only" />
              <span class="block px-5 py-4 border-2 font-cormorant text-lg text-center peer-checked:bg-[#1A1715] peer-checked:text-[#F5F1EB]" style="background-color: #FFFFFF; color: #1A1715; border-color: #1A1715;">
                Neuf / VEFA
                <span class="block font-inter text-[11px] uppercase tracking-wider mt-1 opacity-70">~ 3 %</span>
              </span>
            </label>
          </div>
        </div>

        <div>
          <div class="flex items-baseline justify-between mb-2">
            <label for="notaire-calc-taux" class="font-cormorant text-xl md:text-2xl" style="color: #1A1715;">Taux ajusté</label>
            <span class="font-cormorant text-2xl tabular-nums" style="color: #A28B5C;"><span data-notaire-taux-out>8.0</span> %</span>
          </div>
          <input id="notaire-calc-taux" name="taux" type="range" min="2" max="9" step="0.1" value="8" class="w-full notaire-slider" />
          <div class="flex justify-between mt-1 font-inter text-[10px] uppercase tracking-[0.18em]" style="color: rgba(26,23,21,0.5);">
            <span>Neuf 2 %</span>
            <span>Ancien 9 %</span>
          </div>
        </div>

        <p class="font-inter italic text-[12px]" style="color: rgba(26,23,21,0.6);">Sélectionnez Ancien / Neuf, puis affinez selon la commune. Aucune donnée n'est transmise.</p>
      </form>

      <div class="lg:col-span-6 p-7 md:p-10 flex flex-col justify-center" style="background-color: #1A1715; color: #F5F1EB;">
        <p class="font-inter text-[11px] uppercase tracking-[0.38em]" style="color: #A28B5C;">— Estimation des frais —</p>
        <p class="mt-5 font-cormorant italic text-xl" style="color: rgba(245,241,235,0.7);">Total des frais de notaire</p>
        <p class="mt-2 font-cormorant leading-none" style="font-size: clamp(48px, 7vw, 80px);">
          <span data-notaire-total>20 000</span> <span class="text-3xl md:text-4xl" style="color: #A28B5C;">€</span>
        </p>

        <dl class="mt-8 pt-6 border-t space-y-2.5 font-inter text-[13px]" style="border-color: rgba(245,241,235,0.2);">
          <div class="flex justify-between"><dt class="opacity-75">Taux appliqué</dt><dd class="font-medium"><span data-notaire-taux>8</span> %</dd></div>
          <div class="flex justify-between"><dt class="opacity-75">Prix net vendeur</dt><dd class="font-medium tabular-nums"><span data-notaire-prix>250 000</span> €</dd></div>
          <div class="flex justify-between"><dt class="opacity-75">Coût d'acquisition global</dt><dd class="font-medium tabular-nums"><span data-notaire-cout>270 000</span> €</dd></div>
        </dl>

        <p class="mt-6 font-inter italic text-[12px]" style="color: rgba(245,241,235,0.6);">
          Estimation regroupant droits, émoluments et débours. Chiffrage précis sur rendez-vous.
        </p>
      </div>
    </div>
  </div>

  <style>
    .notaire-slider { -webkit-appearance: none; appearance: none; width: 100%; height: 4px; background: #1A1715; outline: none; }
    .notaire-slider::-webkit-slider-thumb { -webkit-appearance: none; appearance: none; width: 22px; height: 22px; background: #A28B5C; border: 2px solid #1A1715; cursor: pointer; transition: transform 0.15s ease; }
    .notaire-slider::-moz-range-thumb { width: 22px; height: 22px; background: #A28B5C; border: 2px solid #1A1715; cursor: pointer; transition: transform 0.15s ease; }
    .notaire-slider:hover::-webkit-slider-thumb { transform: scale(1.15); }
    .notaire-slider:hover::-moz-range-thumb { transform: scale(1.15); }
  </style>

  <script>
    (function () {
      const form = document.querySelector('[data-notaire-calc]');
      if (!form) return;
      const prix = form.querySelector('#notaire-calc-prix') as HTMLInputElement;
      const radios = form.querySelectorAll<HTMLInputElement>('input[name="type"]');
      const outTotal = document.querySelector('[data-notaire-total]');
      const outTaux  = document.querySelector('[data-notaire-taux]');
      const outPrix  = document.querySelector('[data-notaire-prix]');
      const outCout  = document.querySelector('[data-notaire-cout]');
      const fmt = (n: number) => Math.round(n).toLocaleString('fr-FR');
      const tauxInput = form.querySelector('#notaire-calc-taux') as HTMLInputElement;
      const outTauxSlider = form.querySelector('[data-notaire-taux-out]');
      const outPrixSlider = form.querySelector('[data-notaire-prix-out]');
      const update = () => {
        const p = Math.max(0, Number(prix.value) || 0);
        const t = Math.max(0, Number(tauxInput.value) || 0);
        const total = p * (t / 100);
        if (outTotal) outTotal.textContent = fmt(total);
        if (outTaux)  outTaux.textContent  = t.toFixed(1);
        if (outPrix)  outPrix.textContent  = fmt(p);
        if (outCout)  outCout.textContent  = fmt(p + total);
        if (outTauxSlider) outTauxSlider.textContent = t.toFixed(1);
        if (outPrixSlider) outPrixSlider.textContent = fmt(p);
      };
      prix.addEventListener('input', update);
      tauxInput.addEventListener('input', update);
      radios.forEach((r) => r.addEventListener('change', () => {
        // Switching type repositionne le slider sur la valeur typique
        tauxInput.value = r.value === 'neuf' ? '3' : '8';
        update();
      }));
      update();
    })();
  </script>
</section>
