---
import data from '../../../data/templates/notaire.json';
const notaires = data.notaires;
const photos = ['/images/notaire/extra-1.webp', '/images/notaire/extra-2.webp', '/images/notaire/extra-3.webp'];
---

<section id="notaires" class="py-20 md:py-28" style="background-color: #F5F1EB;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="max-w-3xl mb-14">
      <p class="font-inter text-[11px] uppercase tracking-[0.38em] mb-4" style="color: #A28B5C;">— Les notaires de l'étude —</p>
      <h2 class="font-cormorant leading-[1.02]" style="color: #1A1715; font-size: clamp(34px, 5vw, 58px);">
        Trois associés, <em class="italic" style="color: #A28B5C;">une signature collective.</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {notaires.map((n, i) => (
        <article class="flex flex-col" style="background-color: #FFFFFF;">
          <div class="aspect-[4/5] overflow-hidden">
            <img src={photos[i % photos.length]} alt={`Notaire associé — ${n.specialite}`} loading="lazy" class="w-full h-full object-cover" />
          </div>
          <div class="p-7 md:p-8 flex flex-col gap-2">
            <p class="font-inter text-[10.5px] uppercase tracking-[0.28em]" style="color: #A28B5C;">{n.role}</p>
            <h3 class="font-cormorant text-3xl md:text-4xl" style="color: #1A1715;">{n.nom}</h3>
            <p class="font-cormorant italic text-base mt-1" style="color: rgba(26,23,21,0.75);">{n.specialite}</p>
          </div>
        </article>
      ))}
    </div>

    <p class="mt-10 font-inter italic text-[12.5px] max-w-2xl" style="color: rgba(26,23,21,0.6);">
      Identités stylisées par initiales — démo fictive. Pour une vraie étude, les notaires sont nommément présentés avec leurs photos officielles.
    </p>
  </div>
</section>
