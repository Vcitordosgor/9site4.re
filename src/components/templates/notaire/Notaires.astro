---
import data from '../../../data/templates/notaire.json';
---

<section id="notaires" class="py-20 md:py-28" style="background-color: #F5F1EB;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-inter text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A28B5C;">— Les associés —</p>
      <h2 class="font-cormorant text-4xl md:text-6xl leading-[0.95]" style="color: #1A1715;">
        Trois notaires,
        <em class="italic block" style="color: #A28B5C;">une signature commune.</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {data.notaires.map((n) => (
        <article class="group">
          <div class="relative aspect-[3/4] overflow-hidden">
            <img
              src={n.photo}
              alt={`Portrait de ${n.nom}, ${n.role}`}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <!-- Bandeau anciennete -->
            <div class="absolute inset-x-0 bottom-0 px-4 py-3" style="background-color: rgb(26 23 21 / 0.88);">
              <p class="font-inter text-[10px] uppercase tracking-[0.22em]" style="color: #A28B5C;">
                ✦ {n.anciennete}
              </p>
            </div>
          </div>

          <div class="mt-5">
            <h3 class="font-cormorant text-2xl md:text-3xl leading-tight" style="color: #1A1715;">
              {n.nom}
            </h3>
            <p class="mt-1 font-inter text-[11px] uppercase tracking-[0.22em] font-semibold" style="color: #A28B5C;">
              {n.role}
            </p>
            <p class="mt-3 font-cormorant italic text-lg md:text-xl leading-snug" style="color: rgb(26 23 21 / 0.85);">
              {n.specialite}
            </p>
            <p class="mt-3 font-inter text-[11.5px] uppercase tracking-wider" style="color: rgb(26 23 21 / 0.55);">
              {n.diplome}
            </p>
            <p class="mt-4 font-inter text-[13px] leading-relaxed" style="color: rgb(26 23 21 / 0.75);">
              {n.bio}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
