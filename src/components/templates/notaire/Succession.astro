---
/**
 * Succession — 2ᵉ signature notaire.
 * Timeline 5 actes révélés au scroll : Acceptation → Inventaire → Évaluation → Partage → Acte authentique.
 * Lignes verticales qui se tracent + cachet de cire qui apparaît à chaque étape.
 */
const actes = [
  { num: 'I',   titre: 'Acceptation',     legende: 'Les héritiers acceptent ou renoncent. Délai légal de 4 mois.', duree: 'Semaine 1' },
  { num: 'II',  titre: 'Inventaire',      legende: 'Recensement des biens, des dettes, des comptes du défunt.',     duree: 'Semaines 2-6' },
  { num: 'III', titre: 'Évaluation',      legende: 'Estimation des actifs au jour du décès — base de calcul fiscal.', duree: 'Mois 2' },
  { num: 'IV',  titre: 'Partage',         legende: 'Répartition entre héritiers selon volonté et réserve légale.',   duree: 'Mois 3-5' },
  { num: 'V',   titre: 'Acte authentique', legende: 'Signature de la déclaration de succession et de la dévolution.', duree: 'Mois 6' },
];
---

<section id="succession" class="py-20 md:py-28" style="background-color: #F5F1EB;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <header class="mb-14 md:mb-20 max-w-2xl">
      <p class="font-inter text-[11px] uppercase tracking-[0.38em] mb-4" style="color: #A28B5C;">— Succession —</p>
      <h2 class="font-cormorant leading-[1.02]" style="color: #1A1715; font-size: clamp(34px, 5vw, 58px);">
        Cinq actes,<br/>
        <em class="italic" style="color: #A28B5C;">une démarche apaisée.</em>
      </h2>
      <p class="mt-6 font-inter text-[14px] md:text-[15px] leading-relaxed max-w-xl" style="color: rgba(26,23,21,0.72);">
        L'ouverture d'une succession suit cinq étapes que nous menons à votre rythme. Chaque acte est expliqué, chaque délai anticipé.
      </p>
    </header>

    <ol class="succession-list relative">
      <span class="succession-rail absolute left-5 md:left-1/2 top-0 bottom-0 w-px md:-translate-x-1/2" aria-hidden="true" style="background-color: rgba(26,23,21,0.15);"></span>

      {actes.map((a, i) => (
        <li class={`succession-acte relative md:grid md:grid-cols-2 md:gap-12 mb-12 md:mb-16 ${i % 2 === 0 ? 'md:[&>div]:col-start-1' : 'md:[&>div]:col-start-2'}`}>
          <span class="succession-sceau absolute left-5 md:left-1/2 top-1 -translate-x-1/2 w-10 h-10 rounded-full flex items-center justify-center font-cormorant text-base font-medium z-10"
                style="background-color: #1A1715; color: #F5F1EB; border: 2px solid #A28B5C;"
                aria-hidden="true">{a.num}</span>

          <div class={`pl-16 md:pl-0 ${i % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:col-start-2 md:pl-12'}`}>
            <p class="font-inter text-[11px] uppercase tracking-[0.32em] mb-2" style="color: #A28B5C;">{a.duree}</p>
            <h3 class="font-cormorant text-2xl md:text-3xl mb-3" style="color: #1A1715;">{a.titre}</h3>
            <p class="font-inter text-[14px] leading-relaxed max-w-md md:inline-block" style="color: rgba(26,23,21,0.72);">{a.legende}</p>
          </div>
        </li>
      ))}
    </ol>

  </div>
</section>

<style>
  .succession-acte { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
  .succession-acte.is-visible { opacity: 1; transform: translateY(0); }
  .succession-sceau { opacity: 0; transform: translateX(-50%) scale(0.4); transition: opacity 0.5s ease, transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .succession-acte.is-visible .succession-sceau { opacity: 1; transform: translateX(-50%) scale(1); }
  @media (prefers-reduced-motion: reduce) {
    .succession-acte, .succession-sceau { opacity: 1 !important; transform: none !important; transition: none !important; }
    .succession-sceau { transform: translateX(-50%) !important; }
  }
</style>

<script>
  (() => {
    const items = document.querySelectorAll('.succession-acte');
    if (!items.length) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.25, rootMargin: '0px 0px -60px 0px' });
    items.forEach((el) => io.observe(el));
  })();
</script>
