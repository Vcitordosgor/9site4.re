---
import data from '../../../data/templates/notaire.json';
---

<section id="frais" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">

      <!-- Bloc gauche : intro -->
      <div class="md:col-span-5">
        <p class="font-inter text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A28B5C;">— Frais & honoraires —</p>
        <h2 class="font-cormorant text-4xl md:text-5xl leading-tight" style="color: #1A1715;">
          Transparence
          <em class="italic block" style="color: #A28B5C;">avant toute signature.</em>
        </h2>
        <p class="mt-6 font-inter text-[14px] leading-relaxed" style="color: rgb(26 23 21 / 0.78);">
          Les frais notariés se composent de quatre catégories distinctes.
          Pour chaque dossier, un devis détaillé vous est fourni avant tout engagement,
          poste par poste.
        </p>

        <!-- Note -->
        <div class="mt-8 p-5 border-l-4" style="background-color: #F5F1EB; border-color: #A28B5C;">
          <p class="font-cormorant italic text-base md:text-lg leading-snug" style="color: #1A1715;">
            « L'honoraire est tarifé. L'écoute, elle, ne l'est jamais. »
          </p>
          <p class="mt-2 font-inter text-[11px] uppercase tracking-[0.2em]" style="color: rgb(26 23 21 / 0.6);">
            — Maître Patricia Lefèvre
          </p>
        </div>
      </div>

      <!-- Liste catégories -->
      <div class="md:col-span-7">
        <ul class="space-y-px" style="background-color: rgba(26, 23, 21, 0.18);">
          {data.frais.map((f, i) => (
            <li class="grid grid-cols-12 gap-4 items-start p-6 md:p-7" style="background-color: #FFFFFF;">
              <div class="col-span-1">
                <p class="font-cormorant italic text-2xl md:text-3xl leading-none" style="color: #A28B5C;">
                  0{i + 1}
                </p>
              </div>
              <div class="col-span-11">
                <h3 class="font-cormorant text-xl md:text-2xl leading-tight" style="color: #1A1715;">
                  {f.categorie}
                </h3>
                <p class="mt-2 font-inter text-[12.5px] italic" style="color: rgb(26 23 21 / 0.65);">
                  Ex. {f.exemple}
                </p>
                <p class="mt-3 font-inter text-[12.5px] uppercase tracking-[0.15em] font-semibold" style="color: #A28B5C;">
                  ✦ {f.indication}
                </p>
              </div>
            </li>
          ))}
        </ul>

        <p class="mt-6 font-inter text-[11.5px] text-center" style="color: rgb(26 23 21 / 0.6);">
          ✦ Simulation gratuite des frais sur demande, sous 48h ✦
        </p>
      </div>
    </div>
  </div>
</section>
