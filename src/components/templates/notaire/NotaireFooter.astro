---
import data from '../../../data/templates/notaire.json';
---

<footer style="background-color: #1A1715; color: #F5F1EB;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 36 36" class="w-10 h-10" style="color: #A28B5C;" aria-hidden="true">
            <path d="M18 4 L28 8 L28 18 Q28 26 18 32 Q8 26 8 18 L8 8 Z" stroke="currentColor" stroke-width="1.5" fill="none"/>
            <text x="18" y="22" text-anchor="middle" font-family="serif" font-size="11" font-style="italic" fill="currentColor">N</text>
          </svg>
          <div class="leading-tight">
            <p class="font-cormorant italic text-2xl">Étude Notariale</p>
            <p class="font-inter text-[11px] uppercase tracking-[0.25em] mt-1" style="color: #A28B5C;">& Associés</p>
          </div>
        </div>
        <p class="mt-5 font-inter text-[13.5px] leading-relaxed max-w-sm" style="color: rgb(245 241 235 / 0.78);">
          {data.info.tagline} — Office notarial à La Réunion depuis {data.info.annee}.
          Trois notaires associés, douze collaborateurs.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-inter text-[10px] uppercase tracking-[0.25em] mb-3" style="color: #A28B5C;">Office</p>
        <ul class="space-y-2 font-cormorant text-[15px]">
          <li><a href="#domaines" class="transition-colors hover:underline">Nos domaines</a></li>
          <li><a href="#notaires" class="transition-colors hover:underline">Les notaires</a></li>
          <li><a href="#methode" class="transition-colors hover:underline">Notre méthode</a></li>
          <li><a href="#frais" class="transition-colors hover:underline">Frais</a></li>
          <li><a href="#documents" class="transition-colors hover:underline">Documents</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-inter text-[10px] uppercase tracking-[0.25em] mb-3" style="color: #A28B5C;">Contact</p>
        <ul class="space-y-2 font-cormorant text-[15px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="hover:underline">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="hover:underline">{data.info.email}</a></li>
          <li style="color: rgb(245 241 235 / 0.6);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-inter text-[11px]" style="border-color: rgb(162 139 92 / 0.3); color: rgb(245 241 235 / 0.55);">
      <p>© {data.info.annee}–2026 {data.info.nom} · Office notarial à La Réunion</p>
      <p class="font-cormorant italic text-base" style="color: #A28B5C;">— L'acte qui sécurise.</p>
    </div>
  </div>
</footer>
