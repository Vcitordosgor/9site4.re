---
import data from '../../../data/templates/notaire.json';
---

<section id="domaines" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 mb-14 md:mb-20 items-end">
      <div class="lg:col-span-7">
        <p class="font-inter text-[11px] uppercase tracking-[0.38em] mb-4" style="color: #A28B5C;">— Domaines d'intervention —</p>
        <h2 class="font-cormorant leading-[1.02]" style="color: #1A1715; font-size: clamp(34px, 5vw, 58px);">
          Quatre expertises, <em class="italic" style="color: #A28B5C;">un seul interlocuteur.</em>
        </h2>
      </div>
      <div class="lg:col-span-5">
        <p class="font-inter text-[14.5px] leading-relaxed" style="color: rgba(26,23,21,0.72);">
          L'office regroupe les compétences principales du droit civil et des affaires. Un notaire référent vous est désigné dès le premier rendez-vous.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px" style="background-color: rgba(26,23,21,0.12);">
      {data.domaines.map((d, i) => (
        <article id={d.id} class="p-8 md:p-10 flex flex-col gap-5" style="background-color: #FFFFFF;">
          <div class="flex items-baseline justify-between">
            <span class="font-cormorant italic text-5xl leading-none" style="color: #A28B5C;">{String(i+1).padStart(2,'0')}</span>
            <span class="font-inter text-[10px] uppercase tracking-[0.22em]" style="color: rgba(26,23,21,0.5);">Domaine {String(i+1).padStart(2,'0')} / 04</span>
          </div>
          <h3 class="font-cormorant text-3xl md:text-4xl leading-tight" style="color: #1A1715;">{d.nom}</h3>
          <p class="font-cormorant italic text-lg" style="color: #A28B5C;">{d.tagline}</p>
          <p class="font-inter text-[14px] leading-relaxed" style="color: rgba(26,23,21,0.78);">{d.description}</p>

          <ul class="mt-2 pt-5 border-t grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2 font-inter text-[13px]" style="border-color: rgba(26,23,21,0.12); color: rgba(26,23,21,0.78);">
            {d.actes.map((a) => (
              <li class="flex items-start gap-2">
                <span class="mt-2 block w-1 h-1 shrink-0" style="background-color: #A28B5C;"></span>
                <span>{a}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>
