---
import data from '../../../data/templates/marlene.json';
---

<section class="bg-marlene-noir text-marlene-nacre py-28 md:py-40 px-6 md:px-10 relative overflow-hidden">
  <div class="absolute top-10 left-10 right-10 h-px bg-marlene-champagne/40" aria-hidden="true"></div>
  <div class="absolute bottom-10 left-10 right-10 h-px bg-marlene-champagne/40" aria-hidden="true"></div>

  <div class="max-w-4xl mx-auto relative text-center">
    <p class="font-mulish text-[10px] uppercase tracking-[0.4em] text-marlene-champagne mb-10">
      — credo de la maison —
    </p>
    <blockquote class="font-eb-garamond italic text-marlene-nacre leading-[1.15]" style="font-size:clamp(28px,5vw,56px);">
      Aucun forfait poussé, aucun produit revendu sans nécessité. Vous repartez avec ce dont vous avez besoin — rien d'autre.
    </blockquote>
    <div class="mt-12 flex items-center justify-center gap-4" aria-hidden="true">
      <span class="block w-16 h-px bg-marlene-champagne"></span>
      <span class="font-eb-garamond italic text-marlene-champagne text-xl">M.</span>
      <span class="block w-16 h-px bg-marlene-champagne"></span>
    </div>
    <p class="mt-6 font-mulish text-[11px] uppercase tracking-[0.32em] text-marlene-rose">
      {data.info.fondatrice} · fondatrice
    </p>
  </div>
</section>
