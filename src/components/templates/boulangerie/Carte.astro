---
const pains = [
  { nom: 'Tradition au levain', poids: '500g', prix: '4,80 €', desc: 'Farine T80 bio, croûte caramélisée, mie alvéolée. Le pain de tous les jours.', photo: '/images/boulangerie/extra-2.webp' },
  { nom: 'Miche campagne', poids: '900g', prix: '7,90 €', desc: 'T80 + T130, fermentation 30h. Pour la table familiale, se conserve une semaine.', photo: '/images/boulangerie/extra-3.webp' },
  { nom: 'Pain sarrasin péi', poids: '450g', prix: '5,60 €', desc: 'Sarrasin local + blé, sans gluten ajouté. Note grillée, mie dense.' },
  { nom: 'Demi-complet bourbon', poids: '500g', prix: '5,20 €', desc: 'Blé bourbon T110, son apparent, légèrement noisetté.' },
  { nom: 'Pain de seigle', poids: '600g', prix: '6,40 €', desc: 'Seigle pur, levain seigle dédié, idéal sur huîtres et fromages.' },
  { nom: 'Brioche au beurre', poids: '400g', prix: '8,90 €', desc: 'Beurre AOP, jaunes d\'œufs fermiers, pousse lente 18h. Le samedi seulement.', photo: '/images/boulangerie/extra-4.webp' },
];
---
<section id="carte" class="py-24 md:py-32" style="background:#F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <p class="font-caveat text-2xl mb-2" style="color:#7A5C28;">la carte —</p>
      <h2 class="font-crimson-pro text-5xl md:text-6xl leading-tight" style="color:#1A1614;">Six pains, <em class="italic" style="color:#C89B3C;">pas un de plus.</em></h2>
    </div>
    <div class="grid md:grid-cols-2 gap-px" style="background:rgba(26,22,20,0.15);">
      {pains.map(p => (
        <article class="p-6 md:p-8 flex gap-5" style="background:#F5EBD5;">
          {p.photo && <div class="w-28 h-28 flex-shrink-0 overflow-hidden"><img src={p.photo} alt={p.nom} class="w-full h-full object-cover" loading="lazy"/></div>}
          <div class="flex-grow">
            <div class="flex items-baseline justify-between gap-3 mb-1">
              <h3 class="font-crimson-pro text-2xl" style="color:#1A1614;">{p.nom}</h3>
              <span class="font-crimson-pro text-xl" style="color:#C89B3C;">{p.prix}</span>
            </div>
            <div class="text-[11px] uppercase tracking-[0.22em] mb-2" style="color:#7A5C28;">{p.poids}</div>
            <p class="text-[14px] leading-relaxed" style="color:#3A3128;">{p.desc}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
