---
import data from '../../../data/templates/painleve.json';
---

<section id="calendrier" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-16">
      <p class="font-crimson-pro text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #7A4A2A;">— Une fournée par jour —</p>
      <h2 class="font-crimson-pro font-semibold leading-[0.95]" style="color: #1A1614; font-size: clamp(36px, 5vw, 56px);">
        Calendrier
        <em class="block font-caveat not-italic mt-2" style="color: #C89B3C; font-size: clamp(44px, 6vw, 64px);">de cuisson</em>
      </h2>
      <p class="mt-5 font-crimson-pro text-[15px] leading-relaxed" style="color: rgba(26, 22, 20, 0.78);">
        Le four chauffe quatre matins par semaine. Le reste, on prépare, on nourrit le levain, on se repose.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="overflow-hidden" style="border: 2px solid #1A1614;">
        {data.calendrier.map((j, i) => (
          <div class={`grid grid-cols-12 gap-3 px-5 md:px-8 py-5 md:py-6 items-center ${i % 2 === 0 ? '' : ''}`} style={`background-color: ${i % 2 === 0 ? 'rgba(255,255,255,0.55)' : 'rgba(255,255,255,0.85)'}; ${i > 0 ? 'border-top: 1px solid rgba(122, 74, 42, 0.2);' : ''}`}>
            <div class="col-span-3 md:col-span-2">
              <p class="font-caveat text-2xl md:text-3xl leading-none" style="color: #7A4A2A;">
                {j.jour}
              </p>
            </div>
            <div class="col-span-6 md:col-span-7">
              <p class="font-crimson-pro text-[13.5px] md:text-[15px] leading-snug" style="color: #1A1614;">
                {j.fournee}
              </p>
            </div>
            <div class="col-span-3 md:col-span-3 text-right">
              <p class={`font-crimson-pro text-[12px] md:text-[13px] uppercase tracking-[0.18em] ${j.ouverture === 'Fermé' ? 'opacity-50' : 'font-semibold'}`} style="color: #1A1614;">
                {j.ouverture}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-6 text-center font-caveat text-xl md:text-2xl" style="color: #7A4A2A;">
        — Réservation des pains par WhatsApp jusqu'à la veille 18h —
      </p>
    </div>
  </div>
</section>
