---
const jours = [
  { j: 'Lundi', fournees: ['Fermé'], cls: true },
  { j: 'Mardi', fournees: ['7h00 · Tradition + sarrasin', '12h00 · Tradition + complet', '17h00 · Miche campagne'] },
  { j: 'Mercredi', fournees: ['7h00 · Tradition + seigle', '12h00 · Tradition + complet', '17h00 · Sarrasin'] },
  { j: 'Jeudi', fournees: ['7h00 · Tradition + miche', '12h00 · Tradition + sarrasin', '17h00 · Complet'] },
  { j: 'Vendredi', fournees: ['7h00 · Tradition + brioche', '12h00 · Tradition + miche', '17h00 · Seigle'] },
  { j: 'Samedi', fournees: ['7h00 · Tout', '12h00 · Tout', '17h00 · Selon stock'] },
  { j: 'Dimanche', fournees: ['7h00 · Tradition + brioche', '11h00 · Miche + complet'] },
];
---
<section id="calendrier" class="py-24 md:py-32" style="background:#F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-14 max-w-2xl">
      <p class="font-caveat text-2xl mb-2" style="color:#7A5C28;">le calendrier —</p>
      <h2 class="font-crimson-pro text-5xl md:text-6xl leading-tight" style="color:#1A1614;">Les fournées <em class="italic" style="color:#C89B3C;">de la semaine.</em></h2>
    </div>
    <div class="grid md:grid-cols-7 gap-px" style="background:rgba(26,22,20,0.15);">
      {jours.map(d => (
        <div class="p-5 min-h-[160px]" style={`background:${d.cls ? '#EADBB7' : '#F5EBD5'};`}>
          <div class="text-[11px] uppercase tracking-[0.22em] mb-3 font-semibold" style={`color:${d.cls ? '#7A5C28' : '#1A1614'};`}>{d.j}</div>
          <ul class="space-y-1.5 text-[12px]" style="color:#3A3128;">
            {d.fournees.map(f => <li class="leading-tight">{f}</li>)}
          </ul>
        </div>
      ))}
    </div>
    <p class="mt-6 text-[12px] uppercase tracking-[0.22em]" style="color:#7A5C28;">— Les fournées s'arrêtent à épuisement. Précommandez pour être sûr·e.</p>
  </div>
</section>
