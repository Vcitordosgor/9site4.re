---
import data from '../../../data/templates/painleve.json';
---
<section id="calendrier" class="py-28 md:py-36" style="background:#EADBB7;">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-14 md:mb-20">
      <div class="max-w-2xl">
        <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#7A5C28;">— les fournées de la semaine</p>
        <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(38px,5.4vw,72px); color:#1F2521;">
          Sept jours,
          <span class="block italic" style="color:#A87842; font-size:clamp(50px,7vw,96px);">une fournée par jour.</span>
        </h2>
      </div>
      <p class="max-w-xs text-[14px] leading-relaxed" style="color:#3A3128;">
        {data.info.rythme}. Les fournées s'arrêtent à épuisement, généralement vers 13 h.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-7 gap-px" style="background:rgba(26,22,20,0.18);">
      {data.calendrier.map((d) => {
        const closed = d.ouverture === 'Fermé';
        return (
          <div class={`p-5 md:p-6 min-h-[210px] flex flex-col ${closed ? 'opacity-65' : ''}`} style={`background:${closed ? '#D8C8A4' : '#E8E0CC'};`}>
            <div class="flex items-baseline justify-between gap-2 mb-2">
              <span class="font-crimson-pro text-2xl leading-none" style="color:#1F2521;">{d.jour}</span>
              {!closed && <span class="block w-2 h-2 rounded-full" style="background:#5C7448;" aria-label="ouvert"></span>}
            </div>
            <p class="text-[10.5px] uppercase tracking-[0.22em] mb-4" style="color:#7A5C28;">{d.ouverture}</p>
            <p class="text-[13.5px] leading-relaxed flex-1" style="color:#3A3128;">{d.fournee}</p>
          </div>
        );
      })}
    </div>
    <p class="mt-6 text-[11.5px] uppercase tracking-[0.22em]" style="color:#7A5C28;">— Les fournées s'arrêtent à épuisement. Précommandez la veille pour être sûr·e.</p>
  </div>
</section>
