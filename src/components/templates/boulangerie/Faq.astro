---
const faqs = [
  { q: 'Pourquoi le pain au levain est-il plus cher ?', r: 'Trente heures de fermentation, pétrissage main, levain à entretenir deux fois par jour, four au bois. On vend en moins grande quantité, on vit du juste prix.' },
  { q: 'Le pain au levain est-il digeste pour les intolérants au gluten ?', r: 'La fermentation longue dégrade une partie du gluten et facilite la digestion, mais ne remplace pas un avis médical pour les cœliaques. Le sarrasin pur est sans gluten.' },
  { q: 'Combien de temps le pain se conserve ?', r: 'La tradition : 3-4 jours. La miche : jusqu\'à 7 jours, emballée dans un torchon. Le pain au levain ne moisit pas, il sèche — toastez la fin.' },
  { q: 'Faites-vous des pâtisseries ?', r: 'Uniquement la brioche au beurre, le samedi. Pas de viennoiseries du commerce, pas de gâteaux — on garde notre énergie pour le pain.' },
  { q: 'Acceptez-vous les CB ?', r: 'Oui, à partir de 5€. Espèces toujours bienvenues. Pas de tickets restaurants à ce jour.' },
];
---
<section class="py-24 md:py-32" style="background:#EADBB7;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <p class="font-caveat text-2xl mb-2" style="color:#7A5C28;">on vous répond —</p>
    <h2 class="font-crimson-pro text-5xl md:text-6xl leading-tight mb-12" style="color:#1A1614;">Questions <em class="italic" style="color:#C89B3C;">fréquentes.</em></h2>
    <div class="max-w-3xl divide-y" style="border-color:rgba(26,22,20,0.20);">
      {faqs.map(f => (
        <details class="group py-6">
          <summary class="cursor-pointer flex justify-between gap-4 font-crimson-pro text-xl md:text-2xl" style="color:#1A1614;">
            {f.q}<span class="font-crimson-pro text-2xl transition-transform group-open:rotate-45" style="color:#C89B3C;">+</span>
          </summary>
          <p class="mt-3 text-[15px] leading-relaxed" style="color:#3A3128;">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>details + details { border-top:1px solid rgba(26,22,20,0.20); }</style>
