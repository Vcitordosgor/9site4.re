---
const faqs = [
  { q: "Pourquoi le pain au levain est-il plus cher ?", r: "Vingt-quatre heures de fermentation, pétrissage main, levain nourri tous les jours, four à sole. On vend en plus petite quantité, on travaille au juste prix d'une boulangerie artisanale." },
  { q: "Le pain au levain est-il digeste pour les intolérants au gluten ?", r: "La fermentation longue dégrade une partie du gluten et facilite la digestion, mais cela ne remplace pas un avis médical pour les cœliaques. Le pain de seigle est mieux toléré que le blé pur." },
  { q: "Combien de temps le pain se conserve ?", r: "La tradition : 4 à 5 jours sous torchon. La miche : jusqu'à 7 jours. Le seigle : 7 jours sec. Le pain au levain ne moisit pas, il sèche — passez la dernière tranche au grille-pain." },
  { q: "Faites-vous des pâtisseries ?", r: "Quelques desserts simples (flan vanille, tartelette citron, cake marbré) le vendredi et samedi seulement. On garde notre énergie sur le pain et les viennoiseries." },
  { q: "Acceptez-vous les CB ?", r: "Oui à partir de 5 €. Espèces toujours bienvenues. Tickets restaurants acceptés sur place." },
  { q: "Livrez-vous à domicile ?", r: "Non pour les particuliers. Pour les restaurants et épiceries partenaires, oui — minimum 10 pains/jour, livraison à 7 h." },
];
---
<section class="py-28 md:py-36" style="background:#F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-12">
    <div class="max-w-3xl mb-14">
      <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#7A5C28;">— on vous répond</p>
      <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(38px,5.4vw,72px); color:#1A1614;">
        Questions
        <span class="block italic" style="color:#C89B3C; font-size:clamp(50px,7vw,96px);">qu'on nous pose souvent.</span>
      </h2>
    </div>
    <div class="max-w-3xl divide-y" style="border-color:rgba(26,22,20,0.20);">
      {faqs.map(f => (
        <details class="group py-6">
          <summary class="cursor-pointer flex justify-between gap-6 font-crimson-pro text-xl md:text-2xl leading-tight" style="color:#1A1614;">
            <span class="flex-1">{f.q}</span>
            <span class="font-crimson-pro text-2xl transition-transform group-open:rotate-45 leading-none" style="color:#C89B3C;">+</span>
          </summary>
          <p class="mt-4 text-[15px] leading-relaxed max-w-2xl" style="color:#3A3128;">{f.r}</p>
        </details>
      ))}
    </div>
  </div>
</section>
<style>details + details { border-top:1px solid rgba(26,22,20,0.20); }</style>
