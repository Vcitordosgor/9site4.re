---
import data from '../../../data/templates/painleve.json';
---

<section class="py-20 md:py-28 relative" style="background-color: #C89B3C;">
  <div class="max-w-4xl mx-auto px-6 md:px-10 text-center">
    <p class="font-crimson-pro text-[11px] uppercase tracking-[0.45em] mb-6" style="color: rgba(26, 22, 20, 0.75);">— Le manifeste du fournil —</p>
    <p class="font-crimson-pro font-medium italic leading-[1.4]" style="color: #1A1614; font-size: clamp(22px, 3vw, 32px);">
      « {data.manifesto} »
    </p>
    <div class="mt-8 flex items-center justify-center gap-4">
      <span class="block w-12 h-px" style="background-color: rgba(26, 22, 20, 0.4);"></span>
      <span class="font-caveat text-2xl" style="color: #1A1614;">{data.info.fondateur}</span>
      <span class="block w-12 h-px" style="background-color: rgba(26, 22, 20, 0.4);"></span>
    </div>
  </div>
</section>
