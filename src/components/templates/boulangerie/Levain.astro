---
/**
 * Signature WOAW : "Une fournée, 6 gestes" — timeline verticale alternée
 * SANS photos : heure XXL + titre + texte sensoriel uniquement.
 */
import data from '../../../data/templates/painleve.json';
---
<section id="fournee" class="relative py-28 md:py-40 overflow-hidden" style="background:#1F2521; color:#E8E0CC;">
  <svg class="absolute inset-0 w-full h-full opacity-[0.05] pointer-events-none" aria-hidden="true">
    <filter id="four-grain"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#four-grain)" fill="#E8E0CC"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-12 relative">
    <div class="max-w-3xl mb-16 md:mb-24">
      <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#A87842;">— le rythme du fournil</p>
      <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(40px,6vw,84px); color:#E8E0CC;">
        Une fournée,
        <span class="block italic" style="color:#A87842; font-size:clamp(54px,7.6vw,108px);">six gestes.</span>
      </h2>
      <p class="mt-6 text-base md:text-lg leading-relaxed max-w-xl" style="color:#D4C8AC;">
        Du rafraîchi du levain à 6 h jusqu'au défournement le lendemain, voici ce qui se passe dans la nuit. Vingt-six heures de patience, soixante secondes à lire.
      </p>
    </div>

    <ol class="relative max-w-4xl mx-auto">
      <span class="absolute left-7 md:left-1/2 top-2 bottom-2 w-px md:-translate-x-1/2" style="background:linear-gradient(180deg, transparent, #A87842 8%, #A87842 92%, transparent);" aria-hidden="true"></span>
      {data.levain.etapes.map((e, i) => {
        const left = i % 2 === 0;
        return (
          <li class="relative mb-14 md:mb-20 last:mb-0 grid md:grid-cols-2 gap-8 items-start">
            <!-- Pastille dorée centrale -->
            <span class="absolute left-7 md:left-1/2 top-2 w-4 h-4 rounded-full md:-translate-x-1/2 ring-4 ring-[#1F2521]" style="background:#A87842;"></span>

            <!-- Heure XXL -->
            <div class={`pl-16 md:pl-0 ${left ? 'md:order-1 md:text-right md:pr-16' : 'md:order-2 md:text-left md:pl-16'}`}>
              <p class="font-crimson-pro italic leading-[0.95]" style="font-size:clamp(56px,8vw,108px); color:#A87842;">{e.label}</p>
              <p class="mt-2 font-caveat text-xl md:text-2xl" style="color:#D4C8AC; opacity:0.7;">étape {String(i + 1).padStart(2, '0')}</p>
            </div>

            <!-- Titre + texte -->
            <div class={`pl-16 md:pl-0 ${left ? 'md:order-2 md:pl-16' : 'md:order-1 md:pr-16 md:text-right'}`}>
              <h3 class="font-crimson-pro text-2xl md:text-3xl leading-tight" style="color:#E8E0CC;">{e.titre}</h3>
              <p class="mt-4 text-[15px] md:text-[16px] leading-relaxed max-w-md" style="color:#D4C8AC;">{e.texte}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
