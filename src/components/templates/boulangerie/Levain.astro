---
/**
 * Signature WOAW : "Une fournée, 6 étapes" — timeline verticale alternée
 * avec heure réelle, photos et descriptions sensorielles.
 */
import data from '../../../data/templates/painleve.json';
const photos = [
  '/images/boulangerie/extra-1.webp',
  '/images/boulangerie/extra-2.webp',
  '/images/boulangerie/extra-3.webp',
  '/images/boulangerie/extra-4.webp',
  '/images/boulangerie/extra-5.webp',
  '/images/boulangerie/hero.webp',
];
---
<section id="fournee" class="relative py-28 md:py-40 overflow-hidden" style="background:#1A1614; color:#F5EBD5;">
  <svg class="absolute inset-0 w-full h-full opacity-[0.05] pointer-events-none" aria-hidden="true">
    <filter id="four-grain"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#four-grain)" fill="#F5EBD5"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-12 relative">
    <div class="max-w-3xl mb-16 md:mb-24">
      <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#C89B3C;">— le rythme du fournil</p>
      <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(40px,6vw,84px); color:#F5EBD5;">
        Une fournée,
        <span class="block italic" style="color:#C89B3C; font-size:clamp(54px,7.6vw,108px);">six gestes.</span>
      </h2>
      <p class="mt-6 text-base md:text-lg leading-relaxed max-w-xl" style="color:#E0D2B5;">
        Du rafraîchi du levain à 6 h jusqu'au défournement le lendemain, voici ce qui se passe dans la nuit. Vingt-six heures de patience, soixante secondes à lire.
      </p>
    </div>

    <ol class="relative max-w-5xl mx-auto">
      <span class="absolute left-7 md:left-1/2 top-2 bottom-2 w-px md:-translate-x-1/2" style="background:linear-gradient(180deg, transparent, #C89B3C 8%, #C89B3C 92%, transparent);" aria-hidden="true"></span>
      {data.levain.etapes.map((e, i) => {
        const left = i % 2 === 0;
        return (
          <li class="relative grid md:grid-cols-2 gap-6 md:gap-10 mb-14 md:mb-20 last:mb-0">
            <span class="absolute left-7 md:left-1/2 top-6 w-4 h-4 rounded-full md:-translate-x-1/2 ring-4 ring-[#1A1614]" style="background:#C89B3C;"></span>

            <div class={`pl-16 md:pl-0 ${left ? 'md:order-1 md:pr-12' : 'md:order-2 md:pl-12'}`}>
              <div class="aspect-[5/4] overflow-hidden">
                <img src={photos[i % photos.length]} alt={`Étape ${e.label} — ${e.titre}`}
                     class="w-full h-full object-cover transition-transform duration-700 hover:scale-[1.04]"
                     loading="lazy" />
              </div>
            </div>

            <div class={`pl-16 md:pl-0 ${left ? 'md:order-2 md:pl-12 md:text-left' : 'md:order-1 md:pr-12 md:text-right'}`}>
              <p class="font-crimson-pro text-3xl md:text-4xl leading-none" style="color:#C89B3C;">{e.label}</p>
              <h3 class="mt-3 font-crimson-pro text-2xl md:text-3xl leading-tight" style="color:#F5EBD5;">
                <span class="italic" style="color:#C89B3C;">{String(i + 1).padStart(2, '0')}.</span> {e.titre}
              </h3>
              <p class={`mt-4 text-[15px] leading-relaxed max-w-md ${!left ? 'md:ml-auto' : ''}`} style="color:#E0D2B5;">{e.texte}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </div>
</section>
