---
import data from '../../../data/templates/painleve.json';
---

<section id="levain" class="py-20 md:py-28 relative" style="background-color: #F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-crimson-pro text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #7A4A2A;">— Le cœur du fournil —</p>
      <h2 class="font-crimson-pro font-semibold leading-[0.95]" style="color: #1A1614; font-size: clamp(36px, 5vw, 56px);">
        {data.levain.titre}
        <em class="block font-caveat not-italic mt-2" style="color: #C89B3C; font-size: clamp(44px, 6vw, 64px);">
          {data.levain.soustitre}
        </em>
      </h2>
      <p class="mt-6 font-crimson-pro text-[15.5px] md:text-[16.5px] leading-relaxed" style="color: rgba(26, 22, 20, 0.78);">
        {data.levain.texte}
      </p>
    </div>

    <!-- Timeline étapes -->
    <div class="max-w-4xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
        {data.levain.etapes.map((e, i) => (
          <div class="relative p-6 md:p-7" style="background-color: rgba(255, 255, 255, 0.6); border: 1px solid rgba(122, 74, 42, 0.25); border-left: 3px solid #C89B3C;">
            <div class="flex items-baseline justify-between gap-4 mb-2">
              <p class="font-caveat text-3xl leading-none" style="color: #C89B3C;">{e.label}</p>
              <p class="font-crimson-pro text-[10px] uppercase tracking-[0.25em]" style="color: rgba(122, 74, 42, 0.7);">
                Étape {String(i + 1).padStart(2, '0')}
              </p>
            </div>
            <h3 class="font-crimson-pro font-semibold text-xl md:text-2xl leading-tight" style="color: #1A1614;">
              {e.titre}
            </h3>
            <p class="mt-2.5 font-crimson-pro text-[14.5px] leading-relaxed" style="color: rgba(26, 22, 20, 0.78);">
              {e.texte}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Carte d'identité du levain -->
    <div class="mt-12 md:mt-16 max-w-3xl mx-auto p-8 md:p-10 text-center relative" style="background-color: #1A1614; color: #F5EBD5;">
      <div class="flex items-center justify-center gap-3 mb-5" aria-hidden="true">
        <span class="block w-12 h-px" style="background-color: rgba(200, 155, 60, 0.45);"></span>
        <span class="font-caveat text-2xl" style="color: #C89B3C;">⟡</span>
        <span class="block w-12 h-px" style="background-color: rgba(200, 155, 60, 0.45);"></span>
      </div>
      <p class="font-crimson-pro text-[11px] uppercase tracking-[0.4em]" style="color: #C89B3C;">Levain mère</p>
      <p class="mt-3 font-caveat" style="color: #F5EBD5; font-size: clamp(52px, 8vw, 88px); line-height: 1;">
        Née en {data.levain.annee}
      </p>
      <p class="mt-4 font-crimson-pro text-[14.5px] italic" style="color: rgba(245, 235, 213, 0.75);">
        {data.levain.origine}
      </p>
    </div>
  </div>
</section>
