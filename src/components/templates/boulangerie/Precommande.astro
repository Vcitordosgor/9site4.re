---
import data from '../../../data/templates/painleve.json';
const formules = [
  { titre: 'Deux pains', sous: 'Pour deux personnes', prix: '38 €', detail: '/ mois', pains: '2 pains au choix par semaine', bonus: 'Engagement 1 mois renouvelable.' },
  { titre: 'Quatre pains', sous: 'Famille', prix: '68 €', detail: '/ mois', pains: '4 pains au choix par semaine', bonus: 'Une viennoiserie offerte par mois.', mis: true },
  { titre: 'Six pains', sous: 'Famille + invités', prix: '92 €', detail: '/ mois', pains: '6 pains + 2 viennoiseries / semaine', bonus: 'Brioche feuilletée offerte le 1er samedi.' },
];
---
<section id="abonnement" class="relative py-28 md:py-36 overflow-hidden" style="background:#A87842; color:#1F2521;">
  <svg class="absolute inset-0 w-full h-full opacity-[0.06] pointer-events-none" aria-hidden="true">
    <filter id="grain-abo"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#grain-abo)"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-12 relative">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 mb-14 md:mb-20">
      <div class="max-w-3xl">
        <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#1F2521;">— abonnement hebdo</p>
        <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(40px,6vw,84px);">
          Du pain frais,
          <span class="block italic" style="font-size:clamp(54px,7.6vw,108px);">chaque semaine.</span>
        </h2>
      </div>
      <p class="max-w-md text-base leading-relaxed">
        Engagez-vous sur 4 semaines, choisissez votre jour de retrait, on met votre pain de côté. Pas d'acompte, résiliation à tout moment.
      </p>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
      {formules.map((f) => (
        <li class={`relative p-8 md:p-10 transition-transform hover:-translate-y-1`} style={`background:${f.mis ? '#1F2521' : '#E8E0CC'}; color:${f.mis ? '#E8E0CC' : '#1F2521'};`}>
          {f.mis && <span class="absolute top-5 right-5 px-3 py-1 text-[10px] uppercase tracking-[0.22em] rounded-full" style="background:#A87842; color:#1F2521;">Le plus pris</span>}
          <p class="font-caveat text-2xl" style={`color:${f.mis ? '#A87842' : '#7A5C28'};`}>{f.sous}</p>
          <h3 class="mt-1 font-crimson-pro text-3xl md:text-4xl leading-tight">{f.titre}</h3>
          <p class="mt-6 flex items-baseline gap-2">
            <span class="font-crimson-pro leading-none" style="color:#A87842; font-size:clamp(48px,6vw,68px);">{f.prix}</span>
            <span class="text-[12px] uppercase tracking-[0.22em]" style={`color:${f.mis ? '#D4C8AC' : '#7A5C28'};`}>{f.detail}</span>
          </p>
          <ul class="mt-6 space-y-2 text-[14.5px] leading-relaxed">
            <li class="flex gap-2"><span style="color:#A87842;">✦</span>{f.pains}</li>
            <li class="flex gap-2"><span style="color:#A87842;">✦</span>Retrait à la fournée choisie (11 h ou 13 h)</li>
            <li class="flex gap-2"><span style="color:#A87842;">✦</span>{f.bonus}</li>
          </ul>
          <a href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent(`Bonjour, je voudrais m'abonner à la formule "${f.titre}".`)}`}
             target="_blank" rel="noopener"
             class="mt-10 inline-flex items-center justify-center w-full px-6 rounded-full text-[12px] uppercase tracking-[0.22em] font-semibold transition-colors"
             style={`background:${f.mis ? '#A87842' : '#1F2521'}; color:${f.mis ? '#1F2521' : '#E8E0CC'}; height:52px;`}>
            Choisir cette formule
          </a>
        </li>
      ))}
    </ul>

    <div class="mt-14 md:mt-20 p-8 md:p-10 border-2 border-dashed flex flex-col md:flex-row items-start md:items-center justify-between gap-6" style="border-color:rgba(26,22,20,0.4);">
      <div class="max-w-2xl">
        <p class="font-caveat text-2xl" style="color:#1F2521;">— juste un pain ?</p>
        <h3 class="mt-1 font-crimson-pro text-2xl md:text-3xl">Précommande à l'unité, sans engagement.</h3>
        <p class="mt-2 text-[14px] leading-relaxed">Envoyez un message la veille avant 18 h. On garde votre pain au chaud, vous payez au retrait. Si vous ne venez pas, on le revend — pas de souci.</p>
      </div>
      <a href={`https://wa.me/${data.info.whatsapp}`} target="_blank" rel="noopener"
         class="inline-flex items-center gap-2 px-7 rounded-full text-[12px] uppercase tracking-[0.22em] font-semibold whitespace-nowrap transition-colors"
         style="background:#1F2521; color:#E8E0CC; height:52px;">
         WhatsApp · précommander
         <svg viewBox="0 0 24 24" width="14" height="14"><path d="M5 12h14m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
      </a>
    </div>
  </div>
</section>
