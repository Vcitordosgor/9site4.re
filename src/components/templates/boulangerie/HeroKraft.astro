---
/**
 * HeroKraft — Étiquette papier kraft géante avec tagline manuscrite,
 * tampon "fournée du jour" et photo de pain plein cadre.
 */
import data from '../../../data/templates/painleve.json';

const today = new Date().toLocaleDateString('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long',
});
---

<section id="top" class="relative overflow-hidden" style="background-color: #F5EBD5;">
  <!-- Texture papier grain via SVG -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.08]" aria-hidden="true">
    <filter id="kraft-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" />
      <feColorMatrix values="0 0 0 0 0.48  0 0 0 0 0.29  0 0 0 0 0.16  0 0 0 1 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#kraft-grain)" />
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 pt-10 md:pt-16 pb-16 md:pb-24 relative">

    <!-- Bandeau eyebrow centré -->
    <div class="text-center mb-8 md:mb-12">
      <p class="font-crimson-pro text-[11px] md:text-[12px] uppercase tracking-[0.45em]" style="color: #7A4A2A;">
        Fournil artisanal · une fournée par jour · depuis {data.info.annee}
      </p>
    </div>

    <!-- Wordmark XXL éditorial -->
    <div class="text-center max-w-5xl mx-auto">
      <h1 class="font-crimson-pro font-semibold leading-[0.86]" style="color: #1A1614;">
        <span class="block" style="font-size: clamp(72px, 14.5vw, 188px); letter-spacing: -0.025em;">Le Pain</span>
        <span class="block font-caveat italic" style="font-size: clamp(82px, 16vw, 208px); color: #C89B3C; line-height: 0.9; margin-top: -0.05em;">Levé.</span>
      </h1>

      <!-- Filet ornemental -->
      <div class="flex items-center justify-center gap-3 my-6 md:my-9" aria-hidden="true">
        <span class="block w-12 md:w-20 h-px" style="background-color: rgba(122, 74, 42, 0.45);"></span>
        <span class="font-caveat text-2xl md:text-3xl" style="color: #C89B3C;">{'∼'}</span>
        <span class="block w-12 md:w-20 h-px" style="background-color: rgba(122, 74, 42, 0.45);"></span>
      </div>

      <!-- Tagline -->
      <p class="font-caveat text-3xl md:text-5xl leading-tight" style="color: #7A4A2A;">
        {data.info.tagline}
      </p>

      <p class="mt-6 md:mt-8 font-crimson-pro text-[15px] md:text-[17px] leading-relaxed max-w-2xl mx-auto" style="color: rgba(26, 22, 20, 0.82);">
        Une seule farine bio T80, un levain mère né en 2018,<br class="hidden md:block" />
        une fermentation longue de 18 à 24 heures, un four à sole tournante.
      </p>
    </div>

    <!-- ÉTIQUETTE KRAFT GÉANTE -->
    <div class="mt-12 md:mt-16 max-w-5xl mx-auto relative">
      <div class="relative p-6 md:p-10 border-[3px] border-dashed" style="background-color: rgba(255, 255, 255, 0.55); border-color: #7A4A2A;">
        <!-- Cartouche du jour -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-6">
          <div class="p-4 text-center md:text-left" style="background-color: #1A1614; color: #F5EBD5;">
            <p class="font-crimson-pro text-[10px] uppercase tracking-[0.25em] mb-1" style="color: #C89B3C;">Aujourd'hui</p>
            <p class="font-crimson-pro font-semibold capitalize text-lg leading-tight">{today}</p>
          </div>
          <div class="p-4 text-center md:text-left" style="background-color: rgba(255, 255, 255, 0.6); border: 1px solid rgba(122, 74, 42, 0.35);">
            <p class="font-crimson-pro text-[10px] uppercase tracking-[0.25em] mb-1" style="color: #7A4A2A;">Au four ce matin</p>
            <p class="font-crimson-pro font-semibold text-lg leading-tight" style="color: #1A1614;">30 miches campagne</p>
          </div>
          <div class="p-4 text-center md:text-left" style="background-color: rgba(255, 255, 255, 0.6); border: 1px solid rgba(122, 74, 42, 0.35);">
            <p class="font-crimson-pro text-[10px] uppercase tracking-[0.25em] mb-1" style="color: #7A4A2A;">Ouverture du fournil</p>
            <p class="font-crimson-pro font-semibold text-lg leading-tight" style="color: #1A1614;">7h00 du matin</p>
          </div>
          <div class="p-4 text-center md:text-left" style="background-color: rgba(255, 255, 255, 0.6); border: 1px solid rgba(122, 74, 42, 0.35);">
            <p class="font-crimson-pro text-[10px] uppercase tracking-[0.25em] mb-1" style="color: #7A4A2A;">Rupture habituelle</p>
            <p class="font-crimson-pro font-semibold text-lg leading-tight" style="color: #1A1614;">Vers 11h30</p>
          </div>
        </div>

        <!-- CTAs -->
        <div class="mt-8 md:mt-10 flex flex-col sm:flex-row items-center justify-center gap-3 md:gap-4">
          <a
            href="#carte"
            class="inline-flex items-center justify-center h-12 px-8 font-crimson-pro font-semibold text-[13px] tracking-widest rounded-full transition-opacity hover:opacity-90"
            style="background-color: #1A1614; color: #F5EBD5;"
          >
            Voir la carte du jour
          </a>
          <a
            href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour Mathieu, je voudrais réserver des pains pour cette semaine.')}`}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center h-12 px-8 font-crimson-pro font-semibold text-[13px] tracking-widest rounded-full border-2 transition-colors duration-300"
            style="background-color: transparent; color: #1A1614; border-color: #1A1614;"
          >
            Réserver mes pains
          </a>
        </div>

        <!-- Tampon "fait au levain" en rond -->
        <div class="absolute -top-6 -right-4 md:-top-8 md:-right-6 -rotate-12">
          <div class="w-20 h-20 md:w-28 md:h-28 rounded-full border-2 flex items-center justify-center" style="border-color: rgba(200, 155, 60, 0.85); color: #C89B3C; background-color: rgba(245, 235, 213, 0.85);">
            <div class="text-center">
              <p class="font-crimson-pro text-[8.5px] md:text-[10px] uppercase tracking-[0.22em] leading-none">Fait au</p>
              <p class="font-caveat text-2xl md:text-4xl leading-none mt-1">levain</p>
              <p class="font-crimson-pro text-[8.5px] md:text-[10px] uppercase tracking-[0.22em] leading-none mt-1">mère 2018</p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Photo gros plan dessous -->
    <div class="mt-12 md:mt-16 max-w-5xl mx-auto">
      <div class="aspect-[16/8] overflow-hidden border-[3px]" style="border-color: #1A1614;">
        <img
          src={data.info.photoHero}
          alt={data.info.photoHeroAlt}
          class="w-full h-full object-cover"
          width="1600" height="900" loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <p class="mt-3 text-center font-caveat text-xl md:text-2xl" style="color: #7A4A2A;">
        — Enfourné à 8h ce matin par Mathieu —
      </p>
    </div>
  </div>
</section>
