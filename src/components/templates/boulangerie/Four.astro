---
import data from '../../../data/templates/painleve.json';
---

<section id="four" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #1A1614; color: #F5EBD5;">
  <!-- Texture subtle -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.05]" aria-hidden="true">
    <filter id="four-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" />
      <feColorMatrix values="0 0 0 0 0.78  0 0 0 0 0.61  0 0 0 0 0.24  0 0 0 1 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#four-grain)" />
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">

      <div class="md:col-span-5">
        <p class="font-crimson-pro text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #C89B3C;">— Le geste du fournil —</p>
        <h2 class="font-crimson-pro font-semibold leading-[0.95]" style="font-size: clamp(36px, 5vw, 56px);">
          {data.four.titre}
          <em class="block font-caveat not-italic mt-2" style="color: #C89B3C; font-size: clamp(40px, 6vw, 64px);">{data.four.soustitre}</em>
        </h2>

        <p class="mt-7 font-crimson-pro text-[15.5px] leading-relaxed" style="color: rgba(245, 235, 213, 0.82);">
          {data.four.texte}
        </p>

        <div class="mt-8 pt-7 border-t" style="border-color: rgba(200, 155, 60, 0.25);">
          <p class="font-crimson-pro text-[10.5px] uppercase tracking-[0.3em] mb-4" style="color: #C89B3C;">Nos fournisseurs</p>
          <ul class="space-y-2 font-crimson-pro text-[14.5px]">
            {data.fournisseurs.map((f) => (
              <li class="flex items-start gap-3">
                <span class="font-caveat text-xl leading-none mt-0.5" style="color: #C89B3C;">∘</span>
                <span>{f}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="md:col-span-7">
        <div class="grid grid-cols-2 gap-3 md:gap-5">
          {data.four.stats.map((s) => (
            <div class="p-6 md:p-8 text-center" style="background-color: rgba(245, 235, 213, 0.05); border: 1px solid rgba(200, 155, 60, 0.25);">
              <p class="font-caveat leading-none" style="color: #C89B3C; font-size: clamp(40px, 6vw, 64px);">
                {s.valeur}
              </p>
              <p class="mt-3 font-crimson-pro text-[10.5px] uppercase tracking-[0.25em]" style="color: rgba(245, 235, 213, 0.7);">
                {s.label}
              </p>
            </div>
          ))}
        </div>

        <!-- Citation -->
        <div class="mt-6 md:mt-8 p-7 md:p-9" style="background-color: rgba(200, 155, 60, 0.08); border-left: 3px solid #C89B3C;">
          <p class="font-caveat text-2xl md:text-3xl leading-snug" style="color: #F5EBD5;">
            « Le four, c'est mon premier outil. On l'allume avant que les coqs n'aient l'idée de chanter. »
          </p>
          <p class="mt-3 font-crimson-pro text-[12px] uppercase tracking-[0.25em]" style="color: #C89B3C;">
            — Mathieu, boulanger
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
