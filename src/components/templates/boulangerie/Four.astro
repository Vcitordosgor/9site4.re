---
import data from '../../../data/templates/painleve.json';
---
<section class="relative" style="background:#E8E0CC;">
  <div class="grid lg:grid-cols-2 min-h-[640px]">
    <div class="relative min-h-[360px] overflow-hidden" id="four-visual">
      <img src="/images/boulangerie/pain-6.webp" alt="Four à sole tournante en activité, voûte chaude rougeoyante" class="absolute inset-0 w-full h-full object-cover" loading="lazy"/>
      <div class="absolute inset-0" style="background:linear-gradient(180deg, transparent 50%, rgba(26,22,20,0.35));"></div>

      <!-- Vapeur subtile qui s'élève du pain — signature artisanale -->
      <div class="bl-steam pointer-events-none absolute inset-x-0 bottom-0 h-full" aria-hidden="true">
        <span class="bl-puff" style="--x:28%; --d:0s;   --s:1;   --o:.55;"></span>
        <span class="bl-puff" style="--x:42%; --d:1.4s; --s:1.2; --o:.45;"></span>
        <span class="bl-puff" style="--x:55%; --d:.6s;  --s:.9;  --o:.6;"></span>
        <span class="bl-puff" style="--x:68%; --d:2.1s; --s:1.1; --o:.4;"></span>
        <span class="bl-puff" style="--x:78%; --d:3.2s; --s:.85; --o:.5;"></span>
        <span class="bl-puff" style="--x:35%; --d:4s;   --s:1;   --o:.4;"></span>
      </div>
    </div>
    <div class="flex items-center px-6 md:px-14 py-20 lg:py-0" style="background:#1F2521; color:#E8E0CC;">
      <div class="max-w-xl">
        <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#A87842;">— {data.four.soustitre}</p>
        <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(40px,5.4vw,76px);">
          {data.four.titre.split(' à ')[0]}
          <span class="block italic" style="color:#A87842; font-size:clamp(50px,7vw,96px);">à sole tournante.</span>
        </h2>
        <p class="mt-7 text-base md:text-lg leading-relaxed" style="color:#D4C8AC;">
          {data.four.texte}
        </p>
        <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-7">
          {data.four.stats.map((s) => (
            <li>
              <p class="font-crimson-pro leading-none" style="color:#A87842; font-size:clamp(34px,4.6vw,52px);">{s.valeur}</p>
              <p class="mt-2 text-[11px] uppercase tracking-[0.22em]" style="color:#D4C8AC;">{s.label}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  /* Vapeur — désactivée par défaut, activée via IntersectionObserver */
  .bl-steam { opacity: 0; transition: opacity 1.2s ease-out; }
  .bl-steam.is-on { opacity: 1; }
  .bl-puff {
    position: absolute;
    left: var(--x);
    bottom: 18%;
    width: clamp(60px, 9vw, 130px);
    height: clamp(60px, 9vw, 130px);
    margin-left: calc(clamp(60px, 9vw, 130px) / -2);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 50%, rgba(232,224,204,0.55) 0%, rgba(232,224,204,0.18) 45%, rgba(232,224,204,0) 72%);
    filter: blur(8px);
    opacity: 0;
    transform: translateY(0) scale(calc(var(--s) * 0.6));
  }
  .bl-steam.is-on .bl-puff {
    animation: bl-rise 7s ease-in-out var(--d) infinite;
  }
  @keyframes bl-rise {
    0%   { transform: translate(0, 0)        scale(calc(var(--s) * 0.55)); opacity: 0; }
    18%  { opacity: var(--o); }
    55%  { transform: translate(-10px, -55%) scale(calc(var(--s) * 1));   opacity: calc(var(--o) * 0.7); }
    100% { transform: translate(14px, -110%) scale(calc(var(--s) * 1.4)); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bl-steam, .bl-steam.is-on .bl-puff { animation: none !important; opacity: 0 !important; }
  }
</style>

<script>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return;
    const el = document.getElementById('four-visual');
    if (!el) return;
    const steam = el.querySelector('.bl-steam');
    if (!steam) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { steam.classList.add('is-on'); io.disconnect(); }
      });
    }, { threshold: 0.25 });
    io.observe(el);
  })();
</script>

<section class="py-28 md:py-36" style="background:#EADBB7;">
  <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-5">
      <div class="relative">
        <img src="/images/boulangerie/pain-7.webp" alt="Levain mère dans son pot, surface qui bulle doucement" class="w-full aspect-[4/5] object-cover" loading="lazy" />
        <div class="absolute -bottom-5 -left-5 md:-left-8 max-w-[14rem] p-5 rotate-[-3deg] shadow-[0_18px_44px_-12px_rgba(0,0,0,0.35)]" style="background:#1F2521; color:#E8E0CC;">
          <p class="font-caveat text-3xl leading-tight" style="color:#A87842;">— Margot, le levain.</p>
          <p class="mt-1 text-[11px] uppercase tracking-[0.3em]" style="color:#D4C8AC;">Née en {data.levain.annee}</p>
        </div>
      </div>
    </div>
    <div class="lg:col-span-7">
      <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#7A5C28;">— le levain mère</p>
      <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(38px,5.2vw,72px); color:#1F2521;">
        Sept ans
        <span class="block italic" style="color:#A87842; font-size:clamp(50px,7vw,96px);">de patience quotidienne.</span>
      </h2>
      <p class="mt-7 text-base md:text-lg leading-relaxed" style="color:#3A3128;">
        {data.levain.texte}
      </p>
      <div class="mt-8 grid grid-cols-2 gap-6 max-w-md">
        <div class="border-l-2 pl-4" style="border-color:#A87842;">
          <p class="text-[10px] uppercase tracking-[0.24em]" style="color:#7A5C28;">Origine</p>
          <p class="mt-1 font-crimson-pro text-base leading-tight" style="color:#1F2521;">{data.levain.origine}</p>
        </div>
        <div class="border-l-2 pl-4" style="border-color:#A87842;">
          <p class="text-[10px] uppercase tracking-[0.24em]" style="color:#7A5C28;">Rythme</p>
          <p class="mt-1 font-crimson-pro text-base leading-tight" style="color:#1F2521;">{data.levain.soustitre}</p>
        </div>
      </div>
    </div>
  </div>
</section>
