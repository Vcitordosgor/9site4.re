---
import data from '../../../data/templates/painleve.json';
const points = [
  { titre: 'Le fournil', sous: 'Vente directe', adresse: data.info.adresseLigne1, horaire: data.info.ouvertureHebdo, tag: 'Toute la gamme' },
  { titre: 'Marché de Saint-Paul', sous: 'Samedi matin', adresse: 'Front de mer · stand 14', horaire: 'Samedi 7 h → 12 h', tag: 'Tradition + brioche' },
  { titre: 'Épicerie bio partenaire', sous: 'Dépôt nord', adresse: 'Centre-ville (précisé en boutique)', horaire: 'Mardi → vendredi · 8 h → 19 h', tag: 'Tradition + viennoiseries' },
];
const temoignages = [
  { texte: "On précommande chaque semaine la miche de campagne, le pain se garde 6 jours, juste un crouton sec à la fin.", auteur: "M. · habitué depuis 2022" },
  { texte: "La brioche feuilletée du samedi, c'est dimanche matin obligatoire à la maison.", auteur: "C. · le quartier" },
  { texte: "On a goûté beaucoup de pains au levain en métropole : celui-ci tient la comparaison sans rougir.", auteur: "J. · expat rentré" },
];
---
<section id="trouver" class="py-28 md:py-36" style="background:#1A1614; color:#F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <div class="lg:col-span-5">
      <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#C89B3C;">— où trouver le pain</p>
      <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(38px,5.4vw,72px);">
        Trois points
        <span class="block italic" style="color:#C89B3C; font-size:clamp(50px,7vw,96px);">de retrait sur l'île.</span>
      </h2>
      <!-- Carte stylisée minimaliste -->
      <div class="mt-10 relative aspect-[4/3] overflow-hidden border" style="background:#0F0D0B; border-color:rgba(245,235,213,0.15);">
        <svg viewBox="0 0 400 300" class="absolute inset-0 w-full h-full" aria-hidden="true">
          <path d="M80 130 Q90 80 140 70 Q210 60 280 90 Q330 130 320 200 Q300 250 230 250 Q160 250 110 220 Q70 190 80 130 Z"
                fill="rgba(200,155,60,0.10)" stroke="#C89B3C" stroke-width="1.2"/>
          <g font-family="serif">
            <circle cx="140" cy="180" r="6" fill="#C89B3C"/>
            <text x="155" y="185" fill="#F5EBD5" font-size="11">Fournil</text>
            <circle cx="120" cy="120" r="6" fill="#F5EBD5"/>
            <text x="135" y="125" fill="#F5EBD5" font-size="11">Marché St-Paul</text>
            <circle cx="270" cy="100" r="6" fill="#F5EBD5"/>
            <text x="200" y="100" fill="#F5EBD5" font-size="11" text-anchor="end">Épicerie bio</text>
          </g>
        </svg>
        <div class="absolute bottom-3 right-4 text-[10px] uppercase tracking-[0.22em]" style="color:rgba(245,235,213,0.55);">Carte indicative · La Réunion</div>
      </div>
    </div>

    <div class="lg:col-span-7">
      <ul class="grid gap-px" style="background:rgba(245,235,213,0.15);">
        {points.map((p, i) => (
          <li class="p-7 md:p-9 grid md:grid-cols-3 gap-5 items-start" style="background:#1A1614;">
            <div>
              <p class="text-[10px] uppercase tracking-[0.28em]" style="color:#C89B3C;">{p.sous}</p>
              <h3 class="mt-1 font-crimson-pro text-2xl md:text-3xl leading-tight">{p.titre}</h3>
            </div>
            <div>
              <p class="text-[14.5px]" style="color:#E0D2B5;">{p.adresse}</p>
              <p class="mt-2 text-[11.5px] uppercase tracking-[0.22em]" style="color:#C89B3C;">{p.horaire}</p>
            </div>
            <div class="md:text-right">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-[10.5px] uppercase tracking-[0.22em] border" style="border-color:rgba(200,155,60,0.5); color:#C89B3C;">{p.tag}</span>
              <p class="mt-3 font-crimson-pro italic text-xl" style="color:#F5EBD5;">{String(i + 1).padStart(2, '0')}</p>
            </div>
          </li>
        ))}
      </ul>

      <!-- Témoignages -->
      <div class="mt-14">
        <p class="text-[10px] uppercase tracking-[0.3em] mb-6" style="color:#C89B3C;">— Le livre d'or du fournil</p>
        <ul class="grid sm:grid-cols-3 gap-5">
          {temoignages.map((t) => (
            <li class="p-6 border" style="border-color:rgba(245,235,213,0.18);">
              <p class="font-crimson-pro italic text-[15px] md:text-[16px] leading-relaxed" style="color:#F5EBD5;">“{t.texte}”</p>
              <p class="mt-4 text-[11px] uppercase tracking-[0.24em]" style="color:#C89B3C;">{t.auteur}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10 pt-6 border-t flex flex-wrap gap-6 text-[14px]" style="border-color:rgba(245,235,213,0.20);">
        <span><span style="color:#C89B3C;">Tél · </span><a href={`tel:${data.info.telephoneHref}`} class="hover:underline">{data.info.telephone}</a></span>
        <span><span style="color:#C89B3C;">Email · </span><a href={`mailto:${data.info.email}`} class="hover:underline">{data.info.email}</a></span>
        <span><span style="color:#C89B3C;">Instagram · </span>{data.info.instagram}</span>
      </div>
    </div>
  </div>
</section>
