---
import data from '../../../data/templates/painleve.json';
const points = [
  { titre: 'Le fournil', sous: 'Vente directe', adresse: data.info.adresseLigne1, horaire: data.info.ouvertureHebdo, tag: 'Toute la gamme' },
  { titre: 'Marché de Saint-Paul', sous: 'Samedi matin', adresse: 'Front de mer · stand 14', horaire: 'Samedi 7 h → 12 h', tag: 'Tradition + brioche' },
  { titre: 'Épicerie bio partenaire', sous: 'Dépôt nord', adresse: 'Centre-ville (précisé en boutique)', horaire: 'Mardi → vendredi · 8 h → 19 h', tag: 'Tradition + viennoiseries' },
];
const temoignages = [
  { texte: "On précommande chaque semaine la miche de campagne, le pain se garde 6 jours, juste un crouton sec à la fin.", auteur: "M. · habitué depuis 2022" },
  { texte: "La brioche feuilletée du samedi, c'est dimanche matin obligatoire à la maison.", auteur: "C. · le quartier" },
  { texte: "On a goûté beaucoup de pains au levain en métropole : celui-ci tient la comparaison sans rougir.", auteur: "J. · expat rentré" },
];
---
<section id="trouver" class="py-28 md:py-36" style="background:#1F2521; color:#E8E0CC;">
  <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <div class="lg:col-span-5">
      <p class="font-caveat text-2xl md:text-3xl mb-3" style="color:#A87842;">— où trouver le pain</p>
      <h2 class="font-crimson-pro leading-[0.95] tracking-[-0.01em]" style="font-size:clamp(38px,5.4vw,72px);">
        Trois points
        <span class="block italic" style="color:#A87842; font-size:clamp(50px,7vw,96px);">de retrait sur l'île.</span>
      </h2>
      <p class="mt-10 font-crimson-pro italic text-lg md:text-xl leading-relaxed max-w-md" style="color:#D4C8AC;">
        « On vous attend à la boutique. Les deux autres points sont là pour vous dépanner quand l'île vous éloigne. »
      </p>
    </div>

    <div class="lg:col-span-7">
      <ul class="grid gap-px" style="background:rgba(232,224,204,0.15);">
        {points.map((p, i) => (
          <li class="p-7 md:p-9 grid md:grid-cols-3 gap-5 items-start" style="background:#1F2521;">
            <div>
              <p class="text-[10px] uppercase tracking-[0.28em]" style="color:#A87842;">{p.sous}</p>
              <h3 class="mt-1 font-crimson-pro text-2xl md:text-3xl leading-tight">{p.titre}</h3>
            </div>
            <div>
              <p class="text-[14.5px]" style="color:#D4C8AC;">{p.adresse}</p>
              <p class="mt-2 text-[11.5px] uppercase tracking-[0.22em]" style="color:#A87842;">{p.horaire}</p>
            </div>
            <div class="md:text-right">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-[10.5px] uppercase tracking-[0.22em] border" style="border-color:rgba(168,120,66,0.5); color:#A87842;">{p.tag}</span>
              <p class="mt-3 font-crimson-pro italic text-xl" style="color:#E8E0CC;">{String(i + 1).padStart(2, '0')}</p>
            </div>
          </li>
        ))}
      </ul>

      <!-- Témoignages -->
      <div class="mt-14">
        <p class="text-[10px] uppercase tracking-[0.3em] mb-6" style="color:#A87842;">— Le livre d'or du fournil</p>
        <ul class="grid sm:grid-cols-3 gap-5">
          {temoignages.map((t) => (
            <li class="p-6 border" style="border-color:rgba(232,224,204,0.18);">
              <p class="font-crimson-pro italic text-[15px] md:text-[16px] leading-relaxed" style="color:#E8E0CC;">“{t.texte}”</p>
              <p class="mt-4 text-[11px] uppercase tracking-[0.24em]" style="color:#A87842;">{t.auteur}</p>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-10 pt-6 border-t flex flex-wrap gap-6 text-[14px]" style="border-color:rgba(232,224,204,0.20);">
        <span><span style="color:#A87842;">Tél · </span><a href={`tel:${data.info.telephoneHref}`} class="hover:underline">{data.info.telephone}</a></span>
        <span><span style="color:#A87842;">Email · </span><a href={`mailto:${data.info.email}`} class="hover:underline">{data.info.email}</a></span>
        <span><span style="color:#A87842;">Instagram · </span>{data.info.instagram}</span>
      </div>
    </div>
  </div>
</section>
