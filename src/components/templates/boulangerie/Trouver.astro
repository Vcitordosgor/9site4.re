---
import data from '../../../data/templates/painleve.json';
---
<section id="trouver" class="py-24 md:py-32" style="background:#1A1614; color:#F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-2 gap-12 lg:gap-20 items-center">
    <div class="aspect-[4/3] overflow-hidden">
      <img src="/images/boulangerie/extra-5.webp" alt="Le fournil" class="w-full h-full object-cover" loading="lazy"/>
    </div>
    <div>
      <p class="font-caveat text-3xl mb-2" style="color:#C89B3C;">où nous trouver —</p>
      <h2 class="font-crimson-pro text-4xl md:text-5xl leading-tight mb-8">Le fournil <em class="italic" style="color:#C89B3C;">& deux dépôts.</em></h2>
      <ul class="space-y-6">
        <li>
          <div class="text-[11px] uppercase tracking-[0.28em] mb-1" style="color:#C89B3C;">Fournil — vente directe</div>
          <div class="font-crimson-pro text-xl">La Réunion · côte ouest</div>
          <div class="text-[14px] mt-1" style="color:#E0D2B5;">Mardi → dimanche · selon fournées</div>
        </li>
        <li>
          <div class="text-[11px] uppercase tracking-[0.28em] mb-1" style="color:#C89B3C;">Dépôt centre-ville</div>
          <div class="font-crimson-pro text-xl">Épicerie partenaire · livraison 7h</div>
          <div class="text-[14px] mt-1" style="color:#E0D2B5;">Tradition + brioche · mardi à samedi</div>
        </li>
        <li>
          <div class="text-[11px] uppercase tracking-[0.28em] mb-1" style="color:#C89B3C;">Dépôt nord</div>
          <div class="font-crimson-pro text-xl">Marché bio hebdomadaire</div>
          <div class="text-[14px] mt-1" style="color:#E0D2B5;">Samedi matin · toute la gamme</div>
        </li>
      </ul>
      <div class="mt-10 pt-6 border-t flex flex-wrap gap-6 text-[14px]" style="border-color:rgba(245,235,213,0.20);">
        <span><span style="color:#C89B3C;">Tél · </span><a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a></span>
        <span><span style="color:#C89B3C;">Email · </span><a href={`mailto:${data.info.email}`}>{data.info.email}</a></span>
      </div>
    </div>
  </div>
</section>
