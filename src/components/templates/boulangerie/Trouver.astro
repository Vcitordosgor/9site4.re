---
import data from '../../../data/templates/painleve.json';
const wa = `https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour Mathieu, je souhaite venir au fournil.')}`;
---

<section id="trouver" class="py-20 md:py-28" style="background-color: #F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14">

      <div class="md:col-span-7">
        <p class="font-crimson-pro text-[11px] uppercase tracking-[0.45em] mb-4" style="color: #7A4A2A;">— Le fournil —</p>
        <h2 class="font-crimson-pro font-semibold leading-[0.95]" style="color: #1A1614; font-size: clamp(36px, 5vw, 56px);">
          Venir au
          <em class="block font-caveat not-italic mt-2" style="color: #C89B3C; font-size: clamp(44px, 6vw, 64px);">fournil</em>
        </h2>
        <p class="mt-6 font-crimson-pro text-[15px] leading-relaxed max-w-xl" style="color: rgba(26, 22, 20, 0.78);">
          On ouvre à 7h00. Vers 11h30, la fournée du jour est habituellement épuisée. Le mieux c'est de réserver la veille par WhatsApp — vous récupérez votre pain frais à la sortie du four.
        </p>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          <a href={`tel:${data.info.telephoneHref}`} class="group block p-5 border-2 transition-colors hover:opacity-90" style="background-color: rgba(255,255,255,0.6); border-color: #1A1614;">
            <span class="font-crimson-pro text-[10px] uppercase tracking-[0.25em]" style="color: #7A4A2A;">Téléphone</span>
            <p class="mt-1 font-crimson-pro font-semibold text-xl" style="color: #1A1614;">{data.info.telephone}</p>
          </a>
          <a href={`mailto:${data.info.email}`} class="group block p-5 border-2 transition-colors hover:opacity-90" style="background-color: rgba(255,255,255,0.6); border-color: #1A1614;">
            <span class="font-crimson-pro text-[10px] uppercase tracking-[0.25em]" style="color: #7A4A2A;">Email</span>
            <p class="mt-1 font-crimson-pro font-semibold text-lg break-all" style="color: #1A1614;">{data.info.email}</p>
          </a>
        </div>

        <div class="mt-5">
          <a href={wa} target="_blank" rel="noopener" class="inline-flex items-center justify-center gap-2 h-12 px-7 font-crimson-pro font-semibold text-[13px] tracking-widest rounded-full transition-opacity hover:opacity-90" style="background-color: #1A1614; color: #F5EBD5;">
            WhatsApp · réservation jusqu'à 18h
          </a>
        </div>
      </div>

      <div class="md:col-span-5">
        <div class="p-7 md:p-9 h-full flex flex-col" style="background-color: #1A1614; color: #F5EBD5;">
          <p class="font-crimson-pro text-[10px] uppercase tracking-[0.3em] mb-2" style="color: #C89B3C;">Le fournil</p>
          <p class="font-crimson-pro font-semibold text-xl leading-tight">{data.info.adresseLigne1}</p>
          <p class="font-crimson-pro font-semibold text-xl leading-tight">{data.info.adresseLigne2}</p>

          <div class="mt-6 pt-6 border-t space-y-2.5 font-crimson-pro text-[14px]" style="border-color: rgba(200, 155, 60, 0.3);">
            <div class="flex justify-between gap-3">
              <span class="opacity-65 uppercase tracking-wider text-[10.5px]">Ouverture</span>
              <span class="text-right">{data.info.ouvertureHebdo}</span>
            </div>
            <div class="flex justify-between gap-3">
              <span class="opacity-65 uppercase tracking-wider text-[10.5px]">Fermeture</span>
              <span class="text-right">{data.info.fermeture}</span>
            </div>
            <div class="flex justify-between gap-3">
              <span class="opacity-65 uppercase tracking-wider text-[10.5px]">Rythme</span>
              <span class="text-right">{data.info.rythme}</span>
            </div>
          </div>

          <div class="mt-auto pt-8">
            <p class="font-crimson-pro text-[10px] uppercase tracking-[0.3em] mb-2" style="color: #C89B3C;">À savoir</p>
            <p class="font-caveat text-2xl leading-snug" style="color: #F5EBD5;">
              Le fournil est petit. Quand c'est plein, on accueille dehors sous l'avancée.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
