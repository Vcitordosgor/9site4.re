---
import data from '../../../data/templates/painleve.json';
---

<footer style="background-color: #1A1614; color: #F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 32 32" class="w-9 h-9" style="color: #C89B3C;" aria-hidden="true">
            <g fill="currentColor">
              <path d="M16 4 L16 28" stroke="currentColor" stroke-width="1.5" fill="none"/>
              <ellipse cx="13" cy="9" rx="2" ry="3.5" transform="rotate(-25 13 9)"/>
              <ellipse cx="19" cy="9" rx="2" ry="3.5" transform="rotate(25 19 9)"/>
              <ellipse cx="13" cy="14" rx="2" ry="3.5" transform="rotate(-25 13 14)"/>
              <ellipse cx="19" cy="14" rx="2" ry="3.5" transform="rotate(25 19 14)"/>
              <ellipse cx="13" cy="19" rx="2" ry="3.5" transform="rotate(-25 13 19)"/>
              <ellipse cx="19" cy="19" rx="2" ry="3.5" transform="rotate(25 19 19)"/>
            </g>
          </svg>
          <div class="leading-none">
            <p class="font-crimson-pro font-semibold text-2xl">Le Pain Levé</p>
            <p class="font-caveat text-2xl -mt-1" style="color: #C89B3C;">— fournil artisanal</p>
          </div>
        </div>
        <p class="mt-5 font-crimson-pro text-[14px] leading-relaxed max-w-sm" style="color: rgba(245, 235, 213, 0.8);">
          {data.info.tagline} — Boulangerie au levain mère à La Réunion depuis {data.info.annee}.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-crimson-pro text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #C89B3C;">Le fournil</p>
        <ul class="space-y-2 font-crimson-pro text-[13.5px]">
          <li><a href="#four" class="transition-colors hover:opacity-80">Notre four</a></li>
          <li><a href="#levain" class="transition-colors hover:opacity-80">Notre levain</a></li>
          <li><a href="#carte" class="transition-colors hover:opacity-80">La carte</a></li>
          <li><a href="#calendrier" class="transition-colors hover:opacity-80">Calendrier</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-crimson-pro text-[10px] uppercase tracking-[0.3em] mb-3" style="color: #C89B3C;">Trouver</p>
        <ul class="space-y-2 font-crimson-pro text-[13.5px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="transition-colors hover:opacity-80">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="transition-colors hover:opacity-80 break-all">{data.info.email}</a></li>
          <li style="color: rgba(245, 235, 213, 0.7);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-crimson-pro text-[11px]" style="border-color: rgba(200, 155, 60, 0.3); color: rgba(245, 235, 213, 0.65);">
      <p>© {data.info.annee}–2026 {data.info.nom} · SIRET …{data.info.siret.slice(-5)}</p>
      <p class="font-caveat text-2xl leading-none" style="color: #C89B3C;">{data.info.tagline}</p>
    </div>
  </div>
</footer>
