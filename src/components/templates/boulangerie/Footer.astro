---
import data from '../../../data/templates/painleve.json';
const year = new Date().getFullYear();
---
<footer class="py-14" style="background:#1A1614; color:#F5EBD5;">
  <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-8">
    <div>
      <div class="font-crimson-pro italic text-3xl">Le Pain Levé</div>
      <p class="font-caveat text-xl mt-1" style="color:#C89B3C;">du blé, de l'eau, du sel, du temps</p>
    </div>
    <div class="text-[14px]" style="color:#E0D2B5;">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#C89B3C;">Contact</div>
      <a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a><br/>
      <a href={`mailto:${data.info.email}`}>{data.info.email}</a><br/>
      La Réunion · côte ouest
    </div>
    <div class="text-[14px]" style="color:#E0D2B5;">
      <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#C89B3C;">Fournil</div>
      Mardi → dimanche<br/>3 fournées/jour<br/>Lundi fermé
    </div>
  </div>
  <div class="max-w-content mx-auto px-6 md:px-10 mt-10 pt-5 border-t text-[10px] uppercase tracking-[0.28em]" style="border-color:rgba(245,235,213,0.15); color:#7A5C28;">© {year} Le Pain Levé — Démonstration 9site4</div>
</footer>
