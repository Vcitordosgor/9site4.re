---
import data from '../../../data/templates/encrevolcan.json';
---

<section id="artistes" class="py-20 md:py-28 relative" style="background-color: #1F1A18; color: #EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A11920;">— Les trois mains —</p>
      <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]">
        Les tatoueurs
        <em class="italic block" style="color: #A11920;">de l'atelier.</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {data.artistes.map((a, i) => (
        <article class="group">
          <div class="relative aspect-[3/4] overflow-hidden border" style="border-color: rgb(238 230 216 / 0.18);">
            <img
              src={a.photo}
              alt={`Portrait de ${a.nom}, ${a.role}`}
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 scale-100 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <!-- Overlay rouge bas -->
            <div class="absolute inset-x-0 bottom-0 px-4 py-3" style="background-color: rgb(10 10 10 / 0.92);">
              <p class="font-mono text-[9.5px] uppercase tracking-[0.22em]" style="color: #A11920;">
                ✦ {a.anciennete}
              </p>
            </div>
            <!-- Numéro grand -->
            <span class="absolute top-3 right-3 font-cardo text-4xl leading-none" style="color: #A11920;">
              0{i + 1}
            </span>
          </div>

          <div class="mt-5">
            <h3 class="font-cardo text-2xl md:text-3xl leading-tight">
              {a.nom}
            </h3>
            <p class="mt-1 font-mono text-[10.5px] uppercase tracking-[0.22em]" style="color: #A11920;">
              {a.role}
            </p>
            <p class="mt-3 font-cardo italic text-base md:text-lg leading-snug" style="color: rgb(238 230 216 / 0.82);">
              {a.specialite}
            </p>
            <p class="mt-4 font-mono text-[12px] leading-relaxed" style="color: rgb(238 230 216 / 0.65);">
              {a.bio}
            </p>
          </div>
        </article>
      ))}
    </div>

    <!-- Bandeau bas : engagement collectif -->
    <div class="mt-16 md:mt-20 max-w-3xl mx-auto text-center">
      <div class="flex items-center justify-center gap-3 mb-5" aria-hidden="true">
        <span class="block w-12 h-px" style="background-color: rgb(238 230 216 / 0.3);"></span>
        <span style="color: #A11920;">✦</span>
        <span class="block w-12 h-px" style="background-color: rgb(238 230 216 / 0.3);"></span>
      </div>
      <p class="font-cardo italic text-xl md:text-2xl leading-snug" style="color: rgb(238 230 216 / 0.92);">
        « On dessine d'abord, on tatoue ensuite. Pas l'inverse. »
      </p>
      <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.25em]" style="color: rgb(238 230 216 / 0.55);">
        — Léo Carvalho, fondateur
      </p>
    </div>
  </div>
</section>
