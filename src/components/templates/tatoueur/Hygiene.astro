---
import data from '../../../data/templates/encrevolcan.json';
---

<section class="py-20 md:py-28 relative" style="background-color: #EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A11920;">— Hygiène & matériel —</p>
        <h2 class="font-cardo text-4xl md:text-5xl leading-[0.98]" style="color: #0A0A0A;">
          Stérile,
          <em class="italic" style="color: #A11920;">traçable, conforme.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-cardo italic text-lg leading-relaxed" style="color: rgb(31 26 24 / 0.78);">
          Quatre garanties non négociables, contrôlées par l'Agence régionale de santé.
          Carnet de traçabilité disponible sur demande.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-px" style="background-color: rgba(31, 26, 24, 0.15);">
      {data.hygiene.map((h, i) => (
        <div class="p-7 md:p-8" style="background-color: #EEE6D8;">
          <!-- Icône check encerclé -->
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full mb-5 border-2" style="border-color: #A11920;">
            <svg viewBox="0 0 24 24" class="w-6 h-6" style="color: #A11920;" aria-hidden="true">
              <path d="M5 12l5 5L20 7" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <p class="font-mono text-[10px] uppercase tracking-[0.25em]" style="color: #A11920;">
            0{i + 1}
          </p>
          <h3 class="mt-2 font-cardo text-xl md:text-2xl leading-tight" style="color: #0A0A0A;">
            {h.titre}
          </h3>
          <p class="mt-3 font-mono text-[12.5px] leading-relaxed" style="color: rgb(31 26 24 / 0.75);">
            {h.texte}
          </p>
        </div>
      ))}
    </div>

    <!-- Bandeau certifs -->
    <div class="mt-12 md:mt-16 px-6 md:px-10 py-5 md:py-6 flex flex-col md:flex-row items-center justify-between gap-4 border-2" style="border-color: #0A0A0A;">
      <p class="font-mono text-[11px] md:text-[12px] uppercase tracking-[0.22em] text-center md:text-left" style="color: #0A0A0A;">
        Formation hygiène & salubrité ✦ Déclaration ARS ✦ DASRI agréé
      </p>
      <p class="font-cardo italic text-base md:text-lg" style="color: #A11920;">
        — Arrêté du 12 décembre 2008
      </p>
    </div>
  </div>
</section>
