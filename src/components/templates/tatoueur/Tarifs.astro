---
import data from '../../../data/templates/encrevolcan.json';
---

<section id="tarifs" class="py-20 md:py-28 relative" style="background-color: #1F1A18; color: #EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A11920;">— Tarification —</p>
      <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]">
        Indicatif,
        <em class="italic block" style="color: #A11920;">jamais sorti du chapeau.</em>
      </h2>
      <p class="mt-6 font-cardo italic text-lg md:text-xl leading-relaxed" style="color: rgb(238 230 216 / 0.78);">
        Le devis final dépend du dessin, du placement et du temps réel.
        Vous avez toujours le tarif noir sur blanc avant la première séance.
      </p>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="border-2" style="border-color: rgb(238 230 216 / 0.25);">
        {data.tarification.map((t, i) => (
          <div
            class={`grid grid-cols-12 gap-4 items-baseline px-5 md:px-8 py-5 md:py-7 ${i !== 0 ? 'border-t' : ''}`}
            style="border-color: rgb(238 230 216 / 0.18);"
          >
            <div class="col-span-12 md:col-span-5">
              <p class="font-cardo text-xl md:text-2xl leading-snug">
                {t.categorie}
              </p>
            </div>
            <div class="col-span-7 md:col-span-4">
              <p class="font-mono text-[12px] leading-relaxed" style="color: rgb(238 230 216 / 0.65);">
                {t.detail}
              </p>
            </div>
            <div class="col-span-5 md:col-span-3 text-right">
              <p class="font-cardo italic text-xl md:text-2xl leading-none" style="color: #A11920;">
                {t.prix}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-8 text-center font-mono text-[10.5px] uppercase tracking-[0.25em]" style="color: rgb(238 230 216 / 0.55);">
        ✦ Acompte 30% pour bloquer la séance · Retouche à 6 semaines incluse ✦
      </p>

      <!-- Barème devis / prix au projet -->
      <div class="mt-14 md:mt-16 border-2" style="border-color: rgb(238 230 216 / 0.25);">
        <div class="px-5 md:px-8 py-5 border-b" style="border-color: rgb(238 230 216 / 0.18); background-color: rgb(161 25 32 / 0.08);">
          <p class="font-mono text-[10.5px] uppercase tracking-[0.28em]" style="color: #A11920;">— Devis au projet · barème indicatif —</p>
        </div>
        <ul>
          <li class="grid grid-cols-12 gap-4 items-baseline px-5 md:px-8 py-5">
            <div class="col-span-12 md:col-span-5"><p class="font-cardo text-xl md:text-2xl">Petit motif</p><p class="font-mono text-[12px] mt-1" style="color: rgb(238 230 216 / 0.6);">4 à 6 cm · 1 séance</p></div>
            <div class="col-span-7 md:col-span-4"><p class="font-mono text-[12px]" style="color: rgb(238 230 216 / 0.65);">Lettrage fin, symbole, micro-projet</p></div>
            <div class="col-span-5 md:col-span-3 text-right"><p class="font-cardo italic text-xl md:text-2xl" style="color: #A11920;">80 – 150 €</p></div>
          </li>
          <li class="grid grid-cols-12 gap-4 items-baseline px-5 md:px-8 py-5 border-t" style="border-color: rgb(238 230 216 / 0.18);">
            <div class="col-span-12 md:col-span-5"><p class="font-cardo text-xl md:text-2xl">Pièce moyenne</p><p class="font-mono text-[12px] mt-1" style="color: rgb(238 230 216 / 0.6);">10 à 20 cm · 1 à 2 séances</p></div>
            <div class="col-span-7 md:col-span-4"><p class="font-mono text-[12px]" style="color: rgb(238 230 216 / 0.65);">Avant-bras, mollet, omoplate, dos haut</p></div>
            <div class="col-span-5 md:col-span-3 text-right"><p class="font-cardo italic text-xl md:text-2xl" style="color: #A11920;">150 – 400 €</p></div>
          </li>
          <li class="grid grid-cols-12 gap-4 items-baseline px-5 md:px-8 py-5 border-t" style="border-color: rgb(238 230 216 / 0.18);">
            <div class="col-span-12 md:col-span-5"><p class="font-cardo text-xl md:text-2xl">Grande pièce</p><p class="font-mono text-[12px] mt-1" style="color: rgb(238 230 216 / 0.6);">manchette, dos, cuisse · plusieurs séances</p></div>
            <div class="col-span-7 md:col-span-4"><p class="font-mono text-[12px]" style="color: rgb(238 230 216 / 0.65);">Sleeve, back-piece, composition narrative</p></div>
            <div class="col-span-5 md:col-span-3 text-right"><p class="font-cardo italic text-xl md:text-2xl" style="color: #A11920;">dès 600 €</p></div>
          </li>
          <li class="grid grid-cols-12 gap-4 items-baseline px-5 md:px-8 py-5 border-t" style="border-color: rgb(238 230 216 / 0.18); background-color: rgb(238 230 216 / 0.04);">
            <div class="col-span-12 md:col-span-5"><p class="font-cardo text-xl md:text-2xl">Tarif horaire</p><p class="font-mono text-[12px] mt-1" style="color: rgb(238 230 216 / 0.6);">au-delà de la première heure</p></div>
            <div class="col-span-7 md:col-span-4"><p class="font-mono text-[12px]" style="color: rgb(238 230 216 / 0.65);">Pour les pièces longues et reprises</p></div>
            <div class="col-span-5 md:col-span-3 text-right"><p class="font-cardo italic text-xl md:text-2xl" style="color: #A11920;">100 € / h</p></div>
          </li>
        </ul>
      </div>
    </div>

    <!-- CTA bas -->
    <div class="mt-14 md:mt-20 text-center">
      <a
        href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je voudrais une consultation pour estimer mon projet.')}`}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center justify-center h-13 px-9 py-3.5 font-mono font-semibold text-[12px] uppercase tracking-[0.22em] transition-colors duration-300"
        style="background-color: #A11920; color: #EEE6D8;"
        onmouseover="this.style.backgroundColor='#EEE6D8'; this.style.color='#0A0A0A';"
        onmouseout="this.style.backgroundColor='#A11920'; this.style.color='#EEE6D8';"
      >
        Demander un devis
      </a>
    </div>
  </div>
</section>
