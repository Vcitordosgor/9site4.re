---
const conseils = [
  {
    delai: 'J+0 → J+2',
    titre: 'Film protecteur',
    desc: 'Le film hypoallergénique reste 48 h. Aucune douche directe, pas d\'effort physique, pas de soleil.',
  },
  {
    delai: 'J+2 → J+7',
    titre: 'Nettoyage doux',
    desc: 'Eau tiède + savon pH neutre, 2 fois par jour. Sécher en tamponnant — jamais frotter. Aucune crème grasse.',
  },
  {
    delai: 'J+7 → J+21',
    titre: 'Hydratation ciblée',
    desc: 'Pommade cicatrisante (Bepanthen, Hustle Butter) en couche fine matin et soir. Des squames apparaissent — ne pas gratter.',
  },
  {
    delai: 'J+21 → J+60',
    titre: 'Protection longue',
    desc: 'Cicatrisation complète. SPF 50 systématique en cas d\'exposition. Pas de mer / piscine avant J+30.',
  },
];
---
<section id="soin" class="py-20 md:py-28" style="background:#1F1A18; color:#EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="grid md:grid-cols-12 gap-8 items-end mb-12">
      <div class="md:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color:#A11920;">— Soin & cicatrisation</p>
        <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]">
          Quatre semaines<br/><em class="italic" style="color:#A11920;">de discipline.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-cardo italic text-lg leading-relaxed" style="color:rgb(238 230 216 / 0.75);">
          La qualité finale d'un tatouage se joue à 50 % en cabine, 50 % chez vous. Voici la marche à suivre — imprimée et remise en fin de séance.
        </p>
      </div>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-4 gap-px" style="background:rgb(238 230 216 / 0.10);">
      {conseils.map((c, i) => (
        <li class="p-7 relative" style="background:#1F1A18;">
          <div class="absolute top-0 left-0 right-0 h-[2px]" style="background:#A11920;"></div>
          <div class="font-mono text-[11px] uppercase tracking-[0.28em] mb-3" style="color:#A11920;">Étape 0{i + 1} · {c.delai}</div>
          <svg viewBox="0 0 32 32" class="w-8 h-8 mb-4" fill="none" stroke="#EEE6D8" stroke-width="1.4">
            {i === 0 && <><rect x="6" y="6" width="20" height="20" rx="2"/><path d="M6 12 L26 12"/></>}
            {i === 1 && <><circle cx="16" cy="16" r="9"/><path d="M11 16 Q16 21 21 16"/></>}
            {i === 2 && <><path d="M16 4 C12 12 9 16 9 20 A7 7 0 0 0 23 20 C23 16 20 12 16 4 Z"/></>}
            {i === 3 && <><circle cx="16" cy="16" r="5"/><path d="M16 4 V8 M16 24 V28 M4 16 H8 M24 16 H28 M7 7 L10 10 M22 22 L25 25 M22 10 L25 7 M7 25 L10 22"/></>}
          </svg>
          <h3 class="font-cardo text-2xl leading-tight mb-3">{c.titre}</h3>
          <p class="text-[13.5px] leading-relaxed" style="color:rgb(238 230 216 / 0.72); font-family:'Inter', system-ui, sans-serif;">{c.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
