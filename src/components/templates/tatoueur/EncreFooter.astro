---
import data from '../../../data/templates/encrevolcan.json';
---

<footer style="background-color: #1F1A18; color: #EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 32 32" class="w-9 h-9" style="color: #A11920;" aria-hidden="true">
            <path d="M16 2 L18 14 L26 22 L22 26 L14 18 L2 16 Z" fill="currentColor"/>
            <circle cx="22" cy="22" r="2" fill="#EEE6D8"/>
          </svg>
          <div class="leading-none">
            <p class="font-cardo italic text-2xl">Encre</p>
            <p class="font-mono uppercase tracking-[0.2em] text-[11px] mt-0.5" style="color: #A11920;">Volcan</p>
          </div>
        </div>
        <p class="mt-5 font-mono text-[12.5px] leading-relaxed max-w-sm" style="color: rgb(238 230 216 / 0.7);">
          Atelier de tatouage à La Réunion depuis {data.info.annee}. Trois encreurs résidents.
          Consultation gratuite, sur rendez-vous uniquement.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-mono text-[10px] uppercase tracking-[0.25em] mb-3" style="color: #A11920;">Atelier</p>
        <ul class="space-y-2 font-cardo text-[14px]">
          <li><a href="#styles" class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">Nos styles</a></li>
          <li><a href="#artistes" class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">Les tatoueurs</a></li>
          <li><a href="#flash" class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">Flash sheet</a></li>
          <li><a href="#process" class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">Process</a></li>
          <li><a href="#tarifs" class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">Tarifs</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-mono text-[10px] uppercase tracking-[0.25em] mb-3" style="color: #A11920;">Contact</p>
        <ul class="space-y-2 font-cardo text-[14px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="transition-colors" onmouseover="this.style.color='#A11920';" onmouseout="this.style.color='inherit';">{data.info.email}</a></li>
          <li style="color: rgb(238 230 216 / 0.6);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-mono text-[10.5px] uppercase tracking-[0.18em]" style="border-color: rgba(238, 230, 216, 0.2); color: rgb(238 230 216 / 0.5);">
      <p>© {data.info.annee}–2026 {data.info.nom} · SIRET …{data.info.siret.slice(-5)}</p>
      <p class="font-cardo italic normal-case tracking-normal text-base" style="color: #A11920;">— L'encre, l'aiguille, la main.</p>
    </div>
  </div>
</footer>
