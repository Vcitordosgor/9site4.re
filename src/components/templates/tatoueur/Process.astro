---
import data from '../../../data/templates/encrevolcan.json';
---

<section id="process" class="py-20 md:py-28 relative" style="background-color: #0A0A0A; color: #EEE6D8;">
  <!-- Grain -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.08]" aria-hidden="true">
    <filter id="process-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" />
      <feColorMatrix values="0 0 0 0 0.93  0 0 0 0 0.90  0 0 0 0 0.85  0 0 0 0.18 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#process-grain)" />
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">

    <div class="max-w-2xl mb-14 md:mb-20">
      <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A11920;">— De l'idée à la peau —</p>
      <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]">
        Quatre étapes,
        <em class="italic block" style="color: #A11920;">jamais de raccourci.</em>
      </h2>
    </div>

    <ol class="space-y-px" style="background-color: rgb(238 230 216 / 0.12);">
      {data.process.map((p) => (
        <li class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 p-7 md:p-12 items-start" style="background-color: #0A0A0A;">
          <div class="md:col-span-3">
            <p class="font-cardo italic leading-none" style="color: #A11920; font-size: clamp(56px, 7vw, 96px);">
              {p.etape}
            </p>
          </div>
          <div class="md:col-span-9 md:pl-8 md:border-l" style="border-color: rgb(238 230 216 / 0.2);">
            <h3 class="font-cardo text-2xl md:text-3xl leading-tight">
              {p.titre}
            </h3>
            <p class="mt-4 font-mono text-[13px] md:text-[14px] leading-relaxed max-w-2xl" style="color: rgb(238 230 216 / 0.75);">
              {p.texte}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
