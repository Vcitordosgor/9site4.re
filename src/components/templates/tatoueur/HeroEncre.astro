---
/**
 * HeroEncre — typo XL noir + accent rouge sang, vibe gritty/atelier sombre.
 */
import data from '../../../data/templates/encrevolcan.json';
---

<section id="top" class="relative overflow-hidden" style="background-color: #0A0A0A; color: #EEE6D8;">
  <!-- Grain noir gritty (réduit pour laisser respirer le trait d'aiguille) -->
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.07]" aria-hidden="true">
    <filter id="encre-grain">
      <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="3" />
      <feColorMatrix values="0 0 0 0 0.93  0 0 0 0 0.90  0 0 0 0 0.85  0 0 0 0.18 0" />
    </filter>
    <rect width="100%" height="100%" filter="url(#encre-grain)" />
  </svg>

  <!-- Rouge sang vertical strip à gauche -->
  <div class="absolute top-0 left-0 bottom-0 w-1 md:w-2" style="background-color: #A11920;" aria-hidden="true"></div>

  <!-- Signature tatoueur : trait d'aiguille qui se dessine (épaissi + halo rouge sang) -->
  <svg class="encre-needle absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 1600 900" preserveAspectRatio="none" fill="none" aria-hidden="true">
    <path class="encre-halo" d="M 40 880 C 200 700, 100 520, 320 460 S 700 480, 760 320 S 980 80, 1180 180 S 1500 360, 1560 100"
      stroke="#A11920" stroke-width="6" stroke-linecap="round" opacity="0.32" />
    <path class="encre-trait" d="M 40 880 C 200 700, 100 520, 320 460 S 700 480, 760 320 S 980 80, 1180 180 S 1500 360, 1560 100"
      stroke="#EEE6D8" stroke-width="2.4" stroke-linecap="round" opacity="0.78" />
  </svg>
  <style>
    .encre-needle path {
      stroke-dasharray: 4000;
      stroke-dashoffset: 4000;
      animation: encre-draw 4.5s cubic-bezier(0.65, 0, 0.35, 1) 0.4s forwards;
    }
    .encre-halo { filter: blur(2px); }
    @keyframes encre-draw { to { stroke-dashoffset: 0; } }
    @media (prefers-reduced-motion: reduce) {
      .encre-needle path { stroke-dashoffset: 0; animation: none; }
    }
  </style>

  <div class="max-w-content mx-auto px-6 md:px-10 pt-14 md:pt-24 pb-16 md:pb-28 relative">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 md:gap-14 items-end">

      <!-- Bloc texte -->
      <div class="lg:col-span-7">
        <!-- Eyebrow technique -->
        <div class="flex items-center gap-3 mb-6 md:mb-8">
          <span class="block w-10 h-px" style="background-color: #A11920;" aria-hidden="true"></span>
          <p class="font-mono text-[10px] md:text-[11px] uppercase tracking-[0.4em]" style="color: #A11920;">
            ✦ Atelier — Tatouage signature · depuis {data.info.annee} · {data.info.ville}
          </p>
        </div>

        <!-- Wordmark XXL -->
        <h1 class="font-cardo leading-[0.82]" style="color: #EEE6D8;">
          <span class="block" style="font-size: clamp(72px, 13vw, 184px); letter-spacing: -0.02em;">
            ENCRE
          </span>
          <span class="block italic mt-1" style="font-size: clamp(72px, 13vw, 184px); color: #A11920; letter-spacing: -0.01em;">
            Volcan.
          </span>
        </h1>

        <!-- Tagline serif -->
        <p class="mt-7 md:mt-9 font-cardo italic text-xl md:text-3xl max-w-xl leading-snug" style="color: rgb(238 230 216 / 0.92);">
          {data.info.tagline}
        </p>

        <!-- Description typewriter -->
        <p class="mt-6 font-mono text-[12.5px] md:text-[13.5px] leading-relaxed max-w-lg uppercase tracking-wider" style="color: rgb(238 230 216 / 0.62);">
          3 encreurs résidents — 4 styles signature — rendez-vous uniquement<br/>
          Hygiène autoclave classe B — encres végan REACH 2022
        </p>

        <!-- CTAs -->
        <div class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-3 md:gap-4">
          <a
            href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour, je souhaite réserver une consultation tatouage.')}`}
            target="_blank"
            rel="noopener"
            data-encre-cta="primary"
            class="inline-flex items-center justify-center h-12 px-8 font-mono font-semibold text-[11.5px] uppercase tracking-[0.22em] transition-colors duration-300"
            style="background-color: #A11920; color: #EEE6D8;"
          >
            Réserver consultation
          </a>
          <a
            href="#flash"
            data-encre-cta="ghost"
            class="inline-flex items-center justify-center h-12 px-8 font-mono font-semibold text-[11.5px] uppercase tracking-[0.22em] border-2 transition-colors duration-300"
            style="border-color: #EEE6D8; color: #EEE6D8; background-color: transparent;"
          >
            Voir la flash sheet
          </a>
        </div>
      </div>

      <!-- Photo principale -->
      <div class="lg:col-span-5 relative">
        <div class="relative aspect-[3/4] overflow-hidden border-2" style="border-color: #A11920;">
          <img
            src={data.info.photoHero}
            alt={data.info.photoHeroAlt}
            class="w-full h-full object-cover grayscale contrast-[1.15]"
            width="1600" height="900" loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <!-- Overlay rouge -->
          <div class="absolute inset-0 mix-blend-multiply" style="background-color: rgba(161, 25, 32, 0.18);" aria-hidden="true"></div>
        </div>
        <!-- Cartouche -->
        <div class="absolute -bottom-3 -left-3 md:-bottom-5 md:-left-5 px-4 py-3 font-mono text-[11px] uppercase tracking-[0.18em]" style="background-color: #EEE6D8; color: #0A0A0A;">
          N° 074 · Pleine cuisse
        </div>
      </div>
    </div>

    <!-- Bandeau chiffres bas -->
    <div class="mt-20 md:mt-28 grid grid-cols-3 md:grid-cols-3 gap-px" style="background-color: rgb(238 230 216 / 0.18);" aria-hidden="false">
      <div class="px-4 py-6 md:px-6 md:py-8" style="background-color: #0A0A0A;">
        <p class="font-cardo italic text-3xl md:text-5xl leading-none" style="color: #A11920;">9</p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.22em]" style="color: rgb(238 230 216 / 0.72);">ans d'atelier</p>
      </div>
      <div class="px-4 py-6 md:px-6 md:py-8" style="background-color: #0A0A0A;">
        <p class="font-cardo italic text-3xl md:text-5xl leading-none" style="color: #A11920;">3</p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.22em]" style="color: rgb(238 230 216 / 0.72);">encreurs résidents</p>
      </div>
      <div class="px-4 py-6 md:px-6 md:py-8" style="background-color: #0A0A0A;">
        <p class="font-cardo italic text-3xl md:text-5xl leading-none" style="color: #A11920;">4</p>
        <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.22em]" style="color: rgb(238 230 216 / 0.72);">styles signature</p>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const themePrimary = { bg: '#A11920', fg: '#EEE6D8' };
      const themeGhost   = { bg: 'transparent', fg: '#EEE6D8' };
      const themeHover   = { bg: '#EEE6D8', fg: '#0A0A0A' };
      document.querySelectorAll('[data-encre-cta]').forEach((el) => {
        const base = el.getAttribute('data-encre-cta') === 'primary' ? themePrimary : themeGhost;
        const apply = (t) => {
          el.style.backgroundColor = t.bg;
          el.style.color = t.fg;
        };
        el.addEventListener('mouseenter', () => apply(themeHover));
        el.addEventListener('mouseleave', () => apply(base));
        el.addEventListener('focus', () => apply(themeHover));
        el.addEventListener('blur', () => apply(base));
      });
    })();
  </script>
</section>
