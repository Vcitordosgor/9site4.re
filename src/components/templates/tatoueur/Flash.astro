---
import data from '../../../data/templates/encrevolcan.json';

const flashImages = [
  'https://images.unsplash.com/photo-1611501275019-9b5cda994e8d?q=80&w=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1542856391-010fb87dcfed?q=80&w=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1568515045052-f9a854d70bfd?q=80&w=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1605640840605-14ac1855827b?q=80&w=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1535930749574-1399327ce78f?q=80&w=600&auto=format&fit=crop',
  'https://images.unsplash.com/photo-1543059509-1c12d5f2c1ce?q=80&w=600&auto=format&fit=crop',
];
---

<section id="flash" class="py-20 md:py-28 relative" style="background-color: #EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A11920;">— Flash sheet ce mois —</p>
        <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]" style="color: #0A0A0A;">
          Disponibles
          <em class="italic" style="color: #A11920;">immédiatement.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-cardo italic text-lg leading-relaxed" style="color: rgb(31 26 24 / 0.78);">
          Motifs déjà dessinés, prix forfait, séance bloquée sous deux semaines.
          Un flash par client maximum — chaque pièce sera unique chez vous.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
      {data.flash.map((f, i) => (
        <a
          href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent(`Bonjour, je veux réserver le flash ${f.ref} (${f.style}, ${f.prix}).`)}`}
          target="_blank"
          rel="noopener"
          class="group block relative aspect-[4/5] overflow-hidden border-2 transition-colors"
          style="border-color: #1F1A18;"
          onmouseover="this.style.borderColor='#A11920';"
          onmouseout="this.style.borderColor='#1F1A18';"
        >
          <img
            src={flashImages[i % flashImages.length]}
            alt={`Flash ${f.ref} — ${f.style}`}
            class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 scale-100 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
          <!-- Référence haut -->
          <div class="absolute top-2 left-2 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.18em]" style="background-color: #0A0A0A; color: #EEE6D8;">
            {f.ref}
          </div>
          <!-- Prix bas -->
          <div class="absolute inset-x-0 bottom-0 px-3 py-2.5" style="background-color: rgb(10 10 10 / 0.92);">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[9.5px] uppercase tracking-[0.18em]" style="color: rgb(238 230 216 / 0.7);">
                {f.style}
              </span>
              <span class="font-cardo text-base leading-none" style="color: #A11920;">
                {f.prix}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 md:mt-14 text-center">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em]" style="color: rgb(31 26 24 / 0.6);">
        ✦ Nouvelle flash sheet le premier mardi de chaque mois ✦
      </p>
    </div>
  </div>
</section>
