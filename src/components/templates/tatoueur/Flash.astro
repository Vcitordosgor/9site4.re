---
import data from '../../../data/templates/encrevolcan.json';
---

<section id="flash" class="py-20 md:py-28 relative" style="background-color: #EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color: #A11920;">— Flash sheet ce mois —</p>
        <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]" style="color: #0A0A0A;">
          Disponibles
          <em class="italic" style="color: #A11920;">immédiatement.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-cardo italic text-lg leading-relaxed" style="color: rgb(31 26 24 / 0.78);">
          Motifs déjà dessinés, prix forfait, séance bloquée sous deux semaines.
          Un flash par client maximum — chaque pièce sera unique chez vous.
        </p>
      </div>
    </div>

    <!-- Grille sans photos : cards typographiques avec ref + style + prix -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 md:gap-4">
      {data.flash.map((f) => (
        <a
          href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent(`Bonjour, je veux réserver le flash ${f.ref} (${f.style}, ${f.prix}).`)}`}
          target="_blank"
          rel="noopener"
          class="group block relative aspect-[4/5] overflow-hidden border-2 transition-all flex flex-col p-4 hover:-translate-y-1"
          style="border-color: #1F1A18; background-color: #0A0A0A; color: #EEE6D8;"
          onmouseover="this.style.borderColor='#A11920';"
          onmouseout="this.style.borderColor='#1F1A18';"
        >
          <!-- Référence haut -->
          <div class="font-mono text-[10px] uppercase tracking-[0.22em] opacity-60">{f.ref}</div>
          <!-- Numéro romain géant en filigrane -->
          <div class="flex-1 flex items-center justify-center">
            <span class="font-cardo italic select-none" style="font-size: clamp(64px, 8vw, 96px); color: #A11920; opacity: 0.85;">
              {f.ref.replace(/[^0-9]/g, '') || '✦'}
            </span>
          </div>
          <!-- Style + prix -->
          <div class="mt-auto pt-3 border-t" style="border-color:rgba(238,230,216,0.18);">
            <p class="font-mono text-[9.5px] uppercase tracking-[0.22em] opacity-70 mb-1">{f.style}</p>
            <p class="font-cardo text-xl leading-none" style="color: #A11920;">{f.prix}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="mt-12 md:mt-14 text-center">
      <p class="font-mono text-[11px] uppercase tracking-[0.22em]" style="color: rgb(31 26 24 / 0.6);">
        ✦ Nouvelle flash sheet le premier mardi de chaque mois ✦
      </p>
    </div>
  </div>
</section>
