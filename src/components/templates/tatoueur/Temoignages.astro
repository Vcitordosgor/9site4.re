---
const temoignages = [
  {
    initiales: 'M. C.',
    projet: 'Pièce dorsale · 11h sur 2 séances',
    texte: 'On a passé une heure à parler du projet avant qu\'il dessine. Le résultat dépasse ce que j\'avais imaginé. Le geste est précis, la cabine impeccable, la cicatrisation idéale.',
  },
  {
    initiales: 'L. & R.',
    projet: 'Tatouages assortis · poignets',
    texte: 'On voulait quelque chose de discret mais qui dure. Trait fin, choix d\'encre, taille adaptée à chaque peau — il a su nous freiner quand on voulait trop grand. Bonne décision.',
  },
  {
    initiales: 'J. P.',
    projet: 'Cover-up · avant-bras',
    texte: 'Mon ancien tatouage était à moitié effacé et impossible à reprendre selon trois autres studios. Lui a accepté, dessiné quatre versions, et trouvé la composition qui mange tout l\'ancien tracé. Bluffant.',
  },
];
---
<section id="temoignages" class="py-20 md:py-28" style="background:#EEE6D8;">
  <div class="max-w-content mx-auto px-6 md:px-10">
    <div class="mb-12 max-w-3xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.4em] mb-4" style="color:#A11920;">— Ils témoignent</p>
      <h2 class="font-cardo text-4xl md:text-6xl leading-[0.95]" style="color:#0A0A0A;">Trois retours <em class="italic" style="color:#A11920;">honnêtes.</em></h2>
      <p class="mt-5 font-cardo italic text-lg leading-relaxed" style="color:rgb(31 26 24 / 0.78);">
        Témoignages anonymisés à la demande des clients. Initiales et projet seulement — pas d'avis publics achetés, pas de fausses photos.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-px" style="background:rgb(10 10 10 / 0.15);">
      {temoignages.map((t, i) => (
        <article class="p-8 md:p-9" style="background:#EEE6D8;">
          <div class="font-mono text-[10px] uppercase tracking-[0.32em] mb-5" style="color:#A11920;">N° 0{i + 1}</div>
          <svg viewBox="0 0 30 30" class="w-7 h-7 mb-4" fill="none" stroke="#A11920" stroke-width="1.5">
            <path d="M6 18 Q6 10 14 8 M6 18 L6 24 L12 24 L12 18 Z"/>
            <path d="M18 18 Q18 10 26 8 M18 18 L18 24 L24 24 L24 18 Z"/>
          </svg>
          <p class="font-cardo text-[18px] md:text-[19px] italic leading-relaxed mb-7" style="color:#1F1A18;">« {t.texte} »</p>
          <div class="pt-5 border-t" style="border-color:rgb(10 10 10 / 0.18);">
            <div class="font-cardo text-2xl" style="color:#0A0A0A;">{t.initiales}</div>
            <div class="font-mono text-[10.5px] uppercase tracking-[0.22em] mt-1" style="color:rgb(31 26 24 / 0.6);">{t.projet}</div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
