---
import data from '../../../data/templates/lucas.json';
---

<section class="bg-lucas-vert text-lucas-noir">
  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-7">
        <p class="font-space-mono text-[11px] tracking-tight text-lucas-noir/70 mb-3">
          ▶ # discover.sh
        </p>
        <p class="font-instrument italic text-lucas-noir leading-[1.05]" style="font-size: clamp(28px, 3.6vw, 48px);">
          Premier entretien découverte <span class="font-normal not-italic">offert</span> · 45 min, sans engagement.
        </p>
      </div>
      <div class="md:col-span-5 md:text-right">
        <a
          href="#rendez-vous"
          class="inline-flex items-center justify-center gap-2 h-12 px-7 bg-lucas-noir text-lucas-vert font-hanken font-semibold text-sm hover:bg-lucas-anthracite transition-colors"
        >
          <span class="font-space-mono">▶</span> Planifier l'entretien
        </a>
        <p class="mt-3 font-space-mono text-[11px] tracking-tight text-lucas-noir/70">
          $ tel · {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
