---
/**
 * HeroPortfolio — text-first portfolio. Pas de photo plein écran.
 * Avatar 80px circulaire + curseur clignotant terminal dans l'eyebrow.
 */
import data from '../../../data/templates/lucas.json';
---

<section id="top" class="relative bg-lucas-noir text-lucas-blanc overflow-hidden min-h-[90svh] flex items-center">

  <!-- Subtil gradient en arrière-plan -->
  <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-lucas-vert/40 to-transparent" aria-hidden="true"></div>

  <div class="relative max-w-content mx-auto px-6 md:px-10 pt-32 pb-20 md:pt-40 md:pb-28 w-full">

    <!-- Eyebrow terminal-style avec curseur clignotant -->
    <div class="flex items-baseline gap-2 mb-12 md:mb-16 font-space-mono text-[11px] md:text-[12px] tracking-tight">
      <span class="text-lucas-vert">▶</span>
      <span class="text-lucas-encre">$</span>
      <span class="text-lucas-perle">freelance --senior</span>
      <span class="text-lucas-encre">·</span>
      <span class="text-lucas-perle">whoami</span>
      <span class="text-lucas-encre">→</span>
      <span class="text-lucas-blanc">{data.info.wordmark}</span>
      <span class="text-lucas-encre hidden md:inline">·</span>
      <span class="hidden md:inline text-lucas-encre">{data.info.soustitre}</span>
      <span class="text-lucas-vert ml-1 cursor-blink" aria-hidden="true">▮</span>
    </div>

    <!-- H1 Instrument Serif italique ample -->
    <h1 class="font-instrument italic text-lucas-blanc leading-[0.98]" style="font-size: clamp(56px, 9vw, 148px);">
      J'aide les entreprises à <span class="text-lucas-vert">vraiment</span> utiliser le digital.
    </h1>

    <!-- Sous-titre court neutre -->
    <p class="mt-10 font-hanken text-lucas-perle/85 text-lg md:text-xl leading-relaxed max-w-2xl">
      Stratégie, exécution, mesure. {data.info.experience} ans d'expérience entre la métropole et La Réunion. {data.info.disponibilite}.
    </p>

    <!-- Pseudo-log d'activité 'now.log' : preuve de pratique freelance -->
    <pre class="mt-10 max-w-xl overflow-x-auto rounded-sm bg-lucas-noir ring-1 ring-lucas-vert/20 px-4 py-3.5 font-space-mono text-[11px] md:text-[12px] leading-[1.7] tabular-nums">
<span class="text-lucas-vert">$</span> <span class="text-lucas-perle">tail -f now.log</span>
<span class="text-lucas-encre">─────────────────────────────────────────────</span>
<span class="text-lucas-encre">[2026-01-22]</span> <span class="text-lucas-vert">▸</span> <span class="text-lucas-blanc">Refonte stratégie content B2B</span> <span class="text-lucas-encre">· industrie</span>
<span class="text-lucas-encre">[2026-01-15]</span> <span class="text-lucas-vert">▸</span> <span class="text-lucas-blanc">Audit SEO e-commerce mode</span> <span class="text-lucas-encre">· en cours</span>
<span class="text-lucas-encre">[2026-01-08]</span> <span class="text-lucas-vert">✓</span> <span class="text-lucas-perle/70">Atelier acquisition B2B</span> <span class="text-lucas-encre">· livré</span>
<span class="text-lucas-encre">─────────────────────────────────────────────</span>
    </pre>

    <!-- SIGNATURE : courbe de croissance qui se trace -->
    <figure class="mt-10 max-w-2xl border-l-2 border-lucas-vert/50 pl-5" aria-hidden="true">
      <figcaption class="font-space-mono text-[11px] uppercase tracking-[0.22em] text-lucas-encre mb-2 flex items-baseline justify-between gap-4">
        <span>Acquisition · 12 mois · client e-commerce</span>
        <span class="text-lucas-vert tabular-nums">+184 %</span>
      </figcaption>
      <svg viewBox="0 0 480 100" class="w-full h-auto" role="img" aria-label="Courbe de croissance : +184% sur 12 mois">
        <defs>
          <linearGradient id="lucas-growth-fill" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#A3E635" stop-opacity="0.35"/>
            <stop offset="100%" stop-color="#A3E635" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path
          class="lucas-growth-area"
          d="M0,82 L40,80 L80,76 L120,70 L160,62 L200,55 L240,52 L280,42 L320,32 L360,24 L400,16 L440,10 L480,6 L480,100 L0,100 Z"
          fill="url(#lucas-growth-fill)"
        />
        <path
          class="lucas-growth-line"
          d="M0,82 L40,80 L80,76 L120,70 L160,62 L200,55 L240,52 L280,42 L320,32 L360,24 L400,16 L440,10 L480,6"
          fill="none"
          stroke="#A3E635"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
        <circle class="lucas-growth-dot" cx="480" cy="6" r="4" fill="#A3E635"/>
        <line x1="0" y1="90" x2="480" y2="90" stroke="#3F4045" stroke-width="0.5" stroke-dasharray="2 3"/>
        <text x="2" y="98" font-family="ui-monospace, monospace" font-size="8" fill="#7A7D85">M+0</text>
        <text x="478" y="98" font-family="ui-monospace, monospace" font-size="8" fill="#7A7D85" text-anchor="end">M+12</text>
      </svg>
    </figure>

    <!-- Avatar typographique + ligne d'identité minimale (substitut photo stock) -->
    <div class="mt-12 flex items-center gap-4">
      <span
        class="flex w-14 h-14 md:w-16 md:h-16 rounded-full ring-2 ring-lucas-vert/40 bg-lucas-noir items-center justify-center overflow-hidden"
        role="img"
        aria-label={`Portrait stylisé de ${data.info.wordmark}`}
      >
        <svg viewBox="0 0 64 64" width="100%" height="100%" aria-hidden="true">
          <defs>
            <clipPath id="lucas-portrait-clip"><circle cx="32" cy="32" r="32"/></clipPath>
          </defs>
          <g clip-path="url(#lucas-portrait-clip)">
            <rect width="64" height="64" fill="#0E1014"/>
            <path d="M0 64 C 8 46, 24 42, 32 42 C 40 42, 56 46, 64 64 Z" fill="#A3E635"/>
            <circle cx="32" cy="26" r="11" fill="#A3E635"/>
            <circle cx="32" cy="26" r="11" fill="#0E1014" opacity="0.08"/>
            <path d="M21 25 q11 -16 22 0" fill="none" stroke="#0E1014" stroke-width="1.2" opacity="0.35"/>
          </g>
        </svg>
      </span>
      <div>
        <p class="font-hanken font-semibold text-lucas-blanc text-base">{data.info.wordmark}</p>
        <p class="font-space-mono text-[11px] text-lucas-encre">{data.info.ville} · La Réunion</p>
      </div>
    </div>

    <!-- 3 CTAs : sobres, alignés horizontaux -->
    <div class="mt-14 flex flex-wrap items-center gap-x-8 gap-y-3">
      <a
        href="#missions"
        class="inline-flex items-center gap-2 font-hanken font-semibold text-lucas-vert text-base hover:text-lucas-blanc transition-colors"
      >
        Voir mes missions
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="#rendez-vous"
        class="inline-flex items-center h-12 px-6 bg-lucas-vert text-lucas-noir font-hanken font-semibold text-sm hover:bg-lucas-blanc transition-colors"
      >
        Réserver un appel découverte
      </a>
      <a
        href="#cv"
        class="inline-flex items-center font-hanken text-lucas-perle text-base underline underline-offset-4 decoration-lucas-encre hover:decoration-lucas-vert hover:text-lucas-vert transition-colors"
      >
        Mon CV en PDF
      </a>
    </div>

    <!-- Footer hero : line ID -->
    <div class="mt-20 pt-6 border-t border-lucas-encre/30 flex flex-wrap items-baseline justify-between gap-3 font-space-mono text-[11px] text-lucas-encre">
      <span>~/portfolio · last commit: 2026-01-15</span>
      <span class="hidden md:inline">↓ scroll for more</span>
    </div>
  </div>

  <style>
    .cursor-blink {
      animation: blink 1s step-end infinite;
    }
    @keyframes blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }
    /* Courbe de croissance */
    .lucas-growth-line {
      stroke-dasharray: 700;
      stroke-dashoffset: 700;
      transition: stroke-dashoffset 2.4s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .lucas-growth-area {
      opacity: 0;
      transition: opacity 1.2s ease 1.2s;
    }
    .lucas-growth-dot {
      opacity: 0;
      transform-origin: center;
      transform-box: fill-box;
      transition: opacity 400ms ease 2.2s;
    }
    .is-in .lucas-growth-line { stroke-dashoffset: 0; }
    .is-in .lucas-growth-area { opacity: 1; }
    .is-in .lucas-growth-dot { opacity: 1; animation: lucas-dot-pulse 2s ease-in-out 2.4s infinite; }
    @keyframes lucas-dot-pulse {
      0%, 100% { transform: scale(1); }
      50%      { transform: scale(1.4); }
    }
    @media (prefers-reduced-motion: reduce) {
      .cursor-blink { animation: none; }
      .lucas-growth-line { transition: none; stroke-dashoffset: 0; }
      .lucas-growth-area, .lucas-growth-dot { opacity: 1; transition: none; animation: none; }
    }
  </style>

  <script>
    (function(){
      const fig = document.querySelector('.lucas-growth-line')?.closest('figure');
      if (!fig) return;
      const io = new IntersectionObserver((entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) { (e.target as HTMLElement).classList.add('is-in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.4 });
      io.observe(fig);
    })();
  </script>
</section>
