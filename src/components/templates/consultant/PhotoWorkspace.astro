---
/**
 * PhotoWorkspace — visuel full-bleed minimaliste workspace.
 */
---

<section class="bg-lucas-noir">
  <figure class="relative aspect-[21/9] overflow-hidden bg-lucas-anthracite">
    <img
      src="https://images.unsplash.com/photo-1517292987719-0369a794ec0f?w=1800&q=85"
      alt="Bureau de consultant indépendant, ordinateur ouvert et carnet"
      class="w-full h-full object-cover grayscale"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-lucas-noir via-lucas-noir/40 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-10 left-6 md:left-12 right-6 md:right-12 max-w-2xl">
      <p class="font-space-mono text-[11px] tracking-tight text-lucas-vert mb-2">
        ▶ # workspace
      </p>
      <p class="font-instrument italic text-lucas-blanc leading-[1.1]" style="font-size: clamp(22px, 3vw, 38px);">
        Une mission, un workspace, un livrable.
      </p>
    </figcaption>
  </figure>
</section>
