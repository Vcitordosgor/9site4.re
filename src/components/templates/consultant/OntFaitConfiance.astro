---
const clients = [
  { nom: 'Korail Studio',     mark: 'leaf' },
  { nom: 'Atelier Vavangue',  mark: 'stack' },
  { nom: 'Maison Pitons',     mark: 'triangle' },
  { nom: 'Brassage 974',      mark: 'square' },
  { nom: 'Lagon Conseil',     mark: 'wave' },
];
---

<section id="ont-fait-confiance" class="bg-lucas-noir text-lucas-blanc py-20 md:py-28 px-6 md:px-10 border-t border-lucas-encre/20">
  <div class="max-w-5xl mx-auto">

    <header class="mb-12 md:mb-16">
      <p class="font-space-mono text-[11px] tracking-tight text-lucas-vert mb-5">
        ▶ # references
      </p>
      <h2 class="font-instrument italic text-lucas-blanc leading-[1.05]" style="font-size: clamp(32px, 4.5vw, 56px);">
        Ont fait confiance,<br/>
        <span class="not-italic font-hanken font-semibold text-lucas-perle">cinq structures locales.</span>
      </h2>
    </header>

    <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-px bg-lucas-encre/20 border border-lucas-encre/20" role="list">
      {clients.map((c) => (
        <li class="bg-lucas-noir flex flex-col items-center justify-center gap-3 py-8 px-4 aspect-square">
          <span class="block w-12 h-12 text-lucas-perle" aria-hidden="true">
            {c.mark === 'leaf' && (
              <svg viewBox="0 0 48 48" width="100%" height="100%">
                <path d="M8 40 C 8 20, 24 8, 40 8 C 40 24, 28 40, 8 40 Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M8 40 L 36 12" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            )}
            {c.mark === 'stack' && (
              <svg viewBox="0 0 48 48" width="100%" height="100%">
                <circle cx="24" cy="14" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="26" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <circle cx="24" cy="38" r="8" fill="none" stroke="currentColor" stroke-width="1.6"/>
              </svg>
            )}
            {c.mark === 'triangle' && (
              <svg viewBox="0 0 48 48" width="100%" height="100%">
                <path d="M24 8 L 42 40 L 6 40 Z" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M16 40 L 24 24 L 32 40" fill="none" stroke="currentColor" stroke-width="1.2"/>
              </svg>
            )}
            {c.mark === 'square' && (
              <svg viewBox="0 0 48 48" width="100%" height="100%">
                <rect x="8" y="8" width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <text x="24" y="30" text-anchor="middle" font-family="ui-monospace, monospace" font-size="14" fill="currentColor">B</text>
              </svg>
            )}
            {c.mark === 'wave' && (
              <svg viewBox="0 0 48 48" width="100%" height="100%">
                <path d="M4 28 Q 14 18, 24 28 T 44 28" fill="none" stroke="currentColor" stroke-width="1.6"/>
                <path d="M4 36 Q 14 26, 24 36 T 44 36" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.6"/>
              </svg>
            )}
          </span>
          <p class="font-hanken text-sm text-lucas-perle/80 text-center leading-tight">{c.nom}</p>
        </li>
      ))}
    </ul>

    <p class="mt-8 font-space-mono text-[11px] text-lucas-encre">
      // missions 2023 — 2025 · accompagnement stratégique &amp; opérationnel
    </p>
  </div>
</section>
