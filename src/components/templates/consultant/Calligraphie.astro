---
import '@fontsource/italianno/latin-400.css';
---

<section class="bg-lucas-noir py-28 md:py-40 px-6 md:px-10 relative overflow-hidden">

  <div class="absolute inset-0 pointer-events-none opacity-[0.05]" aria-hidden="true"
       style="background-image: linear-gradient(to right, #00D26A 1px, transparent 1px); background-size: 80px 100%;">
  </div>

  <div class="max-w-content mx-auto relative text-center">

    <p class="font-space-mono text-[11px] uppercase tracking-[0.3em] text-lucas-vert mb-8">
      $ echo "manifeste"
    </p>

    <p class="italianno-line text-lucas-blanc leading-[0.95]" style="font-family: 'Italianno', cursive; font-size: clamp(80px, 16vw, 200px);">
      Pas de magie.
    </p>

    <p class="italianno-line mt-2 text-lucas-vert leading-[0.95]" style="font-family: 'Italianno', cursive; font-size: clamp(80px, 16vw, 200px);">
      Du travail.
    </p>

    <div class="mt-12 flex items-center justify-center gap-3" aria-hidden="true">
      <span class="block w-12 h-px bg-lucas-vert"></span>
      <span class="font-space-mono text-[10px] uppercase tracking-[0.3em] text-lucas-encre">
        Lucas Ferrier · 2017→2026
      </span>
      <span class="block w-12 h-px bg-lucas-vert"></span>
    </div>
  </div>
</section>
