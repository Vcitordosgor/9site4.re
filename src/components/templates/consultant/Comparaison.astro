---
const avant = [
  "Agence : 8 personnes, 4 interlocuteurs",
  "Roadmap rigide vendue avant le diagnostic",
  "Sous-traitance étrangère sur l'exécution",
  "Reporting mensuel formaté, peu lisible",
  "Forfait minimum 30 K€, engagement 12 mois",
];

const apres = [
  "Indépendant : un seul interlocuteur, vous",
  "Diagnostic d'abord, plan d'action ensuite",
  "Exécution faite par moi, intégralement",
  "Slack ouvert, dashboard live, async",
  "Mission packagée 8 K€ ou TJM 850 €",
];
---

<section class="bg-lucas-anthracite py-24 md:py-32 px-6 md:px-10 border-t border-lucas-perle/10">
  <div class="max-w-content mx-auto">

    <header class="mb-14 max-w-3xl">
      <p class="font-space-mono text-[11px] uppercase tracking-[0.3em] text-lucas-vert mb-4">
        ## diff.md
      </p>
      <h2 class="font-hanken font-bold text-lucas-blanc leading-[0.95] tracking-tight" style="font-size: clamp(40px, 6vw, 80px);">
        Agence vs.<br/>
        <span class="font-instrument italic text-lucas-vert font-normal">indépendant.</span>
      </h2>
    </header>

    <div class="grid md:grid-cols-2 gap-px bg-lucas-perle/10 border border-lucas-perle/10">

      <div class="bg-lucas-noir/60 p-7 md:p-9">
        <div class="flex items-center gap-2 mb-6 pb-4 border-b border-lucas-perle/15">
          <span class="font-space-mono text-lucas-encre">−</span>
          <p class="font-space-mono text-[11px] uppercase tracking-[0.22em] text-lucas-encre">
            Avant · agence classique
          </p>
        </div>
        <ul class="space-y-3">
          {avant.map((it) => (
            <li class="flex gap-3 items-start font-hanken text-lucas-perle/70 text-[14.5px] leading-relaxed">
              <span class="font-space-mono text-lucas-encre shrink-0">−</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-lucas-noir p-7 md:p-9 relative">
        <div class="flex items-center gap-2 mb-6 pb-4 border-b border-lucas-vert/30">
          <span class="font-space-mono text-lucas-vert">+</span>
          <p class="font-space-mono text-[11px] uppercase tracking-[0.22em] text-lucas-vert">
            Après · accompagnement Ferrier
          </p>
        </div>
        <ul class="space-y-3">
          {apres.map((it) => (
            <li class="flex gap-3 items-start font-hanken text-lucas-blanc text-[14.5px] leading-relaxed">
              <span class="font-space-mono text-lucas-vert shrink-0">+</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
