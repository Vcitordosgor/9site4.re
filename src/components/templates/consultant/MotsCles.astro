---
/**
 * MotsCles — composition de mots-clés métier flottants en grand format,
 * style impression terminal / éditeur de code.
 */
const mots = [
  { txt: 'Stratégie', size: 'clamp(48px, 8vw, 112px)', col: 'text-lucas-blanc', italic: false, w: 'md:col-span-7' },
  { txt: 'data·driven', size: 'clamp(40px, 6vw, 88px)', col: 'text-lucas-vert', italic: true, w: 'md:col-span-5 md:text-right' },
  { txt: 'SEO', size: 'clamp(56px, 10vw, 140px)', col: 'text-lucas-blanc', italic: false, w: 'md:col-span-4 md:col-start-2' },
  { txt: '/diagnostic/', size: 'clamp(36px, 5vw, 72px)', col: 'text-lucas-perle/65', italic: false, w: 'md:col-span-5', mono: true },
  { txt: 'Acquisition', size: 'clamp(44px, 7vw, 96px)', col: 'text-lucas-vert', italic: true, w: 'md:col-span-3 md:text-right' },
  { txt: 'Analytics', size: 'clamp(48px, 8vw, 108px)', col: 'text-lucas-blanc', italic: false, w: 'md:col-span-6' },
  { txt: '&·exécution', size: 'clamp(36px, 5vw, 72px)', col: 'text-lucas-perle/65', italic: true, w: 'md:col-span-6 md:text-right' },
];
---

<section class="bg-lucas-anthracite py-24 md:py-32 px-6 md:px-10 border-t border-b border-lucas-perle/10 relative overflow-hidden">

  <div class="absolute inset-0 pointer-events-none opacity-[0.04]" aria-hidden="true"
       style="background-image: radial-gradient(circle, #00D26A 1px, transparent 1px); background-size: 24px 24px;">
  </div>

  <div class="max-w-content mx-auto relative">

    <header class="mb-14 max-w-3xl">
      <p class="font-space-mono text-[11px] uppercase tracking-[0.3em] text-lucas-vert mb-4">
        ## terrain.md
      </p>
      <p class="font-instrument italic text-lucas-perle text-xl md:text-2xl">
        Sept mots qui résument une décennie de missions.
      </p>
    </header>

    <ul class="grid md:grid-cols-12 gap-y-6 md:gap-y-8 md:gap-x-4 items-baseline">
      {mots.map((m) => (
        <li class:list={[m.w]}>
          <span
            class:list={[
              'inline-block leading-[0.92] tracking-[-0.02em]',
              m.col,
              m.italic ? 'font-instrument italic' : (m.mono ? 'font-space-mono' : 'font-hanken font-bold'),
            ]}
            style={`font-size: ${m.size};`}
          >
            {m.txt}
          </span>
        </li>
      ))}
    </ul>

    <p class="mt-16 max-w-2xl font-space-mono text-[11px] uppercase tracking-[0.28em] text-lucas-encre">
      // 8 ans · 30+ missions · 1 indépendant
    </p>
  </div>
</section>
