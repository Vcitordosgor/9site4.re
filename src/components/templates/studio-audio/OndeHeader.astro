---
import data from '../../../data/templates/onde.json';

const navLinks = [
  { href: '#services', label: 'Services' },
  { href: '#studio', label: 'Studio' },
  { href: '#ingenieurs', label: 'Équipe' },
  { href: '#process', label: 'Process' },
  { href: '#tarifs', label: 'Tarifs' },
];
---

<header
  id="onde-header"
  data-scrolled="false"
  class="sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500 border-b"
  style="background-color: rgb(13 13 20 / 0.92); border-color: rgb(124 58 237 / 0.3);"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">

    <a href="#top" class="flex items-center gap-2.5 group" aria-label="Onde — accueil">
      <!-- Picto onde sonore -->
      <svg viewBox="0 0 36 36" class="w-8 h-8" aria-hidden="true">
        <rect x="3" y="14" width="2.5" height="8" rx="1" fill="#7C3AED"/>
        <rect x="8" y="10" width="2.5" height="16" rx="1" fill="#22D3EE"/>
        <rect x="13" y="6" width="2.5" height="24" rx="1" fill="#7C3AED"/>
        <rect x="18" y="11" width="2.5" height="14" rx="1" fill="#22D3EE"/>
        <rect x="23" y="14" width="2.5" height="8" rx="1" fill="#7C3AED"/>
        <rect x="28" y="9" width="2.5" height="18" rx="1" fill="#22D3EE"/>
      </svg>
      <div class="flex flex-col leading-none">
        <span class="font-space-grotesk font-bold text-xl md:text-2xl tracking-tight" style="color: #F5F4F8;">Onde</span>
        <span class="font-jetbrains text-[9px] uppercase tracking-[0.28em] mt-0.5" style="color: #22D3EE;">studio_audio</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-9 font-jetbrains text-[11px] uppercase tracking-[0.18em]" aria-label="Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors duration-300" style="color: #F5F4F8;" onmouseover="this.style.color='#22D3EE';" onmouseout="this.style.color='#F5F4F8';">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour Onde, je souhaite réserver une session studio.')}`}
      target="_blank"
      rel="noopener"
      class="hidden md:inline-flex items-center justify-center h-10 px-5 font-jetbrains font-semibold text-[11px] uppercase tracking-[0.18em] transition-all duration-300"
      style="background-color: #7C3AED; color: #F5F4F8; box-shadow: 0 0 16px rgba(124, 58, 237, 0.5);"
      onmouseover="this.style.backgroundColor='#22D3EE'; this.style.color='#0D0D14'; this.style.boxShadow='0 0 18px rgba(34, 211, 238, 0.6)';"
      onmouseout="this.style.backgroundColor='#7C3AED'; this.style.color='#F5F4F8'; this.style.boxShadow='0 0 16px rgba(124, 58, 237, 0.5)';"
    >
      Réserver
    </a>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="md:hidden inline-flex items-center justify-center h-10 px-4 font-jetbrains font-semibold text-[11px] uppercase tracking-wider"
      style="background-color: #7C3AED; color: #F5F4F8;"
      aria-label="Appeler"
    >
      Appeler
    </a>
  </div>
</header>

<style>
  #onde-header[data-scrolled='true'] {
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 0 24px rgba(124, 58, 237, 0.25);
  }
</style>

<script>
  const header = document.getElementById('onde-header');
  if (header) {
    const update = () => { header.dataset.scrolled = String(window.scrollY > 8); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
