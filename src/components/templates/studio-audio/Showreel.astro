---
/**
 * Showreel — extraits audio mock avec waveform SVG + bouton play (UI uniquement, pas de fichier).
 */
const extraits = [
  { titre: 'Mix album folk', sous: 'Voix-guitare + cordes', duree: '03:42', tag: 'Mix' },
  { titre: 'Voix-off documentaire', sous: 'Captation + montage', duree: '01:08', tag: 'Voix' },
  { titre: 'Sound design pub', sous: 'Branding sonore 30s', duree: '00:30', tag: 'Design' },
  { titre: 'Mastering EP rap', sous: 'Loudness streaming', duree: '02:54', tag: 'Master' },
];

// Génération d'une waveform pseudo-aléatoire mais déterministe par seed
const wave = (seed: number, n = 48) => {
  const out: number[] = [];
  let x = seed;
  for (let i = 0; i < n; i++) {
    x = (x * 9301 + 49297) % 233280;
    const v = (x / 233280) * 0.85 + 0.15;
    out.push(v);
  }
  return out;
};

// Waveform du mini-player (40 barres)
const miniWave = wave(101, 40);
---

<section id="showreel" class="py-20 md:py-28" style="background-color: #0D0D14; color: #F5F4F8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-end mb-14">
      <div class="md:col-span-7">
        <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #22D3EE;">// SHOWREEL</p>
        <h2 class="font-space-grotesk font-bold text-4xl md:text-6xl leading-[0.95]">
          Quatre extraits<span style="color: #7C3AED;">,</span><br/>
          quatre univers.
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-jetbrains text-[12.5px] leading-relaxed" style="color: rgb(245 244 248 / 0.75);">
          {'>'} Échantillons de productions réalisées récemment.
          Lecture sur demande après échange — droits cession contrôlés.
        </p>
      </div>
    </div>

    <!-- Mini-player visuel (cosmétique) -->
    <div
      id="onde-mini-player"
      class="mb-10 p-5 md:p-6 border-2"
      style="background-color: rgb(124 58 237 / 0.06); border-color: rgb(124 58 237 / 0.4);"
      aria-label="Lecteur de démonstration (visuel)"
    >
      <div class="flex items-center justify-between gap-4 mb-4">
        <div class="min-w-0">
          <p class="font-jetbrains text-[10px] uppercase tracking-[0.25em]" style="color: #22D3EE;">// NOW_PLAYING</p>
          <p class="mt-1 font-space-grotesk font-bold text-base md:text-lg truncate">
            Demo · Sessions Studio Onde
          </p>
        </div>
        <span
          class="font-jetbrains text-[12px] tabular-nums shrink-0"
          style="color: rgb(245 244 248 / 0.75);"
          data-onde-mp-time
          aria-hidden="true"
        >00:00 / 03:24</span>
      </div>

      <div class="flex items-center gap-4">
        <button
          type="button"
          data-onde-mp-toggle
          aria-pressed="false"
          aria-label="Lecture démo (visuelle)"
          class="w-12 h-12 shrink-0 inline-flex items-center justify-center transition-colors"
          style="background-color: #7C3AED; color: #F5F4F8;"
        >
          <svg data-onde-mp-icon-play viewBox="0 0 24 24" class="w-5 h-5" fill="currentColor" aria-hidden="true">
            <path d="M8 5v14l11-7z"/>
          </svg>
          <svg data-onde-mp-icon-pause viewBox="0 0 24 24" class="w-5 h-5 hidden" fill="currentColor" aria-hidden="true">
            <path d="M6 5h4v14H6zM14 5h4v14h-4z"/>
          </svg>
        </button>

        <div class="flex-1 min-w-0">
          <!-- Waveform statique -->
          <svg viewBox="0 0 240 36" class="w-full h-9 block" aria-hidden="true" preserveAspectRatio="none">
            {miniWave.map((v, idx) => {
              const h = v * 32;
              const y = (36 - h) / 2;
              const x = idx * (240 / miniWave.length);
              const accent = idx % 5 === 0;
              return (
                <rect
                  x={x}
                  y={y}
                  width={(240 / miniWave.length) - 1.5}
                  height={h}
                  fill={accent ? '#22D3EE' : '#7C3AED'}
                  opacity={accent ? 0.85 : 0.55}
                />
              );
            })}
          </svg>

          <!-- Progress bar animée -->
          <div class="mt-2 h-[3px] w-full overflow-hidden" style="background-color: rgb(245 244 248 / 0.12);">
            <div
              class="onde-mp-progress h-full"
              style="background: linear-gradient(90deg, #7C3AED 0%, #22D3EE 100%); width: 100%;"
            ></div>
          </div>
        </div>
      </div>
    </div>

    <ul class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
      {extraits.map((e, i) => {
        const w = wave(i * 17 + 3);
        return (
          <li class="p-5 md:p-6 border" style="background-color: rgb(245 244 248 / 0.03); border-color: rgb(245 244 248 / 0.12);">
            <div class="flex items-start justify-between gap-4">
              <div class="min-w-0">
                <p class="font-jetbrains text-[10px] uppercase tracking-[0.25em]" style="color: #22D3EE;">// {e.tag}</p>
                <h3 class="mt-1 font-space-grotesk font-bold text-xl md:text-2xl leading-tight">{e.titre}</h3>
                <p class="mt-1 font-jetbrains text-[12px]" style="color: rgb(245 244 248 / 0.65);">{e.sous}</p>
              </div>
              <span class="font-jetbrains text-[12px] tabular-nums shrink-0" style="color: rgb(245 244 248 / 0.6);">{e.duree}</span>
            </div>

            <!-- Player mock -->
            <div class="mt-5 flex items-center gap-4">
              <button
                type="button"
                aria-label={`Lecture · ${e.titre}`}
                data-onde-extrait-btn
                class="w-11 h-11 shrink-0 inline-flex items-center justify-center transition-colors"
                style="background-color: #7C3AED; color: #F5F4F8;"
              >
                <span class="font-jetbrains text-sm" aria-hidden="true">▶</span>
              </button>

              <!-- Waveform SVG -->
              <svg viewBox="0 0 240 40" class="flex-1 h-10" aria-hidden="true" preserveAspectRatio="none">
                {w.map((v, idx) => {
                  const h = v * 36;
                  const y = (40 - h) / 2;
                  const x = idx * (240 / w.length);
                  const isPlayed = idx < w.length * 0.3;
                  return (
                    <rect
                      x={x}
                      y={y}
                      width={(240 / w.length) - 1.5}
                      height={h}
                      fill={isPlayed ? '#22D3EE' : 'rgba(245,244,248,0.32)'}
                    />
                  );
                })}
              </svg>

              <span class="font-jetbrains text-[10px] tabular-nums shrink-0" style="color: rgb(245 244 248 / 0.5);">— · —</span>
            </div>
          </li>
        );
      })}
    </ul>

    <p class="mt-8 font-jetbrains text-[11px] uppercase tracking-[0.25em]" style="color: rgb(245 244 248 / 0.5);">
      {'>'} Showreel complet sur demande · NDA possible
    </p>
  </div>

  <style>
    .onde-mp-progress {
      transform-origin: left center;
      animation: onde-mp-fill 30s linear infinite;
      animation-play-state: paused;
      will-change: transform;
    }
    @keyframes onde-mp-fill {
      0%   { transform: scaleX(0); }
      100% { transform: scaleX(1); }
    }
    @media (prefers-reduced-motion: reduce) {
      .onde-mp-progress { animation: none; transform: scaleX(0.15); }
    }
  </style>

  <script>
    // ---------- Color hover refactor (no animation, no reduced-motion gate) ----------
    document.querySelectorAll<HTMLElement>('[data-onde-extrait-btn]').forEach((el) => {
      el.addEventListener('mouseenter', () => {
        el.style.backgroundColor = '#22D3EE';
        el.style.color = '#0D0D14';
      });
      el.addEventListener('mouseleave', () => {
        el.style.backgroundColor = '#7C3AED';
        el.style.color = '#F5F4F8';
      });
    });

    const toggleBtn = document.querySelector<HTMLButtonElement>('[data-onde-mp-toggle]');
    if (toggleBtn) {
      toggleBtn.addEventListener('mouseenter', () => {
        toggleBtn.style.backgroundColor = '#22D3EE';
        toggleBtn.style.color = '#0D0D14';
      });
      toggleBtn.addEventListener('mouseleave', () => {
        toggleBtn.style.backgroundColor = '#7C3AED';
        toggleBtn.style.color = '#F5F4F8';
      });
    }

    // ---------- Mini-player (cosmétique) ----------
    (() => {
      const player = document.getElementById('onde-mini-player');
      if (!player || !toggleBtn) return;

      const progress = player.querySelector<HTMLElement>('.onde-mp-progress');
      const iconPlay = player.querySelector<HTMLElement>('[data-onde-mp-icon-play]');
      const iconPause = player.querySelector<HTMLElement>('[data-onde-mp-icon-pause]');
      const timeEl = player.querySelector<HTMLElement>('[data-onde-mp-time]');

      const TOTAL = 204; // 03:24 in seconds
      let elapsed = 0;
      let isPlaying = false;
      let inView = true;
      let tickId: number | null = null;

      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

      const fmt = (s: number) => {
        const m = Math.floor(s / 60).toString().padStart(2, '0');
        const sec = Math.floor(s % 60).toString().padStart(2, '0');
        return `${m}:${sec}`;
      };

      const renderTime = () => {
        if (timeEl) timeEl.textContent = `${fmt(elapsed)} / 03:24`;
      };

      const applyAnimState = () => {
        if (!progress) return;
        if (reduced) {
          progress.style.animationPlayState = 'paused';
          return;
        }
        progress.style.animationPlayState = (isPlaying && inView) ? 'running' : 'paused';
      };

      const startTick = () => {
        if (tickId !== null) return;
        tickId = window.setInterval(() => {
          elapsed = (elapsed + 1) % (TOTAL + 1);
          renderTime();
        }, 1000);
      };
      const stopTick = () => {
        if (tickId !== null) { clearInterval(tickId); tickId = null; }
      };

      const setPlaying = (next: boolean) => {
        isPlaying = next;
        toggleBtn.setAttribute('aria-pressed', String(isPlaying));
        if (iconPlay && iconPause) {
          iconPlay.classList.toggle('hidden', isPlaying);
          iconPause.classList.toggle('hidden', !isPlaying);
        }
        applyAnimState();
        if (isPlaying) startTick(); else stopTick();
      };

      toggleBtn.addEventListener('click', () => setPlaying(!isPlaying));

      // Pause animation when out of viewport
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            inView = entry.isIntersecting;
            applyAnimState();
            if (!inView) stopTick();
            else if (isPlaying) startTick();
          }
        }, { threshold: 0.05 });
        io.observe(player);
      }

      renderTime();
      applyAnimState();
    })();
  </script>
</section>
