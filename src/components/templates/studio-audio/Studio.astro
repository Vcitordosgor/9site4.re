---
import data from '../../../data/templates/onde.json';
---

<section id="studio" class="py-20 md:py-28" style="background-color: #F5F4F8; color: #0D0D14;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-end mb-14 md:mb-20">
      <div class="md:col-span-7">
        <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #7C3AED;">// ÉQUIPEMENT</p>
        <h2 class="font-space-grotesk font-bold text-4xl md:text-6xl leading-[0.95]">
          Le matériel,
          <span style="color: #7C3AED;">listé sans tabou.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-jetbrains text-[12.5px] leading-relaxed" style="color: rgb(13 13 20 / 0.75);">
          {'>'} Pas de mystère. Voici la chaîne complète de capture, de traitement
          et de monitoring. Si vous demandez du matos spécifique, on loue.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style="background-color: rgb(13 13 20 / 0.15);">
      {data.equipement.map((e, i) => (
        <div class="p-6 md:p-8" style="background-color: #F5F4F8;">
          <p class="font-jetbrains text-[10px] uppercase tracking-[0.25em] mb-1" style="color: #7C3AED;">
            // 0{i + 1}
          </p>
          <h3 class="font-space-grotesk font-bold text-2xl md:text-3xl leading-tight" style="color: #0D0D14;">
            {e.categorie}
          </h3>
          <ul class="mt-5 space-y-2">
            {e.items.map((item) => (
              <li class="flex items-start gap-2.5 font-jetbrains text-[12px] leading-snug" style="color: rgb(13 13 20 / 0.78);">
                <span style="color: #22D3EE;">▸</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bandeau note -->
    <div class="mt-12 md:mt-14 px-6 md:px-8 py-5 md:py-6 flex items-start gap-4 border-l-4" style="background-color: rgb(124 58 237 / 0.05); border-color: #7C3AED;">
      <p style="color: #22D3EE;" class="font-jetbrains text-lg">{'>'}</p>
      <p class="font-jetbrains text-[12.5px] md:text-[13px] leading-relaxed" style="color: rgb(13 13 20 / 0.78);">
        Maintenance trimestrielle de tous les équipements analogiques.
        Calibration bi-annuelle des monitors. Traitement acoustique cabine RT60 inférieur à 0.3s.
        Procédure backup quotidienne sur NAS RAID6 + cloud sécurisé.
      </p>
    </div>
  </div>
</section>
