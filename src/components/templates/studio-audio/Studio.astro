---
import data from '../../../data/templates/onde.json';
---

<section id="studio" class="py-20 md:py-28" style="background-color: #F5F4F8; color: #0D0D14;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-end mb-14 md:mb-20">
      <div class="md:col-span-7">
        <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #7C3AED;">// ÉQUIPEMENT</p>
        <h2 class="font-space-grotesk font-bold text-4xl md:text-6xl leading-[0.95]">
          Le matériel,
          <span style="color: #7C3AED;">listé sans tabou.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-jetbrains text-[12.5px] leading-relaxed" style="color: rgb(13 13 20 / 0.75);">
          {'>'} Pas de mystère. Voici la chaîne complète de capture, de traitement
          et de monitoring. Si vous demandez du matos spécifique, on loue.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px" style="background-color: rgb(13 13 20 / 0.15);">
      {data.equipement.map((e, i) => (
        <div class="p-6 md:p-8" style="background-color: #F5F4F8;">
          <p class="font-jetbrains text-[10px] uppercase tracking-[0.25em] mb-1" style="color: #7C3AED;">
            // 0{i + 1}
          </p>
          <h3 class="font-space-grotesk font-bold text-2xl md:text-3xl leading-tight" style="color: #0D0D14;">
            {e.categorie}
          </h3>
          <ul class="mt-5 space-y-2">
            {e.items.map((item) => (
              <li class="flex items-start gap-2.5 font-jetbrains text-[12px] leading-snug" style="color: rgb(13 13 20 / 0.78);">
                <span style="color: #22D3EE;">▸</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Tableau matériel pro détaillé (génériques, sans marques) -->
    <div class="mt-16 md:mt-20">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-end mb-8">
        <div class="md:col-span-7">
          <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-3" style="color: #7C3AED;">// MATÉRIEL · DÉTAIL</p>
          <h3 class="font-space-grotesk font-bold text-3xl md:text-4xl leading-tight">
            Le détail<span style="color: #7C3AED;">,</span> poste par poste.
          </h3>
        </div>
        <div class="md:col-span-5">
          <p class="font-jetbrains text-[12.5px] leading-relaxed" style="color: rgb(13 13 20 / 0.75);">
            {'>'} Inventaire complet du studio, par familles, en spécifications génériques.
          </p>
        </div>
      </div>

      <div class="border" style="border-color: rgb(13 13 20 / 0.18);">
        {[
          { poste: 'Console', detail: 'Console large format 48 pistes, sommation analogique, automation moteur, patchbay TT 192 points' },
          { poste: 'Convertisseurs', detail: 'AD/DA 32 canaux 24-bit / 192 kHz, horloge maître externe stabilisée OCXO' },
          { poste: 'Micros statiques', detail: 'Condensateurs grande membrane (paire stéréo), petite membrane appairés, capsule tube vintage-style' },
          { poste: 'Micros dynamiques', detail: 'Dynamiques large et petite membrane pour batterie, broadcast voix-off, instruments amplifiés' },
          { poste: 'Préamplis', detail: '8 préamplis à transformateur classe A · 4 préamplis à lampe · 8 préamplis transparents discret' },
          { poste: 'Compression / EQ', detail: 'Compresseurs opto, VCA et FET en rack 19" · égaliseurs Pultec-style et paramétriques 4 bandes' },
          { poste: 'Monitors near-field', detail: 'Monitoring near-field actif haut de gamme + sub calibré, écoutes secondaires alternatives' },
          { poste: 'Casques de référence', detail: '6 casques fermés de référence pour tracking + 2 casques ouverts pour mixage' },
          { poste: 'Acoustique', detail: 'Cabine traitée RT60 < 0.3s · diffuseurs Schroeder · pièges à basses · vitrage 2 verres' },
          { poste: 'Suite logicielle', detail: 'DAW pro multi-pistes, suites de plugins analogiques modélisés, instruments virtuels orchestraux et synthés' },
          { poste: 'Sauvegarde', detail: 'NAS RAID6 redondé · backup cloud chiffré quotidien · archivage projets sur 10 ans' },
        ].map((row, i) => (
          <div class={`grid grid-cols-1 md:grid-cols-12 gap-3 px-5 md:px-7 py-4 md:py-5 ${i > 0 ? 'border-t' : ''}`} style="border-color: rgb(13 13 20 / 0.12);">
            <div class="md:col-span-4">
              <p class="font-space-grotesk font-bold text-base md:text-lg" style="color: #0D0D14;">{row.poste}</p>
            </div>
            <div class="md:col-span-8">
              <p class="font-jetbrains text-[12.5px] leading-relaxed" style="color: rgb(13 13 20 / 0.78);">{row.detail}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Bandeau note -->
    <div class="mt-12 md:mt-14 px-6 md:px-8 py-5 md:py-6 flex items-start gap-4 border-l-4" style="background-color: rgb(124 58 237 / 0.05); border-color: #7C3AED;">
      <p style="color: #22D3EE;" class="font-jetbrains text-lg">{'>'}</p>
      <p class="font-jetbrains text-[12.5px] md:text-[13px] leading-relaxed" style="color: rgb(13 13 20 / 0.78);">
        Maintenance trimestrielle de tous les équipements analogiques.
        Calibration bi-annuelle des monitors. Traitement acoustique cabine RT60 inférieur à 0.3s.
        Procédure backup quotidienne sur NAS RAID6 + cloud sécurisé.
      </p>
    </div>
  </div>
</section>
