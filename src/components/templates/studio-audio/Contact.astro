---
import data from '../../../data/templates/onde.json';
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden" style="background-color: #0D0D14; color: #F5F4F8;">

  <!-- Glow -->
  <div class="absolute -top-32 left-1/2 w-[600px] h-[600px] rounded-full blur-3xl opacity-20 pointer-events-none -translate-x-1/2" style="background: radial-gradient(circle, #7C3AED 0%, transparent 70%);" aria-hidden="true"></div>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">

    <div class="text-center max-w-2xl mx-auto mb-12 md:mb-16">
      <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #22D3EE;">// BOOK_SESSION</p>
      <h2 class="font-space-grotesk font-bold text-4xl md:text-6xl leading-[0.95]">
        Réservez,
        <span style="color: #7C3AED;">on s'occupe du son.</span>
      </h2>
      <p class="mt-6 font-jetbrains text-[12.5px] md:text-[13.5px] leading-relaxed" style="color: rgb(245 244 248 / 0.7);">
        {'>'} Devis personnalisé sous 48h. Première heure offerte
        sur les sessions confirmées avant le 15 du mois.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 max-w-4xl mx-auto">

      <a
        href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour Onde, je souhaite réserver une session studio.')}`}
        target="_blank"
        rel="noopener"
        class="group p-7 md:p-10 text-center border-2 transition-all"
        data-onde-contact-card
        style="background-color: rgb(124 58 237 / 0.08); border-color: rgb(124 58 237 / 0.4);"
      >
        <svg viewBox="0 0 32 32" class="w-10 h-10 mx-auto mb-4" style="color: #22D3EE;" aria-hidden="true">
          <path fill="currentColor" d="M16 3C9 3 3.5 8.5 3.5 15.5c0 2.3.6 4.4 1.7 6.3L3 29l7.4-1.9c1.8 1 3.8 1.5 5.6 1.5 7 0 12.5-5.5 12.5-12.5S23 3 16 3zm0 22.7c-1.6 0-3.3-.4-4.7-1.2l-.3-.2-4.4 1.1 1.2-4.3-.2-.4c-1-1.6-1.5-3.4-1.5-5.2 0-5.5 4.4-9.9 9.9-9.9s9.9 4.4 9.9 9.9-4.4 10.2-9.9 10.2z"/>
        </svg>
        <p class="font-jetbrains text-[10.5px] uppercase tracking-[0.25em] mb-2" style="color: #22D3EE;">
          // WHATSAPP
        </p>
        <p class="font-space-grotesk font-bold text-lg md:text-xl">
          Écrire au studio
        </p>
      </a>

      <a
        href={`tel:${data.info.telephoneHref}`}
        class="group p-7 md:p-10 text-center border-2 transition-all"
        data-onde-contact-card
        style="background-color: rgb(124 58 237 / 0.08); border-color: rgb(124 58 237 / 0.4);"
      >
        <svg viewBox="0 0 24 24" class="w-10 h-10 mx-auto mb-4" style="color: #22D3EE;" aria-hidden="true">
          <path fill="currentColor" d="M6.62 10.79a15.46 15.46 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        <p class="font-jetbrains text-[10.5px] uppercase tracking-[0.25em] mb-2" style="color: #22D3EE;">
          // PHONE
        </p>
        <p class="font-space-grotesk font-bold text-lg md:text-xl">
          {data.info.telephone}
        </p>
      </a>

      <a
        href={`mailto:${data.info.email}`}
        class="group p-7 md:p-10 text-center border-2 transition-all"
        data-onde-contact-card
        style="background-color: rgb(124 58 237 / 0.08); border-color: rgb(124 58 237 / 0.4);"
      >
        <svg viewBox="0 0 24 24" class="w-10 h-10 mx-auto mb-4" style="color: #22D3EE;" aria-hidden="true">
          <path fill="currentColor" d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
        </svg>
        <p class="font-jetbrains text-[10.5px] uppercase tracking-[0.25em] mb-2" style="color: #22D3EE;">
          // EMAIL
        </p>
        <p class="font-space-grotesk font-bold text-base md:text-lg break-all">
          {data.info.email}
        </p>
      </a>
    </div>

    <!-- Horaires -->
    <div class="mt-16 md:mt-20 text-center max-w-md mx-auto border p-7" style="border-color: rgb(124 58 237 / 0.3); background-color: rgb(124 58 237 / 0.05);">
      <p class="font-jetbrains text-[10.5px] uppercase tracking-[0.3em] mb-3" style="color: #22D3EE;">
        // STUDIO_HOURS
      </p>
      <p class="font-space-grotesk font-bold text-lg md:text-xl">{data.info.ouvertureHebdo}</p>
      <p class="mt-2 font-jetbrains text-[12px]" style="color: rgb(245 244 248 / 0.65);">
        ▸ Fermé {data.info.fermeture}
      </p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-onde-contact-card]').forEach((el) => {
    el.addEventListener('mouseenter', () => {
      el.style.borderColor = '#22D3EE';
      el.style.boxShadow = '0 0 24px rgba(34, 211, 238, 0.3)';
    });
    el.addEventListener('mouseleave', () => {
      el.style.borderColor = 'rgb(124 58 237 / 0.4)';
      el.style.boxShadow = 'none';
    });
  });
</script>
