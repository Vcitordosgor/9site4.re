---
import data from '../../../data/templates/onde.json';
---

<section id="tarifs" class="py-20 md:py-28" style="background-color: #F5F4F8; color: #0D0D14;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #7C3AED;">// TARIFS</p>
      <h2 class="font-space-grotesk font-bold text-4xl md:text-6xl leading-[0.95]">
        Grille publique,
        <span style="color: #7C3AED;">devis personnalisé sous 48h.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6 max-w-4xl mx-auto">
      {data.tarifs.map((t, i) => (
        <div class="relative p-7 md:p-9 transition-all hover:-translate-y-1 border-2" style={`background-color: #FFFFFF; border-color: ${i === 4 || i === 5 ? '#22D3EE' : '#0D0D14'};`}>

          {(i === 4 || i === 5) && (
            <span class="absolute -top-3 right-5 px-3 py-1 font-jetbrains text-[10px] uppercase tracking-wider" style="background-color: #22D3EE; color: #0D0D14;">
              ▸ POPULAR
            </span>
          )}

          <p class="font-jetbrains text-[10px] uppercase tracking-[0.22em] mb-2" style="color: #7C3AED;">
            // PACK_0{i + 1}
          </p>
          <h3 class="font-space-grotesk font-bold text-xl md:text-2xl leading-tight">
            {t.type}
          </h3>
          <p class="mt-2 font-jetbrains text-[12px]" style="color: rgb(13 13 20 / 0.6);">
            {t.duree}
          </p>

          <p class="mt-6 font-space-grotesk font-bold text-3xl md:text-4xl" style={`color: ${i === 4 || i === 5 ? '#22D3EE' : '#7C3AED'};`}>
            {t.prix}
          </p>
        </div>
      ))}
    </div>

    <p class="mt-10 text-center font-jetbrains text-[11.5px] uppercase tracking-[0.22em]" style="color: rgb(13 13 20 / 0.6);">
      ▸ TVA 20% incluse · acompte 30% à la réservation · révisions 2 incluses ▸
    </p>
  </div>
</section>
