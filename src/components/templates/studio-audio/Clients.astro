---
import data from '../../../data/templates/onde.json';

const total = data.clients.reduce((acc, c) => acc + c.nombre, 0);
const maxN = Math.max(...data.clients.map(c => c.nombre));
---

<section class="py-20 md:py-28" style="background-color: #0D0D14; color: #F5F4F8;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-jetbrains text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #22D3EE;">// CLIENTS</p>
        <h2 class="font-space-grotesk font-bold text-4xl md:text-6xl leading-[0.95]">
          245 sessions,
          <span style="color: #7C3AED;">six esthétiques.</span>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-jetbrains text-[12.5px] leading-relaxed" style="color: rgb(245 244 248 / 0.7);">
          {'>'} Pas de spécialité unique. Le studio s'adapte au son
          recherché, quel que soit le genre. Répartition réelle de 2018 à 2024.
        </p>
      </div>
    </div>

    <ul class="space-y-3">
      {data.clients.map((c) => (
        <li class="grid grid-cols-12 gap-4 items-center p-5 md:p-6 border" style="background-color: rgb(124 58 237 / 0.05); border-color: rgb(124 58 237 / 0.3);">

          <div class="col-span-12 md:col-span-4">
            <p class="font-space-grotesk font-bold text-lg md:text-xl">
              {c.genre}
            </p>
          </div>

          <div class="col-span-9 md:col-span-6">
            <!-- Barre de progression -->
            <div class="w-full h-2 rounded-full overflow-hidden" style="background-color: rgb(245 244 248 / 0.1);">
              <div
                class="h-full rounded-full"
                style={`width: ${(c.nombre / maxN) * 100}%; background: linear-gradient(90deg, #7C3AED, #22D3EE); box-shadow: 0 0 12px rgba(34, 211, 238, 0.5);`}
              ></div>
            </div>
          </div>

          <div class="col-span-3 md:col-span-2 text-right">
            <p class="font-jetbrains font-semibold text-base md:text-lg" style="color: #22D3EE;">
              {c.nombre}
            </p>
            <p class="font-jetbrains text-[10px] uppercase tracking-[0.18em]" style="color: rgb(245 244 248 / 0.5);">
              sessions
            </p>
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-center font-jetbrains text-[11.5px] uppercase tracking-[0.25em]" style="color: rgb(245 244 248 / 0.55);">
      ▸ Total {total} sessions enregistrées depuis 2018 ▸
    </p>
  </div>
</section>
