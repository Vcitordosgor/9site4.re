---
import data from '../../../data/templates/source.json';
---

<section id="methode" class="py-20 md:py-28 relative" style="background-color: #E4F0EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-14 md:mb-20">
      <div class="md:col-span-7">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #5D7C68;">— Notre méthode —</p>
        <h2 class="font-lora text-4xl md:text-5xl leading-tight" style="color: #1F2926;">
          Quatre étapes,
          <em class="italic" style="color: #5D7C68;">trois mois d'accompagnement.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-manrope text-[15px] leading-relaxed" style="color: rgb(31 41 38 / 0.78);">
          Pas de programme tout-en-un. Chaque accompagnement se construit autour de
          votre rythme, vos contraintes, votre histoire de santé.
        </p>
      </div>
    </div>

    <ol class="relative">
      <!-- Ligne verticale -->
      <div class="absolute left-6 md:left-10 top-0 bottom-0 w-px hidden md:block" style="background-color: rgb(93 124 104 / 0.3);" aria-hidden="true"></div>

      {data.methode.map((m, i) => (
        <li class={`relative grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-10 items-start ${i !== 0 ? 'mt-12 md:mt-16' : ''}`}>

          <!-- Numéro -->
          <div class="md:col-span-3 flex items-center md:items-start gap-4">
            <div class="relative shrink-0 w-12 h-12 md:w-20 md:h-20 rounded-full flex items-center justify-center z-10" style="background-color: #1F2926; color: #FFFFFF;">
              <span class="font-lora italic text-xl md:text-3xl">{m.etape}</span>
            </div>
          </div>

          <!-- Texte -->
          <div class="md:col-span-9 md:pl-4">
            <h3 class="font-lora text-2xl md:text-3xl leading-tight" style="color: #1F2926;">
              {m.titre}
            </h3>
            <p class="mt-4 font-manrope text-[14.5px] md:text-[15px] leading-relaxed max-w-2xl" style="color: rgb(31 41 38 / 0.78);">
              {m.texte}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
