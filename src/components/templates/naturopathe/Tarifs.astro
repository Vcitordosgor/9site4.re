---
import data from '../../../data/templates/source.json';
---

<section id="tarifs" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #5D7C68;">— Tarifs —</p>
      <h2 class="font-lora text-4xl md:text-5xl leading-tight" style="color: #1F2926;">
        Honoraires
        <em class="italic" style="color: #5D7C68;">transparents.</em>
      </h2>
    </div>

    <div class="max-w-4xl mx-auto">
      <div class="rounded-2xl overflow-hidden" style="background-color: #E4F0EE;">
        {data.tarifs.map((t, i) => (
          <div
            class={`grid grid-cols-12 gap-4 items-baseline px-6 md:px-8 py-5 md:py-7 ${i !== 0 ? 'border-t' : ''}`}
            style="border-color: rgb(93 124 104 / 0.2);"
          >
            <div class="col-span-12 md:col-span-5">
              <p class="font-lora text-xl md:text-2xl leading-snug" style="color: #1F2926;">
                {t.categorie}
              </p>
              <p class="mt-1 font-manrope text-[12px] uppercase tracking-[0.15em]" style="color: #5D7C68;">
                ✦ {t.duree}
              </p>
            </div>
            <div class="col-span-7 md:col-span-5">
              <p class="font-manrope text-[14px] leading-relaxed" style="color: rgb(31 41 38 / 0.75);">
                {t.detail}
              </p>
            </div>
            <div class="col-span-5 md:col-span-2 text-right">
              <p class="font-lora italic text-2xl md:text-3xl leading-none" style="color: #5D7C68;">
                {t.prix}
              </p>
            </div>
          </div>
        ))}
      </div>

      <p class="mt-7 text-center font-manrope text-[12px]" style="color: rgb(31 41 38 / 0.6);">
        ✦ Facture mutuelle fournie · Règlement CB, virement ou espèces ✦
      </p>
    </div>
  </div>
</section>
