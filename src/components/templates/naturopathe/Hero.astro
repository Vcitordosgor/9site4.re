---
import data from '../../../data/templates/source.json';
const info = data.info;
---

<section id="top" class="relative overflow-hidden" style="background-color: #F1ECE0;">
  <!-- Single clean hero photo (no overlaid header bug) -->
  <div class="relative max-w-content mx-auto px-5 md:px-10 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-end">

      <div class="lg:col-span-7">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-5" style="color: #B5613F;">
          Cabinet de naturopathie · La Réunion · depuis {info.annee}
        </p>
        <h1 class="font-cormorant leading-[0.98]" style="color: #2E3826; font-size: clamp(46px, 8vw, 110px);">
          Comprendre,<br/>accompagner,<br/><em class="italic" style="color: #4F5D43;">ralentir.</em>
        </h1>
        <p class="mt-8 font-manrope text-[15px] md:text-[16px] leading-relaxed max-w-xl" style="color: rgba(46,56,38,0.78);">
          {data.promesse}
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a href="#rendez-vous" class="inline-flex items-center justify-center h-12 px-7 font-manrope font-medium text-[13px] tracking-wider transition-colors" style="background-color: #2E3826; color: #F1ECE0;">
            Réserver un premier RDV
          </a>
          <a href="#methode" class="inline-flex items-center justify-center h-12 px-7 font-manrope font-medium text-[13px] tracking-wider border transition-colors" style="border-color: #2E3826; color: #2E3826;">
            La méthode →
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="aspect-[4/5] overflow-hidden">
          <img src={info.photoHero} alt={info.photoHeroAlt} loading="eager" fetchpriority="high" class="w-full h-full object-cover" />
        </div>
      </div>
    </div>

    <!-- Botanical scroll cue -->
    <div class="mt-16 flex items-center gap-4">
      <span class="block w-12 h-px" style="background-color: #4F5D43;"></span>
      <p class="font-cormorant italic text-lg" style="color: #4F5D43;">— En complément du suivi médical, jamais en remplacement.</p>
    </div>
  </div>
</section>
