---
import data from '../../../data/templates/source.json';
const info = data.info;
---

<section id="top" class="relative overflow-hidden" style="background-color: #F1ECE0;">
  <style>
    .nat-plant { transform-origin: 60px 600px; }
    .nat-stem {
      stroke-dasharray: 1200;
      stroke-dashoffset: 1200;
    }
    .nat-leaf {
      transform-box: fill-box;
      transform-origin: center;
      opacity: 0; transform: scale(0);
    }
    /* Joué à l'apparition (scroll-triggered via IntersectionObserver) */
    .nat-plant.is-in .nat-stem {
      animation: nat-grow 2.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .nat-plant.is-in .nat-leaf {
      animation: nat-leaf 700ms cubic-bezier(0.34, 1.4, 0.5, 1) forwards;
      animation-delay: calc(0.4s + var(--i) * 0.32s);
    }
    /* Boucle continue : frémissement très lent de la tige (8s) */
    .nat-plant.is-in .nat-stem-sway {
      animation: nat-grow 2.6s cubic-bezier(0.16, 1, 0.3, 1) forwards,
                 nat-sway 9s ease-in-out 2.6s infinite;
      transform-origin: 60px 600px;
    }
    @keyframes nat-grow { to { stroke-dashoffset: 0; } }
    @keyframes nat-leaf { to { opacity: 0.85; transform: scale(1); } }
    @keyframes nat-sway {
      0%, 100% { transform: rotate(-0.6deg); }
      50%      { transform: rotate(0.6deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .nat-stem, .nat-stem-sway { animation: none !important; stroke-dashoffset: 0; }
      .nat-leaf { animation: none !important; opacity: 0.85; transform: none; }
    }
  </style>
  <!-- Single clean hero photo (no overlaid header bug) -->
  <div class="relative max-w-content mx-auto px-5 md:px-10 pt-10 md:pt-16 pb-16 md:pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-end">

      <div class="lg:col-span-7">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-5" style="color: #B5613F;">
          Cabinet de naturopathie · La Réunion · depuis {info.annee}
        </p>
        <h1 class="font-cormorant leading-[0.98]" style="color: #2E3826; font-size: clamp(46px, 8vw, 110px);">
          Comprendre,<br/>accompagner,<br/><em class="italic" style="color: #4F5D43;">ralentir.</em>
        </h1>
        <p class="mt-8 font-manrope text-[15px] md:text-[16px] leading-relaxed max-w-xl" style="color: rgba(46,56,38,0.78);">
          {data.promesse}
        </p>

        <div class="mt-9 flex flex-col sm:flex-row gap-3">
          <a href="#rendez-vous" class="inline-flex items-center justify-center h-12 px-7 font-manrope font-medium text-[13px] tracking-wider transition-colors" style="background-color: #2E3826; color: #F1ECE0;">
            Réserver un premier RDV
          </a>
          <a href="#methode" class="inline-flex items-center justify-center h-12 px-7 font-manrope font-medium text-[13px] tracking-wider border transition-colors" style="border-color: #2E3826; color: #2E3826;">
            La méthode →
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 relative">
        <div class="aspect-[4/5] overflow-hidden">
          <img src={info.photoHero} alt={info.photoHeroAlt} loading="eager" fetchpriority="high" class="w-full h-full object-cover" />
        </div>
        <!-- Signature naturopathe : tige qui pousse au scroll -->
        <svg id="nat-plant-signature" class="nat-plant absolute -left-10 md:-left-14 -bottom-6 h-[110%] w-24 md:w-32 pointer-events-none" viewBox="0 0 120 600" fill="none" aria-hidden="true">
          <g class="nat-stem-sway">
          <path class="nat-stem" d="M60 600 C 40 480, 80 380, 55 280 S 30 140, 60 20"
            stroke="#4F5D43" stroke-width="2" stroke-linecap="round" />
          <g class="nat-leaves" stroke="#4F5D43" stroke-width="1.6" fill="#7C8C6A">
            <ellipse class="nat-leaf" style="--i:0" cx="40" cy="500" rx="18" ry="7" transform="rotate(-25 40 500)" />
            <ellipse class="nat-leaf" style="--i:1" cx="80" cy="430" rx="20" ry="8" transform="rotate(20 80 430)" />
            <ellipse class="nat-leaf" style="--i:2" cx="35" cy="350" rx="22" ry="9" transform="rotate(-30 35 350)" />
            <ellipse class="nat-leaf" style="--i:3" cx="75" cy="260" rx="18" ry="7" transform="rotate(25 75 260)" />
            <ellipse class="nat-leaf" style="--i:4" cx="42" cy="170" rx="16" ry="6" transform="rotate(-20 42 170)" />
            <ellipse class="nat-leaf" style="--i:5" cx="72" cy="90" rx="14" ry="6" transform="rotate(18 72 90)" />
          </g>
          </g>
        </svg>
        <script>
          (() => {
            const el = document.getElementById('nat-plant-signature');
            if (!el) return;
            const io = new IntersectionObserver((entries) => {
              entries.forEach((e) => {
                if (e.isIntersecting) { el.classList.add('is-in'); io.disconnect(); }
              });
            }, { threshold: 0.25 });
            io.observe(el);
          })();
        </script>
      </div>
    </div>

    <!-- Botanical scroll cue -->
    <div class="mt-16 flex items-center gap-4">
      <span class="block w-12 h-px" style="background-color: #4F5D43;"></span>
      <p class="font-cormorant italic text-lg" style="color: #4F5D43;">— En complément du suivi médical, jamais en remplacement.</p>
    </div>
  </div>
</section>
