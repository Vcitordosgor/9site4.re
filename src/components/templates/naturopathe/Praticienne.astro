---
import data from '../../../data/templates/source.json';
const info = data.info;
---

<section id="praticienne" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">

      <div class="md:col-span-5">
        <div class="aspect-[3/4] overflow-hidden">
          <img src="/images/naturopathe/extra-5.webp" alt={`${info.fondatrice}, naturopathe`} loading="lazy" class="w-full h-full object-cover" />
        </div>
      </div>

      <div class="md:col-span-7">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #B5613F;">— Praticienne —</p>
        <h2 class="font-cormorant leading-[1.04]" style="color: #2E3826; font-size: clamp(34px, 5vw, 58px);">
          {info.fondatrice}
        </h2>
        <p class="mt-2 font-cormorant italic text-xl" style="color: #4F5D43;">Naturopathe certifiée · {info.annee}</p>

        <p class="mt-7 font-manrope text-[15px] leading-relaxed" style="color: rgba(46,56,38,0.78);">
          Praticienne en naturopathie depuis {info.annee}, je reçois en cabinet sur rendez-vous. Ma formation est solide, ma posture est claire : je travaille en complément de votre médecin, je ne diagnostique pas, je ne contredis pas. Je propose des ajustements lents, à partir de votre quotidien.
        </p>

        <div class="mt-8 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {data.formations.map((f) => (
            <div class="p-4 border-l-2" style="background-color: #F1ECE0; border-color: #B5613F;">
              <p class="font-manrope text-[11px] uppercase tracking-[0.22em]" style="color: #4F5D43;">{f.annee}</p>
              <p class="font-cormorant text-lg mt-1" style="color: #2E3826;">{f.intitule}</p>
              <p class="font-manrope text-[12px] mt-1" style="color: rgba(46,56,38,0.65);">{f.ecole}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
