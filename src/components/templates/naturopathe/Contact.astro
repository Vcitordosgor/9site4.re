---
import data from '../../../data/templates/source.json';
const info = data.info;
---

<section id="contact" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10 text-center">
    <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-5" style="color: #B5613F;">— Contact —</p>
    <h2 class="font-cormorant leading-[1.02]" style="color: #2E3826; font-size: clamp(34px, 6vw, 78px);">
      « {info.tagline} »
    </h2>

    <div class="mt-12 inline-grid grid-cols-1 sm:grid-cols-3 gap-px text-left" style="background-color: rgba(46,56,38,0.12);">
      <a href={`tel:${info.telephoneHref}`} class="p-8 transition-colors" style="background-color: #F1ECE0;">
        <p class="font-manrope text-[10.5px] uppercase tracking-[0.22em] mb-2" style="color: #B5613F;">Téléphone</p>
        <p class="font-cormorant text-2xl" style="color: #2E3826;">{info.telephone}</p>
      </a>
      <a href={`mailto:${info.email}`} class="p-8 transition-colors" style="background-color: #F1ECE0;">
        <p class="font-manrope text-[10.5px] uppercase tracking-[0.22em] mb-2" style="color: #B5613F;">Email</p>
        <p class="font-cormorant text-2xl break-all" style="color: #2E3826;">{info.email}</p>
      </a>
      <div class="p-8" style="background-color: #F1ECE0;">
        <p class="font-manrope text-[10.5px] uppercase tracking-[0.22em] mb-2" style="color: #B5613F;">Ouverture</p>
        <p class="font-cormorant text-xl leading-snug" style="color: #2E3826;">{info.ouvertureHebdo}</p>
      </div>
    </div>
  </div>
</section>
