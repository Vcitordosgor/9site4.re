---
import data from '../../../data/templates/source.json';

const icons: Record<string, string> = {
  battery: 'M7 8h10v8H7zM17 11h2v2h-2z',
  moon: 'M21 12.8A9 9 0 1111.2 3 7 7 0 0021 12.8z',
  leaf: 'M17 8C8 10 5.9 16.17 3.82 21.34l1.89.66.95-2.3c.48.17.98.3 1.34.3C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z',
  wave: 'M3 12c1.5-3 4-3 5.5 0s4 3 5.5 0 4-3 5.5 0M3 18c1.5-3 4-3 5.5 0s4 3 5.5 0 4-3 5.5 0M3 6c1.5-3 4-3 5.5 0s4 3 5.5 0 4-3 5.5 0',
};
---

<section id="approche" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #5D7C68;">— Pour qui —</p>
      <h2 class="font-lora text-4xl md:text-5xl leading-tight" style="color: #1F2926;">
        Quatre motifs
        <em class="italic" style="color: #5D7C68;">qui reviennent souvent.</em>
      </h2>
      <p class="mt-5 font-manrope text-[15px] leading-relaxed" style="color: rgb(31 41 38 / 0.72);">
        On ne traite pas la maladie. On regarde ce qui fatigue, ce qui pèse, ce qui peut s'alléger.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
      {data.publics.map((p) => (
        <article class="group p-7 md:p-9 rounded-2xl border-2 transition-all hover:shadow-lg" style="background-color: #E4F0EE; border-color: #E4F0EE;" onmouseover="this.style.borderColor='#5D7C68';" onmouseout="this.style.borderColor='#E4F0EE';">
          <div class="flex items-start gap-5">
            <div class="shrink-0 w-14 h-14 rounded-full flex items-center justify-center" style="background-color: #FFFFFF;">
              <svg viewBox="0 0 24 24" class="w-7 h-7" style="color: #5D7C68;" aria-hidden="true" stroke="currentColor" fill={p.icon === 'leaf' || p.icon === 'moon' ? 'currentColor' : 'none'} stroke-width="1.5">
                <path d={icons[p.icon]} stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>
            <div class="flex-1">
              <h3 class="font-lora text-2xl md:text-3xl leading-tight" style="color: #1F2926;">
                {p.nom}
              </h3>
              <p class="mt-1 font-lora italic text-base md:text-lg" style="color: #5D7C68;">
                {p.tagline}
              </p>
            </div>
          </div>

          <p class="mt-5 font-manrope text-[14px] leading-relaxed" style="color: rgb(31 41 38 / 0.78);">
            {p.description}
          </p>
        </article>
      ))}
    </div>

    <!-- Motifs concrets : pastilles cliquables (anchors vers tarifs/contact) -->
    <div class="mt-14 md:mt-16">
      <p class="text-center font-manrope text-[11px] uppercase tracking-[0.32em] mb-6" style="color: #5D7C68;">
        Motifs fréquents au cabinet
      </p>
      <ul class="flex flex-wrap justify-center gap-2.5 md:gap-3 max-w-3xl mx-auto">
        {[
          { label: 'Sommeil & nuits hachées', href: '#tarifs' },
          { label: 'Digestion & inconforts', href: '#tarifs' },
          { label: 'Stress & charge mentale', href: '#tarifs' },
          { label: 'Immunité & saisons', href: '#tarifs' },
          { label: 'Fatigue chronique', href: '#tarifs' },
          { label: 'Périménopause', href: '#tarifs' },
          { label: 'Hygiène de vie globale', href: '#tarifs' },
          { label: 'Cycle féminin', href: '#tarifs' },
        ].map((m) => (
          <li>
            <a
              href={m.href}
              class="inline-flex items-center px-4 py-2 rounded-full text-[13px] font-manrope font-medium transition-colors"
              style="background-color: #FFFFFF; color: #1F2926; border: 1px solid rgb(93 124 104 / 0.25);"
              onmouseover="this.style.backgroundColor='#5D7C68'; this.style.color='#FFFFFF';"
              onmouseout="this.style.backgroundColor='#FFFFFF'; this.style.color='#1F2926';"
            >
              {m.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <!-- Note bas : ce que ce n'est pas -->
    <div class="mt-14 md:mt-16 max-w-2xl mx-auto px-6 py-5 rounded-xl border-l-4" style="background-color: rgb(228 240 238 / 0.5); border-color: #D3C29C;">
      <p class="font-manrope text-[13px] leading-relaxed" style="color: rgb(31 41 38 / 0.78);">
        <strong style="color: #1F2926;">Important.</strong> La naturopathie ne remplace pas un suivi médical
        et ne pose aucun diagnostic. Si vous présentez des symptômes inquiétants, consultez votre médecin traitant en priorité.
      </p>
    </div>
  </div>
</section>
