---
const piliers = [
  { titre: 'Alimentation', texte: "Ce qu'on mange agit sur l'énergie, l'humeur, le sommeil et la digestion. On regarde le réel d'abord, on idéalise après." },
  { titre: 'Sommeil', texte: "Premier pilier de la récupération. Avant tout complément, on observe la qualité, l'heure du coucher, l'environnement." },
  { titre: 'Mouvement', texte: "Marcher tous les jours vaut mieux que courir une fois par semaine. La régularité plutôt que l'intensité." },
  { titre: 'Mental', texte: "Le stress de fond pèse sur la digestion, le sommeil, l'immunité. Outils respiratoires, rituels, mises au calme." },
];
---

<section id="philosophie" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 mb-14">
      <div class="lg:col-span-5">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #B5613F;">— Philosophie —</p>
        <h2 class="font-cormorant leading-[1.02]" style="color: #2E3826; font-size: clamp(34px, 5vw, 58px);">
          Quatre piliers, <em class="italic">une seule logique.</em>
        </h2>
      </div>
      <div class="lg:col-span-7 lg:pt-4">
        <p class="font-manrope text-[15.5px] leading-relaxed" style="color: rgba(46,56,38,0.78);">
          La naturopathie n'a rien d'ésotérique. C'est une lecture lente du quotidien — alimentation, sommeil, mouvement, mental — pour identifier ce qui pèse, ce qui aide, ce qui peut bouger. On part toujours du concret. On ne change qu'une chose à la fois.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {piliers.map((p, i) => (
        <article class="relative p-7 md:p-8 overflow-hidden" style="background-color: #F1ECE0;">
          <p class="font-cormorant italic text-5xl absolute top-4 right-5 pointer-events-none select-none" style="color: rgba(79,93,67,0.18); z-index:0;">{String(i+1).padStart(2,'0')}</p>
          <h3 class="relative font-cormorant text-2xl mb-3 pr-12" style="color: #2E3826; z-index:1;">{p.titre}</h3>
          <p class="relative font-manrope text-[14px] leading-relaxed" style="color: rgba(46,56,38,0.78); z-index:1;">{p.texte}</p>
        </article>
      ))}
    </div>
  </div>
</section>
