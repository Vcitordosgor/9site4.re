---
import data from '../../../data/templates/source.json';
---

<section id="cabinet" class="py-20 md:py-28" style="background-color: #E4F0EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="text-center max-w-2xl mx-auto mb-14 md:mb-20">
      <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #5D7C68;">— Le cabinet —</p>
      <h2 class="font-lora text-4xl md:text-5xl leading-tight" style="color: #1F2926;">
        Une pièce
        <em class="italic" style="color: #5D7C68;">qui descend la tension.</em>
      </h2>
      <p class="mt-5 font-manrope text-[15px] leading-relaxed" style="color: rgb(31 41 38 / 0.72);">
        Bois clair, lin, plantes. Pas d'écran, pas de musique d'ascenseur, pas d'éclairage clinique.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {data.cabinet.map((c, i) => (
        <article class="group">
          <div class="relative aspect-[4/5] overflow-hidden rounded-2xl">
            <img
              src={c.photo}
              alt={c.titre}
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              loading="lazy"
              decoding="async"
            />
            <!-- Index -->
            <div class="absolute top-4 left-4 w-9 h-9 rounded-full flex items-center justify-center" style="background-color: rgb(228 240 238 / 0.95);">
              <span class="font-lora italic text-base" style="color: #1F2926;">0{i + 1}</span>
            </div>
          </div>
          <div class="mt-5">
            <h3 class="font-lora text-xl md:text-2xl leading-tight" style="color: #1F2926;">
              {c.titre}
            </h3>
            <p class="mt-2 font-manrope text-[14px] leading-relaxed" style="color: rgb(31 41 38 / 0.78);">
              {c.texte}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
