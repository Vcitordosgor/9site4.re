---
import data from '../../../data/templates/source.json';
---

<footer style="background-color: #E4F0EE; color: #1F2926;">
  <div class="max-w-content mx-auto px-6 md:px-10 py-14 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 mb-12">

      <div class="md:col-span-5">
        <div class="flex items-center gap-3">
          <svg viewBox="0 0 32 32" class="w-9 h-9" style="color: #5D7C68;" aria-hidden="true">
            <path d="M16 4 C 10 12, 6 16, 6 22 C 6 27 10 30 16 30 C 22 30 26 27 26 22 C 26 16 22 12 16 4 Z" fill="currentColor"/>
          </svg>
          <div class="leading-tight">
            <p class="font-lora italic text-2xl">Source</p>
            <p class="font-manrope text-[10px] uppercase tracking-[0.25em] mt-0.5" style="color: #5D7C68;">naturopathie</p>
          </div>
        </div>
        <p class="mt-5 font-manrope text-[14px] leading-relaxed max-w-sm" style="color: rgb(31 41 38 / 0.78);">
          {data.info.tagline} — Cabinet de naturopathie à La Réunion depuis {data.info.annee}.
        </p>
      </div>

      <div class="md:col-span-3">
        <p class="font-manrope text-[10px] uppercase tracking-[0.25em] mb-3" style="color: #5D7C68;">Cabinet</p>
        <ul class="space-y-2 font-manrope text-[13.5px]">
          <li><a href="#approche" class="transition-colors hover:underline">Pour qui</a></li>
          <li><a href="#methode" class="transition-colors hover:underline">Méthode</a></li>
          <li><a href="#formations" class="transition-colors hover:underline">Parcours</a></li>
          <li><a href="#cabinet" class="transition-colors hover:underline">Le cabinet</a></li>
          <li><a href="#tarifs" class="transition-colors hover:underline">Tarifs</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <p class="font-manrope text-[10px] uppercase tracking-[0.25em] mb-3" style="color: #5D7C68;">Contact</p>
        <ul class="space-y-2 font-manrope text-[13.5px]">
          <li>{data.info.adresseLigne1}</li>
          <li>{data.info.adresseLigne2}</li>
          <li><a href={`tel:${data.info.telephoneHref}`} class="hover:underline">{data.info.telephone}</a></li>
          <li><a href={`mailto:${data.info.email}`} class="hover:underline">{data.info.email}</a></li>
          <li style="color: rgb(31 41 38 / 0.6);">Instagram {data.info.instagram}</li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t flex flex-col md:flex-row items-start md:items-center justify-between gap-3 font-manrope text-[11px]" style="border-color: rgb(93 124 104 / 0.25); color: rgb(31 41 38 / 0.55);">
      <p>© {data.info.annee}–2026 {data.info.nom} · SIRET …{data.info.siret.slice(-5)} · Naturopathie n'est pas une profession médicale</p>
      <p class="font-lora italic text-base" style="color: #5D7C68;">— Comprendre, accompagner, ralentir.</p>
    </div>
  </div>
</footer>
