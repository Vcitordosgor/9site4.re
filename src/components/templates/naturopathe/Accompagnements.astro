---
import data from '../../../data/templates/source.json';
const photos = ['/images/naturopathe/extra-1.webp', '/images/naturopathe/extra-2.webp', '/images/naturopathe/extra-3.webp', '/images/naturopathe/extra-4.webp'];
---

<section id="accompagnements" class="py-20 md:py-28" style="background-color: #F1ECE0;">
  <div class="max-w-content mx-auto px-5 md:px-10">

    <div class="max-w-3xl mb-14">
      <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #B5613F;">— Accompagnements —</p>
      <h2 class="font-cormorant leading-[1.02]" style="color: #2E3826; font-size: clamp(34px, 5vw, 58px);">
        Quatre motifs <em class="italic">qui reviennent.</em>
      </h2>
    </div>

    <div class="space-y-px" style="background-color: rgba(79,93,67,0.18);">
      {data.publics.map((p, i) => (
        <article class="grid grid-cols-1 md:grid-cols-12 gap-0 md:gap-10 items-center p-6 md:p-10" style="background-color: #FFFFFF;">
          <div class="md:col-span-2 flex md:block items-baseline gap-4 mb-4 md:mb-0">
            <span class="font-cormorant italic text-5xl md:text-6xl leading-none" style="color: #B5613F;">0{i+1}</span>
          </div>
          <div class="md:col-span-7">
            <p class="font-cormorant italic text-lg" style="color: #4F5D43;">{p.tagline}</p>
            <h3 class="font-cormorant text-3xl md:text-4xl mt-1 mb-3" style="color: #2E3826;">{p.nom}</h3>
            <p class="font-manrope text-[14.5px] leading-relaxed max-w-2xl" style="color: rgba(46,56,38,0.78);">{p.description}</p>
          </div>
          <div class="md:col-span-3 mt-5 md:mt-0">
            <div class="aspect-[4/3] md:aspect-square overflow-hidden">
              <img src={photos[i % photos.length]} alt={p.nom} loading="lazy" class="w-full h-full object-cover" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
