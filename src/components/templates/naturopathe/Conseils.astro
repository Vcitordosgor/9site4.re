---
import data from '../../../data/templates/source.json';
---

<section id="conseils" class="py-20 md:py-28" style="background-color: #E4F0EE;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 items-end mb-12 md:mb-16">
      <div class="md:col-span-7">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #5D7C68;">— Conseils & lectures —</p>
        <h2 class="font-lora text-4xl md:text-5xl leading-tight" style="color: #1F2926;">
          Trois textes courts
          <em class="italic" style="color: #5D7C68;">à lire en 5 minutes.</em>
        </h2>
      </div>
      <div class="md:col-span-5">
        <p class="font-manrope text-[14px] leading-relaxed" style="color: rgb(31 41 38 / 0.78);">
          Pas de promesse miracle, pas de top 10. Des observations issues des consultations,
          des outils qu'on peut tester sans risque.
        </p>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {data.conseils.map((c) => (
        <article class="group p-7 md:p-9 rounded-2xl transition-all hover:-translate-y-1" style="background-color: #FFFFFF;">
          <p class="font-manrope text-[10.5px] uppercase tracking-[0.25em]" style="color: #5D7C68;">
            ✦ {c.categorie}
          </p>
          <h3 class="mt-4 font-lora text-xl md:text-2xl leading-snug" style="color: #1F2926;">
            {c.titre}
          </h3>
          <p class="mt-4 font-manrope text-[14px] leading-relaxed" style="color: rgb(31 41 38 / 0.75);">
            {c.extrait}
          </p>
          <p class="mt-6 inline-flex items-center gap-2 font-manrope text-[12px] font-semibold tracking-wide uppercase" style="color: #5D7C68;">
            Lire l'article
            <svg viewBox="0 0 24 24" class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M5 12h14M13 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
