---
import data from '../../../data/templates/source.json';
---

<section id="formations" class="py-20 md:py-28" style="background-color: #FFFFFF;">
  <div class="max-w-content mx-auto px-6 md:px-10">

    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16">

      <!-- Bloc gauche présentation -->
      <div class="md:col-span-5">
        <p class="font-manrope text-[11px] uppercase tracking-[0.35em] mb-4" style="color: #5D7C68;">— Parcours —</p>
        <h2 class="font-lora text-4xl md:text-5xl leading-tight" style="color: #1F2926;">
          Formée,
          <em class="italic block" style="color: #5D7C68;">jamais figée.</em>
        </h2>
        <p class="mt-6 font-manrope text-[15px] leading-relaxed" style="color: rgb(31 41 38 / 0.78);">
          Quatre formations complètes depuis 2018, deux à trois jours de formation continue par an
          pour rester à jour des publications scientifiques en micronutrition,
          sommeil et gestion du stress.
        </p>

        <div class="mt-8 inline-flex items-center gap-3 px-5 py-3 rounded-full" style="background-color: #E4F0EE;">
          <svg viewBox="0 0 24 24" class="w-5 h-5" style="color: #5D7C68;" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M9 12l2 2 4-4M12 22a10 10 0 100-20 10 10 0 000 20z" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <p class="font-manrope text-[13px] font-medium" style="color: #1F2926;">
            Membre FENA · n° NPS-12047
          </p>
        </div>
      </div>

      <!-- Liste formations -->
      <div class="md:col-span-7">
        <ul class="space-y-px" style="background-color: rgb(93 124 104 / 0.18);">
          {data.formations.map((f) => (
            <li class="grid grid-cols-12 gap-4 items-baseline p-5 md:p-7" style="background-color: #FFFFFF;">
              <div class="col-span-3 md:col-span-2">
                <p class="font-lora italic text-2xl md:text-3xl leading-none" style="color: #5D7C68;">
                  {f.annee}
                </p>
              </div>
              <div class="col-span-9 md:col-span-10">
                <p class="font-lora text-lg md:text-xl leading-tight" style="color: #1F2926;">
                  {f.intitule}
                </p>
                <p class="mt-1 font-manrope text-[12.5px]" style="color: rgb(31 41 38 / 0.65);">
                  {f.ecole}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
