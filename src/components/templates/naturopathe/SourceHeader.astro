---
import data from '../../../data/templates/source.json';

const navLinks = [
  { href: '#approche', label: 'Pour qui' },
  { href: '#methode', label: 'Méthode' },
  { href: '#formations', label: 'Parcours' },
  { href: '#cabinet', label: 'Cabinet' },
  { href: '#tarifs', label: 'Tarifs' },
];
---

<header
  id="source-header"
  data-scrolled="false"
  class="sticky top-0 z-50 transition-[background-color,backdrop-filter,box-shadow] duration-500 border-b"
  style="background-color: rgb(228 240 238 / 0.95); border-color: rgb(93 124 104 / 0.18);"
>
  <div class="max-w-content mx-auto px-6 md:px-10 h-16 md:h-20 flex items-center justify-between gap-6">

    <a href="#top" class="flex items-center gap-3 group" aria-label="Source — accueil">
      <!-- Picto goutte/feuille -->
      <svg viewBox="0 0 32 32" class="w-7 h-7" style="color: #5D7C68;" aria-hidden="true">
        <path d="M16 4 C 10 12, 6 16, 6 22 C 6 27 10 30 16 30 C 22 30 26 27 26 22 C 26 16 22 12 16 4 Z" fill="currentColor"/>
        <path d="M16 14 Q 13 18 14 24" stroke="#E4F0EE" stroke-width="1.5" fill="none"/>
      </svg>
      <div class="flex flex-col leading-tight">
        <span class="font-lora italic text-xl md:text-2xl" style="color: #1F2926;">Source</span>
        <span class="font-manrope text-[10px] uppercase tracking-[0.25em] -mt-0.5" style="color: #5D7C68;">naturopathie</span>
      </div>
    </a>

    <nav class="hidden md:flex items-center gap-7 lg:gap-9 font-manrope text-[12px] uppercase tracking-[0.18em] font-medium" aria-label="Navigation">
      {navLinks.map((link) => (
        <a href={link.href} class="transition-colors duration-300" style="color: #1F2926;" onmouseover="this.style.color='#5D7C68';" onmouseout="this.style.color='#1F2926';">
          {link.label}
        </a>
      ))}
    </nav>

    <a
      href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent('Bonjour Camille, je souhaite prendre rendez-vous.')}`}
      target="_blank"
      rel="noopener"
      class="hidden md:inline-flex items-center justify-center h-10 px-5 font-manrope font-semibold text-[12px] tracking-wide rounded-full transition-colors duration-300"
      style="background-color: #5D7C68; color: #FFFFFF;"
      onmouseover="this.style.backgroundColor='#1F2926';"
      onmouseout="this.style.backgroundColor='#5D7C68';"
    >
      Prendre RDV
    </a>

    <a
      href={`tel:${data.info.telephoneHref}`}
      class="md:hidden inline-flex items-center justify-center h-11 px-4 font-manrope font-semibold text-[12px] rounded-full"
      style="background-color: #5D7C68; color: #FFFFFF;"
      aria-label="Appeler"
    >
      Appeler
    </a>
  </div>
</header>

<style>
  #source-header[data-scrolled='true'] {
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    backdrop-filter: saturate(180%) blur(12px);
    box-shadow: 0 1px 3px rgb(93 124 104 / 0.1);
  }
</style>

<script>
  const header = document.getElementById('source-header');
  if (header) {
    const update = () => { header.dataset.scrolled = String(window.scrollY > 8); };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>
