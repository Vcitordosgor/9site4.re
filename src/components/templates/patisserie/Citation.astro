---
import data from '../../../data/templates/vanille.json';
---

<section class="bg-vanille-grain text-vanille-creme py-24 md:py-36 relative overflow-hidden">
  <svg class="absolute inset-0 w-full h-full opacity-[0.06] pointer-events-none" aria-hidden="true">
    <filter id="vanille-grain-quote"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#vanille-grain-quote)" fill="#FBF3E2"/>
  </svg>

  <div class="max-w-4xl mx-auto px-6 md:px-10 relative text-center">
    <span class="block font-yeseva text-vanille-caramel text-7xl md:text-9xl leading-none mb-4" aria-hidden="true">&ldquo;</span>
    <blockquote class="font-yeseva italic text-vanille-creme leading-[1.15]" style="font-size:clamp(28px,5vw,56px);">
      Du beurre, du temps, et personne qui te bouscule à 5h du matin.
    </blockquote>
    <div class="mt-10 flex items-center justify-center gap-4" aria-hidden="true">
      <span class="block w-12 h-px bg-vanille-caramel/60"></span>
      <span class="text-vanille-caramel">❦</span>
      <span class="block w-12 h-px bg-vanille-caramel/60"></span>
    </div>
    <p class="mt-6 font-karla text-[11px] uppercase tracking-[0.4em] text-vanille-caramel">
      {data.patissiere.nom} · pâtissière depuis {data.info.annee}
    </p>
  </div>
</section>
