---
/**
 * "Spécialités péi" — 4 cards avec SVG abstraits.
 * Gâteau patate · bonbon piment sucré · tarte coco · mille-feuille vanille.
 */
const speps = [
  {
    nom: 'Gâteau patate',
    sous: 'Patate douce · coco · vanille',
    texte: "Le gâteau de l'enfance créole, dense et moelleux. Patate douce blanche râpée à la main, lait de coco frais, gousse de vanille fendue.",
    accent: '#7AA05B',
    svg: 'patate',
  },
  {
    nom: 'Bonbon piment sucré',
    sous: 'Le pari de Stéphanie',
    texte: "Petit beignet créole revisité version dessert. Pois du Cap, piment doux, glaçage caramel-gingembre. Réservé aux palais curieux.",
    accent: '#D14B3C',
    svg: 'piment',
  },
  {
    nom: 'Tarte coco',
    sous: 'Pâte sablée · noix fraîche · rhum',
    texte: "Pâte sablée pur beurre, crème pâtissière infusée, lamelles de coco fraîche râpées et caramélisées, voile de rhum arrangé maison.",
    accent: '#C68642',
    svg: 'coco',
  },
  {
    nom: 'Mille-feuille vanille bourbon',
    sous: 'Trois gousses dans la crème',
    texte: "Pâte feuilletée pur beurre tournée 6 fois, crème pâtissière infusée 24 h avec trois gousses bourbon, sucre glace tamisé minute.",
    accent: '#5C3A1E',
    svg: 'gousse',
  },
];
---
<section id="saisons" class="bg-vanille-papier py-24 md:py-36 relative overflow-hidden">
  <svg class="absolute inset-0 w-full h-full opacity-[0.04] pointer-events-none" aria-hidden="true">
    <filter id="grain-pei"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#grain-pei)"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-12 relative">
    <div class="max-w-3xl mb-14 md:mb-20">
      <p class="font-karla text-[11px] uppercase tracking-[0.4em] text-vanille-caramel mb-4 flex items-center gap-3">
        <span class="block w-8 h-px bg-vanille-caramel"></span>
        Spécialités péi
      </p>
      <h2 class="font-yeseva text-vanille-gousse leading-[0.95]" style="font-size:clamp(40px,6vw,84px);">
        Quatre douceurs
        <span class="block italic font-italianno text-vanille-caramel" style="font-size:clamp(54px,8vw,108px);">qui sentent l'île.</span>
      </h2>
      <p class="mt-6 font-karla text-[15px] md:text-base text-vanille-gousse/80 leading-relaxed max-w-xl">
        Recettes héritées des grands-mères, retravaillées avec les techniques classiques. La pâte feuilletée pur beurre rencontre la patate douce, le piment doux, le rhum arrangé.
      </p>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-5 md:gap-7">
      {speps.map((p) => (
        <li class="group relative bg-vanille-blanc border border-vanille-gousse/15 p-7 md:p-9 transition-all duration-500 hover:-translate-y-1 hover:border-vanille-caramel/50 hover:shadow-[0_22px_44px_-22px_rgba(76,38,18,0.25)]">
          <!-- SVG abstrait -->
          <div class="w-20 h-20 mb-7 rounded-full flex items-center justify-center" style={`background:${p.accent}1A;`}>
            <svg viewBox="0 0 64 64" class="w-12 h-12" style={`color:${p.accent};`} aria-hidden="true">
              {p.svg === 'gousse' && <path d="M6 44 Q18 22 38 14 Q52 10 58 16 Q52 22 38 26 Q22 32 6 44 Z" fill="currentColor" opacity="0.9"/>}
              {p.svg === 'piment' && <path d="M14 14 Q26 12 32 18 Q40 28 38 42 Q34 52 24 50 Q14 46 14 32 Q14 22 14 14 Z" fill="currentColor"/>}
              {p.svg === 'coco' && <g><circle cx="32" cy="34" r="20" fill="currentColor" opacity="0.85"/><path d="M14 24 Q24 12 32 12" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/><path d="M50 24 Q40 12 32 12" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round"/></g>}
              {p.svg === 'patate' && <path d="M10 36 Q12 18 28 14 Q46 12 54 26 Q58 42 44 50 Q26 56 14 48 Q6 42 10 36 Z" fill="currentColor"/>}
            </svg>
          </div>
          <h3 class="font-yeseva text-vanille-gousse text-2xl md:text-[28px] leading-tight">{p.nom}</h3>
          <p class="mt-1 font-italianno text-2xl md:text-3xl leading-none" style={`color:${p.accent};`}>{p.sous}</p>
          <p class="mt-4 font-karla text-[14.5px] text-vanille-gousse/85 leading-relaxed">{p.texte}</p>
          <span class="absolute top-7 right-7 font-yeseva text-vanille-gousse/10 text-6xl leading-none italic" aria-hidden="true">{['I','II','III','IV'][speps.indexOf(p)]}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
