---
/**
 * Hero éditorial gourmand cinématique : photo plein écran + overlay,
 * titre serif italique XXL gauche, 2 stickers manuscrits, 2 CTA.
 */
import data from '../../../data/templates/vanille.json';
---
<section id="top" class="relative w-full min-h-[100svh] overflow-hidden bg-vanille-grain text-vanille-creme">
  <picture class="absolute inset-0">
    <source srcset={`${data.info.photoHero.replace(/\.webp$/, '-640.webp')} 640w, ${data.info.photoHero.replace(/\.webp$/, '-1024.webp')} 1024w, ${data.info.photoHero} 1600w`} sizes="100vw" />
    <img src={data.info.photoHero} alt={data.info.photoHeroAlt}
         class="absolute inset-0 w-full h-full object-cover scale-105"
         fetchpriority="high" loading="eager" decoding="async" width="1600" height="1000" />
  </picture>
  <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-r from-vanille-grain/85 via-vanille-grain/45 to-transparent"></div>
  <div aria-hidden="true" class="absolute inset-x-0 bottom-0 h-44 bg-gradient-to-t from-vanille-grain/80 to-transparent"></div>

  <!-- Grain organique -->
  <svg class="absolute inset-0 w-full h-full opacity-[0.08] pointer-events-none mix-blend-overlay" aria-hidden="true">
    <filter id="hero-grain"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#hero-grain)"/>
  </svg>

  <div class="relative min-h-[100svh] flex flex-col">
    <div class="flex-1 flex items-center">
      <div class="max-w-content mx-auto w-full px-6 md:px-12 pt-28 md:pt-32 pb-20">
        <div class="max-w-3xl">
          <p class="font-karla text-[11px] md:text-[12px] uppercase tracking-[0.42em] text-vanille-caramel mb-7 md:mb-10 flex items-center gap-3">
            <span class="block w-10 h-px bg-vanille-caramel"></span>
            Pâtisserie créole · La Réunion · depuis {data.info.annee}
          </p>
          <h1 class="font-yeseva text-vanille-creme leading-[0.88] tracking-[-0.02em]" style="font-size:clamp(54px,9.6vw,142px);">
            <span class="block">Pâtisser,</span>
            <span class="block">c'est d'abord</span>
            <span class="block italic font-italianno text-vanille-caramel leading-[0.92]" style="font-size:clamp(72px,12vw,180px);">cuisiner.</span>
          </h1>
          <p class="mt-8 md:mt-12 max-w-xl font-karla text-base md:text-lg leading-relaxed text-vanille-creme/85">
            {data.promesse}
          </p>
          <div class="mt-10 md:mt-12 flex flex-wrap items-center gap-3 md:gap-4">
            <a href="#specialites"
               class="inline-flex items-center justify-center px-7 rounded-full bg-vanille-creme text-vanille-grain font-karla font-semibold text-[12px] uppercase tracking-[0.22em] hover:bg-vanille-caramel hover:text-vanille-creme transition-colors duration-300" style="height:54px;">
              Voir la vitrine du jour
            </a>
            <a href="#commandes"
               class="inline-flex items-center justify-center px-7 rounded-full border-2 border-vanille-creme/70 text-vanille-creme font-karla font-semibold text-[12px] uppercase tracking-[0.22em] hover:bg-vanille-creme hover:text-vanille-grain transition-colors duration-300" style="height:54px;">
              Commander sur mesure
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Sticker manuscrit unique (caramel) -->
    <div aria-hidden="true" class="hidden md:block absolute top-36 right-10 lg:right-24 -rotate-6 vanille-sticker">
      <div class="w-32 h-32 rounded-full border-2 border-vanille-caramel/80 flex items-center justify-center text-center backdrop-blur-sm" style="background:rgba(198,134,66,0.18);">
        <span class="font-italianno text-vanille-caramel text-2xl leading-tight">Fait main<br/>chaque matin</span>
      </div>
    </div>
    <style>
      .vanille-sticker { animation: vanille-sticker-bob 7s ease-in-out infinite; }
      @keyframes vanille-sticker-bob {
        0%, 100% { transform: translateY(0) rotate(-6deg); }
        50%      { transform: translateY(-10px) rotate(-3deg); }
      }
      @media (prefers-reduced-motion: reduce) { .vanille-sticker { animation: none; } }
    </style>

    <div class="relative pb-7 md:pb-10">
      <div class="max-w-content mx-auto px-6 md:px-12 flex items-end justify-between gap-6 text-vanille-creme/80 font-karla text-[11px] uppercase tracking-[0.32em]">
        <div class="flex items-center gap-3">
          <span class="block w-10 h-px bg-vanille-creme/50"></span>
          <span>Stéphanie · pâtissière à La Réunion</span>
        </div>
        <div class="hidden md:flex items-center gap-3">
          <span>Faire défiler</span>
          <svg viewBox="0 0 24 24" width="14" height="14" class="animate-bounce"><path d="M12 4v14m0 0l-5-5m5 5l5-5" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round"/></svg>
        </div>
      </div>
    </div>
  </div>
</section>
