---
/**
 * "Vitrine du jour" — grille 6 pâtisseries du jour avec photo + nom + prix
 * + tag + badge "Encore X parts". Rotation au hover. Signature WOAW.
 */
import data from '../../../data/templates/vanille.json';

const photos = [
  '/images/patisserie/extra-1.webp',
  '/images/patisserie/extra-2.webp',
  '/images/patisserie/extra-3.webp',
  '/images/patisserie/extra-4.webp',
  '/images/patisserie/extra-5.webp',
  '/images/patisserie/extra-6.webp',
];

const tagsParEpice: Record<string, { label: string; cls: string }> = {
  vanille: { label: 'Vanille bourbon', cls: 'bg-vanille-caramel/15 text-vanille-caramel border-vanille-caramel/40' },
  coco:    { label: 'Coco · rhum',     cls: 'bg-vanille-pandan/15 text-vanille-pandan border-vanille-pandan/40' },
  letchi:  { label: 'Saison · letchi', cls: 'bg-vanille-piment/15 text-vanille-piment border-vanille-piment/40' },
  piment:  { label: 'Audace · piment', cls: 'bg-vanille-piment/15 text-vanille-piment border-vanille-piment/40' },
};

// Stocks fictifs du jour — donne un rythme de "boutique vivante"
const stocks = [8, 4, 12, 3, 6];
const today = new Date().toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
---
<section id="vitrine" class="bg-vanille-creme py-24 md:py-36 relative">
  <svg class="absolute inset-0 w-full h-full pointer-events-none opacity-[0.05]" aria-hidden="true">
    <filter id="grain-vitrine"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#grain-vitrine)"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-12 relative">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-6 mb-12 md:mb-16">
      <div>
        <p class="font-karla text-[11px] uppercase tracking-[0.4em] text-vanille-caramel mb-4 flex items-center gap-3">
          <span class="block w-8 h-px bg-vanille-caramel"></span>
          Vitrine du jour
        </p>
        <h2 class="font-yeseva text-vanille-gousse leading-[0.95]" style="font-size:clamp(40px,6vw,84px);">
          Ce qui sort du four,
          <span class="block italic font-italianno text-vanille-caramel" style="font-size:clamp(54px,8vw,108px);">aujourd'hui.</span>
        </h2>
      </div>
      <div class="md:text-right max-w-xs">
        <p class="font-karla text-[11px] uppercase tracking-[0.3em] text-vanille-gousse/60 mb-1">Date</p>
        <p class="font-yeseva text-vanille-gousse text-lg capitalize">{today}</p>
        <p class="mt-2 font-karla text-[13px] text-vanille-gousse/70 leading-snug">
          Tout est cuit le matin même. Quand c'est épuisé, on s'arrête.
        </p>
      </div>
    </div>

    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {data.specialites.map((s, i) => {
        const tag = tagsParEpice[s.epice] ?? tagsParEpice.vanille;
        const reste = stocks[i] ?? 0;
        const epuise = reste === 0;
        return (
          <li class="group relative">
            <article class={`relative flex flex-col h-full bg-vanille-blanc border border-vanille-gousse/15 overflow-hidden transition-all duration-500 ease-out hover:-translate-y-1 hover:border-vanille-caramel/60 hover:shadow-[0_18px_44px_-18px_rgba(76,38,18,0.28)] ${epuise ? 'opacity-80' : ''}`}>
              <div class="relative overflow-hidden aspect-[4/5] bg-vanille-papier">
                <img src={photos[i] ?? photos[0]} alt={s.nom}
                     class="absolute inset-0 w-full h-full object-cover transition-transform duration-[1100ms] ease-out group-hover:scale-[1.06] group-hover:rotate-[0.6deg]"
                     loading="lazy" decoding="async" width="600" height="750" />
                <!-- Badge tag -->
                <span class={`absolute top-4 left-4 inline-flex items-center px-3 py-1 rounded-full text-[10px] font-karla uppercase tracking-[0.22em] border backdrop-blur-md ${tag.cls}`}>
                  {tag.label}
                </span>
                <!-- Badge stock -->
                {epuise ? (
                  <span class="absolute top-4 right-4 inline-flex items-center px-3 py-1 rounded-full text-[10px] font-karla uppercase tracking-[0.22em] bg-vanille-grain text-vanille-creme">
                    Épuisé · revient demain
                  </span>
                ) : (
                  <span class="absolute top-4 right-4 inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-karla uppercase tracking-[0.22em] bg-vanille-creme/95 text-vanille-gousse">
                    <span class="block w-1.5 h-1.5 rounded-full bg-vanille-pandan"></span>
                    Encore {reste} parts
                  </span>
                )}
                <!-- Numéro romain coin -->
                <span class="absolute bottom-3 right-4 font-yeseva text-vanille-creme/90 text-5xl leading-none italic mix-blend-overlay" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>

              <div class="p-6 md:p-7 flex-1 flex flex-col">
                <p class="font-karla text-[10px] uppercase tracking-[0.3em] text-vanille-caramel">{s.categorie}</p>
                <h3 class="mt-2 font-yeseva text-vanille-gousse text-[24px] md:text-[27px] leading-tight">{s.nom}</h3>
                <p class="mt-1 font-italianno text-vanille-caramel text-2xl leading-none">{s.tagline}</p>
                <p class="mt-4 font-karla text-[14px] text-vanille-gousse/85 leading-relaxed">{s.description}</p>
                <p class="mt-4 font-karla text-[11px] uppercase tracking-[0.2em] text-vanille-caramel/90">
                  ✦ {s.details}
                </p>

                <div class="mt-6 pt-5 border-t border-vanille-gousse/15 flex items-end justify-between gap-3">
                  <div>
                    <p class="font-karla text-[10px] uppercase tracking-[0.22em] text-vanille-caramel">Tarif</p>
                    <p class="font-yeseva text-vanille-gousse text-2xl leading-tight">{s.prix}</p>
                  </div>
                  <a
                    href={`https://wa.me/${data.info.whatsapp}?text=${encodeURIComponent(`Bonjour Stéphanie, je voudrais réserver : ${s.nom}.`)}`}
                    target="_blank" rel="noopener"
                    class="inline-flex items-center gap-1.5 h-10 px-4 rounded-full bg-vanille-gousse text-vanille-creme font-karla font-semibold text-[11px] uppercase tracking-[0.18em] hover:bg-vanille-caramel transition-colors whitespace-nowrap"
                  >
                    Réserver
                    <svg viewBox="0 0 24 24" width="12" height="12" aria-hidden="true"><path d="M5 12h14m0 0l-5-5m5 5l-5 5" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round"/></svg>
                  </a>
                </div>
              </div>
            </article>
          </li>
        );
      })}
      <!-- 6e carte : surprise du chef -->
      <li class="group relative">
        <article class="relative flex flex-col h-full bg-vanille-gousse text-vanille-creme overflow-hidden transition-all duration-500 hover:-translate-y-1">
          <div class="relative overflow-hidden aspect-[4/5]">
            <img src={photos[5]} alt="Surprise du jour" class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-700" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-b from-vanille-grain/30 to-vanille-grain/85"></div>
            <div class="absolute inset-0 flex flex-col items-center justify-center text-center p-6">
              <p class="font-karla text-[10px] uppercase tracking-[0.4em] text-vanille-caramel mb-4">Surprise du chef</p>
              <p class="font-italianno text-vanille-caramel text-5xl md:text-6xl leading-none">à découvrir</p>
              <p class="mt-4 font-karla text-[13px] text-vanille-creme/80 max-w-[14rem]">
                Une pièce dessinée à la dernière minute selon les fruits du marché. Toujours différente.
              </p>
            </div>
          </div>
          <div class="p-6 md:p-7 border-t border-vanille-creme/20">
            <p class="font-yeseva text-vanille-creme text-xl leading-tight">Demandez-la en boutique</p>
            <p class="mt-1 font-karla text-[12px] text-vanille-creme/75">Selon arrivage · 1 pièce/jour</p>
          </div>
        </article>
      </li>
    </ul>
  </div>
</section>
