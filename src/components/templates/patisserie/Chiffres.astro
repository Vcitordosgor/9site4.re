---
import data from '../../../data/templates/vanille.json';

const ans = new Date().getFullYear() - parseInt(data.info.annee);
const chiffres = [
  { gros: ans + ' ans', petit: 'à pétrir chaque matin à 4h30' },
  { gros: '42', petit: 'mille-feuilles au four ce matin' },
  { gros: '6h30', petit: 'ouverture boutique, du mardi au dimanche' },
  { gros: '3 gousses', petit: 'de vanille bourbon par mille-feuille' },
];
---

<section class="bg-vanille-papier py-20 md:py-32 relative overflow-hidden">
  <svg class="absolute inset-0 w-full h-full opacity-[0.05] pointer-events-none" aria-hidden="true">
    <filter id="vanille-grain-num"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2"/></filter>
    <rect width="100%" height="100%" filter="url(#vanille-grain-num)"/>
  </svg>

  <div class="max-w-content mx-auto px-6 md:px-10 relative">
    <div class="text-center mb-14 md:mb-20">
      <p class="font-karla text-[11px] uppercase tracking-[0.4em] text-vanille-caramel mb-4">— Maison La Vanille en chiffres —</p>
      <h2 class="font-yeseva text-vanille-gousse text-3xl md:text-5xl leading-tight">
        Une boutique, <em class="font-italianno text-vanille-caramel text-5xl md:text-6xl not-italic">quatre repères</em>.
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-y-12 md:gap-y-20 md:gap-x-8">
      {chiffres.map((c, i) => (
        <div class={`md:col-span-6 ${i === 1 ? 'md:translate-y-10' : ''} ${i === 2 ? 'md:-translate-y-6' : ''} ${i === 3 ? 'md:translate-y-4' : ''} text-center md:text-left`}>
          <p class="font-yeseva text-vanille-gousse leading-[0.85] tracking-tight" style="font-size:clamp(60px,12vw,140px);">
            {c.gros}
          </p>
          <p class="mt-3 md:mt-5 font-italianno text-vanille-caramel text-3xl md:text-4xl leading-tight max-w-md mx-auto md:mx-0">
            {c.petit}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
