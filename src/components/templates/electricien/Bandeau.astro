---
/**
 * Bandeau — bandeau pleine largeur fond cyan, 3 garanties courtes.
 */
---

<section class="relative bg-volta-cyan text-volta-noir py-12 md:py-16 px-6 md:px-10 overflow-hidden">
  <div class="relative max-w-content mx-auto">
    <ul class="grid sm:grid-cols-3 gap-0 divide-y sm:divide-y-0 sm:divide-x divide-volta-noir/15">
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2">
        <span class="font-syne font-extrabold text-volta-noir leading-none" style="font-size: clamp(36px, 4.5vw, 52px);">NF C 15-100</span>
        <p class="mt-2 font-space-grotesk font-medium uppercase tracking-[0.22em] text-volta-noir/75 text-xs">
          Norme garantie sur chaque chantier
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 80ms">
        <span class="font-syne font-extrabold text-volta-noir leading-none" style="font-size: clamp(36px, 4.5vw, 52px);">CONSUEL</span>
        <p class="mt-2 font-space-grotesk font-medium uppercase tracking-[0.22em] text-volta-noir/75 text-xs">
          Attestation remise apres livraison
        </p>
      </li>
      <li class="scroll-reveal flex flex-col items-start sm:items-center text-left sm:text-center px-4 py-5 sm:py-2" style="transition-delay: 160ms">
        <span class="font-syne font-extrabold text-volta-noir leading-none" style="font-size: clamp(36px, 4.5vw, 52px);">2H</span>
        <p class="mt-2 font-space-grotesk font-medium uppercase tracking-[0.22em] text-volta-noir/75 text-xs">
          Intervention urgence sous 2 heures
        </p>
      </li>
    </ul>
  </div>
</section>
