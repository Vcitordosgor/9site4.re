---
/**
 * Citation — section editoriale fond noir, texte massif italique cyan.
 */
---

<section class="relative bg-volta-noir text-volta-fumee py-24 md:py-36 px-6 md:px-10 overflow-hidden">
  <div class="pointer-events-none absolute inset-0 opacity-[0.06]" aria-hidden="true"
       style="background-image: linear-gradient(rgb(6 212 245) 1px, transparent 1px), linear-gradient(90deg, rgb(6 212 245) 1px, transparent 1px); background-size: 60px 60px;">
  </div>

  <div class="relative max-w-5xl mx-auto">
    <span class="scroll-reveal block font-syne font-bold text-volta-cyan/15 leading-none" style="font-size: clamp(120px, 18vw, 220px);" aria-hidden="true">
      &laquo;
    </span>

    <blockquote class="scroll-reveal -mt-12 md:-mt-20 font-space-grotesk italic text-volta-blanc leading-[1.18] tracking-tight" style="font-size: clamp(30px, 4.6vw, 52px);">
      Un bon branchement ne se voit pas. Il se mesure, il se contrôle, il dure trente ans.
      <span class="block mt-4 not-italic text-volta-cyan font-syne font-bold">Pas trente jours.</span>
    </blockquote>

    <footer class="scroll-reveal mt-10 flex items-center gap-4">
      <span class="block w-12 h-px bg-volta-cyan" aria-hidden="true"></span>
      <p class="font-space-grotesk uppercase tracking-[0.28em] text-volta-fumee/60 text-xs">
        Carnet d'atelier — norme NF C 15-100
      </p>
    </footer>
  </div>
</section>
