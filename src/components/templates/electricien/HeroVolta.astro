---
import data from '../../../data/templates/volta.json';
---

<section id="top" class="relative min-h-dvh flex items-center bg-volta-noir overflow-hidden">

  <!-- Fond graphique : photo + dégradé sombre + composition tableau électrique SVG -->
  <div class="absolute inset-0" aria-hidden="true">
    <img src={data.info.photoHero} alt="" fetchpriority="high" decoding="async"
         class="absolute inset-0 w-full h-full object-cover opacity-25 mix-blend-luminosity" />
    <div class="absolute inset-0" style="background: radial-gradient(120% 80% at 80% 20%, rgb(6 212 245 / 0.12) 0%, transparent 60%), linear-gradient(180deg, rgb(15 17 21 / 0.85) 0%, rgb(22 26 32 / 0.95) 100%);"></div>

    <!-- Schéma tableau électrique (visible desktop, masqué mobile) -->
    <svg class="hidden md:block absolute right-0 top-1/2 -translate-y-1/2 h-[88%] w-auto opacity-[0.22] hero-vivant"
         viewBox="0 0 360 480" fill="none" aria-hidden="true">
      <!-- Coffret -->
      <rect x="20" y="20" width="320" height="440" rx="6" stroke="#06D4F5" stroke-width="1.5" fill="rgb(6 212 245 / 0.03)"/>
      <rect x="36" y="36" width="288" height="40" stroke="#06D4F5" stroke-width="1" opacity="0.6"/>
      <text x="50" y="62" fill="#06D4F5" font-family="monospace" font-size="14" opacity="0.9">NF C 15-100</text>
      <!-- Rails DIN + disjoncteurs -->
      {[100, 170, 240, 310, 380].map((y) => (
        <g>
          <line x1="36" y1={y} x2="324" y2={y} stroke="#06D4F5" stroke-width="0.6" opacity="0.45"/>
          {[50, 90, 130, 170, 210, 250, 290].map((x) => (
            <g>
              <rect x={x} y={y - 22} width="28" height="44" stroke="#06D4F5" stroke-width="1" fill="rgb(6 212 245 / 0.05)"/>
              <line x1={x + 14} y1={y - 16} x2={x + 14} y2={y - 8} stroke="#06D4F5" stroke-width="1.2"/>
              <circle cx={x + 14} cy={y - 4} r="1.5" fill="#06D4F5"/>
            </g>
          ))}
        </g>
      ))}
      <!-- Câbles sortants -->
      <path d="M180 460 V 478" stroke="#C97A40" stroke-width="2" opacity="0.7"/>
      <path d="M120 460 V 472 H 60 V 478" stroke="#C97A40" stroke-width="2" opacity="0.5" fill="none"/>
      <path d="M240 460 V 472 H 300 V 478" stroke="#C97A40" stroke-width="2" opacity="0.5" fill="none"/>
    </svg>

    <!-- Ornement circuit gauche, léger -->
    <svg class="absolute left-0 bottom-0 h-1/2 w-1/3 opacity-[0.06] hidden lg:block"
         viewBox="0 0 300 600" fill="none" stroke="#06D4F5" stroke-width="1" aria-hidden="true">
      <path d="M0 100 H120 V220 H40 V360 H180 V480 H80 V600"/>
      <circle cx="120" cy="220" r="3" fill="#06D4F5"/>
      <circle cx="180" cy="360" r="3" fill="#06D4F5"/>
      <circle cx="80" cy="480" r="3" fill="#06D4F5"/>
    </svg>
  </div>

  <div class="relative max-w-content mx-auto px-6 md:px-10 pt-32 pb-20 md:pt-40 md:pb-28 w-full">
    <div class="max-w-2xl">

      <!-- Badge urgence pulsant -->
      <div class="flex items-center gap-3 mb-8">
        <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-volta-cyan opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-volta-cyan"></span>
        </span>
        <span class="font-space-grotesk text-xs font-semibold uppercase tracking-[0.28em] text-volta-cyan">
          {data.urgence.label} · 7j/7 · Sud Réunion
        </span>
      </div>

      <!-- Tagline italique éditoriale -->
      <p class="font-space-grotesk italic text-volta-fumee/60 mb-5 max-w-md" style="font-size: clamp(15px, 1.4vw, 17px);">
        Pour les jours où le tableau électrique fait sa loi.
      </p>

      <!-- Titre principal -->
      <h1 class="font-syne font-extrabold text-volta-blanc leading-[0.92] tracking-tight" style="font-size: clamp(56px, 10vw, 128px);">
        L'électricité,<br/>
        <span class="text-volta-cyan italic">c'est sérieux.</span>
      </h1>

      <!-- Sous-titre -->
      <p class="mt-8 font-space-grotesk text-volta-fumee/75 leading-relaxed max-w-md" style="font-size: clamp(15px, 1.5vw, 18px);">
        {data.info.description}
      </p>

      <!-- Certification badge -->
      <p class="mt-4 font-space-grotesk text-xs text-volta-cyan-fonce tracking-wide">
        <span class="mr-1 text-volta-cuivre">⚡</span>{data.info.certification}
      </p>

      <!-- CTA buttons -->
      <div class="mt-10 flex flex-wrap gap-4">
        <a
          href="#devis"
          class="volta-cta-primary inline-flex items-center justify-center px-8 text-sm font-space-grotesk font-semibold uppercase tracking-[0.18em] rounded-sm bg-volta-cyan text-volta-noir hover:bg-volta-blanc transition-all"
          style="height: 52px;"
        >
          Demander un devis
        </a>
        <a
          href="#devis"
          class="inline-flex items-center justify-center gap-2 px-8 text-sm font-space-grotesk font-semibold uppercase tracking-[0.18em] rounded-sm bg-transparent text-volta-cyan border border-volta-cyan hover:bg-volta-cyan hover:text-volta-noir transition-colors"
          style="height: 52px;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9"/>
            <polyline points="12 7 12 12 15 14"/>
          </svg>
          Devis sous 24h
        </a>
        <a
          href={`tel:${data.info.telephoneHref}`}
          class="inline-flex items-center gap-2 px-8 text-sm font-space-grotesk font-medium text-volta-fumee border border-volta-fumee/25 hover:border-volta-cyan hover:text-volta-cyan transition-colors rounded-sm"
          style="height: 52px;"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1L6.6 10.8z"/>
          </svg>
          <span class="tabular-nums">{data.info.telephone}</span>
        </a>
      </div>

    </div>

    <!-- Stats flottantes -->
    <div class="mt-16 md:mt-20 grid grid-cols-3 gap-6 md:gap-10 max-w-lg border-t border-volta-fumee/10 pt-10">
      {[
        { val: 'NF C', label: 'norme 15-100 respectée' },
        { val: '10 ans', label: 'garantie décennale' },
        { val: '24h', label: 'devis envoyé' },
      ].map(({ val, label }) => (
        <div>
          <p class="font-syne font-bold text-volta-cyan" style="font-size: clamp(28px, 3.5vw, 40px);">{val}</p>
          <p class="mt-1 font-space-grotesk text-xs text-volta-fumee/55 uppercase tracking-[0.18em] leading-snug">{label}</p>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  .volta-cta-primary {
    box-shadow: 0 8px 24px rgb(6 212 245 / 0.25);
  }
  .volta-cta-primary:hover {
    box-shadow: 0 12px 36px rgb(6 212 245 / 0.5);
    transform: translateY(-1px);
  }
  @keyframes hero-vivant {
    from { transform: scale(1.06); }
    to   { transform: scale(1); }
  }
  .hero-vivant {
    transform-origin: center;
    animation: hero-vivant 2400ms cubic-bezier(0.22, 1, 0.36, 1) both;
    will-change: transform;
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-vivant { animation: none !important; transform: none !important; }
  }
</style>
