---
/**
 * Certifications — 4 badges techniques électricien.
 * Qualifelec, IRVE, CONSUEL, décennale.
 */
const certifs = [
  {
    icon: '<path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>',
    label: 'Électricien qualifié',
    sub: 'Habilitations électriques',
  },
  {
    icon: '<rect x="3" y="11" width="14" height="10" rx="2"/><path d="M7 11V7a3 3 0 0 1 6 0v4"/><circle cx="10" cy="16" r="1.5"/>',
    label: 'Bornes IRVE',
    sub: 'Véhicules électriques',
  },
  {
    icon: '<path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/>',
    label: 'Conformité',
    sub: 'Attestations délivrées',
  },
  {
    icon: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
    label: 'Décennale & RC pro',
    sub: 'Assurances à jour',
  },
];
---

<section class="relative bg-volta-acier text-volta-fumee py-20 md:py-24 px-6 md:px-10">
  <div class="max-w-content mx-auto">

    <header class="text-center max-w-2xl mx-auto mb-12 md:mb-14">
      <p class="scroll-reveal text-[11px] sm:text-xs font-space-grotesk font-semibold uppercase tracking-[0.32em] text-volta-cyan">
        Certifications & habilitations
      </p>
      <h2 class="scroll-reveal mt-4 font-syne font-bold text-volta-blanc leading-[0.95] tracking-tight" style="font-size: clamp(30px, 4vw, 48px);">
        Volta est habilité<br/><span class="text-volta-cyan">à le faire.</span>
      </h2>
    </header>

    <ul class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {certifs.map((c, i) => (
        <li
          class="scroll-reveal group relative flex flex-col items-start gap-5 p-7 bg-volta-noir border border-volta-fumee/10 hover:border-volta-cyan transition-all duration-300 hover:-translate-y-1"
          style={`transition-delay: ${i * 70}ms; box-shadow: 0 0 0 0 rgb(6 212 245 / 0); transition: box-shadow .3s, transform .3s, border-color .3s;`}
        >
          <span class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-volta-acier text-volta-cyan border border-volta-cyan/30 group-hover:bg-volta-cyan group-hover:text-volta-noir transition-colors">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon} />
          </span>
          <div>
            <h3 class="font-syne font-semibold text-volta-blanc leading-tight" style="font-size: 20px;">
              {c.label}
            </h3>
            <p class="mt-1 font-space-grotesk text-volta-fumee/60 text-xs uppercase tracking-[0.18em]">
              {c.sub}
            </p>
          </div>
        </li>
      ))}
    </ul>

    <!-- Tableau NF C 15-100 interactif : cliquez sur un disjoncteur pour éclairer la pièce -->
    <div class="scroll-reveal mt-14 md:mt-16 bg-volta-noir border border-volta-fumee/10 p-7 md:p-10" data-tableau-interactif>
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">

        <!-- Côté gauche : le tableau de disjoncteurs -->
        <div class="lg:col-span-5">
          <p class="font-space-grotesk text-[11px] uppercase tracking-[0.32em] text-volta-cyan mb-2">Tableau NF C 15-100</p>
          <h3 class="font-syne font-semibold text-volta-blanc text-xl md:text-2xl mb-5">Allumez la maison.</h3>
          <p class="font-space-grotesk text-xs text-volta-fumee/55 mb-6">Cliquez sur un disjoncteur pour éclairer la pièce correspondante.</p>

          <div class="relative bg-volta-acier border border-volta-cyan/25 rounded-sm p-4">
            <div class="flex items-center justify-between mb-3 pb-3 border-b border-volta-cyan/15">
              <span class="font-mono text-[10px] tracking-[0.18em] text-volta-cyan/85">RAIL DIN · 230V · 30mA</span>
              <span class="font-mono text-[10px] text-volta-fumee/45">NF C 15-100</span>
            </div>
            <div class="grid grid-cols-4 gap-2.5" role="group" aria-label="Disjoncteurs">
              {['salon','cuisine','chambre','sdb'].map((zone, i) => (
                <button
                  type="button"
                  class="breaker group relative h-20 flex flex-col items-center justify-between py-2 bg-volta-noir border border-volta-cyan/30 hover:border-volta-cyan transition-colors"
                  data-breaker={zone}
                  aria-pressed="false"
                  aria-label={`Disjoncteur ${zone}`}
                >
                  <span class="font-mono text-[9px] uppercase tracking-wider text-volta-fumee/60 group-[.is-on]:text-volta-cyan transition-colors">{['Salon','Cuisine','Chambre','SdB'][i]}</span>
                  <span class="switch-track relative w-5 h-9 bg-volta-acier border border-volta-cyan/40 rounded-sm overflow-hidden">
                    <span class="switch-thumb absolute left-0.5 right-0.5 h-3.5 bg-volta-fumee/70 rounded-[2px] transition-all duration-300 ease-out" style="top: calc(100% - 16px);"></span>
                  </span>
                  <span class="font-mono text-[8px] tracking-widest text-volta-fumee/40 group-[.is-on]:text-volta-cyan transition-colors">16A</span>
                </button>
              ))}
            </div>
            <p class="mt-3 pt-3 border-t border-volta-cyan/15 font-mono text-[10px] text-volta-fumee/45">
              ⚡ <span data-actifs>0</span>/4 circuits actifs
            </p>
          </div>
        </div>

        <!-- Côté droit : la maison qui s'allume -->
        <div class="lg:col-span-7">
          <div class="relative aspect-[4/3] bg-volta-acier border border-volta-fumee/10 rounded-sm overflow-hidden" data-maison>
            <svg viewBox="0 0 400 300" class="absolute inset-0 w-full h-full" aria-hidden="true">
              <!-- Toit -->
              <path d="M40 140 L200 50 L360 140 Z" fill="#16191E" stroke="#06D4F5" stroke-width="0.6" opacity="0.35"/>
              <!-- Murs extérieurs -->
              <rect x="60" y="140" width="280" height="140" fill="#16191E" stroke="#06D4F5" stroke-width="0.6" opacity="0.35"/>
              <!-- Cloisons -->
              <line x1="200" y1="140" x2="200" y2="280" stroke="#06D4F5" stroke-width="0.6" opacity="0.35"/>
              <line x1="60" y1="210" x2="340" y2="210" stroke="#06D4F5" stroke-width="0.6" opacity="0.35"/>

              <!-- Salon (haut gauche) -->
              <g class="room" data-room="salon">
                <rect x="60" y="140" width="140" height="70" fill="#06D4F5" class="room-fill"/>
                <circle cx="130" cy="160" r="3" fill="#06D4F5" class="bulb"/>
                <text x="130" y="195" text-anchor="middle" font-family="monospace" font-size="9" fill="#F5F7FA" opacity="0.7">SALON</text>
              </g>
              <!-- Cuisine (haut droite) -->
              <g class="room" data-room="cuisine">
                <rect x="200" y="140" width="140" height="70" fill="#06D4F5" class="room-fill"/>
                <circle cx="270" cy="160" r="3" fill="#06D4F5" class="bulb"/>
                <text x="270" y="195" text-anchor="middle" font-family="monospace" font-size="9" fill="#F5F7FA" opacity="0.7">CUISINE</text>
              </g>
              <!-- Chambre (bas gauche) -->
              <g class="room" data-room="chambre">
                <rect x="60" y="210" width="140" height="70" fill="#06D4F5" class="room-fill"/>
                <circle cx="130" cy="230" r="3" fill="#06D4F5" class="bulb"/>
                <text x="130" y="265" text-anchor="middle" font-family="monospace" font-size="9" fill="#F5F7FA" opacity="0.7">CHAMBRE</text>
              </g>
              <!-- SdB (bas droite) -->
              <g class="room" data-room="sdb">
                <rect x="200" y="210" width="140" height="70" fill="#06D4F5" class="room-fill"/>
                <circle cx="270" cy="230" r="3" fill="#06D4F5" class="bulb"/>
                <text x="270" y="265" text-anchor="middle" font-family="monospace" font-size="9" fill="#F5F7FA" opacity="0.7">SDB</text>
              </g>
              <!-- Porte -->
              <rect x="190" y="260" width="20" height="20" fill="#0F1115" stroke="#06D4F5" stroke-width="0.6" opacity="0.35"/>
            </svg>
            <div class="absolute bottom-3 right-3 font-mono text-[10px] text-volta-fumee/45">230V · 50Hz</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Checklist conformité NF C 15-100 + Consuel -->
    <div class="scroll-reveal mt-12 grid lg:grid-cols-2 gap-4">
      {[
        {
          titre: 'Checklist NF C 15-100',
          items: [
            'Mise à la terre vérifiée et mesurée',
            'Disjoncteur différentiel 30 mA par circuit',
            'Sections de câbles adaptées (1,5 / 2,5 / 6 mm²)',
            'Nombre minimum de prises par pièce respecté',
            'Volumes salle de bain (0 / 1 / 2) sécurisés',
            'Tableau étiqueté, repéré et accessible',
          ],
        },
        {
          titre: 'Dossier Consuel',
          items: [
            'Attestation de conformité visée Consuel',
            'Schéma du tableau électrique fourni',
            'Photos avant / après archivées',
            'Rendez-vous de contrôle pris pour vous',
            'Mise en service Enedis coordonnée',
          ],
        },
      ].map((bloc, b) => (
        <div class="bg-volta-noir border border-volta-fumee/10 p-7" style={`transition-delay: ${b * 80}ms`}>
          <h3 class="font-syne font-semibold text-volta-blanc text-lg mb-5 flex items-center gap-3">
            <span class="inline-block w-2 h-2 bg-volta-cyan" aria-hidden="true"></span>
            {bloc.titre}
          </h3>
          <ul class="space-y-3">
            {bloc.items.map((it) => (
              <li class="flex items-start gap-3 font-space-grotesk text-sm text-volta-fumee/85 leading-snug">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" class="text-volta-cyan flex-shrink-0 mt-0.5" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
                <span>{it}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  [data-tableau-interactif] .room-fill { opacity: 0; transition: opacity 320ms ease-out; }
  [data-tableau-interactif] .room.is-lit .room-fill { opacity: 0.18; }
  [data-tableau-interactif] .bulb { opacity: 0.25; transition: opacity 320ms ease-out, filter 320ms ease-out; }
  [data-tableau-interactif] .room.is-lit .bulb {
    opacity: 1;
    filter: drop-shadow(0 0 8px #06D4F5) drop-shadow(0 0 14px rgba(6,212,245,0.55));
  }
  [data-tableau-interactif] .breaker.is-on { border-color: #06D4F5; background: rgb(6 212 245 / 0.06); }
  [data-tableau-interactif] .breaker.is-on .switch-thumb {
    top: 2px;
    background: #06D4F5;
    box-shadow: 0 0 6px rgba(6,212,245,0.6);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-tableau-interactif] .room-fill,
    [data-tableau-interactif] .bulb,
    [data-tableau-interactif] .switch-thumb { transition: none !important; }
  }
</style>

<script>
  (() => {
    const root = document.querySelector('[data-tableau-interactif]');
    if (!root) return;
    const breakers = root.querySelectorAll<HTMLButtonElement>('[data-breaker]');
    const compteur = root.querySelector('[data-actifs]');
    const rooms = root.querySelectorAll<SVGGElement>('.room');
    const sync = () => {
      let n = 0;
      breakers.forEach((b) => {
        const on = b.classList.contains('is-on');
        if (on) n++;
        b.setAttribute('aria-pressed', String(on));
        const target = b.dataset.breaker;
        rooms.forEach((r) => {
          if (r.dataset.room === target) r.classList.toggle('is-lit', on);
        });
      });
      if (compteur) compteur.textContent = String(n);
    };
    breakers.forEach((b) => {
      b.addEventListener('click', () => {
        b.classList.toggle('is-on');
        sync();
      });
    });
    // Démo : le salon est allumé au reveal
    const first = root.querySelector<HTMLButtonElement>('[data-breaker="salon"]');
    if (first) { first.classList.add('is-on'); }
    sync();
  })();
</script>
