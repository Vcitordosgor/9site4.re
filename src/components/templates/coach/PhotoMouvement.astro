---
/**
 * PhotoMouvement — section visuelle full-bleed athlète en mouvement.
 */
---

<section class="bg-coach-noir">
  <figure class="relative aspect-[21/9] overflow-hidden bg-coach-charbon">
    <img
      src="https://images.unsplash.com/photo-1517836357463-d25dfeac3438?w=1800&q=85"
      alt="Athlète en pleine séance d'entraînement, gros plan"
      class="w-full h-full object-cover grayscale"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-coach-noir/80 via-coach-noir/30 to-transparent"></div>
    <figcaption class="absolute bottom-6 md:bottom-12 left-6 md:left-12 right-6 md:right-12 max-w-2xl">
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-coach-lime font-bold mb-3">
        ▸ TRAINING DAY
      </p>
      <p class="font-big-shoulders font-black text-coach-blanc leading-[0.95] uppercase tracking-tight" style="font-size: clamp(36px, 5vw, 72px);">
        Un pas après l'autre.<br/><span class="text-coach-lime italic">Chaque séance compte.</span>
      </p>
    </figcaption>
  </figure>
</section>
