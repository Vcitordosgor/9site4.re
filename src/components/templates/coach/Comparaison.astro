---
const salle = [
  "Tu paies un abonnement, tu y vas 2 fois",
  "Aucun programme adapté à ton corps",
  "Tu fais 3 séries de muscu au hasard",
  "Personne ne corrige ta technique",
  "Aucun suivi de progression",
  "Tu lâches dans 2 mois",
];

const coach = [
  "Séance bloquée, tu y vas, j'y suis",
  "Programme calibré sur ta morpho et ton objectif",
  "Chaque exo a un sens, on note les charges",
  "Je corrige en direct, à chaque rep",
  "Photos, mesures, charges suivies tous les mois",
  "Tu tiens parce que tu vois les résultats",
];
---

<section class="bg-coach-noir py-20 md:py-28 px-6 md:px-10 border-t border-coach-blanc/10">
  <div class="max-w-content mx-auto">

    <header class="mb-14">
      <p class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-coach-lime mb-3">
        // COMPARATIF
      </p>
      <h2 class="font-big-shoulders font-black text-coach-blanc uppercase leading-[0.88] italic" style="font-size: clamp(48px, 8vw, 112px); font-style: italic;">
        Salle de sport<br/>
        <span class="text-coach-lime">vs. coach perso.</span>
      </h2>
    </header>

    <div class="grid md:grid-cols-2 gap-px bg-coach-blanc/10 border border-coach-blanc/10">

      <div class="bg-coach-charbon p-7 md:p-9">
        <p class="font-jetbrains-mono text-[11px] uppercase tracking-[0.22em] text-coach-gris mb-6 pb-4 border-b border-coach-blanc/10">
          ── Sans coach
        </p>
        <ul class="space-y-4">
          {salle.map((it) => (
            <li class="flex gap-3 items-start font-barlow text-coach-gris text-[14.5px] leading-relaxed">
              <span class="font-big-shoulders font-black text-coach-gris/60 text-2xl leading-none shrink-0 -mt-1">×</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-coach-graphite p-7 md:p-9 relative">
        <div class="absolute top-0 right-0 px-3 py-1.5 bg-coach-lime text-coach-noir font-jetbrains-mono text-[10px] uppercase tracking-[0.22em] font-bold">
          ▶ FOUDRE
        </div>
        <p class="font-jetbrains-mono text-[11px] uppercase tracking-[0.22em] text-coach-lime mb-6 pb-4 border-b border-coach-lime/30">
          ── Avec Foudre
        </p>
        <ul class="space-y-4">
          {coach.map((it) => (
            <li class="flex gap-3 items-start font-barlow text-coach-blanc text-[14.5px] leading-relaxed">
              <span class="font-big-shoulders font-black text-coach-lime text-2xl leading-none shrink-0 -mt-1">→</span>
              <span>{it}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
