---
import data from '../../../data/templates/foudre.json';
---

<section class="bg-coach-lime text-coach-noir">
  <div class="max-w-content mx-auto px-6 md:px-10 py-12 md:py-16">
    <div class="grid md:grid-cols-12 gap-6 items-center">
      <div class="md:col-span-7">
        <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-coach-noir/80 font-bold mb-3">
          ▸ ACCESS · 01
        </p>
        <p class="font-big-shoulders font-black text-coach-noir leading-[0.95] uppercase tracking-tight" style="font-size: clamp(32px, 4.4vw, 56px);">
          Séance d'essai <span class="italic">offerte</span> — viens tester, sans rien signer.
        </p>
      </div>
      <div class="md:col-span-5 md:text-right">
        <a
          href="#essai"
          class="inline-flex items-center justify-center h-14 px-7 bg-coach-noir text-coach-lime font-big-shoulders font-bold text-base uppercase tracking-wider hover:bg-coach-charbon transition-colors"
        >
          Réserver ma séance →
        </a>
        <p class="mt-3 font-mono text-[11px] uppercase tracking-[0.28em] text-coach-noir/80">
          {data.info.telephone}
        </p>
      </div>
    </div>
  </div>
</section>
