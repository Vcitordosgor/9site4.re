---
import data from '../../../data/templates/foudre.json';
---

<section class="bg-coach-charbon text-coach-blanc border-y-4 border-coach-lime py-28 md:py-44 px-6 md:px-10 relative overflow-hidden">
  <span aria-hidden="true" class="absolute -top-12 -right-8 font-big-shoulders font-black text-coach-lime/10 leading-none select-none uppercase" style="font-size: clamp(180px, 32vw, 480px);">
    TON RYTHME
  </span>

  <div class="relative max-w-5xl mx-auto">
    <p class="inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.28em] text-coach-lime font-bold mb-6">
      <span class="block w-8 h-px bg-coach-lime"></span>
      MANIFESTE · 01
    </p>
    <blockquote class="font-big-shoulders font-black text-coach-blanc leading-[0.95] tracking-tight uppercase" style="font-size: clamp(44px, 7vw, 112px);">
      Avance à ton rythme. <br/><span class="text-coach-lime italic">Reste régulier.</span>
    </blockquote>
    <footer class="mt-10 pt-5 border-t border-coach-lime/30 flex flex-wrap items-baseline justify-between gap-3">
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-coach-gris">
        ▸ {data.info.coach} · {data.info.wordmark}
      </p>
      <p class="font-mono text-[11px] uppercase tracking-[0.28em] text-coach-lime">
        depuis {data.info.annee}
      </p>
    </footer>
  </div>
</section>
