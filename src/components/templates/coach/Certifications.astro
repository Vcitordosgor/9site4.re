---
const items = [
  { l: 'BPJEPS', s: 'Activités Physiques pour Tous · Diplôme État' },
  { l: 'CQP·ALS', s: 'Animation Loisirs Sportifs · branche musculation' },
  { l: 'PSC1', s: 'Premiers secours civiques · à jour 2024' },
  { l: 'RCP', s: 'Responsabilité civile pro · MAIF Sport' },
];
---

<section class="bg-coach-charbon py-16 md:py-20 px-6 md:px-10 border-y border-coach-lime/30">
  <div class="max-w-content mx-auto">

    <header class="mb-10">
      <p class="font-jetbrains-mono text-[11px] uppercase tracking-[0.32em] text-coach-lime mb-3">
        // CERTIFICATIONS
      </p>
      <h2 class="font-big-shoulders font-black text-coach-blanc uppercase leading-[0.9] italic" style="font-size: clamp(36px, 5vw, 64px); font-style: italic;">
        Pas de bricolage.<br/>
        <span class="text-coach-lime">Du diplôme.</span>
      </h2>
    </header>

    <ul class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
      {items.map((it) => (
        <li class="bg-coach-graphite border-2 border-coach-blanc/15 px-5 py-7 text-center group hover:border-coach-lime hover:translate-y-[-4px] transition-all relative">

          <svg viewBox="0 0 64 64" class="w-12 h-12 mx-auto mb-4 text-coach-lime" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
            <polygon points="32,8 56,22 52,52 12,52 8,22"/>
            <path d="M24 32 L30 38 L42 24" stroke="currentColor" stroke-width="3"/>
          </svg>

          <p class="font-big-shoulders font-black text-coach-blanc text-2xl md:text-3xl uppercase leading-none tracking-tight">
            {it.l}
          </p>
          <p class="mt-3 pt-3 border-t border-coach-blanc/15 font-jetbrains-mono text-[10px] uppercase tracking-[0.18em] text-coach-gris leading-relaxed">
            {it.s}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
