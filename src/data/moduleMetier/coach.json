      "options": ["Remise en forme", "Perte de poids", "Prise de masse", "Préparation spécifique"],
      "defaut": "Remise en forme"
    },
    {
      "type": "select",
      "id": "format",
      "label": "Format souhaité",
      "requis": true,
      "options": ["À domicile", "En extérieur", "En visio", "Peu importe"],
      "defaut": "En extérieur"
