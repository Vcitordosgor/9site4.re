---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import VillePageSections from '../components/sections/VillePageSections.astro';
import { getSeo, absoluteUrl, getServiceOffer } from '../lib/seo';
import { getVille } from '../data/villes.ts';

const seo = getSeo('villeSaintDenis');
const ville = getVille('saint-denis')!;

const raisons = [
  { i: 'map-pin', t: 'Visibilité locale', d: `Apparaître sur les recherches "à ${ville.nom}" et capter une demande déjà qualifiée.` },
  { i: 'shield-check', t: 'Crédibilité immédiate', d: `Un site clair rassure cabinets, partenaires institutionnels et clients du chef-lieu.` },
  { i: 'monitor', t: 'Mobile-first', d: 'La majorité des visiteurs vous découvrent depuis un téléphone — votre site doit suivre.' },
  { i: 'calendar-check', t: 'Prise de contact facile', d: 'Téléphone, WhatsApp, formulaire, RDV : un seul clic suffit.' },
  { i: 'file-text', t: 'Informations à jour', d: '9site4 met à jour horaires, tarifs, équipe au fil de la vie de votre activité.' },
];

const faq = [
  { q: "Faut-il se rencontrer en personne pour créer mon site à Saint-Denis ?", a: "Non. Tout se fait à distance : un appel ou une visio d'environ 30 minutes pour cadrer le besoin, puis des échanges par e-mail ou WhatsApp. Vous gardez votre temps pour votre activité." },
  { q: "Mon cabinet ou mon commerce du centre-ville peut-il se démarquer en ligne ?", a: "La concurrence est plus dense à Saint-Denis qu'ailleurs sur l'île, mais un site structuré, avec des contenus précis sur vos prestations, permet d'être identifié clairement. Nous ne promettons pas de position sur Google : nous livrons une base saine, rapide et bien référençable." },
  { q: "En combien de temps mon site est-il en ligne ?", a: "Environ 7 jours après réception de vos contenus (textes, photos, informations pratiques). Le délai réel dépend surtout de la rapidité de vos retours." },
  { q: "Mes clients viennent aussi de Saint-André ou de Saint-Benoît : le site en tiendra-t-il compte ?", a: "Oui. Le site présente votre zone réelle d'activité ou de chalandise, pas seulement une adresse à Saint-Denis (97400). Il reste lisible et rapide sur mobile, où se font la plupart des recherches locales." },
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Création de site internet à ${ville.nom}`,
  serviceType: 'Création de site internet',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: {
    '@type': 'Place',
    name: ville.nom,
    address: { '@type': 'PostalAddress', addressLocality: ville.nom, postalCode: ville.code, addressRegion: 'La Réunion', addressCountry: 'FR' },
  },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: getServiceOffer(),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-black text-blanc-casse">
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Création incluse · Module métier · Gestion continue · {ville.microRegion} 974
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Création de site internet à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">(La Réunion).</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 conçoit et gère le site internet des professionnels installés à {ville.nom} ({ville.code}) — cabinets, commerces, indépendants. Création incluse, accompagnement local.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Voir nos réalisations</a>
        </div>
      </div>
    </section>

    <VillePageSections ville={ville} variantSeed={0} raisons={raisons} faq={faq} />

    <section class="relative px-6 py-[3rem] md:py-[4.5rem]" aria-labelledby="web-local-titre">
      <div class="mx-auto max-w-3xl">
        <h2 id="web-local-titre" class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Le web à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">vu du chef-lieu.</span>
        </h2>
        <div class="scroll-reveal mt-8 space-y-5 text-blanc-casse/75 leading-relaxed">
        <p>Avec environ 150 000 habitants, Saint-Denis est la commune la plus peuplée de La Réunion et son principal pôle tertiaire. Préfecture, sièges d'entreprises, cabinets libéraux, commerces de centre-ville : la concurrence y est réelle dans presque tous les secteurs, et vos clients comparent avant de choisir. Un site clair, à jour et facile à trouver est souvent le premier contact avec votre cabinet ou votre boutique.</p>
        <p>Les activités qui structurent l'économie dionysienne — administration, services, commerce, professions libérales — ont un point commun : la crédibilité se joue de plus en plus en ligne. Un avocat, un expert-comptable ou un consultant sans site sérieux part avec un handicap face à des confrères bien présentés. Pour un commerce du centre-ville, des horaires exacts et des informations d'accès claires évitent des appels inutiles et des clients perdus.</p>
        <p>Un site 9site4 pour un professionnel de Saint-Denis, c'est une structure pensée pour votre métier : présentation de l'activité, prestations, prise de rendez-vous ou demande de devis, informations pratiques. Le contenu est rédigé pour être compris rapidement, y compris sur mobile, où se fait l'essentiel des recherches locales.</p>
        <p>Saint-Denis rayonne aussi au-delà de ses limites : une partie de votre clientèle vient de Saint-André, de Saint-Benoît ou de l'Ouest pour travailler ou consulter dans le chef-lieu. Votre site doit donc présenter clairement votre zone d'activité, pas seulement une adresse. C'est ce que nous préparons : des pages lisibles, un référencement local propre et une gestion continue pour que les informations restent justes dans le temps.</p>
        <p>Concrètement, les secteurs les plus demandeurs à Saint-Denis sont ceux que 9site4 connaît bien : professions libérales, TPE/PME de services, commerces de proximité, restauration, salons de coiffure, instituts et praticiens du bien-être. Pour chacun, le site intègre le module métier qui compte — prise de rendez-vous, demande de devis, réservation ou simple contact — et l'abonnement unique couvre création, hébergement et mises à jour, sans frais cachés. Le premier échange est gratuit : présentez votre activité dionysienne, nous vous répondons honnêtement sur ce qu'un site peut vous apporter — et ce qu'il ne peut pas.</p>
        </div>
      </div>
    </section>

    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Vous êtes professionnel à {ville.nom} ?{' '}
          <span class="block italic font-medium text-bleu">Présentez votre activité à 9site4.</span>
        </h2>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">Démarrer mon projet<Icon name="arrow-right" size={20} strokeWidth={2.25} /></Button>
          <a href="/diagnostic-site-internet-la-reunion" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Diagnostic gratuit</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
