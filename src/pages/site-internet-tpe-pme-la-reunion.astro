---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import { getSeo, absoluteUrl, getServiceOffer } from '../lib/seo';

const seo = getSeo('siteTpePmeReunion');

const SLUGS = ['snack-pizzeria', 'institut-de-beaute', 'plomberie', 'cabinet-comptable', 'gite-de-montagne', 'coach-sportif'];
const selected = SLUGS
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

const faq = [
  {
    q: "Je suis une petite structure, ai-je vraiment besoin d'un site ?",
    a: "Oui — surtout en TPE/PME. Vos clients (B2C ou B2B) vous cherchent en ligne avant tout autre contact. Sans site clair, vous perdez en crédibilité face à des concurrents même moins compétents, mais mieux présentés.",
  },
  {
    q: "Combien ça coûte vraiment, sans surprise ?",
    a: "97,4€/mois tout inclus. Création, design, module métier, domaine, hébergement, maintenance, modifications simples. Pas de frais de création, pas d'engagement, pas de surprise dans 6 mois.",
  },
  {
    q: "Mon activité est très spécifique — vous savez gérer ?",
    a: "Oui. 9site4 a travaillé avec restaurateurs, artisans, professions libérales, hébergeurs, coachs, commerces, instituts. Chaque site est structuré pour le métier — on commence par un appel pour comprendre votre activité.",
  },
  {
    q: "Quels modules métier proposez-vous ?",
    a: "Réservation, devis, RDV, séjour, commande, inscription, premier échange. Selon votre activité, on intègre celui qui correspond à votre vrai flux client — pas un module générique.",
  },
  {
    q: "Et la SEO locale dans tout ça ?",
    a: "Votre site est structuré pour les recherches du 974 : commune, métier, contenu local, données structurées. On vous aide aussi à exploiter votre fiche Google pour capter les recherches de proximité.",
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet pour TPE/PME à La Réunion',
  serviceType: 'Création de site internet — TPE/PME',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: getServiceOffer(),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          TPE / PME réunionnaises · Tous secteurs
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Site internet pour TPE/PME{' '}
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 accompagne les TPE/PME réunionnaises avec des sites professionnels clairs, fiables, adaptés à leur métier et gérés dans la durée.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Pourquoi -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le constat
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Chaque TPE/PME a un parcours client unique —{' '}
            <span class="block italic font-medium text-bleu">votre site doit le respecter.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Un restaurant prend des réservations. Un plombier reçoit des demandes de devis. Un gîte accueille des séjours. Un coach prend des RDV. 9site4 construit le site qui correspond au vrai parcours de votre client — pas un template générique.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'monitor', t: 'Une vitrine pro', d: "Image cohérente avec votre vrai niveau de service — rassurer dès la première seconde." },
            { i: 'file-text', t: 'Offres lisibles', d: 'Prestations, tarifs ou fourchettes, conditions claires.' },
            { i: 'wand', t: 'Module métier intégré', d: 'Le bon outil pour votre vrai flux : devis, RDV, séjour, commande…' },
            { i: 'shield-check', t: 'Confiance & sérieux', d: 'Mentions légales, infos pratiques, vraies photos, ton professionnel.' },
            { i: 'map-pin', t: 'Ancrage local', d: 'Communes, zone, références locales — pour la recherche du 974.' },
            { i: 'calendar-clock', t: 'Gestion continue', d: 'Modifications simples incluses, votre site ne devient pas obsolète.' },
          ].map((item) => (
            <li class="rounded-2xl p-6"
              class="card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ce que 9site4 structure -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Ce que 9site4 structure
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Tout ce qui rend votre site{' '}
            <span class="block italic font-medium text-bleu">vraiment utile.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: 'Présentation activité', d: "Qui vous êtes, ce que vous faites, pour qui." },
            { n: '02', t: 'Offres et prestations', d: "Vos services structurés selon votre métier." },
            { n: '03', t: 'Infos pratiques', d: 'Adresse, horaires, contact, WhatsApp, accès.' },
            { n: '04', t: 'Photos et univers', d: 'Votre vrai lieu, vos vraies équipes, vraies réalisations.' },
            { n: '05', t: 'Zone et localisation', d: "Communes desservies, ancrage local, points de repère 974." },
            { n: '06', t: 'Module métier + CTA', d: 'Réservation, devis, RDV, séjour, commande, inscription, info.' },
          ].map((s) => (
            <li class="rounded-2xl p-6"
              class="card-dark">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Module métier : matrice -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Le bon outil{' '}
            <span class="block italic font-medium text-bleu">selon votre activité.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Une TPE/PME ne se résume pas à un canal unique. Selon votre métier, on intègre le module qui colle à votre flux réel.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'calendar-clock', t: 'Réservation', d: 'Restaurants, cours, sorties, événements.' },
            { i: 'calendar-check', t: 'Rendez-vous', d: 'Salons, instituts, santé, conseil, professions libérales.' },
            { i: 'file-text', t: 'Devis', d: 'Artisans, BTP, paysagistes, mariages, événementiel.' },
            { i: 'wrench', t: 'Intervention', d: 'Dépannage, plomberie, électricité, garage, aide à domicile.' },
            { i: 'globe', t: 'Séjour & location', d: 'Gîtes, locations, conciergeries, tourisme.' },
            { i: 'monitor', t: 'Demande info', d: 'Commerces, services aux particuliers, B2B.' },
          ].map((m) => (
            <li class="rounded-2xl p-6"
              class="card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Tous secteurs,{' '}
            <span class="block italic font-medium text-bleu">une seule exigence.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
      </div>
    </section>

    <TarifsBref />

    <!-- FAQ -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce qu'on nous demande{' '}
            <span class="block italic font-medium text-bleu">côté TPE/PME.</span>
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-2xl p-5 md:p-6"
              class="card-dark">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <span class="font-sora font-semibold text-blanc-casse">{item.q}</span>
                <span class="shrink-0 text-bleu transition-transform duration-300 group-open:rotate-45">
                  <Icon name="arrow-right" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <p class="mt-4 text-sm md:text-base text-blanc-casse/75 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <p class="seo-links-row scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/site-vitrine-la-reunion" class="text-bleu hover:underline">site vitrine</a>
          ·
          <a href="/agence-web-la-reunion" class="text-bleu hover:underline">agence web</a>
          ·
          <a href="/site-internet-commerce-local-la-reunion" class="text-bleu hover:underline">commerce local</a>
          ·
          <a href="/creation-site-internet-la-reunion" class="text-bleu hover:underline">création de site à La Réunion</a>
          ·
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a> · <a href="/diagnostic-site-internet-la-reunion" class="text-bleu hover:underline" data-track-event="diagnostic_cta_click" data-track-category="conversion" data-track-source="seo_sector_voir_aussi" data-track-target="/diagnostic-site-internet-la-reunion">diagnostic gratuit</a> · <a href="/methode-9site4" class="text-bleu hover:underline">méthode 9site4</a> · <a href="/questions-frequentes" class="text-bleu hover:underline">questions fréquentes</a> · <a href="/trouver-le-site-adapte" class="text-bleu hover:underline">trouver le site adapté</a>.
        </p>
        <p class="villes-mesh-mention scroll-reveal mt-6 text-center text-xs text-blanc-casse/55">9site4 accompagne aussi les TPE/PME à <a href="/creation-site-internet-saint-denis" class="text-bleu hover:underline">Saint-Denis</a>, <a href="/creation-site-internet-saint-paul" class="text-bleu hover:underline">Saint-Paul</a>, <a href="/creation-site-internet-saint-pierre" class="text-bleu hover:underline">Saint-Pierre</a> et <a href="/creation-site-internet-le-tampon" class="text-bleu hover:underline">Le Tampon</a>.</p>
      </div>
    </section>

    <CTABand trackingSource="seo_sector_cta_band" trackingSector="tpe_pme" trackingPageType="seo_sector_page" />
  </div>
</BaseLayout>
