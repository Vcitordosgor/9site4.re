---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import BandeauReassurance from '../components/sections/BandeauReassurance.astro';
import VitrineExemples from '../components/sections/VitrineExemples.astro';
import Methode9site4 from '../components/sections/Methode9site4.astro';
import FormulairesIntegres from '../components/sections/FormulairesIntegres.astro';
import PourquoiChoisir from '../components/sections/PourquoiChoisir.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import Vision from '../components/sections/Vision.astro';
import ReassuranceFinale from '../components/sections/ReassuranceFinale.astro';
import CTABand from '../components/sections/CTABand.astro';
import { getSeo } from '../lib/seo';
---

<BaseLayout seo={getSeo('home')}>
  <Hero />
  <BandeauReassurance />
  <VitrineExemples />
  <div class="flex justify-center bg-black"><span class="block h-px w-24 bg-bleu/60" aria-hidden="true"></span></div>
  <Methode9site4 />
  <FormulairesIntegres />
  <div class="flex justify-center bg-black"><span class="block h-px w-24 bg-bleu/60" aria-hidden="true"></span></div>
  <PourquoiChoisir />
  <TarifsBref />
  <Vision />
  <ReassuranceFinale />
  <CTABand />
</BaseLayout>
