---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import { getFaqForPage } from '../data/faq';
import { getSeo, absoluteUrl } from '../lib/seo';

const seo = getSeo('creationSiteReunion');

// Sélection mix : 6 réalisations représentatives des grands secteurs.
const selectedSlugs = [
  'restaurant-gastronomique',
  'salon-de-coiffure',
  'plomberie',
  'cabinet-osteopathie',
  'gite-de-montagne',
  'architecte',
];
const selected = selectedSlugs
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

// FAQ centralisée (voir src/data/faq.ts). JSON-LD FAQPage uniquement sur /questions-frequentes/.
const faq = getFaqForPage('creation');

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet à La Réunion',
  serviceType: 'Création de site internet',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: {
    '@type': 'Offer',
    price: 97.4,
    priceCurrency: 'EUR',
    url: 'https://9site4.re/tarifs',
  },
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- 1. Hero SEO commercial -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          TPE / PME à La Réunion
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Création de site internet
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 conçoit, structure et gère des sites internet professionnels pour les TPE/PME réunionnaises. Site prêt en 7 jours, création incluse, gestion continue.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- 2. Pourquoi un site bien structuré -->
    <section class="relative px-6 py-16 md:py-24" aria-labelledby="pourquoi-site-titre">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le constat
          </p>
          <h2 id="pourquoi-site-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un site bien structuré
            <span class="block italic font-medium text-bleu">change tout pour une entreprise locale.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            À La Réunion, la plupart des recherches clients commencent sur Google ou WhatsApp. Sans site clair, vous perdez des prospects qui ne savent pas où vous trouver, ce que vous proposez, ni comment vous contacter.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { icon: 'monitor', t: 'Une présence professionnelle', d: "Un site propre rassure le client avant même le premier appel. Il valide votre sérieux." },
            { icon: 'file-text', t: 'Vos prestations, claires', d: "Tarifs, services, modalités : tout est lisible, plus de questions répétées au téléphone." },
            { icon: 'calendar-clock', t: 'Horaires & disponibilités', d: "Le visiteur sait quand vous êtes joignable, sans appel inutile." },
            { icon: 'map-pin', t: "Zone d'intervention", d: "Les clients du Sud, du Nord, de l'Ouest ou de l'Est savent si vous intervenez chez eux." },
            { icon: 'wand', t: 'Réservation ou devis', d: "Un formulaire métier capte les demandes 24h/24, même quand vous êtes en intervention." },
            { icon: 'shield-check', t: 'Un site qui dure', d: "Hébergement, maintenance, mises à jour, modifications — 9site4 gère, vous travaillez." },
          ].map((item) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.icon} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 3. Ce que 9site4 structure -->
    <section class="relative px-6 py-16 md:py-24" aria-labelledby="structure-titre">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Notre méthode
          </p>
          <h2 id="structure-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce que 9site4 structure
            <span class="block italic font-medium text-bleu">pour votre activité.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: 'Présentation claire', d: "Qui vous êtes, ce que vous faites, ce qui vous distingue à La Réunion." },
            { n: '02', t: 'Prestations & offres', d: "Vos services structurés, hiérarchisés, lisibles, adaptés à votre métier." },
            { n: '03', t: 'Infos pratiques', d: 'Horaires, adresse, contact direct, WhatsApp, plan, accès.' },
            { n: '04', t: 'Photos & visuels', d: 'Vos vraies photos, votre vraie ambiance, votre vrai cadre.' },
            { n: '05', t: 'Zone et localisation', d: "Communes desservies, périmètre d'intervention, ancrage local." },
            { n: '06', t: 'Module métier intégré', d: 'Réservation, devis, RDV, séjour, commande, inscription — adapté à vous.' },
          ].map((s) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>

        <div class="mt-10 text-center">
          <Button variant="primary" size="md" href="/contact">
            Parler de mon projet
            <Icon name="arrow-right" size={18} strokeWidth={2.25} />
          </Button>
        </div>
      </div>
    </section>

    <!-- 4. Module métier intégré -->
    <section class="relative px-6 py-16 md:py-24" aria-labelledby="modules-titre">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier intégré
          </p>
          <h2 id="modules-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Le bon outil
            <span class="block italic font-medium text-bleu">selon votre métier.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Chaque site 9site4 intègre un module fonctionnel pensé pour votre activité — réservation, demande de devis, prise de rendez-vous, réservation de séjour, commande ou inscription.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'calendar-clock', t: 'Réservation', d: 'Restaurants, snacks, bars, cours, sorties.' },
            { i: 'calendar-check', t: 'Prise de rendez-vous', d: 'Salons, instituts, santé, paramédical, professions libérales.' },
            { i: 'file-text', t: 'Demande de devis', d: "Artisans, BTP, paysagistes, mariages, événementiel." },
            { i: 'wrench', t: 'Intervention', d: 'Dépannage, plomberie, électricité, garages, aide à domicile.' },
            { i: 'globe', t: 'Séjour & location', d: 'Gîtes, locations saisonnières, tourisme, excursions.' },
            { i: 'monitor', t: 'Commande', d: 'Boulangeries, pâtisseries, glaciers, torréfacteurs.' },
          ].map((m) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 5. Nos réalisations liées -->
    <section class="relative px-6 py-16 md:py-24" aria-labelledby="reas-titre">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 id="reas-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Des sites professionnels
            <span class="block italic font-medium text-bleu">pour tous les métiers du 974.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
        <div class="mt-10 text-center">
          <a href="/realisations" class="inline-flex items-center gap-2 text-bleu hover:text-blanc-casse transition-colors font-semibold">
            Voir les 40 réalisations
            <Icon name="arrow-right" size={16} strokeWidth={2.25} />
          </a>
        </div>
      </div>
    </section>

    <!-- 6. Offre -->
    <TarifsBref />

    <!-- 6 bis. Voir aussi nos pages par métier -->
    <section class="relative px-6 py-16 md:py-24" aria-labelledby="metiers-pilier-titre">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Voir aussi
          </p>
          <h2 id="metiers-pilier-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Nos pages
            <span class="block italic font-medium text-bleu">par métier.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Chaque métier a ses besoins propres. Découvrez l'approche 9site4 adaptée à votre secteur.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {[
            { href: '/site-internet-restaurant-la-reunion', t: 'Restaurant', d: 'Restos, snacks, bars, cafés, pizzerias.' },
            { href: '/site-internet-artisan-la-reunion', t: 'Artisan', d: 'Plombiers, électriciens, garages, BTP.' },
            { href: '/site-internet-coiffeur-la-reunion', t: 'Coiffeur', d: 'Salons, coiffeurs, barbiers.' },
            { href: '/site-internet-gite-location-la-reunion', t: 'Gîte & location', d: 'Gîtes, locations, conciergerie, tourisme.' },
            { href: '/site-internet-profession-liberale-la-reunion', t: 'Profession libérale', d: 'Avocats, notaires, comptables, consultants.' },
            { href: '/site-internet-bien-etre-sante-la-reunion', t: 'Bien-être & santé', d: 'Ostéo, naturo, diét, psy, coach, yoga.' },
            { href: '/site-internet-institut-beaute-la-reunion', t: 'Institut, spa & coiffure', d: 'Instituts, spas, salons, tatoueurs, bien-être.' },
            { href: '/site-internet-coach-independant-la-reunion', t: 'Coach & indépendant', d: 'Coachs, consultants, formateurs.' },
            { href: '/site-internet-commerce-local-la-reunion', t: 'Commerce local', d: 'Boutiques, boulangeries, fleuristes.' },
            { href: '/site-internet-tpe-pme-la-reunion', t: 'TPE/PME', d: 'Toutes activités, tous secteurs 974.' },
            { href: '/site-vitrine-la-reunion', t: 'Site vitrine', d: 'Vitrine professionnelle qui convertit.' },
            { href: '/agence-web-la-reunion', t: 'Agence web', d: 'Partenaire web TPE/PME 974.' },
            { href: '/realisations', t: 'Toutes les réalisations', d: '40 sites pour tous les métiers du 974.' },
          ].map((m) => (
            <li>
              <a href={m.href} class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
                <p class="font-sora font-semibold text-blanc-casse">{m.t}</p>
                <p class="mt-2 text-sm text-blanc-casse/65">{m.d}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 7. FAQ -->
    <section class="relative px-6 py-16 md:py-24" aria-labelledby="faq-titre">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 id="faq-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce qu'on nous demande
            <span class="block italic font-medium text-bleu">le plus souvent.</span>
          </h2>
        </div>
        <div class="mt-12">
          <FAQAccordion items={faq} idPrefix="faq-creation" />
        </div>

        <!-- Maillage interne -->
        <p class="scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          <a href="/questions-frequentes" class="text-bleu hover:text-blanc-casse underline-offset-4 hover:underline transition-colors">
            Voir toutes les questions fréquentes →
          </a>
        </p>
        <p class="scroll-reveal mt-4 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/realisations" class="text-bleu hover:underline">réalisations</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a> · <a href="/diagnostic-site-internet-la-reunion" class="text-bleu hover:underline" data-track-event="diagnostic_cta_click" data-track-category="conversion" data-track-source="seo_sector_voir_aussi" data-track-target="/diagnostic-site-internet-la-reunion">diagnostic gratuit</a>.
        </p>
      </div>
    </section>

    <!-- 8. CTA final -->
    <CTABand trackingSource="seo_creation_cta_band" trackingSector="creation" trackingPageType="seo_landing" />
  </div>
</BaseLayout>
