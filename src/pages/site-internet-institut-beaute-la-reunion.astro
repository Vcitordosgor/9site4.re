---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import { getSeo, absoluteUrl, getServiceOffer } from '../lib/seo';

const seo = getSeo('siteInstitutBeauteReunion');

const SLUGS = ['institut-de-beaute', 'spa-massage', 'studio-de-tatouage', 'salon-de-coiffure'];
const selected = SLUGS
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

const faq = [
  {
    q: "Comment présenter mes soins et mes ambiances sur le site ?",
    a: "Chaque soin a sa fiche dédiée : description, durée, prix, bénéfices, contre-indications éventuelles. On met en avant l'ambiance de votre institut avec vos vraies photos — cabines, accueil, produits utilisés — pour rassurer avant la première visite.",
  },
  {
    q: "Puis-je vendre des cartes cadeaux directement sur le site ?",
    a: "Oui. On intègre un système simple de cartes cadeaux : montant libre ou prestations packagées, paiement en ligne ou commande à retirer. C'est un vrai levier de chiffre d'affaires sur les périodes Saint-Valentin, fête des mères, fin d'année.",
  },
  {
    q: "Je suis spa, salon de coiffure ou tatoueur — c'est adapté ?",
    a: "Oui. Cette page couvre instituts de beauté, spas, salons de coiffure, studios de tatouage, esthéticiennes et professionnels du bien-être. Le site valorise votre équipe, votre ambiance détente, votre planning, vos références visuelles et la prise de RDV en ligne — quelle que soit votre spécialité.",
  },
  {
    q: "Mon équipe est composée de plusieurs praticiennes — comment c'est géré ?",
    a: "Chaque membre de l'équipe a sa fiche (photo, spécialités, parcours) et son planning de RDV. Vos clientes peuvent choisir la personne avec qui prendre rendez-vous. C'est utile pour les spas, salons de coiffure et instituts avec plusieurs praticiennes.",
  },
  {
    q: "Combien de temps pour mettre en ligne mon site institut ?",
    a: "Environ 7 jours entre le brief et la mise en ligne. Vous continuez à accueillir vos clientes, 9site4 construit votre site et le maintient ensuite.",
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet pour institut de beauté à La Réunion',
  serviceType: 'Création de site internet — Institut de beauté',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: getServiceOffer(),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Institut · Spa · Coiffure · Tatouage · Bien-être
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Site internet pour institut de beauté{' '}
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 crée des sites professionnels pour instituts de beauté, spas, salons de coiffure, studios de tatouage et professionnels du bien-être à La Réunion : soins, équipe, planning de RDV, ambiance détente, cartes cadeaux et gestion continue.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Pourquoi -->
    <section class="relative px-6 py-14 md:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le besoin
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Votre institut mérite une vitrine{' '}
            <span class="block italic font-medium text-bleu">à la hauteur de vos soins.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Une cliente qui hésite entre trois instituts choisit celui dont le site donne envie. Photos, ambiance, soins clairs, tarifs cohérents — votre site est souvent le premier soin que vous offrez.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'monitor', t: 'Une ambiance détente palpable', d: "Cabines, lumière, parfums, espace spa : vos photos transmettent l'atmosphère du lieu." },
            { i: 'file-text', t: 'Soins et prestations détaillés', d: 'Chaque soin, coupe ou tatouage expliqué : durée, bénéfices, conditions, prix.' },
            { i: 'shield-check', t: 'Équipe et expertises', d: 'Vos praticiennes, coiffeurs et tatoueurs présentés — spécialités, parcours, signature.' },
            { i: 'wand', t: 'Cartes cadeaux', d: "Vente en ligne ou réservation simple — un levier pour vos pics d'activité." },
            { i: 'calendar-check', t: 'Planning de RDV par praticienne', d: "Choix du soin, de la personne et du créneau — sans appel, sans friction." },
            { i: 'calendar-clock', t: 'Gestion continue', d: 'Nouveaux soins, photos, événements : 9site4 met à jour pour vous.' },
          ].map((item) => (
            <li class="rounded-2xl p-6 card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ce que 9site4 structure -->
    <section class="relative px-6 py-14 md:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Ce que 9site4 structure
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un site pensé{' '}
            <span class="block italic font-medium text-bleu">pour vos clientes.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: "Présentation de l'institut", d: "Votre histoire, votre signature, votre approche du soin." },
            { n: '02', t: 'Carte de soins complète', d: "Visage, corps, épilation, manucure, tatouage, soins signature." },
            { n: '03', t: 'Infos pratiques', d: "Adresse, horaires, parking, conditions d'accueil." },
            { n: '04', t: 'Photos ambiance & lieu', d: "Cabines, accueil, équipe — votre vraie identité visuelle." },
            { n: '05', t: 'Cartes cadeaux & promotions', d: 'Bons cadeaux, offres saisonnières, événements ponctuels.' },
            { n: '06', t: 'Module RDV ou demande info', d: "Réservation directe, formulaire de pré-projet ou WhatsApp." },
          ].map((s) => (
            <li class="rounded-2xl p-6 card-dark">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Module métier -->
    <section class="relative px-6 py-14 md:py-20">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Soins, RDV, cartes cadeaux{' '}
            <span class="block italic font-medium text-bleu">tout au bon endroit.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Votre site doit transformer la curiosité en réservation — sans friction, sans appel obligatoire, sans grille tarifaire confuse.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 gap-5">
          {[
            { i: 'calendar-check', t: 'Prise de RDV simple', d: 'Soin, durée, créneau — réservation directe ou demande à valider.' },
            { i: 'wand', t: 'Cartes cadeaux en ligne', d: "Montant libre ou packs prédéfinis, envoyés par email ou à retirer." },
            { i: 'file-text', t: 'Demande sur-mesure', d: "Pour les tatouages ou prestations longues, formulaire dédié avec photos." },
            { i: 'map-pin', t: 'Contact direct', d: 'WhatsApp, téléphone, itinéraire — pour les indécises.' },
          ].map((m) => (
            <li class="rounded-2xl p-6 card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="relative px-6 py-14 md:py-20">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Instituts, spas, studios{' '}
            <span class="block italic font-medium text-bleu">conçus par 9site4.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
      </div>
    </section>

    <TarifsBref />

    <!-- FAQ -->
    <section class="relative px-6 py-14 md:py-20">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce qu'on nous demande{' '}
            <span class="block italic font-medium text-bleu">côté institut.</span>
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-2xl p-5 md:p-6 card-dark">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <span class="font-sora font-semibold text-blanc-casse">{item.q}</span>
                <span class="shrink-0 text-bleu transition-transform duration-300 group-open:rotate-45">
                  <Icon name="arrow-right" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <p class="mt-4 text-sm md:text-base text-blanc-casse/75 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <p class="seo-links-row scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/site-internet-coiffeur-la-reunion" class="text-bleu hover:underline">site pour coiffeur</a>
          ·
          <a href="/site-internet-bien-etre-sante-la-reunion" class="text-bleu hover:underline">site pour praticien bien-être</a>
          ·
          <a href="/creation-site-internet-la-reunion" class="text-bleu hover:underline">création de site à La Réunion</a>
          ·
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/realisations" class="text-bleu hover:underline">réalisations</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a> · <a href="/diagnostic-site-internet-la-reunion" class="text-bleu hover:underline" data-track-event="diagnostic_cta_click" data-track-category="conversion" data-track-source="seo_sector_voir_aussi" data-track-target="/diagnostic-site-internet-la-reunion">diagnostic gratuit</a> · <a href="/methode-9site4" class="text-bleu hover:underline">méthode 9site4</a> · <a href="/questions-frequentes" class="text-bleu hover:underline">questions fréquentes</a> · <a href="/trouver-le-site-adapte" class="text-bleu hover:underline">trouver le site adapté</a>.
        </p>
        <p class="villes-mesh-mention scroll-reveal mt-6 text-center text-xs text-blanc-casse/55">9site4 accompagne aussi les instituts à <a href="/creation-site-internet-saint-paul" class="text-bleu hover:underline">Saint-Paul</a>, <a href="/creation-site-internet-saint-denis" class="text-bleu hover:underline">Saint-Denis</a> et <a href="/creation-site-internet-saint-pierre" class="text-bleu hover:underline">Saint-Pierre</a>.</p>
      </div>
    </section>

    <CTABand trackingSource="seo_sector_cta_band" trackingSector="institut_beaute" trackingPageType="seo_sector_page" />
  </div>
</BaseLayout>
