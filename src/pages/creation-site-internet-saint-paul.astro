---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import VillePageSections from '../components/sections/VillePageSections.astro';
import { getSeo, absoluteUrl } from '../lib/seo';
import { getVille } from '../data/villes.ts';

const seo = getSeo('villeSaintPaul');
const ville = getVille('saint-paul')!;

const raisons = [
  {
    "i": "map-pin",
    "t": "Trouvé sur la côte Ouest",
    "d": "De Saint-Gilles à la Possession, capter une demande locale et touristique forte."
  },
  {
    "i": "monitor",
    "t": "Conçu mobile",
    "d": "Vos visiteurs sont en déplacement, en location, en terrasse — votre site doit suivre."
  },
  {
    "i": "calendar-check",
    "t": "Réservation simple",
    "d": "Gîte, table, soin, séjour : un module clair pour transformer la visite en contact."
  },
  {
    "i": "file-text",
    "t": "Carte & infos à jour",
    "d": "Horaires, tarifs, disponibilités : 9site4 met à jour pour vous."
  },
  {
    "i": "shield-check",
    "t": "Crédibilité locale",
    "d": "Un site sérieux rassure une clientèle exigeante et souvent en comparaison."
  }
];

const faq = [
  { q: "Mon activité à Saint-Paul est saisonnière : un site reste-t-il utile toute l'année ?", a: "Oui, à condition qu'il reste à jour. Gîte, restaurant ou activité de loisirs : le site présente vos disponibilités, vos horaires et vos offres du moment. La gestion continue 9site4 sert exactement à cela — vous signalez le changement, nous l'appliquons." },
  { q: "Vous occupez-vous des gîtes et locations de Saint-Gilles, la Saline ou l'Hermitage ?", a: "Oui. Les hébergements touristiques de la côte Ouest font partie des activités que nous accompagnons : présentation du logement, calendrier, demande de séjour, photos. Tout Saint-Paul (97460) est couvert, du littoral aux Hauts." },
  { q: "Comment se passe le premier échange depuis Saint-Paul ?", a: "Par téléphone ou en visio, environ 30 minutes, sans déplacement. Vous recevez ensuite une proposition écrite claire avant tout engagement." },
  { q: "Une clientèle de passage trouvera-t-elle mon établissement ?", a: "Le site est construit pour les recherches locales et mobiles : informations essentielles visibles immédiatement, itinéraire, contact en un geste. Nous ne garantissons pas de classement Google, mais nous mettons toutes les bonnes pratiques de votre côté." },
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Création de site internet à ${ville.nom}`,
  serviceType: 'Création de site internet',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: {
    '@type': 'Place',
    name: ville.nom,
    address: { '@type': 'PostalAddress', addressLocality: ville.nom, postalCode: ville.code, addressRegion: 'La Réunion', addressCountry: 'FR' },
  },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: { '@type': 'Offer', price: 97.4, priceCurrency: 'EUR', url: 'https://9site4.re/tarifs' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-black text-blanc-casse">
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Création incluse · Module métier · Gestion continue · {ville.microRegion} 974
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Création de site internet à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">(La Réunion).</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 conçoit et gère le site internet des professionnels installés à {ville.nom} ({ville.code}) — TPE/PME, artisans, indépendants. Création incluse, accompagnement local.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Voir nos réalisations</a>
        </div>
      </div>
    </section>

    <VillePageSections ville={ville} variantSeed={1} raisons={raisons} faq={faq} />

    <section class="relative px-6 py-16 md:py-24" aria-labelledby="web-local-titre">
      <div class="mx-auto max-w-3xl">
        <h2 id="web-local-titre" class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Le web à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">vu de la côte Ouest.</span>
        </h2>
        <div class="scroll-reveal mt-8 space-y-5 text-blanc-casse/75 leading-relaxed">
        <p>Saint-Paul est la plus grande commune de l'île en superficie et compte environ 105 000 habitants, répartis de Saint-Gilles à la Possession, du littoral aux Hauts. Son économie est portée par le tourisme balnéaire, les hébergements, la restauration, les commerces de proximité et un fort tissu d'artisans installés dans les quartiers résidentiels.</p>
        <p>Cette dominante touristique change la donne pour votre site : une partie de vos visiteurs ne connaît ni votre enseigne ni votre quartier. Un vacancier qui cherche une table à Saint-Gilles, un gîte à la Saline ou un soin en institut décide en quelques minutes, sur son téléphone. Photos honnêtes, tarifs affichés, moyen de contact immédiat : c'est ce qui transforme une recherche en réservation.</p>
        <p>La saisonnalité compte aussi. Les hébergements et les activités de loisirs de l'Ouest alternent haute et basse saison : le site doit rester juste toute l'année — calendrier de disponibilités, horaires ajustés, offres mises à jour. C'est précisément le rôle de la gestion continue 9site4 : vous signalez le changement, nous l'appliquons.</p>
        <p>Enfin, Saint-Paul ne vit pas que du tourisme. Artisans du bâtiment, commerces de bourg, indépendants et TPE des quartiers résidentiels ont besoin de la même chose que partout ailleurs : être trouvés par les habitants de la commune et des villes voisines, de Saint-Denis à Saint-Louis, avec un site sérieux qui présente prestations, zone d'intervention et prise de contact simple.</p>
        <p>Restauration, hébergement, instituts, artisans, commerces : les secteurs porteurs de Saint-Paul correspondent aux formats de sites que 9site4 pratique au quotidien. Chaque site embarque le module utile à votre activité — calendrier de séjour, réservation de table, prise de rendez-vous ou demande de devis — dans un abonnement unique qui couvre la création, l'hébergement et les modifications, sans facturation à l'acte. Si vous exercez sur la côte Ouest, le premier échange — gratuit et sans engagement — suffit à cadrer ce qu'un site peut réellement changer pour votre activité.</p>
        </div>
      </div>
    </section>

    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Vous êtes professionnel à {ville.nom} ?{' '}
          <span class="block italic font-medium text-bleu">Présentez votre activité à 9site4.</span>
        </h2>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">Démarrer mon projet<Icon name="arrow-right" size={20} strokeWidth={2.25} /></Button>
          <a href="/diagnostic-site-internet-la-reunion" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Diagnostic gratuit</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
