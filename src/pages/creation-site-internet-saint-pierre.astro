---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import VillePageSections from '../components/sections/VillePageSections.astro';
import { getSeo, absoluteUrl, getServiceOffer } from '../lib/seo';
import { getVille } from '../data/villes.ts';

const seo = getSeo('villeSaintPierre');
const ville = getVille('saint-pierre')!;

const raisons = [
  {
    "i": "map-pin",
    "t": "Capital du Sud",
    "d": "Une clientèle qui draine tout le bassin sud — votre site doit y être visible."
  },
  {
    "i": "file-text",
    "t": "Informations claires",
    "d": "Adresse, parking, horaires, prestations : les bonnes infos au bon endroit."
  },
  {
    "i": "calendar-check",
    "t": "Prise de contact rapide",
    "d": "WhatsApp, téléphone, formulaire, RDV — selon votre fonctionnement."
  },
  {
    "i": "monitor",
    "t": "Mobile en priorité",
    "d": "Le centre-ville se découvre depuis le téléphone, votre site aussi."
  },
  {
    "i": "shield-check",
    "t": "Image professionnelle",
    "d": "Cabinet, commerce, restaurant : un site soigné fait la différence."
  }
];

const faq = [
  { q: "Je tiens un commerce ou un restaurant à Saint-Pierre : que doit montrer mon site en priorité ?", a: "L'essentiel d'abord : horaires exacts, adresse, carte ou prestations, moyen de contact immédiat (téléphone, WhatsApp). C'est ce que vérifie un client du bassin sud avant de se déplacer, presque toujours depuis son mobile." },
  { q: "Ma clientèle vient de tout le Sud : le site le reflétera-t-il ?", a: "Oui. Saint-Pierre draine des clients du Tampon, de Saint-Louis ou de Saint-Joseph : le site présente votre zone de chalandise réelle et reste facile à trouver depuis tout le bassin sud." },
  { q: "Faut-il venir dans un bureau pour lancer le projet ?", a: "Non. Un appel ou une visio d'environ 30 minutes suffit pour cadrer votre besoin, suivi d'une proposition écrite. Aucun déplacement n'est nécessaire, à Saint-Pierre comme ailleurs." },
  { q: "Puis-je faire évoluer ma carte ou mes prestations après la mise en ligne ?", a: "Oui, c'est inclus dans la gestion continue : vous envoyez la modification, nous la mettons en ligne. Le site n'est pas figé au jour de la livraison." },
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Création de site internet à ${ville.nom}`,
  serviceType: 'Création de site internet',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: {
    '@type': 'Place',
    name: ville.nom,
    address: { '@type': 'PostalAddress', addressLocality: ville.nom, postalCode: ville.code, addressRegion: 'La Réunion', addressCountry: 'FR' },
  },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: getServiceOffer(),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-black text-blanc-casse">
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Création incluse · Module métier · Gestion continue · {ville.microRegion} 974
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Création de site internet à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">(La Réunion).</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 conçoit et gère le site internet des professionnels installés à {ville.nom} ({ville.code}) — TPE/PME, artisans, indépendants. Création incluse, accompagnement local.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Voir nos réalisations</a>
        </div>
      </div>
    </section>

    <VillePageSections ville={ville} variantSeed={2} raisons={raisons} faq={faq} />

    <section class="relative px-6 py-[3rem] md:py-[4.5rem]" aria-labelledby="web-local-titre">
      <div class="mx-auto max-w-3xl">
        <h2 id="web-local-titre" class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Le web à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">vu de la capitale du Sud.</span>
        </h2>
        <div class="scroll-reveal mt-8 space-y-5 text-blanc-casse/75 leading-relaxed">
        <p>Sous-préfecture d'environ 85 000 habitants, Saint-Pierre joue le rôle de capitale économique du Sud. Centre-ville commerçant, front de mer animé, marché forain, restauration dense et services aux professionnels : l'activité y draine une clientèle qui dépasse largement la commune, du Tampon à Saint-Joseph en passant par Saint-Louis.</p>
        <p>Pour un commerce ou un restaurant saint-pierrois, cette densité est une chance et une contrainte : le client a le choix. Avant de se déplacer, il vérifie en ligne les horaires, la carte, les avis, l'adresse exacte. Un site absent ou obsolète, et c'est l'établissement d'à côté qui récupère la visite. Un site précis et à jour, et vous partez avec un coup d'avance.</p>
        <p>Les professions libérales et les services aux entreprises du bassin sud ont un enjeu différent : inspirer confiance avant le premier rendez-vous. Une présentation claire du cabinet, des domaines d'intervention et un moyen de prise de contact simple font souvent la différence entre deux structures équivalentes.</p>
        <p>9site4 conçoit pour les professionnels de Saint-Pierre (97410) des sites structurés autour de leur métier : carte et réservation pour la restauration, prestations et devis pour les services, rendez-vous pour les soins. Le tout géré dans la durée, avec des mises à jour incluses, pour que le site reste le reflet exact de votre activité.</p>
        <p>Saint-Pierre est aussi une ville de rendez-vous : coiffeurs, instituts, praticiens du bien-être, coachs et consultants y sont nombreux. Pour ces activités, le site 9site4 intègre un module de prise de rendez-vous ou de premier contact adapté, en plus de la présentation de vos prestations. La formule reste la même pour tous : abonnement unique, création incluse, gestion continue et mises à jour comprises. Un doute sur l'intérêt d'un site pour votre activité saint-pierroise ? Le premier échange est gratuit et permet d'y répondre franchement, sans discours commercial.</p>
        </div>
      </div>
    </section>

    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Vous êtes professionnel à {ville.nom} ?{' '}
          <span class="block italic font-medium text-bleu">Présentez votre activité à 9site4.</span>
        </h2>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">Démarrer mon projet<Icon name="arrow-right" size={20} strokeWidth={2.25} /></Button>
          <a href="/diagnostic-site-internet-la-reunion" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Diagnostic gratuit</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
