---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import { getSeo, absoluteUrl } from '../lib/seo';

const seo = getSeo('siteGiteLocationReunion');

const SLUGS = [
  'gite-de-montagne',
  'location-saisonniere-bord-de-mer',
  'conciergerie',
  'excursions-randonnee',
  'plongee',
  'ecole-de-surf',
];
const selected = SLUGS
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

const faq = [
  {
    q: 'Mon gîte est déjà sur Airbnb / Booking — j\'ai vraiment besoin d\'un site ?',
    a: "Oui. Un site propre vous rend trouvable directement sur Google (« gîte Cilaos », « location Saint-Leu »), évite les commissions des plateformes pour les clients récurrents, et renforce la crédibilité de votre activité auprès des CSE, professionnels et voyageurs exigeants.",
  },
  {
    q: 'Vous gérez le calendrier des disponibilités ?',
    a: "Oui. On affiche un calendrier clair (mois par mois ou widget) que vous mettez à jour vous-même, ou on synchronise avec votre iCal Airbnb/Booking pour que tout se mette à jour automatiquement.",
  },
  {
    q: 'Je suis conciergerie — j\'ai plusieurs biens à gérer. C\'est possible ?',
    a: "Bien sûr. On structure votre site avec un catalogue de logements (1 fiche par bien : photos, description, capacité, équipements, prix indicatifs) et un formulaire de demande qui qualifie le besoin (dates, voyageurs, type de bien).",
  },
  {
    q: 'Et pour les guides, excursions, plongée, surf ?',
    a: "Même approche : présentation du parcours, des formules (baptême, sortie demi-journée, stage), du matériel, de la sécurité, et un formulaire de réservation par date avec confirmation directe par mail ou WhatsApp.",
  },
  {
    q: 'Combien de temps avant la mise en ligne ?',
    a: "Environ 7 jours entre le brief et la mise en ligne. Vous accueillez vos voyageurs, on construit votre site.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet pour gîte et location saisonnière à La Réunion',
  serviceType: 'Création de site internet — Hébergement & tourisme',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: { '@type': 'Offer', price: 97.4, priceCurrency: 'EUR', url: 'https://9site4.re/tarifs' },
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Gîtes · Locations · Conciergeries · Tourisme
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Site internet pour gîte et location saisonnière
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 crée des sites professionnels pour gîtes, locations saisonnières, conciergeries et hébergements touristiques à La Réunion : présentation, calendrier, demande de séjour.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Pourquoi -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le besoin
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un hébergement touristique
            <span class="block italic font-medium text-bleu">vend une expérience avant un logement.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Les voyageurs comparent, s'imaginent sur place, vérifient les équipements, la vue, la distance des sites incontournables. Un site propre, complet et rassurant transforme une visite Google en réservation directe — sans commission de plateforme.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'monitor', t: 'Photos du logement', d: "Pièces, vue, terrasse, piscine, environnement — l'expérience commence ici." },
            { i: 'file-text', t: 'Description précise', d: 'Capacité, équipements, services inclus, règles maison.' },
            { i: 'calendar-clock', t: 'Calendrier de disponibilités', d: "Le voyageur voit s'il peut venir avant de demander." },
            { i: 'map-pin', t: 'Localisation & alentours', d: "Cirque, lagon, randos, restos, plages — situez votre offre." },
            { i: 'calendar-check', t: 'Demande de séjour', d: "Dates, voyageurs, message — vous répondez avec un devis personnalisé." },
            { i: 'shield-check', t: 'Avis & confiance', d: 'Témoignages, classement gîte de France, label, photos clients.' },
          ].map((item) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ce que 9site4 structure -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Ce que 9site4 structure
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Tout ce dont
            <span class="block italic font-medium text-bleu">votre hébergement a besoin.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: 'Présentation du lieu', d: "Histoire, parti-pris, vue, ambiance, ce qui rend votre hébergement unique." },
            { n: '02', t: 'Logement(s) & équipements', d: "Chambres, capacité, cuisine, piscine, équipements inclus, services optionnels." },
            { n: '03', t: 'Calendrier & tarifs', d: 'Disponibilités, basse/haute saison, séjour minimum, taxes.' },
            { n: '04', t: 'Galerie photos', d: "Logement, vue, alentours, alentours — vraies photos, vraie ambiance." },
            { n: '05', t: 'Module demande de séjour', d: 'Dates, voyageurs, demandes spéciales — vous répondez avec un devis.' },
            { n: '06', t: 'Infos pratiques', d: "Accès, check-in, voiture, randos proches, contact direct." },
          ].map((s) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Module métier -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Demande de séjour, calendrier, contact —
            <span class="block italic font-medium text-bleu">selon votre flux.</span>
          </h2>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 gap-5">
          {[
            { i: 'calendar-check', t: 'Demande de séjour qualifiée', d: 'Dates, nombre de voyageurs, type de chambre, message — vous répondez avec un devis personnalisé.' },
            { i: 'calendar-clock', t: 'Calendrier synchronisé', d: "Disponibilités à jour via iCal Airbnb/Booking, ou édition manuelle simple." },
            { i: 'map-pin', t: 'Contact direct', d: 'WhatsApp, mail, téléphone — pour les voyageurs qui veulent échanger avant de réserver.' },
            { i: 'monitor', t: 'Catalogue multi-biens', d: "Pour les conciergeries : 1 fiche par logement, recherche par dates et capacité." },
          ].map((m) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Gîtes, locations, guides, plongée
            <span class="block italic font-medium text-bleu">conçus par 9site4.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
      </div>
    </section>

    <TarifsBref />

    <!-- FAQ -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce qu'on nous demande
            <span class="block italic font-medium text-bleu">côté hébergement & tourisme.</span>
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-2xl p-5 md:p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <span class="font-sora font-semibold text-blanc-casse">{item.q}</span>
                <span class="shrink-0 text-bleu transition-transform duration-300 group-open:rotate-45">
                  <Icon name="arrow-right" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <p class="mt-4 text-sm md:text-base text-blanc-casse/75 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <p class="scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/site-internet-restaurant-la-reunion" class="text-bleu hover:underline">site pour restaurant</a>
          ·
          <a href="/site-internet-artisan-la-reunion" class="text-bleu hover:underline">site pour artisan</a>
          ·
          <a href="/creation-site-internet-la-reunion" class="text-bleu hover:underline">création de site à La Réunion</a>
          ·
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a>.
        </p>
      </div>
    </section>

    <CTABand />
  </div>
</BaseLayout>
