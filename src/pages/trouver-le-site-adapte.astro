---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteRecommender from '../components/sections/SiteRecommender.tsx';
import siteConfig from '../data/siteConfig.json';
import { getSeo, absoluteUrl } from '../lib/seo';

const seo = getSeo('trouverSiteAdapte');

const badges = ['Gratuit', 'Rapide', 'Sans engagement', 'Adapté aux pros réunionnais'];

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: seo.title,
  description: seo.description,
  url: absoluteUrl(seo.canonical),
  inLanguage: 'fr-RE',
  isPartOf: { '@id': `${siteConfig.siteUrl}/#website` },
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Recommandation de site internet adapté',
  serviceType: 'Recommandation et conseil pour création de site internet',
  provider: {
    '@type': 'Organization',
    name: siteConfig.siteName,
    url: siteConfig.siteUrl,
  },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  description:
    "Outil interactif gratuit de 9site4 permettant d'identifier le type de site internet professionnel adapté à votre activité à La Réunion.",
  url: absoluteUrl('/trouver-le-site-adapte'),
  offers: {
    '@type': 'Offer',
    name: 'Recommandation gratuite',
    price: '0',
    priceCurrency: 'EUR',
    availability: 'https://schema.org/InStock',
  },
};
---

<BaseLayout seo={seo}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  </Fragment>

  <div class="bg-black text-blanc-casse">
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-20">
      <div class="pointer-events-none absolute -top-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-bleu/20 blur-3xl opacity-60" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 w-[24rem] h-[24rem] rounded-full bg-bleu/15 blur-3xl opacity-40" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu/15 ring-1 ring-bleu/30 text-bleu text-[11px] font-semibold uppercase tracking-[0.28em]">
          <span class="block w-1.5 h-1.5 rounded-full bg-bleu animate-pulse"></span>
          Outil interactif
        </p>
        <span class="block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="mt-5 font-sora font-bold text-balance leading-[1.05] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Trouvez le site adapté{' '}
          <span class="block italic font-medium text-bleu">à votre activité.</span>
        </h1>
        <p class="mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/75 leading-relaxed">
          Sept questions courtes pour identifier le type de site, le module métier et la structure adaptés à votre activité à La Réunion. Vous recevez une recommandation claire, des exemples concrets et la possibilité d'échanger avec notre équipe.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="#recommender"
            class="inline-flex items-center justify-center h-14 px-8 text-base font-semibold rounded-full bg-blanc-casse text-bleu-nuit hover:bg-white hover:-translate-y-0.5 shadow-card hover:shadow-card-hover transition-all"
            data-track-event="site_recommender_cta_click"
            data-track-category="engagement"
            data-track-source="trouver_site_hero"
            data-track-target="#recommender"
            data-track-page-type="trouver_site_adapte"
          >
            Commencer le parcours
          </a>
          <a
            href="/realisations"
            class="inline-flex items-center justify-center h-14 px-7 text-base font-semibold rounded-full ring-1 ring-blanc-casse/40 text-blanc-casse hover:bg-white/10 hover:-translate-y-0.5 transition-all"
            data-track-event="cta_view_realisations_click"
            data-track-category="navigation"
            data-track-source="trouver_site_hero"
            data-track-target="/realisations"
            data-track-page-type="trouver_site_adapte"
          >
            Voir nos réalisations
          </a>
        </div>

        <div class="mt-9 flex flex-wrap justify-center gap-2.5">
          {badges.map((b) => (
            <span class="inline-flex items-center gap-2 h-9 px-4 rounded-full bg-white/[0.08] ring-1 ring-white/15 text-xs font-medium text-blanc-casse">
              <span class="block w-1.5 h-1.5 rounded-full bg-bleu" aria-hidden="true"></span>
              {b}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section id="recommender" class="relative px-6 py-[3rem] md:py-[4.5rem] scroll-mt-24 bg-blanc-casse text-bleu-nuit">
      <div class="relative mx-auto max-w-3xl">
        <SiteRecommender client:load />
      </div>
    </section>

    <section class="relative px-6 py-[3rem] md:py-[4.5rem]" aria-labelledby="liens-titre">
      <div class="relative mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
          <span class="w-2 h-2 rounded-full bg-bleu"></span> Pour aller plus loin
        </p>
        <h2 id="liens-titre" class="mt-6 font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.1]">
          Explorer 9site4{' '}
          <span class="block italic font-medium text-bleu">à votre rythme.</span>
        </h2>
        <ul class="mt-10 grid sm:grid-cols-2 gap-3 text-left">
          <li>
            <a href="/realisations" class="block rounded-2xl px-5 py-4 ring-1 ring-white/15 hover:ring-bleu hover:bg-white/[0.06] transition-colors">
              <p class="font-sora font-semibold text-base text-blanc-casse">Nos réalisations</p>
              <p class="mt-1 text-sm text-blanc-casse/70">Sites professionnels conçus pour les TPE/PME réunionnaises.</p>
            </a>
          </li>
          <li>
            <a href="/diagnostic-site-internet-la-reunion" class="block rounded-2xl px-5 py-4 ring-1 ring-white/15 hover:ring-bleu hover:bg-white/[0.06] transition-colors">
              <p class="font-sora font-semibold text-base text-blanc-casse">Diagnostic gratuit</p>
              <p class="mt-1 text-sm text-blanc-casse/70">Un retour clair sur votre présence web actuelle.</p>
            </a>
          </li>
          <li>
            <a href="/tarifs" class="block rounded-2xl px-5 py-4 ring-1 ring-white/15 hover:ring-bleu hover:bg-white/[0.06] transition-colors">
              <p class="font-sora font-semibold text-base text-blanc-casse">Tarifs</p>
              <p class="mt-1 text-sm text-blanc-casse/70">Une formule claire à 97,4€/mois tout inclus.</p>
            </a>
          </li>
          <li>
            <a href="/creation-site-internet-la-reunion" class="block rounded-2xl px-5 py-4 ring-1 ring-white/15 hover:ring-bleu hover:bg-white/[0.06] transition-colors">
              <p class="font-sora font-semibold text-base text-blanc-casse">Création de site</p>
              <p class="mt-1 text-sm text-blanc-casse/70">Notre méthode pour les pros réunionnais.</p>
            </a>
          </li>
        </ul>
        <p class="mt-8 text-sm text-blanc-casse/70">
          Une question particulière ? <a href="/contact" class="text-bleu hover:underline">Contactez-nous directement</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
