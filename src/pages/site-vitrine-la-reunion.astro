---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import { getSeo, absoluteUrl } from '../lib/seo';

const seo = getSeo('siteVitrineReunion');

const SLUGS = ['restaurant-gastronomique', 'salon-de-coiffure', 'plomberie', 'cabinet-osteopathie', 'gite-de-montagne', 'architecte'];
const selected = SLUGS
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

const faq = [
  {
    q: "C'est quoi exactement un site vitrine ?",
    a: "Un site vitrine présente votre activité, vos prestations, vos infos pratiques et facilite la prise de contact — sans gestion de catalogue produits, paniers ni paiement. C'est l'outil le plus efficace pour 90% des TPE/PME réunionnaises.",
  },
  {
    q: "Un site vitrine, ça reste utile en 2026 ?",
    a: "Plus que jamais. Vos clients vérifient toujours en ligne avant de pousser la porte, appeler ou prendre RDV. Un site vitrine bien structuré reste votre meilleur ambassadeur 24/7 — surtout couplé à votre fiche Google.",
  },
  {
    q: "Vous faites uniquement du vitrine, ou aussi du e-commerce ?",
    a: "9site4 est spécialiste du site professionnel pour TPE/PME : vitrine + module métier intégré (réservation, devis, RDV, séjour, demande info). Pour les boutiques en ligne complexes, on oriente vers d'autres acteurs ou on intègre une solution simple si pertinent.",
  },
  {
    q: "Combien de pages dans un site vitrine 9site4 ?",
    a: "Autant qu'il en faut pour structurer votre activité — généralement 5 à 10 sections sur une page longue ou plusieurs pages dédiées. La structure est pensée pour votre métier, pas figée dans un nombre.",
  },
  {
    q: "Est-ce qu'un site vitrine peut générer du chiffre d'affaires ?",
    a: "Oui — indirectement mais massivement. Demande de devis, prise de RDV, réservation, contact WhatsApp, appel téléphonique : ce sont des conversions que le site rend possibles 24h/24. Beaucoup de TPE/PME doublent leurs demandes entrantes après une refonte propre.",
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site vitrine à La Réunion',
  serviceType: 'Création de site vitrine',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: { '@type': 'Offer', price: 97.4, priceCurrency: 'EUR', url: 'https://9site4.re/tarifs' },
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Sites vitrines professionnels · 974
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Site vitrine
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 crée et gère des sites vitrines professionnels à La Réunion pour présenter votre activité, vos prestations, vos informations pratiques et faciliter la prise de contact.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Pourquoi -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le besoin
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un site vitrine bien fait
            <span class="block italic font-medium text-bleu">va beaucoup plus loin qu'une simple présentation.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Trop de sites vitrines à La Réunion se contentent de quelques pages génériques. Un site 9site4 structure votre activité, rassure vos visiteurs et organise les demandes entrantes — c'est ce qui fait la différence.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'monitor', t: 'Présence professionnelle', d: "Un site qui valide votre sérieux dès la première seconde." },
            { i: 'file-text', t: 'Activité structurée', d: 'Vos prestations hiérarchisées, lisibles, pertinentes.' },
            { i: 'shield-check', t: 'Rassurer le visiteur', d: "Photos vraies, ton professionnel, infos cohérentes." },
            { i: 'wand', t: 'Facilite le contact', d: "Formulaire, WhatsApp, téléphone — toujours à un clic." },
            { i: 'map-pin', t: 'Ancrage local', d: "Communes, zone, références 974 — visible pour la recherche locale." },
            { i: 'calendar-clock', t: 'Gestion continue', d: "9site4 met à jour sans surcoût — votre site reste vivant." },
          ].map((item) => (
            <li class="rounded-2xl p-6"
              class="card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ce que 9site4 structure -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Ce que 9site4 structure
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Tout ce dont
            <span class="block italic font-medium text-bleu">un site vitrine a besoin.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: 'Présentation activité', d: "Histoire, valeurs, ce qui vous distingue dans le 974." },
            { n: '02', t: 'Prestations & offres', d: "Vos services hiérarchisés, lisibles, accompagnés des bons CTA." },
            { n: '03', t: 'Infos pratiques', d: 'Adresse, horaires, contact, WhatsApp, plan.' },
            { n: '04', t: 'Photos & ambiance', d: 'Votre vrai cadre, votre vraie équipe, votre vraie identité.' },
            { n: '05', t: 'Zone et accessibilité', d: 'Communes desservies, ancrage local, points de repère.' },
            { n: '06', t: 'Module métier + contact', d: 'Le bon outil pour transformer la visite en conversation.' },
          ].map((s) => (
            <li class="rounded-2xl p-6"
              class="card-dark">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Module métier -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Pas qu'une vitrine —
            <span class="block italic font-medium text-bleu">une vitrine qui convertit.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Un vrai site vitrine n'est pas passif. Chaque section conduit le visiteur vers une action concrète — appeler, écrire, réserver, demander.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 gap-5">
          {[
            { i: 'wand', t: 'WhatsApp & téléphone', d: 'Toujours accessibles, jamais cachés en bas de page.' },
            { i: 'file-text', t: 'Formulaire intelligent', d: "Adapté à votre activité : devis, info, RDV, séjour." },
            { i: 'calendar-check', t: 'Prise de RDV / réservation', d: "Intégrée ou liée à votre outil existant (Planity, Calendly…)." },
            { i: 'map-pin', t: 'Itinéraire & accès', d: 'Plan, lien direct, accessibilité — fluidifier la venue.' },
          ].map((m) => (
            <li class="rounded-2xl p-6"
              class="card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Des sites vitrines
            <span class="block italic font-medium text-bleu">pour tous les métiers.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
      </div>
    </section>

    <TarifsBref />

    <!-- FAQ -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce qu'on nous demande
            <span class="block italic font-medium text-bleu">sur les sites vitrines.</span>
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-2xl p-5 md:p-6"
              class="card-dark">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <span class="font-sora font-semibold text-blanc-casse">{item.q}</span>
                <span class="shrink-0 text-bleu transition-transform duration-300 group-open:rotate-45">
                  <Icon name="arrow-right" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <p class="mt-4 text-sm md:text-base text-blanc-casse/75 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <p class="scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/agence-web-la-reunion" class="text-bleu hover:underline">agence web</a>
          ·
          <a href="/site-internet-tpe-pme-la-reunion" class="text-bleu hover:underline">site pour TPE/PME</a>
          ·
          <a href="/creation-site-internet-la-reunion" class="text-bleu hover:underline">création de site à La Réunion</a>
          ·
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/realisations" class="text-bleu hover:underline">réalisations</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a> · <a href="/diagnostic-site-internet-la-reunion" class="text-bleu hover:underline" data-track-event="diagnostic_cta_click" data-track-category="conversion" data-track-source="seo_sector_voir_aussi" data-track-target="/diagnostic-site-internet-la-reunion">diagnostic gratuit</a> · <a href="/methode-9site4" class="text-bleu hover:underline">méthode 9site4</a> · <a href="/questions-frequentes" class="text-bleu hover:underline">questions fréquentes</a> · <a href="/trouver-le-site-adapte" class="text-bleu hover:underline">trouver le site adapté</a>.
        </p>
      </div>
    </section>

    <CTABand trackingSource="seo_vitrine_cta_band" trackingSector="vitrine" trackingPageType="seo_landing" />
  </div>
</BaseLayout>
