---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import { getSeo, absoluteUrl, getServiceOffer } from '../lib/seo';

const seo = getSeo('siteCommerceLocalReunion');

const SLUGS = ['boulangerie-artisanale', 'glacier-artisanal', 'garage-mecanique', 'cafe-torrefaction', 'fleuriste-atelier', 'patisserie-creole'];
const selected = SLUGS
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

const faq = [
  {
    q: "Mon commerce n'a pas besoin de vendre en ligne, un site est-il utile ?",
    a: "Énormément. Avant de pousser la porte, vos futurs clients vérifient sur Google : horaires, produits, photos, accès, avis. Un site clair transforme la curiosité en visite. Pas besoin de e-commerce — un vrai site vitrine fait souvent gagner plus qu'une boutique en ligne mal entretenue.",
  },
  {
    q: "Vous gérez la mise à jour des horaires et produits ?",
    a: "Oui. Vous nous écrivez en WhatsApp ou par email les changements (horaire d'été, nouveau produit, fermeture exceptionnelle), on s'en occupe. C'est inclus dans la formule à 97,4€/mois.",
  },
  {
    q: "Et la fiche Google de mon commerce ?",
    a: "On vous aide à structurer l'information du site pour qu'elle alimente votre fiche Google : adresse, horaires, photos, lien — pour que les recherches locales vous trouvent en premier.",
  },
  {
    q: "Puis-je recevoir des commandes par WhatsApp depuis le site ?",
    a: "Oui. On intègre un bouton WhatsApp visible avec un message pré-rempli (commande, demande d'info) — votre canal de discussion existant devient le moteur du site.",
  },
  {
    q: "Combien de temps avant la mise en ligne ?",
    a: "Environ 7 jours entre le brief et la mise en ligne. Vous continuez à servir, on construit votre site.",
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet pour commerce local à La Réunion',
  serviceType: 'Création de site internet — Commerce local',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: getServiceOffer(),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Boutiques · Commerces de proximité · Services locaux
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Site internet pour commerce local{' '}
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 crée des sites professionnels pour commerces locaux à La Réunion : présentation de l'activité, horaires, produits, contact, demandes d'information et gestion continue.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Pourquoi -->
    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le besoin
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un commerce local{' '}
            <span class="block italic font-medium text-bleu">vit aussi sur Google.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Boulangerie, fleuriste, garage, glacier, épicerie : votre clientèle de quartier vérifie en ligne avant de venir. Sans site clair, vous perdez le client qui se demandait simplement "ouvert ce dimanche ?".
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'monitor', t: 'Votre commerce en image', d: "Vitrine, produits, équipe : vos vraies photos donnent envie de pousser la porte." },
            { i: 'calendar-clock', t: 'Horaires toujours à jour', d: 'Été, hiver, jours fériés, fermetures exceptionnelles — tenus à jour pour vous.' },
            { i: 'file-text', t: 'Produits & services', d: 'Ce que vous proposez, en clair, avec les nouveautés mises en avant.' },
            { i: 'map-pin', t: 'Localisation & accès', d: "Plan, parking, transports, point de repère — facilitez la première venue." },
            { i: 'shield-check', t: 'Confiance avant achat', d: "Histoire du commerce, savoir-faire, valeurs : rassurez avant l'entrée." },
            { i: 'wand', t: 'Contact WhatsApp', d: 'Le canal préféré des Réunionnais — directement depuis votre site.' },
          ].map((item) => (
            <li class="rounded-2xl p-6 card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ce que 9site4 structure -->
    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Ce que 9site4 structure
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un site pratique{' '}
            <span class="block italic font-medium text-bleu">pour votre clientèle locale.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: 'Présentation du commerce', d: "Histoire, savoir-faire, parti-pris, ce qui vous distingue." },
            { n: '02', t: 'Produits ou services', d: "Catalogue clair avec photos, prix éventuels, nouveautés." },
            { n: '03', t: 'Infos pratiques visibles', d: "Adresse, horaires, téléphone, WhatsApp, plan, parking." },
            { n: '04', t: 'Photos du lieu et équipe', d: "Vraies photos — votre vitrine, vos produits, votre équipe." },
            { n: '05', t: 'Zone et accessibilité', d: "Commune, quartier, accès véhicule et piéton." },
            { n: '06', t: 'Module contact / demande', d: 'Formulaire info, devis simple, WhatsApp, email.' },
          ].map((s) => (
            <li class="rounded-2xl p-6 card-dark">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Module métier -->
    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Le bon contact{' '}
            <span class="block italic font-medium text-bleu">au bon moment.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Pas de panier, pas de paiement compliqué — juste les bons moyens pour que le client vous joigne, commande, vienne.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 gap-5">
          {[
            { i: 'wand', t: 'WhatsApp en un clic', d: 'Message pré-rempli, votre canal réel devient le moteur du site.' },
            { i: 'file-text', t: 'Demande info / devis', d: "Formulaire simple pour les demandes plus longues (mariage, événement, commande spéciale)." },
            { i: 'map-pin', t: 'Itinéraire direct', d: 'Plan intégré, lien Google Maps, point de repère explicite.' },
            { i: 'calendar-clock', t: 'Horaires à jour', d: "Vous nous écrivez les changements, on met à jour dans la journée." },
          ].map((m) => (
            <li class="rounded-2xl p-6 card-dark">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Boulangeries, fleuristes, garages{' '}
            <span class="block italic font-medium text-bleu">conçus par 9site4.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
      </div>
    </section>

    <TarifsBref />

    <!-- FAQ -->
    <section class="relative px-6 py-[3rem] md:py-[4.5rem]">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Ce qu'on nous demande{' '}
            <span class="block italic font-medium text-bleu">côté commerce.</span>
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-2xl p-5 md:p-6 card-dark">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <span class="font-sora font-semibold text-blanc-casse">{item.q}</span>
                <span class="shrink-0 text-bleu transition-transform duration-300 group-open:rotate-45">
                  <Icon name="arrow-right" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <p class="mt-4 text-sm md:text-base text-blanc-casse/75 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <p class="seo-links-row scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/site-internet-restaurant-la-reunion" class="text-bleu hover:underline">site pour restaurant</a>
          ·
          <a href="/site-internet-artisan-la-reunion" class="text-bleu hover:underline">site pour artisan</a>
          ·
          <a href="/site-internet-tpe-pme-la-reunion" class="text-bleu hover:underline">site pour TPE/PME</a>
          ·
          <a href="/creation-site-internet-la-reunion" class="text-bleu hover:underline">création de site à La Réunion</a>
          ·
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a> · <a href="/diagnostic-site-internet-la-reunion" class="text-bleu hover:underline" data-track-event="diagnostic_cta_click" data-track-category="conversion" data-track-source="seo_sector_voir_aussi" data-track-target="/diagnostic-site-internet-la-reunion">diagnostic gratuit</a> · <a href="/methode-9site4" class="text-bleu hover:underline">méthode 9site4</a> · <a href="/questions-frequentes" class="text-bleu hover:underline">questions fréquentes</a> · <a href="/trouver-le-site-adapte" class="text-bleu hover:underline">trouver le site adapté</a>.
        </p>
        <p class="villes-mesh-mention scroll-reveal mt-6 text-center text-xs text-blanc-casse/55">9site4 accompagne aussi les commerces locaux à <a href="/creation-site-internet-saint-louis" class="text-bleu hover:underline">Saint-Louis</a>, <a href="/creation-site-internet-saint-andre" class="text-bleu hover:underline">Saint-André</a> et <a href="/creation-site-internet-le-tampon" class="text-bleu hover:underline">Le Tampon</a>.</p>
      </div>
    </section>

    <CTABand trackingSource="seo_sector_cta_band" trackingSector="commerce_local" trackingPageType="seo_sector_page" />
  </div>
</BaseLayout>
