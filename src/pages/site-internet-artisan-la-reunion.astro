---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import TarifsBref from '../components/sections/TarifsBref.astro';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import { getSeo, absoluteUrl } from '../lib/seo';

const seo = getSeo('siteArtisanReunion');

// Mix artisans + garages
const selectedSlugs = [
  'plomberie',
  'electricite-generale',
  'paysagiste',
  'garage-mecanique',
  'aide-a-domicile',
  'architecte',
];
const selected = selectedSlugs
  .map((s) => realisations.find((r) => r.slug === s))
  .filter(Boolean) as typeof realisations;

const faq = [
  {
    q: "Je suis artisan seul — un site, ça vaut vraiment le coup ?",
    a: "Oui, surtout en solo. Un site bien structuré joue le rôle de premier filtre : il qualifie les demandes (zone, prestation, urgence), évite les appels hors-zone et donne une vraie crédibilité face à des concurrents déjà en ligne.",
  },
  {
    q: "Comment fonctionne le module de demande de devis ?",
    a: "Le formulaire est adapté à votre activité : type d'intervention, localisation, urgence, contact. Vous recevez la demande par mail (ou WhatsApp si vous préférez) avec toutes les infos utiles pour rappeler.",
  },
  {
    q: "Vous gérez aussi les garages, paysagistes, BTP, aide à domicile ?",
    a: "Oui. La page couvre l'ensemble des métiers techniques et de service à La Réunion : plombier, électricien, paysagiste, garage, BTP, multi-services, aide à domicile, conciergerie.",
  },
  {
    q: "Je peux préciser ma zone d'intervention (Sud, Nord, Ouest, Est) ?",
    a: "Oui. La zone d'intervention est mise en avant clairement (communes, micro-régions, rayon) — ça réduit les contacts inutiles et améliore votre référencement local sur Google.",
  },
  {
    q: "Et si je change mes tarifs ou que j'ajoute une prestation ?",
    a: "Vous nous écrivez, on met à jour. La gestion continue est incluse dans la formule : modifications simples (prestations, tarifs, photos, zones, horaires) prises en charge par 9site4.",
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Création de site internet pour artisan à La Réunion',
  serviceType: 'Création de site internet — Artisanat & BTP',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: { '@type': 'AdministrativeArea', name: 'La Réunion' },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: { '@type': 'Offer', price: 97.4, priceCurrency: 'EUR', url: 'https://9site4.re/tarifs' },
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

  <div class="bg-black text-blanc-casse">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Artisans · BTP · Garages · Services
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Site internet pour artisan
          <span class="block italic font-medium text-bleu">à La Réunion.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 crée des sites professionnels pour artisans et entreprises locales à La Réunion : prestations, zones d'intervention, demande de devis, photos et gestion continue.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site avec 9site4
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">
            Voir nos réalisations
          </a>
        </div>
      </div>
    </section>

    <!-- Pourquoi -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Le besoin
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Un artisan a besoin d'un site
            <span class="block italic font-medium text-bleu">qui qualifie ses demandes.</span>
          </h2>
          <p class="scroll-reveal mt-6 text-base md:text-lg text-blanc-casse/70 leading-relaxed">
            Les clients du 974 cherchent un pro de confiance, proche de chez eux, qui répond clairement à leur besoin. Sans site, vous laissez la place à la concurrence — et vous perdez du temps avec des appels hors-zone ou hors-périmètre.
          </p>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'wrench', t: 'Vos prestations détaillées', d: "Ce que vous faites, ce que vous ne faites pas — clairement listé." },
            { i: 'map-pin', t: "Zone d'intervention", d: "Sud, Nord, Ouest, Est, communes précises — fini les déplacements inutiles." },
            { i: 'file-text', t: 'Demande de devis claire', d: "Formulaire structuré : nature, urgence, contact. Vous rappelez avec les bonnes infos." },
            { i: 'monitor', t: 'Photos de chantiers', d: "Vos réalisations rassurent autant qu'un avis client." },
            { i: 'shield-check', t: 'Confiance & sérieux', d: "SIRET, assurance, qualifications, ancienneté — affichés proprement." },
            { i: 'calendar-clock', t: 'Disponibilités', d: "Délais, urgences, horaires : les clients savent à quoi s'attendre." },
          ].map((item) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={item.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{item.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{item.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Ce que 9site4 structure -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Ce que 9site4 structure
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Tout ce qu'il faut pour
            <span class="block italic font-medium text-bleu">vendre votre savoir-faire.</span>
          </h2>
        </div>

        <ol class="scroll-reveal mt-12 grid md:grid-cols-2 gap-5">
          {[
            { n: '01', t: 'Présentation de l\'entreprise', d: "Métier, ancienneté, équipe, valeurs, certifications." },
            { n: '02', t: 'Prestations détaillées', d: "Liste structurée des interventions, dépannages, services." },
            { n: '03', t: 'Zone d\'intervention', d: 'Carte ou liste des communes desservies à La Réunion.' },
            { n: '04', t: 'Photos de chantiers', d: 'Réalisations terminées — la preuve par l\'image.' },
            { n: '05', t: 'Module métier intégré', d: 'Demande de devis ou prise de contact rapide.' },
            { n: '06', t: 'Confiance & contact', d: 'SIRET, assurance, téléphone, WhatsApp, mail.' },
          ].map((s) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <p class="font-roboto-mono text-bleu text-sm font-semibold tracking-widest">{s.n}</p>
              <p class="mt-2 font-sora font-semibold text-lg text-blanc-casse">{s.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{s.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Module métier -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-5xl">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Module métier
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Devis, intervention, zone —
            <span class="block italic font-medium text-bleu">structurés pour vous.</span>
          </h2>
        </div>

        <ul class="scroll-reveal mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {[
            { i: 'file-text', t: 'Demande de devis', d: "Type d'intervention, urgence, localisation, contact — qualifié dès l'arrivée." },
            { i: 'wrench', t: 'Intervention rapide', d: "Bouton urgence, plage horaire, retour express selon votre fonctionnement." },
            { i: 'map-pin', t: 'Zone d\'intervention', d: 'Communes desservies, micro-régions, rayon en km — mis en avant.' },
          ].map((m) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <span class="flex w-11 h-11 items-center justify-center rounded-xl bg-bleu/15 text-bleu">
                <Icon name={m.i} size={20} strokeWidth={1.75} />
              </span>
              <p class="mt-4 font-sora font-semibold text-blanc-casse">{m.t}</p>
              <p class="mt-2 text-sm text-blanc-casse/70 leading-relaxed">{m.d}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Réalisations -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-content">
        <div class="text-center max-w-3xl mx-auto">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Nos réalisations
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Plombiers, électriciens, garages
            <span class="block italic font-medium text-bleu">conçus par 9site4.</span>
          </h2>
        </div>
        <ul class="scroll-reveal mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {selected.map((r) => (
            <li><RealisationCard realisation={r} /></li>
          ))}
        </ul>
      </div>
    </section>

    <TarifsBref />

    <!-- FAQ -->
    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> Questions fréquentes
          </p>
          <h2 class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
            Les questions
            <span class="block italic font-medium text-bleu">des artisans réunionnais.</span>
          </h2>
        </div>
        <div class="mt-12 space-y-3">
          {faq.map((item) => (
            <details class="group rounded-2xl p-5 md:p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <summary class="flex items-center justify-between gap-4 cursor-pointer list-none">
                <span class="font-sora font-semibold text-blanc-casse">{item.q}</span>
                <span class="shrink-0 text-bleu transition-transform duration-300 group-open:rotate-45">
                  <Icon name="arrow-right" size={18} strokeWidth={2.25} />
                </span>
              </summary>
              <p class="mt-4 text-sm md:text-base text-blanc-casse/75 leading-relaxed">{item.a}</p>
            </details>
          ))}
        </div>

        <p class="scroll-reveal mt-12 text-center text-sm text-blanc-casse/65">
          Voir aussi&nbsp;:
          <a href="/creation-site-internet-la-reunion" class="text-bleu hover:underline">création de site internet à La Réunion</a>
          ·
          <a href="/site-internet-restaurant-la-reunion" class="text-bleu hover:underline">site internet pour restaurant</a>
          ·
          <a href="/site-internet-commerce-local-la-reunion" class="text-bleu hover:underline">site internet commerce local</a>
          ·
          <a href="/site-internet-tpe-pme-la-reunion" class="text-bleu hover:underline">site internet TPE/PME</a>
          ·
          <a href="/tarifs" class="text-bleu hover:underline">tarifs</a>
          ·
          <a href="/contact" class="text-bleu hover:underline">contact</a> · <a href="/diagnostic-site-internet-la-reunion" class="text-bleu hover:underline" data-track-event="diagnostic_cta_click" data-track-category="conversion" data-track-source="seo_sector_voir_aussi" data-track-target="/diagnostic-site-internet-la-reunion">diagnostic gratuit</a>.
        </p>
      </div>
    </section>

    <CTABand trackingSource="seo_sector_cta_band" trackingSector="artisan" trackingPageType="seo_sector_page" />
  </div>
</BaseLayout>
