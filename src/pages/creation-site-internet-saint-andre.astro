---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import VillePageSections from '../components/sections/VillePageSections.astro';
import { getSeo, absoluteUrl } from '../lib/seo';
import { getVille } from '../data/villes.ts';

const seo = getSeo('villeSaintAndre');
const ville = getVille('saint-andre')!;

const raisons = [
  {
    "i": "map-pin",
    "t": "Référencé sur l'Est",
    "d": "Capter les recherches \"à Saint-André\" et alentours, sur des requêtes peu concurrentielles."
  },
  {
    "i": "file-text",
    "t": "Présentation soignée",
    "d": "Artisans, commerces, services : montrer ce que vous faites concrètement."
  },
  {
    "i": "monitor",
    "t": "Adapté mobile",
    "d": "Vitesse, lisibilité, contact en un geste sur smartphone."
  },
  {
    "i": "calendar-check",
    "t": "Devis & demandes",
    "d": "Formulaire clair pour transformer le visiteur en demande qualifiée."
  },
  {
    "i": "shield-check",
    "t": "Sérieux affiché",
    "d": "Un site propre vaut mieux qu'une fiche réseau approximative."
  }
];

const faq = [
  { q: "Je travaille surtout au bouche-à-oreille à Saint-André : un site va-t-il changer quelque chose ?", a: "Il le prolonge plutôt qu'il ne le remplace : un client recommandé vérifie presque toujours en ligne avant d'appeler. Un site clair confirme la recommandation ; une absence de site peut la faire douter." },
  { q: "Y a-t-il un intérêt à être en ligne alors que l'Est est moins connecté que l'Ouest ?", a: "Justement : la concurrence en ligne y est plus faible. Un professionnel de Saint-André avec un site soigné et à jour se démarque plus facilement dans sa catégorie que dans les zones saturées de l'île." },
  { q: "Comment se déroule le projet si je suis à Saint-André ?", a: "Entièrement à distance : un appel ou une visio d'environ 30 minutes pour cadrer, puis les contenus par e-mail ou WhatsApp. Le site est généralement en ligne en 7 jours environ après réception de vos éléments." },
  { q: "Mon entreprise intervient aussi vers Saint-Benoît et Saint-Denis : le site peut-il le dire ?", a: "Oui. Le site décrit votre zone d'intervention réelle sur le bassin est et au-delà, pour capter les demandes de toute votre zone et pas seulement du centre-ville de Saint-André (97440)." },
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Création de site internet à ${ville.nom}`,
  serviceType: 'Création de site internet',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: {
    '@type': 'Place',
    name: ville.nom,
    address: { '@type': 'PostalAddress', addressLocality: ville.nom, postalCode: ville.code, addressRegion: 'La Réunion', addressCountry: 'FR' },
  },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: { '@type': 'Offer', price: 97.4, priceCurrency: 'EUR', url: 'https://9site4.re/tarifs' },
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-black text-blanc-casse">
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Création incluse · Module métier · Gestion continue · {ville.microRegion} 974
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Création de site internet à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">(La Réunion).</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 conçoit et gère le site internet des professionnels installés à {ville.nom} ({ville.code}) — TPE/PME, artisans, indépendants. Création incluse, accompagnement local.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Voir nos réalisations</a>
        </div>
      </div>
    </section>

    <VillePageSections ville={ville} variantSeed={4} raisons={raisons} faq={faq} />

    <section class="relative px-6 py-16 md:py-24" aria-labelledby="web-local-titre">
      <div class="mx-auto max-w-3xl">
        <h2 id="web-local-titre" class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Le web à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">vu de l'Est.</span>
        </h2>
        <div class="scroll-reveal mt-8 space-y-5 text-blanc-casse/75 leading-relaxed">
        <p>Principale ville de l'Est avec environ 58 000 habitants, Saint-André reste un pôle agricole majeur — canne, fruits — doublé d'une zone d'activité industrielle et artisanale. Le centre-ville et les quartiers concentrent commerces de proximité, restauration locale et services aux habitants.</p>
        <p>Pour les artisans et entreprises de la zone d'activité comme pour les commerces du centre, l'enjeu web est concret : être trouvé par les habitants de la commune et du bassin est, présenter clairement prestations et coordonnées, et recevoir des demandes exploitables. Beaucoup de professionnels de Saint-André fonctionnent encore uniquement au bouche-à-oreille ; un site sérieux prolonge cette réputation au lieu de la remplacer.</p>
        <p>L'Est est moins saturé en ligne que l'Ouest ou le chef-lieu : les professionnels qui prennent le temps de soigner leur présence web y sont d'autant plus visibles. Un salon de coiffure, un institut, un snack ou une entreprise du bâtiment avec un site clair et à jour se distingue immédiatement dans sa catégorie.</p>
        <p>9site4 accompagne les professionnels de Saint-André (97440) à distance, comme partout sur l'île : un échange téléphonique pour cadrer le besoin, un site construit autour de votre métier, puis une gestion continue qui garde les informations exactes — horaires, tarifs, prestations — sans que vous ayez à vous en occuper.</p>
        <p>Restauration locale, salons de coiffure, instituts, commerces de quartier, entreprises du bâtiment et de l'industrie légère : les métiers présents à Saint-André correspondent aux formats de sites que 9site4 construit régulièrement. Chaque site est livré avec le module utile à votre activité — devis, rendez-vous, contact — et une formule unique couvrant création, hébergement et modifications, sans mauvaise surprise de facturation. Un appel gratuit d'une trentaine de minutes suffit pour évaluer ensemble, honnêtement, ce qu'un site apporterait à votre activité saint-andréenne.</p>
        </div>
      </div>
    </section>

    <section class="relative px-6 py-16 md:py-24">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Vous êtes professionnel à {ville.nom} ?{' '}
          <span class="block italic font-medium text-bleu">Présentez votre activité à 9site4.</span>
        </h2>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">Démarrer mon projet<Icon name="arrow-right" size={20} strokeWidth={2.25} /></Button>
          <a href="/diagnostic-site-internet-la-reunion" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Diagnostic gratuit</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
