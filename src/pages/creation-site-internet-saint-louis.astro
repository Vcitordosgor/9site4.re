---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import VillePageSections from '../components/sections/VillePageSections.astro';
import { getSeo, absoluteUrl, getServiceOffer } from '../lib/seo';
import { getVille } from '../data/villes.ts';

const seo = getSeo('villeSaintLouis');
const ville = getVille('saint-louis')!;

const raisons = [
  {
    "i": "map-pin",
    "t": "Entre Sud et Ouest",
    "d": "Une position de carrefour — votre site capte les deux bassins."
  },
  {
    "i": "file-text",
    "t": "Activité bien décrite",
    "d": "Commerces, artisans, services : un contenu structuré qui répond aux vraies questions."
  },
  {
    "i": "calendar-check",
    "t": "Contact simple",
    "d": "Téléphone, WhatsApp, formulaire — au bon endroit, sur chaque page."
  },
  {
    "i": "monitor",
    "t": "Mobile-first",
    "d": "Une expérience claire sur petit écran, là où la majorité vous trouve."
  },
  {
    "i": "shield-check",
    "t": "Image fiable",
    "d": "Un site à jour rassure et différencie sur des marchés concurrentiels."
  }
];

const faq = [
  { q: "J'interviens de Saint-Louis vers Saint-Pierre et l'Ouest : le site couvrira-t-il tout ça ?", a: "Oui. La position de carrefour de Saint-Louis est justement un atout : le site décrit précisément votre zone d'intervention, du bassin sud à la côte Ouest, pour que les demandes viennent de toute votre zone réelle." },
  { q: "Quels contenus dois-je fournir pour démarrer ?", a: "Vos textes de base (activité, prestations, tarifs si vous les affichez), quelques photos et vos informations pratiques. On vous guide sur le reste : c'est cadré lors du premier échange téléphonique." },
  { q: "Le rendez-vous de lancement peut-il se faire sans déplacement ?", a: "Oui, tout se fait par téléphone ou en visio, environ 30 minutes. Vous recevez ensuite une proposition écrite claire avant de vous engager." },
  { q: "Une fois le site en ligne, les modifications sont-elles payantes ?", a: "Non, elles sont comprises dans la gestion continue : changement d'horaires, de tarifs, nouvelle prestation — vous nous l'envoyez, nous le mettons en ligne." },
];

const placeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: `Création de site internet à ${ville.nom}`,
  serviceType: 'Création de site internet',
  provider: { '@type': 'Organization', name: '9site4', url: 'https://9site4.re' },
  areaServed: {
    '@type': 'Place',
    name: ville.nom,
    address: { '@type': 'PostalAddress', addressLocality: ville.nom, postalCode: ville.code, addressRegion: 'La Réunion', addressCountry: 'FR' },
  },
  url: absoluteUrl(seo.canonical),
  description: seo.description,
  offers: getServiceOffer(),
};
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<BaseLayout seo={seo}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(placeSchema)} />
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="bg-black text-blanc-casse">
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-24">
      <div class="mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-bleu-nuit text-xs font-semibold uppercase tracking-wide text-center">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
          Création incluse · Module métier · Gestion continue · {ville.microRegion} 974
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
          Création de site internet à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">(La Réunion).</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          9site4 conçoit et gère le site internet des professionnels installés à {ville.nom} ({ville.code}) — TPE/PME, artisans, indépendants. Création incluse, accompagnement local.
        </p>
        <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">
            Créer mon site
            <Icon name="arrow-right" size={20} strokeWidth={2.25} />
          </Button>
          <a href="/realisations" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Voir nos réalisations</a>
        </div>
      </div>
    </section>

    <VillePageSections ville={ville} variantSeed={5} raisons={raisons} faq={faq} />

    <section class="relative px-6 py-14 md:py-20" aria-labelledby="web-local-titre">
      <div class="mx-auto max-w-3xl">
        <h2 id="web-local-titre" class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Le web à {ville.nom}{' '}
          <span class="block italic font-medium text-bleu">vu du carrefour Sud-Ouest.</span>
        </h2>
        <div class="scroll-reveal mt-8 space-y-5 text-blanc-casse/75 leading-relaxed">
        <p>Avec environ 53 000 habitants, Saint-Louis articule le Sud et l'Ouest de l'île. Son économie repose sur l'agriculture — la canne et la sucrerie du Gol en sont les symboles —, les commerces, les services et un réseau d'artisans actifs sur la commune et les bassins voisins.</p>
        <p>Cette position de carrefour est un atout commercial : la clientèle potentielle d'un professionnel saint-louisien ne s'arrête pas aux limites de la commune. Artisans et services interviennent couramment vers Saint-Pierre, Le Tampon ou la côte Ouest. Encore faut-il que cette zone d'intervention soit visible : c'est le rôle du site, qui la décrit noir sur blanc.</p>
        <p>Pour les commerces et la restauration du centre-ville et de la Rivière, l'enjeu est plus simple mais tout aussi décisif : des horaires justes, une adresse claire, un moyen de contact immédiat. La majorité des recherches locales se font sur mobile, souvent juste avant la visite — le site doit y répondre en quelques secondes.</p>
        <p>9site4 construit pour les professionnels de Saint-Louis (97450) des sites adaptés à leur métier : devis pour les artisans, présentation et contact pour les commerces, rendez-vous pour les services. La création est incluse dans l'abonnement, et la gestion continue garantit que le site reste exact dans le temps, sans surcoût à chaque modification.</p>
        <p>La commune compte aussi des professions libérales, des salons, des praticiens du bien-être et des restaurants pour lesquels le format 9site4 s'applique de la même façon : un site structuré autour du métier, un module adapté — rendez-vous, réservation ou contact —, et un interlocuteur qui suit le site dans la durée plutôt qu'un prestataire qui disparaît après la livraison. Pour savoir si ce format correspond à votre activité à Saint-Louis, le premier échange téléphonique est gratuit et n'engage à rien.</p>
        </div>
      </div>
    </section>

    <section class="relative px-6 py-14 md:py-20">
      <div class="mx-auto max-w-3xl text-center">
        <h2 class="scroll-reveal font-sora font-bold text-2xl md:text-4xl text-blanc-casse text-balance leading-[1.12]">
          Vous êtes professionnel à {ville.nom} ?{' '}
          <span class="block italic font-medium text-bleu">Présentez votre activité à 9site4.</span>
        </h2>
        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <Button variant="primary" size="lg" href="/contact">Démarrer mon projet<Icon name="arrow-right" size={20} strokeWidth={2.25} /></Button>
          <a href="/diagnostic-site-internet-la-reunion" class="inline-flex items-center justify-center gap-2 h-14 px-8 text-lg font-semibold rounded-full text-bleu hover:text-blanc-casse transition-colors">Diagnostic gratuit</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
