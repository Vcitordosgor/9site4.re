---
import BaseLayout from '../layouts/BaseLayout.astro';
import RealisationCard from '../components/realisations/RealisationCard.astro';
import FiltersBar from '../components/realisations/FiltersBar.tsx';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/realisations.json';
import categories from '../data/categories.json';
import { getSeo } from '../lib/seo';

// Pré-calcul des counts par catégorie (rendu serveur, pas de flicker au mount)
const counts = realisations.reduce<Record<string, number>>((acc, r) => {
  acc[r.categorie] = (acc[r.categorie] || 0) + 1;
  return acc;
}, {});

const categoriesWithCount = categories.map((c) => ({
  ...c,
  count: counts[c.id] ?? 0,
}));

// 3 exemples vedettes (métiers variés) mis en avant avant la grille complète
const featuredCats = ['restaurants', 'artisans', 'beaute'];
const featured = featuredCats
  .map((cat) => realisations.find((r) => r.categorie === cat))
  .filter(Boolean) as typeof realisations;
---

<BaseLayout seo={getSeo('realisations')}>
  <!-- En-tête : titre + sous-titre -->
  <section class="relative overflow-hidden px-6 pt-24 pb-12 md:pt-32 md:pb-16">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] halo-mix opacity-50"></div>
    </div>
    <div class="mx-auto max-w-3xl text-center">
      <p class="inline-flex items-center px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
        Exemples métiers
      </p>
      <h1 class="mt-4 text-4xl md:text-6xl font-sora font-bold text-bleu-nuit text-balance leading-tight">
        Un aperçu de ce qu'on peut créer pour vous.
      </h1>
      <p class="mt-6 text-lg md:text-xl text-bleu-nuit/70 leading-relaxed">
        Ces exemples sont des démonstrations créées par 9site4 pour vous aider à
        vous projeter. Chaque site client est ensuite adapté à son activité, ses
        contenus et ses objectifs.
      </p>
    </div>
  </section>

  <!-- Exemples vedettes -->
  <section class="relative px-6 pb-4 md:pb-8" aria-labelledby="vedettes-titre">
    <div class="mx-auto max-w-content">
      <h2 id="vedettes-titre" class="sr-only">Exemples mis en avant</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featured.map((r) => (
          <a
            href={r.previewUrl}
            class="group relative flex flex-col rounded-3xl overflow-hidden ring-1 ring-bleu-nuit/10 bg-blanc-casse shadow-card transition-all duration-300 ease-out-soft hover:-translate-y-1 hover:shadow-card-hover"
          >
            <div class="relative aspect-[4/3] overflow-hidden">
              <img
                src={r.thumbnail}
                alt={`Exemple de site — ${r.nom}`}
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-orange text-white text-[10px] font-bold uppercase tracking-wide">
                Démo métier
              </span>
            </div>
            <div class="flex flex-col flex-1 p-6">
              <p class="font-sora font-semibold text-lg text-bleu-nuit">{r.nom}</p>
              <p class="mt-1 text-sm text-bleu-nuit/65 leading-relaxed">{r.sousTitre}</p>
              <div class="mt-4 flex items-center justify-between">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-bleu/20 text-bleu-nuit text-xs font-semibold">
                  Module : {r.moduleInclus}
                </span>
                <span class="inline-flex items-center gap-1 text-sm font-semibold text-bleu-nuit group-hover:text-orange transition-colors">
                  Voir la démo
                  <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-0.5">→</span>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Séparateur : toute la collection -->
  <section class="relative px-6 pt-12 md:pt-16 pb-2" aria-hidden="true">
    <div class="mx-auto max-w-content flex items-center gap-4">
      <span class="h-px flex-1 bg-bleu-nuit/10"></span>
      <span class="font-roboto-mono text-[11px] uppercase tracking-[0.28em] text-bleu-nuit/45">Toute la collection</span>
      <span class="h-px flex-1 bg-bleu-nuit/10"></span>
    </div>
  </section>

  <!-- Barre de filtres (Astro Island, client:load) -->
  <section class="relative px-6 pb-10" aria-label="Filtres">
    <div class="mx-auto max-w-content">
      <FiltersBar
        client:load
        categories={categoriesWithCount}
        totalCount={realisations.length}
      />
      <p
        id="realisations-live"
        class="sr-only"
        aria-live="polite"
        aria-atomic="true"
      >
        {realisations.length} réalisations affichées.
      </p>
    </div>
  </section>

  <!-- Grille des 30 cartes (rendu serveur, filtré côté client par display) -->
  <section class="relative px-6 pb-20 md:pb-28" aria-labelledby="liste-realisations">
    <div class="mx-auto max-w-content">
      <h2 id="liste-realisations" class="sr-only">Liste des réalisations</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {realisations.map((r) => (
          <li data-realisation-categorie={r.categorie}>
            <RealisationCard realisation={r} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABand />
</BaseLayout>
