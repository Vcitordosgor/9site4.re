---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import FAQAccordion from '../components/sections/FAQAccordion.astro';
import ContactForm from '../components/sections/ContactForm.tsx';
import siteConfig from '../data/siteConfig.json';
import categories from '../data/categories.json';
import { getSeo } from '../lib/seo';
import { getFaqForPage } from '../data/faq';

const waUrl = `https://wa.me/${siteConfig.contact.whatsapp}?text=${encodeURIComponent(
  siteConfig.contact.whatsappMessage
)}`;

const promesses = [
  {
    icon: 'clock',
    titre: 'Réponse sous 24h',
    texte: "Vous nous écrivez aujourd'hui, on vous répond demain. Ouvrés.",
  },
  {
    icon: 'shield-check',
    titre: 'Sans engagement',
    texte: "Un échange pour comprendre votre besoin. Vous décidez ensuite.",
  },
  {
    icon: 'headphones',
    titre: 'RDV téléphone 30 min',
    texte: "Un appel court pour cadrer votre projet, sans jargon technique.",
  },
];

// FAQ centralisée — questions liées à "que se passe-t-il après l'envoi du formulaire".
const contactFaq = getFaqForPage('contact');
---

<BaseLayout seo={getSeo('contact')}>
  <div class="bg-black text-blanc-casse">
    <!-- ============================================================ -->
    <!-- HERO éditorial                                                -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-20">
      <div class="pointer-events-none absolute -top-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-bleu/20 blur-3xl opacity-60 halo-pulse" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 w-[24rem] h-[24rem] rounded-full bg-bleu/15 blur-3xl opacity-40 halo-pulse-slow" aria-hidden="true"></div>
      <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
        <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] halo-mix opacity-60"></div>
      </div>

      <div class="relative mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu/15 ring-1 ring-bleu/30 text-bleu text-[11px] font-semibold uppercase tracking-[0.28em]">
          <span class="block w-1.5 h-1.5 rounded-full bg-bleu animate-pulse"></span>
          Contact
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.05] text-[clamp(2.5rem,4.5vw+1rem,4.5rem)] tracking-tight text-blanc-casse">
          Parlez-nous
          <span class="block italic font-medium text-bleu">de votre projet web.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/75 leading-relaxed">
          Présentez votre activité, votre besoin et vos objectifs. L'équipe 9site4 vous répond avec une proposition claire et adaptée à votre métier.
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 2 COLONNES : formulaire (gauche) + réassurance (droite)       -->
    <!-- ============================================================ -->
    <section class="relative px-6 pb-20 md:pb-28">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        
      </div>

      <div class="relative mx-auto max-w-content grid lg:grid-cols-12 gap-8 lg:gap-10 items-start">
        <!-- ===== Colonne formulaire ===== -->
        <div class="lg:col-span-7 scroll-reveal">
          <div class="relative rounded-3xl overflow-hidden"
            style="background: #FFFFFF; box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 22px 50px -20px rgba(0,0,0,0.85), 0 0 0 1.5px #91a6ff, 0 0 36px -10px rgba(145,166,255,0.50);">
            <!-- Liseret bleu mauve en haut -->
            <span class="absolute top-0 inset-x-10 h-px bg-gradient-to-r from-transparent via-bleu/60 to-transparent" aria-hidden="true"></span>
            <div class="relative">
              <ContactForm client:load categories={categories} />
            </div>
          </div>
          <p class="mt-6 text-center text-sm text-blanc-casse/65">
            Pas encore prêt à nous contacter ?{' '}
            <a
              href="/diagnostic-site-internet-la-reunion"
              class="text-bleu hover:text-blanc-casse underline-offset-4 hover:underline transition-colors"
              data-track-event="diagnostic_cta_click"
              data-track-category="conversion"
              data-track-source="contact_page_under_form"
              data-track-target="/diagnostic-site-internet-la-reunion"
            >
              Demander un diagnostic gratuit →
            </a>
          </p>
        </div>

        <!-- ===== Colonne réassurance (sticky desktop) ===== -->
        <aside class="lg:col-span-5 space-y-5 lg:sticky lg:top-28">
          <!-- Pourquoi nous écrire — card premium cohérente avec le reste -->
          <div class="scroll-reveal relative rounded-3xl p-7 md:p-8 overflow-hidden"
            style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 18px 40px -22px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
            <!-- Liseret bleu mauve en haut -->
            <span class="absolute top-0 inset-x-10 h-px bg-gradient-to-r from-transparent via-bleu/60 to-transparent" aria-hidden="true"></span>

            <p class="relative inline-flex items-center gap-2 font-roboto-mono text-[10px] uppercase tracking-[0.3em] text-blanc-casse/55 font-semibold">
              <span class="w-1.5 h-1.5 rounded-full bg-bleu"></span>
              Pourquoi nous écrire
            </p>
            <h2 class="relative mt-4 font-sora font-bold text-2xl text-blanc-casse leading-tight">
              Trois choses qu'on
              <span class="block italic font-medium text-bleu">s'engage à faire.</span>
            </h2>

            <!-- Séparateur or qui s'étire (rappel cards méthode) -->
            <span class="relative mt-6 block h-px w-12 bg-bleu/50" aria-hidden="true"></span>

            <ul class="relative mt-6 space-y-5">
              {promesses.map((p) => (
                <li class="flex items-start gap-4">
                  <span class="relative flex w-11 h-11 shrink-0 items-center justify-center rounded-2xl overflow-hidden">
                    <span class="absolute inset-0 bg-gradient-to-br from-bleu/30 to-bleu/5" aria-hidden="true"></span>
                    <Icon name={p.icon} size={20} strokeWidth={1.75} class="relative text-bleu" />
                  </span>
                  <div>
                    <p class="font-sora font-semibold text-base text-blanc-casse">{p.titre}</p>
                    <p class="mt-1 text-sm text-blanc-casse/65 leading-relaxed">{p.texte}</p>
                  </div>
                </li>
              ))}
            </ul>
          </div>

          <!-- Coordonnées : card sombre cohérente -->
          <div class="scroll-reveal relative rounded-3xl p-7 overflow-hidden"
            style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 18px 40px -22px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">

            <div class="grid grid-cols-1 gap-5">
              <!-- Email -->
              <div class="flex items-start gap-4">
                <span class="relative flex w-11 h-11 shrink-0 items-center justify-center rounded-2xl overflow-hidden">
                  <span class="absolute inset-0 bg-gradient-to-br from-bleu/30 to-bleu/5" aria-hidden="true"></span>
                  <Icon name="mail" size={20} strokeWidth={1.75} class="relative text-bleu" />
                </span>
                <div class="min-w-0 flex-1">
                  <p class="font-roboto-mono text-[10px] font-semibold text-blanc-casse/55 uppercase tracking-[0.22em]">Email</p>
                  <a href={`mailto:${siteConfig.contact.email}`} class="mt-1 inline-block font-sora font-semibold text-base text-blanc-casse hover:text-bleu transition-colors truncate">
                    {siteConfig.contact.email}
                  </a>
                </div>
              </div>

              <!-- Localisation -->
              <div class="flex items-start gap-4 pt-5 border-t border-white/10">
                <span class="relative flex w-11 h-11 shrink-0 items-center justify-center rounded-2xl overflow-hidden">
                  <span class="absolute inset-0 bg-gradient-to-br from-bleu/30 to-bleu/5" aria-hidden="true"></span>
                  <Icon name="map-pin" size={20} strokeWidth={1.75} class="relative text-bleu" />
                </span>
                <div>
                  <p class="font-roboto-mono text-[10px] font-semibold text-blanc-casse/55 uppercase tracking-[0.22em]">Localisation</p>
                  <p class="mt-1 font-sora font-semibold text-base text-blanc-casse">
                    {siteConfig.location.region}
                  </p>
                  <p class="text-sm text-blanc-casse/65">100% en ligne</p>
                </div>
              </div>

              <!-- Horaires -->
              <div class="flex items-start gap-4 pt-5 border-t border-white/10">
                <span class="relative flex w-11 h-11 shrink-0 items-center justify-center rounded-2xl overflow-hidden">
                  <span class="absolute inset-0 bg-gradient-to-br from-bleu/30 to-bleu/5" aria-hidden="true"></span>
                  <Icon name="clock" size={20} strokeWidth={1.75} class="relative text-bleu" />
                </span>
                <div>
                  <p class="font-roboto-mono text-[10px] font-semibold text-blanc-casse/55 uppercase tracking-[0.22em]">Disponibilité</p>
                  <p class="mt-1 font-sora font-semibold text-base text-blanc-casse">
                    Lun – Ven · 9h – 18h
                  </p>
                  <p class="text-sm text-blanc-casse/65">heure 974</p>
                </div>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TRUST INDICATORS : 3 KPI                                      -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden px-6 py-16 md:py-20" aria-label="Chiffres clés">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[36rem] h-[36rem] halo-mix opacity-30"></div>
      </div>

      <div class="relative mx-auto max-w-5xl">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 md:gap-6">
          <div class="scroll-reveal text-center rounded-3xl bg-white/[0.03] ring-1 ring-white/10 p-8 hover:ring-bleu/30 hover:bg-white/[0.05] transition-all duration-300">
            <p class="font-sora font-bold text-5xl text-bleu">0 €</p>
            <p class="mt-2 text-sm text-blanc-casse/70">d'engagement, libre à tout moment</p>
          </div>
          <div class="scroll-reveal text-center rounded-3xl bg-white/[0.03] ring-1 ring-white/10 p-8 hover:ring-bleu/30 hover:bg-white/[0.05] transition-all duration-300" style="transition-delay: 80ms">
            <p class="font-sora font-bold text-5xl text-bleu" data-count="7" data-count-suffix="">7</p>
            <p class="mt-2 text-sm text-blanc-casse/70">jours pour démarrer votre site</p>
          </div>
          <div class="scroll-reveal text-center rounded-3xl bg-white/[0.03] ring-1 ring-white/10 p-8 hover:ring-bleu/30 hover:bg-white/[0.05] transition-all duration-300" style="transition-delay: 160ms">
            <p class="font-sora font-bold text-5xl text-bleu" data-count="97.4" data-count-decimals="1" data-count-suffix="€">97,4€</p>
            <p class="mt-2 text-sm text-blanc-casse/70">/mois tout inclus</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FAQ COURTE                                                    -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden px-6 py-20 md:py-28" aria-labelledby="faq-titre">
      <div class="pointer-events-none absolute inset-0" aria-hidden="true">
        <div class="absolute -top-24 left-0 w-[28rem] h-[28rem] halo-bleu opacity-30"></div>
      </div>

      <div class="relative mx-auto max-w-3xl">
        <div class="text-center mb-12">
          <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="w-2 h-2 rounded-full bg-bleu"></span> FAQ contact
          </p>
          <h2 id="faq-titre" class="scroll-reveal mt-6 font-sora font-bold text-3xl md:text-5xl text-blanc-casse text-balance leading-[1.1]">
            Avant d'écrire,
            <span class="italic font-medium text-bleu">quelques réponses.</span>
          </h2>
        </div>
        <div class="scroll-reveal">
          <FAQAccordion items={contactFaq} idPrefix="faq-contact" />
        </div>
        <p class="scroll-reveal mt-10 text-center text-sm text-blanc-casse/65">
          <a href="/questions-frequentes" class="text-bleu hover:text-blanc-casse underline-offset-4 hover:underline transition-colors">
            Voir toutes les questions fréquentes →
          </a>
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
