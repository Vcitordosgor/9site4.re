---
import BaseLayout from '../layouts/BaseLayout.astro';
import RealisationCard from '../components/exemples/RealisationCard.astro';
import Icon from '../components/ui/Icon.astro';
import FiltersBar from '../components/exemples/FiltersBar.tsx';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/exemples.json';
import categories from '../data/categories.json';
import { getSeo } from '../lib/seo';

// Pré-calcul des counts par catégorie (rendu serveur, pas de flicker au mount)
const counts = realisations.reduce<Record<string, number>>((acc, r) => {
  acc[r.categorie] = (acc[r.categorie] || 0) + 1;
  return acc;
}, {});

const categoriesWithCount = categories.map((c) => ({
  ...c,
  count: counts[c.id] ?? 0,
}));

// Ordre personnalisé : ces métiers prioritaires en haut de grille
const priorityOrder = [
  'snack-pizzeria',
  'auto-ecole',
  'restaurant-gastronomique',
  'bar-a-jus-tropical',
  'coach-sportif',
  'studio-yoga',
  'studio-audio',
  'electricite-generale',
  'avocat-cabinet',
];
const orderedRealisations = [
  ...priorityOrder
    .map((slug) => realisations.find((r) => r.slug === slug))
    .filter(Boolean) as typeof realisations,
  ...realisations.filter((r) => !priorityOrder.includes(r.slug)),
];
---

<BaseLayout seo={getSeo('exemples')}>
  <div class="bg-black text-blanc-casse">
  <!-- Hero éditorial : aligné qualité home (eyebrow + accent line + titre italique + animations) -->
  <section class="relative overflow-hidden px-6 pt-28 pb-14 md:pt-36 md:pb-20">
    <!-- Halos décoratifs subtils -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-bleu/20 blur-3xl opacity-50" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-[24rem] h-[24rem] rounded-full bg-orange/15 blur-3xl opacity-40" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] halo-mix opacity-50"></div>
    </div>
    <div class="mx-auto max-w-3xl text-center">
      <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
        <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
        {realisations.length} réalisations
      </p>
      <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
      <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-blanc-casse">
        Nos réalisations
        <span class="block italic font-medium text-bleu">pour les pros réunionnais.</span>
      </h1>
      <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
        Découvrez une sélection de sites conçus par 9site4 pour les professionnels réunionnais.
      </p>
      <p class="hero-rise hero-rise-5 mx-auto mt-5 max-w-2xl text-base text-blanc-casse/65 leading-relaxed">
        Chaque réalisation illustre notre manière de structurer une activité en ligne. Votre site sera adapté à votre métier, vos contenus et vos objectifs.
      </p>
    </div>
  </section>


  <!-- Barre de filtres (Astro Island, client:load) -->
  <section class="relative px-6 pb-10" aria-label="Filtres">
    <div class="mx-auto max-w-content">
      <FiltersBar
        client:load
        categories={categoriesWithCount}
        totalCount={realisations.length}
      />
      <p
        id="realisations-live"
        class="sr-only"
        aria-live="polite"
        aria-atomic="true"
      >
        {realisations.length} réalisations affichées.
      </p>
    </div>
  </section>

  <!-- Grille des 30 cartes (rendu serveur, filtré côté client par display) -->
  <section class="relative px-6 pb-20 md:pb-28" aria-labelledby="liste-realisations">
    <div class="mx-auto max-w-content">
      <h2 id="liste-realisations" class="sr-only">Liste des réalisations</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {orderedRealisations.map((r) => (
          <li data-realisation-categorie={r.categorie}>
            <RealisationCard realisation={r} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Pont éditorial avant le CTA final : adresse les visiteurs qui ne trouvent pas leur métier -->
  <section class="relative overflow-hidden px-6 py-16 md:py-24" aria-labelledby="pas-trouve-titre">
    <div class="mx-auto max-w-3xl text-center">
      <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
        <span class="w-2 h-2 rounded-full bg-bleu"></span> Votre métier n'est pas dans la liste ?
      </p>
      <h2 id="pas-trouve-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-blanc-casse text-balance leading-[1.12]">
        Ces réalisations sont un point de départ.
        <span class="block mt-1 italic font-medium text-bleu">Votre site sera adapté à votre activité.</span>
      </h2>
      <p class="scroll-reveal mx-auto mt-7 max-w-2xl text-lg text-blanc-casse/70 leading-relaxed">
        Chaque site est structuré sur-mesure pour votre métier, vos contenus et vos objectifs. Quel que soit votre secteur, 9site4 construit la version qui correspond à votre entreprise.
      </p>
    </div>
  </section>

  <!-- Encart maillage SEO : pages métiers -->
  <section class="relative px-6 pb-16 md:pb-24" aria-labelledby="metiers-titre">
    <div class="mx-auto max-w-5xl rounded-3xl p-8 md:p-10"
      style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
      <p class="font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
        <span class="inline-block align-middle w-2 h-2 rounded-full bg-bleu mr-2"></span>
        Vous cherchez un site pour votre métier ?
      </p>
      <h2 id="metiers-titre" class="mt-4 font-sora font-bold text-2xl md:text-3xl text-blanc-casse text-balance leading-tight">
        Découvrez nos pages dédiées
        <span class="block italic font-medium text-bleu">aux principaux métiers du 974.</span>
      </h2>
      <ul class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <li>
          <a href="/creation-site-internet-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Création de site à La Réunion</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Page pilier pour les TPE/PME réunionnaises.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-restaurant-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour restaurant</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Restaurants, snacks, bars, cafés, pizzerias.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-artisan-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour artisan</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Plombiers, électriciens, garages, BTP.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-coiffeur-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour coiffeur</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Salons, coiffeurs, barbiers.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-institut-beaute-spa-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour institut & spa</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Instituts, spas, esthéticiennes, bien-être.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-gite-location-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour gîte & location</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Gîtes, locations, conciergeries, tourisme.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-profession-liberale-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour profession libérale</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Avocats, notaires, comptables, consultants.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-bien-etre-sante-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour bien-être & santé</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Ostéo, naturo, diét, psy, coach, yoga, danse.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-institut-beaute-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour institut de beauté</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Esthétique, tatouage, cartes cadeaux.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-coach-independant-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour coach & indépendant</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Coachs, consultants, formateurs, indépendants.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-commerce-local-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour commerce local</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Boutiques, boulangeries, fleuristes, garages.</p>
          </a>
        </li>
        <li>
          <a href="/site-internet-tpe-pme-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site pour TPE/PME</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Toutes activités, tous secteurs du 974.</p>
          </a>
        </li>
        <li>
          <a href="/site-vitrine-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Site vitrine</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Vitrine professionnelle qui convertit.</p>
          </a>
        </li>
        <li>
          <a href="/agence-web-la-reunion" class="block h-full rounded-2xl p-5 border border-white/10 hover:border-bleu transition-colors">
            <p class="font-sora font-semibold text-blanc-casse">Agence web</p>
            <p class="mt-2 text-sm text-blanc-casse/65">Partenaire web TPE/PME, offre claire.</p>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <CTABand trackingSource="realisations_page_cta_band" trackingPageType="realisations" />
  </div>
</BaseLayout>
