---
import BaseLayout from '../layouts/BaseLayout.astro';
import RealisationCard from '../components/exemples/RealisationCard.astro';
import Icon from '../components/ui/Icon.astro';
import FiltersBar from '../components/exemples/FiltersBar.tsx';
import CTABand from '../components/sections/CTABand.astro';
import realisations from '../data/exemples.json';
import categories from '../data/categories.json';
import { getSeo } from '../lib/seo';

// Pré-calcul des counts par catégorie (rendu serveur, pas de flicker au mount)
const counts = realisations.reduce<Record<string, number>>((acc, r) => {
  acc[r.categorie] = (acc[r.categorie] || 0) + 1;
  return acc;
}, {});

const categoriesWithCount = categories.map((c) => ({
  ...c,
  count: counts[c.id] ?? 0,
}));

// 3 exemples vedettes (métiers variés) mis en avant avant la grille complète
// Sélection post passe qualité : boulangerie (gourmand), studio audio (pro/créatif),
// plongée (tourisme/expérientiel) — 3 univers visuels et métiers très différents.
const featuredSlugs = ['boulangerie-artisanale', 'studio-audio', 'plongee'];
const featured = featuredSlugs
  .map((slug) => realisations.find((r) => r.slug === slug))
  .filter(Boolean) as typeof realisations;
---

<BaseLayout seo={getSeo('exemples')}>
  <div class="bg-blanc-casse text-bleu-nuit">
  <!-- Hero éditorial : aligné qualité home (eyebrow + accent line + titre italique + animations) -->
  <section class="relative overflow-hidden px-6 pt-28 pb-14 md:pt-36 md:pb-20">
    <!-- Halos décoratifs subtils -->
    <div class="pointer-events-none absolute -top-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-bleu/20 blur-3xl opacity-50" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 -left-32 w-[24rem] h-[24rem] rounded-full bg-orange/15 blur-3xl opacity-40" aria-hidden="true"></div>
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] halo-mix opacity-50"></div>
    </div>
    <div class="mx-auto max-w-3xl text-center">
      <p class="hero-rise hero-rise-1 inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
        <span class="block w-1.5 h-1.5 rounded-full bg-white/90 animate-pulse"></span>
        {realisations.length} démos métiers
      </p>
      <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
      <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2.25rem,4vw+1rem,4rem)] tracking-tight text-bleu-nuit">
        {realisations.length} démos métiers,
        <span class="block italic font-medium text-bleu">pour vous projeter.</span>
      </h1>
      <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-bleu-nuit/70 leading-relaxed">
        Ces exemples sont des <strong class="font-semibold text-bleu-nuit">démonstrations conçues par 9site4</strong>{' '}
        pour vous aider à vous projeter. Chaque site est ensuite adapté à votre
        activité, vos contenus et vos objectifs.
      </p>
    </div>
  </section>

  <!-- Exemples vedettes -->
  <section class="relative px-6 pb-4 md:pb-8" aria-labelledby="vedettes-titre">
    <div class="mx-auto max-w-content">
      <h2 id="vedettes-titre" class="sr-only">Exemples mis en avant</h2>
      <div class="mb-4 flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-orange/15 text-orange text-[10.5px] font-bold uppercase tracking-[0.18em]">
          <Icon name="sparkle" size={11} strokeWidth={2.5} />
          Coups de cœur
        </span>
        <span class="text-xs text-bleu-nuit/55 font-roboto-mono uppercase tracking-wider">3 démos repérées</span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {featured.map((r) => (
          <article class="group relative flex flex-col rounded-3xl overflow-hidden ring-1 ring-bleu-nuit/10 bg-blanc-casse shadow-card transition-all duration-300 ease-out-soft hover:-translate-y-1 hover:shadow-card-hover hover:ring-bleu/40">
            <a
              href={r.previewUrl}
              target="_blank"
              rel="noopener"
              class="block relative overflow-hidden bg-bleu-nuit"
              aria-label={`Voir la démo ${r.nom}`}
            >
              <div class="flex items-center gap-1.5 px-3 py-2 bg-bleu-nuit/95" aria-hidden="true">
                <span class="block w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
                <span class="block w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
                <span class="block w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
              </div>
              <div class="relative aspect-[4/3] overflow-hidden bg-blanc-casse">
                <img
                  src={r.thumbnail}
                  alt={`Exemple de site — ${r.nom}`}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
                <span class="absolute top-3 left-3 inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-orange text-white text-[10px] font-bold uppercase tracking-wide shadow-md">
                  Démo métier
                </span>
                <div class="absolute inset-0 flex items-end justify-center pb-5 bg-gradient-to-t from-bleu-nuit/70 via-bleu-nuit/0 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  <span class="inline-flex items-center gap-2 h-11 px-5 rounded-full bg-bleu text-white font-semibold text-sm shadow-[0_0_24px_rgba(145,166,255,0.6)]">
                    Voir la démo
                    <Icon name="arrow-right" size={16} strokeWidth={2.5} />
                  </span>
                </div>
              </div>
            </a>
            <div class="flex flex-col flex-1 p-6">
              <p class="font-sora font-semibold text-lg text-bleu-nuit">{r.nom}</p>
              <p class="mt-1 text-sm text-bleu-nuit/65 leading-relaxed">{r.sousTitre}</p>
              <div class="mt-5 pt-4 border-t border-bleu-nuit/10 flex items-center justify-between gap-3">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-bleu/15 text-bleu-nuit text-xs font-semibold">
                  Module : {r.moduleInclus}
                </span>
                <a
                  href="/contact"
                  class="inline-flex items-center gap-1.5 text-sm font-semibold text-bleu-nuit/70 hover:text-bleu transition-colors"
                >
                  Je veux celui-ci
                  <Icon name="arrow-right" size={14} strokeWidth={2.5} />
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Séparateur : toute la collection -->
  <section class="relative px-6 pt-12 md:pt-16 pb-2" aria-hidden="true">
    <div class="mx-auto max-w-content flex items-center gap-4">
      <span class="h-px flex-1 bg-bleu-nuit/10"></span>
      <span class="font-roboto-mono text-[11px] uppercase tracking-[0.28em] text-bleu-nuit/45">Toute la collection</span>
      <span class="h-px flex-1 bg-bleu-nuit/10"></span>
    </div>
  </section>

  <!-- Barre de filtres (Astro Island, client:load) -->
  <section class="relative px-6 pb-10" aria-label="Filtres">
    <div class="mx-auto max-w-content">
      <FiltersBar
        client:load
        categories={categoriesWithCount}
        totalCount={realisations.length}
      />
      <p
        id="realisations-live"
        class="sr-only"
        aria-live="polite"
        aria-atomic="true"
      >
        {realisations.length} exemples affichés.
      </p>
    </div>
  </section>

  <!-- Grille des 30 cartes (rendu serveur, filtré côté client par display) -->
  <section class="relative px-6 pb-20 md:pb-28" aria-labelledby="liste-realisations">
    <div class="mx-auto max-w-content">
      <h2 id="liste-realisations" class="sr-only">Liste des exemples</h2>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {realisations.map((r) => (
          <li data-realisation-categorie={r.categorie}>
            <RealisationCard realisation={r} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Pont éditorial avant le CTA final : adresse les visiteurs qui ne trouvent pas leur métier -->
  <section class="relative overflow-hidden px-6 py-16 md:py-24" aria-labelledby="pas-trouve-titre">
    <div class="mx-auto max-w-3xl text-center">
      <p class="scroll-reveal inline-flex items-center gap-2 font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-bleu-nuit/55 font-semibold">
        <span class="w-2 h-2 rounded-full bg-bleu"></span> Vous ne voyez pas votre métier ?
      </p>
      <h2 id="pas-trouve-titre" class="scroll-reveal mt-6 font-sora font-bold text-2xl md:text-4xl lg:text-5xl text-bleu-nuit text-balance leading-[1.12]">
        Ces démos ne sont qu'un point de départ.
        <span class="block mt-1 italic font-medium text-bleu">Votre site, lui, sera adapté à vous.</span>
      </h2>
      <p class="scroll-reveal mx-auto mt-7 max-w-2xl text-lg text-bleu-nuit/65 leading-relaxed">
        Chaque site est ensuite ajusté à votre activité, vos contenus et vos
        objectifs. Quel que soit votre métier, on construit la version qui vous
        ressemble.
      </p>
    </div>
  </section>

  <CTABand />
  </div>
</BaseLayout>
