---
import '@fontsource/crimson-pro/latin-400.css';
import '@fontsource/crimson-pro/latin-500.css';
import '@fontsource/crimson-pro/latin-600.css';
import '@fontsource/crimson-pro/latin-400-italic.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/painleve.json';

import Header from '../../components/templates/boulangerie/Header.astro';
import Hero from '../../components/templates/boulangerie/HeroKraft.astro';
import Manifesto from '../../components/templates/boulangerie/Manifesto.astro';
import Four from '../../components/templates/boulangerie/Four.astro';
import Levain from '../../components/templates/boulangerie/Levain.astro';
import Carte from '../../components/templates/boulangerie/Carte.astro';
import Precommande from '../../components/templates/boulangerie/Precommande.astro';
import Calendrier from '../../components/templates/boulangerie/Calendrier.astro';
import Trouver from '../../components/templates/boulangerie/Trouver.astro';
import Faq from '../../components/templates/boulangerie/Faq.astro';
import Footer from '../../components/templates/boulangerie/Footer.astro';

const businessLD = localBusinessSchema(data, 'Bakery');
---

<BaseLayout seo={getSeo('templateBoulangerie')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/boulangerie/hero.webp" fetchpriority="high" />
  </Fragment>

  <Header />
  <main id="top" style="background:#F5EBD5; color:#1A1614; font-family:'Crimson Pro',Georgia,serif;">
    <Hero />
    <Manifesto />
    <Four />
    <Levain />
    <Carte />
    <Precommande />
    <Calendrier />
    <Trouver />
    <Faq />
  </main>
  <Footer />
</BaseLayout>
