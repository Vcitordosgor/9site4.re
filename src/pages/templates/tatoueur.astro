---
import '@fontsource/cardo/latin-400.css';
import '@fontsource/cardo/latin-400-italic.css';
import '@fontsource/cardo/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { localBusinessSchema } from "../../lib/businessSchema";
import encreData from '../../data/templates/encrevolcan.json';

// SEO entry pour ce template à ajouter dans src/lib/seo.ts (cf. NEW_TEMPLATES_BATCH_2.md).
// En attendant, on fournit un SEO inline pour ne pas bloquer le build.
const localSeo = {
  title: 'Encre Volcan — Studio de tatouage à La Réunion | Template 9site4',
  description: 'Aperçu du template "Studio de tatouage" proposé par 9site4 : styles signature, équipe, flash sheet, process, hygiène, tarifs. Site fictif de démonstration.',
  canonical: '/templates/tatoueur',
  ogImage: '/og-image.png',
  ogImageAlt: 'Encre Volcan — Studio de tatouage à La Réunion',
  noindex: true,
};

import EncreHeader from '../../components/templates/tatoueur/EncreHeader.astro';
import HeroEncre from '../../components/templates/tatoueur/HeroEncre.astro';
import Styles from '../../components/templates/tatoueur/Styles.astro';
import Artistes from '../../components/templates/tatoueur/Artistes.astro';
import Flash from '../../components/templates/tatoueur/Flash.astro';
import Process from '../../components/templates/tatoueur/Process.astro';
import Hygiene from '../../components/templates/tatoueur/Hygiene.astro';
import Tarifs from '../../components/templates/tatoueur/Tarifs.astro';
import Faq from '../../components/templates/tatoueur/Faq.astro';
import Contact from '../../components/templates/tatoueur/Contact.astro';
import EncreFooter from '../../components/templates/tatoueur/EncreFooter.astro';

const businessLD = localBusinessSchema(encreData);
---

<BaseLayout seo={localSeo} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preload" as="image" href={encreData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <EncreHeader />

  <main style="background-color: #0A0A0A;">
    <HeroEncre />
    <Styles />
    <Artistes />
    <Flash />
    <Process />
    <Hygiene />
    <Tarifs />
    <Faq />
    <Contact />
  </main>

  <EncreFooter />
</BaseLayout>
