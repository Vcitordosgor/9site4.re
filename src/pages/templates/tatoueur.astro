---
import '../../styles/templates.css';
import '@fontsource/cardo/latin-400.css';
import '@fontsource/cardo/latin-400-italic.css';
import '@fontsource/cardo/latin-700.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import encreData from '../../data/templates/encrevolcan.json';

import EncreHeader from '../../components/templates/tatoueur/EncreHeader.astro';
import HeroEncre from '../../components/templates/tatoueur/HeroEncre.astro';
import Styles from '../../components/templates/tatoueur/Styles.astro';
import Portfolio from '../../components/templates/tatoueur/Portfolio.astro';
import Artistes from '../../components/templates/tatoueur/Artistes.astro';
import Flash from '../../components/templates/tatoueur/Flash.astro';
import Process from '../../components/templates/tatoueur/Process.astro';
import Soin from '../../components/templates/tatoueur/Soin.astro';
import Hygiene from '../../components/templates/tatoueur/Hygiene.astro';
import Tarifs from '../../components/templates/tatoueur/Tarifs.astro';
import Temoignages from '../../components/templates/tatoueur/Temoignages.astro';
import Faq from '../../components/templates/tatoueur/Faq.astro';
import Contact from '../../components/templates/tatoueur/Contact.astro';
import EncreFooter from '../../components/templates/tatoueur/EncreFooter.astro';

const businessLD = localBusinessSchema(encreData, 'HealthAndBeautyBusiness');
---

<BaseLayout seo={getSeo('templateTatoueur')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
<link rel="preload" as="image" href={encreData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <EncreHeader />

  <main style="background-color: #0A0A0A;">
    <HeroEncre />
    <Styles />
    <Portfolio />
    <Artistes />
    <Flash />
    <Process />
    <Soin />
    <Hygiene />
    <Tarifs />
    <Temoignages />
    <Faq />
    <Contact />
  </main>

  <EncreFooter />

  <a
    id="encre-sticky-cta"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center h-12 font-mono font-semibold text-xs uppercase tracking-[0.2em] transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="background-color: #A11920; color: #EEE6D8; box-shadow: 0 12px 28px rgba(0,0,0,0.55);"
  >
    Réserver une consultation →
  </a>

  <script>
    const sticky = document.getElementById('encre-sticky-cta');
    const contact = document.getElementById('contact');
    if (sticky && contact) {
      const update = () => {
        const rect = contact.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 600;
        sticky.dataset.visible = String(scrolledPastHero && !inSection);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
