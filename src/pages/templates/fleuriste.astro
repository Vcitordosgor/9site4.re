---
import '../../styles/templates.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/frangipane.json';

import Header from '../../components/templates/fleuriste/Header.astro';
import Hero from '../../components/templates/fleuriste/HeroPoudre.astro';
import Petales from '../../components/templates/fleuriste/Compositions.astro';
import Atelier from '../../components/templates/fleuriste/Atelier.astro';
import Saison from '../../components/templates/fleuriste/Saison.astro';
import Livraison from '../../components/templates/fleuriste/Livraison.astro';
import Galerie from '../../components/templates/fleuriste/Galerie.astro';
import Faq from '../../components/templates/fleuriste/Faq.astro';

const businessLD = localBusinessSchema(data, 'Florist');
---
<BaseLayout seo={getSeo('templateFleuriste')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/fleuriste/hero.webp" fetchpriority="high" />
  </Fragment>
  <Header />
  <main id="top" style="background:#FBF3EE; color:#2A2520; font-family:Inter,system-ui,sans-serif;">
    <Hero />
    <Petales />
    <Atelier />
    <Saison />
    <Galerie />
    <Livraison />
    <Faq />
  </main>
  <footer id="contact" class="py-14" style="background:#2A2520; color:#FBF3EE;">
    <div class="max-w-content mx-auto px-6 md:px-10 grid md:grid-cols-3 gap-8">
      <div>
        <div class="font-cormorant italic text-3xl">Frangipane</div>
        <p class="text-[11px] uppercase tracking-[0.28em] mt-1" style="color:#C49B62;">Atelier floral · Réunion</p>
      </div>
      <div class="text-[14px]" style="color:#E4D8CB;">
        <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#C49B62;">Contact</div>
        <a href={`tel:${data.info.telephoneHref}`}>{data.info.telephone}</a><br/>
        <a href={`mailto:${data.info.email}`}>{data.info.email}</a><br/>
        Atelier · La Réunion
      </div>
      <div class="text-[14px]" style="color:#E4D8CB;">
        <div class="text-[11px] uppercase tracking-[0.28em] mb-2" style="color:#C49B62;">Atelier ouvert</div>
        Mardi → samedi · 10h-18h<br/>Commandes par téléphone<br/>Mariage / deuil : 7j/7
      </div>
    </div>
    <div class="max-w-content mx-auto px-6 md:px-10 mt-10 pt-5 border-t text-[10px] uppercase tracking-[0.28em]" style="border-color:rgba(251,243,238,0.15); color:#7A6A5C;">© {new Date().getFullYear()} Frangipane — Démonstration 9site4</div>
  </footer>
</BaseLayout>
