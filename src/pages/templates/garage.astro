---
import '@fontsource/bebas-neue/latin-400.css';
import '@fontsource/inter-tight/latin-400.css';
import '@fontsource/inter-tight/latin-500.css';
import '@fontsource/inter-tight/latin-600.css';
import '@fontsource/inter-tight/latin-400-italic.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/italianno/latin-400.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import data from '../../data/templates/motorpiton.json';

import MotorpitonHeader from '../../components/templates/garage/MotorpitonHeader.astro';
import HeroMotorpiton from '../../components/templates/garage/HeroMotorpiton.astro';
import Diagnostic from '../../components/templates/garage/Diagnostic.astro';
import Interventions from '../../components/templates/garage/Interventions.astro';
import Marques from '../../components/templates/garage/Marques.astro';
import Process from '../../components/templates/garage/Process.astro';
import Equipe from '../../components/templates/garage/Equipe.astro';
import PhotoDuotone from '../../components/templates/garage/PhotoDuotone.astro';
import Engagements from '../../components/templates/garage/Engagements.astro';
import Agrements from '../../components/templates/garage/Agrements.astro';
import Citation from '../../components/templates/garage/Citation.astro';
import Avis from '../../components/templates/garage/Avis.astro';
import Bandeau from '../../components/templates/garage/Bandeau.astro';
import Faq from '../../components/templates/garage/Faq.astro';
import Contact from '../../components/templates/garage/Contact.astro';
import MotorpitonFooter from '../../components/templates/garage/MotorpitonFooter.astro';

const businessLD = localBusinessSchema(data, 'AutoRepair');
---

<BaseLayout seo={getSeo('templateGarage')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preload" as="image" href={data.info.photoHero} fetchpriority="high" />
  </Fragment>

  <MotorpitonHeader />

  <main class="bg-piton-asphalte text-piton-beton font-inter-tight">
    <HeroMotorpiton />
    <Diagnostic />
    <Interventions />
    <Marques />
    <Process />
    <Equipe />
    <PhotoDuotone />
    <Engagements />
    <Agrements />
    <Citation />
    <Avis />
    <Bandeau />
    <Faq />
    <Contact />
  </main>

  <MotorpitonFooter />

  <!-- Sticky CTA mobile : appel atelier direct -->
  <a
    id="mp-sticky-call"
    href={`tel:${data.info.telephoneHref}`}
    data-visible="false"
    aria-label="Appeler l'atelier Motor Piton"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center gap-2 h-14 px-6 font-bebas text-lg tracking-[0.08em] bg-piton-feu text-piton-asphalte border-2 border-piton-asphalte transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
    </svg>
    <span>Appeler l'atelier</span>
  </a>

  <script>
    const mpSticky = document.getElementById('mp-sticky-call');
    if (mpSticky) {
      const updateMpSticky = () => {
        mpSticky.dataset.visible = String(window.scrollY > 480);
      };
      updateMpSticky();
      window.addEventListener('scroll', updateMpSticky, { passive: true });
    }
  </script>
</BaseLayout>
