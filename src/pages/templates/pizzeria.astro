---
import '@fontsource/playfair-display/latin-400.css';
import '@fontsource/playfair-display/latin-600.css';
import '@fontsource/playfair-display/latin-700.css';
import '@fontsource/playfair-display/latin-400-italic.css';
import '@fontsource/playfair-display/latin-600-italic.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';

import PizzeriaHeader from '../../components/templates/pizzeria/PizzeriaHeader.astro';
import PizzeriaFooter from '../../components/templates/pizzeria/PizzeriaFooter.astro';
import HeroImmersive from '../../components/templates/pizzeria/HeroImmersive.astro';
import StatBanner from '../../components/templates/pizzeria/StatBanner.astro';
import Manifesto from '../../components/templates/pizzeria/Manifesto.astro';
import FindUs from '../../components/templates/pizzeria/FindUs.astro';
import PizzeriaShop from '../../components/templates/pizzeria/PizzeriaShop.tsx';
import data from '../../data/templates/pizzeria.json';
import { localBusinessSchema } from '../../lib/businessSchema';

const businessLD = localBusinessSchema(data, 'Restaurant');
---

<BaseLayout seo={getSeo('templatePizzeria')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link
      rel="preload"
      as="image"
      href="/images/pizzeria/four-1024.webp"
      imagesrcset="/images/pizzeria/four-640.webp 640w, /images/pizzeria/four-1024.webp 1024w, /images/pizzeria/four.webp 1600w"
      imagesizes="100vw"
      fetchpriority="high"
    />
  </Fragment>

  <PizzeriaHeader />

  <main id="top" class="bg-pizza-creme text-pizza-charbon font-inter">
    <HeroImmersive />

    <!-- Marquee bandeau signature : pâte 72h · feu de bois · mozzarella di bufala -->
    <div class="bg-pizza-rouge text-pizza-creme py-4 overflow-hidden border-y border-pizza-dore/30" aria-hidden="true">
      <div class="flex gap-12 whitespace-nowrap" style="animation: pizza-marquee 38s linear infinite; width: max-content;">
        {Array.from({ length: 2 }).map(() => (
          <div class="flex gap-12 items-center font-playfair italic text-2xl md:text-3xl">
            <span>Pâte fermentée 72 h</span><span class="text-pizza-dore">·</span>
            <span>Cuisson au feu de bois</span><span class="text-pizza-dore">·</span>
            <span>Farines bio</span><span class="text-pizza-dore">·</span>
            <span>Mozzarella fior di latte</span><span class="text-pizza-dore">·</span>
            <span>Tomates San Marzano</span><span class="text-pizza-dore">·</span>
          </div>
        ))}
      </div>
    </div>
    <style>
      @keyframes pizza-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @media (prefers-reduced-motion: reduce) { [style*="pizza-marquee"] { animation: none !important; } }
    </style>

    <StatBanner />
    <Manifesto />

    <!-- Le four à bois -->
    <section id="four" class="relative bg-white py-24 md:py-32 px-6 md:px-10 border-y border-pizza-dore/20">
      <div class="max-w-content mx-auto grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-6 order-2 lg:order-1">
          <p class="scroll-reveal flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-pizza-rouge">
            <span class="inline-block w-8 h-px bg-pizza-rouge" aria-hidden="true"></span>
            <span>Le four à bois</span>
          </p>
          <h2 class="scroll-reveal mt-5 font-playfair font-bold text-pizza-charbon leading-tight" style="font-size: clamp(32px, 4vw, 48px);">
            Une coupole de briques
            <span class="block italic font-medium text-pizza-rouge">portée à 450°C.</span>
          </h2>
          <div class="scroll-reveal mt-6 space-y-4 font-inter text-pizza-charbon/75 leading-relaxed">
            <p>Notre four traditionnel, construit en briques réfractaires, est alimenté au bois de letchi et de goyavier. La flamme lèche la voûte, la sole emmagasine la chaleur, et la pizza cuit en 90 secondes à peine.</p>
            <p>Cette cuisson rapide à très haute température donne ce cornicione gonflé et alvéolé, ces taches de cuisson irrégulières, et ce parfum de bois si caractéristique.</p>
          </div>
          <ul class="scroll-reveal mt-8 grid grid-cols-3 gap-4">
            <li class="text-center">
              <p class="font-playfair font-bold text-pizza-rouge tabular-nums" style="font-size: 28px;">450°C</p>
              <p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-pizza-charbon/55">Voûte</p>
            </li>
            <li class="text-center">
              <p class="font-playfair font-bold text-pizza-rouge tabular-nums" style="font-size: 28px;">90s</p>
              <p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-pizza-charbon/55">Cuisson</p>
            </li>
            <li class="text-center">
              <p class="font-playfair font-bold text-pizza-rouge tabular-nums" style="font-size: 28px;">2</p>
              <p class="mt-1 text-[11px] uppercase tracking-[0.2em] text-pizza-charbon/55">Bois locaux</p>
            </li>
          </ul>
        </div>
        <figure class="scroll-reveal lg:col-span-6 order-1 lg:order-2">
          <div class="relative overflow-hidden rounded-sm" style="aspect-ratio: 4/3;">
            <img
              src="/images/pizzeria/hero.webp"
              alt="Four à bois traditionnel en pleine cuisson, lumière chaude"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover"
            />
          </div>
        </figure>
      </div>
    </section>

    <!-- Nos pâtes (24h pousse) -->
    <section id="pates" class="relative bg-pizza-creme py-24 md:py-32 px-6 md:px-10">
      <div class="max-w-content mx-auto">
        <header class="text-center max-w-2xl mx-auto mb-14">
          <p class="scroll-reveal flex items-center justify-center gap-3 text-xs font-semibold uppercase tracking-[0.3em] text-pizza-rouge">
            <span class="inline-block w-8 h-px bg-pizza-rouge" aria-hidden="true"></span>
            <span>Nos pâtes</span>
            <span class="inline-block w-8 h-px bg-pizza-rouge" aria-hidden="true"></span>
          </p>
          <h2 class="scroll-reveal mt-5 font-playfair font-bold text-pizza-charbon leading-tight" style="font-size: clamp(32px, 4vw, 48px);">
            24 heures de pousse,
            <span class="italic font-medium text-pizza-rouge">digestibilité maximale.</span>
          </h2>
          <p class="scroll-reveal mt-5 text-pizza-charbon/70 leading-relaxed">
            Trois étapes patientes pour une pâte aérienne, légère et digeste — le secret d'une vraie pizza napolitaine.
          </p>
        </header>
        <ol class="grid md:grid-cols-3 gap-6 md:gap-8">
          {[
            { h: 'J-1 · 10h', t: 'Pétrissage', d: 'Farine T0, eau de source, levain mère et sel. Hydratation à 65%, autolyse de 30 min.' },
            { h: 'J-1 · 12h → J · 8h', t: 'Pointage', d: '20 heures en chambre froide à 4°C. La fermentation lente développe les arômes.' },
            { h: 'J · service', t: 'Apprêt & façonnage', d: '4 heures à température ambiante. Les pâtons gonflent, deviennent soyeux, prêts à être étalés.' },
          ].map((step, i) => (
            <li class="scroll-reveal bg-white rounded-sm p-7 ring-1 ring-pizza-charbon/10" style={`transition-delay: ${i * 80}ms`}>
              <p class="font-playfair italic text-pizza-rouge text-sm">{step.h}</p>
              <h3 class="mt-2 font-playfair font-bold text-pizza-charbon text-xl">{step.t}</h3>
              <p class="mt-3 text-sm text-pizza-charbon/70 leading-relaxed">{step.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- Carte + Commander (1 island Preact qui partage le panier) -->
    <PizzeriaShop
      client:load
      info={{ nom: data.info.nom, whatsapp: data.info.whatsapp }}
      menu={data.menu}
      items={data.items}
      zones={data.zones}
      horairesCommande={data.horairesCommande}
    />

    <FindUs />
  </main>

  <PizzeriaFooter />

  <!-- Sticky bottom CTA mobile-only -->
  <a
    id="pizza-sticky-cta"
    href="#commander"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-14 px-6 text-sm font-semibold uppercase tracking-[0.2em] font-inter rounded-full bg-pizza-rouge text-pizza-creme transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow: 0 12px 32px rgb(168 37 50 / 0.45);"
  >
    Commander une pizza
  </a>

  <script>
    const sticky = document.getElementById('pizza-sticky-cta');
    const commander = document.getElementById('commander');
    if (sticky) {
      const updateSticky = () => {
        const scrolledPastHero = window.scrollY > 480;
        let inCommander = false;
        if (commander) {
          const rect = commander.getBoundingClientRect();
          inCommander = rect.top < window.innerHeight && rect.bottom > 80;
        }
        sticky.dataset.visible = String(scrolledPastHero && !inCommander);
      };
      updateSticky();
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky, { passive: true });
    }
  </script>
</BaseLayout>
