---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/concierge.json';

import Header from '../../components/templates/conciergerie/ConciergeHeader.astro';
import Hero from '../../components/templates/conciergerie/HeroCarteBienvenue.astro';
import Services from '../../components/templates/conciergerie/Services.astro';
import Proprietaires from '../../components/templates/conciergerie/Promesse.astro';
import Tarification from '../../components/templates/conciergerie/Formules.astro';
import Temoignages from '../../components/templates/conciergerie/Temoignages.astro';
import Zone from '../../components/templates/conciergerie/Bandeau.astro';
import Contact from '../../components/templates/conciergerie/Demande.astro';
import Footer from '../../components/templates/conciergerie/ConciergeFooter.astro';

const businessLD = localBusinessSchema(data, 'LocalBusiness');
---

<BaseLayout seo={getSeo('templateConciergerie')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/conciergerie/extra-1.webp" fetchpriority="high" />
  </Fragment>

  <Header />

  <main id="top" style="background:#F7F4EE; color:#0F1B2E; font-family:Inter,system-ui,sans-serif;">
    <Hero />
    <Services />
    <Proprietaires />
    <Tarification />
    <Temoignages />
    <Zone />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
