---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/concierge.json';

import ConciergeHeader from '../../components/templates/conciergerie/ConciergeHeader.astro';
import HeroCarteBienvenue from '../../components/templates/conciergerie/HeroCarteBienvenue.astro';
import Services from '../../components/templates/conciergerie/Services.astro';
import Promesse from '../../components/templates/conciergerie/Promesse.astro';
import CommentCaMarche from '../../components/templates/conciergerie/CommentCaMarche.astro';
import Numbers from '../../components/templates/conciergerie/Numbers.astro';
import Formules from '../../components/templates/conciergerie/Formules.astro';
import Citation from '../../components/templates/conciergerie/Citation.astro';
import Temoignages from '../../components/templates/conciergerie/Temoignages.astro';
import Bandeau from '../../components/templates/conciergerie/Bandeau.astro';
import Demande from '../../components/templates/conciergerie/Demande.astro';
import Faq from '../../components/templates/conciergerie/Faq.astro';
import CTAFinal from '../../components/templates/conciergerie/CTAFinal.astro';
import ConciergeFooter from '../../components/templates/conciergerie/ConciergeFooter.astro';

const businessLD = localBusinessSchema(data, 'LocalBusiness');
---

<BaseLayout seo={getSeo('templateConciergerie')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href={data.info.photoVilla} fetchpriority="high" />
  </Fragment>

  <ConciergeHeader />

  <main class="bg-concierge-champagne text-concierge-encre font-inter">
    <HeroCarteBienvenue />
    <Services />
    <Promesse />
    <CommentCaMarche />
    <Numbers />
    <Formules />
    <Citation />
    <Temoignages />
    <Bandeau />
    <Demande />
    <Faq />
    <CTAFinal />
  </main>

  <ConciergeFooter />

  <a
    id="concierge-sticky-cta"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center h-13 bg-concierge-bordeaux text-white font-inter text-sm uppercase tracking-[0.25em] transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="height: 52px; box-shadow: 0 12px 28px rgba(14,27,44,0.40);"
  >
    Demander un audit
  </a>

  <script>
    const sticky = document.getElementById('concierge-sticky-cta');
    const contact = document.getElementById('contact');
    const footerEl = document.querySelector('footer');
    if (sticky && contact) {
      const update = () => {
        const rect = contact.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const footerRect = footerEl ? footerEl.getBoundingClientRect() : null;
        const nearFooter = footerRect ? footerRect.top < window.innerHeight - 40 : false;
        const scrolledPastHero = window.scrollY > 600;
        sticky.dataset.visible = String(scrolledPastHero && !inSection && !nearFooter);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
