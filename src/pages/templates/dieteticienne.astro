---
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/fraunces/latin-500.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import data from '../../data/templates/mona.json';

import Header from '../../components/templates/dieteticienne/Header.astro';
import Hero from '../../components/templates/dieteticienne/Hero.astro';
import Accompagnements from '../../components/templates/dieteticienne/Accompagnements.astro';
import Methode from '../../components/templates/dieteticienne/Methode.astro';
import Praticienne from '../../components/templates/dieteticienne/Praticienne.astro';
import Tarifs from '../../components/templates/dieteticienne/Tarifs.astro';
import RendezVous from '../../components/templates/dieteticienne/RendezVous.astro';
import Faq from '../../components/templates/dieteticienne/Faq.astro';
import Contact from '../../components/templates/dieteticienne/Contact.astro';
import Footer from '../../components/templates/dieteticienne/Footer.astro';

const businessLD = localBusinessSchema(data, 'MedicalBusiness');
---

<BaseLayout seo={getSeo('templateDieteticienne')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href={data.info.photoHero} fetchpriority="high" />
  </Fragment>

  <Header />

  <main style="background-color: #F4EFE6;">
    <Hero />
    <Accompagnements />
    <Methode />
    <Praticienne />
    <Tarifs />
    <RendezVous />
    <Faq />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
