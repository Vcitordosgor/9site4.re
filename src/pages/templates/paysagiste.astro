---
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/manrope/latin-300.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import agapData from '../../data/templates/agapanthes.json';

import PaysagisteHeader from '../../components/templates/paysagiste/PaysagisteHeader.astro';
import HeroBotanique from '../../components/templates/paysagiste/HeroBotanique.astro';
import Manifeste from '../../components/templates/paysagiste/Manifeste.astro';
import PlanJardin from '../../components/templates/paysagiste/PlanJardin.astro';
import Saisons from '../../components/templates/paysagiste/Saisons.astro';
import Galerie from '../../components/templates/paysagiste/Galerie.astro';
import Plantes from '../../components/templates/paysagiste/Plantes.astro';
import Process from '../../components/templates/paysagiste/Process.astro';
import Equipe from '../../components/templates/paysagiste/Equipe.astro';
import Fourchettes from '../../components/templates/paysagiste/Fourchettes.astro';
import Devis from '../../components/templates/paysagiste/Devis.astro';
import Faq from '../../components/templates/paysagiste/Faq.astro';
import Citation from '../../components/templates/paysagiste/Citation.astro';
import PaysagisteFooter from '../../components/templates/paysagiste/PaysagisteFooter.astro';

const businessLD = localBusinessSchema(agapData, 'LocalBusiness');
---

<BaseLayout seo={getSeo('templatePaysagiste')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href={agapData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <PaysagisteHeader />

  <main id="top" class="bg-agap-lin text-agap-feuille font-manrope">
    <HeroBotanique />
    <Manifeste />
    <PlanJardin />
    <Saisons />
    <Galerie />
    <Plantes />
    <Process />
    <Equipe />
    <Fourchettes />
    <Citation />
    <Devis />
    <Faq />
  </main>

  <PaysagisteFooter />

  <a
    id="agap-sticky-cta"
    href="#devis"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-14 px-6 text-xs font-manrope font-semibold uppercase tracking-[0.22em] rounded-full bg-agap-violet text-agap-lin transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow: 0 12px 32px rgb(107 91 149 / 0.40);"
  >
    Demander un devis
  </a>

  <script>
    const sticky = document.getElementById('agap-sticky-cta');
    const devis = document.getElementById('devis');
    if (sticky && devis) {
      const updateSticky = () => {
        const rect = devis.getBoundingClientRect();
        const inDevis = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 480;
        sticky.dataset.visible = String(scrolledPastHero && !inDevis);
      };
      updateSticky();
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky, { passive: true });
    }
  </script>
</BaseLayout>
