---
import '../../styles/templates.css';
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/manrope/latin-300.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import agapData from '../../data/templates/agapanthes.json';

import PaysagisteHeader from '../../components/templates/paysagiste/PaysagisteHeader.astro';
import HeroBotanique from '../../components/templates/paysagiste/HeroBotanique.astro';
import Manifeste from '../../components/templates/paysagiste/Manifeste.astro';
import PlanJardin from '../../components/templates/paysagiste/PlanJardin.astro';
import Saisons from '../../components/templates/paysagiste/Saisons.astro';
import Galerie from '../../components/templates/paysagiste/Galerie.astro';
import Plantes from '../../components/templates/paysagiste/Plantes.astro';
import Process from '../../components/templates/paysagiste/Process.astro';
import Equipe from '../../components/templates/paysagiste/Equipe.astro';
import Fourchettes from '../../components/templates/paysagiste/Fourchettes.astro';
import Devis from '../../components/templates/paysagiste/Devis.astro';
import Faq from '../../components/templates/paysagiste/Faq.astro';
import Citation from '../../components/templates/paysagiste/Citation.astro';
import PaysagisteFooter from '../../components/templates/paysagiste/PaysagisteFooter.astro';

const businessLD = localBusinessSchema(agapData, 'LocalBusiness');
---

<BaseLayout seo={getSeo('templatePaysagiste')} bare={true}>
  <style is:global>
    [data-agap-reveal] { opacity: 0; transform: translateY(28px); transition: opacity .9s ease-out, transform .9s cubic-bezier(.22,.61,.36,1); }
    [data-agap-reveal].is-in { opacity: 1; transform: translateY(0); }
    [data-agap-reveal][data-delay="1"] { transition-delay: .12s; }
    [data-agap-reveal][data-delay="2"] { transition-delay: .24s; }
    [data-agap-reveal][data-delay="3"] { transition-delay: .36s; }
    @media (prefers-reduced-motion: reduce) {
      [data-agap-reveal] { opacity: 1 !important; transform: none !important; transition: none !important; }
    }
    /* Signature vine (réutilisable hors hero) */
    .agap-vine-stem { stroke-dasharray: 2400; stroke-dashoffset: 2400; transition: stroke-dashoffset 1.8s cubic-bezier(.22,.61,.36,1); }
    .agap-vine-leaves > path { opacity: 0; transform: scale(0.2); transform-origin: center; transform-box: fill-box; transition: opacity .7s ease-out, transform .9s cubic-bezier(.34,1.56,.64,1); }
    .agap-vine-blooms circle { opacity: 0; transform: scale(0); transform-origin: center; transform-box: fill-box; transition: opacity .6s ease-out, transform .7s cubic-bezier(.34,1.56,.64,1); }
    .agap-vine.is-revealed .agap-vine-stem { stroke-dashoffset: 0; }
    .agap-vine.is-revealed .agap-vine-leaves > path { opacity: 0.85; transform: scale(1); }
    .agap-vine.is-revealed .agap-vine-blooms circle { opacity: 0.7; transform: scale(1); }
    .agap-vine.is-revealed .agap-vine-leaves > path:nth-child(1){ transition-delay: .35s; }
    .agap-vine.is-revealed .agap-vine-leaves > path:nth-child(2){ transition-delay: .55s; }
    .agap-vine.is-revealed .agap-vine-leaves > path:nth-child(3){ transition-delay: .75s; }
    .agap-vine.is-revealed .agap-vine-leaves > path:nth-child(4){ transition-delay: .95s; }
    .agap-vine.is-revealed .agap-vine-blooms circle { transition-delay: 1.2s; }
    @media (prefers-reduced-motion: reduce) {
      .agap-vine-stem { stroke-dashoffset: 0 !important; transition: none !important; }
      .agap-vine-leaves > path, .agap-vine-blooms circle { opacity: 0.85 !important; transform: none !important; transition: none !important; }
    }
  </style>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href={agapData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <PaysagisteHeader />

  <main id="top" class="bg-agap-lin text-agap-feuille font-manrope">
    <HeroBotanique />
    <Manifeste />
    <PlanJardin />
    <Saisons />
    <Galerie />
    <Plantes />
    <Process />
    <Equipe />
    <Fourchettes />
    <Citation />
    <Devis />
    <Faq />
  </main>

  <PaysagisteFooter />

  <a
    id="agap-sticky-cta"
    href="#devis"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-14 px-6 text-xs font-manrope font-semibold uppercase tracking-[0.22em] rounded-full bg-agap-violet text-agap-lin transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow: 0 12px 32px rgb(107 91 149 / 0.40);"
  >
    Demander un devis
  </a>

  <script>
    const sticky = document.getElementById('agap-sticky-cta');
    const devis = document.getElementById('devis');
    if (sticky && devis) {
      const updateSticky = () => {
        const rect = devis.getBoundingClientRect();
        const inDevis = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 480;
        sticky.dataset.visible = String(scrolledPastHero && !inDevis);
      };
      updateSticky();
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky, { passive: true });
    }

    // SIGNATURE — révèle les vignes botaniques au scroll (IntersectionObserver)
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vines = document.querySelectorAll<SVGSVGElement>('[data-agap-vine]');
    if (vines.length) {
      if (reduce || !('IntersectionObserver' in window)) {
        vines.forEach(v => v.classList.add('is-revealed'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -15% 0px', threshold: 0.05 });
        vines.forEach(v => io.observe(v));
      }
    }

    // Scroll-reveal des en-têtes de sections
    const reveals = document.querySelectorAll<HTMLElement>('[data-agap-reveal]');
    if (reveals.length) {
      if (reduce || !('IntersectionObserver' in window)) {
        reveals.forEach(r => r.classList.add('is-in'));
      } else {
        const io2 = new IntersectionObserver((entries) => {
          entries.forEach(e => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-in');
              io2.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.1 });
        reveals.forEach(r => io2.observe(r));
      }
    }
  </script>
</BaseLayout>
