---
import '../../styles/templates.css';
import '@fontsource/bodoni-moda/latin-400.css';
import '@fontsource/bodoni-moda/latin-500.css';
import '@fontsource/bodoni-moda/latin-600.css';
import '@fontsource/bodoni-moda/latin-700.css';
import '@fontsource/bodoni-moda/latin-400-italic.css';
import '@fontsource/bodoni-moda/latin-500-italic.css';
import '@fontsource/bodoni-moda/latin-600-italic.css';
import '@fontsource/bodoni-moda/latin-700-italic.css';
import '@fontsource/manrope/latin-300.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/latin-700.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import jardinData from '../../data/templates/jardin.json';

import RestoHeader from '../../components/templates/resto/RestoHeader.astro';
import HeroEditorial from '../../components/templates/resto/HeroEditorial.astro';
import LeRestaurant from '../../components/templates/resto/LeRestaurant.astro';
import Carte from '../../components/templates/resto/Carte.astro';
import LeChef from '../../components/templates/resto/LeChef.astro';
import Cave from '../../components/templates/resto/Cave.astro';
import Ambiance from '../../components/templates/resto/Ambiance.astro';
import Reservation from '../../components/templates/resto/Reservation.astro';
import Trouver from '../../components/templates/resto/Trouver.astro';
import CTAFinal from '../../components/templates/resto/CTAFinal.astro';
import RestoFooter from '../../components/templates/resto/RestoFooter.astro';
const businessLD = localBusinessSchema(jardinData, 'Restaurant');

---

<BaseLayout seo={getSeo('templateResto')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link
      rel="preload"
      as="image"
      href={jardinData.info.photoHero}
      fetchpriority="high"
    />
  </Fragment>

  <RestoHeader />

  <main id="top" class="bg-resto-blanc-casse text-resto-bleu-encre font-manrope">
    <HeroEditorial />
    <LeRestaurant />
    <Carte />

    <!-- Bandeau signature : produit · saison · cuisson · terroir -->
    <div class="bg-resto-bleu-encre text-resto-blanc-casse py-5 overflow-hidden border-y border-resto-or/30 relative" aria-hidden="true">
      <div class="flex gap-14 whitespace-nowrap" style="animation: resto-marquee 44s linear infinite; width: max-content;">
        {Array.from({ length: 2 }).map(() => (
          <div class="flex gap-14 items-center font-bodoni italic text-2xl md:text-3xl">
            <span>Produit du jour</span><span class="text-resto-or resto-mq-star">✦</span>
            <span>Cuisine de saison</span><span class="text-resto-or resto-mq-star">✦</span>
            <span>Pêche locale</span><span class="text-resto-or resto-mq-star">✦</span>
            <span>Maraîchers de l'île</span><span class="text-resto-or resto-mq-star">✦</span>
            <span>Cave engagée</span><span class="text-resto-or resto-mq-star">✦</span>
          </div>
        ))}
      </div>
      <!-- Filet or animé qui pulse en continu, bas du bandeau -->
      <div class="absolute left-0 right-0 bottom-0 h-px pointer-events-none">
        <div class="h-full" style="background:linear-gradient(90deg, transparent, rgba(200,166,94,0.85), transparent); background-size:200% 100%; animation: resto-shimmer 5.5s linear infinite;"></div>
      </div>
    </div>
    <style>
      @keyframes resto-marquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }
      @keyframes resto-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
      .resto-mq-star { display: inline-block; animation: resto-mq-twinkle 3s ease-in-out infinite; }
      @keyframes resto-mq-twinkle {
        0%, 100% { opacity: 0.55; transform: scale(1); }
        50%      { opacity: 1;    transform: scale(1.25); }
      }
      @media (prefers-reduced-motion: reduce) {
        [style*="resto-marquee"], [style*="resto-shimmer"], .resto-mq-star { animation: none !important; }
      }
    </style>

    <LeChef />
    <Cave />
    <Ambiance />

    <!-- Bande Allergènes & régimes -->
    <section aria-label="Allergènes et régimes" class="bg-resto-blanc-casse border-y border-resto-bleu-encre/10 py-8 px-6">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center justify-center gap-x-10 gap-y-4 text-center">
        <p class="font-manrope text-[11px] uppercase tracking-[0.32em] text-resto-bleu-roi font-semibold">
          Allergènes &amp; régimes
        </p>
        <ul class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 font-manrope text-sm text-resto-bleu-encre/80">
          <li class="inline-flex items-center gap-2">
            <span aria-hidden="true" class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-resto-or/15 text-resto-or text-xs font-bold">SG</span>
            <span>Sans gluten</span>
          </li>
          <li class="inline-flex items-center gap-2">
            <span aria-hidden="true" class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-resto-or/15 text-resto-or text-xs font-bold">V</span>
            <span>Végétarien</span>
          </li>
          <li class="inline-flex items-center gap-2">
            <span aria-hidden="true" class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-resto-or/15 text-resto-or text-xs font-bold">SL</span>
            <span>Sans lactose</span>
          </li>
          <li class="inline-flex items-center gap-2">
            <span aria-hidden="true" class="inline-flex items-center justify-center w-7 h-7 rounded-full bg-resto-or/15 text-resto-or text-xs font-bold">H</span>
            <span>Halal sur demande</span>
          </li>
        </ul>
      </div>
      <p class="mt-4 text-center font-bodoni italic text-xs text-resto-bleu-encre/55">
        Précisez votre régime à la réservation — la carte s'adapte.
      </p>
    </section>

    <Reservation />
    <Trouver />
    <CTAFinal />
  </main>

  <RestoFooter />

  <!-- Sticky bottom CTA mobile-only — caché en section Réservation -->
  <a
    id="resto-sticky-cta"
    href="#reservation"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-14 px-6 text-sm font-semibold uppercase tracking-[0.22em] font-manrope rounded-full bg-resto-bleu-roi text-resto-blanc-casse transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow: 0 12px 32px rgb(30 58 138 / 0.40);"
  >
    Réserver une table
  </a>

  <script>
    /* Sticky CTA mobile : visible après scroll du hero, caché en section Réservation */
    const sticky = document.getElementById('resto-sticky-cta');
    const reservation = document.getElementById('reservation');
    if (sticky && reservation) {
      const updateSticky = () => {
        const rect = reservation.getBoundingClientRect();
        const inReservation = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 480;
        sticky.dataset.visible = String(scrolledPastHero && !inReservation);
      };
      updateSticky();
      window.addEventListener('scroll', updateSticky, { passive: true });
      window.addEventListener('resize', updateSticky, { passive: true });
    }
  </script>
</BaseLayout>
