---
import '../../styles/templates.css';
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/brulerie.json';

import Header from '../../components/templates/cafe-torref/Header.astro';
import Hero from '../../components/templates/cafe-torref/HeroSac.astro';
import Origines from '../../components/templates/cafe-torref/Origines.astro';
import Methodes from '../../components/templates/cafe-torref/Methodes.astro';
import Torrefacteur from '../../components/templates/cafe-torref/Torrefacteur.astro';
import Preparation from '../../components/templates/cafe-torref/Preparation.astro';
import Atelier from '../../components/templates/cafe-torref/Atelier.astro';
import Abonnement from '../../components/templates/cafe-torref/Abonnement.astro';
import Boutique from '../../components/templates/cafe-torref/Boutique.astro';
import Engagement from '../../components/templates/cafe-torref/Engagement.astro';
import Faq from '../../components/templates/cafe-torref/Faq.astro';
import Footer from '../../components/templates/cafe-torref/Footer.astro';

const businessLD = localBusinessSchema(data, 'CafeOrCoffeeShop');
---
<BaseLayout seo={getSeo('templateCafeTorref')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/cafe-torref/hero.webp" fetchpriority="high" />
  </Fragment>
  <Header />
  <main id="top" style="background:#E8DDC7; color:#1A0F0A; font-family:'DM Sans',system-ui,sans-serif;">
    <Hero />
    <Origines />
    <Methodes />
    <Torrefacteur />
    <Preparation />
    <Atelier />
    <Abonnement />
    <Boutique />
    <Engagement />
    <Faq />
  </main>
  <Footer />

  <a
    id="cf-sticky-cta"
    href="#abonnement"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center h-12 text-[11px] uppercase tracking-[0.22em] font-semibold transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="font-family:'DM Mono',monospace; background:#B57A4A; color:#1A0F0A; box-shadow:0 12px 28px rgba(26,15,10,0.40);"
  >S'abonner — 14€ / 15 jours</a>

  <script>
    const sticky = document.getElementById('cf-sticky-cta');
    const target = document.getElementById('abonnement');
    if (sticky && target) {
      const update = () => {
        const rect = target.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 600;
        sticky.dataset.visible = String(scrolledPastHero && !inSection);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
