---
import '@fontsource/instrument-serif/latin-400.css';
import '@fontsource/instrument-serif/latin-400-italic.css';
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/brulerie.json';

import Header from '../../components/templates/cafe-torref/Header.astro';
import Hero from '../../components/templates/cafe-torref/HeroSac.astro';
import Origines from '../../components/templates/cafe-torref/Origines.astro';
import Methodes from '../../components/templates/cafe-torref/Methodes.astro';
import Atelier from '../../components/templates/cafe-torref/Atelier.astro';
import Abonnement from '../../components/templates/cafe-torref/Abonnement.astro';
import Faq from '../../components/templates/cafe-torref/Faq.astro';
import Footer from '../../components/templates/cafe-torref/Footer.astro';

const businessLD = localBusinessSchema(data, 'CafeOrCoffeeShop');
---
<BaseLayout seo={getSeo('templateCafeTorref')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/cafe-torref/hero.webp" fetchpriority="high" />
  </Fragment>
  <Header />
  <main id="top" style="background:#E8DDC7; color:#1A0F0A; font-family:'DM Sans',system-ui,sans-serif;">
    <Hero />
    <Origines />
    <Methodes />
    <Atelier />
    <Abonnement />
    <Faq />
  </main>
  <Footer />
</BaseLayout>
