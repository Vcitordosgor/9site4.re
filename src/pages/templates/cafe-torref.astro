---
import '@fontsource/dm-mono/latin-400.css';
import '@fontsource/dm-mono/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import brulerieData from '../../data/templates/brulerie.json';

import Header from '../../components/templates/cafe-torref/Header.astro';
import HeroSac from '../../components/templates/cafe-torref/HeroSac.astro';
import Origines from '../../components/templates/cafe-torref/Origines.astro';
import Methodes from '../../components/templates/cafe-torref/Methodes.astro';
import Atelier from '../../components/templates/cafe-torref/Atelier.astro';
import Abonnement from '../../components/templates/cafe-torref/Abonnement.astro';
import Faq from '../../components/templates/cafe-torref/Faq.astro';
import Footer from '../../components/templates/cafe-torref/Footer.astro';

const businessLD = localBusinessSchema(brulerieData, 'CafeOrCoffeeShop');
---

<BaseLayout seo={getSeo('templateCafeTorref')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preload" as="image" href={brulerieData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <Header />

  <main class="font-dm-mono" style="background-color: #E8DDC7; color: #1A0F0A;">
    <HeroSac />
    <Origines />
    <Methodes />
    <Atelier />
    <Abonnement />
    <Faq />
  </main>

  <Footer />
</BaseLayout>
