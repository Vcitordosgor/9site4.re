---
import '@fontsource/lora/latin-400.css';
import '@fontsource/lora/latin-400-italic.css';
import '@fontsource/lora/latin-500.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import sourceData from '../../data/templates/source.json';

import SourceHeader from '../../components/templates/naturopathe/SourceHeader.astro';
import HeroSource from '../../components/templates/naturopathe/HeroSource.astro';
import PourQui from '../../components/templates/naturopathe/PourQui.astro';
import Methode from '../../components/templates/naturopathe/Methode.astro';
import Complementarite from '../../components/templates/naturopathe/Complementarite.astro';
import Formations from '../../components/templates/naturopathe/Formations.astro';
import Cabinet from '../../components/templates/naturopathe/Cabinet.astro';
import Tarifs from '../../components/templates/naturopathe/Tarifs.astro';
import Conseils from '../../components/templates/naturopathe/Conseils.astro';
import Faq from '../../components/templates/naturopathe/Faq.astro';
import Contact from '../../components/templates/naturopathe/Contact.astro';
import SourceFooter from '../../components/templates/naturopathe/SourceFooter.astro';

const businessLD = localBusinessSchema(sourceData, 'MedicalBusiness');

---

<BaseLayout seo={getSeo('templateNaturopathe')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
<link rel="preload" as="image" href={sourceData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <SourceHeader />

  <main style="background-color: #FFFFFF;">
    <HeroSource />
    <PourQui />
    <Methode />
    <Complementarite />
    <Formations />
    <Cabinet />
    <Tarifs />
    <Conseils />
    <Faq />
    <Contact />
  </main>

  <SourceFooter />

  <!-- Sticky CTA mobile -->
  <a
    id="naturo-sticky-cta"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-13 px-6 font-manrope text-[13px] font-semibold tracking-wide rounded-full transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="height: 52px; background-color: #5D7C68; color: #FFFFFF; box-shadow: 0 10px 28px rgb(31 41 38 / 0.30);"
  >
    Prendre RDV première séance
  </a>
  <script>
    const stickyN = document.getElementById('naturo-sticky-cta');
    const contactN = document.getElementById('contact');
    if (stickyN && contactN) {
      const upd = () => {
        const rect = contactN.getBoundingClientRect();
        const inContact = rect.top < window.innerHeight && rect.bottom > 80;
        const past = window.scrollY > 480;
        stickyN.dataset.visible = String(past && !inContact);
      };
      upd();
      window.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd, { passive: true });
    }
  </script>
</BaseLayout>
