---
import '@fontsource/italianno/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/outfit/latin-400.css';
import '@fontsource/outfit/latin-500.css';
import '@fontsource/outfit/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import seveData from '../../data/templates/seve.json';

import SeveHeader from '../../components/templates/wedding/SeveHeader.astro';
import HeroSeve from '../../components/templates/wedding/HeroSeve.astro';
import Ceremonies from '../../components/templates/wedding/Ceremonies.astro';
import Lieux from '../../components/templates/wedding/Lieux.astro';
import PhotoPanorama from '../../components/templates/wedding/PhotoPanorama.astro';
import Bandeau from '../../components/templates/wedding/Bandeau.astro';
import Citation from '../../components/templates/wedding/Citation.astro';
import Fondatrice from '../../components/templates/wedding/Fondatrice.astro';
import Demarches from '../../components/templates/wedding/Demarches.astro';
import Couples from '../../components/templates/wedding/Couples.astro';
import Contact from '../../components/templates/wedding/Contact.astro';
import SeveFooter from '../../components/templates/wedding/SeveFooter.astro';
import Chiffres from '../../components/templates/wedding/Chiffres.astro';
import Calligraphie from '../../components/templates/wedding/Calligraphie.astro';
import Processus from '../../components/templates/wedding/Processus.astro';
import Faq from '../../components/templates/wedding/Faq.astro';
const businessLD = localBusinessSchema(seveData);

---

<BaseLayout seo={getSeo('templateWedding')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <link
      rel="preload"
      as="image"
      href={seveData.info.photoHero}
      fetchpriority="high"
    />
  </Fragment>

  <SeveHeader />

  <main class="bg-seve-ivoire text-seve-marine font-outfit">
    <HeroSeve />
    <Ceremonies />
    <Chiffres />
    <Lieux />
    <PhotoPanorama />
    <Processus />
    <Fondatrice />
    <Bandeau />
    <Demarches />
    <Citation />
    <Calligraphie />
    <Couples />
    <Faq />
    <Contact />
  </main>

  <SeveFooter />

  <!-- Sticky CTA mobile -->
  <a
    id="wedding-sticky-cta"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-13 px-6 font-outfit text-[12px] font-semibold uppercase tracking-[0.2em] rounded-full bg-seve-marine text-seve-ivoire transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="height: 52px; box-shadow: 0 10px 28px rgb(28 40 60 / 0.30);"
  >
    Premier appel — gratuit
  </a>
  <script>
    const stickyW = document.getElementById('wedding-sticky-cta');
    const contactW = document.getElementById('contact');
    if (stickyW && contactW) {
      const upd = () => {
        const rect = contactW.getBoundingClientRect();
        const inContact = rect.top < window.innerHeight && rect.bottom > 80;
        const past = window.scrollY > 520;
        stickyW.dataset.visible = String(past && !inContact);
      };
      upd();
      window.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd, { passive: true });
    }
  </script>
</BaseLayout>
