---
import '../../styles/templates.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import data from '../../data/templates/seve.json';

import Header from '../../components/templates/wedding/Header.astro';
import Hero from '../../components/templates/wedding/Hero.astro';
import Promesse from '../../components/templates/wedding/Promesse.astro';
import Histoire from '../../components/templates/wedding/Histoire.astro';
import Formules from '../../components/templates/wedding/Formules.astro';
import Univers from '../../components/templates/wedding/Univers.astro';
import Inclus from '../../components/templates/wedding/Inclus.astro';
import Lieux from '../../components/templates/wedding/Lieux.astro';
import Couples from '../../components/templates/wedding/Couples.astro';
import Calendrier from '../../components/templates/wedding/Calendrier.astro';
import Contact from '../../components/templates/wedding/Contact.astro';
import Faq from '../../components/templates/wedding/Faq.astro';
import Footer from '../../components/templates/wedding/Footer.astro';

const businessLD = localBusinessSchema(data, 'LocalBusiness');
---
<BaseLayout seo={getSeo('templateWedding')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/wedding/extra-1.webp" fetchpriority="high" />
  </Fragment>

  <Header />

  <main id="top" style="background:#FAF4EA; color:#3A352D; font-family:'Inter',system-ui,sans-serif;">
    <Hero />
    <Promesse />
    <Histoire />
    <Formules />
    <Univers />
    <Inclus />
    <Lieux />
    <Couples />
    <Calendrier />
    <Contact />
    <Faq />
  </main>

  <Footer />

  <a
    id="wed-sticky"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center gap-2 h-[52px] bg-[#3A352D] text-[#FAF4EA] text-[13px] tracking-[0.12em] uppercase font-medium rounded-full transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow:0 14px 32px rgba(58,53,45,0.32); font-family:'Inter',system-ui,sans-serif;"
  >
    Réserver un RDV découverte
  </a>

  <script>
    const sticky = document.getElementById('wed-sticky');
    const target = document.getElementById('contact');
    if (sticky && target) {
      const upd = () => {
        const rect = target.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const past = window.scrollY > 600;
        sticky.dataset.visible = String(past && !inSection);
      };
      upd();
      window.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd, { passive: true });
    }

    const els = document.querySelectorAll('[data-reveal]');
    els.forEach((el) => {
      const h = el as HTMLElement;
      h.style.opacity = '0';
      h.style.transform = 'translateY(32px)';
      h.style.transition = 'opacity 1s ease, transform 1s ease';
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          const h = e.target as HTMLElement;
          h.style.opacity = '1';
          h.style.transform = 'translateY(0)';
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
    els.forEach((el) => io.observe(el));
  </script>
</BaseLayout>
