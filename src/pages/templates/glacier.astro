---
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-500.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/fraunces/latin-500-italic.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
import '@fontsource/dm-sans/latin-600.css';
import '@fontsource/dm-sans/latin-700.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/sorbetpei.json';

import Header from '../../components/templates/glacier/Header.astro';
import Hero from '../../components/templates/glacier/HeroPop.astro';
import Parfums from '../../components/templates/glacier/Parfums.astro';
import Moment from '../../components/templates/glacier/Moment.astro';
import Processus from '../../components/templates/glacier/Processus.astro';
import Tournee from '../../components/templates/glacier/Tournee.astro';
import Privatisation from '../../components/templates/glacier/Privatisation.astro';
import Faq from '../../components/templates/glacier/Faq.astro';
import Footer from '../../components/templates/glacier/Footer.astro';

const businessLD = localBusinessSchema(data, 'FoodEstablishment');
---
<BaseLayout seo={getSeo('templateGlacier')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/glacier/hero.webp" fetchpriority="high" />
  </Fragment>
  <Header />
  <main style="background:#FFF6E2; color:#3D2817; font-family:'DM Sans',system-ui,sans-serif;">
    <Hero />
    <Parfums />
    <Moment />
    <Processus />
    <Tournee />
    <Privatisation />
    <Faq />
  </main>
  <Footer />

  <a id="gl-sticky" href="#tournee" data-visible="false"
     class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-14 px-6 text-[12px] font-bold uppercase tracking-[0.22em] rounded-full transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
     style="background:#FF6F91; color:#FFF6E2; box-shadow:0 12px 32px rgba(255,111,145,0.4);">
     Où croiser le camion
  </a>
  <script>
    const s = document.getElementById('gl-sticky');
    const t = document.getElementById('tournee') || document.getElementById('contact');
    if (s) {
      const u = () => {
        const past = window.scrollY > 480;
        let inSec = false;
        if (t) { const r = t.getBoundingClientRect(); inSec = r.top < window.innerHeight && r.bottom > 80; }
        s.dataset.visible = String(past && !inSec);
      };
      u(); window.addEventListener('scroll', u, { passive: true }); window.addEventListener('resize', u, { passive: true });
    }
  </script>
</BaseLayout>
