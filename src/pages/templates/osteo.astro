---
import '../../styles/templates.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import data from '../../data/templates/verveine.json';

import Header from '../../components/templates/osteo/Header.astro';
import Hero from '../../components/templates/osteo/Hero.astro';
import Approche from '../../components/templates/osteo/Approche.astro';
import Expertise from '../../components/templates/osteo/Expertise.astro';
import Praticienne from '../../components/templates/osteo/Praticienne.astro';
import Tarifs from '../../components/templates/osteo/Tarifs.astro';
import RendezVous from '../../components/templates/osteo/RendezVous.astro';
import Faq from '../../components/templates/osteo/Faq.astro';
import Contact from '../../components/templates/osteo/Contact.astro';
import Footer from '../../components/templates/osteo/Footer.astro';

const businessLD = localBusinessSchema(data, 'MedicalBusiness');
---

<BaseLayout seo={getSeo('templateOsteo')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/osteo/extra-1.webp" fetchpriority="high" />
  </Fragment>

  <Header />

  <main style="background-color: #F7F4EE;">
    <Hero />
    <Approche />
    <Expertise />
    <Praticienne />
    <Tarifs />
    <RendezVous />
    <Faq />
    <Contact />
  </main>

  <Footer />
</BaseLayout>
