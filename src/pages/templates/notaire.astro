---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import notaireData from '../../data/templates/notaire.json';

import NotaireHeader from '../../components/templates/notaire/NotaireHeader.astro';
import HeroNotaire from '../../components/templates/notaire/HeroNotaire.astro';
import Domaines from '../../components/templates/notaire/Domaines.astro';
import Notaires from '../../components/templates/notaire/Notaires.astro';
import Methode from '../../components/templates/notaire/Methode.astro';
import Frais from '../../components/templates/notaire/Frais.astro';
import Documents from '../../components/templates/notaire/Documents.astro';
import Faq from '../../components/templates/notaire/Faq.astro';
import Contact from '../../components/templates/notaire/Contact.astro';
import NotaireFooter from '../../components/templates/notaire/NotaireFooter.astro';

const businessLD = localBusinessSchema(notaireData, 'LegalService');

---

<BaseLayout seo={getSeo('templateNotaire')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link rel="preload" as="image" href={notaireData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <NotaireHeader />

  <main style="background-color: #FFFFFF;">
    <HeroNotaire />
    <Domaines />
    <Notaires />
    <Methode />
    <Frais />
    <Documents />
    <Faq />
    <Contact />
  </main>

  <NotaireFooter />

  <a
    id="notaire-sticky-cta"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center h-12 font-inter font-semibold text-xs uppercase tracking-[0.2em] transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="background-color: #1A1715; color: #F5F1EB; box-shadow: 0 12px 28px rgba(26,23,21,0.30);"
  >
    Premier RDV offert →
  </a>

  <script>
    const sticky = document.getElementById('notaire-sticky-cta');
    const contact = document.getElementById('contact');
    if (sticky && contact) {
      const update = () => {
        const rect = contact.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 600;
        sticky.dataset.visible = String(scrolledPastHero && !inSection);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
