---
import '@fontsource/eb-garamond/latin-400.css';
import '@fontsource/eb-garamond/latin-400-italic.css';
import '@fontsource/eb-garamond/latin-500.css';
import '@fontsource/public-sans/latin-400.css';
import '@fontsource/public-sans/latin-500.css';
import '@fontsource/public-sans/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import roussinData from '../../data/templates/roussin.json';

import RoussinHeader from '../../components/templates/avocat/RoussinHeader.astro';
import HeroRoussin from '../../components/templates/avocat/HeroRoussin.astro';
import Domaines from '../../components/templates/avocat/Domaines.astro';
import Manifesto from '../../components/templates/avocat/Manifesto.astro';
import Citation from '../../components/templates/avocat/Citation.astro';
import Associes from '../../components/templates/avocat/Associes.astro';
import PhotoBibliotheque from '../../components/templates/avocat/PhotoBibliotheque.astro';
import Chiffres from '../../components/templates/avocat/Chiffres.astro';
import Demarche from '../../components/templates/avocat/Demarche.astro';
import Certifications from '../../components/templates/avocat/Certifications.astro';
import Avis from '../../components/templates/avocat/Avis.astro';
import Bandeau from '../../components/templates/avocat/Bandeau.astro';
import FAQ from '../../components/templates/avocat/FAQ.astro';
import Contact from '../../components/templates/avocat/Contact.astro';
import RoussinFooter from '../../components/templates/avocat/RoussinFooter.astro';

const businessLD = localBusinessSchema(roussinData, 'LegalService');
---

<BaseLayout seo={getSeo('templateAvocat')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
  </Fragment>
  <RoussinHeader />

  <main class="bg-roussin-velin text-roussin-nuit font-public-sans">
    <HeroRoussin />
    <section aria-hidden="true" class="bg-roussin-velin">
      <div class="max-w-content mx-auto px-6 md:px-10">
        <img src="/images/avocat/bibliotheque.webp" alt="Bibliothèque du cabinet" class="w-full aspect-[21/9] object-cover" loading="lazy" style="object-position: center 30%;" />
      </div>
    </section>
    <Domaines />
    <Manifesto />
    <Citation />
    <Associes />
    <PhotoBibliotheque />
    <Chiffres />
    <Demarche />
    <section aria-hidden="true" class="bg-roussin-velin py-10">
      <div class="max-w-content mx-auto px-6 md:px-10">
        <img src="/images/avocat/bibliotheque.webp" alt="Cabinet" class="w-full aspect-[21/6] object-cover" loading="lazy" style="object-position: 80% center;" />
      </div>
    </section>
    <Certifications />
    <Avis />
    <Bandeau />
    <FAQ />
    <Contact />
  </main>

  <RoussinFooter />

  <a
    id="roussin-sticky-cta"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center h-12 bg-roussin-nuit text-roussin-velin font-public-sans font-semibold text-xs uppercase tracking-[0.2em] transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow: 0 12px 28px rgba(11,15,26,0.28);"
  >
    Premier RDV offert →
  </a>

  <script>
    const sticky = document.getElementById('roussin-sticky-cta');
    const contact = document.getElementById('contact');
    if (sticky && contact) {
      const update = () => {
        const rect = contact.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const scrolledPastHero = window.scrollY > 600;
        sticky.dataset.visible = String(scrolledPastHero && !inSection);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
