---
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from '../../lib/businessSchema';
import doudouData from '../../data/templates/doudou.json';

import Header from '../../components/templates/aide-domicile/Header.astro';
import Hero from '../../components/templates/aide-domicile/Hero.astro';
import JourneeMarie from '../../components/templates/aide-domicile/JourneeMarie.astro';
import PourQui from '../../components/templates/aide-domicile/PourQui.astro';
import Aidants from '../../components/templates/aide-domicile/Aidants.astro';
import Process from '../../components/templates/aide-domicile/Process.astro';
import Tarifs from '../../components/templates/aide-domicile/Tarifs.astro';
import Temoignages from '../../components/templates/aide-domicile/Temoignages.astro';
import Charte from '../../components/templates/aide-domicile/Charte.astro';
import Bandeau from '../../components/templates/aide-domicile/Bandeau.astro';
import Demande from '../../components/templates/aide-domicile/Demande.astro';
import Faq from '../../components/templates/aide-domicile/Faq.astro';
import Footer from '../../components/templates/aide-domicile/Footer.astro';

const businessLD = localBusinessSchema(doudouData, 'LocalBusiness');
---
<BaseLayout seo={getSeo('templateAideDomicile')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href={doudouData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <Header />

  <main id="top" style="background:#F8F0E3; color:#3D2A1E; font-family:'Inter',system-ui,sans-serif;">
    <Hero />
    <JourneeMarie />
    <PourQui />
    <Aidants />
    <Process />
    <Tarifs />
    <Temoignages />
    <Charte />
    <Bandeau />
    <Demande />
    <Faq />
  </main>

  <Footer />

  <a
    id="ad-sticky"
    href="#contact"
    data-visible="false"
    class="md:hidden fixed bottom-5 inset-x-5 z-40 inline-flex items-center justify-center gap-2 h-[52px] bg-[#3D2A1E] text-[#F8F0E3] text-[14px] font-medium rounded-full transition-all duration-300 data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow:0 14px 32px rgba(61,42,30,0.32); font-family:'Inter',system-ui,sans-serif;"
  >
    Visite gratuite à domicile
  </a>

  <script>
    const sticky = document.getElementById('ad-sticky');
    const target = document.getElementById('contact');
    if (sticky && target) {
      const upd = () => {
        const rect = target.getBoundingClientRect();
        const inSection = rect.top < window.innerHeight && rect.bottom > 80;
        const past = window.scrollY > 600;
        sticky.dataset.visible = String(past && !inSection);
      };
      upd();
      window.addEventListener('scroll', upd, { passive: true });
      window.addEventListener('resize', upd, { passive: true });
    }

    const els = document.querySelectorAll('[data-reveal]');
    els.forEach((el) => {
      const h = el as HTMLElement;
      h.style.opacity = '0';
      h.style.transform = 'translateY(28px)';
      h.style.transition = 'opacity .9s ease, transform .9s ease';
    });
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          const h = e.target as HTMLElement;
          h.style.opacity = '1';
          h.style.transform = 'translateY(0)';
          io.unobserve(e.target);
        }
      }
    }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
    els.forEach((el) => io.observe(el));
  </script>
</BaseLayout>
