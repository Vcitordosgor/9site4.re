---
import '@fontsource/yeseva-one/latin-400.css';
import '@fontsource/italianno/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500-italic.css';
import '@fontsource/caveat/latin-400.css';
import '@fontsource/karla/latin-400.css';
import '@fontsource/karla/latin-500.css';
import '@fontsource/karla/latin-600.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import vanilleData from '../../data/templates/vanille.json';

import VanilleHeader from '../../components/templates/patisserie/VanilleHeader.astro';
import HeroVanille from '../../components/templates/patisserie/HeroVanille.astro';
import Citation from '../../components/templates/patisserie/Citation.astro';
import Specialites from '../../components/templates/patisserie/Specialites.astro';
import Processus from '../../components/templates/patisserie/Processus.astro';
import Bandeau from '../../components/templates/patisserie/Bandeau.astro';
import Saisons from '../../components/templates/patisserie/Saisons.astro';
import Patissiere from '../../components/templates/patisserie/Patissiere.astro';
import Marquee from '../../components/templates/patisserie/Marquee.astro';
import Chiffres from '../../components/templates/patisserie/Chiffres.astro';
import Commandes from '../../components/templates/patisserie/Commandes.astro';
import Avis from '../../components/templates/patisserie/Avis.astro';
import Faq from '../../components/templates/patisserie/Faq.astro';
import Contact from '../../components/templates/patisserie/Contact.astro';
import VanilleFooter from '../../components/templates/patisserie/VanilleFooter.astro';
const businessLD = localBusinessSchema(vanilleData, 'Bakery');
---

<BaseLayout seo={getSeo('templatePatisserie')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href={vanilleData.info.photoHero} fetchpriority="high" />
  </Fragment>

  <VanilleHeader />

  <main class="bg-vanille-creme text-vanille-gousse font-karla">
    <HeroVanille />
    <Citation />
    <Specialites />
    <Processus />
    <Bandeau />
    <Saisons />
    <Patissiere />
    <Marquee />
    <Chiffres />

    {/* Atelier kids — mercredi après-midi */}
    <section id="atelier" aria-label="Atelier enfants" class="bg-vanille-papier py-24 md:py-32 relative overflow-hidden">
      <div class="max-w-content mx-auto px-6 md:px-12 grid lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <div class="lg:col-span-6">
          <img src="/images/patisserie/extra-5.webp" alt="Atelier de pâtisserie pour enfants, mains qui pétrissent la pâte" class="w-full aspect-[5/4] object-cover" loading="lazy" />
        </div>
        <div class="lg:col-span-6">
          <p class="font-karla text-[11px] uppercase tracking-[0.4em] text-vanille-caramel mb-4 flex items-center gap-3">
            <span class="block w-8 h-px bg-vanille-caramel"></span>
            Atelier kids · le mercredi
          </p>
          <h2 class="font-yeseva text-vanille-gousse leading-[0.95]" style="font-size:clamp(38px,5.4vw,72px);">
            Les petites mains,
            <span class="block italic font-italianno text-vanille-caramel" style="font-size:clamp(50px,7vw,96px);">au tablier.</span>
          </h2>
          <p class="mt-6 font-karla text-[15px] text-vanille-gousse/80 leading-relaxed max-w-xl">
            Une fois par semaine, six enfants (6-12 ans) pétrissent, façonnent, glacent. Deux heures, un goûter en commun, et chacun rentre avec sa création.
          </p>
          <ul class="mt-7 grid grid-cols-2 gap-3 font-karla text-[13px] text-vanille-gousse/85 max-w-md">
            <li class="flex gap-2"><span class="text-vanille-caramel">✦</span> Mercredi · 14 h → 16 h</li>
            <li class="flex gap-2"><span class="text-vanille-caramel">✦</span> 6 enfants maximum</li>
            <li class="flex gap-2"><span class="text-vanille-caramel">✦</span> 28 € par enfant</li>
            <li class="flex gap-2"><span class="text-vanille-caramel">✦</span> Tablier offert</li>
          </ul>
          <form class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md" action={`https://wa.me/${vanilleData.info.whatsapp}`} method="get" target="_blank" rel="noopener">
            <input type="text" name="text" placeholder="Prénom de l'enfant + âge" class="flex-1 bg-vanille-blanc border border-vanille-gousse/30 h-12 px-4 font-karla text-[14px] focus:outline-none focus:border-vanille-caramel" />
            <button type="submit" class="inline-flex items-center justify-center px-6 rounded-full bg-vanille-gousse text-vanille-creme font-karla font-semibold text-[12px] uppercase tracking-[0.2em] hover:bg-vanille-caramel transition-colors" style="height:48px;">
              Inscrire
            </button>
          </form>
        </div>
      </div>
    </section>

    <Commandes />
    <Avis />
    <Faq />
    <Contact />
  </main>

  <VanilleFooter />

  <a
    id="vanille-sticky-cta"
    href="#commandes"
    data-visible="false"
    class="md:hidden fixed bottom-4 inset-x-4 z-40 inline-flex items-center justify-center h-14 px-6 text-[12px] font-semibold uppercase tracking-[0.22em] font-karla rounded-full bg-vanille-gousse text-vanille-creme transition-all duration-300 ease-out data-[visible=false]:opacity-0 data-[visible=false]:translate-y-4 data-[visible=false]:pointer-events-none data-[visible=true]:opacity-100 data-[visible=true]:translate-y-0"
    style="box-shadow: 0 12px 32px rgb(76 38 18 / 0.35);"
  >
    Commander sur mesure
  </a>
  <script>
    const sticky = document.getElementById('vanille-sticky-cta');
    const target = document.getElementById('commandes') || document.getElementById('contact');
    if (sticky) {
      const update = () => {
        const past = window.scrollY > 480;
        let inSection = false;
        if (target) {
          const r = target.getBoundingClientRect();
          inSection = r.top < window.innerHeight && r.bottom > 80;
        }
        sticky.dataset.visible = String(past && !inSection);
      };
      update();
      window.addEventListener('scroll', update, { passive: true });
      window.addEventListener('resize', update, { passive: true });
    }
  </script>
</BaseLayout>
