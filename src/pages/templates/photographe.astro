---
import '../../styles/templates.css';
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-500.css';
import '@fontsource/fraunces/latin-600.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeo } from '../../lib/seo';
import { localBusinessSchema } from "../../lib/businessSchema";
import data from '../../data/templates/latitude.json';

import Header from '../../components/templates/photographe/LatitudeHeader.astro';
import Hero from '../../components/templates/photographe/HeroLatitude.astro';
import Seances from '../../components/templates/photographe/Series.astro';
import Portfolio from '../../components/templates/photographe/PhotoPleine.astro';
import Methode from '../../components/templates/photographe/Process.astro';
import Tarifs from '../../components/templates/photographe/Forfaits.astro';
import RDV from '../../components/templates/photographe/Demarche.astro';
import Avis from '../../components/templates/photographe/Avis.astro';
import Auteur from '../../components/templates/photographe/Auteur.astro';
import Faq from '../../components/templates/photographe/Faq.astro';
import Contact from '../../components/templates/photographe/Contact.astro';
import Footer from '../../components/templates/photographe/LatitudeFooter.astro';

const businessLD = localBusinessSchema(data, 'LocalBusiness');
---

<BaseLayout seo={getSeo('templatePhotographe')} bare={true}>
  <Fragment slot="head">
    {businessLD && <script type="application/ld+json" set:html={JSON.stringify(businessLD)} />}
    <link rel="preload" as="image" href="/images/photographe/extra-1.webp" fetchpriority="high" />
  </Fragment>

  <Header />
  <main id="top" style="background:#FAF7F0; color:#0A0A0B; font-family:Inter,system-ui,sans-serif;">
    <Hero />
    <Seances />
    <Portfolio />
    <Methode />
    <Tarifs />
    <Avis />
    <Auteur />
    <RDV />
    <Faq />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
