---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Icon from '../components/ui/Icon.astro';
import siteConfig from '../data/siteConfig.json';
import { inclusions } from '../lib/inclusions';
import type { PageSeo } from '../lib/seo';

// Lien de paiement Stripe (Payment Link hébergé par Stripe).
// TODO: remplacer par le vrai lien avant mise en ligne.
const STRIPE_PAYMENT_LINK = 'https://buy.stripe.com/REMPLACER';

// SEO local : page volontairement non indexée et hors navigation.
// Objet construit en ligne pour ne pas modifier src/lib/seo.ts.
const seo: PageSeo = {
  title: `Abonnement ${siteConfig.siteName} — ${siteConfig.pricing.monthly}/mois`,
  description:
    "Abonnez-vous à l'offre 9site4 : création, design, module métier, hébergement, sécurité, maintenance et accompagnement local, dans une formule mensuelle unique.",
  canonical: '/abonnement',
  ogImage: '/og-image.png',
  ogImageAlt: `${siteConfig.siteName} — ${siteConfig.baseline}`,
  noindex: true,
};

// Inclusions reprises de la source unique partagée (home + tarifs).
const cardItems = inclusions.map((i) => i.titre);
---

<BaseLayout seo={seo}>
  <div class="bg-black text-blanc-casse">
    <!-- ============================================================ -->
    <!-- HERO éditorial : eyebrow + accent line + titre italique       -->
    <!-- ============================================================ -->
    <section class="relative overflow-hidden px-6 pt-28 pb-16 md:pt-36 md:pb-20">
      <!-- Halos décoratifs signature -->
      <div class="pointer-events-none absolute -top-32 -right-32 w-[28rem] h-[28rem] rounded-full bg-bleu/20 blur-3xl opacity-60 halo-pulse" aria-hidden="true"></div>
      <div class="pointer-events-none absolute -bottom-32 -left-32 w-[24rem] h-[24rem] rounded-full bg-bleu/15 blur-3xl opacity-40 halo-pulse-slow" aria-hidden="true"></div>

      <div class="relative mx-auto max-w-3xl text-center">
        <p class="hero-rise hero-rise-1 inline-flex flex-wrap items-center justify-center gap-2 px-3 py-1.5 rounded-full bg-bleu/15 ring-1 ring-bleu/30 text-bleu text-[11px] font-semibold uppercase tracking-[0.28em]">
          <span class="block w-1.5 h-1.5 rounded-full bg-bleu animate-pulse"></span>
          Abonnement 9site4
        </p>
        <span class="hero-rise hero-rise-2 block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.05] text-[clamp(2.5rem,4.5vw+1rem,4.5rem)] tracking-tight text-blanc-casse">
          Votre site professionnel,
          <span class="block italic font-medium text-bleu">créé et géré chaque mois.</span>
        </h1>
        <p class="hero-rise hero-rise-4 mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/75 leading-relaxed">
          Une formule mensuelle unique : création, design, module métier, hébergement, sécurité, maintenance et accompagnement local. Paiement sécurisé par Stripe.
        </p>

        <!-- Mini-badges réassurance -->
        <div class="hero-rise hero-rise-5 mt-8 flex flex-wrap items-center justify-center gap-2.5">
          {['Sans engagement', 'Sans frais de création', 'Résiliation à tout moment'].map((t) => (
            <span class="inline-flex items-center gap-2 h-9 px-4 rounded-full bg-white/[0.04] ring-1 ring-white/10 text-xs font-medium text-blanc-casse/80">
              <Icon name="check" size={13} strokeWidth={2.5} class="text-bleu" />
              {t}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CARTE OFFRE SIGNATURE : grande carte héroïque (gradient ring) -->
    <!-- ============================================================ -->
    <section class="relative px-6 pb-24 md:pb-32" aria-labelledby="offre-titre">
      <div class="relative mx-auto max-w-3xl">
        <!-- Halo signature bleu mauve derrière la card -->
        <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
          <div class="absolute inset-x-8 top-12 bottom-12 rounded-[2.5rem] bg-bleu/30 blur-3xl opacity-60"></div>
        </div>

        <article class="relative rounded-[2rem] p-[1.5px] bg-gradient-to-br from-bleu via-bleu/40 to-white/10 shadow-[0_30px_80px_-20px_rgba(145,166,255,0.55)]">
          <div class="relative rounded-[1.93rem] bg-[#0a0a0a] p-8 md:p-12 overflow-hidden">
            <!-- Glow interne discret -->
            <div class="pointer-events-none absolute -top-32 -right-32 w-80 h-80 rounded-full bg-bleu/20 blur-3xl" aria-hidden="true"></div>

            <div class="relative grid md:grid-cols-2 gap-10 items-start">
              <!-- Colonne prix + CTA -->
              <div>
                <p class="inline-flex items-center gap-2 font-roboto-mono text-[10px] uppercase tracking-[0.3em] text-bleu font-semibold">
                  <span class="w-1.5 h-1.5 rounded-full bg-bleu"></span>
                  Formule unique
                </p>
                <h2 id="offre-titre" class="mt-4 font-sora font-bold text-3xl md:text-4xl text-blanc-casse leading-tight">
                  Abonnement
                  <span class="block italic font-medium text-bleu">tout inclus.</span>
                </h2>

                <div class="mt-8 flex items-baseline gap-2">
                  <span class="font-sora font-bold text-[clamp(3.75rem,8vw,5.5rem)] leading-none tracking-tight text-blanc-casse">{siteConfig.pricing.monthly}</span>
                  <span class="text-lg text-blanc-casse/60 font-medium">/mois</span>
                </div>
                <p class="mt-3 text-sm text-blanc-casse/60">
                  Soit environ <span class="text-blanc-casse/85 font-medium">{siteConfig.pricing.daily}/jour</span>. Sans engagement.
                </p>

                <div class="mt-8">
                  <Button
                    variant="primary"
                    size="lg"
                    href={STRIPE_PAYMENT_LINK}
                    target="_blank"
                    rel="noopener noreferrer"
                    fullWidth
                    aria-label="S'abonner à 9site4 — paiement sécurisé par Stripe"
                  >
                    S'abonner
                    <Icon name="arrow-right" size={20} strokeWidth={2.25} />
                  </Button>
                  <p class="mt-3 flex items-center justify-center gap-1.5 text-center text-xs text-blanc-casse/55">
                    <Icon name="shield-check" size={13} strokeWidth={2} class="text-bleu" />
                    Paiement sécurisé par Stripe · Fait à La Réunion
                  </p>
                </div>

                <!-- Toggle annuel discret -->
                <div class="mt-6 flex items-center justify-between rounded-2xl bg-white/[0.04] ring-1 ring-white/10 px-4 py-3">
                  <div>
                    <p class="font-sora font-semibold text-sm text-blanc-casse">Formule annuelle</p>
                    <p class="text-xs text-blanc-casse/60">{siteConfig.pricing.yearly}/an · ≈ 2 mois offerts</p>
                  </div>
                  <Badge variant="primary" size="sm">−17%</Badge>
                </div>
              </div>

              <!-- Colonne inclusions -->
              <div>
                <p class="font-sora font-semibold text-sm text-blanc-casse/85 uppercase tracking-wide">
                  Ce qui est inclus
                </p>
                <ul class="mt-5 space-y-3.5">
                  {cardItems.map((label) => (
                    <li class="flex items-start gap-3 text-[15px] text-blanc-casse/85 leading-snug">
                      <span class="flex w-5 h-5 rounded-full bg-bleu/20 text-bleu items-center justify-center shrink-0 mt-0.5">
                        <Icon name="check" size={12} strokeWidth={3} />
                      </span>
                      <span>{label}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </article>

        <p class="mt-8 text-center text-sm text-blanc-casse/55">
          En cliquant sur « S'abonner », vous êtes redirigé vers la page de paiement sécurisée Stripe. Aucune donnée bancaire n'est saisie sur ce site.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>
