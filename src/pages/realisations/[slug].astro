---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RealisationCard from '../../components/realisations/RealisationCard.astro';
import Icon from '../../components/ui/Icon.astro';
import CTABand from '../../components/sections/CTABand.astro';
import realisationsData from '../../data/realisations.json';
import categories from '../../data/categories.json';
import siteConfig from '../../data/siteConfig.json';
import { getRealisationSeo, absoluteUrl } from '../../lib/seo';

// Imports des mini-previews (un par template) — réutilisés pour la section aperçu
import PreviewResto from '../../components/realisations/previews/PreviewResto.astro';
import PreviewPizzeria from '../../components/realisations/previews/PreviewPizzeria.astro';
import PreviewBarJus from '../../components/realisations/previews/PreviewBarJus.astro';
import PreviewSalon from '../../components/realisations/previews/PreviewSalon.astro';
import PreviewInstitut from '../../components/realisations/previews/PreviewInstitut.astro';
import PreviewSpa from '../../components/realisations/previews/PreviewSpa.astro';
import PreviewPlomberie from '../../components/realisations/previews/PreviewPlomberie.astro';
import PreviewElectricien from '../../components/realisations/previews/PreviewElectricien.astro';
import PreviewPaysagiste from '../../components/realisations/previews/PreviewPaysagiste.astro';
import PreviewOsteo from '../../components/realisations/previews/PreviewOsteo.astro';
import PreviewDieteticienne from '../../components/realisations/previews/PreviewDieteticienne.astro';
import PreviewPsy from '../../components/realisations/previews/PreviewPsy.astro';
import PreviewCoach from '../../components/realisations/previews/PreviewCoach.astro';
import PreviewYoga from '../../components/realisations/previews/PreviewYoga.astro';
import PreviewDanse from '../../components/realisations/previews/PreviewDanse.astro';
import PreviewGite from '../../components/realisations/previews/PreviewGite.astro';
import PreviewExcursions from '../../components/realisations/previews/PreviewExcursions.astro';
import PreviewLocation from '../../components/realisations/previews/PreviewLocation.astro';
import PreviewConsultant from '../../components/realisations/previews/PreviewConsultant.astro';
import PreviewComptable from '../../components/realisations/previews/PreviewComptable.astro';
import PreviewArchitecte from '../../components/realisations/previews/PreviewArchitecte.astro';
import PreviewAutoEcole from '../../components/realisations/previews/PreviewAutoEcole.astro';
import PreviewConciergerie from '../../components/realisations/previews/PreviewConciergerie.astro';
import PreviewAideDomicile from '../../components/realisations/previews/PreviewAideDomicile.astro';
import PreviewPlongee from '../../components/realisations/previews/PreviewPlongee.astro';
import PreviewWedding from '../../components/realisations/previews/PreviewWedding.astro';
import PreviewPatisserie from '../../components/realisations/previews/PreviewPatisserie.astro';
import PreviewGarage from '../../components/realisations/previews/PreviewGarage.astro';
import PreviewPhotographe from '../../components/realisations/previews/PreviewPhotographe.astro';
import PreviewAvocat from '../../components/realisations/previews/PreviewAvocat.astro';
import PreviewBoulangerie from '../../components/realisations/previews/PreviewBoulangerie.astro';
import PreviewGlacier from '../../components/realisations/previews/PreviewGlacier.astro';
import PreviewCafeTorref from '../../components/realisations/previews/PreviewCafeTorref.astro';
import PreviewSurf from '../../components/realisations/previews/PreviewSurf.astro';
import PreviewFleuriste from '../../components/realisations/previews/PreviewFleuriste.astro';
import PreviewTatoueur from '../../components/realisations/previews/PreviewTatoueur.astro';
import PreviewNaturopathe from '../../components/realisations/previews/PreviewNaturopathe.astro';
import PreviewCreche from '../../components/realisations/previews/PreviewCreche.astro';
import PreviewNotaire from '../../components/realisations/previews/PreviewNotaire.astro';
import PreviewStudioAudio from '../../components/realisations/previews/PreviewStudioAudio.astro';

export async function getStaticPaths() {
  const realisations = (await import('../../data/realisations.json')).default;
  return realisations.map((r: any) => ({
    params: { slug: r.slug },
    props: { realisation: r },
  }));
}

const { realisation } = Astro.props as { realisation: any };

const previewMap: Record<string, any> = {
  'restaurant-gastronomique': PreviewResto,
  'snack-pizzeria': PreviewPizzeria,
  'bar-a-jus-tropical': PreviewBarJus,
  'salon-de-coiffure': PreviewSalon,
  'institut-de-beaute': PreviewInstitut,
  'spa-massage': PreviewSpa,
  'plomberie': PreviewPlomberie,
  'electricite-generale': PreviewElectricien,
  'paysagiste': PreviewPaysagiste,
  'cabinet-osteopathie': PreviewOsteo,
  'dieteticienne': PreviewDieteticienne,
  'psychologue': PreviewPsy,
  'coach-sportif': PreviewCoach,
  'studio-yoga': PreviewYoga,
  'ecole-de-danse': PreviewDanse,
  'gite-de-montagne': PreviewGite,
  'excursions-randonnee': PreviewExcursions,
  'location-saisonniere-bord-de-mer': PreviewLocation,
  'consultant': PreviewConsultant,
  'cabinet-comptable': PreviewComptable,
  'architecte': PreviewArchitecte,
  'auto-ecole': PreviewAutoEcole,
  'conciergerie': PreviewConciergerie,
  'aide-a-domicile': PreviewAideDomicile,
  'plongee': PreviewPlongee,
  'wedding-planner': PreviewWedding,
  'patisserie-creole': PreviewPatisserie,
  'garage-mecanique': PreviewGarage,
  'photographe-auteur': PreviewPhotographe,
  'avocat-cabinet': PreviewAvocat,
  'boulangerie-artisanale': PreviewBoulangerie,
  'glacier-artisanal': PreviewGlacier,
  'cafe-torrefaction': PreviewCafeTorref,
  'ecole-de-surf': PreviewSurf,
  'fleuriste-atelier': PreviewFleuriste,
  'studio-de-tatouage': PreviewTatoueur,
  'naturopathe': PreviewNaturopathe,
  'micro-creche': PreviewCreche,
  'etude-notariale': PreviewNotaire,
  'studio-audio': PreviewStudioAudio,
};
const Preview = previewMap[realisation.slug] ?? null;

const seo = getRealisationSeo(realisation);

const categoryName =
  categories.find((c) => c.id === realisation.categorie)?.nom ?? realisation.categorie;

// Réalisations proches : 3 autres dans la même catégorie
const related = (realisationsData as any[])
  .filter((r) => r.categorie === realisation.categorie && r.slug !== realisation.slug)
  .slice(0, 3);

// JSON-LD : Breadcrumb + CreativeWork
const breadcrumb = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Accueil', item: absoluteUrl('/') },
    { '@type': 'ListItem', position: 2, name: 'Nos réalisations', item: absoluteUrl('/realisations') },
    { '@type': 'ListItem', position: 3, name: realisation.nom, item: absoluteUrl(seo.canonical) },
  ],
};

const creativeWork = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: `Réalisation 9site4 — ${realisation.nom}`,
  about: realisation.businessType,
  inLanguage: 'fr-RE',
  creator: { '@id': `${siteConfig.siteUrl}/#organization` },
  url: absoluteUrl(seo.canonical),
  description: realisation.goal,
};
---

<BaseLayout seo={seo}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} slot="head" />
  <script type="application/ld+json" set:html={JSON.stringify(creativeWork)} slot="head" />

  <div class="bg-black text-blanc-casse">

    <!-- Section 1 : Hero réalisation -->
    <section class="relative overflow-hidden px-6 pt-28 pb-14 md:pt-36 md:pb-20">
      <div class="mx-auto max-w-3xl text-center">
        <p class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-bleu text-white text-xs font-semibold uppercase tracking-wide">
          <span class="block w-1.5 h-1.5 rounded-full bg-white/90"></span>
          Réalisation 9site4 · {realisation.sector}
        </p>
        <span class="block mx-auto mt-7 h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
        <h1 class="mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2rem,3.5vw+1rem,3.5rem)] tracking-tight text-blanc-casse">
          Réalisation de site internet pour
          <span class="block italic font-medium text-bleu">{realisation.businessType} à La Réunion.</span>
        </h1>
        <p class="mx-auto mt-7 max-w-2xl text-lg md:text-xl text-blanc-casse/80 leading-relaxed">
          {realisation.goal}
        </p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-3">
          <a
            href="/contact"
            class="inline-flex items-center gap-2 h-12 px-6 rounded-full bg-bleu text-white font-semibold text-sm shadow-[0_4px_16px_rgba(145,166,255,0.35)] hover:bg-[#7e95ff] hover:-translate-y-0.5 transition-all"
            data-track-event="cta_create_site_click"
            data-track-category="conversion"
            data-track-label={realisation.slug}
            data-track-source="realisation_detail_hero"
            data-track-target="/contact"
          >
            Créer un site dans cet esprit
            <Icon name="arrow-right" size={16} strokeWidth={2.5} />
          </a>
          {realisation.previewUrl && (
            <a
              href={realisation.previewUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 h-12 px-6 rounded-full border border-white/15 text-blanc-casse font-semibold text-sm hover:border-bleu hover:text-bleu transition-colors"
              data-track-event="cta_view_template_preview_click"
              data-track-category="navigation"
              data-track-label={realisation.slug}
              data-track-source="realisation_detail_hero"
              data-track-target={realisation.previewUrl}
            >
              Voir l'aperçu complet
              <Icon name="arrow-right" size={16} strokeWidth={2.5} />
            </a>
          )}
        </div>
      </div>
    </section>

    <!-- Section 2 : Contexte métier -->
    <section class="relative px-6 py-12 md:py-16">
      <div class="mx-auto max-w-3xl">
        <p class="font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
          <span class="inline-block align-middle w-2 h-2 rounded-full bg-bleu mr-2"></span>
          Contexte métier
        </p>
        <h2 class="mt-4 font-sora font-bold text-2xl md:text-3xl text-blanc-casse text-balance leading-tight">
          Un site pensé pour les besoins
          <span class="block italic font-medium text-bleu">d'un {realisation.businessType} à La Réunion.</span>
        </h2>
        <p class="mt-6 text-lg text-blanc-casse/75 leading-relaxed">
          Pour un {realisation.businessType}, un site internet doit présenter clairement l'activité,
          les prestations et faciliter la mise en relation avec les clients locaux. {realisation.shortDescription}.
        </p>
        <p class="mt-4 text-base text-blanc-casse/65 leading-relaxed">
          9site4 structure votre site autour de ce qui compte pour votre métier : présentation, contenus utiles,
          informations pratiques, et un module métier intégré pour transformer la visite en contact ou en réservation.
          <a href={realisation.sectorPageUrl} class="text-bleu hover:underline">En savoir plus sur les sites pour {realisation.sector.toLowerCase()}.</a>
        </p>
      </div>
    </section>

    <!-- Section 3 : Ce que 9site4 structure -->
    <section class="relative px-6 py-12 md:py-16">
      <div class="mx-auto max-w-5xl">
        <p class="font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
          <span class="inline-block align-middle w-2 h-2 rounded-full bg-bleu mr-2"></span>
          Structure de la réalisation
        </p>
        <h2 class="mt-4 font-sora font-bold text-2xl md:text-3xl text-blanc-casse text-balance leading-tight">
          Ce que 9site4 structure
          <span class="block italic font-medium text-bleu">pour ce type d'activité.</span>
        </h2>
        <ul class="mt-10 grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {realisation.structuredElements.map((el: string) => (
            <li class="rounded-2xl p-6"
              style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
              <div class="inline-flex items-center justify-center w-10 h-10 rounded-xl mb-4"
                style="background: linear-gradient(135deg, #91a6ff 0%, #b39dff 100%);">
                <Icon name="sparkle" size={18} strokeWidth={2.25} class="text-bleu-nuit" />
              </div>
              <p class="font-sora font-semibold text-blanc-casse text-base leading-snug">{el}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Section 4 : Module métier intégré -->
    <section class="relative px-6 py-12 md:py-16">
      <div class="mx-auto max-w-4xl rounded-3xl p-8 md:p-10"
        style="background: linear-gradient(180deg, #14161F 0%, #0A0B12 100%); box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 12px 30px -16px rgba(0,0,0,0.85), 0 0 0 1px rgba(255,255,255,0.08);">
        <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-bleu/15 text-bleu text-xs font-bold uppercase tracking-wide">
          Module {realisation.moduleInclus}
        </span>
        <h2 class="mt-5 font-sora font-bold text-2xl md:text-3xl text-blanc-casse text-balance leading-tight">
          Un module métier intégré
          <span class="block italic font-medium text-bleu">adapté à ce type d'activité.</span>
        </h2>
        <p class="mt-5 text-lg text-blanc-casse/80 leading-relaxed">
          {realisation.moduleDescription}
        </p>
        <p class="mt-4 text-base text-blanc-casse/65 leading-relaxed">
          Le module métier intégré pour ce type d'activité simplifie la transformation d'une visite en contact qualifié
          ou en réservation directe — sans intermédiaire, sans commission.
        </p>
      </div>
    </section>

    <!-- Section 5 : Aperçu visuel -->
    {realisation.previewUrl && Preview && (
      <section class="relative px-6 py-12 md:py-16">
        <div class="mx-auto max-w-5xl">
          <p class="font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="inline-block align-middle w-2 h-2 rounded-full bg-bleu mr-2"></span>
            Aperçu visuel
          </p>
          <h2 class="mt-4 font-sora font-bold text-2xl md:text-3xl text-blanc-casse text-balance leading-tight">
            Un aperçu de la réalisation
            <span class="block italic font-medium text-bleu">pour vous projeter concrètement.</span>
          </h2>
          <div class="mt-8 rounded-2xl overflow-hidden border border-white/10"
            style="background: #000; box-shadow: 0 1px 0 rgba(255,255,255,0.06) inset, 0 18px 40px -22px rgba(0,0,0,0.85), 0 0 0 1.5px #91a6ff, 0 0 28px -8px rgba(145,166,255,0.45);">
            <div class="flex items-center gap-1.5 px-3 py-2 bg-bleu-nuit/95" aria-hidden="true">
              <span class="block w-2.5 h-2.5 rounded-full bg-[#FF5F57]"></span>
              <span class="block w-2.5 h-2.5 rounded-full bg-[#FEBC2E]"></span>
              <span class="block w-2.5 h-2.5 rounded-full bg-[#28C840]"></span>
            </div>
            <div class="relative aspect-[16/10] overflow-hidden bg-bleu-nuit">
              <div class="absolute inset-0">
                <Preview />
              </div>
            </div>
          </div>
          <div class="mt-6 flex justify-center">
            <a
              href={realisation.previewUrl}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-2 h-12 px-6 rounded-full bg-bleu text-white font-semibold text-sm shadow-[0_4px_16px_rgba(145,166,255,0.35)] hover:bg-[#7e95ff] hover:-translate-y-0.5 transition-all"
              data-track-event="cta_view_template_preview_click"
              data-track-category="navigation"
              data-track-label={realisation.slug}
              data-track-source="realisation_detail_preview"
              data-track-target={realisation.previewUrl}
            >
              Voir l'aperçu complet
              <Icon name="arrow-right" size={16} strokeWidth={2.5} />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Section 6 : Réalisations proches -->
    {related.length > 0 && (
      <section class="relative px-6 py-12 md:py-16">
        <div class="mx-auto max-w-content">
          <p class="font-roboto-mono text-[11px] uppercase tracking-[0.32em] text-blanc-casse/55 font-semibold">
            <span class="inline-block align-middle w-2 h-2 rounded-full bg-bleu mr-2"></span>
            Réalisations proches
          </p>
          <h2 class="mt-4 font-sora font-bold text-2xl md:text-3xl text-blanc-casse text-balance leading-tight">
            D'autres réalisations
            <span class="block italic font-medium text-bleu">dans la même catégorie.</span>
          </h2>
          <ul class="mt-8 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {related.map((r) => (
              <li>
                <RealisationCard realisation={r} />
              </li>
            ))}
          </ul>
          <div class="mt-10 text-center">
            <a href="/realisations" class="inline-flex items-center gap-2 text-sm font-semibold text-bleu hover:underline">
              Voir toutes nos réalisations
              <Icon name="arrow-right" size={14} strokeWidth={2.5} />
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- Section 7 : CTA final -->
    <CTABand
      trackingSource="realisation_detail_cta_band"
      trackingPageType="realisation_detail"
      trackingSector={realisation.categorie}
    />
  </div>
</BaseLayout>
