---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { getSeo } from '../lib/seo';
---

<BaseLayout seo={getSeo('notFound')}>
  <section class="relative overflow-hidden px-6 pt-24 pb-24 md:pt-32 md:pb-32 min-h-[70dvh] flex items-center">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[40rem] h-[40rem] halo-mix opacity-50"></div>
    </div>

    <div class="mx-auto max-w-2xl text-center">
      <p class="hero-rise hero-rise-1 font-sora font-bold text-[8rem] md:text-[12rem] leading-none text-bleu-nuit/15 select-none" aria-hidden="true">
        404
      </p>
      <span class="hero-rise hero-rise-2 block mx-auto h-[3px] w-16 bg-bleu" aria-hidden="true"></span>
      <h1 class="hero-rise hero-rise-2 mt-5 font-sora font-bold text-balance leading-[1.08] text-[clamp(2rem,3vw+1rem,3.25rem)] tracking-tight text-bleu-nuit">
        Cette page
        <span class="block italic font-medium text-bleu">n'existe pas.</span>
      </h1>
      <p class="hero-rise hero-rise-4 mt-6 text-lg text-bleu-nuit/70 leading-relaxed">
        Le lien est peut-être périmé, ou l'adresse mal orthographiée.
      </p>

      <div class="hero-rise hero-rise-5 mt-10 flex flex-col sm:flex-row gap-4 justify-center">
        <Button variant="primary" size="lg" href="/">
          Retour à l'accueil
          <Icon name="arrow-right" size={20} strokeWidth={2.25} />
        </Button>
        <Button variant="secondary" size="lg" href="/contact">
          Nous contacter
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
