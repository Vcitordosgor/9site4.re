# 9site4 — Variables d'environnement
#
# Copier ce fichier en `.env` à la racine du projet et remplir si besoin.
# Laisser vide / PUBLIC_ENABLE_ANALYTICS=false en local pour désactiver tout tracking.

# ---- Tracking conversion (GA4 + Meta Pixel) ----
# Master switch — si != "true", aucun script de tracking n'est chargé.
PUBLIC_ENABLE_ANALYTICS=false

# Google Analytics 4 — Measurement ID (format G-XXXXXXXXXX). Laisser vide pour désactiver.
PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook) Pixel — Pixel ID numérique. Laisser vide pour désactiver.
PUBLIC_META_PIXEL_ID=

# ---- Bindings et secrets runtime — À CONFIGURER DANS CLOUDFLARE PAGES, PAS ICI ----
#
# Les valeurs ci-dessous ne sont JAMAIS mises en local. Documentation seulement.
#
# SEB           : Binding Cloudflare Send Email — Cloudflare Pages → Settings → Functions → Bindings
#                 Nom exact attendu par le code : `SEB`
#                 Sans ce binding, les endpoints /api/contact et /api/diagnostic renvoient 500 binding_missing.
#                 Le client affiche alors un fallback WhatsApp automatique.
#
# DISCORD_WEBHOOK_URL (ou tout nom contenant "discord" + "webhook")
#               : Notification Discord temps réel sur soumission de formulaire.
#                 Optionnel : si absent, skippé silencieusement (n'empêche pas l'email).
#                 À ajouter dans Cloudflare Pages → Settings → Environment Variables.
#
# Voir docs/PROD_SETUP.md pour le setup complet.
