{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "9site4",
  "compatibility_date": "2026-04-25",
  "observability": {
    "enabled": true
  },
  "main": "dist/_worker.js/index.js",
  "compatibility_flags": [
    "global_fetch_strictly_public",
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "send_email": [
    {
      // destination_address = boîte OVHcloud (France), destination VÉRIFIÉE du binding.
      // Remplacer REMPLACER_BOITE_OVH par l'adresse réelle (idem siteConfig.contact.notifyEmail).
      "name": "SEB",
      "destination_address": "REMPLACER_BOITE_OVH"
    }
  ]
}
